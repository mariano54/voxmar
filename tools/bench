#!/bin/bash
# Frame-time benchmarks at Mariano's settings, on a quiet machine. See docs/quality.md.
#
#   tools/bench fps [--repeats N] [--only NAME[,NAME]] [--quiet]
#       The FPS benchmark, for optimising: this tree's frame rate in fixed scenes (a fixed
#       seed and scripted camera), each run N times (default 3). Prints the median of the
#       runs' average FPS, 1% low,
#       p99 and worst frame per scene, with the spread between runs, and adds the results
#       to ~/Projects/voxmar-wt/bench-history.jsonl by commit and power mode.
#   tools/bench cpu [--repeats N]
#       The CPU half, needing no GPU (the Linux box too): server tick times, columns
#       streamed and lighting and meshing cost while flying at 4x speed at 32 chunks.
#   tools/bench history [SCENE]
#       The recorded results, oldest first, to see the effect of changes over time.
#   tools/bench [--rounds N] [--only NAME[,NAME]] [--quiet] [BASE]
#       --quiet holds a quiet window while timing (QUIET: other builds pause), for numbers
#       on an idle machine; without it the load is recorded with them.
#       The performance gate: this tree against a base (main unless given), below.
#
# Builds both with --release, then runs each view alternately (base, this, base, this…)
# for N rounds (default 2), all within one quiet window: it holds ~/Projects/voxmar-wt/QUIET
# while it times, which pauses other threads' builds (memcap) and holds new heavy commands,
# and waits for running tests and game runs to finish. Judges ratios against the base,
# never absolute numbers, as the graphics thread does:
#
# - a flight fails if its p99 frame is over 1.5x the base's in every round, or its worst
#   frame over 25 ms on AC power;
# - a static view fails if it is over 8% slower than the base in every round.
#
# Views (headless captures, seed 1, his config: 32 chunks and SMAA, VSync off):
#   flight75   40 s flight at 2268x1473, his 75% resolution of a 3024x1964 screen
#   flight100  40 s flight at 3024x1964, full resolution
#   flightfast 40 s flight at 2268x1473 four times as fast (his fly speed), the world
#              streaming in faster than it is made: p99 and worst frame matter most
#   sea        the sea at spawn, 2268x1473
#   forest     dense forest, 2268x1473
#   mountains  a mountain range with spruce forest, 2268x1473
#   night_rain the land at midnight in rain, 2268x1473
#   dig        digging a shaft for 15 s, holding the button: breaking, particles, drops,
#              remeshing, 2268x1473
# Scenes of the FPS benchmark: flight75 flightfast forest mountains night_rain dig.
# The numbers, the power mode and the load go to target/bench/report.txt.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 2
memcap=~/Projects/voxmar-wt/memcap
# Away from the Mac (a Linux machine, a fresh clone), the copy in this tree.
[[ -x $memcap ]] || memcap=$PWD/tools/memcap
quiet=~/Projects/voxmar-wt/QUIET
# QUIET and the history live there, which a fresh machine does not have yet.
mkdir -p ~/Projects/voxmar-wt
# Quiet samples in a row so far, after a sample of `busy` percent of a core: the count
# goes up on a quiet one and back to 0 on a busy one.
calm_after() {
  local calm=$1 busy=$2
  if ((busy < MAX_BUSY)); then echo $((calm + 1)); else echo 0; fi
}
MAX_BUSY=300

# "ratio worse too-slow" for a flight: base p99, this p99, this worst frame, on AC (1/0).
flight_verdict() {
  awk -v bp="$1" -v cp="$2" -v cx="$3" -v ac="$4" 'BEGIN { r = cp / bp; printf "%.2f %d %d", r, (r > 1.5), (ac && cx > 25) }'
}
# "ratio worse 0" for a static view: base and this frame time.
static_verdict() {
  awk -v b="$1" -v c="$2" 'BEGIN { r = c / b; printf "%.3f %d 0", r, (r > 1.08) }'
}

# Checks the decisions that once failed silently (the idle count never rose, a ratio was
# never printed), so `tools/gate` can run this before every landing.
self_check() {
  local calm=0 busy failed=0
  for busy in 100 250 400 100 100 100; do calm=$(calm_after "$calm" "$busy"); done
  ((calm == 3)) || { echo "bench self-check: idle count is $calm after three quiet samples, not 3" >&2; failed=1; }
  local verdict
  verdict=$(flight_verdict 6.0 9.5 30 1)
  [[ $verdict == "1.58 1 1" ]] || { echo "bench self-check: flight verdict is '$verdict', not '1.58 1 1'" >&2; failed=1; }
  verdict=$(static_verdict 2.0 2.4)
  [[ $verdict == "1.200 1 0" ]] || { echo "bench self-check: static verdict is '$verdict', not '1.200 1 0'" >&2; failed=1; }
  return $failed
}

history=~/Projects/voxmar-wt/bench-history.jsonl

# The machine, so results from different ones (a Mac, a Linux box) are never compared:
# the platform, and on a Mac its power mode (Low Power Mode swings GPU clocks 2x) and
# whether it runs on AC.
platform() { echo "$(uname -s)-$(uname -m)"; }
power_mode() {
  if command -v pmset >/dev/null; then
    pmset -g | awk '/powermode/ { print ($2 == 1 ? "low" : $2 == 2 ? "high" : "normal") }'
  else
    echo n/a
  fi
}
on_ac_power() {
  if command -v pmset >/dev/null; then pmset -g batt | head -1 | grep -q 'AC Power' && echo ac || echo battery; else echo n/a; fi
}
load_avg() { if [[ -r /proc/loadavg ]]; then awk '{ print $1 }' /proc/loadavg; else sysctl -n vm.loadavg | awk '{ print $2 }'; fi; }
# A copy-on-write copy where the filesystem has one (APFS, btrfs, XFS).
clone_dir() { if [[ $(uname -s) == Darwin ]]; then cp -cR "$1" "$2"; else cp -R --reflink=auto "$1" "$2"; fi; }
rounds=2 only= base=main mode=compare repeats=3 use_quiet=0
case ${1:-} in
  fps) mode=fps; shift ;;
  cpu)
    # The CPU half, no GPU needed (any machine): the server's ticks, columns streamed and
    # the client's lighting and meshing while flying at 4x speed at 32 chunks
    # (crates/server/tests/cpu_bench.rs), N runs (default 3), medians recorded.
    shift
    repeats=3
    [[ ${1:-} == --repeats ]] && repeats=$2
    memcap=~/Projects/voxmar-wt/memcap
    [[ -x $memcap ]] || memcap=$PWD/tools/memcap
    mkdir -p ~/Projects/voxmar-wt target/bench
    commit=$(git rev-parse --short HEAD)$([[ -n $(git status --porcelain --untracked-files=no) ]] && echo '+changes')
    lines=()
    for ((r = 1; r <= repeats; r++)); do
      line=$($memcap 16 -- cargo test --release -p voxmar_server --test cpu_bench -- --ignored --nocapture 2>&1 | tee target/bench/cpu.txt | grep '^cpu:')
      [[ -n $line ]] || { echo "bench: FAILED: no cpu line; see target/bench/cpu.txt" >&2; exit 1; }
      echo "$line"
      lines+=("$(sed -E 's/^cpu: [0-9]+ ticks, median ([0-9.]+) ms, p99 ([0-9.]+) ms, max ([0-9.]+) ms; ([0-9]+) columns\/s streamed; ([0-9.]+) ms .*/\1 \2 \3 \4 \5/' <<<"$line")")
    done
    printf '%s\n' "${lines[@]}" | python3 -c '
import json, statistics, sys, time
rows = [list(map(float, l.split())) for l in sys.stdin if l.strip()]
med = [statistics.median(c) for c in zip(*rows)]
names = ["tick_median", "tick_p99", "tick_max", "columns_s", "mesh_ms"]
entry = dict(t=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), commit=sys.argv[1], platform=sys.argv[2], power=sys.argv[3], ac=sys.argv[4], load=sys.argv[5], scene="cpu", repeats=len(rows), **dict(zip(names, med)))
print("cpu (medians): tick median %.2f ms, p99 %.2f ms, max %.2f ms; %.0f columns/s; %.2f ms a column" % tuple(med))
open(sys.argv[6], "a").write(json.dumps(entry) + "\n")
' "$commit" "$(platform)" "$(power_mode)" "$(on_ac_power)" "$(load_avg)" "$history"
    exit 0 ;;
  history)
    # One line per run and scene: when, commit, power mode, and the numbers.
    [[ -e $history ]] || { echo "bench: no results recorded yet" >&2; exit 1; }
    python3 - "$history" "${2:-}" <<'PY'
import json, sys
rows = [json.loads(l) for l in open(sys.argv[1]) if l.strip()]
scene = sys.argv[2]
print(f"{'when (UTC)':17} {'commit':9} {'machine':14} {'power':6} {'scene':11} {'fps':>6} {'1% low':>7} {'p99 ms':>7} {'worst':>7} {'spread':>7}")
for r in rows:
    if scene and r["scene"] != scene:
        continue
    if r["scene"] == "cpu":
        print(f"{r['t'][:16]:17} {r['commit'][:9]:9} {r.get('platform', '?'):14} {r['power']:6} cpu         ticks {r['tick_median']:.2f}/{r['tick_p99']:.2f}/{r['tick_max']:.1f} ms, {r['columns_s']:.0f} columns/s, mesh {r['mesh_ms']:.2f} ms")
        continue
    print(f"{r['t'][:16]:17} {r['commit'][:9]:9} {r.get('platform', '?'):14} {r['power']:6} {r['scene']:11} {r['fps']:6.0f} {r['low']:7.0f} {r['p99']:7.2f} {r['worst']:7.1f} {r['spread']*100:6.1f}%")
PY
    exit 0 ;;
esac
while (($#)); do
  case $1 in
    --self-check) self_check; exit $? ;;
    --repeats) repeats=$2; shift 2 ;;
    --quiet) use_quiet=1; shift ;;
    --rounds) rounds=$2; shift 2 ;;
    --only) only=$2; shift 2 ;;
    -*) echo "usage: tools/bench fps [--repeats N] [--only NAME,...] | tools/bench history [SCENE] | tools/bench [--rounds N] [--only NAME,...] [BASE]" >&2; exit 2 ;;
    *) base=$1; shift ;;
  esac
done

out=$PWD/target/bench
mkdir -p "$out"
report=$out/report.txt
config=$out/config
mkdir -p "$config"
# Mariano's settings, as he plays (2026-10-05).
printf '(\n    view_distance: 32,\n    anti_aliasing: Smaa,\n    vsync: false,\n)\n' >"$config/settings.ron"
# The same, flying four times as fast, as he does (fly speed 400%): the world streams in
# faster than it is generated and meshed, which is where his frame rate fell under 60.
fast=$out/config-fast
mkdir -p "$fast"
printf '(\n    view_distance: 32,\n    anti_aliasing: Smaa,\n    vsync: false,\n    fly_speed: 400,\n)\n' >"$fast/settings.ron"

# The capture arguments of a view, into `view_args`.
view_args() {
  case $1 in
    flight75) view_args=(--size 2268x1473 --weather clear --time 0.2 --flight 40) ;;
    flight100) view_args=(--size 3024x1964 --weather clear --time 0.2 --flight 40) ;;
    flightfast) view_args=(--size 2268x1473 --weather clear --time 0.2 --flight 40) ;;
    sea) view_args=(--size 2268x1473 --pose 0,2,0,20,-5 --time 0.2 --wait 10) ;;
    forest) view_args=(--size 2268x1473 --weather clear --time 0.3 --command "/tp 384 1504" --pose 0,25,0,200,-30 --wait 10) ;;
    mountains) view_args=(--size 2268x1473 --weather clear --time 0.25 --command "/tp 352 -448" --pose 0,30,0,0,-15 --wait 10) ;;
    night_rain) view_args=(--size 2268x1473 --weather rain --time 0.75 --pose 0,10,0,90,-5 --wait 10) ;;
    dig) view_args=(--size 2268x1473 --weather clear --time 0.3 --command "/tp 288 -384" --dig 15) ;;
    *) return 1 ;;
  esac
}
views=(flight75 flight100 flightfast sea forest)
[[ $mode == fps ]] && views=(flight75 flightfast forest mountains night_rain dig)
[[ -n $only ]] && IFS=, read -ra views <<<"$only"
for view in "${views[@]}"; do view_args "$view" || { echo "bench: no view called $view" >&2; exit 2; }; done

# The base, built in its own worktree (its target seeded from ours, so only what changed
# is rebuilt). The FPS benchmark has none.
base_rev=$(git rev-parse --verify "$base^{commit}") || exit 2
base_dir=$out/base
if [[ $mode == fps ]]; then
  echo "bench: building this tree with --release"
  $memcap -- cargo build --release >"$out/build.txt" 2>&1 || { tail -20 "$out/build.txt"; exit 1; }
elif [[ ! -e $base_dir/.git ]]; then
  git worktree add --detach "$base_dir" "$base_rev" >/dev/null || exit 1
  [[ -d target/release ]] && mkdir -p "$base_dir/target" && clone_dir target/release "$base_dir/target/release"
fi
if [[ $mode == compare ]]; then
  git -C "$base_dir" checkout -q --detach "$base_rev" || exit 1
  echo "bench: building this tree and the base ($(git log -1 --format='%h %s' "$base_rev")) with --release"
  $memcap -- cargo build --release >"$out/build.txt" 2>&1 || { tail -20 "$out/build.txt"; exit 1; }
  (cd "$base_dir" && $memcap -- cargo build --release) >"$out/build-base.txt" 2>&1 || { tail -20 "$out/build-base.txt"; exit 1; }
fi

# Whether a game Mariano plays is running (voxmar not as a capture or gate, or Minecraft):
# numbers taken then would be wrong, so nothing is timed.
game_running() {
  # The program is the first word of the arguments: `comm` is cut at 16 characters, which
  # made ./target/release/voxmar look like "release".
  ps -A -o args= | awk '
    { n = split($1, path, "/"); exe = path[n] }
    exe == "voxmar" && !/--capture|--gate/ { found = 1 }
    exe == "java" && tolower($0) ~ /minecraft/ { found = 1 }
    END { exit !found }'
}
# Percent of one core the whole machine is busy, now.
busy_cpu() { ps -A -o pcpu= | awk '{ s += $1 } END { print int(s) }'; }

while game_running; do
  echo "bench: Mariano's game is running; waiting until he quits, as numbers now would be wrong"
  sleep 30
done

# With --quiet, a quiet window: claim QUIET at once (another timing run's, if fresh, is
# waited for), which pauses every build memcap runs and holds new heavy commands; then
# wait for the tests and game runs still going to finish, and a minute at most for the
# machine to idle. Without it (the default, Mariano's rule until the Linux box takes over
# benchmarks), the numbers are taken alongside whatever else runs, the load recorded.
if ((use_quiet)); then
  while [[ -e $quiet && -n $(find "$quiet" -mmin -20 2>/dev/null) ]]; do
    echo "bench: another timing run holds QUIET ($(cat "$quiet")), waiting"
    sleep 10
  done
  echo "bench $(date -u +%FT%TZ)" >"$quiet"
  trap 'rm -f "$quiet"' EXIT INT TERM
  echo "bench: holding QUIET; waiting for running heavy commands to pause or finish"
  for ((i = 0; ; i++)); do
    busy=0
    for lock in /tmp/voxmar-heavy-*.lock; do
      [[ -e $lock && ! -e $lock.paused ]] && kill -0 "$(cat "$lock" 2>/dev/null)" 2>/dev/null && busy=1
    done
    ((!busy)) && break
    ((i > 150)) && { echo "bench: FAILED: heavy commands still running after 5 minutes" >&2; exit 1; }
    sleep 2
  done
  # Idle: under MAX_BUSY (percent of a core, of 1800; his own apps take 100-200) for three
  # samples in a row. Anything heavier would show in the frame times; better no numbers than
  # wrong ones.
  # Mariano's rule (2026-10-05): until the Linux box is the benchmark machine, benchmarks
  # run on his Mac however busy it is, with the load recorded beside the numbers and more
  # runs judged by their median. So this waits a minute at most for the machine to idle.
  calm=0
  for ((i = 0; i < 30 && calm < 3; i++)); do
    # Not `((calm++)) || calm=0`: a post-increment from 0 is false, which reset the count,
    # so no machine was ever quiet enough. `--self-check` guards this.
    calm=$(calm_after "$calm" "$(busy_cpu)")
    sleep 2
  done
  if ((calm < 3)); then
    echo "bench: the machine is busy ($(busy_cpu)% of a core, load $(load_avg)); timing anyway, with the load recorded"
  else
    echo "bench: quiet after $((i * 2))s ($(busy_cpu)% of a core busy, load $(load_avg))"
  fi
  # Our own runs go ahead in the window we hold.
  export VOXMAR_TIMING=1
fi

# One run of `view` by the binary in `dir`: its numbers, as "median p99 max" (flights) or
# "frame-ms" (static views). Stops everything if Mariano starts playing.
run() {
  local dir=$1 view=$2 log
  view_args "$view"
  ((use_quiet)) && touch "$quiet"
  game_running && { echo "bench: FAILED: Mariano started playing; no numbers taken now are trustworthy" >&2; exit 1; }
  local settings=$config
  [[ $view == flightfast ]] && settings=$fast
  log=$(cd "$dir" && VOXMAR_MUTE=1 VOXMAR_CONFIG="$settings" $memcap 16 -- target/release/voxmar --capture "$out/$view.png" --seed 1 "${view_args[@]}" 2>&1 | sed 's/\x1b\[[0-9;]*m//g')
  if [[ $mode == fps ]]; then
    # "fps 1%-low p99 worst" from the run's frame statistics, whatever kind of scene.
    sed -nE 's/.*(flight|dig|steady): [0-9]+ frames, median [0-9.]+ ms, p99 ([0-9.]+) ms, max ([0-9.]+) ms, .*\(([0-9]+) fps\), 1% low ([0-9]+) fps.*/\4 \5 \2 \3/p' <<<"$log"
  elif [[ $view == flight* ]]; then
    # "median p99 max meshed": meshed is the columns loaded less those still waiting to be
    # meshed, so a change that meshes less, and so draws less, shows.
    local meshed
    meshed=$(sed -nE 's/.*capture: .* ([0-9]+) columns, .* ([0-9]+) pending, .*/\1 \2/p' <<<"$log" | awk '{ print $1 - $2 }')
    sed -nE 's/.*flight: [0-9]+ frames, median ([0-9.]+) ms, p99 ([0-9.]+) ms, max ([0-9.]+) ms.*/\1 \2 \3/p' <<<"$log" | sed "s/$/ $meshed/"
  else
    sed -nE 's/.*capture: [0-9]+ fps \(([0-9.]+) ms\).*/\1/p' <<<"$log"
  fi
}

if [[ $mode == fps ]]; then
  commit=$(git rev-parse --short HEAD)$([[ -n $(git status --porcelain --untracked-files=no) ]] && echo '+changes')
  power=$(power_mode) on_ac=$(on_ac_power) machine=$(platform)
  {
    echo "fps $(date -u +%FT%TZ): $commit on $machine, power $power on $on_ac, load $(load_avg), $repeats runs a scene"
    printf '%-11s %7s %7s %8s %8s %8s\n' scene fps "1% low" "p99 ms" "worst" spread
  } | tee "$report"
  for view in "${views[@]}"; do
    runs=() load_during=$(load_avg)
    for ((r = 1; r <= repeats; r++)); do
      numbers=$(run . "$view") || exit 1
      [[ $(wc -w <<<"$numbers") -eq 4 ]] || { echo "bench: FAILED: $view gave no frame statistics; see a run by hand" | tee -a "$report"; exit 1; }
      runs+=("$numbers")
    done
    # The median of the runs for each number (robust to a run disturbed by a busy
    # machine), the worst of their worst frames, and the runs' FPS spread around the median.
    line=$(printf '%s\n' "${runs[@]}" | sort -n | awk -v scene="$view" '
      { fps[NR] = $1; low[NR] = $2; p99[NR] = $3; if ($4 > worst) worst = $4 }
      function median(a, n,   i, j, t) {
        for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) if (a[j] < a[i]) { t = a[i]; a[i] = a[j]; a[j] = t }
        return n % 2 ? a[(n + 1) / 2] : (a[n / 2] + a[n / 2 + 1]) / 2
      }
      END { n = NR; lo = fps[1]; hi = fps[n]; m = median(fps, n); printf "%s %.1f %.1f %.2f %.1f %.4f\n", scene, m, median(low, n), median(p99, n), worst, (hi - lo) / m }')
    read -r _ fps low p99 worst spread <<<"$line"
    printf '%-11s %7.0f %7.0f %8.2f %8.1f %7.1f%%\n' "$view" "$fps" "$low" "$p99" "$worst" "$(awk -v s="$spread" 'BEGIN { print s * 100 }')" | tee -a "$report"
    printf '{"t":"%s","commit":"%s","platform":"%s","power":"%s","ac":"%s","load":"%s","scene":"%s","repeats":%d,"fps":%s,"low":%s,"p99":%s,"worst":%s,"spread":%s,"runs":"%s"}\n' \
      "$(date -u +%FT%TZ)" "$commit" "$machine" "$power" "$on_ac" "$load_during" "$view" "$repeats" "$fps" "$low" "$p99" "$worst" "$spread" "$(IFS=';'; echo "${runs[*]}")" >>"$history"
  done
  echo "bench: done; results added to $history (tools/bench history)"
  exit 0
fi

{
  echo "bench $(date -u +%FT%TZ): $(git rev-parse --short HEAD)$([[ -n $(git status --porcelain --untracked-files=no) ]] && echo '+changes') against $(git rev-parse --short "$base_rev")"
  echo "machine: $(platform), power $(power_mode) on $(on_ac_power), load $(load_avg)"
} | tee "$report"
failed=0 inconclusive=0
on_ac=$([[ $(on_ac_power) == ac ]] && echo 1 || echo 0)
number='^[0-9]+([.][0-9]+)?$'
for view in "${views[@]}"; do
  worse=0 worst_fail=0 base_low= base_high=
  for ((round = 1; round <= rounds; round++)); do
    busy=$(busy_cpu)
    b=$(run "$base_dir" "$view") || exit 1
    c=$(run . "$view") || exit 1
    if [[ $view == flight* ]]; then
      read -r bm bp bx bn <<<"$b"
      read -r cm cp cx cn <<<"$c"
      key=$bp
      verdict=$(flight_verdict "$bp" "$cp" "$cx" "$on_ac")
      line="base median $bm p99 $bp max $bx ms, $bn columns meshed; this median $cm p99 $cp max $cx ms, $cn meshed; p99"
      values=("$bm" "$bp" "$bx" "$cm" "$cp" "$cx")
    else
      key=$b
      verdict=$(static_verdict "$b" "$c")
      line="base $b ms, this $c ms a frame;"
      values=("$b" "$c")
    fi
    read -r ratio over too_slow <<<"$verdict"
    for v in "${values[@]}" "$ratio" "$over" "$too_slow"; do
      [[ $v =~ $number ]] || { echo "$view round $round: FAILED, no numbers to compare (base '$b', this '$c'); see a run by hand" | tee -a "$report"; exit 1; }
    done
    ((worse += over, worst_fail += too_slow)) || true
    [[ -z $base_low ]] && base_low=$key base_high=$key
    base_low=$(awk -v a="$base_low" -v b="$key" 'BEGIN { print (b < a ? b : a) }')
    base_high=$(awk -v a="$base_high" -v b="$key" 'BEGIN { print (b > a ? b : a) }')
    echo "$view round $round: $line x$ratio (machine $busy% of a core busy before)" | tee -a "$report"
  done
  # The base against itself: rounds that disagree this much say the machine was not quiet.
  spread=$(awk -v l="$base_low" -v h="$base_high" -v f="$([[ $view == flight* ]] && echo 1.5 || echo 1.15)" 'BEGIN { print (h > l * f) }')
  if ((worse == rounds)); then
    echo "$view: FAILED, slower than the base in every round" | tee -a "$report"
    failed=1
  elif ((worst_fail > 0)); then
    echo "$view: FAILED, a frame over 25 ms on AC power" | tee -a "$report"
    failed=1
  elif ((spread)); then
    echo "$view: INCONCLUSIVE, the base itself ranged $base_low-$base_high ms between rounds" | tee -a "$report"
    inconclusive=1
  fi
done
((failed)) && { echo "bench: FAILED (report in $report)"; exit 1; }
((inconclusive)) && { echo "bench: INCONCLUSIVE, too noisy to judge; run it again (report in $report)"; exit 3; }
echo "bench: passed (report in $report)"
