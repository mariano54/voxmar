#!/bin/bash
# Frame times of play builds as Mariano plays them: his own settings, a new world, three
# scenes, each game's own frame statistics (the capture's `steady:` or `flight:` line:
# median, p99, worst frame, mean fps and 1% low). For telling a build that is slower from
# a machine that was busy:
#
#   tools/perf/play_frames BINARY [BINARY...]
#
# e.g. tools/perf/play_frames ~/Projects/voxmar-wt/play/target/release/voxmar OLD/voxmar
#
#   spawn   standing at the spawn of seed 1, looking over the land, once it has loaded
#   town    over Ashhurst, the village of seed 1 nearest its spawn (21 houses, 14
#           people), looking over its roofs, creative and noon
#   flight  40 s flight from the spawn of seed 1 at his fly speed: the land streaming in
#
# Holds ~/Projects/voxmar-wt/QUIET while it times, which pauses memcap's builds and holds
# new heavy commands, and refuses to run while his game is open. Run it with no gate or
# train going: QUIET does not pause tests or game runs already running, and numbers taken
# beside them say nothing about a build. Each scene runs `REPEATS` times (default 2), the
# builds taking turns, so a passing disturbance shows as runs that disagree.

set -uo pipefail
[[ $# -ge 1 ]] || { echo "usage: tools/perf/play_frames BINARY [BINARY...]" >&2; exit 2; }
repeats=${REPEATS:-2}
settings=${VOXMAR_SETTINGS:-$HOME/Library/Application Support/voxmar/settings.ron}
quiet=~/Projects/voxmar-wt/QUIET
out=$(mktemp -d "${TMPDIR:-/tmp}/play-frames.XXXXXX")

game_running() {
  ps -A -o args= | awk '
    { n = split($1, path, "/"); exe = path[n] }
    exe == "voxmar" && !/--capture|--gate/ { found = 1 }
    END { exit !found }'
}
if game_running; then
  echo "play_frames: Mariano's game is open; numbers now would be his frames' and ours mixed" >&2
  exit 1
fi
mkdir -p ~/Projects/voxmar-wt
echo "play_frames $(date -u +%FT%TZ)" >"$quiet"
trap 'rm -f "$quiet"; rm -rf "$out"' EXIT INT TERM

scene_args() {
  case $1 in
    spawn) args=(--seed 1 --weather clear --time 0.3 --pose 0,2,0,20,-5 --wait 30) ;;
    town) args=(--seed 1 --weather clear --time 0.3 --command "/gamemode creative" --command "/time set noon"
      --command "/time freeze" --command "/tp -624 -592" --pose 0,12,24,0,-20 --wait 30) ;;
    flight) args=(--seed 1 --weather clear --time 0.3 --flight 40) ;;
  esac
}

echo "play_frames: load $(sysctl -n vm.loadavg 2>/dev/null || cat /proc/loadavg), $repeats runs a scene"
for scene in spawn town flight; do
  for ((round = 1; round <= repeats; round++)); do
    for binary in "$@"; do
      [[ -x $binary ]] || { echo "$scene: no binary at $binary"; continue; }
      binary=$(cd "$(dirname "$binary")" && pwd)/$(basename "$binary")
      touch "$quiet"
      config=$out/config
      rm -rf "$config" && mkdir -p "$config"
      [[ -e $settings ]] && cp "$settings" "$config/settings.ron"
      scene_args "$scene"
      log=$(cd "$(dirname "$binary")/../.." && VOXMAR_MUTE=1 VOXMAR_TIMING=1 VOXMAR_FOREGROUND=1 VOXMAR_CONFIG=$config \
        "$binary" --capture "$out/$scene.png" --size 2268x1473 "${args[@]}" 2>&1 | sed 's/\x1b\[[0-9;]*m//g')
      stats=$(grep -oE '(steady|flight): [0-9]+ frames.*' <<<"$log" | tail -1)
      gpu=$(grep -m1 -oE 'AdapterInfo \{ name: "[^"]*"' <<<"$log" | sed 's/.*name: //')
      echo "$scene round $round, $binary: ${stats:-no frame statistics (see a run by hand)} [gpu $gpu, load $(sysctl -n vm.loadavg 2>/dev/null | awk '{ print $2 }')]"
    done
  done
done
