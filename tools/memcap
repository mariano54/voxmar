#!/bin/bash
# memcap: run a heavy command (cargo build/test/run, the game, a capture) with a memory
# cap and a machine-wide limit on how many heavy commands run at once, out of the way of
# Mariano's playing and of timing runs.
#
#   ~/Projects/voxmar-wt/memcap [GB] -- cargo test --release -p voxmar_worldgen
#
# - Gets out of the way of timing runs: waits while ~/Projects/voxmar-wt/QUIET exists (a
#   flag older than 20 minutes is stale and ignored), and pauses a running build (not tests
#   or game runs, which finish soon) until it goes. The timing run itself sets
#   VOXMAR_TIMING=1 to go ahead; `tools/bench` does all of this for you.
# - Waits for one of VOXMAR_SLOTS (default 4) slots shared by every thread and track.
# - Gets out of Mariano's way completely when he plays: while ~/Projects/voxmar-wt/PLAYING
#   exists (written when he says he will play), nothing new starts and whatever is running
#   pauses, until it goes. Once his game (voxmar not as a capture or gate, or Minecraft)
#   has been seen, the flag is ignored 30 minutes after it last ran; until then, two hours
#   after it was written.
# - Runs everything muted (VOXMAR_MUTE=1): no run of ours ever plays a sound; and with a
#   configuration directory of its own (VOXMAR_CONFIG) unless one is given, so no run of
#   ours ever writes Mariano's settings or worlds.
# - Kills the command and everything it started once their resident memory together
#   passes GB (default 20), and exits 137 with a message saying so.
# - Defaults RUST_TEST_THREADS=4 unless already set. Cargo uses every core: a clean build
#   of the whole workspace peaks around 6.5 GB, so four at once stay far below the caps.
#
# Written after a worldgen test reached 117 GB on 2026-10-04 and took the Mac down; the
# holds after our builds gave him 40-140 ms frames and under 60 fps while he played, and
# timing runs could not get a quiet machine.

cap_gb=20
if [[ $1 =~ ^[0-9]+$ ]]; then cap_gb=$1; shift; fi
[[ $1 == -- ]] && shift
[[ $# -eq 0 ]] && { echo "usage: memcap [GB] -- command..." >&2; exit 2; }

export RUST_TEST_THREADS=${RUST_TEST_THREADS:-4}
# Nothing run through memcap ever makes a sound: games launched while developing would
# otherwise play over whoever is at the machine.
export VOXMAR_MUTE=1
# Nor does it touch Mariano's own settings and worlds: unless a command names a
# configuration directory, it gets a fresh one of its own, deleted afterwards. (A gate run
# once saved its settings over his.)
own_config=
if [[ -z ${VOXMAR_CONFIG:-} ]]; then
  own_config=$(mktemp -d "${TMPDIR:-/tmp}/voxmar-config.XXXXXX") && export VOXMAR_CONFIG=$own_config
fi
quiet_flag=${VOXMAR_QUIET_FLAG:-~/Projects/voxmar-wt/QUIET}
play_flag=${VOXMAR_PLAY_FLAG:-~/Projects/voxmar-wt/PLAYING}

# Whether a game Mariano plays is running: voxmar not as a capture or gate run (other runs
# are silent captures, by the rules), or Minecraft.
game_running() {
  # The program is the first word of the arguments: `comm` is cut at 16 characters, which
  # made ./target/release/voxmar look like "release".
  ps -A -o args= | awk '
    { n = split($1, path, "/"); exe = path[n] }
    exe == "voxmar" && !/--capture|--gate/ { found = 1 }
    exe == "java" && tolower($0) ~ /minecraft/ { found = 1 }
    END { exit !found }'
}

# Whether to hold for Mariano's playing: only while PLAYING exists, which the coordinator
# writes when he says he will play (he wants work to go on otherwise, game open or not).
# The flag is kept fresh while his game runs; once none has run for 30 minutes it is
# stale and ignored, so a forgotten flag cannot stall everything.
playing() {
  [[ -e $play_flag ]] || return 1
  if game_running; then
    grep -q '^seen' "$play_flag" || echo "seen his game $(date -u +%FT%TZ)" >>"$play_flag"
    touch "$play_flag"
    return 0
  fi
  # Once his game has been seen and has gone for 30 minutes, he has stopped; until it is
  # first seen, he may take a while to start, so the flag holds for two hours.
  if grep -q '^seen' "$play_flag"; then
    [[ -n $(find "$play_flag" -mmin -30 2>/dev/null) ]]
  else
    [[ -n $(find "$play_flag" -mmin -120 2>/dev/null) ]]
  fi
}

# Whether the command runs the game (a capture, a gate, `cargo run` of the client), which
# competes for the GPU and so waits rather than slowing down.
game=0 package=
previous=
for arg in "$@"; do
  case $arg in
    */voxmar | voxmar | --capture | --gate | --flight | run) game=1 ;;
  esac
  [[ $previous == -p || $previous == --package ]] && package=$arg
  previous=$arg
done
[[ -n $package && $package != voxmar_client ]] && [[ " $* " != *" --capture "* ]] && game=0

quiet() {
  [[ -z $VOXMAR_TIMING && -e $quiet_flag && -n $(find "$quiet_flag" -mmin -20 2>/dev/null) ]]
}

waited=0
while quiet || playing; do
  if ((waited++ % 30 == 0)); then
    if quiet; then echo "memcap: a timing run holds QUIET, waiting (the timing run itself sets VOXMAR_TIMING=1)" >&2; else echo "memcap: Mariano is playing, waiting until he stops" >&2; fi
  fi
  sleep 2
done

slots=${VOXMAR_SLOTS:-4}
lock=
waited=0
while [[ -z $lock ]]; do
  for i in $(seq 1 "$slots"); do
    if shlock -f "/tmp/voxmar-heavy-$i.lock" -p $$; then lock=/tmp/voxmar-heavy-$i.lock; break; fi
  done
  if [[ -z $lock ]]; then
    ((waited++ % 30 == 0)) && echo "memcap: all $slots heavy slots busy, waiting" >&2
    sleep 2
  fi
done

name=$1
"$@" &
child=$!

# The command and all its descendants, by walking parent links.
tree() {
  ps -A -o pid=,ppid= | awk -v root="$child" '
    { parent[$1] = $2 }
    END { for (p in parent) { q = p; while (q > 1) { if (q == root) { print p; break } q = parent[q] } } }'
}

# Builds (anything but a game run or tests, which finish within a minute or two and may
# time themselves) pause while a timing run holds QUIET, so its window starts at once.
pausable=1
((game)) && pausable=0
for arg in "$@"; do [[ $arg == test ]] && pausable=0; done

# Steps out of the way of Mariano's playing and of timing runs: everything pauses while he
# plays, and builds while QUIET is up (`$lock.paused` says so, for the timing run to see).
# Applied again every check, to catch processes the command started since.
paused=0
step_aside() {
  local playing_now=$1 quiet_now=$2 pause=0 pid
  ((playing_now || pausable && quiet_now)) && pause=1
  if ((pause != paused)); then
    if ((pause)); then
      echo "memcap: '$name' paused while $( ((playing_now)) && echo "Mariano plays" || echo "a timing run holds QUIET")" >&2
      : >"$lock.paused"
    else
      echo "memcap: '$name' carries on" >&2
      rm -f "$lock.paused"
    fi
  fi
  if ((pause || paused)); then
    for pid in $(tree); do kill "-$( ((pause)) && echo STOP || echo CONT)" "$pid" 2>/dev/null; done
  fi
  paused=$pause
}

stop() {
  local pids
  pids=$(tree)
  ((paused)) && [[ -n $pids ]] && kill -CONT $pids 2>/dev/null
  [[ -n $pids ]] && kill -9 $pids 2>/dev/null
  rm -f "$lock" "$lock.paused"
  [[ -n $own_config ]] && rm -r "${own_config:?}"
}
trap 'stop; exit 143' TERM INT HUP

cap_kb=$((cap_gb * 1024 * 1024))
ticks=0
while kill -0 "$child" 2>/dev/null; do
  pids=$(tree | tr '\n' ',')
  if [[ -n $pids ]]; then
    kb=$(ps -o rss= -p "${pids%,}" 2>/dev/null | awk '{ s += $1 } END { print s + 0 }')
    if ((kb > cap_kb)); then
      echo "memcap: killed '$*' at $((kb / 1024 / 1024)) GB resident, over the ${cap_gb} GB cap" >&2
      stop
      wait "$child" 2>/dev/null
      exit 137
    fi
  fi
  # Checked every other second.
  if ((ticks++ % 2 == 0)); then
    playing_now=0 quiet_now=0
    playing && playing_now=1
    quiet && quiet_now=1
    ((playing_now || quiet_now || paused)) && step_aside "$playing_now" "$quiet_now"
  fi
  sleep 1
done
wait "$child"
status=$?
rm -f "$lock" "$lock.paused"
[[ -n $own_config ]] && rm -r "${own_config:?}"
exit $status
