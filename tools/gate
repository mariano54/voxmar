#!/bin/bash
# The gates. See docs/quality.md.
#
#   tools/gate                 # before every landing: fast, only what the change can affect
#   tools/gate --full          # everything; play builds are made only from commits it passed
#   tools/gate stop            # stops this worktree's own gate run, and nobody else's
#   tools/gate --passed [--full] [REV]
#                              # exits 0 if REV (default HEAD) passed (the full gate)
#
# Both: hygiene (no whitespace errors, no conflict markers, no test waiting on the wall
# clock: tools/test-waits), a warning-free incremental
# build (`--profile iter`, tests included), tests, and a scripted session in the real game
# with its integrated server running behind (`voxmar --gate`, crates/client/src/gate.rs):
# building, digging, drops, climbing out of water, the menu and inventory, storm and snow,
# the sun, moon and stars, a gorge, leaving the world. The session fails on any failed check, a
# crash, a panic, any ERROR line (wgpu validation errors among them) and any WARN line not
# listed in ALLOWED_WARNINGS. Tests and the session run side by side.
#
# The landing gate runs only the tests of the crates the change can reach (from the files
# it touches against main), skips the slow tests listed in SLOW_TESTS, plays the session
# in a small world, and skips everything a tree already passed. The full gate runs every
# test and plays at the normal view distance, with the steps too long for every landing
# (the workshop's later machine phases, `VOXMAR_GATE_FULL=1`).
#
# Every heavy step runs through ~/Projects/voxmar-wt/memcap. On a clean tree a pass is
# recorded against the tree (so a merge or rebase that changes nothing keeps it). The
# game's log and shots stay in target/gate/ for a look.

set -uo pipefail
# Check and SKIPPED diagnostics are part of the gate's evidence and retry decisions.
# Keep them visible even when the calling shell filters ordinary game logs to warnings.
export RUST_LOG="${RUST_LOG:+$RUST_LOG,}voxmar::gate=info"
cd "$(git rev-parse --show-toplevel)" || exit 2
memcap=~/Projects/voxmar-wt/memcap
# Away from the Mac (a Linux machine, a fresh clone), the copy in this tree.
[[ -x $memcap ]] || memcap=$PWD/tools/memcap
# The gate's build and tests run at utility QoS rather than memcap's background one: they
# may use a performance core his game leaves free (landings wait on them), and PLAYING
# still pauses them while he plays.
export VOXMAR_QOS=utility
passed_dir="$(git rev-parse --git-common-dir)/gate-passed"

# The run in progress in this worktree, for `tools/gate stop`.
pid_file=$PWD/target/gate.pid

# Stops this worktree's gate run: its script and everything it started (memcap passes the
# signal on to the build, the tests and the game). Never stop gates by pattern (`pkill -f
# tools/gate`, `pkill -f voxmar`): that kills every thread's run.
if [[ ${1:-} == stop ]]; then
  pid=$(cat "$pid_file" 2>/dev/null)
  if [[ -z $pid ]] || ! kill -0 "$pid" 2>/dev/null; then
    echo "gate: no gate run in this worktree"
    exit 0
  fi
  descendants=$(ps -A -o pid=,ppid= | awk -v root="$pid" '
    { parent[$1] = $2 }
    END { for (p in parent) { q = p; while (q > 1) { if (q == root) { print p; break } q = parent[q] } } }')
  kill -TERM $descendants "$pid" 2>/dev/null
  rm -f "$pid_file"
  echo "gate: stopped this worktree's run ($pid)"
  exit 0
fi

full=0 check=0 rev=HEAD
while (($#)); do
  case $1 in
    --full) full=1 ;;
    --passed) check=1 ;;
    -*) echo "usage: tools/gate [--full] | tools/gate --passed [--full] [REV]" >&2; exit 2 ;;
    *) rev=$1 ;;
  esac
  shift
done
level=$( ((full)) && echo full || echo landing)

# A tree passed `landing` if either gate passed it, `full` only if the full one did.
passed() {
  local record=$passed_dir/$1
  [[ -e $record ]] && { ((!full)) || grep -q '^full ' "$record"; }
}

if ((check)); then
  tree=$(git rev-parse --verify "$rev^{tree}") || exit 2
  passed "$tree" && { cat "$passed_dir/$tree"; exit 0; }
  echo "gate: $(git rev-parse --short "$rev") has not passed the $level gate" >&2
  exit 1
fi

# WARN lines a session may log, each with why it is expected.
ALLOWED_WARNINGS=(
  # The gate makes the integrated server run behind on purpose (gate::SERVER_LAG).
  'server is running behind, skipping ticks'
)

# Tests too slow for every landing, run by the full gate only: `crate test_name` pairs
# (test names as `cargo test` filters take them).
# Measured alone on 2026-10-05: the next slowest took 7 s.
SLOW_TESTS=(
  voxmar_worldgen fluids_are_contained          # 177 s
  voxmar_worldgen decorations_rest_on_the_ground # 23 s
  voxmar_worldgen wood_never_floats             # 17 s
  voxmar_worldgen rare_herbs_grow_at_their_rates # herb biomes in 3 places a seed, up to 16 seeds
  voxmar_server a_dead_villager_stays_dead_across_a_restart_until_a_newcomer_comes # 62 s at load 74, 2026-10-08; direct lifecycle unit runs at every landing
)

# The crates whose tests a changed file can reach: the crate itself and its dependents.
# Assets reach every crate whose tests read them (engine: crops, movement, recipes, weather;
# texgen: assets/ui/fonts; worldgen, server and client: everything it reads). Music, sounds
# and shader packs are the client's alone; texture packs and fonts are texgen's and the
# client's. A content file that nothing in worldgen reads (quests, recipes, skills, combat,
# lang...) cannot change what its tests generate, so it skips the slow worldgen tests; the
# engine, server and client load all of it, so a bad reference there still fails. What
# worldgen reads is every `*.ron` it names in its sources, the blocks, and the creatures
# its settlements' people are checked against. Anything else reaches all of them.
world_files=
crates_for() {
  case $1 in
    Cargo.toml | Cargo.lock | crates/engine/*) echo voxmar_engine voxmar_worldgen voxmar_server voxmar_client ;;
    assets/music/* | assets/shaderpacks/* | assets/content/*/sounds/*) echo voxmar_client ;;
    assets/packs/* | assets/ui/*) echo voxmar_texgen voxmar_client ;;
    assets/content/*)
      [[ -n $world_files ]] || world_files=$(git grep -hoE '"[a-z_]+\.ron"' -- crates/worldgen | tr -d '"' | sort -u)
      local name=${1##*/}
      if [[ $name == blocks*.ron || $name == creatures*.ron ]] || grep -qxF "$name" <<<"$world_files"; then
        echo voxmar_engine voxmar_worldgen voxmar_server voxmar_client
      else
        echo voxmar_engine voxmar_server voxmar_client
      fi ;;
    assets/*) echo voxmar_engine voxmar_worldgen voxmar_server voxmar_client voxmar_texgen ;;
    crates/worldgen/*) echo voxmar_worldgen voxmar_server voxmar_client ;;
    crates/protocol/*) echo voxmar_server voxmar_client ;;
    crates/server/*) echo voxmar_server voxmar_client ;;
    crates/texgen/*) echo voxmar_texgen voxmar_client ;;
    crates/client/*) echo voxmar_client ;;
  esac
}

# A path in each area reaches the crates whose tests read it.
reach_self_check() {
  local path want
  while IFS='|' read -r path want; do
    [[ " $(crates_for "$path") " == *" $want "* ]] || { echo "gate: $path does not reach $want"; return 1; }
  done <<'EOF_REACH'
assets/content/base/crops.ron|voxmar_engine
assets/content/core/movement.ron|voxmar_engine
assets/content/base/creatures_villagers.ron|voxmar_worldgen
assets/content/base/settlements.ron|voxmar_worldgen
assets/content/base/quests.ron|voxmar_server
assets/content/base/lang/ja.ron|voxmar_client
assets/music/dawn_meadow.mp3|voxmar_client
assets/content/base/blocks.ron|voxmar_worldgen
assets/content/base/blocks.ron|voxmar_server
assets/content/base/blocks.ron|voxmar_client
assets/packs/voxmar/textures/blocks/stone.png|voxmar_texgen
assets/packs/voxmar/textures/blocks/stone.png|voxmar_client
assets/ui/fonts/pixel.ttf|voxmar_texgen
assets/ui/fonts/pixel.ttf|voxmar_client
crates/engine/src/lib.rs|voxmar_server
crates/texgen/src/font.rs|voxmar_client
crates/protocol/src/lib.rs|voxmar_client
Cargo.lock|voxmar_engine
EOF_REACH
  [[ -z $(crates_for docs/quality.md) ]] || { echo "gate: docs reach a crate"; return 1; }
  # The slow worldgen tests are skipped by what worldgen cannot read, and by nothing else.
  for path in assets/content/base/quests.ron assets/content/base/recipes.ron assets/content/core/skills.ron assets/content/base/lang/en.ron assets/music/dawn_meadow.mp3 assets/packs/default/variants.ron; do
    [[ " $(crates_for "$path") " != *" voxmar_worldgen "* ]] || { echo "gate: $path reaches worldgen's tests"; return 1; }
  done
}

started=$(date +%s)
out=$PWD/target/gate
rm -rf "$out" && mkdir -p "$out"
echo $$ >"$pid_file"
trap 'rm -f "$pid_file"' EXIT
fail() {
  echo "gate: FAILED: $*" >&2
  exit 1
}
step() { echo "gate: $* ($(($(date +%s) - started))s)"; }

step "hygiene"
hygiene_base=main
git rev-parse --verify -q main >/dev/null || hygiene_base=origin/main
git diff "$hygiene_base" --check >"$out/hygiene.txt" || { cat "$out/hygiene.txt"; fail "whitespace errors against main"; }
if git grep -nE '^(<<<<<<<|>>>>>>>)( |$)' -- '*.rs' '*.ron' '*.md' '*.wgsl' '*.toml' >"$out/hygiene.txt"; then
  cat "$out/hygiene.txt"
  fail "conflict markers"
fi
tools/bench --self-check || fail "tools/bench's self-check"
reach_self_check || fail "the map from files to the crates they reach"
tools/test-waits --self-check || fail "tools/test-waits' self-check"
# A minute of scratch repos, so only when this branch changes it (what lands goes live on
# the Mac within the hour), and only on a Mac, the one place it runs.
if [[ $(uname -s) == Darwin ]] && ! git diff --quiet "$(git merge-base HEAD "$hygiene_base")" -- tools/tidy; then
  tools/tidy --self-check || fail "tools/tidy's self-check"
fi
[[ $(git rev-parse HEAD) == $(git rev-parse "$hygiene_base") ]] && hygiene_base=origin/main
tools/test-waits "$(git merge-base HEAD "$hygiene_base")" || fail "a test waits on the wall clock"
[[ -z $(git status --porcelain --untracked-files=no) ]] && clean=1 || clean=0
tree=$(git rev-parse HEAD^{tree})
if ((clean)) && passed "$tree"; then
  echo "gate: this tree already passed: $(cat "$passed_dir/$tree")"
  exit 0
fi

# What the change can reach: crates and their dependents, from the files it touches
# against main (or, on main itself, against what was last pushed).
packages=()
session=1
if ((!full)); then
  # A fresh clone (a cloud session) has no local main: origin/main is the base then.
  base=main
  git rev-parse --verify -q main >/dev/null || base=origin/main
  [[ $(git rev-parse HEAD) == $(git rev-parse "$base") ]] && base=origin/main
  changed=$( (git diff --name-only "$(git merge-base HEAD "$base")" HEAD; git diff --name-only HEAD) | sort -u)
  reach() { for p in "$@"; do [[ " ${packages[*]+"${packages[*]}"} " == *" $p "* ]] || packages+=("$p"); done; }
  while read -r path; do
    [[ -n $path ]] && reach $(crates_for "$path")
  done <<<"$changed"
  ((${#packages[@]})) || session=0
fi

# A machine with no display and no GPU (a cloud container) builds and tests but does not play
# the session, and records no pass (the Mac's gate is the landing bar): the session needs a
# GPU. `VOXMAR_GATE_SOFTWARE=1` plays it on a virtual display with Mesa's software Vulkan
# (`apt install xvfb mesa-vulkan-drivers`) instead, as a look rather than a bar: frames take
# half a second there, so steps that time the game (perfect block, dodge, natural births)
# fail on the speed alone, and the run stops at the first one.
norecord=0
if [[ $(uname -s) == Linux && -z ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && ((session)) && [[ -z ${VOXMAR_GATE_SOFTWARE:-} ]]; then
  session=0 norecord=1
  echo "gate: no display here, so the build and tests run but the session is not played, and no pass is recorded"
fi

# A change that reaches no crate (docs, tools) has nothing to build, test or play: main
# built and played as it is, so waiting a build slot for it gains nothing.
log=
if ((!full && !${#packages[@]})); then
  step "build, tests and play skipped: the change reaches no crate"
else

step "build"
$memcap -- cargo build --profile iter --workspace --all-targets >"$out/build.txt" 2>&1 || { tail -40 "$out/build.txt"; fail "the build"; }
if grep -q '^warning' "$out/build.txt"; then
  grep -A6 '^warning' "$out/build.txt" | head -40
  fail "build warnings"
fi

step "tests ($( ((full)) && echo all || echo "${packages[*]+"${packages[*]}"}"))$( ((session)) && echo " and play")"
test_args=(--workspace)
skips=()
if ((!full)); then
  test_args=()
  for p in ${packages[@]+"${packages[@]}"}; do test_args+=(-p "$p"); done
  for ((i = 0; i + 1 < ${#SLOW_TESTS[@]}; i += 2)); do skips+=(--skip "${SLOW_TESTS[i + 1]}"); done
fi
# The test binaries (already built) and the session run side by side (the tests from when the
# session's distant land is in, below), under one memcap
# (one heavy slot, held as a game run's: `--gate` names the script), rather than one after another as `cargo test` runs them; each test
# binary runs from its crate's directory as cargo would.
# The tests run at the lowest priority there is (nice 19), below the session: the session's
# server and renderer must keep up, and the tests' own servers and worlds once starved it so
# far that nine of its checks failed together. At nice 10 a loaded Mac (load 87 to 133 on 18
# cores, build 21) still drew the fight-feel step's frames a quarter second or more apart,
# past the bear's 0.7 s wind-up. Not background QoS: that also throttles timers, and a test
# that times a break by the clock then failed.
# Nor any QoS clamp: memcap runs the pair as his game would (`VOXMAR_FOREGROUND=1`). Under
# memcap's utility clamp the session had it too, and nice 19 bought it little against the
# tests: at load 55 on 18 cores (T3, 2026-10-14) its frames ran 0.5 to 2 s, its threads
# waiting up to 8.5 s for a core within one, and the perfect block judged nothing in ten
# tries. The tests alone at utility QoS kept to the efficiency cores (12 of the 18): the
# worldgen binary alone took 115 s there and 33 s at nice 19 without it (twice the CPU
# time too, 613 s against 301; T7b, 2026-10-14), so nice 19 is all that keeps them under
# the session. PLAYING still pauses both, so neither takes a core from his game.
run='
  out=$1 session=$2; shift 2
  if [[ $session == 1 ]]; then
    (VOXMAR_MUTE=1 $GATE_PREFIX target/iter/voxmar --gate "$out" $GATE_ARGS >"$out/game.txt" 2>&1; echo $? >"$out/game.status") &
    # The tests begin once the session'"'"'s distant land is in (it writes `land-in`, gate.rs
    # `LAND_IN`) or it ended: the land is built on the game'"'"'s own low-priority workers, and
    # with the tests beside it from the start a loaded Mac had 20 of its 568 tiles in when
    # placing began, and breaking waited 42 s for it. A session that tells no land in
    # $LAND_WAIT s (counted while not paused) fails the gate, its tests not run.
    if [[ -s $out/tests.list ]]; then
      waited=0
      while [[ ! -e $out/land-in && ! -e $out/game.status ]]; do
        if ((waited >= LAND_WAIT)); then
          echo "the session told no distant land in $waited s" >"$out/land.timeout"
          cat "$out/land.timeout"
          wait
          exit 1
        fi
        sleep 1
        waited=$((waited + 1))
      done
      echo "gate: the tests began $waited s into the session ($([[ -e $out/land-in ]] && echo "the distant land in at $(cat "$out/land-in") game s" || echo "the session ended first"))"
    fi
  fi
  lower=(nice -n 19 env RAYON_NUM_THREADS=$TEST_POOL)
  while IFS=$(printf "\t") read -r dir exe; do
    (
      cd "$dir" || exit
      RUSTC_BOOTSTRAP=1 "${lower[@]}" "$exe" -Z unstable-options --report-time "$@" >"$out/test-${exe##*/}.txt" 2>&1 &
      pid=$!
      # A test binary still running after $TEST_TIMEOUT s is stopped and fails the gate
      # (a gameplay test once waited 39 minutes on a fight that never came, holding the
      # landing). Counted in steps of ten seconds while it runs: memcap pausing it for
      # Mariano playing pauses this count too.
      ( ran=0
        while kill -0 "$pid" 2>/dev/null; do
          sleep 10
          [[ $(ps -o state= -p "$pid" 2>/dev/null) == T* ]] || ran=$((ran + 10))
          if ((ran >= TEST_TIMEOUT)) && kill -0 "$pid" 2>/dev/null; then
            echo "$ran" >"$out/test-${exe##*/}.timeout"
            kill "$pid"
            break
          fi
        done ) &
      watch=$!
      wait "$pid"
      echo $? >"$out/test-${exe##*/}.status"
      kill "$watch" 2>/dev/null
    ) &
  done <"$out/tests.list"
  wait'
: >"$out/tests.list"
if ((${#test_args[@]})); then
  cargo test --profile iter "${test_args[@]}" --no-run --message-format=json 2>"$out/tests-build.txt" |
    python3 -c '
import json, os, sys
for line in sys.stdin:
    m = json.loads(line)
    if m.get("reason") == "compiler-artifact" and m.get("executable") and m["profile"]["test"]:
        print(os.path.dirname(m["manifest_path"]) + "\t" + m["executable"])' >"$out/tests.list" ||
    fail "building the tests ($out/tests-build.txt)"
fi
# The software session (see `VOXMAR_GATE_SOFTWARE` above): a virtual display and Mesa's lavapipe.
GATE_PREFIX=
if [[ $(uname -s) == Linux && -z ${DISPLAY:-}${WAYLAND_DISPLAY:-} && -n ${VOXMAR_GATE_SOFTWARE:-} ]] && command -v xvfb-run >/dev/null; then
  lvp=$(ls /usr/share/vulkan/icd.d/lvp_icd*.json 2>/dev/null | head -1)
  [[ -n $lvp ]] && export VK_ICD_FILENAMES=$lvp GATE_PREFIX='xvfb-run -a'
fi
export GATE_PREFIX
# The session keeps its settings in a directory of its own, and Mariano's own must not
# change while it runs: a gate run once saved its settings over his.
his_settings=$(if [[ $(uname -s) == Darwin ]]; then echo ~/Library/Application\ Support/voxmar/settings.ron; else echo "${XDG_CONFIG_HOME:-$HOME/.config}/voxmar/settings.ron"; fi)
fingerprint() { [[ -e $his_settings ]] && shasum "$his_settings" | cut -d' ' -f1 || echo none; }
his_before=$(fingerprint)
mkdir -p "$out/config"
# The load average is sampled while the tests run (a measure taken afterwards would only see
# the quiet at the end, where the slowest binary runs alone), for the time budgets below.
: >"$out/load.txt"
( while :; do cut -d' ' -f1 /proc/loadavg 2>/dev/null || sysctl -n vm.loadavg | awk '{ print $2 }'; sleep 10; done >>"$out/load.txt" ) &
sampler=$!
# Each test binary's own threads (worlds made side by side, a test's seeds side by side) take
# at most half the cores: eight test threads to a binary keep the rest busy, and the session's
# server, land generation and renderer, running at full speed outside its lagged steps, keep
# the other half. With every core to each binary, the worldgen tests took 106 s, then 159
# and 194 s on the Mac as the session sped up (and the Mac was busy besides).
TEST_POOL=$(( $(getconf _NPROCESSORS_ONLN) / 2 > 1 ? $(getconf _NPROCESSORS_ONLN) / 2 : 1 ))
# Seconds a test binary may run (not counting time paused for Mariano playing) before it
# is stopped and fails the gate. A loaded Mac's slowest, the full gate's worldgen binary,
# took about 11 minutes; past 30 a binary is stuck, not slow.
TEST_TIMEOUT=${VOXMAR_TEST_TIMEOUT:-1800}
# Seconds the tests wait for the session's distant land at most: alone, it is in within
# seconds of the world loading (the Mac took 56 s with the tests beside it).
LAND_WAIT=120
export TEST_POOL TEST_TIMEOUT LAND_WAIT
VOXMAR_CONFIG=$out/config VOXMAR_GATE_FULL=$full GATE_ARGS=$( ((full)) || echo --view-distance 4) RUST_TEST_THREADS=${RUST_TEST_THREADS:-8} \
  VOXMAR_FOREGROUND=1 $memcap 24 -- bash -c "$run" --gate "$out" "$session" ${skips[@]+"${skips[@]}"} >"$out/run.txt" 2>&1
kill "$sampler" 2>/dev/null

# A check the session skipped (a hitch, on a machine too loaded for a long frame to say
# anything about the game) is not a pass, or a landing could go in untested: once the
# machine has cores to spare, the session plays again on its own and that run is judged.
skipped() { [[ -e $out/game.txt ]] && sed 's/\x1b\[[0-9;]*m//g' "$out/game.txt" | grep -E 'gate: SKIPPED' | sed -E 's/.*gate: //'; }
load_now() { if [[ $(uname -s) == Darwin ]]; then sysctl -n vm.loadavg | awk '{ print $2 }'; else cut -d' ' -f1 /proc/loadavg; fi; }
if ((session)) && [[ -n $(skipped) ]]; then
  skipped
  cores=$(getconf _NPROCESSORS_ONLN)
  step "checks skipped on an overloaded machine; playing again once the load is under $cores"
  for _ in $(seq 80); do
    awk -v l="$(load_now)" -v c="$cores" 'BEGIN { exit !(l < c) }' && break
    sleep 15
  done
  mv "$out/game.txt" "$out/game-skipped.txt"
  # The first run's shots too, for a look at what it saw.
  mkdir -p "$out/first-run" && mv "$out"/*.png "$out/first-run/" 2>/dev/null
  rm -f "$out/game.status"
  mv "$out/tests.list" "$out/tests.list.ran" && : >"$out/tests.list"
  VOXMAR_CONFIG=$out/config VOXMAR_GATE_FULL=$full GATE_ARGS=$( ((full)) || echo --view-distance 4) \
    VOXMAR_FOREGROUND=1 $memcap 24 -- bash -c "$run" --gate "$out" 1 >"$out/rerun.txt" 2>&1
  mv "$out/tests.list.ran" "$out/tests.list"
  if [[ -n $(skipped) ]]; then
    skipped
    fail "checks were skipped twice on an overloaded machine (load $(load_now) on $cores cores); run tools/gate again when it is calmer"
  fi
fi
if [[ $(fingerprint) != "$his_before" ]]; then
  # His own game saves its settings too; only a change made without it counts.
  ps -A -o args= | awk '{ n = split($1, p, "/") } p[n] == "voxmar" && !/--capture|--gate/ { found = 1 } END { exit !found }' ||
    fail "Mariano's settings ($his_settings) changed during the run, and his game was not running"
fi
[[ -e $out/land.timeout ]] && fail "$(cat "$out/land.timeout"), so its tests were not run ($out/game.txt)"
tests_failed=0
for f in "$out"/test-*.status; do
  [[ -e $f ]] || continue
  cat "${f%.status}.txt" >>"$out/tests.txt"
  [[ $(cat "$f") == 0 ]] || tests_failed=1
done
# A binary stopped for running too long: named, with the tests it left running (libtest
# names each one past 60 seconds; those with no result line had not finished).
for f in "$out"/test-*.timeout; do
  [[ -e $f ]] || continue
  txt=${f%.timeout}.txt
  running=$(sed -nE 's/^test (.*) has been running for over 60 seconds$/\1/p' "$txt" | while read -r name; do
    grep -qF "test $name ... " "$txt" || echo "$name"
  done | paste -sd, -)
  echo "gate: ${f##*/test-} stopped after $(cat "$f") s, still running: ${running:-no test past 60 s}" | sed 's/\.timeout / /'
  tests_failed=1
done
if ((tests_failed)); then
  grep -E '^test .* FAILED|^failures:|panicked|^error' "$out/tests.txt" | head -40
  fail "tests (all output in $out/tests.txt)"
fi
# How long the tests took, against tools/test-budget.toml (docs/quality.md, "Fast tests"): the
# slowest are listed every run, a test over its budget fails the gate. The budgets were set
# on the Linux box running the gate (every binary side by side); a busier machine scales them
# by the load it averaged while the tests ran, and a slower one by its slowdown.
#
# The Mac's slowdown, measured when it ran the tests at nice 10 and utility QoS beside the
# played session (nice 19 now, without the QoS),
# which kept them mostly on its efficiency cores, so a calm Mac's landing gate (home #61,
# 2026-10-13, load under the core count) took 3 to 8 times the Linux box's times for the same
# tests, the gate's own build and tests being all its load: at most 3.5 times their budgets
# (the glyph tests 17.4 s against 5), past the rod cast's 81 s (a wall-clock wait, since
# fixed). 5 holds those with room for a busier day and still fails a test grown several times
# slower. VOXMAR_TEST_SLOWDOWN sets it for another machine.
if compgen -G "$out/test-*.txt" >/dev/null; then
  slowdown=${VOXMAR_TEST_SLOWDOWN:-$([[ $(uname -s) == Darwin ]] && echo 5 || echo 1)}
  scale=$(awk -v c="$(getconf _NPROCESSORS_ONLN)" '{ s += $1; n++ } END { s = n ? s / n / c : 1; print (s < 1 ? 1 : s) }' "$out/load.txt")
  # What else the machine runs (an emulator, browsers) must never block a landing: with the
  # load averaged during the tests over the cores, the times are listed, not judged. Judged on
  # a calm machine, where a test's time is its own.
  if awk -v s="$scale" 'BEGIN { exit !(s > 1) }'; then
    tools/test-times "$out" $( ((full)) && echo --full) --scale "$(awk -v s="$scale" -v d="$slowdown" 'BEGIN { print s * d }')" --top 8 || echo "gate: test times not judged: the load during the tests was x$scale over the cores; run tools/gate on a calmer machine to hold them to tools/test-budget.toml"
  else
    tools/test-times "$out" $( ((full)) && echo --full) --scale "$slowdown" --top 8 || fail "test times (tools/test-budget.toml, x$slowdown for this machine's slowdown)"
  fi
fi
status=$(cat "$out/game.status" 2>/dev/null || echo 0)
((session)) && [[ ! -e $out/game.status ]] && fail "the session never ran ($out/run.txt)"
if ((session)); then
  log=$(sed 's/\x1b\[[0-9;]*m//g' "$out/game.txt")
  grep -E 'gate: (FAILED|KNOWN|SKIPPED)' <<<"$log" | sed -E 's/.*gate: //'
  problems=$(grep -E ' ERROR |panicked' <<<"$log")
  warnings=$(grep ' WARN ' <<<"$log")
  for allowed in "${ALLOWED_WARNINGS[@]}"; do
    warnings=$(grep -vF "$allowed" <<<"$warnings")
  done
  [[ -n $warnings ]] && problems+=$'\n'$warnings
  problems=$(grep -v 'gate: FAILED\|gate FAILED' <<<"$problems" | sed '/^$/d')
  [[ -n $problems ]] && { echo "$problems" | head -20; fail "the game logged errors or unexpected warnings ($out/game.txt)"; }
  ((status == 0)) || fail "the game exited with $status ($out/game.txt, shots in $out)"
fi

fi

checks=$(grep -c 'gate: ok' <<<"$log")
((session == 0 || checks > 0)) || fail "the game recorded no gate checks ($out/game.txt)"
ran=$(grep -h '^test result' "$out/tests.txt" 2>/dev/null | awk '{ p += $4 } END { print p + 0 }')
summary="$level passed $(date -u +%FT%TZ) in $(($(date +%s) - started))s: $checks game checks, $ran tests"
if ((norecord)); then
  echo "gate: $summary (the session was not played, so nothing was recorded)"
elif ((clean)); then
  mkdir -p "$passed_dir" && echo "$summary" >>"$passed_dir/$tree"
  echo "gate: $(git rev-parse --short HEAD) $summary"
else
  echo "gate: $summary (uncommitted changes, so nothing was recorded)"
fi
