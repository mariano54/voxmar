// Verdant: a warm, contrasty look after Complementary Reimagined. Warm sun against cool,
// deep shade, soft shadows with wide penumbrae, dark forest floors, corners grounded by
// occlusion, leaves glowing against the sun, light shafts and mist, and a blue haze over
// the distance.
(
    name: "Verdant",
    sun: 1.4,
    sun_tint: (1.12, 1.0, 0.8),
    ambient: 0.5,
    shade_tint: (0.82, 0.95, 1.2),
    haze: 3.0,
    haze_tint: (0.9, 0.97, 1.06),
    mist: 1.0,
    fog: 1.0,
    local_air: 0.7,
    rays: 1.0,
    shadow_softness: 0.025,
    sky_falloff: 3.0,
    ambient_occlusion: 1.6,
    subsurface: 0.35,
    cloud_shadows: 0.5,
    exposure: 1.0,
    contrast: 1.2,
    saturation: 1.05,
    vibrance: 0.15,
    warmth: 0.06,
    bloom: 0.08,
    // Glowing blocks hold their colour a little past where the display starts rolling it
    // towards white.
    glow_peak: 1.15,
    water: (pixelated: true),
    // Fire stays orange by day: a deep yellow core, flames bright enough to read but not
    // to burn out to white where they overlap, smoke lit only just above the flames at
    // night, and embers and sparks solid specks against the sky.
    fire: (
        core: (1.0, 0.58, 0.08),
        glow_added: 1.3,
        glow_solid: 1.25,
        smoke_falloff: 6.0,
        hides: (flame: 0.6, ember: 1.0, spark: 1.0, smoke: 0.0),
    ),
    // Wet ground is darker and glossier, never paler.
    wet: (darkening: 0.3, gloss: 1.15, saturation: 0.3, puddle_mirror: 0.6),
)
