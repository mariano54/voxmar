// Voxmar HD rocks (docs/voxmar-hd.md). Warmer ramps with more shades replace the default
// pack's palettes of the same name, so every texture drawn with them (each rock's raw,
// cobbled, polished and brick forms, and everything derived from those) takes them; the
// `stone` template's members are redrawn at 32×32 for every rock at once.
(
    palettes: {
        // Grey with the barest warmth, violet in the shadows, a little straw in the light.
        "stone": (ramp: "#868684", shades: 6, light: 0.28, hue: 8.0, chroma: -0.3),
        "andesite": (ramp: "#7e7d7b", shades: 6, light: 0.34, hue: 20.0, chroma: -0.3),
        "granite": (ramp: "#93695a", shades: 6, light: 0.34, hue: 18.0, chroma: -0.35),
        "diorite": (ramp: "#c4c0b8", shades: 6, light: 0.3, hue: 20.0, chroma: -0.3),
        "tuff": (ramp: "#77776a", shades: 6, light: 0.32, hue: 20.0, chroma: -0.3),
        "deepslate": (ramp: "#4b4a54", shades: 6, light: 0.3, hue: 16.0, chroma: -0.3),
        "limestone": (ramp: "#c2b799", shades: 6, light: 0.3, hue: 20.0, chroma: -0.3),
        "sandstone": (ramp: "#d6c493", shades: 6, light: 0.3, hue: 18.0, chroma: -0.35),
        "stone_moss": (ramp: "#5f7a33", shades: 6, light: 0.3, hue: 24.0, chroma: -0.3),
    },
    templates: {
        "stone": {
            // Vanilla's design language, our own drawing: sixteen or so rounded stones of
            // varied tone packed in dark mortar, each lit on its top-left edge and rounding
            // into shadow, blotched inside like the raw rock.
            "block/cobbled_{name}": (size: (32, 32), palettes: {"main": "{name}"}, layers: [
                Paint(palette: "main", base: 0.7, shade: [
                    Cells(count: (4, 4), jitter: 0.95, value: 0.45, edge: -1.2, width: 1.0, bevel: 0.6, lip: 0.35, round: 0.45, warp: 2.0),
                    Noise(cells: (16, 16), octaves: 1, amount: 0.3),
                ], clean: true),
            ]),
            // Dressed stone in vanilla's language: a face of clear-shade blotches, finer
            // than the raw rock's, inside a crisp lit top-left edge and a shadowed
            // bottom-right one, so a floor of it reads as laid slabs.
            "block/polished_{name}": (size: (32, 32), palettes: {"main": "{name}"}, layers: [
                Paint(palette: "main", base: 0.6, shade: [
                    Noise(cells: (8, 8), octaves: 2, amount: 0.22),
                    Noise(cells: (32, 32), amount: 0.25),
                    Border(width: 2, amount: -0.3, sides: (0.0, 1.0, 1.0, 0.0)),
                    Border(width: 2, amount: 0.22, sides: (1.0, 0.0, 0.0, 1.0)),
                ], clean: true),
            ]),
            // Two bricks across, four courses, each its own tone, lit on its upper edge,
            // blotched inside like the rock, in dark mortar.
            "block/{name}_bricks": (size: (32, 32), palettes: {"main": "{name}"}, layers: [
                Paint(palette: "main", base: 0.6, shade: [
                    Bricks(size: (16, 8), mortar: -0.6, value: 0.25, bevel: 0.16),
                    Noise(cells: (8, 16), octaves: 2, amount: 0.25),
                    Noise(cells: (32, 32), amount: 0.3),
                ], clean: true),
            ]),
            "block/mossy_cobbled_{name}": (base: "block/cobbled_{name}", palettes: {"moss": "stone_moss"}, layers: [
                Paint(palette: "moss", base: 0.45, shade: [Noise(cells: (8, 8), amount: 0.4), Noise(cells: (32, 32), amount: 0.45)], mask: [Noise(cells: (4, 4), octaves: 2, amount: 1.4), Noise(cells: (16, 16), amount: 0.4)], above: 0.45, clean: true, shadow: -1),
            ]),
            "block/cracked_{name}_bricks": (base: "block/{name}_bricks", layers: [
                Paint(palette: "main", base: 0.05, mask: [Ridge(cells: (3, 3), octaves: 1, width: 0.05, amount: 1.0), Noise(cells: (4, 4), amount: 1.0), Border(width: 3, amount: -3.0)], above: 0.95, light: 1),
            ]),
        },
    },
    textures: {
        // Vanilla's design language at 32×32, our own drawing: grey rock as crisp pixel
        // clusters, like its neighbours cobble and granite, not soft clouds: a quiet broad
        // base, then many clusters two to six texels across in a darker and a lighter
        // shade, a few deep pits and pale flecks. Clusters land anywhere and no one of
        // them is large, so neither turning nor the variants (variants.ron, alternates.ron
        // in the default pack, which redraw this from new seeds) show a repeating mark.
        "block/stone": (size: (32, 32), palettes: {"main": "stone"}, layers: [
            Paint(palette: "main", base: 0.5, shade: [Noise(cells: (8, 8), amount: 0.08)], clean: true),
            Clusters(palette: "main", count: 26, size: (2, 6), spread: (1.3, 0.9), spacing: 3.6, shade: 1, seed: 1),
            Clusters(palette: "main", count: 24, size: (2, 6), spread: (1.3, 0.9), spacing: 3.6, shade: 4, seed: 2),
            Clusters(palette: "main", count: 8, size: (1, 3), spacing: 6.0, shade: 0, seed: 3),
            Clusters(palette: "main", count: 8, size: (1, 2), spacing: 6.0, shade: 5, seed: 4),
        ]),
        // Two more drawings of stone for Voxmar HD's variants.ron, from seeds of their own.
        "block/stone_4": (base: "block/stone", seed: 303),
        "block/stone_5": (base: "block/stone", seed: 404),
        // A mullioned window's stone is the wall's, under a name of its own so only the
        // window glows (the default pack's stone.ron).
        "block/stone_window": (base: "block/stone_bricks"),
        // Ores in vanilla's design language, our own drawing: eight irregular clumps of
        // mineral four to eight texels across in four speckled shades with dark edge
        // texels, drawn over the rock they lie in (their block's `host`). The ores keep
        // the default pack's four-shade palettes: dark, shade, face, highlight.
        "block/hd_nugget_ore": (size: (32, 32), palettes: {"ore": ["#5e4030", "#a77a5c", "#d2a888", "#f0d8c2"]}, layers: [
            Grid(legend: {'o': "ore:0", 'm': "ore:1", 'l': "ore:2", 'h': "ore:3"}, rows: ["..oo.o..", ".ohlmmo.", "ohllmhmo", "olmhllmo", ".omllmo.", "..ommo.o", "...oo..."], at: [(3, 4), (19, 17)], wrap: true),
            Grid(legend: {'o': "ore:0", 'm': "ore:1", 'l': "ore:2", 'h': "ore:3"}, rows: [".oo.o.", "ohlmmo", "olhlmo", ".ommo.", "..o..."], at: [(20, 4), (6, 20)], wrap: true),
            Grid(legend: {'o': "ore:0", 'm': "ore:1", 'l': "ore:2", 'h': "ore:3"}, rows: ["..oo.o..", ".ohlmmo.", "ohllmhmo", "olmhllmo", ".omllmo.", "..ommo.o", "...oo..."], at: [(11, 11)], mirror: true, wrap: true),
            Grid(legend: {'o': "ore:0", 'm': "ore:1", 'l': "ore:2", 'h': "ore:3"}, rows: [".oo..", "ohlo.", "olmmo", ".omo."], at: [(27, 11), (14, 26), (2, 13)], wrap: true),
        ]),
        "block/hd_crystal_ore": (base: "block/hd_nugget_ore", palettes: {"ore": ["#0f5452", "#2fb7b0", "#6ff0e6", "#d8fffb"]}),
        // Richer veins: more and bigger clumps (lodestone, bauxite).
        "block/hd_dense_ore": (base: "block/hd_nugget_ore", layers: [
            Grid(legend: {'o': "ore:0", 'm': "ore:1", 'l': "ore:2", 'h': "ore:3"}, rows: ["..oo.o..", ".ohlmmo.", "ohllmhmo", "olmhllmo", ".omllmo.", "..ommo.o", "...oo..."], at: [(23, 23), (8, 13)], mirror: true, wrap: true),
            Grid(legend: {'o': "ore:0", 'm': "ore:1", 'l': "ore:2", 'h': "ore:3"}, rows: [".oo.o.", "ohlmmo", "olhlmo", ".ommo.", "..o..."], at: [(13, 2), (27, 1)], wrap: true),
        ]),
        // Flaky veins: many small clumps (graphite).
        "block/hd_flake_ore": (size: (32, 32), palettes: {"ore": ["#1c1c1f", "#33343a", "#56585f", "#9aa0aa"]}, layers: [
            Grid(legend: {'o': "ore:0", 'm': "ore:1", 'l': "ore:2", 'h': "ore:3"}, rows: [".oo..", "ohlo.", "olmmo", ".omo."], at: [(2, 3), (11, 6), (22, 2), (6, 14), (17, 12), (27, 15), (3, 24), (13, 22), (22, 25)], wrap: true),
            Grid(legend: {'o': "ore:0", 'm': "ore:1", 'l': "ore:2", 'h': "ore:3"}, rows: [".oo..", "ohlo.", "olmmo", ".omo."], at: [(8, 28), (27, 7), (16, 18)], mirror: true, wrap: true),
        ]),
        // Gems: a few small bright clumps, rarer than metals.
        "block/hd_gem_ore": (size: (32, 32), palettes: {"ore": ["#5e0a17", "#a8162c", "#e64a5e", "#ffc2cb"]}, layers: [
            Grid(legend: {'o': "ore:0", 'm': "ore:1", 'l': "ore:2", 'h': "ore:3"}, rows: [".oo.o.", "ohlmmo", "olhlmo", ".ommo.", "..o..."], at: [(5, 6), (20, 19), (13, 12)], wrap: true),
            Grid(legend: {'o': "ore:0", 'm': "ore:1", 'l': "ore:2", 'h': "ore:3"}, rows: [".oo..", "ohlo.", "olmmo", ".omo."], at: [(22, 5), (7, 22)], mirror: true, wrap: true),
            Shift(by: [Flat(1.0)], mask: [Speckle(chance: 0.03, amount: 1.0, seed: 3)], above: 0.5),
        ]),
        "block/zinc_ore": (base: "block/hd_nugget_ore", palettes: {"ore": ["#4a3418", "#8a6526", "#c49a45", "#ead08a"]}),
        "block/lead_ore": (base: "block/hd_nugget_ore", palettes: {"ore": ["#2c3038", "#4d5563", "#7d8798", "#c3cad6"]}),
        "block/lodestone": (base: "block/hd_dense_ore", palettes: {"ore": ["#141518", "#2a2c33", "#4a4e5a", "#8c93a6"]}),
        "block/bauxite": (base: "block/hd_dense_ore", palettes: {"ore": ["#5e2a14", "#9a4a24", "#c87a46", "#e8b083"]}),
        "block/graphite_ore": (base: "block/hd_flake_ore"),
        "block/ruby_ore": (base: "block/hd_gem_ore"),
        "block/sapphire_ore": (base: "block/hd_gem_ore", palettes: {"ore": ["#0b1f5c", "#1d43a8", "#4f7fe8", "#c6d8ff"]}),
        "block/emerald_ore": (base: "block/hd_gem_ore", palettes: {"ore": ["#0b4a2a", "#168a4d", "#3fd486", "#c8ffe0"]}),
        "block/coal_ore": (base: "block/hd_nugget_ore", palettes: {"ore": ["#121214", "#26262a", "#3a3a40", "#5a5a62"]}),
        "block/iron_ore": (base: "block/hd_nugget_ore", palettes: {"ore": ["#5e4030", "#a77a5c", "#d2a888", "#f0d8c2"]}),
        "block/copper_ore": (base: "block/hd_nugget_ore", palettes: {"ore": ["#5a2a16", "#b05a32", "#de8a54", "#7fcaa6"]}),
        "block/gold_ore": (base: "block/hd_nugget_ore", palettes: {"ore": ["#6e4a0c", "#d39c1e", "#f6d24a", "#fff3a8"]}),
        "block/tin_ore": (base: "block/hd_nugget_ore", palettes: {"ore": ["#4a5458", "#97a5aa", "#c8d4d7", "#eef5f6"]}),
        "block/silver_ore": (base: "block/hd_nugget_ore", palettes: {"ore": ["#5c5f68", "#b0b5c0", "#dfe3ec", "#ffffff"]}),
        "block/diamond_ore": (base: "block/hd_crystal_ore", palettes: {"ore": ["#0f5452", "#2fb7b0", "#6ff0e6", "#d8fffb"]}),
        "block/cobalt_ore": (base: "block/hd_crystal_ore", palettes: {"ore": ["#121c58", "#2d47b8", "#5a80f0", "#b6cbff"]}),
        "block/aetherite_ore": (base: "block/hd_crystal_ore", palettes: {"ore": ["#3a1870", "#8a4cf0", "#c39bff", "#f2e6ff"]}),
    },
)
