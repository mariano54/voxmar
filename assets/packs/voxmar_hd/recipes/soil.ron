// Voxmar HD soils (docs/voxmar-hd.md): dirt, grass, sand and gravel at 32×32. Grass tops
// and the grass fringe stay grey, as the game tints them; their style follows the biome
// thread's meadow turf (`block/meadow_grass_top` in the default pack): fine, soft speckle
// with gentle patches, light flecks of blades catching the sun and a few darker hollows.
(
    palettes: {
        "dirt": (ramp: "#7a5c46", shades: 8, light: 0.3, hue: 18.0, chroma: -0.3),
        "sand": (ramp: "#d9c79b", shades: 8, light: 0.24, hue: 16.0, chroma: -0.3),
        "red_sand": (ramp: "#c0703c", shades: 8, light: 0.26, hue: 14.0, chroma: -0.3),
        "gravel": (ramp: "#8a8682", shades: 8, light: 0.36, hue: 18.0, chroma: -0.25),
        "pebble": (ramp: "#9a918a", shades: 5, light: 0.24, hue: 20.0, chroma: -0.3),
        // Neutral, with a slight warm lift in the light: the tint gives the colour.
        "grass_grey": ["#6e6e6e", "#7a7a7a", "#868686", "#929292", "#9e9e9e", "#aaaaa9", "#b8b8b6", "#c8c8c4"],
    },
    textures: {
        // Soft umber earth: broad damp and dry patches, fine crumb, a few pale grit
        // grains and small pebbles half buried, each with its shadow.
        "block/dirt": (size: (32, 32), palettes: {"main": "dirt", "pebble": "pebble"}, layers: [
            Paint(palette: "main", base: 0.5, shade: [
                Noise(cells: (4, 4), octaves: 2, amount: 0.28),
                Noise(cells: (16, 16), amount: 0.14),
                Grain(0.26),
            ], clean: true),
            Shift(by: [Flat(-2.0)], mask: [Speckle(chance: 0.05, amount: 1.0, seed: 1)], above: 0.5),
            Shift(by: [Flat(1.0)], mask: [Speckle(chance: 0.04, amount: 1.0, seed: 2)], above: 0.5),
            Clusters(palette: "pebble", count: 6, size: (2, 6), spacing: 9.0, shade: 2, shadow: -1, seed: 2),
        ]),
        "block/grass_block_top": (size: (32, 32), palettes: {"main": "grass_grey"}, layers: [
            Paint(palette: "main", base: 0.5, shade: [
                Noise(cells: (4, 4), octaves: 2, amount: 0.22),
                Noise(cells: (16, 16), amount: 0.1),
                Grain(0.3),
            ]),
            // Blade tips catching the light, short upright strokes, and darker hollows.
            Clusters(palette: "main", count: 40, size: (1, 2), spread: (0.2, 2.0), spacing: 3.0, shade: 6),
            Shift(by: [Flat(1.0)], mask: [Speckle(chance: 0.08, amount: 1.0, seed: 4)], above: 0.5),
            Shift(by: [Flat(-1.0)], mask: [Speckle(chance: 0.05, amount: 1.0, seed: 3)], above: 0.5),
        ]),
        // A ragged fringe of thin blades hanging over the dirt, darker where it meets it.
        "block/grass_block_side_overlay": (size: (32, 32), palettes: {"grass": "grass_grey"}, layers: [
            Paint(palette: "grass", base: 0.6, shade: [Grain(0.25), Gradient(from: 0.15, to: -0.6)], mask: [Fringe(depth: (3, 7), smooth: 0.35)], above: 0.5),
            // Single blades hanging lower, a texel wide, darkening down: the shorter of two
            // random reaches, so a few are long and most short.
            Paint(palette: "grass", base: 0.5, shade: [Gradient(from: 0.3, to: -0.9), Grain(0.15)], mask: [Fringe(depth: (0, 13), smooth: 0.0, seed: 3), Fringe(depth: (0, 13), smooth: 0.0, seed: 6)], above: 1.5),
            Shift(by: [Flat(1.0)], mask: [Speckle(chance: 0.07, amount: 1.0, seed: 5)], above: 0.5),
        ]),
        "block/grass_block_side": (base: "block/dirt", layers: [
            Stamp(texture: "block/grass_block_side_overlay", shadow: -1),
        ]),
        // Pale straw sand: very soft variation, fine grains of a few colours, a sprinkle
        // of darker mineral grains and a few bright quartz ones.
        "block/sand": (size: (32, 32), palettes: {"main": "sand"}, layers: [
            Paint(palette: "main", base: 0.55, shade: [
                Noise(cells: (4, 4), octaves: 2, amount: 0.2),
                Grain(0.22),
            ], clean: true),
            Shift(by: [Flat(-2.0)], mask: [Speckle(chance: 0.035, amount: 1.0, seed: 1)], above: 0.5),
            Shift(by: [Flat(-1.0)], mask: [Speckle(chance: 0.06, amount: 1.0, seed: 2)], above: 0.5),
            Shift(by: [Flat(2.0)], mask: [Speckle(chance: 0.025, amount: 1.0, seed: 3)], above: 0.5),
        ]),
        "block/red_sand": (base: "block/sand", palettes: {"main": "red_sand"}),
        // Loose stones of many sizes, each rounded and lit, a few of warmer rock, over
        // dark gaps.
        "block/gravel": (size: (32, 32), palettes: {"main": "gravel", "warm": (ramp: "#8f7c70", shades: 6, light: 0.3, hue: 18.0, chroma: -0.3)}, layers: [
            Paint(palette: "main", base: 0.56, shade: [
                Cells(count: (7, 7), jitter: 1.0, value: 0.5, edge: -0.55, width: 1.0, bevel: 0.45, round: 0.35, warp: 1.2),
                Grain(0.1),
            ], clean: true),
            Clusters(palette: "warm", count: 3, size: (6, 12), spacing: 11.0, shade: 3, shadow: -1),
            Clusters(palette: "main", count: 8, size: (2, 5), spacing: 6.0, shade: 5, shadow: -1, seed: 1),
        ]),
    },
)
