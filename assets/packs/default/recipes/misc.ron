// Water, glass, light blocks, cactus, roots, the climate colour maps and HUD sprites.
(
    textures: {
        // Grey and see-through: the game tints water by climate.
        "block/water_still": (palettes: {"main": ["#8e939cb0", "#a0a5adb0", "#b2b6bdb4", "#c5c8cdb8", "#d8dadebc"]}, layers: [
            Paint(palette: "main", base: 0.45, shade: [
                Noise(cells: (4, 4), octaves: 2, amount: 0.35),
                Stripes(period: 8.0, width: 0.25, amount: 0.2, slope: 0.5, warp: 1.5),
                Stripes(period: 8.0, width: 0.125, amount: -0.2, slope: 0.5, warp: 1.5, phase: 4.0),
            ], clean: true),
        ]),
        // Molten rock: bright flowing streaks between darker cooling crust.
        "block/lava_still": (palettes: {"main": ["#8a1e06", "#b8340a", "#dc5410", "#f27c1c", "#fca63a", "#ffd66e"]}, layers: [
            Paint(palette: "main", base: 0.36, shade: [
                Cells(count: (4, 4), jitter: 1.0, value: 0.25, edge: 0.45, width: 1.0, bevel: 0.0, round: -0.2, warp: 1.5),
                Noise(cells: (4, 4), octaves: 2, amount: 0.4),
                Stripes(period: 8.0, width: 0.25, amount: 0.15, slope: 0.5, warp: 1.5),
            ], clean: true),
        ]),
        "block/glass": (palettes: {"frame": ["#8fb3bf", "#c3dce4", "#eef8fb"]}, layers: [
            Paint(palette: "frame", base: 0.4, shade: [Border(width: 1, amount: 0.4, sides: (1.0, 0.0, 0.0, 1.0)), Border(width: 1, amount: -0.4, sides: (0.0, 1.0, 1.0, 0.0))], mask: [Border(width: 1, amount: 1.0)], above: 0.5),
            Grid(legend: {'w': "#ffffffd0", 'l': "#e2f3f8a0"}, rows: [
                "................",
                "................",
                "...........w....",
                "..........w.....",
                ".........w......",
                "....l...w.......",
                "...l...w........",
                "..l.............",
                "................",
                "................",
                "............l...",
                "...........l....",
                "..........l.....",
                "................",
                "................",
                "................",
            ]),
        ]),
        // A window before glass: oiled hide stretched in a stick frame with a cross of sticks,
        // amber and a little blotchy. Its pane is bright enough to glow by a lit room's light
        // through it (`lit_through`); the frame stays dark.
        "block/hide_window": (palettes: {"pane": ["#a8743a", "#bf8a4c", "#d29e5e", "#e2b474"], "frame": ["#4e3420", "#6a4a2c", "#86603a"]}, layers: [
            Paint(palette: "pane", base: 0.6, shade: [Noise(cells: (4, 4), octaves: 2, amount: 0.45), Noise(cells: (16, 16), amount: 0.25)]),
            Paint(palette: "frame", base: 0.5, shade: [Border(width: 1, amount: 0.35, sides: (1.0, 0.0, 0.0, 1.0)), Border(width: 1, amount: -0.35, sides: (0.0, 1.0, 1.0, 0.0)), Noise(cells: (16, 16), amount: 0.3)], mask: [Border(width: 2, amount: 1.0)], above: 0.5),
            Grid(legend: {'f': "#6a4a2c", 'h': "#86603a", 'd': "#4e3420"}, rows: [
                "................",
                "................",
                ".......hf.......",
                ".......hf.......",
                ".......hf.......",
                ".......hf.......",
                ".......hf.......",
                "..hhhhhhfhhhhh..",
                "..ffffffdfffff..",
                ".......hf.......",
                ".......hf.......",
                ".......hf.......",
                ".......hf.......",
                ".......hf.......",
                "................",
                "................",
            ]),
        ]),
        // Old glass, from abandoned windows: a weathered lead frame round a cloudy, faintly
        // green pane, uneven in thickness, with a crack across one corner.
        "block/old_glass": (size: (32, 32), palettes: {"frame": ["#4a4e4c", "#6a706c", "#8c928c"], "pane": ["#b8c8b080", "#c8d6c090", "#d6e2cc98", "#e2ecdaa0"]}, layers: [
            Paint(palette: "pane", base: 0.45, shade: [Noise(cells: (4, 4), octaves: 2, amount: 0.5), Noise(cells: (16, 16), amount: 0.3)], clean: true),
            Paint(palette: "frame", base: 0.5, shade: [Border(width: 1, amount: 0.35, sides: (1.0, 0.0, 0.0, 1.0)), Border(width: 1, amount: -0.35, sides: (0.0, 1.0, 1.0, 0.0)), Noise(cells: (16, 16), amount: 0.3)], mask: [Border(width: 2, amount: 1.0)], above: 0.5),
            Grid(legend: {'c': "#3a403cc0", 'l': "#f4f8eec0"}, rows: [
                "................................",
                "................................",
                "......................c.........",
                "......................c.........",
                ".....................cl.........",
                "....................c...........",
                "...................cl...........",
                "..................c.............",
                "................cc..............",
                "...............c................",
                "..............c.................",
                "..............l.................",
            ], at: [(2, 0)]),
        ]),
        "block/glowstone": (palettes: {"main": ["#6b4a1c", "#a8742c", "#d9a341", "#f2c766", "#ffe196", "#fff4cc"]}, layers: [
            Paint(palette: "main", base: 0.6, shade: [Cells(count: (4, 4), jitter: 1.0, value: 0.5, edge: -0.55, bevel: 0.35, warp: 1.0), Speckle(chance: 0.1, amount: 0.3)], clean: true),
