                Stripes(period: 8.0, width: 0.25, amount: 1.0, slope: -1.0, warp: 1.2, phase: 3.0, seed: 2),
            ], above: 0.5, shadow: -1),
        ]),
        "block/mangrove_roots_top": (base: "block/mangrove_roots_side", seed: 77),
        "block/azalea_leaves": (base: "block/oak_leaves", palettes: {"leaves": ["#33501c", "#406223", "#4f752b", "#5f8834", "#709b3e", "#82ae4a"]}),
        "block/flowering_azalea_leaves": (base: "block/azalea_leaves", palettes: {"bloom": ["#7a2f7c", "#a8459f", "#cf64be", "#ec8ad6"]}, layers: [
            Clusters(palette: "bloom", count: 6, size: (2, 4), spacing: 4.5, shade: 1, seed: 5),
