        // Climate colour maps: left hot, right cold; top wet, bottom dry.
        "colormap/grass": (size: (256, 256), layers: [Corners("#4ab434", "#57a266", "#b8b046", "#7cab6c")]),
        "colormap/foliage": (size: (256, 256), layers: [Corners("#2aa812", "#3e9450", "#aaa428", "#5aa25a")]),
