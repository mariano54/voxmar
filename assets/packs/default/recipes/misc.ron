        "block/sea_lantern": (palettes: {"main": ["#5d8d8a", "#86b3ad", "#aed2cb", "#cfe7e1", "#e9f6f2", "#fbfffd"]}, layers: [
            Paint(palette: "main", base: 0.7, shade: [
