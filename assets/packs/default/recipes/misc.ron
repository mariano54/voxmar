        // A tangle of roots: two sets of wavy diagonal strands crossing, gaps between.
        "block/mangrove_roots_side": (palettes: {"root": ["#2f2118", "#40301f", "#523e28", "#644d33", "#765c3e"]}, layers: [
            Paint(palette: "root", base: 0.5, shade: [Noise(cells: (4, 4), amount: 0.5), Grain(0.3), Stripes(period: 8.0, width: 0.125, amount: 0.25, slope: 1.0, warp: 1.0)], mask: [
