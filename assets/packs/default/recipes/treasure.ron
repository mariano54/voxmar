// Treasure (content: base/blocks_treasure.ron): locked chests are the plain chest bound in
// iron with a lock plate in the metal of the chest's age (the `lock` slot, `Q` and `q`):
// bone for the Nomad age, then copper, bronze, iron and the Steam age's brass, so a player
// can tell which lockpick a chest wants (one of the age before, or later). Lockpicks are a
// pin on a twine grip, drawn once in the metal palette's three shades (`a`-`c`) and
// recoloured per material.
(
    legend: {'a': "head:0", 'b': "head:1", 'c': "head:2", 'D': "#1a140e", 'K': "#1e2024", 'i': "#4a4e56", 'j': "#6e737c", 'L': "#c4c9d2", 'w': "#e0cc98", 'l': "#a88a50", 'Q': "lock:2", 'q': "lock:1"},
    palettes: {
        "lock_nomad": ["#6e6450", "#cfc4a8", "#f2ead6"],
        "lock_farm": ["#7a3a18", "#c06a38", "#f0a070"],
        "lock_bronze": ["#6e4418", "#b07a3a", "#e8b46a"],
        "lock_iron": ["#5a5e66", "#a0a6b0", "#e2e6ee"],
        "lock_steam": ["#5a400c", "#b08a28", "#f0cc50"],
    },
    textures: {
        "block/treasure_chest_side": (base: "block/chest_side", palettes: {"lock": "lock_steam"}, layers: [Grid(rows: [
            "................",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij.KKKK.ji...",
            "...ij.KQQK.ji...",
            "...ij.KQDK.ji...",
            "...ij.KQDK.ji...",
            "...ij.KqqK.ji...",
            "...ij.KKKK.ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "................",
        ])]),
        "block/nomad_treasure_chest_side": (base: "block/treasure_chest_side", palettes: {"lock": "lock_nomad"}),
        "block/farm_treasure_chest_side": (base: "block/treasure_chest_side", palettes: {"lock": "lock_farm"}),
        "block/bronze_treasure_chest_side": (base: "block/treasure_chest_side", palettes: {"lock": "lock_bronze"}),
        "block/iron_treasure_chest_side": (base: "block/treasure_chest_side", palettes: {"lock": "lock_iron"}),
        "block/steam_treasure_chest_side": (base: "block/treasure_chest_side", palettes: {"lock": "lock_steam"}),
        "block/treasure_chest_top": (base: "block/chest_top", layers: [Grid(rows: [
            "................",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...ij......ji...",
            "...LL......LL...",
            "................",
        ])]),
        "block/bone_lockpick": (base: "shape/plant", palettes: {"head": ["#8a7e66", "#cfc4a8", "#f2ead6"]}, layers: [Grid(rows: [
            "................",
            "................",
            "...........Da...",
            "..........Dcb...",
            ".........Dca....",
            "........Dcb.....",
            ".......Dcb......",
            "......Dcb.......",
            ".....DwlD.......",
            "....DwlwD.......",
            "...DlwlD........",
            "...DwlwD........",
            "....DDD.........",
            "................",
            "................",
            "................",
        ])]),
        "block/copper_lockpick": (base: "block/bone_lockpick", palettes: {"head": ["#7a3a18", "#c06a38", "#f0a070"]}),
        "block/bronze_lockpick": (base: "block/bone_lockpick", palettes: {"head": ["#7a4a1a", "#c0803a", "#ecb878"]}),
        "block/iron_lockpick": (base: "block/bone_lockpick", palettes: {"head": ["#5a5e66", "#a0a6b0", "#e2e6ee"]}),
    },
)
