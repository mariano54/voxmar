// Grasses, ferns, bushes, mushrooms and wild flowers, drawn as text sprites from the
// bottom edge up. Every grid in this book shares one legend: `a`–`e` leaf and stem
// greens (dark to light), `p`–`s` petals, `x`–`z` flower centres, `k`–`m` wood, `f`, `h`,
// `j` fruit and `W` a white highlight. Recipes start from `shape/plant`, which gives every
// palette a default, and replace the ones they colour differently. Grass, ferns and sugar
// cane are grey: the game tints them with the climate's grass colour.
(
    legend: {
        'a': "leaf:0", 'b': "leaf:1", 'c': "leaf:2", 'd': "leaf:3", 'e': "leaf:4",
        'p': "petal:0", 'q': "petal:1", 'r': "petal:2", 's': "petal:3",
        'x': "centre:0", 'y': "centre:1", 'z': "centre:2",
        'k': "wood:0", 'l': "wood:1", 'm': "wood:2",
        'f': "fruit:0", 'h': "fruit:1", 'j': "fruit:2",
        'W': "#f4f1ea",
    },
    palettes: {
        "green": ["#1d3a13", "#2b5018", "#3c681f", "#518229", "#6a9c35"],
        "grey": ["#5c5c5c", "#737373", "#8a8a8a", "#a2a2a2", "#bababa"],
        "red": ["#7e1616", "#b42420", "#dc3c2e", "#f2705a"],
        "yellow": ["#a07410", "#d8a81c", "#f2cc34", "#fff08a"],
        "white": ["#8e949c", "#c4c8ce", "#e6e8ec", "#ffffff"],
        "blue": ["#1c2c80", "#2c48b8", "#4a72e0", "#86a8f6"],
        "purple": ["#4e1c6e", "#7230a0", "#9a50c8", "#c486ea"],
        "pink": ["#a4386a", "#d0588e", "#ec82ae", "#fbb4cf"],
        "orange": ["#9a3a0c", "#d05a14", "#f08226", "#ffb05a"],
    },
    textures: {
        "shape/plant": (palettes: {
            "leaf": "green", "petal": "red", "centre": ["#3a2a12", "#a8781c", "#f2cc40"],
            "wood": ["#3c2a1a", "#5a412a", "#7a5a3c"], "fruit": ["#4a0e14", "#8e1c28", "#d8404e"],
            "glow": ["#ffe8a0", "#fff4d0", "#ffffff"],
        }),
        "block/fern": (base: "shape/plant", palettes: {"leaf": "grey"}, layers: [Grid(rows: [
            "................",
            "................",
            "................",
            "................",
            ".......e........",
            "..e...ded...e...",
            "..dd.ede.d.dd...",
            "...dcdd.dedc..e.",
            ".e..cdc.dcd..dd.",
            ".dd..cd.dc..dc..",
            "..dcc.cdc.ccd...",
            "e..dccbcbccd..e.",
            "dd...cbcbc...dd.",
            ".dccc.bcb.cccd..",
            "....cc.b.cc.....",
            ".......b........",
        ])]),
        "block/large_fern_bottom": (base: "shape/plant", palettes: {"leaf": "grey"}, layers: [Grid(rows: [
            "..d....c....d...",
            "..dd..dcd..dd...",
            "e..dc.dcd.cd..e.",
            "dd..cdcbcdc..dd.",
            ".dcc.cbcbc.ccd..",
            "...ccbcbcbcc....",
            ".e...cbcbc...e..",
            ".ddc..cbc..cdd..",
            "...dcccbccc.....",
            ".d...ccbcc...d..",
            ".dcc..cbc..ccd..",
            "...ccc.b.ccc....",
            "......cbc.......",
            "...ccc.b.ccc....",
            ".......b........",
            ".......b........",
        ])]),
        "block/large_fern_top": (base: "shape/plant", palettes: {"leaf": "grey"}, layers: [Grid(rows: [
            "................",
            "................",
            "................",
            "................",
            ".......e........",
            "......ded.......",
            ".....edcde......",
            "..e...dcd...e...",
            "..dd..dcd..dd...",
            "...dc.dcd.cd....",
            ".e..cddcddc..e..",
            ".dd..cdcdc..dd..",
            "..dcc.cbc.ccd...",
            "....ccbcbcc.....",
            "..dd..cbc..dd...",
            "...dcc.c.ccd....",
        ])]),
        "block/sugar_cane": (base: "shape/plant", palettes: {"leaf": "grey"}, layers: [Grid(rows: [
            "...e.......e....",
            "..ed...c..de....",
            "..dc..cd..dc....",
            "..dc.e.c..dc..e.",
            "..bb.ed...bb..d.",
            "..dc.dc...dc..dc",
            "..dc.dcc..dc.cdc",
            "..dc.bb...dc..bb",
            "e.dc.dc...bb..dc",
            "dcbb.dc...dc..dc",
            "..dc.dc..edc..dc",
            "..dc.bb..cdc..dc",
            "..dc.dc...dc..bb",
            "..dc.dc...bb..dc",
            "..bb.dc...dc..dc",
            "..dc.dc...dc..dc",
        ])]),
        "shape/tulip": (base: "shape/plant", layers: [Grid(rows: [
            "................",
            "................",
            "................",
            "................",
            ".....r.s.r......",
            ".....rsrsr......",
            ".....qrsrq......",
            ".....qrrrq......",
            "......qqq.......",
            ".......c........",
            ".......c........",
            "..dc...c...cd...",
            "...dc..c..cd....",
            "...bdc.c.cdb....",
            "....bcdcdcb.....",
            "......bcb.......",
        ])]),
    },
)
