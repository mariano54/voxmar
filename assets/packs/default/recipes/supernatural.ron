// Supernatural plants: rare, slightly fantastic crops and wild finds that tie into
// creatures and dishes (docs/systems-web.md, "Plants wanted"). Each recolours a familiar
// shape and adds faint glints, so they read as kin of ordinary plants with something odd
// about them. Glowing ones glow dimly.
(
    legend: {
        'a': "leaf:0", 'b': "leaf:1", 'c': "leaf:2", 'd': "leaf:3", 'e': "leaf:4",
        'p': "petal:0", 'q': "petal:1", 'r': "petal:2", 's': "petal:3",
        'x': "centre:0", 'y': "centre:1", 'z': "centre:2",
        'k': "wood:0", 'l': "wood:1", 'm': "wood:2",
        'f': "fruit:0", 'h': "fruit:1", 'j': "fruit:2",
        'u': "glow:0", 'v': "glow:1", 'w': "glow:2",
        'W': "#f4f1ea",
    },
    palettes: {
