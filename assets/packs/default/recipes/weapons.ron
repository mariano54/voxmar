// Weapon sprites (content: base/blocks_weapons.ron, combat.ron). One drawing per class,
// recoloured per material: `a`-`c` the blade or head (dark to light), `g` and `h` the guard
// and pommel, `k` and `l` the grip. Drawn by a small script from lines on the grid, then
// outlined in `D`.
(
    legend: {'a': "blade:0", 'b': "blade:1", 'c': "blade:2", 'g': "guard:1", 'h': "guard:2", 'k': "grip:0", 'l': "grip:1", 'D': "#1a140e"},
    palettes: {
        "weapon_stone": ["#4a4a50", "#7a7a82", "#a8a8b0"],
        "weapon_copper": ["#7a3a18", "#c06a38", "#f0a070"],
        "weapon_bronze": ["#6e4418", "#b07a3a", "#e8b46a"],
        "weapon_iron": ["#5a5e66", "#a0a6b0", "#e2e6ee"],
        "weapon_bone": ["#a89878", "#d8ccb0", "#f4eedc"],
        "weapon_guard": ["#3a3430", "#5e5650", "#8a8078"],
        "weapon_horn": ["#3a2c22", "#5a4434", "#7e624a"],
        "weapon_wood": ["#4a3018", "#7e5a34", "#a87c48"],
        "weapon_leather": ["#3e2616", "#6a4428", "#8e623c"],
        "weapon_flint": ["#2e2e34", "#55555e", "#86868f"],
        "weapon_ivory": ["#b4a684", "#e2d8bc", "#fffaec"],
    },
    textures: {
        // A sword: a straight blade, a cross guard and a short grip.
        "block/stone_sword": (base: "shape/plant", palettes: {"blade": "weapon_stone", "guard": "weapon_wood", "grip": "weapon_wood"}, layers: [Grid(rows: [
            "................",
            ".............DD.",
            "............DcbD",
            "...........DcbD.",
            "..........DcbaD.",
            ".........DcbaD..",
            "........DcbaD...",
            ".......DcbaD....",
            "...D..DcbaD.....",
            "..DgDDcbaD......",
            "...DgcbaD.......",
            "....DhaD........",
            "...DlDgD........",
            "..DkD.DgD.......",
            ".DhD...D........",
            "..D.............",
        ])]),
        "block/copper_sword": (base: "block/stone_sword", palettes: {"blade": "weapon_copper", "guard": "weapon_guard", "grip": "weapon_leather"}),
        "block/bronze_sword": (base: "block/stone_sword", palettes: {"blade": "weapon_bronze", "guard": "weapon_guard", "grip": "weapon_leather"}),
        "block/iron_sword": (base: "block/stone_sword", palettes: {"blade": "weapon_iron", "guard": "weapon_guard", "grip": "weapon_leather"}),
        // A club: a knob of bone on a haft.
        "block/bone_club": (base: "shape/plant", palettes: {"blade": "weapon_bone", "guard": "weapon_bone", "grip": "weapon_wood"}, layers: [Grid(rows: [
            "................",
            "..........DD....",
            ".........DbbDD..",
            "........DccbbcD.",
            ".......DbcbbbbD.",
            ".......DbbbbabD.",
            ".......DcbbbaD..",
            ".......DkDbaD...",
            "......DklDDD....",
            ".....DklD.......",
            "....DklD........",
            "...DklD.........",
            "..DklD..........",
            "..DlD...........",
            ".DkD............",
            "..D.............",
        ])]),
        // A dagger: a fang for a blade, a horn guard and a bound grip.
        "block/tusk_club": (base: "block/bone_club", palettes: {"blade": "weapon_ivory", "guard": "weapon_ivory", "grip": "weapon_leather"}),
