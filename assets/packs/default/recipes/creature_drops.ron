// What creatures drop (content/base/blocks_creatures.ron), drawn as item sprites in a few
// shapes shared by many items, each in its own palettes: a cut of meat, a hide, a feather,
// a bone, a tooth or claw, an antler, a tuft of wool, a lump of fat, a coil of silk, a sac,
// a pile of dust, a blob of slime and a mote. Legend: `f`, `h`, `j` the main colour (dark,
// middle, light), `k`, `l`, `m` the second (fat, bone, rim), `u`–`w` glow, `W` white and
// `D` a dark outline.
(
    legend: {
        'f': "fruit:0", 'h': "fruit:1", 'j': "fruit:2",
        'k': "wood:0", 'l': "wood:1", 'm': "wood:2",
        'u': "glow:0", 'v': "glow:1", 'w': "glow:2",
        'W': "#fbf8ee", 'D': "#2a2220",
    },
    palettes: {
        "meat_small_game": ["#8e3a3a", "#c8605a", "#e88c80"],
        "meat_duck": ["#7a2e2e", "#b0504a", "#d07c70"],
        "meat_mutton": ["#7a1e1e", "#b03a34", "#d8665c"],
        "meat_pork": ["#b05a5a", "#e48c8c", "#f8b8b0"],
