// Tool sprites (content: base/blocks_tools.ron, tools.ron). One drawing per kind, recoloured
// per tier: `a`-`c` the head (dark to light), `k`-`m` the haft. Generated; edit the shapes
// in one place and regenerate rather than each tier by hand.
(
    legend: {'a': "head:0", 'b': "head:1", 'c': "head:2", 'k': "haft:0", 'l': "haft:1", 'm': "haft:2", 'D': "#1a140e"},
    palettes: {
        "haft": ["#4a3018", "#7e5a34", "#a87c48"],
        // A firebrand's flame (dark to bright) and a burnt-out stick.
        "flame": ["#c03a0c", "#f08a1c", "#ffd25a"],
        "burnt_stick": ["#5a3a24", "#2a221c", "#4a3c32"],
        "tool_flint": ["#2c2e36", "#4e5260", "#8a8e9c"],
        "tool_wooden": ["#5e4024", "#8a6234", "#b88a50"],
        "tool_stone": ["#4a4a50", "#7a7a82", "#a8a8b0"],
        "tool_copper": ["#7a3a18", "#c06a38", "#f0a070"],
        "tool_bronze": ["#6a4418", "#b8823c", "#ecc27a"],
        "tool_iron": ["#5a5e66", "#a0a6b0", "#e2e6ee"],
        // Fish, raw (the `head` of each fish's sprite; Voxmar HD draws its own fish in these),
        // and every fish cooked.
        "fish_minnow": ["#5a6a70", "#90a4aa", "#c8d8dc"],
        "fish_sardine": ["#3a5a80", "#7aa0c8", "#d0e4f4"],
