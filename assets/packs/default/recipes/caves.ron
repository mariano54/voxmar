            ".edcdede.dcde.de",
            "edcdcdcdcdcdcdcd",
            "cdcbcdcbcdcbcdcb",
            "bcbcbcbcbcbcbcbc",
        ])]),
        "block/hanging_roots": (base: "shape/plant", palettes: {"wood": "root"}, layers: [Grid(rows: [
            "..lmlk.klml.mlk.",
            "...ml...lm..lk..",
            "...l.....l...l..",
            "..l......ml..k..",
            "..l.......l..l..",
            "...k.....l....l.",
