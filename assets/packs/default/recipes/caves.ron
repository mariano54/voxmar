        "red_cap": ["#7a1210", "#9a1a16", "#b8241c", "#d03428", "#e24c3c"],
        "stem_pale": ["#a89e8c", "#bcb3a0", "#cec6b4", "#ddd6c6", "#ebe6da"],
    },
    textures: {
