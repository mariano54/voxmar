// Cave blocks and volcanic glass: dripstone, glow berries and lichen, moss carpet, hanging
// roots, crystals, magma, gloomvein, mushroom blocks and obsidian. Sprites use the same
// legend as plants.ron. The palettes here (crystal glows, dripstone, glowberry and the
// wonders' new colours) are shared with the other books.
(
    legend: {
        'a': "leaf:0", 'b': "leaf:1", 'c': "leaf:2", 'd': "leaf:3", 'e': "leaf:4",
        'p': "petal:0", 'q': "petal:1", 'r': "petal:2", 's': "petal:3",
        'x': "centre:0", 'y': "centre:1", 'z': "centre:2",
        'k': "wood:0", 'l': "wood:1", 'm': "wood:2",
        'f': "fruit:0", 'h': "fruit:1", 'j': "fruit:2",
        'u': "glow:0", 'v': "glow:1", 'w': "glow:2",
        'W': "#f4f1ea",
    },
    palettes: {
        "starlily": ["#a89464", "#dccc96", "#f6eed4", "#ffffff"],
        "gold_centre": ["#c08a10", "#f0c030", "#fff090"],
        "sunspire": ["#b86a10", "#f0a020", "#ffd040", "#fff4a0"],
        "ice_glow": ["#a0e8ff", "#d8f8ff", "#ffffff"],
        "cyan_glow": ["#5ae0f0", "#a8f4ff", "#ffffff"],
        "rock": ["#3a3e48", "#5a606c", "#7e8694"],
        "wiry": ["#8c7a5c", "#9c8a6a", "#ac9a78"],
        "dripstone": ["#6a5446", "#8a705e", "#a88e78"],
        "vine": ["#1e3a12", "#2c5018", "#3e6820", "#548228", "#6c9a34"],
        "glowberry": ["#c86a10", "#ffb030", "#ffe890"],
        "lichen": ["#3e5a4a", "#527262", "#688a78", "#80a290", "#9abaa8"],
        "lichen_glow": ["#8ad8b0", "#c4f4d8", "#f0fff6"],
        "obsidian": ["#0b0912", "#13101d", "#1c1729", "#272038", "#352c4c", "#4a3e68"],
        "magma": ["#3a1008", "#5c1a0a", "#8a2a0c", "#c2440e", "#f07a1c", "#ffb84a"],
        "crystal_rock": ["#4a3a6a", "#5e4c86", "#7462a4", "#8e7ec0", "#aa9cd8", "#cac0ee"],
        "gloom": ["#060c10", "#0a1418", "#0f1d22", "#15272e", "#1d343c", "#27444e"],
        "gloom_glow": ["#1a8a9a", "#3cc8d8", "#9cf4ff"],
        "brown_cap": ["#5a3e2a", "#6e4c34", "#82593e", "#94684a", "#a67858"],
        "red_cap": ["#7a1210", "#9a1a16", "#b8241c", "#d03428", "#e24c3c"],
        "stem_pale": ["#a89e8c", "#bcb3a0", "#cec6b4", "#ddd6c6", "#ebe6da"],
    },
    textures: {
