        "block/crystal_cluster": (base: "shape/plant", palettes: {"petal": ["#4a3a6a", "#7462a4", "#aa9cd8", "#e6e0ff"], "glow": "ice_glow"}, layers: [Grid(rows: [
            "................",
            "................",
            "................",
            ".......s........",
