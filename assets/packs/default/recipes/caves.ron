        "block/dripstone_block": (palettes: {"main": ["#5c483c", "#6e584a", "#806858", "#927a68", "#a48c78", "#b8a08c"]}, layers: [
            Paint(palette: "main", base: 0.52, shade: [Stripes(vertical: true, period: 4.0, width: 0.25, amount: -0.3, warp: 1.0), Noise(cells: (8, 2), octaves: 2, amount: 0.5), Grain(0.25)], clean: true),
        ]),
        // Volcanic glass: near-black conchoidal facets with violet glints.
        "block/obsidian": (palettes: {"main": "obsidian"}, layers: [
            Paint(palette: "main", base: 0.38, shade: [
                Cells(count: (3, 3), jitter: 1.0, value: 0.25, edge: -0.15, bevel: 0.55, round: -0.2, warp: 1.2),
                Grain(0.15),
            ], clean: true),
            Paint(palette: "main", base: 0.95, mask: [Speckle(chance: 0.05, amount: 1.0)]),
        ]),
        // Crusted lava: dark plates over glowing cracks.
        "block/magma": (palettes: {"main": "magma"}, layers: [
            Paint(palette: "main", base: 0.32, shade: [Cells(count: (4, 4), jitter: 1.0, value: 0.2, edge: 0.6, bevel: 0.1, round: -0.15, warp: 1.2), Grain(0.15)], clean: true),
        ]),
        // A mass of amethyst shards leaning the same way: each facet flat, its lit face and
        // ridge pale, a dark seam below and right, and a few glints. A grid, not noise:
        // noise-shaded cells read as cobbles, and in a dark cave only the glow shader's
        // bright texels show, so the pale faces are laid out to glow as whole shards.
        "block/crystal_block": (palettes: {"main": "crystal_rock"}, layers: [Grid(legend: {'1': "main:1", '2': "main:2", '3': "main:3", '4': "main:4", '5': "main:5", '6': "main:6"}, rows: [
            "4254453532333444",
            "4234435553233344",
            "4423354555353334",
            "4422344555322222",
            "2254254455535552",
            "5254234455535333",
            "4254423445532333",
            "4223423335553533",
            "3425423533333533",
            "3425342556653233",
            "3322342545555353",
            "3253232344555323",
            "2545324254555532",
            "6444532234455333",
            "3444553225333552",
            "2344453323555444",
        ])]),
        // Gloomvein: the deep dark's living crust, shot through with faintly glowing veins.
        "block/gloomvein": (palettes: {"main": "gloom", "vein": "gloom_glow"}, layers: [
            Paint(palette: "main", base: 0.45, shade: [Noise(cells: (4, 4), octaves: 2, amount: 0.6), Grain(0.3)], clean: true),
            Paint(palette: "vein", base: 0.1, shade: [Noise(cells: (8, 8), amount: 0.8)], mask: [Ridge(cells: (2, 2), octaves: 1, width: 0.07, amount: 1.0), Noise(cells: (4, 4), amount: 0.8)], above: 0.75),
            Paint(palette: "vein", base: 0.9, mask: [Speckle(chance: 0.025, amount: 1.0, seed: 3)]),
        ]),
        "block/brown_mushroom_block": (palettes: {"main": "brown_cap"}, layers: [
            Paint(palette: "main", base: 0.5, shade: [Noise(cells: (4, 4), octaves: 2, amount: 0.4), Grain(0.35), Border(width: 1, amount: -0.15)], clean: true),
        ]),
        "block/red_mushroom_block": (palettes: {"main": "red_cap", "spot": ["#cfc6b4", "#ece6d8", "#ffffff"]}, layers: [
            Paint(palette: "main", base: 0.5, shade: [Noise(cells: (4, 4), octaves: 2, amount: 0.4), Grain(0.3)], clean: true),
            Clusters(palette: "spot", count: 4, size: (8, 14), spacing: 7.0, shade: 1, shadow: -1),
        ]),
        "block/mushroom_stem": (palettes: {"main": "stem_pale"}, layers: [
            Paint(palette: "main", base: 0.55, shade: [Stripes(vertical: true, period: 3.0, width: 0.34, amount: -0.2, warp: 0.6), Noise(cells: (16, 2), amount: 0.3), Grain(0.15)], clean: true),
        ]),
        // Gatherable cave flora: mushrooms, a glowing herb, a pale root, moss and two
        // fantastical finds (cave_biomes.ron places them).
        "block/pale_cap": (base: "block/porcini", palettes: {"petal": ["#8e8a82", "#b8b4aa", "#dcd8ce", "#f6f4ec"], "centre": "stem_pale"}),
        "block/ember_cap": (base: "block/fly_agaric", palettes: {"petal": ["#8a1a06", "#d0400c", "#ff801c", "#ffd060"], "centre": ["#4a2a1a", "#7a4a2a", "#a87050"]}),
