        // Five amethyst prisms, each lit on its left face with a bright ridge and a glinting
        // tip; the glow shader lights the ridges and tips (its bright texels).
        "block/crystal_cluster": (base: "shape/plant", palettes: {"main": "crystal_rock"}, layers: [Grid(legend: {'2': "main:2", '3': "main:3", '4': "main:4", '5': "main:5", '6': "main:6"}, rows: [
