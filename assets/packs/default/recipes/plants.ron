        "grey_wood": ["#4a4440", "#6a625c", "#8c847c"],
        "cattail": ["#3a2210", "#5e3a1c", "#86582e"],
        "blue_glow": ["#1c3aa0", "#3a6ae0", "#8ab4ff"],
        "white_glow": ["#c8e8ff", "#eef8ff", "#ffffff"],
        "warm_glow": ["#ffb03a", "#ffd878", "#fff4c8"],
        "gold_glow": ["#f0c040", "#ffe48a", "#fffbe0"],
        "violet_glow": ["#b48aff", "#dcc4ff", "#f8f0ff"],
    },
    templates: {
        "flower": {
            "block/{name}_pair": (layers: [
                Stamp(texture: "block/{name}", relative: true, at: [(-3, 3)]),
                Stamp(texture: "block/{name}", relative: true, at: [(3, 0)], mirror: true),
            ]),
            "block/{name}_clump": (layers: [
                Stamp(texture: "block/{name}", relative: true, at: [(-4, 4)], mirror: true),
                Stamp(texture: "block/{name}", relative: true, at: [(4, 2)]),
                Stamp(texture: "block/{name}", relative: true, at: [(0, 0)]),
            ]),
        },
    },
    families: [
