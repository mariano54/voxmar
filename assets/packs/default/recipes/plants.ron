        "warm_glow": ["#ffb03a", "#ffd878", "#fff4c8"],
        "gold_glow": ["#f0c040", "#ffe48a", "#fffbe0"],
        "violet_glow": ["#b48aff", "#dcc4ff", "#f8f0ff"],
    },
    templates: {
        "flower": {
            "block/{name}_pair": (layers: [
                Stamp(texture: "block/{name}", at: [(-3, 3)]),
                Stamp(texture: "block/{name}", at: [(3, 0)], mirror: true),
            ]),
            "block/{name}_clump": (layers: [
                Stamp(texture: "block/{name}", at: [(-4, 4)], mirror: true),
                Stamp(texture: "block/{name}", at: [(4, 2)]),
                Stamp(texture: "block/{name}", at: [(0, 0)]),
            ]),
        },
    },
