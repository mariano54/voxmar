// New wild plants: flowers, herbs, bushes, grasses, reeds, ferns, fungi and wonders,
// drawn as text sprites with the same legend as flora.ron plus glow shades `u`, `v`, `w`
// for the fantastical ones. The `flower` template makes each flower's other
// looks, a pair and a clump of three, by stamping its sprite at offsets.
(
    legend: {
        'a': "leaf:0", 'b': "leaf:1", 'c': "leaf:2", 'd': "leaf:3", 'e': "leaf:4",
        'p': "petal:0", 'q': "petal:1", 'r': "petal:2", 's': "petal:3",
        'x': "centre:0", 'y': "centre:1", 'z': "centre:2",
        'k': "wood:0", 'l': "wood:1", 'm': "wood:2",
        'f': "fruit:0", 'h': "fruit:1", 'j': "fruit:2",
        'u': "glow:0", 'v': "glow:1", 'w': "glow:2",
        'W': "#f4f1ea",
    },
    palettes: {
        "magenta": ["#7a1c5e", "#a82e84", "#d04ea8", "#ee86cc"],
        "lilac": ["#5a3a8a", "#7e58b4", "#a27cd8", "#c8aaf0"],
