// Woods. The `wood` template draws every texture a wood needs from four palettes: `bark`,
// `wood` (the inside: planks, stripped logs, log ends), `leaves` and `sapling`. Leaves are
// grey for woods whose leaves the game tints with the climate's foliage colour, and in
// colour for woods whose leaves keep their own (maple, cherry, the fantasy woods).
// `{name}_leaves_bushy` is a round 32×32 leaf cluster with clear margins, for drawing
// leaves as tilted cards around a crown (the renderer does not use it yet).
(
    palettes: {
        "leaf_grey": ["#707070", "#8e8e8e", "#adadad", "#cbcbcb", "#eaeaea", "#ffffff"],
        "sapling_green": ["#2d4a1c", "#3a5e22", "#4a742a", "#5c8a33", "#70a03f"],
        "oak_bark": ["#3e2e1b", "#523e25", "#675030", "#7d623c", "#93754a", "#a8895a"],
        "oak_wood": ["#6f5532", "#83643c", "#967447", "#a88452", "#b8935e", "#c6a26b"],
        "birch_bark": ["#a9a49a", "#c0bcb1", "#d4d0c6", "#e4e1d8", "#f2efe8"],
        "birch_wood": ["#9a8256", "#ad9563", "#bea771", "#ceb781", "#dbc591", "#e6d2a1"],
        "birch_leaves": ["#676767", "#838383", "#9f9f9f", "#bbbbbb", "#d7d7d7", "#f4f4f4"],
        "birch_sapling": ["#3f5a22", "#4f6e29", "#628432", "#769a3c", "#8bb047"],
        "spruce_bark": ["#22170d", "#2e1f12", "#3b2818", "#49321f", "#573d27", "#664930"],
        "spruce_wood": ["#4a341d", "#583f24", "#664a2b", "#745533", "#82613b", "#906d44"],
        "spruce_leaves": ["#5c5c5c", "#767676", "#919191", "#acacac", "#c6c6c6", "#e1e1e1"],
        "spruce_sapling": ["#1d3a26", "#264a2f", "#305b38", "#3c6d43", "#4a7f4f"],
        "jungle_bark": ["#2e250d", "#3d3313", "#4c4119", "#5b4f20", "#6a5d28", "#7a6c31"],
        "jungle_wood": ["#74503a", "#855d42", "#966b4b", "#a67955", "#b48760", "#c1966c"],
        "acacia_bark": ["#3a3631", "#4a4540", "#5a544e", "#6a645c", "#7b746b", "#8c857b"],
        "dead_bark": ["#4f4c48", "#625f5a", "#77736d", "#8c8881", "#a19d95", "#b6b2aa"],
        "acacia_wood": ["#843f1f", "#9a4b26", "#ad572e", "#bd6437", "#ca7141", "#d67f4d"],
        "dark_oak_bark": ["#1a120a", "#24190e", "#2f2113", "#3a2a18", "#46331e", "#523d25"],
        "dark_oak_wood": ["#382512", "#432d18", "#4e361e", "#5a3f24", "#66492b", "#725333"],
        "dark_oak_leaves": ["#616161", "#7c7c7c", "#979797", "#b2b2b2", "#cccccc", "#e7e7e7"],
        "cherry_bark": ["#2e1c24", "#3d2530", "#4d2f3c", "#5d3a48", "#6e4655", "#8a6470"],
        "cherry_wood": ["#a87470", "#b9837e", "#c9928c", "#d6a29b", "#e1b2aa", "#eac1b9"],
        "cherry_leaves": ["#b0577f", "#c76a93", "#da82a8", "#e99cbc", "#f4b6cf", "#fbcfe0"],
        "cherry_sapling": ["#a24f76", "#bd6690", "#d681a9", "#e99dbf", "#f5b9d3"],
        "mangrove_bark": ["#33221a", "#432d22", "#53382b", "#634335", "#734f3f", "#845c4a"],
        "mangrove_wood": ["#6a2823", "#7b302a", "#8c3931", "#9c4339", "#ab4e42", "#b85a4c"],
        "maple_bark": ["#2b2724", "#3a3430", "#49423c", "#585049", "#685f57", "#7a7067"],
        "maple_wood": ["#9c6540", "#ad7249", "#bc8053", "#c98e5e", "#d49c6a", "#ddaa78"],
        "maple_leaves": ["#7a2416", "#97341d", "#b04826", "#c45f30", "#d47c3f", "#e09a55"],
        "maple_sapling": ["#8a2412", "#ad3618", "#cc4e1f", "#e2702b", "#f0963a"],
        "redwood_bark": ["#3c1810", "#4f2016", "#62291c", "#753324", "#873e2c", "#994a36"],
        "redwood_wood": ["#742f21", "#863928", "#984330", "#a94e39", "#b85a43", "#c5674e"],
        "redwood_leaves": ["#414141", "#575757", "#6f6f6f", "#878787", "#9f9f9f", "#b9b9b9"],
        "redwood_sapling": ["#1b3a22", "#244a2a", "#2d5a33", "#386b3d", "#457d48"],
        "pine_bark": ["#4a2814", "#64351a", "#7e4420", "#985427", "#b06631", "#c67a3e"],
        "pine_bark_old": ["#2e2420", "#3d302a", "#4d3d35", "#5d4a40"],
        "pine_wood": ["#9c7a46", "#ae8a51", "#bf9b5d", "#cdab6a", "#d9ba79", "#e4c98a"],
        "pine_leaves": ["#545b62", "#6d757d", "#888f98", "#a3aab4", "#bec5cf", "#dae1eb"],
        "pine_sapling": ["#1c3832", "#25473e", "#2e574a", "#396857", "#467a65"],
        "cypress_bark": ["#352d28", "#443a33", "#53473f", "#62554b", "#726358", "#827266"],
        "cypress_wood": ["#9a8262", "#aa916f", "#b9a07c", "#c7ae8a", "#d3bb98", "#ddc7a5"],
        "cypress_leaves": ["#444444", "#5a5a5a", "#717171", "#898989", "#a2a2a2", "#bbbbbb"],
        "cypress_sapling": ["#1c3a2c", "#244a36", "#2e5b41", "#3a6d4d", "#487f5b"],
        "willow_bark": ["#2e2a21", "#3c372b", "#4a4435", "#585140", "#675f4b", "#776e57"],
        "willow_wood": ["#958358", "#a59364", "#b5a271", "#c3b07e", "#cfbd8b", "#dac999"],
        "willow_leaves": ["#6d6d6d", "#898989", "#a5a5a5", "#c1c1c1", "#dedede", "#fafafa"],
        "willow_sapling": ["#4a6a2a", "#5a7e31", "#6c933a", "#80a845", "#95bc52"],
        "baobab_bark": ["#5a4b44", "#6b5a52", "#7c6a61", "#8c7a70", "#9c8a80", "#ac9b91"],
        "baobab_wood": ["#9a8464", "#aa9372", "#b9a280", "#c6b08e", "#d2bd9c", "#dcc9aa"],
        "palm_bark": ["#463824", "#58472d", "#6a5737", "#7c6742", "#8d774d", "#9e8859"],
        "palm_wood": ["#9a7a4b", "#ac8957", "#bc9863", "#c9a670", "#d5b37d", "#dfc08b"],
        "silverwood_bark": ["#6f7581", "#878e9a", "#a0a6b1", "#b8bdc7", "#ced2da", "#e4e7ed"],
        "silverwood_wood": ["#8f99ad", "#a0a9bc", "#b1b9ca", "#c1c8d7", "#d0d6e2", "#dee3ec"],
        "silverwood_leaves": ["#4d7a8e", "#6592a5", "#7eabbc", "#9cc5d3", "#bddde7", "#dff2f7"],
        "silverwood_sapling": ["#527f93", "#6b98ab", "#86b2c2", "#a6cbd8", "#c7e3ec"],
        "emberwood_bark": ["#1b1311", "#271b18", "#33231f", "#3f2c26", "#4b352e"],
        "emberwood_wood": ["#702612", "#852f16", "#9a391b", "#ad4421", "#bd5028", "#cb5d31"],
        "emberwood_leaves": ["#741a0b", "#962810", "#ba3c14", "#da581b", "#f17f26", "#fdab3a"],
        "emberwood_sapling": ["#8c240e", "#b23814", "#d4541b", "#ec7a26", "#fba43a"],
    },
    templates: {
        "wood": {
            // Bark: tall plates parted by dark furrows, lit on their left, never the even
            // boards of planks. Species with a bark of their own replace this below.
            "block/{name}_log": (layers: [
                Paint(palette: "bark", base: 0.55, shade: [
                    Cells(count: (4, 3), jitter: 0.9, value: 0.3, edge: -0.75, bevel: 0.35, warp: 0.6, stretch: (1.0, 3.0)),
                    Noise(cells: (16, 4), amount: 0.15),
                    Grain(0.25),
                ], clean: true),
            ]),
            // The cut end: growth rings inside a ragged ring of bark.
            "block/{name}_log_top": (layers: [
                Paint(palette: "wood", base: 0.62, shade: [Rings(spacing: 2.6, width: 0.35, amount: -0.3, wobble: 0.5, square: 0.45), Grain(0.12)]),
                Paint(palette: "bark", base: 0.45, shade: [Grain(0.6)], mask: [Border(width: 1, amount: 1.0), Border(width: 2, amount: 0.45), Noise(cells: (8, 8), amount: 0.4)], above: 0.62),
            ]),
            // Smooth wood under the bark, with fine wandering grain and no board seams.
            "block/stripped_{name}_log": (layers: [
                Paint(palette: "wood", base: 0.6, shade: [Noise(cells: (8, 1), octaves: 2, amount: 0.35), Grain(0.15)], clean: true),
                Paint(palette: "wood", base: 0.28, shade: [Grain(0.2)], mask: [Ridge(cells: (5, 1), octaves: 2, width: 0.1, amount: 1.0)], above: 0.5),
            ]),
            "block/stripped_{name}_log_top": (layers: [
                Paint(palette: "wood", base: 0.66, shade: [Rings(spacing: 2.6, width: 0.35, amount: -0.25, wobble: 0.5, square: 0.45), Border(width: 1, amount: -0.25), Noise(cells: (16, 16), amount: 0.12)]),
            ]),
            "block/{name}_planks": (layers: [
                Paint(palette: "wood", base: 0.56, shade: [
                    Boards(height: 4, seam: -0.5, joint: -0.4, value: 0.22, bevel: 0.12),
                    Noise(cells: (4, 16), octaves: 2, amount: 0.28),
                ], clean: true),
            ]),
            "block/{name}_leaves": (palettes: {"leaves": "leaf_grey"}, layers: [
                // Shadowed depths, then single leaves, lit along their upper edges, in a
                // few shapes and both ways round, then holes in the depths between them, so
                // the sky shows between leaves rather than through them. Our own drawing.
                Paint(palette: "leaves", base: 0.05, shade: [Noise(cells: (4, 4), amount: 0.25)]),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: ["...hl", "..lmd", ".lmmd", "lmmd.", "md..."], at: [(1, 2)], wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: ["hl..", "lmm.", ".mmd", "..md"], at: [(2, 11)], wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: [".hl.", "lmmd", "lmmd", ".md."], at: [(5, 9)], wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: ["...hl", "..lmd", ".lmmd", "lmmd.", "md..."], at: [(8, 6)], mirror: true, wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: ["hl..", "lmm.", ".mmd", "..md"], at: [(13, 12)], mirror: true, wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: [".hl.", "lmmd", "lmmd", ".md."], at: [(8, 1)], mirror: true, wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: ["...hl", "..lmd", ".lmmd", "lmmd.", "md..."], at: [(5, 14)], wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: ["hl..", "lmm.", ".mmd", "..md"], at: [(14, 5)], wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: [".hl.", "lmmd", "lmmd", ".md."], at: [(15, 9)], wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: ["...hl", "..lmd", ".lmmd", "lmmd.", "md..."], at: [(9, 13)], mirror: true, wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: ["hl..", "lmm.", ".mmd", "..md"], at: [(0, 14)], mirror: true, wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: [".hl.", "lmmd", "lmmd", ".md."], at: [(13, 0)], mirror: true, wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: ["...hl", "..lmd", ".lmmd", "lmmd.", "md..."], at: [(4, 5)], wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: ["hl..", "lmm.", ".mmd", "..md"], at: [(11, 8)], wrap: true),
                Grid(legend: {'h': "leaves:5", 'l': "leaves:4", 'm': "leaves:3", 'd': "leaves:1"}, rows: [".hl.", "lmmd", "lmmd", ".md."], at: [(11, 3)], wrap: true),
                Cut(mask: [Noise(cells: (8, 8), amount: 0.5), Grain(0.6)], above: -0.05, darker_than: 1),
            ]),
            // As Better Leaves Lite bakes them (MIT; the technique, not its images): the
            // leaf tile 3×3 on a canvas twice its size, so the pattern runs on past every
            // edge, cut to a ragged round cluster whose middle is the tile itself.
            "block/{name}_leaves_bushy": (size: (32, 32), layers: [
                Stamp(texture: "block/{name}_leaves", at: [(-8, -8), (8, -8), (24, -8), (-8, 8), (8, 8), (24, 8), (-8, 24), (8, 24), (24, 24)]),
                Cut(mask: [Circle(radius: 14.0, rough: 2.5)], below: 0.5),
            ]),
            "block/{name}_sapling": (palettes: {"sapling": "sapling_green"}, layers: [
                Grid(
                    legend: {
                        'a': "sapling:0", 'b': "sapling:1", 'c': "sapling:2", 'd': "sapling:3", 'e': "sapling:4",
                        's': "bark:2", 't': "bark:0",
                    },
                    rows: [
                        "................",
                        "................",
                        "......abb.......",
                        "....abccdb......",
                        "...abcdedcb.....",
                        "...bcdeedcba....",
                        "..abcdddcbaab...",
                        "...abccba.abcb..",
                        "....aab.s.bdcb..",
                        ".........sabba..",
                        "........s.......",
                        "........s.......",
                        ".......ts.......",
                        "........s.......",
                        "........t.......",
                        "........s.......",
                    ],
                ),
            ]),
        },
    },
    families: [
        (template: "wood", name: "oak", palettes: {"bark": "oak_bark", "wood": "oak_wood"}),
        (template: "wood", name: "birch", palettes: {"bark": "birch_bark", "wood": "birch_wood", "leaves": "birch_leaves", "sapling": "birch_sapling"}),
        (template: "wood", name: "spruce", palettes: {"bark": "spruce_bark", "wood": "spruce_wood", "leaves": "spruce_leaves", "sapling": "spruce_sapling"}),
        (template: "wood", name: "jungle", palettes: {"bark": "jungle_bark", "wood": "jungle_wood"}),
        (template: "wood", name: "acacia", palettes: {"bark": "acacia_bark", "wood": "acacia_wood"}),
        (template: "wood", name: "dark_oak", palettes: {"bark": "dark_oak_bark", "wood": "dark_oak_wood", "leaves": "dark_oak_leaves"}),
        (template: "wood", name: "cherry", palettes: {"bark": "cherry_bark", "wood": "cherry_wood", "leaves": "cherry_leaves", "sapling": "cherry_sapling"}),
        (template: "wood", name: "mangrove", palettes: {"bark": "mangrove_bark", "wood": "mangrove_wood"}),
        (template: "wood", name: "maple", palettes: {"bark": "maple_bark", "wood": "maple_wood", "leaves": "maple_leaves", "sapling": "maple_sapling"}),
        (template: "wood", name: "redwood", palettes: {"bark": "redwood_bark", "wood": "redwood_wood", "leaves": "redwood_leaves", "sapling": "redwood_sapling"}),
        (template: "wood", name: "pine", palettes: {"bark": "pine_bark", "wood": "pine_wood", "leaves": "pine_leaves", "sapling": "pine_sapling"}),
        (template: "wood", name: "cypress", palettes: {"bark": "cypress_bark", "wood": "cypress_wood", "leaves": "cypress_leaves", "sapling": "cypress_sapling"}),
        (template: "wood", name: "willow", palettes: {"bark": "willow_bark", "wood": "willow_wood", "leaves": "willow_leaves", "sapling": "willow_sapling"}),
        (template: "wood", name: "baobab", palettes: {"bark": "baobab_bark", "wood": "baobab_wood"}),
        (template: "wood", name: "palm", palettes: {"bark": "palm_bark", "wood": "palm_wood"}),
        (template: "wood", name: "silverwood", palettes: {"bark": "silverwood_bark", "wood": "silverwood_wood", "leaves": "silverwood_leaves", "sapling": "silverwood_sapling"}),
        (template: "wood", name: "emberwood", palettes: {"bark": "emberwood_bark", "wood": "emberwood_wood", "leaves": "emberwood_leaves", "sapling": "emberwood_sapling"}),
    ],
    textures: {
        // Birch: pale bark with dark lenticels.
        "block/birch_log": (palettes: {"bark": "birch_bark", "mark": ["#1c1814", "#2d2822", "#3e3830", "#57504a"]}, layers: [
            Paint(palette: "bark", base: 0.62, shade: [Noise(cells: (8, 4), octaves: 2, amount: 0.4), Noise(cells: (16, 16), amount: 0.2)], clean: true),
            Clusters(palette: "mark", count: 7, size: (2, 5), spread: (3.0, 0.3), spacing: 4.0, shade: 1, seed: 3),
        ]),
        // Each species' bark, so a trunk says what tree it is.
        "block/maple_log": (palettes: {"bark": "maple_bark"}, layers: [
            // Grey, in long narrow strips that lift at their edges.
            Paint(palette: "bark", base: 0.55, shade: [
                Cells(count: (5, 2), jitter: 0.8, value: 0.35, edge: -0.75, bevel: 0.35, warp: 0.6, stretch: (1.0, 4.0)),
                Noise(cells: (16, 4), amount: 0.15),
                Grain(0.2),
            ], clean: true),
        ]),
        "block/spruce_log": (palettes: {"bark": "spruce_bark"}, layers: [
            // Small, thin scales.
            Paint(palette: "bark", base: 0.55, shade: [Cells(count: (4, 6), jitter: 1.0, value: 0.4, edge: -0.6, bevel: 0.45, warp: 0.4, stretch: (1.4, 1.0)), Grain(0.2)], clean: true),
        ]),
        "block/dark_oak_log": (palettes: {"bark": "dark_oak_bark"}, layers: [
            // Thick ridges and deep furrows.
            Paint(palette: "bark", base: 0.6, shade: [Cells(count: (3, 3), jitter: 0.9, value: 0.3, edge: -0.95, width: 1.0, bevel: 0.45, warp: 0.8, stretch: (1.0, 3.0)), Grain(0.25)], clean: true),
        ]),
        "block/jungle_log": (palettes: {"bark": "jungle_bark", "moss": ["#2f4a1c", "#3e5f22", "#4f752a", "#628a33"]}, layers: [
            // Ribbed and streaked, with moss in the furrows.
            Paint(palette: "bark", base: 0.55, shade: [Cells(count: (5, 2), jitter: 0.8, value: 0.25, edge: -0.6, bevel: 0.3, warp: 1.0, stretch: (1.0, 3.5)), Noise(cells: (16, 4), amount: 0.2), Grain(0.25)], clean: true),
            Paint(palette: "moss", base: 0.4, shade: [Grain(0.8)], mask: [Noise(cells: (3, 2), octaves: 2, amount: 1.2), Speckle(chance: 0.3, amount: 0.3)], above: 0.85),
        ]),
        "block/acacia_log": (palettes: {"bark": "acacia_bark"}, layers: [
            // Grey, coarse and blocky.
            Paint(palette: "bark", base: 0.55, shade: [Cells(count: (3, 3), jitter: 1.0, value: 0.4, edge: -0.7, bevel: 0.4, warp: 1.0, stretch: (1.0, 2.0)), Grain(0.3)], clean: true),
        ]),
        // A long-dead trunk: the bark gone, the wood weathered silver-grey, fibrous along
        // the grain and split into long strips by dark cracks running up it.
        "block/dead_log": (palettes: {"bark": "dead_bark"}, layers: [
            Paint(palette: "bark", base: 0.62, shade: [
                Cells(count: (4, 1), jitter: 0.8, value: 0.25, edge: -0.9, bevel: 0.25, warp: 0.8, stretch: (1.0, 5.0)),
                Stripes(vertical: true, period: 3.0, width: 0.34, amount: -0.12, warp: 0.6),
                Noise(cells: (16, 2), octaves: 2, amount: 0.2),
                Grain(0.1),
            ], clean: true),
        ]),
        "block/cherry_log": (palettes: {"bark": "cherry_bark"}, layers: [
            // Smooth and dark, with the pale horizontal lenticels cherries have.
            Paint(palette: "bark", base: 0.5, shade: [Noise(cells: (2, 4), octaves: 2, amount: 0.35), Stripes(period: 4.0, width: 0.25, amount: -0.2, warp: 0.8, phase: 2.0), Grain(0.15)], clean: true),
            Paint(palette: "bark", base: 0.95, mask: [Stripes(period: 4.0, width: 0.25, amount: 1.0, warp: 0.8), Noise(cells: (8, 4), amount: 0.9)], above: 1.0, shadow: -2),
        ]),
        "block/mangrove_log": (palettes: {"bark": "mangrove_bark"}, layers: [
            // Fine, scaly network.
            Paint(palette: "bark", base: 0.55, shade: [Cells(count: (5, 4), jitter: 1.0, value: 0.3, edge: -0.65, bevel: 0.35, warp: 0.5, stretch: (1.0, 2.0)), Grain(0.25)], clean: true),
        ]),
        "block/redwood_log": (palettes: {"bark": "redwood_bark"}, layers: [
            // Deep, fibrous ridges running the whole trunk.
            Paint(palette: "bark", base: 0.55, shade: [
                Cells(count: (6, 1), jitter: 0.7, value: 0.3, edge: -0.8, bevel: 0.3, warp: 0.8, stretch: (1.0, 6.0)),
                Noise(cells: (16, 2), amount: 0.25),
                Grain(0.25),
            ], clean: true),
        ]),
        "block/cypress_log": (palettes: {"bark": "cypress_bark"}, layers: [
            // Stringy strips.
            Paint(palette: "bark", base: 0.55, shade: [Cells(count: (7, 2), jitter: 0.8, value: 0.25, edge: -0.6, bevel: 0.3, warp: 0.6, stretch: (1.0, 5.0)), Grain(0.25)], clean: true),
        ]),
