// Fruit on trees (content/base/crops.ron): each fruit's leaves are its tree's own leaves
// (bare, in blossom, unripe and ripe), and each stage after bare carries an overlay of
// blossom or fruit that the game draws over the tinted leaves untinted. Same legend as
// flora.ron and crops.ron; `u`–`w` glow for the emberfruit. Then the fruit itself.
(
    legend: {
        'a': "leaf:0", 'b': "leaf:1", 'c': "leaf:2", 'd': "leaf:3", 'e': "leaf:4",
        'p': "petal:0", 'q': "petal:1", 'r': "petal:2", 's': "petal:3",
        'x': "centre:0", 'y': "centre:1", 'z': "centre:2",
        'k': "wood:0", 'l': "wood:1", 'm': "wood:2",
        'f': "fruit:0", 'h': "fruit:1", 'j': "fruit:2",
        'u': "glow:0", 'v': "glow:1", 'w': "glow:2",
        'W': "#fff8d8",
    },
    palettes: {
        "apple_red": ["#7a1010", "#c42a1e", "#f0603e"],
