// Fruit on trees (content/base/crops.ron): each fruit's leaves are its tree's own leaves
// (bare, in blossom, unripe and ripe). Blossom is an overlay the game draws over the
// tinted leaves untinted; unripe and ripe fruit hangs from the leaves in 3D, modelled in
// boxes in the colour of the fruit's own texture (engine mesh.rs `emit_fruit`), so their
// overlays are left clear. Same legend as flora.ron and crops.ron; `u`–`w` glow for the
// emberfruit. Then the fruit itself.
(
    legend: {
        'a': "leaf:0", 'b': "leaf:1", 'c': "leaf:2", 'd': "leaf:3", 'e': "leaf:4",
        'p': "petal:0", 'q': "petal:1", 'r': "petal:2", 's': "petal:3",
        'x': "centre:0", 'y': "centre:1", 'z': "centre:2",
        'k': "wood:0", 'l': "wood:1", 'm': "wood:2",
        'f': "fruit:0", 'h': "fruit:1", 'j': "fruit:2",
        'u': "glow:0", 'v': "glow:1", 'w': "glow:2",
        'W': "#fff8d8",
    },
    palettes: {
        "apple_red": ["#7a1010", "#c42a1e", "#f0603e"],
        "unripe_green": ["#5a7a1e", "#8aa830", "#b8cc5a"],
        "cherry_red": ["#4a0410", "#8e0a1e", "#d0303e"],
        "cherry_unripe": ["#6a8a1a", "#a0b42a", "#d0d860"],
        "cherry_blossom": ["#b06a86", "#e09ab4", "#f6c8da", "#ffeef4"],
        "orange_peel": ["#a04a06", "#e07a10", "#ffaa36"],
        "coconut_husk": ["#3e2610", "#6a4220", "#946a3e"],
        "coconut_young": ["#4a6a1e", "#6e8e2a", "#98b446"],
        "gold_fruit": ["#a07010", "#e8b828", "#fff07a"],
        "unripe_gold": ["#8a8a2a", "#b8b440", "#e0dc78"],
        "ember_fruit": ["#e08a20", "#ffd860", "#fffbe0"],
        "ember_unripe": ["#6a2a0a", "#a04a14", "#d07a2a"],
        // The trees grown for gathering: their ripe fruit.
        "pear_ripe": ["#6a7a1a", "#a8b43a", "#dcd870"],
        "plum_ripe": ["#2e0e36", "#5e2a6e", "#9058a0"],
        "hazelnut_ripe": ["#4e3216", "#7e5428", "#ae8048"],
        "walnut_ripe": ["#3a521a", "#5a762a", "#86a046"],
        "chestnut_ripe": ["#7a5a10", "#b8922a", "#e6cc5a"],
        "wild_cherries_ripe": ["#4a0410", "#8e0a1e", "#d0303e"],
        "rowan_berries_ripe": ["#8a1a06", "#d0400e", "#ff7a30"],
        "olives_ripe": ["#262414", "#46441e", "#6a6636"],
        "fig_ripe": ["#34163a", "#64345a", "#98647a"],
        "lemon_ripe": ["#b89a10", "#e8d030", "#fff07a"],
        "almond_ripe": ["#5e6e34", "#90a056", "#c4cc86"],
        "banana_ripe": ["#a08a10", "#e0c830", "#fff27a"],
        "mango_ripe": ["#c05a10", "#e8a020", "#ffd84a"],
        "avocado_ripe": ["#1c1020", "#3a2438", "#5e4048"],
        "cacao_ripe": ["#8a2a0c", "#d05a16", "#f8a028"],
        "baobab_fruit_ripe": ["#56563a", "#86865a", "#b6b28a"],
        "marula_ripe": ["#a08a10", "#d8c030", "#f4e47a"],
