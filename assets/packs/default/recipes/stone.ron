// Rocks and ores. Each rock has its own recipe for the raw stone; the `stone` template
// makes its cobbled, polished and brick forms from the rock's `main` palette.
(
    palettes: {
        "moss_overlay": ["#3d5a24", "#4f7029", "#628532", "#779a3c"],
        "stone": ["#5e5f63", "#6c6d70", "#7a7a7c", "#878788", "#949493", "#a3a2a0"],
        "granite": ["#6a4840", "#7d574d", "#90665a", "#a27667", "#b38877", "#c39b8a"],
        // Softened at both ends (Review, 2026-10-08): diorite is field stone in plains,
        // meadows and steppe mounds, and a near-white top read stark against the grass.
        "diorite": ["#8f8f8e", "#9e9e9c", "#adadaa", "#bbbab7", "#c7c6c2", "#d2d1cc"],
        "andesite": ["#5d5f61", "#6c6e70", "#7b7c7e", "#898a8b", "#97989a", "#a7a8a8"],
        "tuff": ["#4c4e46", "#5a5c53", "#686a61", "#76786e", "#84867b", "#94958a"],
        "calcite": ["#b9bcb8", "#c8cbc6", "#d6d8d3", "#e1e3de", "#ebede8", "#f6f6f2"],
        "deepslate": ["#2e2e34", "#38383f", "#43434a", "#4e4e56", "#5a5a62", "#67676f"],
        "marble": ["#b4b3b0", "#c6c5c1", "#d5d4d0", "#e2e1dc", "#edece7", "#f8f7f3"],
        "marble_vein": ["#7c818c", "#979ba4", "#b3b6bc"],
        "limestone": ["#a1977e", "#b1a78d", "#c0b79c", "#cdc5aa", "#d9d2b8", "#e5dfc6"],
        "slate": ["#252a36", "#2f3541", "#39414d", "#444c58", "#505864", "#5e6670"],
        "basalt": ["#16171e", "#21222a", "#2c2d35", "#38383f", "#46454b", "#57545a"],
        "chalk": ["#c6c5bd", "#d3d2cb", "#dedcd6", "#e8e7e1", "#f0efea", "#f9f8f4"],
        "sandstone": ["#b39f6e", "#c3af7e", "#d1be8d", "#dcca9b", "#e5d5a8", "#eee0b7"],
        "red_sandstone": ["#7f4520", "#8f5027", "#9f5c2f", "#ad6939", "#ba7745", "#c68653"],
        "travertine": ["#a39274", "#b3a283", "#c2b292", "#cfc0a0", "#dacdae", "#e5d9bc"],
        "bedrock": ["#141416", "#2a2a2e", "#46464b", "#66666b", "#8a8a8e", "#adadb0"],
    },
    templates: {
        "stone": {
            "block/{name}": (palettes: {"main": "{name}"}, layers: [
                Paint(palette: "main", base: 0.55, shade: [Noise(cells: (3, 6), octaves: 3, gain: 0.6, amount: 0.7)], clean: true),
            ]),
            "block/cobbled_{name}": (palettes: {"main": "{name}"}, layers: [
                Paint(palette: "main", base: 0.66, shade: [
                    Cells(count: (3, 3), jitter: 0.9, value: 0.4, edge: -0.85, bevel: 0.45, round: 0.25, warp: 1.5),
                    Noise(cells: (8, 8), amount: 0.25),
                    Grain(0.2),
                ], clean: true),
            ]),
            "block/polished_{name}": (palettes: {"main": "{name}"}, layers: [
                Paint(palette: "main", base: 0.6, shade: [
                    Noise(cells: (4, 4), octaves: 2, amount: 0.22),
                    Border(width: 1, amount: -0.35, sides: (0.0, 1.0, 1.0, 0.0)),
                    Border(width: 1, amount: 0.25, sides: (1.0, 0.0, 0.0, 1.0)),
                    Border(width: 2, amount: -0.12),
                ], clean: true),
            ]),
            "block/{name}_bricks": (palettes: {"main": "{name}"}, layers: [
                Paint(palette: "main", base: 0.6, shade: [
                    Bricks(size: (8, 4), mortar: -0.55, value: 0.2, bevel: 0.15),
                    Noise(cells: (8, 8), amount: 0.2),
                ], clean: true),
            ]),
            "block/mossy_cobbled_{name}": (base: "block/cobbled_{name}", palettes: {"moss": "moss_overlay"}, layers: [
                Paint(palette: "moss", base: 0.45, shade: [Noise(cells: (8, 8), amount: 0.8), Grain(0.3)], mask: [Noise(cells: (3, 3), octaves: 2, amount: 1.4), Speckle(chance: 0.25, amount: 0.25)], above: 0.42, clean: true),
            ]),
            // Bricks split by a few dark cracks with a lit lip.
            "block/cracked_{name}_bricks": (base: "block/{name}_bricks", layers: [
                Paint(palette: "main", base: 0.0, mask: [Ridge(cells: (2, 2), octaves: 1, width: 0.12, amount: 1.0), Noise(cells: (3, 3), amount: 0.9)], above: 0.72, light: 1),
            ]),
        },
    },
    families: [
        (template: "stone", name: "stone"),
        (template: "stone", name: "granite"),
        (template: "stone", name: "diorite"),
        (template: "stone", name: "andesite"),
        (template: "stone", name: "tuff"),
        (template: "stone", name: "calcite"),
        (template: "stone", name: "deepslate"),
        (template: "stone", name: "marble"),
        (template: "stone", name: "limestone"),
        (template: "stone", name: "slate"),
        (template: "stone", name: "basalt"),
        (template: "stone", name: "chalk"),
        (template: "stone", name: "sandstone"),
        (template: "stone", name: "red_sandstone"),
        (template: "stone", name: "travertine"),
    ],
    textures: {
        "block/stone": (palettes: {"main": "stone"}, layers: [
            Paint(palette: "main", base: 0.5, shade: [Noise(cells: (3, 6), octaves: 3, gain: 0.6, amount: 0.7), Grain(0.2)], clean: true),
            Paint(palette: "main", base: 0.25, mask: [Ridge(cells: (2, 3), width: 0.12, amount: 1.0), Noise(cells: (4, 4), amount: 0.8)], above: 0.85, light: 1),
        ]),
        "block/cobblestone": (base: "block/cobbled_andesite", palettes: {"main": "stone"}, seed: 11),
        // A mullioned window's stone bricks: the wall's own drawing under a name of its own,
        // since a window glows by the light through it and the wall must not.
        "block/stone_window": (base: "block/stone_bricks"),
        "block/mossy_stone_bricks": (base: "block/stone_bricks", palettes: {"moss": "moss_overlay"}, layers: [
            Paint(palette: "moss", base: 0.45, shade: [Noise(cells: (8, 8), amount: 0.8), Grain(0.3)], mask: [Noise(cells: (3, 3), octaves: 2, amount: 1.4), Speckle(chance: 0.25, amount: 0.25)], above: 0.42, clean: true),
        ]),
        "block/mossy_cobblestone": (base: "block/cobblestone", palettes: {"moss": "moss_overlay"}, layers: [
            Paint(palette: "moss", base: 0.45, shade: [Noise(cells: (8, 8), amount: 0.8)], mask: [Noise(cells: (3, 3), octaves: 2, amount: 1.4), Speckle(chance: 0.25, amount: 0.25)], above: 0.42, clean: true),
        ]),
        "block/bedrock": (palettes: {"main": "bedrock"}, layers: [
            Paint(palette: "main", base: 0.5, shade: [Cells(count: (5, 5), jitter: 1.0, value: 0.9, edge: -0.3, bevel: 0.3, warp: 1.5), Speckle(chance: 0.2, amount: 0.3)], clean: true),
        ]),
        "block/granite": (palettes: {"main": "granite", "fleck": ["#4e3530", "#cdaa9a", "#dcc0b2"]}, layers: [
            Paint(palette: "main", base: 0.55, shade: [Noise(cells: (4, 4), octaves: 3, gain: 0.7, amount: 0.8)], clean: true),
            Paint(palette: "fleck", base: 0.0, shade: [Speckle(chance: 1.0, amount: 0.0)], mask: [Speckle(chance: 0.06, amount: 1.0)]),
            Paint(palette: "fleck", base: 0.4, mask: [Speckle(chance: 0.05, amount: 1.0, seed: 3)]),
        ]),
        "block/diorite": (palettes: {"main": "diorite", "fleck": ["#7a7b7e", "#86878a", "#949598"]}, layers: [
            Paint(palette: "main", base: 0.6, shade: [Noise(cells: (4, 4), octaves: 2, amount: 0.6)], clean: true),
            Clusters(palette: "fleck", count: 10, size: (1, 4), spacing: 3.0, shade: 1, seed: 1),
        ]),
        "block/andesite": (palettes: {"main": "andesite"}, layers: [
            Paint(palette: "main", base: 0.5, shade: [Noise(cells: (4, 4), octaves: 2, amount: 0.5), Speckle(chance: 0.18, amount: 0.3), Speckle(chance: 0.15, amount: -0.3, seed: 2)], clean: false),
        ]),
        "block/tuff": (palettes: {"main": "tuff"}, layers: [
            Paint(palette: "main", base: 0.5, shade: [Noise(cells: (4, 8), octaves: 2, amount: 0.6), Speckle(chance: 0.1, amount: 0.45), Speckle(chance: 0.08, amount: -0.4, seed: 4)], clean: true),
        ]),
        "block/calcite": (palettes: {"main": "calcite"}, layers: [
            Paint(palette: "main", base: 0.62, shade: [Cells(count: (3, 3), jitter: 1.0, value: 0.35, edge: -0.18, bevel: 0.2, warp: 0.5), Noise(cells: (8, 8), amount: 0.15)], clean: true),
        ]),
        "block/deepslate": (palettes: {"main": "deepslate"}, layers: [
            Paint(palette: "main", base: 0.55, shade: [
                Noise(cells: (2, 8), octaves: 2, amount: 0.5),
                Stripes(period: 4.0, width: 0.25, amount: -0.3, warp: 1.0),
                Speckle(chance: 0.08, amount: 0.25),
            ], clean: true),
        ]),
        "block/deepslate_top": (palettes: {"main": "deepslate"}, layers: [
            Paint(palette: "main", base: 0.6, shade: [Cells(count: (3, 3), jitter: 0.8, value: 0.3, edge: -0.4, bevel: 0.15), Noise(cells: (8, 8), amount: 0.3)], clean: true),
        ]),
        // Soft clouded white with a few thin grey veins that fork and break off, drawn by
        // hand: noise ridges made rings and dots, not veins. The pale texels beside the main
        // vein are its halo.
        "block/marble": (palettes: {"main": "marble", "vein": "marble_vein"}, layers: [
            Paint(palette: "main", base: 0.66, shade: [Noise(cells: (3, 3), octaves: 2, amount: 0.4, seed: 5)], clean: true),
            Grid(legend: {'v': "vein:2", 'h': "-1", 'f': "main:2"}, rows: [
            ".........vv....v",
            "v......vv.......",
            "................",
            "................",
            ".............ff.",
            "..........fff...",
            "................",
            "................",
            "................",
            "................",
            "........hh......",
            "........vvh.....",
            "..........v.....",
            "...........v....",
            "............vh..",
            "...........v.vvh",
            ]),
        ]),
        "block/limestone": (palettes: {"main": "limestone"}, layers: [
            Paint(palette: "main", base: 0.6, shade: [
                Noise(cells: (2, 8), octaves: 2, amount: 0.45),
                Stripes(period: 8.0, width: 0.125, amount: -0.25, warp: 1.0, phase: 2.0),
                Speckle(chance: 0.05, amount: -0.35),
            ], clean: true),
        ]),
        // Thin beds dipping gently, each with a pale cleaved edge here and there.
        "block/slate": (palettes: {"main": "slate"}, layers: [
            Paint(palette: "main", base: 0.55, shade: [Noise(cells: (2, 8), octaves: 2, amount: 0.5), Stripes(period: 4.0, width: 0.25, amount: -0.25, warp: 1.0, slope: 0.25)], clean: true),
            Paint(palette: "main", base: 0.9, mask: [Stripes(period: 4.0, width: 0.25, amount: 1.0, warp: 1.0, slope: 0.25, phase: 1.0), Noise(cells: (4, 2), amount: 0.8)], above: 1.1),
        ]),
        // Rough columns: tall cells split by dark joints, streaked up and down, with a few
        // gas pores.
        "block/basalt": (palettes: {"main": "basalt"}, layers: [
            Paint(palette: "main", base: 0.52, shade: [Cells(count: (4, 2), jitter: 0.7, value: 0.25, edge: -0.35, bevel: 0.25, warp: 0.8, stretch: (1.0, 2.5), seed: 7), Noise(cells: (8, 2), octaves: 2, amount: 0.3), Grain(0.08)], clean: true),
            Paint(palette: "main", base: 0.05, mask: [Speckle(chance: 0.02, amount: 1.0, seed: 9)]),
        ]),
        "block/chalk": (palettes: {"main": "chalk"}, layers: [
            Paint(palette: "main", base: 0.62, shade: [Noise(cells: (4, 4), octaves: 3, amount: 0.5), Speckle(chance: 0.04, amount: -0.3)], clean: true),
        ]),
        "block/sandstone": (palettes: {"main": "sandstone"}, layers: [
            Paint(palette: "main", base: 0.55, shade: [
                Noise(cells: (8, 16), amount: 0.3),
                Stripes(period: 16.0, width: 0.1875, amount: 0.2, phase: 0.0),
                Stripes(period: 16.0, width: 0.0625, amount: -0.3, phase: 3.0),
                Noise(cells: (1, 4), octaves: 2, amount: 0.25),
                Border(width: 1, amount: -0.25, sides: (0.0, 0.0, 1.0, 0.0)),
            ], clean: true),
        ]),
        "block/sandstone_top": (palettes: {"main": "sandstone"}, layers: [
            Paint(palette: "main", base: 0.62, shade: [Noise(cells: (4, 4), octaves: 2, amount: 0.35), Speckle(chance: 0.12, amount: -0.25), Speckle(chance: 0.08, amount: 0.25, seed: 5)]),
        ]),
        "block/sandstone_bottom": (base: "block/sandstone_top", layers: [
            Shift(by: [Flat(-1.0)], mask: [Noise(cells: (4, 4), amount: 1.0)], above: 0.25),
        ]),
        "block/red_sandstone": (base: "block/sandstone", palettes: {"main": "red_sandstone"}),
        "block/red_sandstone_top": (base: "block/sandstone_top", palettes: {"main": "red_sandstone"}),
        "block/red_sandstone_bottom": (base: "block/sandstone_bottom", palettes: {"main": "red_sandstone"}),
        "block/travertine": (palettes: {"main": "travertine"}, layers: [
            Paint(palette: "main", base: 0.6, shade: [
                Noise(cells: (1, 8), octaves: 2, amount: 0.5),
                Stripes(period: 4.0, width: 0.25, amount: 0.15, warp: 0.8),
            ], clean: true),
            Paint(palette: "main", base: 0.05, mask: [Speckle(chance: 0.35, amount: 1.0), Stripes(period: 4.0, width: 0.25, amount: 1.0, warp: 0.8, phase: 2.0), Noise(cells: (16, 4), amount: 0.6)], above: 1.6, light: 1),
        ]),
        // Ores: clumps of mineral on clear texels, lit from the top left, drawn over the
        // rock they lie in (their block's `host`). The deepslate forms are the same clumps.
        "block/coal_ore": (palettes: {"ore": ["#121214", "#1e1e21", "#2e2e32", "#45454a"]}, layers: [
            Clusters(palette: "ore", count: 4, size: (9, 14), spacing: 5.5, shade: 1, margin: 1),
        ]),
        "block/iron_ore": (palettes: {"ore": ["#6d4c37", "#a77a5c", "#d2a888", "#ead0b8"]}, layers: [
            Clusters(palette: "ore", count: 4, size: (9, 14), spacing: 5.5, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/copper_ore": (palettes: {"ore": ["#6c331b", "#b05a32", "#de8a54", "#5fae8c"]}, layers: [
            Clusters(palette: "ore", count: 5, size: (7, 11), spacing: 5.0, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/gold_ore": (palettes: {"ore": ["#8a5f0f", "#d39c1e", "#f6d24a", "#fff3a8"]}, layers: [
            Clusters(palette: "ore", count: 4, size: (8, 12), spacing: 5.5, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/diamond_ore": (palettes: {"ore": ["#156d6b", "#2fb7b0", "#6ff0e6", "#d8fffb"]}, layers: [
            Clusters(palette: "ore", count: 4, size: (6, 10), spacing: 5.5, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/deepslate_coal_ore": (base: "block/coal_ore"),
        "block/deepslate_iron_ore": (base: "block/iron_ore"),
        "block/deepslate_copper_ore": (base: "block/copper_ore"),
        "block/deepslate_gold_ore": (base: "block/gold_ore"),
        "block/deepslate_diamond_ore": (base: "block/diamond_ore"),
        "block/cobalt_ore": (palettes: {"ore": ["#16246e", "#2d47b8", "#5a80f0", "#b6cbff"]}, layers: [
            Clusters(palette: "ore", count: 4, size: (8, 12), spacing: 5.5, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/tin_ore": (palettes: {"ore": ["#5f6b70", "#97a5aa", "#c8d4d7", "#eef5f6"]}, layers: [
            Clusters(palette: "ore", count: 5, size: (6, 10), spacing: 5.0, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/silver_ore": (palettes: {"ore": ["#70737c", "#b0b5c0", "#dfe3ec", "#ffffff"]}, layers: [
            Clusters(palette: "ore", count: 5, size: (5, 9), spacing: 5.0, shade: 1, shadow: -1, margin: 1),
        ]),
        // The later ages' ores: sphalerite, galena's cubes, magnetite, graphite flakes,
        // bauxite's pisoliths, and three gems in small bright clusters.
        "block/zinc_ore": (palettes: {"ore": ["#4a3418", "#8a6526", "#c49a45", "#ead08a"]}, layers: [
            Clusters(palette: "ore", count: 5, size: (6, 10), spacing: 5.0, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/lead_ore": (palettes: {"ore": ["#2c3038", "#4d5563", "#7d8798", "#c3cad6"]}, layers: [
            Clusters(palette: "ore", count: 4, size: (8, 12), spacing: 5.5, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/lodestone": (palettes: {"ore": ["#141518", "#2a2c33", "#4a4e5a", "#8c93a6"]}, layers: [
            Clusters(palette: "ore", count: 6, size: (9, 14), spacing: 4.5, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/graphite_ore": (palettes: {"ore": ["#1c1c1f", "#33343a", "#56585f", "#9aa0aa"]}, layers: [
            Clusters(palette: "ore", count: 6, size: (4, 8), spacing: 4.5, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/bauxite": (palettes: {"ore": ["#5e2a14", "#9a4a24", "#c87a46", "#e8b083"]}, layers: [
            Clusters(palette: "ore", count: 7, size: (5, 9), spacing: 4.0, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/ruby_ore": (palettes: {"ore": ["#5e0a17", "#a8162c", "#e64a5e", "#ffc2cb"]}, layers: [
            Clusters(palette: "ore", count: 3, size: (5, 8), spacing: 6.0, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/sapphire_ore": (palettes: {"ore": ["#0b1f5c", "#1d43a8", "#4f7fe8", "#c6d8ff"]}, layers: [
            Clusters(palette: "ore", count: 3, size: (5, 8), spacing: 6.0, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/emerald_ore": (palettes: {"ore": ["#0b4a2a", "#168a4d", "#3fd486", "#c8ffe0"]}, layers: [
            Clusters(palette: "ore", count: 3, size: (5, 8), spacing: 6.0, shade: 1, shadow: -1, margin: 1),
        ]),
        "block/deepslate_zinc_ore": (base: "block/zinc_ore"),
        "block/deepslate_lead_ore": (base: "block/lead_ore"),
        "block/deepslate_lodestone": (base: "block/lodestone"),
        "block/deepslate_graphite_ore": (base: "block/graphite_ore"),
        "block/deepslate_ruby_ore": (base: "block/ruby_ore"),
        "block/deepslate_sapphire_ore": (base: "block/sapphire_ore"),
        "block/deepslate_emerald_ore": (base: "block/emerald_ore"),
        "block/aetherite_ore": (palettes: {"ore": ["#4a1f8c", "#8a4cf0", "#c39bff", "#f2e6ff"], "glint": ["#7af5ff"]}, layers: [
            Clusters(palette: "ore", count: 4, size: (7, 11), spacing: 5.5, shade: 1, shadow: -1, margin: 1),
            Paint(palette: "glint", mask: [Speckle(chance: 0.03, amount: 1.0, seed: 9)]),
        ]),
    },
)
