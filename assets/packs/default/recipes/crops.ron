// Crops (content/base/crops.ron): each grows through two shared sprouting stages drawn
// with its own palettes (the `crop` template), then its own growing and ripe plants, and
// its seeds (shared too) and what it yields. Same legend as flora.ron: `a`–`e` leaves and
// stems dark to light, `p`–`s` petals, `x`–`z` centres, `k`–`m` wood or grain, `f`, `h`,
// `j` fruit (dark, middle, light), `u`–`w` glow and `W` white.
(
    legend: {
        'a': "leaf:0", 'b': "leaf:1", 'c': "leaf:2", 'd': "leaf:3", 'e': "leaf:4",
        'p': "petal:0", 'q': "petal:1", 'r': "petal:2", 's': "petal:3",
        'x': "centre:0", 'y': "centre:1", 'z': "centre:2",
        'k': "wood:0", 'l': "wood:1", 'm': "wood:2",
        'f': "fruit:0", 'h': "fruit:1", 'j': "fruit:2",
        'u': "glow:0", 'v': "glow:1", 'w': "glow:2",
        'W': "#f4f1ea",
    },
    palettes: {
        "crop_green": ["#24451a", "#33601f", "#467a27", "#5c9432", "#78ae40"],
        "carrot_top": ["#2a5a14", "#3a7a1a", "#4e9a22", "#6ab42e", "#8cca44"],
        "cabbage_leaf": ["#2c4e3e", "#3e6a52", "#558868", "#72a680", "#98c49c"],
        "saffron_leaf": ["#2c4a1e", "#3e6226", "#547c30", "#6c963c", "#8ab04e"],
        "moon_leaf": ["#1e3a4a", "#2c5262", "#3e6c7c", "#568898", "#76a6b4"],
        "orange_root": ["#a04a0a", "#e07a18", "#ffa63a"],
        "potato_skin": ["#5a3a1c", "#a8783e", "#d4a868"],
        "bread_crust": ["#6a3c14", "#b06e28", "#e0a85a"],
        "bread_crumb": ["#c8a060", "#e8cc90", "#f6e6c0"],
        "tomato_red": ["#7a0e0c", "#cc2a1c", "#f2604a"],
        "berry_red": ["#6e0a14", "#c81e2c", "#f2546a"],
        "pepper_red": ["#6a0c06", "#b8200c", "#e8481e"],
        "crocus": ["#3c1a6a", "#5e30a0", "#8a58d0", "#b892f0"],
        "saffron_red": ["#6a0a08", "#b8200c", "#f05a1c"],
        "twine": ["#5a3c1c", "#7a5a30", "#9a7a48"],
        "seed_yellow": ["#8a6a24", "#c09a3a", "#e8cc78"],
        "seed_cream": ["#8c8064", "#c4b48c", "#ece0bc"],
        "seed_dark": ["#2a1c14", "#4a3424", "#6e5238"],
        "seed_corm": ["#4a2e18", "#7a5230", "#a87a4c"],
        "seed_moon": ["#4a6aa0", "#8ab0e0", "#dcecff"],
        "moon_glow": ["#7a9cd0", "#acc8f0", "#eef6ff"],
        "strawberry_seed": ["#a08a20", "#d0c040", "#f4ec80"],
        "strawberry_flower": ["#c8c4b8", "#e6e2d8", "#f6f4ee", "#ffffff"],
        "potato_flower": ["#8a6aa8", "#b496d0", "#d8c4ec", "#f4ecff"],
        "tomato_flower": ["#b08a10", "#e0b420", "#f4d84a", "#fff08a"],
    },
    templates: {
        // The two sprouting stages and the seeds every crop shares, in its own colours.
        "crop": {
            "block/{name}_crop0": (base: "shape/plant", layers: [Grid(rows: [
                "................",
                "................",
                "................",
                "................",
                "................",
                "................",
                "................",
                "................",
                "................",
                "................",
                "................",
                "..e........e....",
                ".dcd...e..dcd...",
                "..c...dcd..c..e.",
                "..b....c...b.dcd",
                "..b....b...b..b.",
            ])]),
            "block/{name}_crop1": (base: "shape/plant", layers: [Grid(rows: [
                "................",
                "................",
                "................",
                "................",
                "................",
                "................",
                "................",
                "................",
                "....e.......e...",
                "...dc..e...dc...",
                "..e.c.dc..e.c.e.",
                ".dcdc..c.dcdcdc.",
                "..dcb.dcb..cb.c.",
                "...cbdc.b..cbcb.",
                "..dcb.cb..dcb.b.",
                "...bb..b...bb.b.",
            ])]),
            "block/{name}_seeds": (base: "shape/plant", layers: [Grid(rows: [
                "................",
                "................",
                "................",
                "................",
                "................",
                "......ml........",
                ".....mlk...ml...",
                "......k...mlk...",
                "...ml......k....",
                "..mlk...ml......",
                "...k...mlk..ml..",
                ".......kk..mlk..",
                "....ml......k...",
                "...mlk..........",
                "....k...........",
                "................",
            ])]),
        },
    },
    families: [
        (template: "crop", name: "wheat", palettes: {"leaf": "crop_green", "wood": "wheat"}),
        (template: "crop", name: "carrot", palettes: {"leaf": "carrot_top"}, without: ["block/{name}_seeds"]),
        (template: "crop", name: "potato", palettes: {"leaf": "crop_green"}, without: ["block/{name}_seeds"]),
        (template: "crop", name: "cabbage", palettes: {"leaf": "cabbage_leaf", "wood": "seed_dark"}),
        (template: "crop", name: "tomato", palettes: {"leaf": "crop_green", "wood": "seed_cream"}),
        (template: "crop", name: "strawberry", palettes: {"leaf": "crop_green", "wood": "strawberry_seed"}),
        (template: "crop", name: "chili_pepper", palettes: {"leaf": "crop_green", "wood": "seed_yellow"}),
        (template: "crop", name: "saffron", palettes: {"leaf": "saffron_leaf", "wood": "seed_corm"}),
        (template: "crop", name: "moonbloom", palettes: {"leaf": "moon_leaf", "wood": "seed_moon"}),
    ],
