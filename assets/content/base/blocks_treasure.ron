// Treasure (treasure.ron says who opens what, and what each holds): chests locked by the
// age they belong to, which nothing breaks while locked, and the lockpicks that open them.
// Worldgen places the chests (ruins, villages, caves); right click one with a lockpick in
// hand to try its lock (`base:pick_lock`).
(
    blocks: [
        (
            name: "nomad_treasure_chest", sound: Wood, textures: Sides(top: "treasure_chest_top", bottom: "chest_top", side: "treasure_chest_side"),
            hardness: -1.0, color: (130, 100, 70), tags: ["locked", "wood"],
        ),
        (
            name: "farm_treasure_chest", sound: Wood, textures: Sides(top: "treasure_chest_top", bottom: "chest_top", side: "treasure_chest_side"),
            hardness: -1.0, color: (135, 105, 70), tags: ["locked", "wood"],
        ),
        (
            name: "bronze_treasure_chest", sound: Wood, textures: Sides(top: "treasure_chest_top", bottom: "chest_top", side: "treasure_chest_side"),
            hardness: -1.0, color: (150, 110, 65), tags: ["locked", "wood"],
        ),
        (
            name: "iron_treasure_chest", sound: Wood, textures: Sides(top: "treasure_chest_top", bottom: "chest_top", side: "treasure_chest_side"),
            hardness: -1.0, color: (140, 130, 120), tags: ["locked", "wood"],
        ),
        (
            name: "steam_treasure_chest", sound: Wood, textures: Sides(top: "treasure_chest_top", bottom: "chest_top", side: "treasure_chest_side"),
            hardness: -1.0, color: (120, 120, 125), tags: ["locked", "wood"],
        ),
        // Relics (machines.ron's `relics`): worn gate machines found in chests, at half
        // rate until repaired into the machine they are of.
        (
            name: "worn_bloomery", sound: Stone, textures: Sides(top: "worn_kiln_bricks", bottom: "worn_kiln_bricks", side: "worn_bloomery_side"),
            hardness: 3.0, color: (140, 85, 60), light: 6, rarity: Rare, tags: ["machine", "multiblock_core", "heat", "building", "relic"],
        ),
        (
            name: "worn_beam_engine", sound: Stone, textures: Sides(top: "worn_beam_engine_top", bottom: "worn_iron_casing", side: "worn_beam_engine_side"),
            hardness: 3.5, color: (100, 95, 85), rarity: Rare, tags: ["machine", "building", "relic"],
        ),
        (
            name: "worn_dynamo", sound: Stone, textures: Sides(top: "worn_dynamo_top", bottom: "worn_iron_casing", side: "worn_dynamo_side"),
            hardness: 3.5, color: (110, 90, 75), rarity: Rare, tags: ["machine", "building", "relic"],
        ),
    ],
    families: [
        // Lockpicks, one an age: bone, then each age's metal.
        (template: "drop", name: "bone_lockpick", tags: ["lockpick"], all: (color: (225, 215, 190))),
        (template: "drop", name: "copper_lockpick", tags: ["lockpick"], all: (color: (190, 110, 70))),
        (template: "drop", name: "bronze_lockpick", tags: ["lockpick"], all: (color: (200, 140, 70))),
        (template: "drop", name: "iron_lockpick", tags: ["lockpick"], all: (color: (200, 205, 215))),
    ],
)
