// Fishing (engine/src/fishing.rs): what a line cast into water brings up. Each catch has
// the Fishing level it takes, its experience, a `weight` (how often it bites among those
// that can), the `water` it bites in (Salt: a biome tagged ocean; Fresh: rivers, lakes and
// ponds; Any), the biome tags it wants (any of them; anywhere when none), and `when` it
// bites (Day, Night, Rain; all must hold). Rare fish come a little more often with a
// better rod. Nothing here asks for more than level 80.
//
// A fish's xp doubles every 10.5 levels: 10 × 2^((level − 1) ÷ 10.5) (design draft 63; a
// content test holds every catch here to it). Each fish bites twice as often, against
// those below it, for every `outlevelled` levels it asks, so the water's best fish are
// what a high level mostly lands (a later package may set it, design draft 91).
//
// The water's climate comes from its temperature (°C, as climate.ron reads the land) and
// counts as a biome tag: frozen below `frozen`, cold below `cold`, cool, temperate, warm
// below `warm`, hot above. The sea is one biome from pole to equator, so this is what
// sends cod to cold water and tuna to warm (a later package may set it, design draft 91).
(
    outlevelled: 15.0,
    water: (frozen: -3.0, cold: 4.0, cool: 10.0, temperate: 17.0, warm: 22.0),
    catches: [
        (item: "raw_shrimp", level: 1, xp: 10.0, weight: 6.0),
        (item: "raw_minnow", level: 1, xp: 10.0, weight: 6.0, water: Fresh),
        (item: "raw_sardine", level: 5, xp: 13.0, weight: 5.0, water: Salt),
        (item: "raw_perch", level: 10, xp: 18.0, weight: 4.0, water: Fresh),
        (item: "raw_trout", level: 15, xp: 25.0, weight: 4.0, water: Fresh, biomes: ["cold", "cool", "frozen", "mountain", "conifer"]),
        (item: "raw_cod", level: 20, xp: 35.0, weight: 4.0, water: Salt, biomes: ["cold", "cool", "frozen"]),
        (item: "raw_salmon", level: 25, xp: 49.0, weight: 3.0, water: Fresh, biomes: ["cold", "cool", "conifer", "river"]),
        (item: "raw_carp", level: 30, xp: 68.0, weight: 3.0, water: Fresh, biomes: ["warm", "temperate", "wetland"]),
        (item: "raw_bass", level: 35, xp: 94.0, weight: 3.0, water: Salt),
        (item: "raw_pike", level: 40, xp: 131.0, weight: 2.0, water: Fresh, biomes: ["temperate", "cool", "wetland", "forest"]),
        (item: "raw_eel", level: 45, xp: 183.0, weight: 2.0, water: Fresh, when: [Night], rarity: Uncommon),
        (item: "raw_tuna", level: 50, xp: 254.0, weight: 2.0, water: Salt, biomes: ["warm", "hot", "tropical"]),
        // A big river fish, and the deep ocean's by day, at the top of the line.
        (item: "raw_sturgeon", level: 55, xp: 353.0, weight: 1.5, water: Fresh, biomes: ["river", "temperate", "cool", "cold"], rarity: Uncommon),
        (item: "raw_marlin", level: 60, xp: 491.0, weight: 1.0, water: Salt, biomes: ["deep"], when: [Day], rarity: Rare),
        (item: "raw_swordfish", level: 65, xp: 684.0, weight: 1.0, water: Salt, biomes: ["warm", "hot", "tropical"], rarity: Rare),
        // A deep-sea fish that rises at night, in deep ocean.
        (item: "raw_deepwater_lanternfish", level: 70, xp: 951.0, weight: 0.8, water: Salt, biomes: ["deep"], when: [Night], rarity: Rare),
        // Supernatural: a koi that glows, in fantastical waters on rainy nights.
        (item: "raw_glimmer_koi", level: 75, xp: 1323.0, weight: 0.5, water: Fresh, biomes: ["fantastical"], when: [Night, Rain], rarity: VeryRare),
    ],
)
