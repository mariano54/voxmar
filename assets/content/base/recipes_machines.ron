// How machines and their parts are built, on a crafting table (recipes.ron says how a
// recipe reads). Every machine trains Engineering and needs a level in it; parts can be
// made by hand at a loss, or worked in a machine for more (processing.ron).
(
    recipes: [
        // Parts by hand: two ingots beaten into a plate (a trip hammer makes one of one), a
        // copper plate cut into wire.
        (pattern: [["copper_ingot"], ["copper_ingot"]], output: "copper_plate", skill: "core:engineering", level: 15, xp: 4.0),
        (pattern: [["bronze_ingot"], ["bronze_ingot"]], output: "bronze_plate", skill: "core:engineering", level: 18, xp: 5.0),
        (pattern: [["iron_ingot"], ["iron_ingot"]], output: "iron_plate", skill: "core:engineering", level: 28, xp: 6.0),
        (ingredients: ["copper_plate"], output: "copper_wire", count: 3, skill: "core:engineering", level: 36, xp: 3.0),
        // The Bronze age: rotation from water and wind, carried by shafts, worked by a
        // trip hammer.
        (pattern: [["{name}_log", "stick", "{name}_log"]], output: "shaft", count: 4, skill: "core:engineering", level: 18, xp: 6.0),
        (pattern: [["{name}_planks", "{name}_planks", "{name}_planks"], ["{name}_planks", "shaft", "{name}_planks"], ["{name}_planks", "{name}_planks", "{name}_planks"]], output: "treadwheel", skill: "core:engineering", level: 18, xp: 30.0),
        (pattern: [["stick", "{name}_planks", "stick"], ["{name}_planks", "bronze_ingot", "{name}_planks"], ["stick", "{name}_planks", "stick"]], output: "water_wheel", skill: "core:engineering", level: 20, xp: 40.0),
        (pattern: [["wool", "stick", "wool"], ["stick", "bronze_ingot", "stick"], ["wool", "stick", "wool"]], output: "windmill", skill: "core:engineering", level: 24, xp: 50.0),
        (pattern: [["bronze_ingot", "bronze_ingot", "bronze_ingot"], ["", "shaft", ""], ["tag:cobbled", "tag:cobbled", "tag:cobbled"]], output: "trip_hammer", skill: "core:engineering", level: 32, xp: 60.0),
        // Items between machines: a wooden chest (Crafting) and a hopper of planks, wooden chutes, and iron
        // conveyors on hide belts, four times as fast.
        (pattern: [["{name}_planks", "{name}_planks", "{name}_planks"], ["{name}_planks", "", "{name}_planks"], ["{name}_planks", "{name}_planks", "{name}_planks"]], output: "chest", skill: "core:crafting", level: 1, xp: 10.0),
        (pattern: [["{name}_planks", "", "{name}_planks"], ["{name}_planks", "{name}_planks", "{name}_planks"], ["", "{name}_planks", ""]], output: "hopper", skill: "core:engineering", level: 12, xp: 15.0),
        (pattern: [["{name}_planks", "", "{name}_planks"], ["", "{name}_planks", ""]], output: "chute", count: 4, skill: "core:engineering", level: 14, xp: 4.0),
        (pattern: [["hide", "hide", "hide"], ["iron_plate", "shaft", "iron_plate"]], output: "conveyor", count: 4, skill: "core:engineering", level: 34, xp: 12.0),
        // The Bronze age's gate, the Bellows Bloomery: a bloomery of kiln bricks round a
        // fire, hide bellows on a shaft, and a bloom beaten into two ingots by hand (a trip
        // hammer gets three).
        (pattern: [["kiln_bricks", "", "kiln_bricks"], ["kiln_bricks", "charcoal", "kiln_bricks"], ["kiln_bricks", "kiln_bricks", "kiln_bricks"]], output: "bloomery", skill: "core:engineering", level: 22, xp: 80.0),
        (pattern: [["{name}_planks", "{name}_planks", "{name}_planks"], ["hide", "hide", "hide"], ["{name}_planks", "shaft", "{name}_planks"]], output: "bellows", skill: "core:engineering", level: 20, xp: 40.0),
        (ingredients: ["iron_bloom"], output: "iron_ingot", count: 2, skill: "core:engineering", level: 15, xp: 10.0),
        // The Iron age: a coke oven of kiln bricks round an iron door, a blast furnace raised
        // from a bloomery in iron plates, and a sawmill with an iron blade on a shaft.
        (pattern: [["kiln_bricks", "kiln_bricks", "kiln_bricks"], ["kiln_bricks", "iron_plate", "kiln_bricks"], ["kiln_bricks", "kiln_bricks", "kiln_bricks"]], output: "coke_oven", skill: "core:engineering", level: 28, xp: 90.0),
        (pattern: [["kiln_bricks", "iron_plate", "kiln_bricks"], ["iron_plate", "bloomery", "iron_plate"], ["kiln_bricks", "iron_plate", "kiln_bricks"]], output: "blast_furnace", skill: "core:engineering", level: 34, xp: 150.0),
        (pattern: [["", "iron_plate", ""], ["{name}_planks", "shaft", "{name}_planks"], ["{name}_planks", "{name}_planks", "{name}_planks"]], output: "sawmill", skill: "core:engineering", level: 26, xp: 60.0),
        // The Iron and Steam ages: a boiler over a fire, pipes, an engine, a crusher.
        (pattern: [["copper_plate", "copper_plate", "copper_plate"]], output: "steam_pipe", count: 4, skill: "core:engineering", level: 30, xp: 8.0),
        (pattern: [["iron_plate", "iron_plate", "iron_plate"], ["iron_plate", "", "iron_plate"], ["tag:cobbled", "campfire", "tag:cobbled"]], output: "boiler", skill: "core:engineering", level: 32, xp: 80.0),
        (pattern: [["iron_plate", "iron_plate", "iron_plate"], ["steam_pipe", "shaft", "steam_pipe"], ["iron_plate", "bronze_plate", "iron_plate"]], output: "beam_engine", skill: "core:engineering", level: 35, xp: 100.0),
        (pattern: [["iron_plate", "steam_pipe", "iron_plate"], ["iron_ingot", "iron_ingot", "iron_ingot"], ["iron_plate", "bronze_plate", "iron_plate"]], output: "steam_crusher", skill: "core:engineering", level: 38, xp: 110.0),
        // The LV age: wool-wrapped copper cable, a dynamo round a lodestone, batteries and
        // the first electric machines.
        (pattern: [["wool", "wool", "wool"], ["copper_wire", "copper_wire", "copper_wire"], ["wool", "wool", "wool"]], output: "lv_cable", count: 6, skill: "core:engineering", level: 40, xp: 10.0),
        (pattern: [["iron_plate", "copper_wire", "iron_plate"], ["copper_wire", "lodestone", "copper_wire"], ["iron_plate", "shaft", "iron_plate"]], output: "dynamo", skill: "core:engineering", level: 42, xp: 140.0),
        (pattern: [["iron_plate", "lv_cable", "iron_plate"], ["copper_plate", "vial", "copper_plate"], ["iron_plate", "copper_plate", "iron_plate"]], output: "battery_bank", skill: "core:engineering", level: 44, xp: 150.0),
        (pattern: [["iron_plate", "copper_wire", "iron_plate"], ["copper_wire", "kiln_bricks", "copper_wire"], ["iron_plate", "lv_cable", "iron_plate"]], output: "electric_furnace", skill: "core:engineering", level: 44, xp: 150.0),
        (pattern: [["iron_plate", "iron_ingot", "iron_plate"], ["copper_wire", "iron_ingot", "copper_wire"], ["iron_plate", "lv_cable", "iron_plate"]], output: "macerator", skill: "core:engineering", level: 46, xp: 170.0),
        // A washer: a macerator over a pail of water, for the third dust.
        (pattern: [["iron_plate", "pail", "iron_plate"], ["copper_wire", "macerator", "copper_wire"], ["iron_plate", "lv_cable", "iron_plate"]], output: "ore_washer", skill: "core:engineering", level: 48, xp: 190.0),
        // The MV age: thicker cable, a turbine fed straight from the boilers, a transformer
        // down to LV, and a bank of LV banks.
        (pattern: [["wool", "wool", "wool"], ["copper_plate", "copper_plate", "copper_plate"], ["wool", "wool", "wool"]], output: "mv_cable", count: 6, skill: "core:engineering", level: 50, xp: 14.0),
        (pattern: [["iron_plate", "steam_pipe", "iron_plate"], ["copper_wire", "dynamo", "copper_wire"], ["iron_plate", "steam_pipe", "iron_plate"]], output: "steam_turbine", skill: "core:engineering", level: 52, xp: 220.0),
        (pattern: [["iron_plate", "mv_cable", "iron_plate"], ["copper_wire", "lodestone", "copper_wire"], ["iron_plate", "lv_cable", "iron_plate"]], output: "lv_transformer", skill: "core:engineering", level: 52, xp: 200.0),
        (pattern: [["iron_plate", "mv_cable", "iron_plate"], ["battery_bank", "battery_bank", "battery_bank"], ["iron_plate", "iron_plate", "iron_plate"]], output: "mv_battery_bank", skill: "core:engineering", level: 54, xp: 240.0),
        // The HV age: thicker cable again, casing for the turbine hall and its core (two
        // turbines round a diamond bearing), a transformer down to MV, and a bank of MV banks.
        (pattern: [["wool", "wool", "wool"], ["mv_cable", "mv_cable", "mv_cable"], ["wool", "wool", "wool"]], output: "hv_cable", count: 3, skill: "core:engineering", level: 55, xp: 20.0),
        (pattern: [["iron_plate", "iron_plate", "iron_plate"], ["iron_plate", "steam_pipe", "iron_plate"], ["iron_plate", "iron_plate", "iron_plate"]], output: "turbine_casing", count: 8, skill: "core:engineering", level: 56, xp: 30.0),
        (pattern: [["iron_plate", "steam_turbine", "iron_plate"], ["hv_cable", "diamond_ore", "hv_cable"], ["iron_plate", "steam_turbine", "iron_plate"]], output: "turbine_hall", skill: "core:engineering", level: 58, xp: 400.0),
        (pattern: [["iron_plate", "hv_cable", "iron_plate"], ["copper_wire", "lodestone", "copper_wire"], ["iron_plate", "mv_cable", "iron_plate"]], output: "mv_transformer", skill: "core:engineering", level: 57, xp: 260.0),
        (pattern: [["iron_plate", "hv_cable", "iron_plate"], ["mv_battery_bank", "mv_battery_bank", "mv_battery_bank"], ["iron_plate", "iron_plate", "iron_plate"]], output: "hv_battery_bank", skill: "core:engineering", level: 60, xp: 320.0),
    ],
)
