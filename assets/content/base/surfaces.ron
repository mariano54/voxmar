// Surface rule sets biomes share. A biome names them in `surface.include`; they are tried
// in order before the biome's own rules, so a trail crosses every biome that includes it
// and slopes break up the same way everywhere. Conditions are those of biome surfaces (see
// `Condition` in crates/worldgen/src/content.rs); thresholds given as two values are
// dithered between them in clumps. Noises are named for their seed, so rules naming the
// same noise share it: the trails here are the same trails the steppe and savanna wear.
(
    sets: [
        (
            // Slopes of soil break up as they steepen: coarse dirt creeps onto the edges of
            // gentle steps, gravel and coarse dirt onto steeper ones, then the province's
            // rock in clumps, until the steepest ground is bare cliff.
            name: "soil_slopes",
            rules: [
                (when: [Slope(2.0, 3.0), Patch((name: "slope_rock", scale: 6.0, octaves: 2), -0.3)], place: (top: Stones, filler: Stones)),
                (when: [Slope(1.5, 2.5), Patch((name: "slope_gravel", scale: 4.0), 0.2)], place: (top: Block("gravel"), filler: Block("gravel"), depth: 2)),
                (when: [Slope(1.0, 2.0), Patch((name: "slope_scree", scale: 5.0, octaves: 2), 0.1)], place: (top: Mix([Name("coarse_dirt", 3.0), Name("gravel", 1.0)]), filler: Block("dirt"))),
                (when: [Slope(0.5, 1.5), Patch((name: "slope_scree", scale: 5.0, octaves: 2), 0.5)], place: (top: Block("coarse_dirt"), filler: Block("dirt"))),
                (when: [Slope(0.5, 1.5), Patch((name: "slope_rock", scale: 6.0, octaves: 2), 0.62)], place: (top: Stones, filler: Stones)),
            ],
        ),
        (
            // High, stony ground: rock and scree take most slopes, grass keeps the flats.
            name: "rocky_slopes",
            rules: [
                (when: [Slope(1.5, 2.5), Patch((name: "slope_rock", scale: 6.0, octaves: 2), -0.5)], place: (top: Stones, filler: Stones)),
                (when: [Slope(1.0, 2.0), Patch((name: "slope_gravel", scale: 4.0), -0.1)], place: (top: Mix([Name("gravel", 3.0), Name("coarse_dirt", 1.0)]), filler: Block("gravel"), depth: 2)),
                (when: [Slope(0.5, 1.5), Patch((name: "slope_scree", scale: 5.0, octaves: 2), 0.15)], place: (top: Mix([Name("coarse_dirt", 2.0), Name("gravel", 1.0), Name("stone", 1.0)]), filler: Block("dirt"))),
            ],
        ),
        (
            // Game trails: worn lines of coarse dirt and gravel along a noise's zero contour,
            // a block or two wide, keeping to gentle ground and fading at their sides.
            name: "trails",
            rules: [
                (when: [Not(Slope(1.0, 2.0)), Band((name: "game_trails", scale: 140.0), 0.009)], place: (top: Mix([Name("coarse_dirt", 4.0), Name("gravel", 1.0)]), filler: Block("dirt"))),
                (when: [Not(Slope(1.0, 2.0)), Band((name: "game_trails", scale: 140.0), 0.017), Chance(0.35)], place: (top: Block("coarse_dirt"), filler: Block("dirt"))),
            ],
        ),
        (
            // Dry washes: the beds of streams that run only after rain, gravel and sand along
            // a contour, wide in some stretches, thread-thin in others, gone in between.
            name: "washes",
            rules: [
                (
                    when: [Not(Slope(1.0, 2.0)), Tapered((name: "dry_washes", scale: 320.0, octaves: 2), (name: "dry_wash_width", scale: 500.0, octaves: 2), [(0.3, 0.014), (0.0, 0.008), (-0.25, 0.004)])],
                    place: (top: Mix([Name("gravel", 3.0), Name("sand", 2.0), Name("coarse_dirt", 1.0)]), filler: Block("gravel"), depth: 2),
                ),
            ],
        ),
    ],
)
