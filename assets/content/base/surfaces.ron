// Surface rule sets biomes share. A biome names them in `surface.include`; they are tried
// in order before the biome's own rules, so a trail crosses every biome that includes it
// and slopes break up the same way everywhere. Conditions are those of biome surfaces (see
// `Condition` in crates/worldgen/src/content.rs); thresholds given as two values are
// dithered between them in clumps. Noises are named for their seed, so rules naming the
// same noise share it: the trails here are the same trails the steppe and savanna wear.
(
    sets: [
        (
            // Slopes of soil, by how steep the ground is around them (smooth from block to
            // block): gentle slopes keep the biome's ground; steeper ones show patches of
            // coarse dirt tens of blocks across; steeper still, outcrops of the province's
            // rock in its beds, until the steepest ground is bare cliff. One material per
            // patch, never a mix block by block.
            name: "soil_slopes",
            rules: [
                (when: [Slope(1.8, 2.6), Patch((name: "slope_rock", scale: 22.0, octaves: 2), -0.2)], place: (top: Stones, filler: Stones)),
                (when: [Slope(1.3, 1.9), Patch((name: "slope_scree", scale: 18.0, octaves: 2), 0.35)], place: (top: Block("coarse_dirt"), filler: Block("dirt"))),
            ],
        ),
        (
            // High, stony ground: rock outcrops on steep ground, patches of gravel on
            // moderate slopes, the biome's ground on gentle ones.
            name: "rocky_slopes",
            rules: [
                (when: [Slope(1.4, 2.2), Patch((name: "slope_rock", scale: 22.0, octaves: 2), -0.4)], place: (top: Stones, filler: Stones)),
                (when: [Slope(1.0, 1.6), Patch((name: "slope_gravel", scale: 16.0, octaves: 2), 0.25)], place: (top: Block("gravel"), filler: Block("gravel"), depth: 2)),
            ],
        ),
        (
            // Game trails: worn lines of coarse dirt and gravel along a noise's zero contour,
            // a block or two wide, keeping to gentle ground and fading at their sides. No
            // biome includes them for now: they read as paths, which belong near settlements.
            name: "trails",
            rules: [
                (when: [Not(Slope(0.9, 1.5)), Band((name: "game_trails", scale: 140.0), 0.009)], place: (top: Mix([Name("coarse_dirt", 4.0), Name("gravel", 1.0)]), filler: Block("dirt"))),
                (when: [Not(Slope(0.9, 1.5)), Band((name: "game_trails", scale: 140.0), 0.017), Chance(0.35)], place: (top: Block("coarse_dirt"), filler: Block("dirt"))),
            ],
        ),
        (
            // Dry washes: the beds of streams that run only after rain, gravel and sand along
            // a contour, wide in some stretches, thread-thin in others, gone in between. In
            // the cold of high steppe, gravel and stony dirt without the sand.
            name: "washes",
            rules: [
                (
                    when: [Not(Slope(0.9, 1.5)), Warmer(8.0, 12.0), Tapered((name: "dry_washes", scale: 320.0, octaves: 2), (name: "dry_wash_width", scale: 500.0, octaves: 2), [(0.3, 0.014), (0.0, 0.008), (-0.25, 0.004)])],
                    place: (top: Mix([Name("gravel", 3.0), Name("sand", 2.0), Name("coarse_dirt", 1.0)]), filler: Block("gravel"), depth: 2),
                ),
                (
                    when: [Not(Slope(0.9, 1.5)), Tapered((name: "dry_washes", scale: 320.0, octaves: 2), (name: "dry_wash_width", scale: 500.0, octaves: 2), [(0.3, 0.014), (0.0, 0.008), (-0.25, 0.004)])],
                    place: (top: Mix([Name("gravel", 3.0), Name("coarse_dirt", 2.0)]), filler: Block("gravel"), depth: 2),
                ),
            ],
        ),
    ],
)
