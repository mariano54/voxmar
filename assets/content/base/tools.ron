// Tools (engine/src/tool.rs). A tool is an item tagged `tool` and with its kind's name
// (`pickaxe`), a `tier:N` and a `speed:X`, and maybe a `yield:Y` (blocks_tools.ron).
//
// `kinds`: what each kind of tool is for. Held over a block with one of its `mines` tags, a
// tool mines it `speed` times as fast as a bare hand, and its `yield` adds to the chance of
// an extra drop there (and of rarer harvests from crops, with a hoe). Better tools make
// better finds; they never make the world grow faster.
//
// `blocks`: what breaking a block takes and teaches, the first rule whose tags the block
// all has: a level in a skill (`level`, RuneScape-style), a tool of a kind and tier
// (`tool`, `tier`), and the experience it gives. Only natural blocks teach, so breaking
// what you placed teaches nothing. `instead` is sometimes something else in place of its
// own drop (item, chance); `by` makes that wait on a kind of tool, whose yield adds to the
// chance.
//
// `wear`: how tools and weapons with `uses:N` wear out (blocks_tools.ron). A block a tool is
// made for takes `suited` uses, any other `unsuited` (a block that breaks at a touch none),
// tilling `till`, a blow that lands `hit`. Each kind's `skill` (a weapon's own, else
// `weapon_skill`) saves a use `save_per_level` times its level: 1 in 2 at 99. At `warn` of
// its uses left, or `warn_uses` if more (a flint tool's fifty would leave five, too few to
// take it back and mend), a tool creaks and reddens; worn out it breaks with a snap. Mending, at a
// block tagged `mend_near` unless the tool names its own, gives back `mend` of its uses a
// piece (more where its recipe takes fewer pieces), and making a new one must never be
// cheaper than mending (checked at load). Metal tools and weapons are mended at a grindstone
// (`mend_near:grindstone`, blocks_tools.ron), everything else at a chopping block. With
// `spare`, a tool that breaks in the hand brings up a spare of its kind from the pack (its
// like first, else the one with most uses left; a weapon, only its like), so the spare axe
// An Axe to It asks for is in hand when the first one goes.
//
// `break_wait`: seconds the hand waits after each block it breaks before it starts on the
// next (Minecraft's five ticks). On soft blocks it is most of a break, so past a stone
// shovel a faster one is felt less there than in its uses (engine's
// `every_tool_tier_is_felt` pins those steps as the only ones not felt).
(
    break_wait: 0.25,
    wear: (suited: 1, unsuited: 2, hit: 1, till: 1, save_per_level: 0.005, weapon_skill: "core:attack", warn: 0.1, warn_uses: 10, mend: 0.5, mend_near: "chopping_block", spare: true),
    kinds: [
        (name: "pickaxe", mines: ["stone", "ore", "cobbled", "bricks", "crystal", "ice"], skill: "core:mining"),
        (name: "axe", mines: ["log", "wood", "planks", "bush"], skill: "core:crafting"),
        (name: "shovel", mines: ["soil", "sand", "gravel", "clay", "snow", "silt"], skill: "core:mining"),
        (name: "hoe", mines: ["crop", "leaves", "moss", "hay"], skill: "core:farming"),
        (name: "shears", mines: ["leaves", "wool", "vine"], skill: "core:farming"),
        (name: "knife", mines: ["plant", "vine", "flower"], skill: "core:crafting"),
        // A rod mines nothing; it fishes (fishing.ron).
        (name: "rod", mines: []),
    ],
    // Mining xp in level order (design draft 63): stone 1, coal 13, copper 17.5, tin 25,
    // iron 35, zinc and lead 49, cobalt 70, silver 99, gold 140, ruby and sapphire 172,
    // lodestone 198, emerald 227, graphite and diamond 280, bauxite and aetherite 396.
    // Stone alone no longer trains Mining. The first sample of ore a player breaks over each
    // vein teaches `prospect` more (three times the ore's xp): finding a vein is the work.
    blocks: [
        (tags: ["ore", "alchemy:aether"], skill: "core:mining", level: 50, tool: "pickaxe", tier: 4, xp: 396.0, prospect: 1188.0),
        // The ores of ores.ron's second part, by tag so their deepslate forms and surface
        // samples follow. Gems each ahead of the general gem rule.
        (tags: ["metal:aluminium"], skill: "core:mining", level: 50, tool: "pickaxe", tier: 4, xp: 396.0, prospect: 1188.0),
        (tags: ["graphite"], skill: "core:mining", level: 45, tool: "pickaxe", tier: 4, xp: 280.0, prospect: 840.0),
        (tags: ["gem:emerald"], skill: "core:mining", level: 42, tool: "pickaxe", tier: 4, xp: 227.0, prospect: 681.0),
        (tags: ["magnetic"], skill: "core:mining", level: 40, tool: "pickaxe", tier: 4, xp: 198.0, prospect: 594.0),
        (tags: ["gem:ruby"], skill: "core:mining", level: 38, tool: "pickaxe", tier: 4, xp: 172.0, prospect: 516.0),
        (tags: ["gem:sapphire"], skill: "core:mining", level: 38, tool: "pickaxe", tier: 4, xp: 172.0, prospect: 516.0),
        (tags: ["metal:zinc"], skill: "core:mining", level: 20, tool: "pickaxe", tier: 2, xp: 49.0, prospect: 147.0),
        (tags: ["metal:lead"], skill: "core:mining", level: 20, tool: "pickaxe", tier: 2, xp: 49.0, prospect: 147.0),
        (tags: ["ore", "gem"], skill: "core:mining", level: 45, tool: "pickaxe", tier: 4, xp: 280.0, prospect: 840.0),
        (tags: ["ore", "metal:gold"], skill: "core:mining", level: 35, tool: "pickaxe", tier: 3, xp: 140.0, prospect: 420.0),
        (tags: ["ore", "metal:silver"], skill: "core:mining", level: 30, tool: "pickaxe", tier: 3, xp: 99.0, prospect: 297.0),
        (tags: ["ore", "metal:cobalt"], skill: "core:mining", level: 25, tool: "pickaxe", tier: 3, xp: 70.0, prospect: 210.0),
        (tags: ["ore", "metal:iron"], skill: "core:mining", level: 15, tool: "pickaxe", tier: 2, xp: 35.0, prospect: 105.0),
        // Copper and tin want a stone pickaxe like coal; a copper sample still lifts with flint.
        (tags: ["ore", "metal:tin"], skill: "core:mining", level: 10, tool: "pickaxe", tier: 2, xp: 25.0, prospect: 75.0),
        (tags: ["ore_sample", "metal:copper"], skill: "core:mining", level: 5, tool: "pickaxe", tier: 1, xp: 17.5, prospect: 52.5),
        (tags: ["ore", "metal:copper"], skill: "core:mining", level: 5, tool: "pickaxe", tier: 2, xp: 17.5, prospect: 52.5),
        // Coal wants a stone pickaxe: a flint one only scratches the seam. Its
        // sample on the ground above lifts with flint, so the seam is found before it is dug.
        (tags: ["ore_sample", "fuel"], skill: "core:mining", level: 1, tool: "pickaxe", tier: 1, xp: 13.0, prospect: 39.0),
        (tags: ["ore", "fuel"], skill: "core:mining", level: 1, tool: "pickaxe", tier: 2, xp: 13.0, prospect: 39.0),
        (tags: ["ore"], skill: "core:mining", level: 1, tool: "pickaxe", tier: 1, xp: 10.0, prospect: 30.0),
        // Bare hands break neither rock nor a tree: stone wants a pickaxe and a log an axe,
        // flint ones at the least (recipes.ron), so the first tools are made, not found. A
        // log set down as a wall still wants the axe that felled it.
        (tags: ["stone", "natural"], skill: "core:mining", tool: "pickaxe", tier: 1, xp: 1.0),
        // A dead snag's trunk breaks to a stick, not a log, by hand too.
        (tags: ["log", "snag"], instead: ("stick", 1.0)),
        (tags: ["log", "natural"], tool: "axe", tier: 1),
        // Leaves pulled from a tree give a stick one time in five: the hafts of the first tools.
        (tags: ["leaves", "natural"], instead: ("stick", 0.2)),
        (tags: ["clay", "natural"], skill: "core:mining", xp: 2.0),
        // Tall grass cut with a knife gives twine one time in five, more with a better knife
        // (its yield adds: stone 1 in 4, copper 3 in 10, iron 7 in 20); by hand, nothing.
        (tags: ["fibre", "tall"], instead: ("twine", 0.2), by: "knife"),
        // Gravel breaks to flint one time in eight (arrowheads, spear points).
        (tags: ["gravel", "natural"], skill: "core:mining", xp: 1.0, instead: ("flint", 0.125)),
    ],
)
