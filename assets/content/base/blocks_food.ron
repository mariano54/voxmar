// Food and the stations that cook it (cooking.ron, docs/food-and-cooking.md). `food:N` is how
// much hunger it fills, `heal:N` the health it gives back at once: raw food only fills,
// cooked food fills more and heals. Stations are blocks whose tag recipes name.
(
    blocks: [
        // A campfire: logs and embers that cook one thing at a time and keep the cold off.
        (
            name: "campfire", render: Plant, solid: false, sound: Wood, textures: All("campfire"),
            light: 13, hardness: 0.6, color: (230, 120, 40), tags: ["campfire", "station", "heat", "fire"],
        ),
    ],
    families: [
        (template: "drop", name: "cooked_rabbit", tags: ["meat", "cooked", "edible", "food:5", "heal:4", "flavour:savoury"], all: (color: (160, 90, 50))),
        (template: "drop", name: "cooked_chicken", tags: ["meat", "cooked", "edible", "food:5", "heal:4", "flavour:savoury"], all: (color: (200, 140, 70))),
        (template: "drop", name: "cooked_duck", tags: ["meat", "cooked", "edible", "food:5", "heal:5", "flavour:savoury"], all: (color: (150, 80, 40))),
        (template: "drop", name: "cooked_mutton", tags: ["meat", "cooked", "edible", "food:6", "heal:5", "flavour:savoury"], all: (color: (140, 70, 40))),
        (template: "drop", name: "cooked_pork", tags: ["meat", "cooked", "edible", "food:7", "heal:6", "flavour:savoury"], all: (color: (190, 120, 70))),
        (template: "drop", name: "cooked_beef", tags: ["meat", "cooked", "edible", "food:8", "heal:6", "flavour:savoury"], all: (color: (120, 60, 30))),
        (template: "drop", name: "cooked_venison", tags: ["meat", "cooked", "edible", "food:8", "heal:7", "flavour:savoury", "game"], all: (color: (110, 50, 30))),
        (template: "drop", name: "cooked_bear", tags: ["meat", "cooked", "edible", "food:9", "heal:8", "flavour:savoury", "game"], all: (color: (100, 45, 30))),
        (template: "drop", name: "baked_potato", tags: ["root", "cooked", "edible", "food:5", "heal:3"], all: (color: (190, 140, 70))),
        (template: "drop", name: "roast_carrot", tags: ["root", "cooked", "edible", "food:4", "heal:2", "flavour:sweet"], all: (color: (220, 110, 30))),
        (template: "drop", name: "burnt_food", tags: ["burnt", "compost", "bait"], all: (color: (40, 34, 30))),
    ],
)
