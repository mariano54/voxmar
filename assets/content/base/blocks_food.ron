// Food and the stations that cook it (cooking.ron, docs/food-and-cooking.md). `heal:N` is the
// health eating it gives back: cooked food 0.4 × the level that cooks it, at least 2 (design
// draft 55, about a fifth of the health of a player who can make it); raw food 1 and fruit
// 2 (vitals). Stations are blocks whose tag recipes name.
(
    blocks: [
        // Thatch or wattle on fire (fire.ron): a flame that lights what catches beside it and
        // is gone when it has burned. Broken by hand, it is put out, and leaves nothing.
        (
            name: "blaze", render: Plant, solid: false, sound: Wood, textures: All("campfire"),
            light: 14, drops: "core:air", hardness: 0.0, color: (240, 130, 40), tags: ["creative_only", "fire", "blaze"],
            particles: [
                (style: Flame, rate: 55.0, at: (0.5, 0.25, 0.5), spread: 0.24, size: 2.6, height: 1.1, color: Some((236, 112, 18))),
                (style: Flame, rate: 30.0, at: (0.5, 0.3, 0.5), spread: 0.1, size: 2.0, height: 0.6, color: Some((250, 168, 28))),
            ],
        ),
        // A campfire: logs and embers that cook one thing at a time and keep the cold off,
        // and the wild back 8 blocks at night (`ward`).
        // A `furnishing`: a village's gives nothing, one a player placed gives itself back.
        (
            name: "campfire", render: Plant, solid: false, sound: Wood, textures: All("campfire"),
            light: 13, hardness: 0.6, color: (230, 120, 40), tags: ["campfire", "station", "heat", "fire", "hob", "furnishing"], ward: 8.0,
            // Flames licking a block and more above the logs, a deep yellow core among them,
            // smoke thick over the fire and thinning as it rises a few blocks, embers
            // floating up as high, and now and then a crackle of sparks (`particles`:
            // engine/src/block.rs, `Emission`). Fire's colours run deep yellow to red with
            // no near-white, which the glow would wash pink; smoke is a neutral grey.
            particles: [
                (style: Flame, rate: 55.0, at: (0.5, 0.25, 0.5), spread: 0.24, size: 2.6, height: 1.1, color: Some((236, 112, 18))),
                (style: Flame, rate: 30.0, at: (0.5, 0.3, 0.5), spread: 0.1, size: 2.0, height: 0.6, color: Some((250, 168, 28))),
                (style: Smoke, rate: 10.0, at: (0.5, 1.1, 0.5), spread: 0.2, size: 1.4, height: 4.0, color: Some((112, 112, 112))),
                (style: Ember, rate: 6.0, at: (0.5, 0.4, 0.5), spread: 0.3, height: 3.0, color: Some((226, 84, 16))),
                (style: Spark, rate: 0.6, count: 5, at: (0.5, 0.3, 0.5), spread: 0.15, height: 2.0, color: Some((248, 150, 30))),
            ],
        ),
        // A torch: a stick with a burning tip, to light the night. Its flame flickers, and
        // the odd ember and wisp of smoke rise from it.
        (
            name: "torch", render: Plant, solid: false, sound: Wood, textures: All("torch_lit"),
            light: 14, hardness: 0.0, color: (250, 180, 60), tags: ["light", "fire"], wall: "wall_torch",
            particles: [
                (style: Flame, rate: 26.0, at: (0.5, 0.78, 0.5), spread: 0.04, size: 1.6, height: 0.35, color: Some((240, 128, 20))),
                (style: Ember, rate: 0.5, at: (0.5, 0.75, 0.5), spread: 0.04, size: 0.7, height: 2.0, color: Some((226, 84, 16))),
                (style: Smoke, rate: 0.8, at: (0.5, 0.9, 0.5), spread: 0.02, size: 0.45, color: Some((112, 112, 112))),
            ],
        ),
        // A torch placed against a wall's side: it leans out from the wall, its flame over
        // its tip. The four facings are blocks of their own (`wall_torch` faces north, -z;
        // `wall_torch_east`, `_south`, `_west`), so settlements can place them directly.
        (
            name: "wall_torch", render: Plant, solid: false, sound: Wood, textures: All("torch_lit"),
            light: 14, hardness: 0.0, color: (250, 180, 60), tags: ["light", "fire"], drops: "torch",
            facing: true, support: Wall, model: Wall,
            particles: [
                (style: Flame, rate: 26.0, at: (0.5, 0.84, 0.67), spread: 0.04, size: 1.6, height: 0.35),
                (style: Ember, rate: 0.5, at: (0.5, 0.81, 0.68), spread: 0.04, size: 0.7, height: 2.0),
                (style: Smoke, rate: 0.8, at: (0.5, 0.96, 0.63), spread: 0.02, size: 0.45),
            ],
        ),
    ],
    families: [
        (template: "drop", name: "cooked_small_game", tags: ["meat", "cooked", "edible", "heal:4", "flavour:savoury"], all: (color: (160, 90, 50))),
        (template: "drop", name: "cooked_crab", tags: ["meat", "cooked", "edible", "heal:4", "flavour:savoury", "seafood"], all: (color: (230, 110, 60))),
        (template: "drop", name: "cooked_duck", tags: ["meat", "cooked", "edible", "heal:4", "flavour:savoury"], all: (color: (150, 80, 40), rarity: Uncommon)),
        (template: "drop", name: "cooked_mutton", tags: ["meat", "cooked", "edible", "heal:4", "flavour:savoury"], all: (color: (140, 70, 40))),
        (template: "drop", name: "cooked_pork", tags: ["meat", "cooked", "edible", "heal:4", "flavour:savoury"], all: (color: (190, 120, 70))),
        (template: "drop", name: "cooked_beef", tags: ["meat", "cooked", "edible", "heal:5", "flavour:savoury"], all: (color: (120, 60, 30))),
        (template: "drop", name: "cooked_venison", tags: ["meat", "cooked", "edible", "heal:6", "flavour:savoury", "game"], all: (color: (110, 50, 30))),
        (template: "drop", name: "cooked_bear", tags: ["meat", "cooked", "edible", "heal:10", "flavour:savoury", "game"], all: (color: (100, 45, 30), rarity: Uncommon)),
        (template: "drop", name: "baked_potato", tags: ["root", "cooked", "edible", "heal:4"], all: (color: (190, 140, 70), rarity: Uncommon)),
        (template: "drop", name: "roast_carrot", tags: ["root", "cooked", "edible", "heal:4", "flavour:sweet"], all: (color: (220, 110, 30))),
        (template: "drop", name: "egg", tags: ["egg", "raw", "edible"], all: (color: (240, 228, 200))),
        (template: "drop", name: "fried_egg", tags: ["egg", "cooked", "edible", "heal:4"], all: (color: (250, 220, 120))),
        (template: "drop", name: "milk", tags: ["dairy", "drink", "edible"], all: (color: (245, 245, 240))),
        // Fish (fishing.ron): raw ones heal 1, cooked ones by the level that cooks them.
        (template: "drop", name: "raw_minnow", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_minnow", tags: ["fish", "cooked", "edible", "heal:4", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_sardine", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_sardine", tags: ["fish", "cooked", "edible", "heal:4", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_perch", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_perch", tags: ["fish", "cooked", "edible", "heal:4", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_trout", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_trout", tags: ["fish", "cooked", "edible", "heal:6", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_cod", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_cod", tags: ["fish", "cooked", "edible", "heal:8", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_salmon", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_salmon", tags: ["fish", "cooked", "edible", "heal:10", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_carp", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_carp", tags: ["fish", "cooked", "edible", "heal:12", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_bass", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_bass", tags: ["fish", "cooked", "edible", "heal:14", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_pike", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_pike", tags: ["fish", "cooked", "edible", "heal:16", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_eel", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190), rarity: Uncommon)),
        (template: "drop", name: "cooked_eel", tags: ["fish", "cooked", "edible", "heal:18", "seafood", "flavour:savoury"], all: (color: (200, 150, 100), rarity: Uncommon)),
        (template: "drop", name: "raw_tuna", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_tuna", tags: ["fish", "cooked", "edible", "heal:20", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_sturgeon", tags: ["fish", "raw", "edible", "seafood"], all: (color: (130, 125, 115), rarity: Uncommon)),
        (template: "drop", name: "cooked_sturgeon", tags: ["fish", "cooked", "edible", "heal:22", "seafood", "flavour:savoury"], all: (color: (200, 150, 100), rarity: Uncommon)),
        (template: "drop", name: "raw_marlin", tags: ["fish", "raw", "edible", "seafood"], all: (color: (60, 100, 160), rarity: Rare)),
        (template: "drop", name: "cooked_marlin", tags: ["fish", "cooked", "edible", "heal:24", "seafood", "flavour:savoury"], all: (color: (200, 150, 100), rarity: Rare)),
        (template: "drop", name: "raw_swordfish", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190), rarity: Rare)),
        (template: "drop", name: "cooked_swordfish", tags: ["fish", "cooked", "edible", "heal:26", "seafood", "flavour:savoury"], all: (color: (200, 150, 100), rarity: Rare)),
        (template: "drop", name: "raw_deepwater_lanternfish", tags: ["fish", "raw", "edible", "seafood"], all: (color: (40, 60, 90), rarity: Rare)),
        (template: "drop", name: "cooked_deepwater_lanternfish", tags: ["fish", "cooked", "edible", "heal:28", "seafood", "flavour:savoury"], all: (color: (200, 150, 100), rarity: Rare)),
        (template: "drop", name: "raw_glimmer_koi", tags: ["fish", "raw", "edible", "seafood"], all: (color: (150, 170, 190), rarity: VeryRare)),
        (template: "drop", name: "cooked_glimmer_koi", tags: ["fish", "cooked", "edible", "heal:30", "seafood", "flavour:savoury"], all: (color: (200, 150, 100), rarity: VeryRare)),
        // Tools for what kept animals give.
        (template: "drop", name: "shears", tags: ["shears", "tool"], all: (color: (150, 150, 155))),
        (template: "drop", name: "pail", tags: ["pail", "tool"], all: (color: (150, 110, 70))),
        (template: "drop", name: "burnt_food", tags: ["burnt", "compost", "bait"], all: (color: (40, 34, 30))),
    ],
    // Rabbit, chicken and frog were one meat in all but name (Cooking 1, healing 4; frog
    // only taught less), so they are one now (items law, Oct 14).
    renamed: {
        "raw_rabbit": "raw_small_game",
        "raw_chicken": "raw_small_game",
        "cooked_rabbit": "cooked_small_game",
        "cooked_chicken": "cooked_small_game",
        "raw_frog": "raw_small_game",
        "cooked_frog": "cooked_small_game",
        // Shrimp cooked, healed and taught as minnows did; minnows bite in any water now.
        "raw_shrimp": "raw_minnow",
        "cooked_shrimp": "cooked_minnow",
    },
)
