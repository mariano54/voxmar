// Food and the stations that cook it (cooking.ron, docs/food-and-cooking.md). `food:N` is how
// much hunger it fills, `heal:N` the health it gives back at once: raw food only fills,
// cooked food fills more and heals. Stations are blocks whose tag recipes name.
(
    blocks: [
        // A campfire: logs and embers that cook one thing at a time and keep the cold off.
        // A `furnishing`: a village's gives nothing, one a player placed gives itself back.
        (
            name: "campfire", render: Plant, solid: false, sound: Wood, textures: All("campfire"),
            light: 13, hardness: 0.6, color: (230, 120, 40), tags: ["campfire", "station", "heat", "fire", "furnishing"],
            // Flames licking a block and more above the logs, a deep yellow core among them,
            // smoke thick over the fire and thinning as it rises a few blocks, embers
            // floating up as high, and now and then a crackle of sparks (`particles`:
            // engine/src/block.rs, `Emission`). Fire's colours run deep yellow to red with
            // no near-white, which the glow would wash pink; smoke is a neutral grey.
            particles: [
                (style: Flame, rate: 55.0, at: (0.5, 0.25, 0.5), spread: 0.24, size: 2.6, height: 1.1, color: Some((236, 112, 18))),
                (style: Flame, rate: 30.0, at: (0.5, 0.3, 0.5), spread: 0.1, size: 2.0, height: 0.6, color: Some((250, 168, 28))),
                (style: Smoke, rate: 10.0, at: (0.5, 1.1, 0.5), spread: 0.2, size: 1.4, height: 4.0, color: Some((112, 112, 112))),
                (style: Ember, rate: 6.0, at: (0.5, 0.4, 0.5), spread: 0.3, height: 3.0, color: Some((226, 84, 16))),
                (style: Spark, rate: 0.6, count: 5, at: (0.5, 0.3, 0.5), spread: 0.15, height: 2.0, color: Some((248, 150, 30))),
            ],
        ),
        // A torch: a stick with a burning tip, to light the night. Its flame flickers, and
        // the odd ember and wisp of smoke rise from it.
        (
            name: "torch", render: Plant, solid: false, sound: Wood, textures: All("torch_lit"),
            light: 14, hardness: 0.0, color: (250, 180, 60), tags: ["light", "fire"], wall: "wall_torch",
            particles: [
                (style: Flame, rate: 26.0, at: (0.5, 0.78, 0.5), spread: 0.04, size: 1.6, height: 0.35, color: Some((240, 128, 20))),
                (style: Ember, rate: 0.5, at: (0.5, 0.75, 0.5), spread: 0.04, size: 0.7, height: 2.0, color: Some((226, 84, 16))),
                (style: Smoke, rate: 0.8, at: (0.5, 0.9, 0.5), spread: 0.02, size: 0.45, color: Some((112, 112, 112))),
            ],
        ),
        // A torch placed against a wall's side: it leans out from the wall, its flame over
        // its tip. The four facings are blocks of their own (`wall_torch` faces north, -z;
        // `wall_torch_east`, `_south`, `_west`), so settlements can place them directly.
        (
            name: "wall_torch", render: Plant, solid: false, sound: Wood, textures: All("torch_lit"),
            light: 14, hardness: 0.0, color: (250, 180, 60), tags: ["light", "fire"], drops: "torch",
            facing: true, support: Wall, model: Wall,
            particles: [
                (style: Flame, rate: 26.0, at: (0.5, 0.84, 0.67), spread: 0.04, size: 1.6, height: 0.35),
                (style: Ember, rate: 0.5, at: (0.5, 0.81, 0.68), spread: 0.04, size: 0.7, height: 2.0),
                (style: Smoke, rate: 0.8, at: (0.5, 0.96, 0.63), spread: 0.02, size: 0.45),
            ],
        ),
    ],
    families: [
        (template: "drop", name: "cooked_rabbit", tags: ["meat", "cooked", "edible", "food:5", "heal:4", "flavour:savoury"], all: (color: (160, 90, 50))),
        (template: "drop", name: "cooked_chicken", tags: ["meat", "cooked", "edible", "food:5", "heal:4", "flavour:savoury"], all: (color: (200, 140, 70))),
        (template: "drop", name: "cooked_frog", tags: ["meat", "cooked", "edible", "food:3", "heal:2", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "cooked_crab", tags: ["meat", "cooked", "edible", "food:5", "heal:4", "flavour:savoury", "seafood"], all: (color: (230, 110, 60))),
        (template: "drop", name: "cooked_duck", tags: ["meat", "cooked", "edible", "food:5", "heal:5", "flavour:savoury"], all: (color: (150, 80, 40), rarity: Uncommon)),
        (template: "drop", name: "cooked_mutton", tags: ["meat", "cooked", "edible", "food:6", "heal:5", "flavour:savoury"], all: (color: (140, 70, 40))),
        (template: "drop", name: "cooked_pork", tags: ["meat", "cooked", "edible", "food:7", "heal:6", "flavour:savoury"], all: (color: (190, 120, 70))),
        (template: "drop", name: "cooked_beef", tags: ["meat", "cooked", "edible", "food:8", "heal:6", "flavour:savoury"], all: (color: (120, 60, 30))),
        (template: "drop", name: "cooked_venison", tags: ["meat", "cooked", "edible", "food:8", "heal:7", "flavour:savoury", "game"], all: (color: (110, 50, 30))),
        (template: "drop", name: "cooked_bear", tags: ["meat", "cooked", "edible", "food:9", "heal:8", "flavour:savoury", "game"], all: (color: (100, 45, 30), rarity: Uncommon)),
        (template: "drop", name: "baked_potato", tags: ["root", "cooked", "edible", "food:5", "heal:3"], all: (color: (190, 140, 70), rarity: Uncommon)),
        (template: "drop", name: "roast_carrot", tags: ["root", "cooked", "edible", "food:4", "heal:2", "flavour:sweet"], all: (color: (220, 110, 30))),
        (template: "drop", name: "egg", tags: ["egg", "raw", "edible", "food:1"], all: (color: (240, 228, 200))),
        (template: "drop", name: "fried_egg", tags: ["egg", "cooked", "edible", "food:4", "heal:3"], all: (color: (250, 220, 120))),
        (template: "drop", name: "milk", tags: ["dairy", "drink", "edible", "food:3"], all: (color: (245, 245, 240))),
        // Fish (fishing.ron): raw ones barely fill, cooked ones heal well.
        (template: "drop", name: "raw_shrimp", tags: ["fish", "raw", "edible", "food:1", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_shrimp", tags: ["fish", "cooked", "edible", "food:2", "heal:1", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_minnow", tags: ["fish", "raw", "edible", "food:1", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_minnow", tags: ["fish", "cooked", "edible", "food:1", "heal:1", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_sardine", tags: ["fish", "raw", "edible", "food:1", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_sardine", tags: ["fish", "cooked", "edible", "food:3", "heal:2", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_perch", tags: ["fish", "raw", "edible", "food:1", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_perch", tags: ["fish", "cooked", "edible", "food:4", "heal:3", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_trout", tags: ["fish", "raw", "edible", "food:1", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_trout", tags: ["fish", "cooked", "edible", "food:5", "heal:4", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_cod", tags: ["fish", "raw", "edible", "food:1", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_cod", tags: ["fish", "cooked", "edible", "food:6", "heal:5", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_salmon", tags: ["fish", "raw", "edible", "food:1", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_salmon", tags: ["fish", "cooked", "edible", "food:7", "heal:6", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_carp", tags: ["fish", "raw", "edible", "food:1", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_carp", tags: ["fish", "cooked", "edible", "food:7", "heal:6", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_bass", tags: ["fish", "raw", "edible", "food:1", "seafood"], all: (color: (150, 170, 190))),
        (template: "drop", name: "cooked_bass", tags: ["fish", "cooked", "edible", "food:8", "heal:7", "seafood", "flavour:savoury"], all: (color: (200, 150, 100))),
        (template: "drop", name: "raw_pike", tags: ["fish", "raw", "edible", "food:1", "seafood"], all: (color: (150, 170, 190))),
