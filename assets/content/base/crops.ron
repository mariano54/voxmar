// Crops: sown from seeds (or, for roots, from what they yield) on soil, growing through
// three stages to ripe (the `crop` and `root_crop` templates in blocks.ron make the
// blocks: `<name>_crop_0` to `_2`, the ripe `<name>_crop`, `<name>_seeds` and `<name>`).
//
// - `level` is the farming level sowing it takes; `xp` what sowing, harvesting and
//   foraging a wild one give. Experience per crop doubles about every ten levels, so
//   each level's crops train about as fast as the curve rises (research/farming.md 12.8).
// - `minutes` is real time from sowing to ripe where everything suits it: inside its
//   `comfort` (temperature °C and moisture, as plants.ron's), in at least `light` (sky
//   or lamp, 0..=15), on fertile ground with water within four blocks. Outside its
//   comfort it slows, to a stop 5 °C or 0.3 moisture beyond; dry or plain ground slows
//   it too (engine/src/crop.rs).
// - `harvest` is what a ripe one gives, broken or (for those with `regrow`) picked by hand,
//   which takes it back to that stage to fruit again. Each find has a chance; uncommon and
//   rarer finds come up to half again as often with level.
// - `wild` names wild plants that are this crop gone wild, and `forage` what each gives.
//   Most crops are rare; their wild forms are where seeds come from first.
(
    crops: [
        (
            name: "wheat", level: 1, xp: (plant: 2.0, harvest: 9.0, forage: 2.0), minutes: 12.0,
            comfort: (temperature: (2.0, 28.0), moisture: (0.25, 1.5)),
            harvest: [(item: "wheat", count: (1, 2)), (item: "wheat_seeds", count: (1, 3), chance: 0.95)],
            wild: ["wild_wheat"],
            forage: [(item: "wheat_seeds", count: (1, 2)), (item: "wheat", chance: 0.3)],
        ),
        (
            name: "carrot", seed: "carrot", level: 5, xp: (plant: 3.0, harvest: 11.0, forage: 2.0), minutes: 14.0,
            comfort: (temperature: (2.0, 24.0), moisture: (0.4, 1.6)),
            harvest: [(item: "carrot", count: (2, 4))],
            wild: ["wild_carrot"],
            forage: [(item: "carrot", chance: 0.6)],
        ),
        (
            name: "potato", seed: "potato", level: 12, rarity: Uncommon, xp: (plant: 4.0, harvest: 19.0), minutes: 16.0,
            comfort: (temperature: (0.0, 22.0), moisture: (0.5, 1.8)),
            harvest: [(item: "potato", count: (2, 4))],
        ),
        (
            name: "cabbage", level: 20, rarity: Uncommon, xp: (plant: 7.0, harvest: 33.0), minutes: 22.0,
            comfort: (temperature: (-4.0, 20.0), moisture: (0.6, 2.0)),
            harvest: [(item: "cabbage"), (item: "cabbage_seeds", count: (1, 2), chance: 0.6)],
        ),
        (
            name: "tomato", level: 30, rarity: Rare, xp: (plant: 16.0, harvest: 30.0), minutes: 26.0, regrow: 2,
            comfort: (temperature: (14.0, 32.0), moisture: (0.4, 1.5)),
            harvest: [(item: "tomato", count: (1, 3)), (item: "tomato_seeds", chance: 0.15, rarity: Uncommon)],
        ),
        (
            name: "strawberry", level: 38, rarity: Rare, xp: (plant: 28.0, harvest: 50.0), minutes: 22.0, regrow: 2,
            comfort: (temperature: (6.0, 24.0), moisture: (0.6, 1.8)),
            harvest: [(item: "strawberry", count: (2, 4)), (item: "strawberry_seeds", chance: 0.12, rarity: Uncommon)],
        ),
        (
            name: "chili_pepper", level: 45, rarity: Rare, xp: (plant: 45.0, harvest: 80.0, forage: 10.0), minutes: 30.0, regrow: 2,
            comfort: (temperature: (18.0, 38.0), moisture: (0.2, 1.3)),
            harvest: [(item: "chili_pepper", count: (1, 3)), (item: "chili_pepper_seeds", chance: 0.12, rarity: Uncommon)],
            wild: ["chili"],
            forage: [(item: "chili_pepper", count: (1, 2), chance: 0.6), (item: "chili_pepper_seeds", chance: 0.4, rarity: Rare)],
        ),
        (
            name: "saffron", level: 60, rarity: VeryRare, xp: (plant: 128.0, harvest: 512.0), minutes: 45.0,
            comfort: (temperature: (6.0, 28.0), moisture: (0.15, 0.8)),
            harvest: [(item: "saffron", count: (1, 2)), (item: "saffron_seeds", chance: 0.35, rarity: Uncommon)],
        ),
        // Opens and grows by night: it needs no light at all.
        (
            name: "moonbloom", level: 75, rarity: VeryRare, xp: (plant: 360.0, harvest: 1450.0, forage: 50.0), minutes: 60.0, light: 0,
            comfort: (temperature: (0.0, 24.0), moisture: (0.5, 2.2)),
            harvest: [(item: "moonbloom"), (item: "moonbloom_seeds", chance: 0.25, rarity: Rare)],
