// Village furnishings (settlements.ron's `furnishings` name them): what settlements set in
// yards, barns, lanes and on their bell frames. Breaking one gives nothing (design draft
// 80), so a village is no free store of goods; their tags say what they are, never what
// they yield (no `herb` or `plant`, which regrowth and foraging read). Art is in the
// default pack's furnishings.ron.
//
// Homes (design draft 108, P58a) are below: wood furniture in three woods, cloth things in
// twelve dyes, and crockery in three glazes, each a template that one family line fills in.
// Their boxes are in shapes.ron and their greyscale drawings, which a block's `tint:
// Fixed(r, g, b)` colours (a wood's, a dye's), in the default pack's decor.ron. A piece a
// player placed gives itself back when broken, so a home can be rearranged or moved; the
// `furnishing` tag makes one a village placed give nothing, as its props do.
(
    // The dyes `dyes: true` families are made over: each is a name (`family.base.<name>` in
    // the language files) and the colour a greyscale drawing is multiplied by. The colours
    // are meant for white-ish cloth, bright enough to show a weave in.
    dyes: [
        (name: "white", rgb: (246, 244, 238)),
        (name: "cream", rgb: (240, 224, 184)),
        (name: "ochre", rgb: (204, 160, 70)),
        (name: "amber", rgb: (238, 170, 36)),
        (name: "red", rgb: (196, 52, 46)),
        (name: "rust", rgb: (168, 86, 48)),
        (name: "rose", rgb: (226, 128, 150)),
        (name: "mulberry", rgb: (122, 56, 120)),
        (name: "indigo", rgb: (52, 64, 150)),
        (name: "sky", rgb: (112, 170, 224)),
        (name: "teal", rgb: (44, 142, 140)),
        (name: "green", rgb: (76, 140, 70)),
    ],
    templates: {
        // Furniture in one wood (`{name}`): boxes in a drawing of grain, tinted the wood's
        // colour (the family line below). Broken, a placed piece gives itself back. Seats
        // are not solid: a player sits in one, feet on the floor, so a chair under a roof
        // two blocks up is sat on as one in the open is.
        "furniture": [
            (name: "{name}_stool", render: Model, shape: "stool", solid: false, sound: Wood, textures: All("furniture_wood"), hardness: 1.0, color: (160, 120, 70), tags: ["furniture", "seat", "decor", "wood"]),
            (name: "{name}_chair", render: Model, shape: "chair", facing: true, solid: false, sound: Wood, textures: All("furniture_wood"), hardness: 1.0, color: (160, 120, 70), tags: ["furniture", "seat", "decor", "wood"]),
            (name: "{name}_bench", render: Model, shape: "bench", facing: true, solid: false, sound: Wood, textures: All("furniture_wood"), hardness: 1.2, color: (160, 120, 70), tags: ["furniture", "seat", "decor", "wood", "yard"]),
            (name: "{name}_table", render: Model, shape: "table", sound: Wood, textures: All("furniture_wood"), hardness: 1.2, color: (160, 120, 70), tags: ["furniture", "table", "decor", "wood"]),
            (name: "{name}_bed", render: Model, shape: "bed", facing: true, sound: Wood, textures: All("furniture_wood"), hardness: 1.2, color: (160, 120, 70), tags: ["furniture", "bed", "decor", "wood"]),
            (name: "{name}_shelf", render: Model, shape: "shelf", facing: true, sound: Wood, textures: All("furniture_wood"), hardness: 1.2, color: (160, 120, 70), tags: ["furniture", "shelf", "storage", "decor", "wood"]),
            (name: "{name}_bookshelf", render: Model, shape: "bookshelf", facing: true, sound: Wood, textures: All("furniture_wood"), hardness: 1.2, color: (160, 120, 70), tags: ["furniture", "shelf", "storage", "books", "decor", "wood"]),
            (name: "{name}_cupboard", render: Model, shape: "cupboard", facing: true, sound: Wood, textures: All("furniture_wood"), hardness: 1.5, color: (160, 120, 70), tags: ["furniture", "cupboard", "storage", "decor", "wood"]),
            (name: "{name}_wardrobe", render: Model, shape: "wardrobe", facing: true, sound: Wood, textures: All("furniture_wood"), hardness: 1.5, color: (160, 120, 70), tags: ["furniture", "cupboard", "storage", "decor", "wood"]),
            (name: "{name}_desk", render: Model, shape: "desk", facing: true, sound: Wood, textures: All("furniture_wood"), hardness: 1.5, color: (160, 120, 70), tags: ["furniture", "table", "decor", "wood"]),
            (name: "{name}_counter", render: Model, shape: "counter", sound: Wood, textures: All("furniture_wood"), hardness: 1.5, color: (160, 120, 70), tags: ["furniture", "table", "decor", "wood"]),
            (name: "{name}_barrel_rack", render: Model, shape: "barrel_rack", facing: true, sound: Wood, textures: All("furniture_wood"), hardness: 1.5, color: (160, 120, 70), tags: ["furniture", "storage", "decor", "wood"]),
            (name: "{name}_crate_stack", render: Model, shape: "crate_stack", sound: Wood, textures: All("furniture_crate"), hardness: 1.5, color: (160, 120, 70), tags: ["furniture", "storage", "decor", "wood"]),
            // A window seat: a panelled box under a cushion, built in under a window to sit
            // at (`seat`) with things kept in it (`storage`).
            (name: "{name}_window_seat", render: Model, shape: "window_seat", facing: true, solid: false, sound: Wood, textures: All("furniture_wood"), hardness: 1.2, color: (160, 120, 70), tags: ["furniture", "seat", "storage", "decor", "wood"]),
            // A deep sill: a board on two brackets along the wall at the top of its cell, set
            // under a window inside, for a pot or a candle.
            (name: "{name}_sill", render: Model, shape: "deep_sill", facing: true, sound: Wood, textures: All("furniture_wood"), hardness: 1.0, color: (160, 120, 70), tags: ["furniture", "sill", "decor", "wood"]),
            // Pantry shelves: a shelf stood with crocks and a keg, a store for the home's food
            // (`storage`, counted by a pantry and a larder).
            (name: "{name}_pantry_shelf", render: Model, shape: "pantry_shelf", facing: true, sound: Wood, textures: All("furniture_wood"), hardness: 1.2, color: (160, 120, 70), tags: ["furniture", "shelf", "storage", "pantry", "decor", "wood"]),
            (name: "{name}_pot_shelf", render: Model, shape: "pot_shelf", facing: true, sound: Wood, textures: All("furniture_wood"), hardness: 1.0, color: (160, 120, 70), tags: ["furniture", "shelf", "storage", "decor", "wood"]),
        ],
        // Cloth in one dye (`dyes: true` fills `{name}` and the tint): the greyscale drawings
        // of cloth_grey and its kin, multiplied by the dye. Broken, a placed piece gives itself back.
        "dyed": [
            (name: "{name}_cloth", sound: Moss, textures: All("cloth_grey"), hardness: 0.4, color: (200, 200, 200), tags: ["cloth", "decor", "building", "colour:{name}", "shelter:draughty"]),
            (name: "{name}_rug", render: Model, shape: "rug", solid: false, sound: Moss, textures: All("rug_grey"), hardness: 0.2, color: (200, 200, 200), tags: ["cloth", "rug", "decor", "colour:{name}"]),
            (name: "{name}_banner", render: Model, shape: "banner", facing: true, solid: false, sound: Moss, textures: All("banner_grey"), hardness: 0.2, color: (200, 200, 200), tags: ["cloth", "banner", "decor", "colour:{name}"]),
            (name: "{name}_wall_hanging", render: Model, shape: "wall_hanging", facing: true, solid: false, sound: Moss, textures: All("hanging_grey"), hardness: 0.2, color: (200, 200, 200), tags: ["cloth", "drape", "decor", "colour:{name}"]),
            // A curtain drawn across, and drawn back (a right click, `swaps`, as a door). Drawn
            // across a window it keeps most of the room's light in (`light_filter`), so a lit
            // home's window glows low at night; drawn back, the light goes through as air.
            (name: "{name}_curtain", render: Model, shape: "curtain", facing: true, solid: false, light_filter: 8, sound: Moss, textures: All("curtain_grey"), hardness: 0.2, color: (200, 200, 200),
                swaps: "{name}_curtain_open", tags: ["cloth", "curtain", "drape", "decor", "colour:{name}"]),
            (name: "{name}_curtain_open", render: Model, shape: "curtain_open", facing: true, solid: false, sound: Moss, textures: All("curtain_grey"), hardness: 0.2, color: (200, 200, 200),
                swaps: "{name}_curtain", drops: "{name}_curtain", tags: ["cloth", "curtain", "drape", "decor", "colour:{name}"]),
            (name: "{name}_paper_lantern", render: Model, shape: "paper_lantern", solid: false, sound: Moss, light: 12, textures: All("lantern_grey"), hardness: 0.2, color: (200, 200, 200), tags: ["cloth", "lantern", "light", "decor", "colour:{name}"]),
            (name: "{name}_cushion", render: Model, shape: "cushion", solid: false, sound: Moss, textures: All("cushion_grey"), hardness: 0.2, color: (200, 200, 200), tags: ["cloth", "seat", "cushion", "decor", "colour:{name}"]),
            (name: "{name}_bunting", render: Model, shape: "bunting", facing: true, solid: false, sound: Moss, textures: All("bunting_grey"), hardness: 0.1, color: (200, 200, 200), tags: ["cloth", "bunting", "decor", "yard", "colour:{name}"]),
            (name: "{name}_awning", render: Model, shape: "awning", facing: true, solid: false, sound: Moss, textures: All("awning_grey"), hardness: 0.3, color: (200, 200, 200), tags: ["cloth", "awning", "decor", "building", "colour:{name}", "shelter:draughty"]),
        ],
        // Crockery in one glaze: a plate, a bowl, a jar, a jug and a basket for tables and
        // shelves; broken, a placed piece gives itself back.
        "crockery": [
            (name: "{name}_plate", render: Model, shape: "plate", solid: false, sound: Stone, textures: All("crockery_grey"), hardness: 0.1, color: (190, 120, 80), tags: ["crockery", "decor"]),
            (name: "{name}_bowl", render: Model, shape: "bowl", solid: false, sound: Stone, textures: All("crockery_grey"), hardness: 0.1, color: (190, 120, 80), tags: ["crockery", "decor"]),
            (name: "{name}_jar", render: Model, shape: "jar", solid: false, sound: Stone, textures: All("crockery_grey"), hardness: 0.1, color: (190, 120, 80), tags: ["crockery", "storage", "decor"]),
            (name: "{name}_jug", render: Model, shape: "jug", solid: false, sound: Stone, textures: All("crockery_grey"), hardness: 0.1, color: (190, 120, 80), tags: ["crockery", "decor"]),
            (name: "{name}_basket", render: Model, shape: "basket", solid: false, sound: Grass, textures: All("basket_grey"), hardness: 0.1, color: (190, 120, 80), tags: ["crockery", "storage", "decor"]),
        ],
        // A hanging lantern of one metal (`{name}`: iron or copper), its drawing tinted the
        // metal's colour; it breaks to an ingot.
        "metal_lantern": [
            (
                name: "{name}_hanging_lantern", render: Model, shape: "hanging_lantern", solid: false, light: 14, sound: Stone, textures: All("metal_grey"),
                drops: "{name}_ingot", hardness: 0.5, color: (170, 170, 180), tags: ["lantern", "light", "decor", "metal"],
            ),
        ],
        // A stone lantern or a column of one stone (`{name}`), in that stone's own texture. A
        // column walls a room as soundly as the stone it is cut from (calcite, sandstone and
        // stone, all `shelter:sound`).
        "stone_lantern": [
            (
                name: "{name}_lantern", render: Model, shape: "stone_lantern", light: 10, sound: Stone, textures: All("{name}"),
                drops: "core:air", hardness: 1.5, color: (125, 125, 125), tags: ["lantern", "light", "decor", "stone"],
            ),
        ],
        "column": [
            (
                name: "{name}_column", render: Model, shape: "column", sound: Stone, textures: All("{name}"),
                drops: "core:air", hardness: 2.0, color: (125, 125, 125), tags: ["column", "decor", "building", "stone", "shelter:sound"],
            ),
        ],
    },
    blocks: [
        // A wooden door, two blocks tall: placed facing whoever sets it, its top half goes
        // in above with it (`upper`) and both break together, giving the door back. A right
        // click opens or shuts it (`swaps`, base:open), the server first, so nobody walks
        // through a door the server still holds shut. Shut, it is solid to players and
        // creatures alike, and no creature opens one: a home with its door shut keeps the
        // night out. Open, it stands against its jamb. It is not a furnishing: a village's
        // gives itself back too.
        (
            name: "wooden_door", render: Model, shape: "door", facing: true, sound: Wood, textures: All("oak_planks"),
            upper: "wooden_door_top", swaps: "wooden_door_open", hardness: 1.5, color: (150, 110, 65), tags: ["door", "door_shut", "wood", "building", "shelter:sound"],
        ),
        (
            name: "wooden_door_top", render: Model, shape: "door", facing: true, support: Below, sound: Wood, textures: All("oak_planks"),
            swaps: "wooden_door_open_top", drops: "core:air", hardness: 1.5, color: (150, 110, 65), tags: ["door", "door_shut", "wood", "building", "shelter:sound"],
        ),
        (
            name: "wooden_door_open", render: Model, shape: "door_open", facing: true, solid: false, sound: Wood, textures: All("oak_planks"),
            upper: "wooden_door_open_top", swaps: "wooden_door", drops: "wooden_door", hardness: 1.5, color: (150, 110, 65), tags: ["door", "door_open", "wood", "building"],
        ),
        (
            name: "wooden_door_open_top", render: Model, shape: "door_open", facing: true, solid: false, support: Below, sound: Wood, textures: All("oak_planks"),
            swaps: "wooden_door_top", drops: "core:air", hardness: 1.5, color: (150, 110, 65), tags: ["door", "door_open", "wood", "building"],
        ),
        // A bale of straw, tied in two places.
        (
            name: "hay_bale", sound: Grass, textures: Column(end: "hay_bale_top", side: "hay_bale_side"),
            drops: "core:air", hardness: 0.5, color: (200, 170, 70), tags: ["creative_only", "hay", "farm", "decor", "yard", "building", "shelter:draughty"],
        ),
        // A barrel of staves held by two iron hoops.
        (
            name: "barrel", render: Model, shape: "barrel", sound: Wood, textures: Column(end: "barrel_top", side: "barrel_side"),
            drops: "core:air", hardness: 2.0, color: (130, 90, 55), tags: ["creative_only", "barrel", "wood", "storage", "building"],
        ),
        // A slatted crate: boards with gaps between them, braced at the corners.
        (
            name: "crate", render: Model, shape: "crate", sound: Wood, textures: Sides(top: "crate_top", bottom: "crate_top", side: "crate_side"),
            drops: "core:air", hardness: 1.5, color: (160, 120, 70), tags: ["creative_only", "crate", "wood", "storage", "building"],
        ),
        // A sack of grain, its neck tied off.
        (
            name: "sack", render: Model, shape: "sack", sound: Grass, textures: Sides(top: "sack_top", bottom: "sack_top", side: "sack_side"),
            drops: "core:air", hardness: 0.4, color: (200, 180, 140), tags: ["creative_only", "sack", "cloth", "farm", "building"],
        ),
        // A bronze bell hanging from the beam above it.
        (
            name: "bell", render: Plant, solid: false, support: Above, sound: Stone, textures: All("bell"),
            drops: "core:air", hardness: 1.5, color: (190, 140, 60), tags: ["creative_only", "bell", "metal", "building"],
        ),
        // A fishing net hung to dry, with cork floats.
        (
            name: "fishing_net", render: Plant, solid: false, support: Above, sound: Grass, textures: All("fishing_net"),
            drops: "core:air", hardness: 0.2, color: (170, 150, 110), tags: ["creative_only", "net", "decor", "building"],
        ),
        // Bunches of herbs hung upside down to dry: two make a home's herb nook (`drying`).
        (
            name: "hanging_herbs", render: Plant, solid: false, support: Above, sound: Grass, textures: All("hanging_herbs"),
            drops: "core:air", hardness: 0.0, color: (110, 140, 70), tags: ["hanging", "drying", "decor"],
        ),

        // Singles. A candle (tallow until bees make wax), and the fire a hearth has.
        (
            name: "candle", render: Model, shape: "candle", solid: false, light: 8, sound: Wood, textures: All("candle_grey"), tint: Fixed(240, 228, 196),
            hardness: 0.0, color: (240, 228, 196), tags: ["candle", "light", "decor", "furnishing"],
            particles: [(style: Flame, rate: 8.0, at: (0.5, 0.45, 0.5), spread: 0.01, size: 0.7, height: 0.2, color: Some((240, 150, 40)))],
        ),
        (
            name: "brazier", render: Model, shape: "brazier", light: 14, sound: Stone, textures: All("brazier_iron"),
            drops: "core:air", hardness: 1.5, color: (90, 90, 96), tags: ["fire", "light", "decor", "metal"],
            particles: [
                (style: Flame, rate: 30.0, at: (0.5, 0.78, 0.5), spread: 0.18, size: 2.0, height: 0.5, color: Some((240, 128, 20))),
                (style: Smoke, rate: 1.0, at: (0.5, 0.9, 0.5), spread: 0.1, size: 0.6, color: Some((112, 112, 112))),
            ],
        ),
        // Decor until the Cooking machines land: a pot on three legs.
        (
            name: "cauldron", render: Model, shape: "cauldron", sound: Stone, textures: All("cauldron_iron"),
            drops: "core:air", hardness: 2.0, color: (60, 60, 66), tags: ["cooking", "decor", "metal"],
        ),
        // A brick stove: the campfire it is built round still burns in it. It cooks what a
        // campfire cooks (`campfire`), holds a cooking pot (`hob`), warms and lights the room
        // as a fire does (`heat`, `fire`, light 12: survival.ron's heat_emission), and smokes
        // from its flue.
        (
            name: "cottage_stove", render: Model, shape: "cottage_stove", sound: Stone, textures: All("stove_bricks"),
            light: 12, drops: "core:air", hardness: 2.0, color: (120, 90, 80), tags: ["cooking", "decor", "stone", "campfire", "heat", "fire", "hob"],
            particles: [
                (style: Smoke, rate: 3.0, at: (0.75, 1.05, 0.75), spread: 0.06, size: 0.9, height: 3.0, color: Some((112, 112, 112))),
            ],
        ),
        // Stand-ins for the Farm age's machines, which will have the plain names: a loom, a
        // spinning wheel and a quern for a weaver's or a miller's room.
        (
            name: "loom_frame", render: Model, shape: "loom_frame", facing: true, sound: Wood, textures: All("furniture_wood"), tint: Fixed(205, 150, 86),
            drops: "oak_planks", drop_count: 2, hardness: 1.5, color: (160, 120, 70), tags: ["workshop", "decor", "wood", "furnishing"],
        ),
        (
            name: "spindle_stand", render: Model, shape: "spindle_stand", facing: true, sound: Wood, textures: All("furniture_wood"), tint: Fixed(205, 150, 86),
            drops: "oak_planks", drop_count: 1, hardness: 1.5, color: (160, 120, 70), tags: ["workshop", "decor", "wood", "furnishing"],
        ),
        (
            name: "quern_stones", render: Model, shape: "quern_stones", facing: true, sound: Stone, textures: All("cobblestone"),
            drops: "core:air", hardness: 2.0, color: (110, 110, 110), tags: ["workshop", "decor", "stone"],
        ),
        // Prayer flags in the Cloud monks' five colours, drawn in colour (not a dye).
        (
            name: "wind_flags", render: Model, shape: "wind_flags", facing: true, solid: false, sound: Moss, textures: All("wind_flags"),
            drops: "core:air", hardness: 0.1, color: (200, 200, 200), tags: ["cloth", "bunting", "decor"],
        ),
        // Graves: a slab and a headstone, in stone and mossy stone.
        (name: "stone_grave_slab", render: Model, shape: "grave_slab", sound: Stone, textures: All("stone"), drops: "core:air", hardness: 2.0, color: (125, 125, 125), tags: ["grave", "decor", "stone"]),
        (name: "mossy_grave_slab", render: Model, shape: "grave_slab", sound: Stone, textures: All("mossy_cobblestone"), drops: "core:air", hardness: 2.0, color: (100, 118, 90), tags: ["grave", "decor", "stone", "mossy"]),
        (name: "stone_headstone", render: Model, shape: "headstone", facing: true, sound: Stone, textures: All("stone"), drops: "core:air", hardness: 2.0, color: (125, 125, 125), tags: ["grave", "decor", "stone"]),
        (name: "mossy_headstone", render: Model, shape: "headstone", facing: true, sound: Stone, textures: All("mossy_cobblestone"), drops: "core:air", hardness: 2.0, color: (100, 118, 90), tags: ["grave", "decor", "stone", "mossy"]),
    ],

    families: [
        // The three tones: pale birch, warm oak, dark oak.
        (template: "furniture", name: "birch", tags: ["furnishing"], all: (tint: Fixed(236, 212, 164), color: (200, 175, 125))),
        (template: "furniture", name: "oak", tags: ["furnishing"], all: (tint: Fixed(205, 150, 86), color: (160, 120, 70))),
        (template: "furniture", name: "dark_oak", tags: ["furnishing"], all: (tint: Fixed(130, 88, 58), color: (100, 70, 45))),
        (template: "dyed", dyes: true, tags: ["furnishing"]),
        (template: "crockery", name: "earthen", tags: ["furnishing"], all: (tint: Fixed(196, 120, 82), color: (196, 120, 82))),
        (template: "crockery", name: "ivory", tags: ["furnishing"], all: (tint: Fixed(238, 230, 208), color: (238, 230, 208))),
        (template: "metal_lantern", name: "iron", tags: ["furnishing"], all: (tint: Fixed(176, 178, 190), color: (176, 178, 190))),
        (template: "metal_lantern", name: "copper", tags: ["furnishing"], all: (tint: Fixed(214, 128, 86), color: (214, 128, 86))),
        (template: "stone_lantern", name: "stone"),
        (template: "stone_lantern", name: "sandstone"),
        (template: "column", name: "calcite"),
        (template: "column", name: "sandstone"),
        (template: "column", name: "stone"),
        (template: "crockery", name: "cobalt", tags: ["furnishing"], all: (tint: Fixed(70, 100, 170), color: (70, 100, 170))),
    ],
)
