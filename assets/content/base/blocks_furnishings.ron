// Village furnishings (settlements.ron's `furnishings` name them): what settlements set in
// yards, barns, lanes and on their bell frames, also placeable by players. Art is in the
// default pack's furnishings.ron.
(
    blocks: [
        // A bale of straw, tied in two places.
        (
            name: "hay_bale", sound: Grass, textures: Column(end: "hay_bale_top", side: "hay_bale_side"),
            hardness: 0.5, color: (200, 170, 70), tags: ["hay", "fuel", "farm", "building"],
        ),
        // A barrel of staves held by two iron hoops.
        (
            name: "barrel", sound: Wood, textures: Column(end: "barrel_top", side: "barrel_side"),
            hardness: 2.0, color: (130, 90, 55), tags: ["barrel", "wood", "storage", "building"],
        ),
        // A slatted crate: boards with gaps between them, braced at the corners.
        (
            name: "crate", sound: Wood, textures: Sides(top: "crate_top", bottom: "crate_top", side: "crate_side"),
            hardness: 1.5, color: (160, 120, 70), tags: ["crate", "wood", "storage", "building"],
        ),
        // A sack of grain, its neck tied off.
        (
            name: "sack", sound: Grass, textures: Sides(top: "sack_top", bottom: "sack_top", side: "sack_side"),
            hardness: 0.4, color: (200, 180, 140), tags: ["sack", "cloth", "farm", "building"],
        ),
        // A bronze bell hanging from the beam above it.
        (
            name: "bell", render: Plant, solid: false, support: Above, sound: Stone, textures: All("bell"),
            hardness: 1.5, color: (190, 140, 60), tags: ["bell", "metal", "building"],
        ),
        // A fishing net hung to dry, with cork floats.
        (
            name: "fishing_net", render: Plant, solid: false, sound: Grass, textures: All("fishing_net"),
            hardness: 0.2, color: (170, 150, 110), tags: ["net", "fibre", "fishing", "building"],
        ),
        // Bunches of herbs hung upside down to dry.
        (
            name: "hanging_herbs", render: Plant, solid: false, support: Above, sound: Grass, textures: All("hanging_herbs"),
            hardness: 0.0, color: (110, 140, 70), tags: ["herb", "hanging", "plant"],
        ),
    ],
)
