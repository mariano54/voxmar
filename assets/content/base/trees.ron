            ground: [Soil, Snow, Sand],
        ),
        (
            name: "cactus", tags: ["desert", "dry", "hot"],
            log: "cactus", height: (1, 4),
            crown: Bare,
            ground: [Sand],
            comfort: (temperature: (17.0, 45.0), moisture: (0.0, 0.35)),
        ),
    ],
)
