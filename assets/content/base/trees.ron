// Base game trees: a shared pool biomes draw from by tag or name. Each is a handful of
// shape parameters (trunk height, thickness and lean, roots, crown) and the blocks it is
// made of, plus where it grows: the ground it roots in (Soil, Snow, Sand, Shallows), its
// habitat (Anywhere, Open, Shade, Water, Shore, Shallows) and the climate it is comfortable
// in, outside which it fades over a small margin. Lean plus the crown's reach stays within
// 8 blocks of the trunk.
//
// Crowns: Round(reach, radius, squash, start), Conical(radius, start), Pine(radius, start),
// Spire(radius, start), Umbrella(reach, radius, squash, fork), Weeping(radius, drape),
// Palm(fronds, length), Cap(radius), Bush(radius), Dead(branches, reach, broken, fork),
// Bare. Round, Conical, Pine and Umbrella crowns are grown: limbs branch out from the trunk
// towards points scattered through the crown's shape (space colonisation), so no two
// trees of a kind branch alike. Ranges are (least, most). Heights and crowns are a mature
// tree's: each tree draws an age, so a stand mixes young trees (about half to four fifths
// the size), mature ones and now and then a giant half again as tall, more of them in
// old-growth cores.
//
// `stand` is where in the forest's structure a tree grows, 0 in gaps and scrubby edges ..= 1
// in old-growth cores: giants keep to the cores, shrubs to the edges. Trees grow taller
// where the stand is high.
//
// `fruit: (leaves: "apple_leaves", share: 0.06)` swaps that share of a crown's outer leaves,
// most of them on its underside and rim, for a fruiting kind of its leaves.
//
// Tags: broadleaf, conifer, tropical, palm (as on wood families), plus temperate, cold,
// dry, wetland, blossom, giant, shrub, snag.
(
    // How densely trees grow in forests: a factor on every biome's tree cover (1 is the
    // biomes' own). Thinner forests show more of the ground and the trees' own shapes.
    density: 0.87,
    // Where each wood comes from, so a region's timber is its own trees': a wood named
    // after a tree builds a tree of another family only in biomes where one of its own
    // family grows too (a test holds the base game to it). The common woods are generic
    // temperate woods that may build any tree. Every wood a tree is built of (its log and
    // root block) is one or the other; each family's trees are built of its wood. A later
    // package may class a wood the other way.
    woods: (
        common: ["oak_log", "birch_log", "spruce_log", "pine_log", "dark_oak_log"],
        families: {
            "acacia_log": ["acacia"],
            "baobab_log": ["baobab"],
            "cactus": ["cactus"],
            // Plums and almonds are cherries' kin (Prunus).
            "cherry_log": ["cherry", "wild_cherry", "plum_tree", "almond"],
            "cypress_log": ["cypress", "bald_cypress"],
            "dead_log": ["dead_tree"],
            "emberwood_log": ["emberwood"],
            "glowcap_stem": ["giant_glowcap"],
            "jungle_log": ["jungle", "giant_jungle"],
            "mangrove_log": ["mangrove"],
            "mangrove_roots": ["mangrove"],
            "maple_log": ["maple", "amber_maple", "green_maple"],
            "palm_log": ["palm", "date_palm"],
            "redwood_log": ["redwood"],
            "silverwood_log": ["silverwood"],
            "willow_log": ["willow"],
        },
    ),
    trees: [
        (
            name: "oak", tags: ["broadleaf", "temperate"],
            log: "oak_log", leaves: "oak_leaves", height: (5, 8), lean: 0.6,
            fruit: (leaves: "apple_leaves", share: 0.02),
            crown: Round(reach: (1.8, 3.0), radius: (1.8, 2.5), squash: 0.95, start: 0.45),
            comfort: (temperature: (7.0, 23.0)),
        ),
        (
            name: "big_oak", tags: ["broadleaf", "temperate", "giant"], rarity: Uncommon, stand: (0.5, 1.0),
            log: "oak_log", leaves: "oak_leaves", height: (9, 13), lean: 0.8,
            fruit: (leaves: "apple_leaves", share: 0.02),
            crown: Round(reach: (2.8, 4.2), radius: (2.0, 2.8), squash: 0.9, start: 0.4),
            comfort: (temperature: (10.0, 20.0), moisture: (1.0, 8.0)),
        ),
        (
            name: "birch", tags: ["broadleaf", "temperate", "cold"],
            log: "birch_log", leaves: "birch_leaves", height: (7, 12), lean: 0.4,
            crown: Round(reach: (0.8, 1.8), radius: (1.6, 2.2), squash: 0.95, start: 0.62),
            comfort: (temperature: (2.0, 14.0), moisture: (0.8, 8.0)),
        ),
        (
            name: "spruce", tags: ["conifer", "cold", "evergreen"],
            log: "spruce_log", leaves: "spruce_leaves", height: (8, 14), lean: 0.2,
            crown: Conical(radius: (2.4, 3.4), start: 0.12),
            ground: [Soil, Snow],
            comfort: (temperature: (-12.0, 7.0), moisture: (0.8, 8.0)),
        ),
        (
