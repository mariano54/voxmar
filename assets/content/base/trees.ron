            comfort: (temperature: (8.0, 24.0)),
        ),
        (
            name: "mangrove", tags: ["tropical", "wetland"], habitat: Shallows,
            log: "mangrove_log", leaves: "mangrove_leaves", root_block: "mangrove_roots", height: (5, 8), lean: 0.6, roots: Stilts,
            crown: Round(branches: (2, 3), reach: (1.5, 2.5), radius: (2.2, 2.8), squash: 0.7),
            ground: [Shallows, Soil, Sand],
            comfort: (temperature: (21.0, 40.0), moisture: (1.0, 3.0)),
        ),
        (
            name: "palm", tags: ["tropical", "palm", "shore"], habitat: Shore,
            log: "jungle_log", leaves: "jungle_leaves", height: (6, 10), lean: 3.0,
            crown: Palm(fronds: (6, 8), length: (3.5, 5.0)),
            ground: [Sand, Soil],
            comfort: (temperature: (20.0, 40.0), moisture: (0.4, 3.0)),
        ),
        (
            name: "shrub", tags: ["shrub", "temperate", "dry"],
            log: "oak_log", leaves: "azalea_leaves", alternate: ("flowering_azalea_leaves", 0.35), height: (1, 2),
            crown: Bush(radius: (1.4, 2.4)),
            comfort: (temperature: (6.0, 40.0), moisture: (0.2, 1.1)),
