// Base game trees: a shared pool biomes draw from by tag or name. Each is a handful of
// shape parameters (trunk height, thickness and lean, roots, crown) and the blocks it is
// made of, plus where it grows: the ground it roots in (Soil, Snow, Sand, Shallows), its
// habitat (Anywhere, Open, Shade, Water, Shore, Shallows) and the climate it is comfortable
// in, outside which it fades over a small margin. Lean plus the crown's reach stays within
// 8 blocks of the trunk.
//
// Crowns: Round(branches, reach, radius, squash), Conical(radius, start), Umbrella(branches,
// reach, radius), Weeping(radius, drape), Palm(fronds, length), Bush(radius), Dead(branches,
// reach), Bare. Ranges are (least, most).
//
// Tags: broadleaf, conifer, tropical, palm (as on wood families), plus temperate, cold,
// dry, wetland, blossom, giant, shrub, snag.
(
    trees: [
        (
            name: "oak", tags: ["broadleaf", "temperate"],
            log: "oak_log", leaves: "oak_leaves", height: (4, 7), lean: 0.6,
            crown: Round(branches: (2, 4), reach: (1.5, 2.5), radius: (2.0, 2.8), squash: 0.8),
            comfort: (temperature: (7.0, 23.0)),
        ),
        (
            name: "big_oak", tags: ["broadleaf", "temperate", "giant"], rarity: Uncommon,
            log: "oak_log", leaves: "oak_leaves", height: (8, 12), lean: 0.8,
            crown: Round(branches: (4, 6), reach: (2.5, 4.0), radius: (2.2, 3.0), squash: 0.75),
            comfort: (temperature: (10.0, 20.0), moisture: (1.0, 3.0)),
        ),
        (
            name: "birch", tags: ["broadleaf", "temperate", "cold"], stands: true,
            log: "birch_log", leaves: "birch_leaves", height: (5, 9), lean: 0.4,
            crown: Round(branches: (1, 3), reach: (0.5, 1.5), radius: (1.6, 2.2), squash: 1.3),
            comfort: (temperature: (2.0, 14.0), moisture: (0.8, 3.0)),
        ),
        (
            name: "spruce", tags: ["conifer", "cold", "evergreen"],
            log: "spruce_log", leaves: "spruce_leaves", height: (7, 12), lean: 0.2,
            crown: Conical(radius: (2.2, 3.2), start: 0.25),
            ground: [Soil, Snow],
            comfort: (temperature: (-12.0, 7.0), moisture: (0.8, 3.0)),
        ),
        (
            name: "giant_spruce", tags: ["conifer", "cold", "evergreen", "giant"], rarity: Uncommon,
            log: "spruce_log", leaves: "spruce_leaves", height: (16, 24), thick: true, lean: 0.3,
            crown: Conical(radius: (3.5, 5.0), start: 0.4),
            ground: [Soil, Snow],
            comfort: (temperature: (-2.0, 5.0), moisture: (1.3, 3.0)),
        ),
        (
            name: "pine", tags: ["conifer", "cold", "dry", "evergreen"],
            log: "spruce_log", leaves: "spruce_leaves", height: (9, 14), lean: 0.5,
            crown: Conical(radius: (2.2, 3.0), start: 0.5),
            ground: [Soil, Snow],
            comfort: (temperature: (-10.0, 9.0), moisture: (0.2, 1.0)),
        ),
        (
            name: "dark_oak", tags: ["broadleaf", "temperate", "dense"],
            log: "dark_oak_log", leaves: "dark_oak_leaves", height: (6, 9), thick: true, lean: 0.8,
            crown: Round(branches: (3, 5), reach: (2.0, 3.5), radius: (2.8, 3.6), squash: 0.6),
            comfort: (temperature: (12.0, 22.0), moisture: (1.2, 3.0)),
        ),
        (
            name: "cherry", tags: ["broadleaf", "blossom", "temperate"], rarity: Uncommon,
            log: "cherry_log", leaves: "cherry_leaves", height: (4, 7), lean: 0.8,
            crown: Umbrella(branches: (2, 4), reach: (2.5, 4.0), radius: (2.5, 3.2)),
            comfort: (temperature: (5.0, 15.0), moisture: (0.7, 3.0)),
        ),
        (
            name: "jungle", tags: ["tropical", "broadleaf"],
            log: "jungle_log", leaves: "jungle_leaves", height: (8, 13), lean: 0.5,
            crown: Round(branches: (2, 4), reach: (2.0, 3.0), radius: (2.2, 3.0), squash: 0.7),
            comfort: (temperature: (19.0, 40.0), moisture: (1.0, 3.0)),
        ),
        (
            name: "giant_jungle", tags: ["tropical", "broadleaf", "giant"], rarity: Uncommon,
            log: "jungle_log", leaves: "jungle_leaves", height: (18, 26), thick: true, lean: 0.6, roots: Buttress,
            crown: Round(branches: (3, 5), reach: (2.5, 4.0), radius: (2.8, 3.4), squash: 0.65),
            comfort: (temperature: (21.0, 40.0), moisture: (1.3, 3.0)),
        ),
        (
            name: "jungle_bush", tags: ["tropical", "shrub"],
            log: "jungle_log", leaves: "oak_leaves", height: (1, 2),
