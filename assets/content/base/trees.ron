            log: "spruce_log", leaves: "spruce_leaves", height: (18, 26), thick: true, lean: 0.3,
            crown: Conical(radius: (3.6, 5.0), start: 0.3),
            ground: [Soil, Snow],
            comfort: (temperature: (-2.0, 5.0), moisture: (1.3, 8.0)),
