    avoid: ["no_settlement", "ocean", "water", "river", "peaks", "ice", "frozen", "fantastical", "giant"],
    sizes: [
        // Homes are `houses`; working buildings (`workshops`, and the `works` it always
        // has) come on top. Every place has a field or a pen (a field where green, else a
        // pen, when it rolled neither). Wiki draft 60: hamlets always have a well and a
        // trader and 3 to 6 homes, villages 8 to 16 homes and a chapel.
        (
            name: "hamlet", weight: 3.0,
            houses: (3, 6), workshops: (0, 1), lanes: (2, 3), lane_length: (20, 40), square: (3, 5), centrepiece: 0.12, crop_level: 5,
            lane_half: 0.9, paving: (0.45, 2.0), well: (3, 3), lamps: 1.5,
            always: [Well, Trader],
            sometimes: [(Field, 0.6), (Pen, 0.45), (Woodyard, 0.35), (Orchard, 0.15), (Shrine, 0.1)],
        ),
        (
            name: "village", weight: 1.0, lean: {"wealth": 0.4, "trade": 0.3},
            houses: (8, 16), workshops: (1, 4), works: ["shrine"], lanes: (4, 6), lane_length: (36, 72), square: (6, 9), centrepiece: 0.75, crop_level: 12,
            lane_half: 1.4, paving: (0.0, 0.55), well: (3, 4), lamps: 1.0,
            always: [Well, Trader, Inn, Smithy],
            sometimes: [(Stall, 0.8), (Stall, 0.5), (Stall, 0.25), (Field, 0.9), (Field, 0.6), (Pen, 0.7), (Orchard, 0.35), (Woodyard, 0.4), (Shrine, 0.35)],
            // A palisade or a stone wall where it is martial and orderly.
            walls: (0.12, {"martial": 1.0, "order": 0.5}),
        ),
        // Towns (wiki: 20 to 60 buildings, walls, a temple, shops): rare, wealthy and
        // trading, a market of stalls round a wide square, a temple, most works, and a wall
        // round it all but the fields.
        (
            name: "town", weight: 0.3, lean: {"wealth": 0.8, "trade": 0.6, "order": 0.3, "crowding": 0.6},
            houses: (16, 30), workshops: (5, 8), works: ["shrine"], lanes: (6, 8), lane_length: (56, 92), square: (8, 9), centrepiece: 0.9, crop_level: 12,
            lane_half: 1.9, paving: (0.0, 0.35), well: (4, 4), lamps: 0.8,
            always: [Well, Trader, Inn, Smithy, Stall, Stall, Stall],
            sometimes: [(Stall, 0.8), (Stall, 0.5), (Field, 1.0), (Field, 0.8), (Pen, 0.8), (Orchard, 0.5), (Woodyard, 0.5), (Shrine, 0.4)],
            walls: (0.85, {"martial": 0.6, "order": 0.3}),
            smaller: "village",
        ),
    ],
    layouts: [
        // Lanes leave the square in every direction.
        (name: "spokes", shape: Spokes, weight: 3.0),
        // One long street through the square, short lanes off it.
        (name: "street", shape: Line, weight: 2.0, lean: {"order": 0.6, "hierarchy": 0.4}),
        // Houses face a wide green, lanes lead out from its rim.
        (name: "green", shape: Green, weight: 1.5, lean: {"order": 0.5, "green": 0.8, "festivity": 0.6}),
        // No square to speak of: houses wherever the paths wander.
        (name: "scatter", shape: Scatter, weight: 1.5, lean: {"order": -0.9, "age": 0.5, "hierarchy": -0.5}),
        // A street that forks in two.
        (name: "fork", shape: Fork, weight: 1.5),
        // Four ways meeting square on at the well.
        (name: "crossroads", shape: Crossroads, weight: 1.5, lean: {"order": 0.8, "trade": 0.6}),
        // A lane round the square, houses either side of it.
        (name: "ring", shape: Ring, weight: 1.0, lean: {"order": 0.3, "crowding": 0.4, "martial": 0.4, "hierarchy": 0.4}),
        // A street along the bank of the water near, boathouses on the water side.
        (name: "riverside", shape: Riverside, weight: 3.0, lean: {"trade": 0.3}, water: true),
        // Streets along the slope, one above another.
        (name: "terraces", shape: Terraces, weight: 1.0, lean: {"age": 0.3}),
    ],
    houses: [
