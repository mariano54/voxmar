// Settlements: hamlets and villages grown on good ground (see crates/worldgen/src/settlements).
//
// Every settlement is rolled from deep lists, and every roll leans on the settlement's
// character, so the lists stay coherent rather than shuffled: a rich, orderly village on a
// fertile river plain builds big stone-footed houses round a paved square with lamps
// along straight lanes; a poor, old hamlet on a cold hill is a few crooked huts on
// wandering paths with woodpiles and moss in the walls.
//
// LEVERS. Each settlement draws five levers, each 0 ..= 1, partly from its site and partly
// from the seed (the code says how; the wiki's settlements page records it):
//   wealth    fertile soil, fresh water and flat ground make it richer
//   age       how long it has stood: moss and cracks, crooked lanes, old kinds of house
//   order     planned or grown: straight lanes and aligned houses towards 1
//   crowding  how close the houses stand and how small their yards are
//   green     gardens, hedges, flowers and trees left standing
// Any entry below may `lean` on them: a lean of +1 on wealth doubles its weight in the
// richest places and drops it to nothing in the poorest; -0.5 halves it where it is
// richest. Leans multiply, so entries can lean on several levers at once.
//
// grid: one site is considered per square of `spacing` blocks; `chance` of the squares
//   hold one (mostly hamlets: see sizes), placed at least `margin` blocks inside the
//   square so a settlement never reaches into the next.
// avoid: biome tags no settlement is built in (rivers, lakes and their banks, crags and
//   terrain shapes are always avoided too).
// sizes: hamlets and villages: how many houses, lanes and how long, the square's radius,
//   and the places they always or sometimes have (Well, Trader, Inn, Smithy, Stall,
//   Shrine, Field, Pen, Orchard, Woodyard).
// layouts: how lanes are laid out (Spokes, Line, Green, Scatter, Fork, Crossroads, Ring,
//   Riverside, Terraces); `water: true` only where fresh water is near.
// houses: the kinds of house, by size, storeys and form (Box, Round, AFrame, Courtyard,
//   ShopFront). Working buildings name their `work` (for the people who will work
//   there) and what stands `inside` (Oven, Millstone, Vats, Racks, Stalls, Bins, Smoke,
//   Altar, Pews, Boat, Counter); a house may have extras it `always` has, its own
//   `roofs`, the `sizes` that build it, the `most` one place builds, `stilts`, and
//   `water: true` to stand only beside fresh water.
// roofs: how every roof shape leans, multiplying the weights styles give them (Gable,
//   Hip, HalfHip, Saltbox, Gambrel, Conical, Flat, Shed). Round houses take cones,
//   courtyard houses hips, A-frames steep gables, whatever was rolled, unless flat.
// extras: what a house may have besides walls and a roof, each by its own chance.
// props: what stands in yards and along lanes: one the code draws by its name, or one of
//   your own as `blocks` from its spot (y 1 the block on the ground); `water: true` ones
//   stand only on the bank of fresh water.
// centrepieces: the one great thing a place is known by, by `centrepiece` chance in
//   `sizes`: one the code draws by its name, made of its `parts` (log, leaves, stone,
//   worn, water, cloth, light, bell; `{wood}` the place's wood; any left out from the style),
//   or one of your own as `blocks` from its middle. `spot` Square stands it at the heart
//   of the square, the well beside it; Edge out by the end of a lane.
// styles: what a settlement is built of, by the biome it stands in; the first whose
//   biome tags match wins (an empty list matches anywhere). `woods` fill `{wood}` (the
//   main wood) and `{trim}` (a second wood, sometimes the same) in block names; every
//   material list is weighed per settlement, which keeps a few of its options, and each
//   house picks among those.
(
    grid: (spacing: 1024, chance: 0.33, margin: 160),
    // site: the temperatures, heights over sea level and the most rise and fall across its
    //   middle a settlement stands on; how far it keeps from sinkholes and ravines; no trees
    //   within glade.0 blocks of a house, fewer out to glade.1, glade_trees.0 of them left
    //   past the treeless ring and glade_trees.1 more where it is green.
    site: (temperature: (-8.0, 34.0), height: (3, 90), relief: 14, caves: 150, glade: (5, 16), glade_trees: (0.08, 0.3)),
    // furnishings: blocks every settlement uses whatever its style. A package may name
    //   others; content without one leaves it out (no water or dirt: no settlements).
    furnishings: (
        torch: "torch", campfire: "campfire", table: "crafting_table", farmland: "farmland",
        water: "water", dirt: "dirt", planter: "herb_planter", anvil: "polished_basalt",
        barrel: "barrel", bell: "bell", altar: "polished_calcite",
        flowers: [Tag("flower", 1)],
        bushes: [Tag("bush", 1)],
        canopies: [Name("red_terracotta", 1), Name("orange_terracotta", 1), Name("yellow_terracotta", 1), Name("white_terracotta", 1), Name("light_blue_terracotta", 1), Name("cyan_terracotta", 1), Name("lime_terracotta", 1), Name("magenta_terracotta", 1), Name("pink_terracotta", 1), Name("green_terracotta", 1), Name("blue_terracotta", 1)],
        compost: [Name("coarse_dirt", 1), Name("rooted_dirt", 1), Name("podzol", 1)],
        boulders: [Name("cobblestone", 1), Name("mossy_cobblestone", 1), Name("cobbled_andesite", 1)],
        fruit: [Name("apple_leaves", 1), Name("pear_leaves", 1), Name("plum_leaves", 1), Name("cherries_leaves", 1), Name("orange_leaves", 1), Name("lemon_leaves", 1)],
        hay: [Name("hay_bale", 1)],
        hanging: [Name("hanging_herbs", 1)],
        nets: [Name("fishing_net", 1)],
        sacks: [Name("sack", 1)],
        cloth: [Name("white_terracotta", 4), Name("light_blue_terracotta", 1), Name("red_terracotta", 1), Name("yellow_terracotta", 1), Name("pink_terracotta", 1), Name("light_gray_terracotta", 1)],
    ),
    avoid: ["no_settlement", "ocean", "water", "river", "peaks", "ice", "frozen", "fantastical", "giant"],
    sizes: [
        (
            name: "hamlet", weight: 3.0,
            houses: (2, 5), lanes: (1, 3), lane_length: (16, 34), square: (3, 5), centrepiece: 0.12,
            always: [Well],
            sometimes: [(Trader, 0.7), (Field, 0.6), (Pen, 0.45), (Woodyard, 0.35), (Orchard, 0.15), (Shrine, 0.1)],
        ),
        (
            name: "village", weight: 1.0, lean: {"wealth": 0.4},
            houses: (7, 14), lanes: (3, 5), lane_length: (30, 60), square: (6, 9), centrepiece: 0.75,
            always: [Well, Trader, Inn, Smithy],
            sometimes: [(Stall, 0.8), (Stall, 0.5), (Stall, 0.25), (Field, 0.9), (Field, 0.6), (Pen, 0.7), (Orchard, 0.35), (Woodyard, 0.4), (Shrine, 0.35)],
        ),
    ],
    layouts: [
        // Lanes leave the square in every direction.
        (name: "spokes", shape: Spokes, weight: 3.0),
        // One long street through the square, short lanes off it.
        (name: "street", shape: Line, weight: 2.0, lean: {"order": 0.6}),
        // Houses face a wide green, lanes lead out from its rim.
        (name: "green", shape: Green, weight: 1.5, lean: {"order": 0.5, "green": 0.8}),
        // No square to speak of: houses wherever the paths wander.
        (name: "scatter", shape: Scatter, weight: 1.5, lean: {"order": -0.9, "age": 0.5}),
        // A street that forks in two.
        (name: "fork", shape: Fork, weight: 1.5),
        // Four ways meeting square on at the well.
        (name: "crossroads", shape: Crossroads, weight: 1.5, lean: {"order": 0.8}),
        // A lane round the square, houses either side of it.
        (name: "ring", shape: Ring, weight: 1.0, lean: {"order": 0.3, "crowding": 0.4}),
        // A street along the bank of the water near, boathouses on the water side.
        (name: "riverside", shape: Riverside, weight: 3.0, water: true),
        // Streets along the slope, one above another.
        (name: "terraces", shape: Terraces, weight: 1.0, lean: {"age": 0.3}),
    ],
    houses: [
        (name: "cottage", weight: 4.0, width: (5, 7), depth: (6, 8), walls: (3, 3), storeys: (1, 1)),
        (name: "long_house", weight: 1.5, lean: {"age": 0.8, "wealth": -0.3}, width: (5, 6), depth: (10, 14), walls: (3, 3), storeys: (1, 1)),
        (name: "town_house", weight: 1.5, lean: {"wealth": 0.6, "crowding": 0.8, "order": 0.3}, width: (5, 7), depth: (6, 8), walls: (3, 4), storeys: (2, 2)),
        (name: "farm_house", weight: 1.5, lean: {"green": 0.6, "crowding": -0.8, "wealth": 0.3}, width: (7, 9), depth: (9, 11), walls: (3, 4), storeys: (1, 2), porch: 0.6),
        (name: "hut", weight: 2.0, lean: {"wealth": -0.9, "age": 0.4}, width: (4, 5), depth: (4, 6), walls: (2, 3), storeys: (1, 1)),
        (name: "tower_house", weight: 0.4, lean: {"order": -0.5, "age": 0.6}, width: (5, 6), depth: (5, 6), walls: (3, 4), storeys: (3, 3)),
        (name: "hall", weight: 0.6, lean: {"wealth": 1.0}, width: (8, 10), depth: (11, 14), walls: (4, 5), storeys: (1, 1), porch: 0.4),
        (name: "wing_house", weight: 1.0, lean: {"wealth": 0.6}, width: (6, 8), depth: (7, 9), walls: (3, 3), storeys: (1, 2), wing: 1.0),
        // New outlines.
        (name: "roundhouse", form: Round, weight: 1.0, lean: {"age": 0.6, "wealth": -0.4, "order": -0.5}, width: (7, 9), depth: (7, 9), walls: (3, 3), storeys: (1, 1)),
        (name: "a_frame", form: AFrame, weight: 0.8, lean: {"green": 0.6, "wealth": -0.2}, width: (5, 7), depth: (6, 9), walls: (3, 3), storeys: (1, 1)),
        (name: "courtyard_house", form: Courtyard, sizes: ["village"], weight: 0.35, lean: {"wealth": 1.0, "crowding": -0.5}, width: (11, 12), depth: (11, 13), walls: (3, 3), storeys: (1, 1)),
        (name: "shop_house", form: ShopFront, sizes: ["village"], weight: 0.8, lean: {"wealth": 0.5, "crowding": 0.8}, width: (5, 7), depth: (6, 8), walls: (3, 4), storeys: (2, 2)),
        // Working buildings, one of each to a place (barns two); `work` names the trade.
        (name: "bakery", work: "bakery", sizes: ["village"], inside: [Oven, Counter], always: [Chimney], most: 1, weight: 0.8, lean: {"wealth": 0.3, "crowding": 0.4}, width: (5, 7), depth: (6, 8), walls: (3, 3), storeys: (1, 2)),
        (name: "mill", work: "mill", sizes: ["village"], inside: [Millstone, Bins], always: [Weathervane], most: 1, weight: 0.6, lean: {"green": 0.5}, width: (6, 8), depth: (6, 8), walls: (4, 5), storeys: (1, 1)),
        (name: "tannery", work: "tannery", sizes: ["village"], inside: [Vats, Racks], most: 1, weight: 0.6, lean: {"wealth": -0.4, "age": 0.3}, width: (6, 8), depth: (7, 9), walls: (3, 3), storeys: (1, 1), roofs: [(Gable, 2), (Shed, 1)]),
        (name: "barn", work: "barn", inside: [Stalls], most: 2, weight: 0.8, lean: {"green": 0.8, "crowding": -0.8}, width: (8, 10), depth: (10, 14), walls: (4, 5), storeys: (1, 1), roofs: [(Gambrel, 4), (Gable, 2)]),
        (name: "granary", work: "granary", inside: [Bins], stilts: 1, most: 1, weight: 0.6, lean: {"wealth": 0.3, "green": 0.5}, width: (5, 6), depth: (5, 7), walls: (3, 3), storeys: (1, 1), roofs: [(Hip, 2), (Gable, 2)]),
        (name: "smokehouse", work: "smokehouse", inside: [Smoke, Racks], most: 1, weight: 0.5, lean: {"age": 0.4}, width: (5, 6), depth: (5, 6), walls: (3, 3), storeys: (1, 1), roofs: [(Gable, 2), (Shed, 1)]),
        // The altar here will restore prayer.
        (name: "chapel", work: "shrine", inside: [Altar, Pews], always: [Weathervane], sizes: ["village"], most: 1, weight: 0.7, lean: {"order": 0.5, "wealth": 0.4}, width: (7, 7), depth: (9, 12), walls: (4, 5), storeys: (1, 1), roofs: [(Gable, 4), (HalfHip, 1)]),
        (name: "boathouse", work: "boathouse", inside: [Boat], water: true, most: 1, weight: 1.5, width: (6, 7), depth: (8, 10), walls: (3, 3), storeys: (1, 1), roofs: [(Gable, 3), (Shed, 1)]),
    ],
    roofs: [
        (shape: Gable, weight: 1.0),
        (shape: Hip, weight: 1.0, lean: {"wealth": 0.4}),
        (shape: HalfHip, weight: 1.0, lean: {"age": 0.4, "wealth": 0.2}),
        (shape: Saltbox, weight: 1.0, lean: {"order": -0.4, "age": 0.3}),
        (shape: Gambrel, weight: 1.0, lean: {"green": 0.5, "crowding": -0.5}),
        (shape: Conical, weight: 1.0, lean: {"age": 0.8, "order": -0.5}),
        (shape: Flat, weight: 1.0),
        (shape: Shed, weight: 1.0, lean: {"wealth": -0.6}),
    ],
    // Extras any house may have, each by its own chance, leaning like the lists.
    extras: [
        (name: Chimney, chance: 0.45, lean: {"wealth": 0.4}),
        (name: Porch, chance: 0.2, lean: {"green": 0.4}),
        (name: Shed, chance: 0.3, lean: {"crowding": -0.6, "wealth": -0.2}),
        (name: FlowerBoxes, chance: 0.3, lean: {"green": 0.8, "wealth": 0.3}),
        (name: Garden, chance: 0.35, lean: {"green": 0.9, "crowding": -0.7}),
        (name: Hedge, chance: 0.2, lean: {"green": 0.7, "order": 0.5}),
        (name: Lamp, chance: 0.6, lean: {"wealth": 0.6}),
        (name: Woodpile, chance: 0.35, lean: {"wealth": -0.3, "age": 0.3}),
        (name: Moss, chance: 0.3, lean: {"age": 1.0}),
        (name: Wing, chance: 0.1, lean: {"wealth": 0.5}),
        (name: Dormer, chance: 0.25, lean: {"wealth": 0.5, "order": 0.3}),
        (name: Balcony, chance: 0.2, lean: {"wealth": 0.6, "crowding": 0.5}),
        (name: OutsideStair, chance: 0.15, lean: {"crowding": -0.3, "age": 0.3}),
        (name: Shutters, chance: 0.3, lean: {"order": 0.6, "wealth": 0.3}),
        (name: Awning, chance: 0.12, lean: {"wealth": 0.5, "crowding": 0.6}),
        (name: SignBoard, chance: 0.1, lean: {"wealth": 0.4}),
        (name: RainBarrel, chance: 0.25, lean: {"green": 0.3}),
        (name: Weathervane, chance: 0.12, lean: {"wealth": 0.5, "age": 0.3}),
        (name: Dovecote, chance: 0.08, lean: {"green": 0.5, "wealth": 0.3}),
        (name: HangingHerbs, chance: 0.18, lean: {"green": 0.7, "wealth": -0.2}),
    ],
    props: [
        (name: "Woodpile", weight: 2.0, lean: {"wealth": -0.2}),
        (name: "Crates", weight: 1.5, lean: {"wealth": 0.5}),
        (name: "StonePile", weight: 1.0, lean: {"age": 0.6}),
        (name: "FlowerBed", weight: 1.5, lean: {"green": 1.0}),
        (name: "HerbPlanter", weight: 1.0, lean: {"green": 0.4, "wealth": 0.3}),
        (name: "Campfire", weight: 0.8, lean: {"wealth": -0.6, "order": -0.4}),
        (name: "Lamp", weight: 2.0, lean: {"wealth": 0.8, "order": 0.5}),
        (name: "Bush", weight: 1.2, lean: {"green": 0.8, "order": -0.3}),
        (name: "Compost", weight: 0.8, lean: {"green": 0.4}),
        (name: "Boulder", weight: 0.6, lean: {"order": -0.8}),
        (name: "Cart", weight: 0.8, lean: {"wealth": 0.2, "order": -0.2}),
        (name: "Barrel", weight: 1.5, lean: {"wealth": 0.3}),
        (name: "HayBale", weight: 1.0, lean: {"green": 0.6, "crowding": -0.5}),
        (name: "LaundryLine", weight: 0.7, lean: {"crowding": 0.5}),
        (name: "FenceRun", weight: 1.0, lean: {"order": 0.5, "green": 0.4}),
        (name: "Scarecrow", weight: 0.4, lean: {"green": 0.8, "crowding": -0.8}),
        (name: "Skep", weight: 0.5, lean: {"green": 1.0}),
        (name: "Anvil", weight: 0.25, lean: {"wealth": -0.2}),
        (name: "Grindstone", weight: 0.4),
        (name: "Washtub", weight: 0.5, lean: {"crowding": 0.3}),
        (name: "Sacks", weight: 0.8, lean: {"wealth": 0.3}),
        (name: "ChickenCoop", weight: 0.6, lean: {"green": 0.6, "crowding": -0.6}),
        (name: "Signpost", weight: 0.4, lean: {"order": 0.6}),
        // On the bank of the water near.
        (name: "Boat", weight: 1.0, water: true),
        (name: "Nets", weight: 1.0, water: true, lean: {"wealth": -0.3}),
        // Props of their own: blocks from the spot, y 1 on the ground.
        (name: "log_bench", weight: 0.8, lean: {"order": 0.4}, blocks: [((0, 1, 0), "stripped_oak_log"), ((1, 1, 0), "stripped_oak_log")]),
        (name: "stone_cairn", weight: 0.4, lean: {"age": 1.0, "order": -0.4}, blocks: [((0, 1, 0), "cobblestone"), ((0, 2, 0), "mossy_cobblestone"), ((0, 3, 0), "cobblestone")]),
        (name: "drying_rack", weight: 0.5, lean: {"wealth": -0.4, "green": 0.3}, blocks: [((0, 1, 0), "spruce_log"), ((0, 2, 0), "spruce_log"), ((2, 1, 0), "spruce_log"), ((2, 2, 0), "spruce_log"), ((1, 2, 0), "spruce_planks")]),
        (name: "trough", weight: 0.5, lean: {"green": 0.4}, blocks: [((0, 1, 0), "oak_planks"), ((1, 1, 0), "water"), ((2, 1, 0), "oak_planks")]),
        (name: "stacked_stone", weight: 0.5, lean: {"wealth": 0.3, "order": 0.5}, blocks: [((0, 1, 0), "stone_bricks"), ((1, 1, 0), "stone_bricks"), ((0, 2, 0), "stone_bricks")]),
    ],
    centrepieces: [
        (name: "GreatTree", weight: 2.0, lean: {"green": 1.0, "age": 0.5}, parts: {"leaves": "{wood}_leaves"}),
        (name: "StoneCircle", spot: Edge, weight: 1.0, lean: {"age": 1.0, "order": -0.3}, parts: {"stone": "stone", "worn": "mossy_cobblestone"}),
        (name: "WatchtowerRuin", spot: Edge, weight: 0.8, lean: {"age": 1.0, "wealth": -0.3}),
        (name: "Windmill", spot: Edge, weight: 1.2, lean: {"wealth": 0.5, "green": 0.4}),
        (name: "BellFrame", weight: 1.0, lean: {"order": 0.6, "wealth": 0.3}),
        (name: "FallenStatue", weight: 0.6, lean: {"age": 1.0, "wealth": 0.3}, parts: {"stone": "polished_calcite", "worn": "calcite"}),
        (name: "Maypole", weight: 1.0, lean: {"green": 0.6, "age": -0.3}, parts: {"leaves": "{wood}_leaves"}),
        (name: "MarketCross", weight: 1.0, lean: {"wealth": 0.8, "order": 0.5}),
        (name: "Fountain", weight: 0.8, lean: {"wealth": 1.0, "order": 0.6}),
        (name: "Beacon", spot: Edge, weight: 0.6, lean: {"age": 0.4, "order": -0.2}),
        (name: "StandingStone", weight: 0.8, lean: {"age": 0.8}),
        (name: "DuckPond", weight: 1.0, lean: {"green": 0.8, "crowding": -0.5}),
    ],
    // Names: a first part and a last part, each with its Japanese reading, by the biome's
    // tags (the first list whose tags match; an empty list matches anywhere). Hamlets
    // sometimes take a small word ("End", "Cross") instead of a last part, and now and
    // then a name takes a word before it, leaning on the levers ("Old" where it is old).
    names: [
        (
            biome: ["desert", "dunes", "mesa", "savanna", "scrubland"],
            first: [("Sab", "サブ"), ("Kar", "カル"), ("Ama", "アマ"), ("Zir", "ジル"), ("Tal", "タル"), ("Oas", "オア"), ("Ham", "ハム"), ("Dal", "ダル"), ("Mer", "メル"), ("Sur", "スル"), ("Ras", "ラス"), ("Nub", "ヌブ"), ("Kes", "ケス"), ("Yar", "ヤル"), ("Qad", "カド"), ("Bah", "バハ"), ("Jem", "ジェム"), ("Saf", "サフ"), ("Tam", "タム"), ("Azz", "アッズ"), ("Mal", "マル"), ("Har", "ハル"), ("Zab", "ザブ"), ("Imr", "イムル"), ("Wad", "ワド"), ("Sel", "セル"), ("Kufr", "クフル"), ("Num", "ヌム"), ("Ebb", "エッブ"), ("Ush", "ウシュ"), ("Nar", "ナル"), ("Tir", "ティル"), ("Baz", "バズ"), ("Fas", "ファス")],
            last: [("ah", "ア"), ("ir", "イル"), ("um", "ウム"), ("esh", "エシュ"), ("ara", "アラ"), ("oun", "ウン"), ("ad", "アド"), ("is", "イス"), ("an", "アン"), ("eth", "エス"), ("abad", "アバド"), ("iya", "イヤ"), ("oum", "ウーム"), ("assa", "アッサ"), ("ek", "エク"), ("ul", "ウル"), ("ina", "イナ"), ("ar", "アル"), ("aya", "アヤ"), ("ez", "エズ")],
            small: [("Well", "ウェル"), ("Rest", "レスト"), ("Palms", "パームズ"), ("Spring", "スプリング"), ("Gate", "ゲート"), ("Shade", "シェード")],
            prefixes: [
                (en: "Old", ja: "オールド", weight: 1.0, lean: {"age": 1.0}),
                (en: "New", ja: "ニュー", weight: 0.5, lean: {"age": -1.0}),
                (en: "Upper", ja: "アッパー", weight: 0.5),
                (en: "Lower", ja: "ロウアー", weight: 0.5),
                (en: "Red", ja: "レッド", weight: 0.4),
                (en: "Dry", ja: "ドライ", weight: 0.4, lean: {"green": -1.0}),
            ],
        ),
        (
            biome: ["jungle", "tropical"],
            first: [("Ma", "マ"), ("Ta", "タ"), ("Ka", "カ"), ("Lu", "ル"), ("Nai", "ナイ"), ("Ro", "ロ"), ("Hi", "ヒ"), ("Pa", "パ"), ("Wai", "ワイ"), ("Ko", "コ"), ("Mo", "モ"), ("Te", "テ"), ("Ala", "アラ"), ("Uku", "ウク"), ("Ewa", "エワ"), ("Oli", "オリ"), ("Ri", "リ"), ("Sa", "サ"), ("Nu", "ヌ"), ("Ho", "ホ")],
            last: [("lani", "ラニ"), ("koa", "コア"), ("mau", "マウ"), ("nui", "ヌイ"), ("rua", "ルア"), ("tai", "タイ"), ("vale", "ヴァレ"), ("moa", "モア"), ("kai", "カイ"), ("pono", "ポノ"), ("ana", "アナ"), ("hiva", "ヒヴァ"), ("roa", "ロア"), ("lua", "ルア")],
            small: [("Landing", "ランディング"), ("Grove", "グローヴ"), ("Falls", "フォールズ")],
            prefixes: [
                (en: "Old", ja: "オールド", weight: 1.0, lean: {"age": 1.0}),
                (en: "Deep", ja: "ディープ", weight: 0.6, lean: {"green": 1.0}),
            ],
        ),
        (
