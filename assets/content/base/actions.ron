// Base game actions: farming. Sowing a seed takes the farming level its crop needs and
// gives experience; picking a ripe crop that fruits again (tomatoes, berries) keeps the
// plant. Harvesting a ripe crop by breaking it is `core:mine` (see crops.ron).
(
    actions: [
        (name: "plant", duration: Instant, requires: [Alive, InReach, HoldingSeed, Plantable, SkillLevel], effects: [Plant]),
        (name: "pick", duration: Instant, requires: [Alive, InReach, Ripe, CropLevel], effects: [Pick]),
        // Tending a creature with what is in hand (right click on it): food that tames it or
        // readies a kept one to breed, or a tool that takes its product (creatures.ron).
        (name: "tend", duration: Instant, requires: [Alive, CreatureInReach, CreatureAccepts], effects: [Tend]),
        // Looking closely at a creature (right click with nothing it wants in hand): more
        // with Farming level (server inspect.rs).
        (name: "inspect", duration: Instant, requires: [Alive, CreatureInReach], effects: [Inspect]),
        // Letting one of your own animals go wild again (Shift and right click on it, twice):
        // it leaves your keeping and gives nothing (design draft 99, server husbandry.rs).
        (name: "release", duration: Instant, requires: [Alive, CreatureInReach, CreatureIsMine], effects: [Release]),
        // Cooking what is in hand on a station that cooks it (cooking.ron).
        (name: "cook", duration: Instant, requires: [Alive, InReach, Cookable, CookingLevel], effects: [Cook]),
        // Tilling soil into farmland with a hoe (right click), where crops are sown.
        (name: "till", duration: Instant, requires: [Alive, InReach, Tillable], effects: [Till]),
        // Casting a rod into water (right click with it): a few seconds, then a fish or
        // nothing (fishing.ron).
        (name: "fish", duration: Seconds(5.0), requires: [Alive, Fishable], effects: [Fish]),
        // Emptying a pouch in hand into the inventory (right click with it).
        (name: "empty_pouch", duration: Instant, requires: [Alive], effects: [EmptyPouch]),
        // Working at a crafting table (right click): its three-by-three grid.
        (name: "use_table", duration: Instant, requires: [Alive, InReach, CraftingTable], effects: [UseTable]),
        // Light a multiblock by its core (multiblocks.ron): a hearthstone with the Homestead
        // Hearth built around it is home; a crucible in its kiln smelts.
        // Sleep in a sleeping bag: wake there after dying, until a hearth makes a home.
        (name: "sleep", duration: Instant, requires: [Alive, InReach, Bed], effects: [Sleep]),
        (name: "light", duration: Instant, requires: [Alive, InReach, MultiblockCore], effects: [Light]),
    ],
)
