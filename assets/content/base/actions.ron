// Base game actions: farming. Sowing a seed takes the farming level its crop needs and
// gives experience; picking a ripe crop that fruits again (tomatoes, berries) keeps the
// plant. Harvesting a ripe crop by breaking it is `core:mine` (see crops.ron).
(
    actions: [
        (name: "plant", duration: Instant, requires: [Alive, InReach, HoldingSeed, Plantable, SkillLevel], effects: [Plant]),
        (name: "pick", duration: Instant, requires: [Alive, InReach, Ripe, CropLevel], effects: [Pick]),
        // Tending a creature with what is in hand (right click on it): food that tames it or
        // readies a kept one to breed, or a tool that takes its product (creatures.ron).
        (name: "tend", duration: Instant, requires: [Alive, CreatureInTouch, CreatureAccepts], effects: [Tend]),
        // Looking closely at a creature (right click with nothing it wants in hand): more
        // with Farming level (server inspect.rs).
        (name: "inspect", duration: Instant, requires: [Alive, CreatureInTouch], effects: [Inspect]),
        // Letting one of your own animals go wild again (Shift and right click on it, twice):
        // it leaves your keeping and gives nothing (design draft 99, server husbandry.rs).
        (name: "release", duration: Instant, requires: [Alive, CreatureInTouch, CreatureIsMine], effects: [Release]),
        // Cooking what is in hand on a station that cooks it (cooking.ron): two seconds, so
        // a fish's Cooking experience (what catching it taught) comes at a cook's pace
        // (design draft 104).
        (name: "cook", duration: Seconds(2.0), requires: [Alive, InReach, Cookable, CookingLevel, CookingTool], effects: [Cook]),
        // Tilling soil into farmland with a hoe (right click), where crops are sown.
        (name: "till", duration: Instant, requires: [Alive, InReach, Tillable], effects: [Till, WearHeld]),
        // Coating a block in place with what is in hand (right click): clay on a wattle
        // panel daubs it (blocks' `coat`), at the level of the recipe that makes the daub.
        (name: "coat", duration: Instant, requires: [Alive, InReach, Coats, CoatClear], effects: [Coat]),
        // Casting a rod into water (right click with it): a few seconds, then a fish or
        // nothing (fishing.ron).
        (name: "fish", duration: Seconds(5.0), requires: [Alive, Fishable], effects: [Fish]),
        // Emptying a pouch in hand into the inventory (right click with it).
        (name: "empty_pouch", duration: Instant, requires: [Alive], effects: [EmptyPouch]),
        // Working at a crafting table (right click): its three-by-three grid.
        (name: "use_table", duration: Instant, requires: [Alive, InReach, CraftingTable], effects: [UseTable]),
        // Light a multiblock by its core (multiblocks.ron): a hearthstone with the Homestead
        // Hearth built around it is home; a crucible in its kiln smelts.
        // Sleep in a sleeping bag: wake there after dying, until a hearth makes a home.
        // A door opened or shut (right click): it and its other half turn into what they
        // swap for, unless someone stands where it would shut.
        (name: "open", duration: Instant, requires: [Alive, InReach, Swaps], effects: [Swap]),
        (name: "sleep", duration: Instant, requires: [Alive, InReach, Bed], effects: [Sleep]),
        // Sit on a seat (a stool, chair, bench or cushion), with nothing to place in hand:
        // sat until you move off it (effects ask `Seated`).
        (name: "sit", duration: Instant, requires: [Alive, InReach, Seat], effects: [Sit]),
        (name: "light", duration: Instant, requires: [Alive, InReach, MultiblockCore], effects: [Light]),
        // Light a torch's stub again (flame.rs) with something that kindles in hand (a
        // firebrand, a lit torch): for nothing, as it was.
        (name: "relight", duration: Instant, requires: [Alive, InReach, Relights], effects: [Relight]),
        // Use a machine (machines.ron): what is in hand goes in, if it burns it or works it;
        // with nothing it takes, what the machine made comes out.
        (name: "use_machine", duration: Instant, requires: [Alive, InReach, Machine], effects: [UseMachine]),
        // Open a store (machines.ron: a chest, a cupboard, a jar) beside the inventory, to
        // move items in and out of its slots; anything but a machine in hand (a chute is
        // laid against it).
        (name: "open_store", duration: Instant, requires: [Alive, InReach, Store], effects: [OpenStore]),
        // Pick the lock of a treasure chest (treasure.ron) with the lockpick in hand; with
        // anything else, be told it is locked.
        (name: "pick_lock", duration: Instant, requires: [Alive, InReach, Locked], effects: [PickLock]),
        // Take from bees (bees.ron): a skep held up to a wild nest takes its swarm, a right
        // click on a full skep its honey; under smoke calmly, without it stung.
        (name: "tend_bees", duration: Instant, requires: [Alive, InReach, Bees], effects: [TendBees]),
        // Pray at an altar: an offering in hand for Magic experience, else prayer points back.
        (name: "pray", duration: Instant, requires: [Alive, InReach, Altar], effects: [Pray]),
        // Use a home station (stations.ron): load it with what is in hand, take what it
        // made, or be told how it goes.
        (name: "use_station", duration: Instant, requires: [Alive, InReach, Station], effects: [UseStation]),
        // Take what a sprung trap caught (traps.ron), and set it again.
        (name: "take_from_trap", duration: Instant, requires: [Alive, InReach, SprungTrap], effects: [TakeFromTrap]),
        // Spread a fertiliser in hand on a growing crop: the crops about it grow a stage.
        (name: "fertilise", duration: Instant, requires: [Alive, InReach, Fertilisable], effects: [Fertilise]),
    ],
)
