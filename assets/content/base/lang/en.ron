    "effect.base.camp": "Camp",
    "effect.base.camp.description": "Your own bed and light: you heal a fifth faster here.",
    "effect.base.camp.next": "Next: build a Homestead Hearth near your bed and light it.",
    "effect.base.hearthside": "Hearthside",
    "effect.base.hearthside.description": "Your hearth keeps the cold off: you heal a third faster here.",
    "effect.base.hearthside.next": "Next: roof it over, with your bed and two lights, to be snug.",
    "effect.base.snug": "Snug",
    "effect.base.snug.description": "Warm under a roof: you heal half as fast again here.",
    "effect.base.snug.next": "Next: two seats, a table, two places to store things and a third light make it homely.",
    "effect.base.homely": "Homely",
    "effect.base.homely.description": "Room to sit, work and store: you learn a twentieth more here.",
    "effect.base.homely.next": "Next: two rugs, two curtains, a cushion, three pieces of crockery and a fourth light make it cosy.",
    "effect.base.cosy": "Cosy",
    "effect.base.cosy.description": "Soft and bright: you heal faster and learn a tenth more here.",
    "effect.base.cosy.next": "Next: a bookshelf, a stove or cauldron, a loom, spindle or quern, and a banner make it the heart of the home.",
    "effect.base.heart_of_the_home": "Heart of the Home",
    "effect.base.heart_of_the_home.description": "Everything a home needs: heal twice as fast, learn an eighth more.",
    "effect.base.workbench": "Workbench",
    "effect.base.workbench.description": "A bench to work at: you craft and build as if a level higher here.",
    "effect.base.workbench.next": "Next: a loom, spindle stand or quern, a light, and two places to store things under a roof make it a workshop.",
    "effect.base.workshop": "Workshop",
    "effect.base.workshop.description": "Everything to hand: you craft and build as if two levels higher here.",
    "effect.base.pantry": "Pantry",
    "effect.base.pantry.description": "A full pantry by the fire: the good a meal does lasts a quarter longer.",
    "effect.base.pantry.next": "Next: four places to store things, a stove or cauldron and a table under a roof make it a larder.",
    "effect.base.larder": "Larder",
    "effect.base.larder.description": "Meals heal a fifth more here and their good lasts half again as long.",
    "effect.base.sheltered": "Sheltered",
    "effect.base.sheltered.description": "Warm and dry while it storms: you heal a fifth faster, learn a bit more.",
    "effect.base.company": "Company",
    "effect.base.company.description": "Your animals about the house: you heal a tenth faster here.",
    "effect.base.company.next": "Next: four animals kept about the house make it a full house.",
    "effect.base.full_house": "Full house",
    "effect.base.full_house.description": "A yard full of animals: you heal a fifth faster, learn a bit more here.",
    "effect.base.kitchen_garden": "Kitchen garden",
    "effect.base.kitchen_garden.description": "Greens growing by the door: meals heal a tenth more here.",
    "effect.base.banked_fire": "Banked fire",
    "effect.base.banked_fire.description": "A camp taught you to bank a fire: at home with a fire lit, 3° warmer.",
    "effect.base.snowed_in": "Snowed in",
    "effect.base.snowed_in.description": "Snug for winter: snow or hail outside, you heal and learn more at home.",
    "effect.base.everything_in_its_place": "Everything in its place",
    "effect.base.everything_in_its_place.description": "A homely home: with room to store things, you build a level higher at home.",
    "effect.base.home_cooking": "Home cooking",
    "effect.base.home_cooking.description": "Stove and quern learnt: meals at home heal a tenth more and last longer.",
    "effect.base.studious": "Studious",
    "effect.base.studious.description": "Books on the shelf: indoors at home you learn a twentieth more.",
    "effect.base.hearthkeeper": "Hearthkeeper",
    "effect.base.hearthkeeper.description": "Your own hearth is the best bench: craft and cook as if a level higher at home.",
    "effect.base.rested": "Rested",
    "effect.base.rested.description": "You slept: you heal and learn a little more for a while.",
    "effect.base.well_rested": "Well rested",
    "effect.base.well_rested.description": "Slept in a snug home: you learn more and mine faster for a while.",
    "effect.base.deep_rest": "Deep rest",
    "effect.base.deep_rest.description": "Slept in a cosy home: you heal, learn, mine and walk faster for a while.",
    "effect.base.steady_hands": "Steady hands",
    "effect.base.steady_hands.description": "A stone tool in your fist: every tool bites a tenth faster.",
    "effect.base.steady_hands.next": "Next: carry a full stone kit (pickaxe, axe, shovel, hoe and knife).",
    "effect.base.practised_hands": "Practised hands",
    "effect.base.practised_hands.description": "A whole kit and the habit of it: a fifth faster, and now and then an extra piece turns up.",
    "effect.base.practised_hands.next": "Next: forge a copper kit (axe, shovel, hoe and knife) from red metal.",
    "effect.base.copper_hands": "Copper hands",
