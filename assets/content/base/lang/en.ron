    "quest.age.nomad": "Nomad",
    "quest.age.farm": "Farm",
    "quest.base.a_bed_of_your_own": "A Bed of Your Own",
    "quest.base.a_bed_of_your_own.why": "Until you sleep somewhere, death sends you back to world spawn. Wool and hide, pelts, or feathers make a sleeping bag.",
    "quest.base.the_potter": "The Potter",
    "quest.base.the_potter.why": "Pots and vials hold potions and stews, and fired clay lines the kiln you are working toward.",
    "quest.base.charcoal": "Charcoal",
    "quest.base.charcoal.why": "Fuel before metal: coal or charcoal smelts copper and makes torches. Burn logs down in a campfire, or dig out a coal seam.",
    "quest.base.red_metal": "Red Metal",
    "quest.base.red_metal.why": "Copper tools are faster and find more, and copper is three parts of bronze.",
    "quest.base.crucible_kiln": "Crucible Kiln",
    "quest.base.crucible_kiln.why": "Bronze needs heat a campfire can't reach. Lighting the kiln starts the Bronze age.",
    "quest.base.first_bronze": "First Bronze",
    "quest.base.first_bronze.why": "Three copper to one tin, smelted in the kiln: the metal of the next age.",
    "block.base.pit_kiln": "Pit Kiln",
    "block.base.kiln_bricks": "Kiln Bricks",
    "block.base.crucible": "Crucible",
    "block.base.sleeping_bag": "Sleeping Bag",
    "block.base.clay_pot": "Clay Pot",
    "block.base.vial": "Vial",
    "block.base.bronze_blend": "Bronze Blend",
    "block.base.bronze_ingot": "Bronze Ingot",
    "multiblock.base.homestead_hearth": "Homestead Hearth",
    "multiblock.base.homestead_hearth.hint": "The hearth needs a ring of stone around the hearthstone and a chimney two blocks tall at one corner.",
    "multiblock.base.crucible_kiln": "Crucible Kiln",
    "multiblock.base.crucible_kiln.hint": "The kiln needs kiln bricks all round the crucible and a pillar of kiln bricks on each corner.",
    "quest.base.look_it_up": "Look It Up",
    "quest.base.look_it_up.why": "Forgotten a recipe? Open the inventory, type part of a name in its search box, and click the item to see how it is made; a right-click shows what it goes into. Look up the stone pickaxe.",
    "quest.base.first_night": "First Night",
    "quest.base.first_night.why": "Night comes fast. Cooked food heals far more than raw, and a fire keeps the cold off.",
    "quest.base.stone_in_hand": "Stone in Hand",
    "quest.base.stone_in_hand.why": "Bare hands are slow. Stone tools mine twice as fast and reach coal for torches.",
    "quest.base.where_to_settle": "Where to Settle",
    "quest.base.where_to_settle.why": "Biomes help different work: the woods heal, the water fishes, the mountains mine. Where you build decides what your home gives.",
    "quest.base.homestead_hearth": "Homestead Hearth",
    "quest.base.homestead_hearth.why": "Your home: you wake here after dying, and the Farm age opens. A hearthstone in a ring of stone, with a chimney at a corner.",
    "quest.base.a_friend_in_the_wild": "A Friend in the Wild",
    "quest.base.a_friend_in_the_wild.why": "A tamed junglefowl lays eggs at home: your first step to a farm, and to pets.",
    "quest.base.bare_hands": "First Catch",
    "quest.base.bare_hands.why": "Fish are the easiest food near water, and heal well once cooked.",
    "quest.base.twine_and_thong": "Twine and Thong",
    "quest.base.twine_and_thong.why": "Twine goes into rod lines, pouches, snares and bows.",
    "quest.base.pockets": "Pockets",
    "quest.base.pockets.why": "Herbs and seeds eat slots; a pouch holds a thousand of a kind in one.",
    "quest.base.torchlight": "Torchlight",
    "quest.base.torchlight.why": "Light keeps monsters off and lets you work at night.",
    "quest.base.crafting_table": "Crafting Table",
    "quest.base.crafting_table.why": "Its three-by-three grid makes every tool and weapon.",
    "quest.base.first_ore": "Red Metal Underfoot",
    "quest.base.first_ore.why": "Copper is the first ore your stone pickaxe can take, and the start of every metal.",
    "block.base.farmland": "Farmland",
