    "bees.angry": "The bees boil out of the nest and will not go in. Smoke them first: a campfire close by, or a torch held a moment before you take up the skep.",
    "bees.stung": "Stung! Smoke calms bees: a campfire close by, or a torch held a moment first, since its smoke clings to you a while.",
    "effect.base.camp": "Camp",
    "effect.base.camp.description": "Your own bed and light: you heal a fifth faster here.",
    "effect.base.camp.next": "Next: build a Homestead Hearth near your bed and light it.",
    "effect.base.hearthside": "Hearthside",
    "effect.base.hearthside.description": "Your hearth keeps the cold off: you heal a third faster here.",
    "effect.base.hearthside.next": "Next: wall it in and roof it over, even with hide or wattle, with your bed and two lights, to be snug.",
    "effect.base.snug": "Snug",
    "effect.base.snug.description": "Walled in and roofed over: you heal half as fast again here.",
    "effect.base.snug.next": "Next: sound walls (logs, planks or stone) for most of the room, two seats, a table, two places to store things and a third light make it homely.",
    "effect.base.homely": "Homely",
    "effect.base.homely.description": "Sound walls, and room to sit, work and store: 2° warmer, and you learn a twentieth more here, and your stores here hold twice as much.",
    "effect.base.homely.next": "Next: sound walls nearly all about, two rugs, two curtains, a cushion, three pieces of crockery and a fourth light make it cosy.",
    "effect.base.cosy": "Cosy",
    "effect.base.cosy.description": "Soft, bright and close walled: 3° warmer, you heal faster and learn a tenth more here, and your stores here hold twice as much.",
    "effect.base.cosy.next": "Next: fine walls (dressed stone, brick or glass) for half the room, a bookshelf, a stove or cauldron, a loom, spindle or quern, and a banner make it the heart of the home.",
    "effect.base.heart_of_the_home": "Heart of the Home",
    "effect.base.heart_of_the_home.description": "Everything a home needs, finely walled: 4° warmer, heal twice as fast, learn an eighth more, and your stores here hold three times as much.",
    "effect.base.workbench": "Workbench",
    "effect.base.workbench.description": "A bench to work at: you craft and build as if a level higher here.",
    "effect.base.workbench.next": "Next: a loom, spindle stand or quern, a light, and two places to store things under a roof make it a workshop.",
    "effect.base.workshop": "Workshop",
    "effect.base.workshop.description": "Everything to hand: you craft and build as if two levels higher here.",
    "effect.base.pantry": "Pantry",
    "effect.base.pantry.description": "A full pantry by the fire: the good a meal does lasts a quarter longer.",
    "effect.base.pantry.next": "Next: four places to store things, a stove or cauldron and a table under a roof make it a larder.",
    "effect.base.larder": "Larder",
    "effect.base.larder.description": "Meals heal a fifth more here and their good lasts half again as long.",
    "effect.base.bedside": "Bedside",
    "effect.base.bedside.description": "A seat and two lights by your bed: 2° warmer here, and a night's sleep is well rested.",
    "effect.base.soft_furnishings": "Soft furnishings",
    "effect.base.soft_furnishings.description": "A rug underfoot and cloth hung on the wall keep the draught off: 1° warmer here.",
    "effect.base.herb_nook": "Herb nook",
    "effect.base.bright_room": "Bright room",
    "effect.base.bright_room.description": "Daylight through two windows: you learn a twentieth more here, and heal a twentieth faster.",
    "effect.base.hearth_corner": "Hearth corner",
    "effect.base.bedchamber": "Bedchamber",
    "effect.base.bedchamber.description": "A bed, a blanket chest at its foot, a washstand and a rug under one roof: 1° warmer here, and you heal a tenth faster.",
    "effect.base.kitchen": "Kitchen",
    "effect.base.kitchen.description": "A dresser and a pot crane by the hearth: 1° warmer here, and meals heal a twentieth more.",
    "effect.base.hearth_corner.description": "A settle by the hearth and wood stacked to hand: 1° warmer here, and you heal a twentieth faster.",
    "effect.base.lived_in_hearth": "Lived-in hearth",
    "effect.base.lived_in_hearth.description": "A mantel shelf over the hearth and a fireside bench before it: 1° warmer here, and you learn a twentieth more.",
    "effect.base.herb_nook.description": "Herbs drying overhead: you farm and brew as if a level higher here, and a meal's good lasts a tenth longer.",
    "effect.base.bee_garden": "Bee garden",
    "effect.base.bee_garden.description": "Bees at work among your flowers: you heal a tenth faster here, and crops near the hive grow a quarter faster.",
    "effect.base.dooryard": "Dooryard",
    "effect.base.dooryard.description": "An awning at your door, a bench, bunting, bales or a dry-stone wall out in the open about it: in the yard you heal a twentieth faster.",
    "effect.base.sheltered": "Sheltered",
    "effect.base.sheltered.description": "Warm and dry while it storms: you heal a fifth faster, learn a bit more.",
    "effect.base.company": "Company",
    "effect.base.company.description": "Your animals about the house: you heal a tenth faster here.",
    "effect.base.company.next": "Next: four animals kept about the house make it a full house.",
    "effect.base.full_house": "Full house",
    "effect.base.full_house.description": "A yard full of animals: you heal a fifth faster, learn a bit more here.",
    "effect.base.door_shut": "Door shut",
    "effect.base.door_shut.description": "The door shut on the night: you heal a tenth faster here, and are 1° warmer.",
    "effect.base.evening_in": "Evening in",
    "effect.base.evening_in.description": "Home by the fire after dark: you heal a fifth faster here, and are 2° warmer.",
    "effect.base.kitchen_garden": "Kitchen garden",
    "effect.base.kitchen_garden.description": "Greens growing by the door: meals heal a tenth more here.",
    "effect.base.banked_fire": "Banked fire",
    "effect.base.banked_fire.description": "A camp taught you to bank a fire: at home with a fire lit, 3° warmer.",
    "effect.base.snowed_in": "Snowed in",
    "effect.base.snowed_in.description": "Snug for winter: snow or hail outside, you heal and learn more at home.",
    "effect.base.everything_in_its_place": "Everything in its place",
    "effect.base.everything_in_its_place.description": "A homely home: with room to store things, you build a level higher at home.",
    "effect.base.home_cooking": "Home cooking",
    "effect.base.home_cooking.description": "Stove and quern learnt: meals at home heal a tenth more and last longer.",
    "effect.base.studious": "Studious",
    "effect.base.studious.description": "Books on the shelf: indoors at home you learn a twentieth more.",
    "effect.base.hearthkeeper": "Hearthkeeper",
    "effect.base.hearthkeeper.description": "Your own hearth is the best bench: craft and cook as if a level higher at home.",
    "effect.base.healing_sleep": "Healing Sleep",
    "effect.base.healing_sleep.description": "You slept: your wounds close quickly for a little while.",
    "effect.base.rested": "Rested",
    "effect.base.rested.description": "You slept: you heal and learn a little more for a while.",
    "effect.base.well_rested": "Well rested",
    "effect.base.well_rested.description": "A night slept snug, in a proper bed, or with a lit corner by the bed: you learn more and mine faster for a while.",
    "effect.base.deep_rest": "Deep rest",
    "effect.base.deep_rest.description": "A night slept in a cosy home: you heal, learn, mine and walk faster for a while.",
    "effect.base.steady_hands": "Steady hands",
    "effect.base.steady_hands.description": "A stone tool in your fist: every tool bites a tenth faster.",
    "effect.base.steady_hands.next": "Next: carry a full stone kit (pickaxe, axe, shovel, hoe and knife).",
    "effect.base.practised_hands": "Practised hands",
    "effect.base.practised_hands.description": "A whole kit and the habit of it: a fifth faster, and now and then an extra piece turns up.",
    "effect.base.practised_hands.next": "Next: forge a copper kit (axe, shovel, hoe and knife) from red metal.",
    "effect.base.copper_hands": "Copper hands",
    "effect.base.copper_hands.description": "Copper in every grip: nearly a third faster, and extras turn up twice as often.",
    "effect.base.stonewise": "Stonewise",
    "effect.base.stonewise.description": "A hand that knows stone reads mountain rock: it splits to give more.",
    "effect.base.anglers_knack": "Angler's knack",
    "effect.base.anglers_knack.description": "A supper caught and cooked: you read the water, and casts land a tenth more often.",
    "effect.base.deft_angler": "Deft angler",
    "effect.base.deft_angler.description": "Patience paid off: casts land a fifth more often.",
    "effect.base.prospector": "Prospector",
    "effect.base.prospector.description": "A good run of ore taught you where it lies: a twentieth faster, and extras turn up more.",
    "effect.base.settled_and_fed": "Settled and fed",
    "effect.base.settled_and_fed.description": "Your animals thrive and your table is set: at home you heal a tenth faster.",
