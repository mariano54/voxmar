    // Wandering parties (wandering.ron): their names for /wander and what the speaker says.
    "wander.base.mage_tutors.title": "Wandering mage",
    "wander.base.mage_tutors.greet": "Aether runs through a mote like water through a reed. Bring me one and I will show you how it is held.",
    "wander.base.mage_tutors.lesson_pair": "Two motes! Then we can go slowly, and you will keep more of it. Hold still, and breathe.",
    "wander.base.mage_tutors.lesson": "A mote will do. Close your hand round it, feel it hum, and let it go the way water goes. There, that is the first of it.",
    "wander.base.pedlar_and_hound.title": "Pedlar and hound",
    "wander.base.pedlar_and_hound.greet": "Hides, bones, feathers: I swap them for things you can use. He doesn't bite. Much.",
    "wander.base.pedlar_and_hound.swap_hide": "Two hides! Here, six lengths of twine, spun this week.",
    "wander.base.pedlar_and_hound.swap_bone": "Three bones for a pouch of seed mix. The hound will be glad of them.",
    "wander.base.pedlar_and_hound.swap_feather": "Six feathers... my pillow thanks you. Take two loaves.",
    "wander.base.pilgrims.title": "Pilgrims",
    "wander.base.pilgrims.greet": "We walk to the shrine beyond the mountains. Peace on your road.",
    "wander.base.pilgrims.mend": "You are hurt. Sit a moment; this will ease it.",
    "wander.base.pilgrims.blessing": "May bread be on your table and your fire never go out.",
    "wander.base.stroll_with_dog.title": "A walk with the dog",
    "wander.base.stroll_with_dog.greet": "Lovely day for it. He knows every rabbit hole for a mile.",
    "wander.base.stroll_with_dog.treat": "A bone for him? Oh, he will remember you. Here, I have spare twine.",
    "wander.base.bandit_patrol.title": "Bandit patrol",
    "wander.base.wolf_prowl.title": "Wolf pack on the prowl",
    "wander.base.hooded_stranger.title": "Hooded stranger",
    "wander.base.hooded_stranger.greet": "I have nothing more for you. Mind the night.",
    "wander.base.hooded_stranger.light": "You walk toward the dark. Take this, then. Most who do wish they had.",
    "wander.base.tinker_camp.title": "Tinker's camp",
    "wander.base.tinker_camp.greet": "Rest your feet. We swap hides, wool and fangs for food and twine.",
    "wander.base.tinker_camp.swap_hide": "Four hides, good. Six loaves, still warm from the fire.",
    "wander.base.tinker_camp.swap_wool": "Three fleeces for eight lengths of twine. My wife will be pleased.",
    "wander.base.tinker_camp.swap_fang": "A fang! Hold on... six measures of seed mix, the good kind.",
    "wander.base.bard_band.title": "Travelling singers",
    "wander.base.bard_band.greet": "We sing for the road and the road sings back. Stay and listen!",
    "wander.base.bard_band.song": "A song for you, then: 'The Bread That Walked Home'.",
    "wander.base.mage_tutors.greet_2": "A traveller who walks far from the roads. Good. Magic is for those who go and look. Bring me a mote and I will teach.",
    "wander.base.mage_tutors.greet_3": "Do not touch my staff. Have you a mote of aether about you? Even a small one will do for a first lesson.",
    "wander.base.mage_tutors.master": "I have nothing left to teach you. You hold the aether better than I do now. Go on, and teach someone else.",
    "wander.base.mage_tutors.adept": "Three motes. Now we can work properly: do not hold it, shape it. Again... again. Yes, that is the start of the second step.",
    "wander.base.mage_tutors.grown": "You are past the first steps. For a proper lesson I need three motes, not one. The second step is hungrier.",
    "wander.base.pedlar_and_hound.greet_2": "Needles, flints, sharp words for sale. Or bring me hides, bones and feathers, and we trade even.",
    "wander.base.pilgrims.greet_2": "Slowly, slowly: the shrine will not move. Would you walk a while with us?",
    "wander.base.tinker_camp.greet_2": "Pots mended, knives sharpened. Or swap what you carry: we know a fang when we see one.",
    "wander.base.prison_convoy.title": "Prison convoy",
    "wander.base.prison_convoy.jailer_greet": "Move along. This one is the sheriff's business, and so is anyone who makes it ours.",
    "wander.base.prison_convoy.jailer_greet_2": "Keep your distance. We have walked three days with this one and are in no mood.",
    "wander.base.prison_convoy.bribe": "Three coins, and I did not see a thing. That rope was rotten anyway.",
    "wander.base.prison_convoy.captive_greet": "Please... they say I stole a goat. I only borrowed her. Will you help me?",
    "wander.base.prison_convoy.captive_greet_2": "My hands... the rope is tight. If you have a knife, or any way, I will not forget it.",
    "wander.base.prison_convoy.cut": "Quiet, quiet... there! Oh, they are looking. Run!",
    "wander.base.prison_convoy.thanks": "Free! I will not forget this. Take it: it was all I had hidden in my boot.",
    "wander.base.prison_convoy.freed": "Thank you again. The road is long, but it is mine once more.",
    "creature.base.jailer": "Jailer",
    "creature.base.thief": "Thief",
    "creature.base.white_stag": "White stag",
    "creature.base.constable": "Constable",
    "creature.base.traveller": "Wounded traveller",
    "creature.base.captive": "Captive",
    "wander.base.shepherd_and_flock.title": "Shepherd and flock",
    "wander.base.shepherd_and_flock.greet": "Easy, easy. They scatter if you shout. Stand a moment and they will come round you.",
    "wander.base.shepherd_and_flock.greet_2": "Forty sheep, one dog, one shepherd, and a hundred opinions. Mind the mouflon: wild in the blood.",
    "wander.base.shepherd_and_flock.tip": "A crust for the dog's master? Watch how he turns them: never chase, always cut across. Same for the beasts in your own pen.",
    "wander.base.shepherd_and_flock.swap_bread": "Two loaves, and I shear the one that will not miss it. Take the fleece.",
    "wander.base.lost_child.title": "A lost child",
    "wander.base.lost_child.greet": "...I can't find the way home. Do you know where the village is?",
    "wander.base.lost_child.greet_2": "I followed a butterfly and now everything looks the same. I'm hungry.",
    "wander.base.lost_child.comfort": "Bread! Thank you. Will you walk with me to the village? I'll stay close.",
    "wander.base.lost_child.company": "Is it far? I'm trying to be brave.",
    "wander.base.lost_child.arrived": "That's our chimney! Mum! ... Here, she says this is for you.",
    "wander.base.stray_hound.title": "A stray hound",
    "wander.base.wounded_hunter.title": "A wounded hunter",
    "wander.base.wounded_hunter.greet": "My leg... a boar. I'll mend, but slowly. Spare a bite of food?",
    "wander.base.wounded_hunter.greet_2": "Don't mind me, just resting. The woods teach you things the hard way.",
    "wander.base.wounded_hunter.meal": "Ah, that helps. Let me show you how to read a track. And take these flints: good ones.",
    "wander.base.wounded_hunter.grown": "You read a track better than I do now. Go on, I will manage.",
    "wander.base.thief_chase.title": "A thief on the run",
    "wander.base.thief_chase.thief_greet": "Out of my way!",
    "wander.base.thief_chase.thief_greet_2": "Not me! I never touched it!",
    "wander.base.thief_chase.thief_caught": "All right, all right! It was a loaf and a purse, not the crown jewels.",
    "wander.base.thief_chase.constable_greet": "Stop that man!",
    "wander.base.thief_chase.constable_greet_2": "Thief! Stand clear, citizen!",
    "wander.base.thief_chase.reward": "You laid hands on him? Fair work. The town pays a bounty: take it, and our thanks.",
    "wander.base.thief_chase.caught": "Got him. Move along, there is nothing to see. The town thanks you for standing clear.",
    "wander.base.wounded_traveller.title": "A wounded traveller",
    "wander.base.wounded_traveller.traveller_greet": "Help... please... my leg. They took everything...",
    "wander.base.wounded_traveller.traveller_greet_2": "Don't leave me... water? Anything? I cannot stand...",
    "wander.base.wounded_traveller.thanks": "They are gone... gone! You did that? Here, take this: it is all they missed.",
    "wander.base.wounded_traveller.won": "I will mend. Go on, go on. The road is yours.",
    "wander.base.wounded_traveller.raider_greet": "Keep walking, friend. Nothing to see.",
    "wander.base.wounded_traveller.raider_greet_2": "Lost? The road is that way. Go on.",
    "wander.base.wounded_traveller.pay": "Three coins. Fine. We were never here, and neither were you.",
    "wander.base.wounded_traveller.sprung": "Now, lads!",
    "wander.base.white_stag.title": "A white stag",
    "wander.base.white_stag.arrived": "The stag stops at the edge of a glade, looks back at you once, and is gone. Where it stood, something pale lies in the moss.",
    "wander.base.wisp_trail.title": "A wandering light",
    "wander.base.wisp_trail.arrived": "The light dips into a hollow, hangs a moment over the moss, and goes out. Something glints where it was.",
    "wander.base.fox_and_farmer.title": "A fox and a farmer",
    "wander.base.fox_and_farmer.farmer_greet": "Stop that fox! He has had two of my hens!",
    "wander.base.fox_and_farmer.farmer_greet_2": "My hens! Head him off, friend!",
    "wander.base.fox_and_farmer.reward": "You turned him! Here, take these eggs: what the hens left me.",
    "wander.base.fox_and_farmer.caught": "Got him by the tail. Off to the far hedge with you, you thief.",
    "creature.base.hunter": "Hunter",
    "creature.base.poacher": "Poacher",
    "creature.base.wild_sow": "Wild sow",
    "wander.base.berry_pickers.title": "Berry pickers",
    "wander.base.berry_pickers.greet": "Mind the thorns. The best ones hide under the leaves.",
    "wander.base.berry_pickers.greet_2": "A good year for berries. The birds think so too.",
    "wander.base.berry_pickers.swap": "Eight good ones! Here, a loaf from the basket. Fair swap.",
    "wander.base.berry_pickers.mushrooms": "Looking for more than berries? We passed mushrooms on the way. Here is where.",
    "wander.base.herb_gatherer.title": "Herb gatherer",
    "wander.base.herb_gatherer.greet": "Every green thing is good for something, if you know what.",
    "wander.base.herb_gatherer.greet_2": "Careful where you tread, young one. That is supper and medicine both.",
    "wander.base.herb_gatherer.lore": "Let me see. Yes, that one: steep it, drink it, and mind the dose. Remember how it smelled.",
    "wander.base.herb_gatherer.roots": "You know your leaves. Now roots: dig where I tell you, and gently.",
    "wander.base.herb_gatherer.wonders": "You have the eye for it. There are flowers that glow, if you know where. I will tell you what I know.",
    "wander.base.fisher_folk.title": "Fisher folk",
    "wander.base.fisher_folk.greet": "Shh. They are biting, or they were until you came.",
    "wander.base.fisher_folk.greet_2": "Still water, patient hands. That is all there is to it.",
    "wander.base.fisher_folk.rod_tip": "Not like that. Low, and let the line sit. The fish come to the still ones.",
    "wander.base.fisher_folk.line": "Three good sticks? That is a rod in the making. Here is line enough to finish it.",
    "wander.base.fisher_folk.swap": "Good catch. We will take those to market; here is line for your trouble.",
    "wander.base.fisher_folk.share": "You look worn through. Here, take one of ours. Cook it before you eat it.",
    "wander.base.boar_sounder.title": "A sow and her piglets",
    "wander.base.boar_sounder.warn": "The sow lowers her head and grunts at you. Her piglets bunch behind her.",
    "wander.base.deer_herd.title": "A herd of deer",
    "wander.base.travelling_cook.title": "A travelling cook",
    "wander.base.travelling_cook.greet": "Pull up a log. The pot is on, and there is always room for more in it.",
    "wander.base.travelling_cook.greet_2": "Bring me something raw and I will bring it back better.",
    "wander.base.travelling_cook.cook": "Into the pan. There, done, not a scrap burnt. I kept one for the pot, that is the fee.",
    "wander.base.travelling_cook.lesson": "You cooked this? Not bad. Less fire, more patience, and turn it once, not ten times.",
    "wander.base.travelling_cook.supper": "Sit, sit. You are in no state to walk. Eat this.",
    "wander.base.cowherd.title": "A cowherd and a calf",
    "wander.base.cowherd.greet": "Fresh grass over the hill, or so they tell me. We will see.",
    "wander.base.cowherd.greet_2": "Steady, girls. It is only a traveller.",
    "wander.base.cowherd.milk": "Got a pail? Go on, the brown one is gentle. Warm hands, mind.",
    "wander.base.cowherd.calf": "Four coins, and the calf is yours. Treat her well, and she will see you through a winter.",
    "wander.base.cowherd.calf_offer": "You have the hands for beasts, I can see. Four coins and that calf goes home with you.",
    "wander.base.cowherd.green": "Selling? Not to someone who has not kept a beast. Tame a few wild ones first; then we talk.",
    "wander.base.woodcutters.title": "Woodcutters at work",
    "wander.base.woodcutters.greet": "Mind the trunk when it comes down. We shout first, usually.",
    "wander.base.woodcutters.greet_2": "Good straight timber in this stand. The pile grows.",
    "wander.base.woodcutters.buy": "Eight good logs? Saves our arms. Four coins, and they go on the pile.",
    "wander.base.woodcutters.axe": "Hold it lower and let the weight do the work. Cut the notch on the side you want it to fall.",
    "wander.base.woodcutters.fruit": "If you want more than firewood out of a tree, we passed fruit trees on the way. Here is where.",
    "wander.base.water_carriers.title": "Water carriers",
    "wander.base.water_carriers.greet": "Heavy, these. The field is thirsty all the same.",
    "wander.base.water_carriers.greet_2": "Two more trips and the rows will drink well.",
    "wander.base.water_carriers.tip": "Crops near water grow better. Till close to a stream and save your back.",
    "wander.base.water_carriers.drink": "You look done in. Here, drink, it is clean.",
    "wander.base.harvest_family.title": "A harvest family",
    "wander.base.harvest_family.greet": "Good year for us. The cart is heavy, the children are heavier.",
    "wander.base.harvest_family.greet_2": "Taking it all to market. Unless someone here grows something we do not.",
    "wander.base.harvest_family.chickpea": "Carrots! We will trade you chickpeas for those. Dry ground suits them.",
    "wander.base.harvest_family.carrot": "Rye for carrots, fair is fair. Sow them deep and loose.",
    "wander.base.harvest_family.rye": "Wheat? Take some rye in trade. It grows where wheat sulks.",
    "wander.base.harvest_family.sow": "Seed in hand already. Till the ground, sow it, and keep the birds off. That is half of farming.",
    "wander.base.charcoal_burners.title": "Charcoal burners",
    "wander.base.charcoal_burners.greet": "Keep clear of the mound. It burns slow and it burns long.",
    "wander.base.charcoal_burners.greet_2": "Smoke in your eyes, soot in your bread. Good trade, though.",
    "wander.base.charcoal_burners.burn": "A dozen logs for two of charcoal. Fair, for the days it takes.",
    "wander.base.charcoal_burners.coal": "Want the real thing? Black stone shows on the ground near here. Dig under it.",
    "wander.base.wandering_healer.title": "A wandering healer",
    "wander.base.wandering_healer.greet": "Walking and listening. People always need mending somewhere.",
    "wander.base.wandering_healer.greet_2": "Herbs from every hill in this bag. Some of them even work.",
    "wander.base.wandering_healer.mend": "Sit, let me see. There. Keep it clean and it will close.",
    "wander.base.wandering_healer.salve": "Three herbs make a salve. Rub it in; it soothes as it heals.",
    "wander.base.story_teller.title": "A story teller",
    "wander.base.story_teller.greet": "Come, sit. The fire is warm and the tale is long.",
    "wander.base.story_teller.greet_2": "Every hill has a story. Most are even true.",
    "wander.base.story_teller.tale": "They say there is something strange not far from this fire. Go and see, if you dare.",
    "wander.base.hermit.title": "A hermit",
    "wander.base.hermit.greet": "Few come this far. Fewer come back the same.",
    "wander.base.hermit.greet_2": "Sit if you like. The quiet is free.",
    "wander.base.hermit.riddle_ask": "What the wind forgets, the earth keeps. Bring me {count} of {thing}, and I will tell you a thing worth the walk.",
    "wander.base.hermit.riddle": "So you listened. There is a wonder not far from here. Go and see it with your own eyes.",
    "wander.base.goose_girl.title": "A goose girl",
    "wander.base.goose_girl.greet": "Shoo, shoo! To the water with you!",
    "wander.base.goose_girl.greet_2": "They bite if you get too close. Mostly the big one.",
    "wander.base.goose_girl.seed": "Seed! Throw it wide so they don't squabble. Here, they always drop feathers.",
    "wander.base.goose_girl.duckling": "Two coins and the little one is yours. Keep her near water.",
    "wander.base.prospector.title": "A prospector",
    "wander.base.prospector.greet": "See the colour in that rock? Where it shows on top, there is more below.",
    "wander.base.prospector.greet_2": "Every hill hides something. The trick is knowing which.",
    "wander.base.prospector.lesson": "Strike along the grain, not against it. Let the pick bounce and you will tire by noon.",
    "wander.base.prospector.vein": "You have the eye. I passed more stone showing colour on the way here.",
    "wander.base.travelling_alchemist.title": "A travelling alchemist",
    "wander.base.travelling_alchemist.greet": "Every leaf has a property. Most of them are bitter.",
    "wander.base.travelling_alchemist.greet_2": "Careful of the bag. Some of those jars are not quite settled.",
    "wander.base.travelling_alchemist.herb_ask": "I am short of one thing for a brew: {count} of {thing}. Find them and I will make it worth your while.",
    "wander.base.travelling_alchemist.herb": "Exactly right. Watch how I steep it, and keep this. It clears the head.",
    "wander.base.wedding.title": "A wedding party",
    "wander.base.wedding.greet": "To the shrine! Walk with us a way, if you like.",
    "wander.base.wedding.greet_2": "A good day for it. Not a cloud.",
    "wander.base.wedding.gift": "A flower, for us? Then take a slice of the wedding bread, and our luck with it.",
    "wander.base.funeral.title": "A funeral",
    "wander.base.funeral.greet": "We walk him to rest. Peace on your road.",
    "wander.base.funeral.greet_2": "Quiet, now.",
    "wander.base.funeral.respects": "Thank you. Lay it with the others. He would have liked that.",
    "wander.base.travelling_smith.title": "A travelling smith",
    "wander.base.travelling_smith.greet": "Dull edges? I can hear them from here.",
    "wander.base.travelling_smith.greet_2": "Anvil's cold, but my whetstone isn't. A coin and every edge you carry bites again.",
    "wander.base.travelling_smith.whet": "There. Feel that? Every edge you carry, sharp as the day it was made. Mind your thumbs.",
    "wander.base.travelling_smith.care": "Wipe it clean, keep it dry, and never pry with an edge. A tool kept is a tool that keeps you.",
    "wander.base.truffle_hunter.title": "A truffle hunter",
    "wander.base.truffle_hunter.greet": "Mind the pig. She bites, but only things worth biting.",
    "wander.base.truffle_hunter.greet_2": "Shh. She's got the scent of something.",
    "wander.base.truffle_hunter.safe": "Let me see that. Firm, clean gills, no ring of red: that one you may eat. The bright ones, never.",
    "wander.base.truffle_hunter.truffle": "A coin for a secret, then. She dug at a spot not far off, and she is never wrong.",
    "wander.base.wandering_monk.title": "A wandering monk",
    "wander.base.wandering_monk.greet": "... (The monk bows, a finger to the lips.)",
    "wander.base.wandering_monk.greet_2": "... (A nod. The monk looks at your hands, then at the sky.)",
    "wander.base.wandering_monk.mend": "... (The monk kneels and binds your hurts with clean linen, without a word.)",
    "wander.base.wandering_monk.blessing": "... (The monk takes the mote, closes your hand round its warmth, and smiles.)",
    "wander.base.refugees.title": "Refugees",
    "wander.base.refugees.greet": "Raiders took the village. We walked three days. Have you anything to eat?",
    "wander.base.refugees.greet_2": "Don't be afraid of us. We only want somewhere to sit down.",
    "wander.base.refugees.shelter": "Bless you. You have a home? ... Could one of us come with you? I can work. I will keep the fire.",
    "wander.base.refugees.company": "Is your home far? Walk on, I'll keep up.",
    "wander.base.refugees.arrived": "A hearth. I'd forgotten. Here, the seed we carried all this way; it should grow in better hands than ours.",
    "wander.base.puppeteers.title": "Puppeteers",
    "wander.base.puppeteers.greet": "Sit, sit! The show starts when the knight finds his other leg.",
    "wander.base.puppeteers.greet_2": "Children at the front, grown-ups at the back, dragons nowhere near.",
    "wander.base.puppeteers.show": "And the dragon went home, and everyone had supper. The end! Thank you, thank you!",
    "wander.base.puppeteers.hat": "A coin in the hat! The knight bows to you, sir or madam. Twice, because you paid.",
    "wander.base.dance_circle.title": "A dance circle",
    "wander.base.dance_circle.greet": "Into the ring! Nobody minds your feet in the dark.",
    "wander.base.dance_circle.greet_2": "Keep the beat. Left, left, turn, and clap!",
    "wander.base.dance_circle.show": "There, you're warm through now. Come back tomorrow night; we'll still be turning.",
    "wander.base.dance_circle.round": "One round with us! Faster... faster! Ha, you'll sleep well tonight.",
    "wander.base.cartographer.title": "A cartographer",
    "wander.base.cartographer.greet": "Hold still, you're standing on my baseline.",
    "wander.base.cartographer.greet_2": "Every map is wrong somewhere. I'm here to make this one wrong less.",
    "wander.base.cartographer.town": "I came by a town. Here, I'll mark it for you.",
    "wander.base.cartographer.chest": "Someone left a chest under the rock near here, locked tight. I put it on the map; here, it's this way.",
    "wander.base.cartographer.pace": "Pace it out: one stride, one block. Count your strides and you'll never cut a wall short.",
    "wander.base.scarecrow.title": "A walking scarecrow",
    "wander.base.scarecrow.greet": "... (Straw rustles. The painted face does not move.)",
    "wander.base.scarecrow.pockets": "... (Straw rustles. Its burlap pockets are full of seed.)",
    "wander.base.hunting_party.title": "A hunting party",
    "wander.base.hunting_party.greet": "Quiet now. There's boar sign all through here.",
    "wander.base.hunting_party.greet_2": "Keep behind the hounds, friend, and keep low.",
    "wander.base.hunting_party.tracks": "See how the leaves are pressed, and the soil turned where it rooted? Read the ground first and the beast is half found.",
    "wander.base.hunting_party.took": "A clean kill. We'll eat well in town tonight.",
    "wander.base.hunting_party.share": "Yours was the first blow on that one. Here's your share, fair and square.",
    "wander.base.poacher.title": "A poacher",
    "wander.base.poacher.greet": "Shh! You'll put the deer up. Go on, you never saw me.",
    "wander.base.poacher.greet_2": "Just walking. Nothing to see here.",
    "wander.base.poacher.cut": "You saw nothing, eh? Take this for your trouble, and keep it that way.",
    "wander.base.poacher.spare": "All right, all right! Put that away. I'm going, and the deer can keep its hide.",
    "wander.base.trapper.title": "A trapper",
    "wander.base.trapper.greet": "Mind my snares. They don't care whose foot they catch.",
    "wander.base.trapper.greet_2": "Rabbits run the same runs every night. That's all there is to it.",
    "wander.base.trapper.snare": "A loop of twine where the grass is worn flat, a peg to hold it, and patience. Here, I'll show you the knot.",
    "wander.base.trapper.share": "You drew first blood on that one. Fair's fair, take your share.",
    "wander.base.night_watchman.title": "The night watch",
    "wander.base.night_watchman.greet": "Who goes there? Ah, a traveller. Keep to the light.",
    "wander.base.night_watchman.greet_2": "All's quiet, and long may it stay so.",
    "wander.base.night_watchman.mend": "You're bleeding. Hold still while I bind that.",
    "wander.base.night_watchman.guard_up": "Keep your guard up and your back to something solid. The dark comes at you from every side.",
    "wander.base.night_watchman.way": "Lost? Town's not far. Here, I'll tell you the way.",
    "wander.base.guard_patrol.title": "A guard patrol",
    "wander.base.guard_patrol.greet": "The road's safe while we walk it. Move along.",
    "wander.base.guard_patrol.greet_2": "Bring us a fang, if you hunt. The town pays for every one.",
    "wander.base.guard_patrol.bounty": "A fang? That's one less beast at the gates. Here's the town's bounty.",
    "wander.base.guard_patrol.drill": "You hold that like a spade. Feet apart, weight forward, strike through. Again!",
    "wander.base.fortune_teller.title": "A fortune teller",
    "wander.base.fortune_teller.greet": "Cross my palm with gold, dear, and the cards will tell you what lies near.",
    "wander.base.fortune_teller.greet_2": "The cards are restless tonight. Will you hear them?",
    "wander.base.fortune_teller.fortune": "The cards turn... and they say this, true as I sit here.",
    "wander.base.market_folk.title": "Market folk",
    "wander.base.market_folk.greet": "Off to market! Walk with us if you're going our way.",
    "wander.base.market_folk.greet_2": "It's a long road to town, and better in company.",
    "wander.base.market_folk.there": "Here we are. The market's just through there.",
    "wander.base.market_folk.sell": "Good wheat, that. Here's a coin for it; we'll grind it in town.",
    "wander.base.market_folk.arrived": "We made it! You kept us good company. Have some of the bread we baked for the road.",
    "wander.base.drenched_travellers.title": "Travellers caught in the rain",
    "wander.base.drenched_travellers.greet": "Soaked to the bone. This rain won't stop.",
    "wander.base.drenched_travellers.greet_2": "Have you anything warm? Anything at all?",
    "wander.base.drenched_travellers.warm": "A light! Oh, that's better. Here, take this for your kindness.",
    "wander.base.drenched_travellers.ledge": "Thank you. We sheltered under a ledge on the way. Ore showed in the rock there, I'm sure of it.",
    "wander.base.rainmakers.title": "Rainmakers",
    "wander.base.rainmakers.greet": "The land is thirsty. We dance so the sky remembers it.",
    "wander.base.rainmakers.greet_2": "Two coins, and we'll dance it in earnest.",
    "wander.base.rainmakers.rain": "Then we dance! Listen... can you hear it coming?",
    "wander.base.rainmakers.show": "The drums fall quiet. You feel lighter for watching.",
    "wander.base.shrine_bearer.title": "A shrine bearer",
    "wander.base.shrine_bearer.greet": "Peace on your road. We carry the shrine from town to town.",
    "wander.base.shrine_bearer.greet_2": "Rest a moment, friend. The shrine asks nothing of you.",
    "wander.base.shrine_bearer.first_prayer": "Kneel here. Quiet your breath, and listen. That stillness is where every prayer begins.",
    "wander.base.shrine_bearer.renew": "You have given much of yourself. Kneel by the shrine and be filled again.",
    "wander.base.neighbours.title": "Neighbours calling",
    "wander.base.neighbours.greet": "Hello there! We heard someone had settled nearby.",
    "wander.base.neighbours.greet_2": "It's good to have neighbours again. This land's been lonely.",
    "wander.base.neighbours.housewarming": "We brought you something for the house. Every home needs a good plate.",
    "wander.base.neighbours.meal": "You cook well! Here, seed from our garden for yours.",
    "wander.base.wolf_hunters.title": "Wolf hunters",
    "wander.base.wolf_hunters.greet": "Wolves have been at the flocks round here. We mean to end it.",
    "wander.base.wolf_hunters.greet_2": "Stay near the fire tonight. We'll handle the wolves.",
    "wander.base.wolf_hunters.took": "That's one wolf that won't be at anyone's door again.",
    "wander.base.wolf_hunters.share": "You blooded that one first. Brave work. Here's your share.",
    "wander.base.clay_diggers.title": "Clay diggers",
    "wander.base.clay_diggers.greet": "Good clay here, smooth as butter. The kiln's hungry for it.",
    "wander.base.clay_diggers.greet_2": "Mind the bank, it's slippery. We're digging for the kiln.",
    "wander.base.clay_diggers.fire": "Give it here, our kiln's hot. There, fired through, not a crack in it. We'll keep one for the trouble.",
    "wander.base.clay_diggers.pot": "Fired clay! Now, wet your hands and draw the wall up slowly, turning as you go. That's a pot.",
    "wander.base.harvest_home.title": "Harvest home",
    "wander.base.harvest_home.greet": "Harvest home! We carry the last sheaf round every field.",
    "wander.base.harvest_home.greet_2": "Sing with us, neighbour! The corn's in, or nearly.",
    "wander.base.harvest_home.sheaf": "A sheaf from your own field for the dolly! May it go well with what's still growing here.",
    "wander.base.harvest_home.song": "You don't know the sowing song? Here: seed for the singing, and sow it before the frost.",
    "wander.base.coal_carters.title": "Coal carters",
    "wander.base.coal_carters.greet": "Coal for the town's smiths. Heavy going, but it pays.",
    "wander.base.coal_carters.greet_2": "Walk with us if you're bound for town. Company makes the sacks lighter.",
    "wander.base.coal_carters.there": "Here's the town, and the smiths waiting on us.",
    "wander.base.coal_carters.torch": "Two sticks? Here's a lump of coal. Coal on the end of a stick and you've light for the night.",
    "wander.base.coal_carters.seam": "Want coal of your own? Look for the black-flecked stones lying about; there's a seam under them.",
    "wander.base.coal_carters.arrived": "We made it. Take a little of the coal; you carried your share of the road.",
    "wander.base.tanner.title": "A tanner",
    "wander.base.tanner.greet": "Where there are hunters there are hides, and where there are hides, there's me.",
    "wander.base.tanner.greet_2": "Don't mind the smell. That's the honest smell of leather.",
    "wander.base.tanner.scrape": "Scrape the flesh side clean, salt it, stretch it and let it dry. Then it's fit for wraps.",
    "wander.base.tanner.buy": "Four good hides! Two coins for them, and fair.",
    "wander.base.rat_catcher.title": "A piper",
    "wander.base.rat_catcher.arrived": "The tune ends, and the mice run off into the grass. The piper bows and leaves a little sack of the seed they would have eaten.",
    "wander.base.benighted_miners.title": "Benighted miners",
    "wander.base.benighted_miners.greet": "Our lamp's gone out and the dark's come down. We'll sit here till morning.",
    "wander.base.benighted_miners.greet_2": "You don't have a bit of coal, do you? Our lamp's dead.",
    "wander.base.benighted_miners.relight": "Coal! Light again. Here, a coin for it, and a miner's word: coal shows as black flecks in the rock.",
    "wander.base.benighted_miners.seam": "We were working a seam today. There's coal showing at the surface, if you know where to look.",
    "wander.base.sparring_master.title": "A sparring master",
    "wander.base.sparring_master.greet": "Thirty years a soldier. Now I teach the young ones not to die.",
    "wander.base.sparring_master.greet_2": "Keep your guard up and your feet under you. That's most of it.",
    "wander.base.sparring_master.spar": "You hold that like a spade. Come on then, a bout. I'll stop before either of us is hurt, so don't you hold back.",
    "wander.base.sparring_master.bout_won": "Enough! Enough. You've a fighter's eye. Come here, let me show you why that worked.",
    "wander.base.sparring_master.bout_lost": "And that's a bout. No shame in it. Get your breath and listen.",
    "wander.base.sparring_master.won": "You beat an old soldier fair. Remember what your feet were doing; that's what won it.",
    "wander.base.sparring_master.lost": "You dropped your guard each time you swung. Watch the shoulder, not the blade.",
    "wander.base.sparring_master.master": "Nothing left I can teach you. I'd rather watch you than fight you.",
    "wander.base.village_champion.title": "The village champion",
    "wander.base.village_champion.greet": "Champion of the town three summers running! Anyone fancy a bout?",
    "wander.base.village_champion.greet_2": "Two coins says you can't put me down to half. Double back if you can.",
    "wander.base.village_champion.wager": "A wager! Into the ring, then. To half, and nobody falls.",
    "wander.base.village_champion.bout_won": "Ha! You've done it. The crowd won't let me hear the end of this.",
    "wander.base.village_champion.bout_lost": "That's the bout! Still champion. Better luck next summer.",
    "wander.base.village_champion.won": "Fair's fair: your wager back, doubled. Spend it well, champion.",
    "wander.base.village_champion.lost": "Your coins buy the ring a round tonight. Come back when you've trained.",
    "wander.base.stargazers.title": "Stargazers",
    "wander.base.stargazers.greet": "A clear night at last! Lie back and look up.",
    "wander.base.stargazers.greet_2": "Every star has a name, if you know where to look.",
    "wander.base.stargazers.tube": "Put your eye here. No, lower, toward the land. See that glow? Something strange lies over there.",
    "wander.base.stargazers.show": "You lie back in the grass with them, and for a while there is nothing but the stars. You get up clear-headed.",
    "wander.base.chimney_sweep.title": "A chimney sweep",
    "wander.base.chimney_sweep.greet": "Sweep! Chimneys swept! Your flue drawing well, neighbour?",
    "wander.base.chimney_sweep.greet_2": "Mind the soot. It's lucky, mind, but it doesn't come out.",
    "wander.base.chimney_sweep.luck": "Shake a sweep's hand for luck! There. Watch what comes your way today.",
    "wander.base.quack_doctor.title": "A quack doctor",
    "wander.base.quack_doctor.greet": "Tonics! Cordials! Cure what ails you, and some things that don't!",
    "wander.base.quack_doctor.greet_2": "One coin, friend. Every bottle a wonder, every wonder a bottle.",
    "wander.base.quack_doctor.greet_3": "Made from a secret recipe. Even I don't know what's in them.",
    "wander.base.quack_doctor.tonic": "A fine choice! Drink it down in one. There! How do you feel?",
    "wander.base.stuck_cart.title": "A cart stuck in the mud",
    "wander.base.stuck_cart.show": "You put your shoulder to the wheel with the farmer and the cart comes free with a sucking groan. They press a coin and a loaf on you.",
    "wander.base.wassailers.title": "Wassailers",
    "wander.base.wassailers.greet": "Wassail! Wassail! A health to your house and your fields!",
    "wander.base.wassailers.greet_2": "A loaf for the singers, and we'll toast your crops to a fat harvest.",
    "wander.base.wassailers.toast": "Here's to the corn and here's to the field! Grow, little ones, grow! There. Listen to them stretch.",
    "wander.base.thatchers.title": "Thatchers",
    "wander.base.thatchers.greet": "Off to a roof that's let the rain in all spring.",
    "wander.base.thatchers.greet_2": "Straw, a ladder, and a good knee. That's thatching.",
    "wander.base.thatchers.lesson": "Lay it in rows from the eaves up, each row over the last, so the rain runs off and never in.",
    "wander.base.thatchers.roof": "Your roof keeping you dry? Straw laid thick will outlast you.",
    "wander.base.seed_swappers.title": "Seed swappers",
    "wander.base.seed_swappers.greet": "Seeds for seeds! What grew for you, and what would you like to grow?",
    "wander.base.seed_swappers.greet_2": "Every field gets tired of one crop. Try something new.",
    "wander.base.seed_swappers.sow": "Sow in turned earth by water, and don't pick till it's ripe. Green crops give back only seed.",
    "wander.base.seed_swappers.swap_more": "Four of your wheat seeds for a few of ours. You've a farmer's hands now; try these.",
    "wander.base.seed_swappers.swap": "Four of your wheat seeds for a few of ours. Sow them like wheat; these did well for us last year.",
    "wander.base.flint_knappers.title": "Flint knappers",
    "wander.base.flint_knappers.greet": "Mind the chips. They're sharper than they look.",
    "wander.base.flint_knappers.greet_2": "A good flint rings when you strike it.",
    "wander.base.flint_knappers.knap": "Hold it on your knee, strike the edge on a slant, and the flake comes away clean. Again.",
    "wander.base.flint_knappers.gravel": "Flint hides in gravel. Dig the bank over that way and you'll turn some up.",
    "wander.base.flint_knappers.trade": "A good hide! Take a handful of flints for it.",
    "wander.base.frog_giggers.title": "Frog giggers",
    "wander.base.frog_giggers.greet": "Shh. Hold the light steady and they freeze.",
    "wander.base.frog_giggers.greet_2": "A wet night's a good night, for frogs.",
    "wander.base.frog_giggers.still": "Shine it in their eyes and keep it still. They won't move till you're on them.",
    "wander.base.frog_giggers.share": "Yours was the first strike on that one. Fair's fair.",
    "wander.base.messenger.title": "A messenger",
    "wander.base.messenger.greet": "Can't stop! A letter for the town!",
    "wander.base.messenger.greet_2": "Keep up if you can!",
    "wander.base.messenger.news": "Saw something strange on the road, over that way. Didn't stop to look!",
    "wander.base.messenger.there": "Delivered! Now I can breathe.",
    "wander.base.messenger.arrived": "You kept up the whole way! Here, have a drink on me.",
    "wander.base.sleepwalker.title": "A sleepwalker",
    "wander.base.sleepwalker.greet": "Mm... the geese... must count the geese...",
    "wander.base.sleepwalker.greet_2": "Three... no, four... where did the bucket go...",
    "wander.base.sleepwalker.wake": "Wha... where am I? Oh no, not again. Thank you, friend. Here, for your trouble. I'd best get home.",
    "wander.base.ore_assayer.title": "An ore assayer",
    "wander.base.ore_assayer.greet": "Rock tells you everything, if you know how to ask it.",
    "wander.base.ore_assayer.greet_2": "Copper stains green, iron stains red. Remember that.",
    "wander.base.ore_assayer.assay": "Feel the weight of it. Heavy for its size is good ore; light and crumbly is mostly rock.",
    "wander.base.ore_assayer.buy": "Four good lumps of copper ore. That's worth a coin to me.",
    "wander.base.bloomery_smelters.title": "Bloomery smelters",
    "wander.base.bloomery_smelters.greet": "Mind the cart, the furnace is still warm.",
    "wander.base.bloomery_smelters.greet_2": "Got ore and no fire hot enough? We can help.",
    "wander.base.bloomery_smelters.smelt": "Into the crucible with it. Pump, pump... there. Your metal, less one for our charcoal.",
    "wander.base.bloomery_smelters.bellows": "Ore wants more heat than wood gives. Charcoal and a steady draught: that's what bellows are for.",
    "wander.base.moth_netters.title": "Moth netters",
    "wander.base.moth_netters.greet": "Shh, they come to the light. Have you a flame?",
    "wander.base.moth_netters.greet_2": "Look at the dust on their wings. Every one different.",
    "wander.base.moth_netters.net": "Hold it still... there! Three in the jar. Here's a coin, and a tip: tracks show best by low light.",
    "wander.base.potter.title": "A potter",
    "wander.base.potter.greet": "Crocks, jars and jugs! Mind the cart, they break.",
    "wander.base.potter.greet_2": "Clay remembers every thumb that shaped it.",
    "wander.base.potter.burnish": "Rub it with a smooth stone before it's fired, and it comes out shining like this.",
    "wander.base.potter.buy": "Four sound pots! Two coins, and I'll sell them on in town.",
    "wander.base.snail_racers.title": "Snail racers",
    "wander.base.snail_racers.greet": "Come and watch! The green one is winning!",
    "wander.base.snail_racers.greet_2": "Rain's the best time for racing. They like it wet.",
    "wander.base.snail_racers.bet": "One coin on the green one? Go on, go on! ...",
    "wander.base.snail_racers.show": "You crouch in the wet grass and cheer them on until the green one crosses the twig. Everybody laughs.",
    "wander.base.henwife.title": "A henwife",
    "wander.base.henwife.greet": "Mind the hens! They'll peck your boots.",
    "wander.base.henwife.greet_2": "Off to market with my girls. Good layers, every one.",
    "wander.base.henwife.hen": "You've a home and a field, I see. Take this one; she's a fine layer. Keep her fed and she'll keep you in eggs.",
    "wander.base.henwife.lay": "Hens lay where it's dark and dry. Give them a quiet corner and look there each morning.",
    "wander.base.henwife.eggs": "Feathers for my pillows! Two eggs for them, fresh this morning.",
    "wander.base.mushroom_pickers.title": "Mushroom pickers",
    "wander.base.mushroom_pickers.greet": "After rain they come up overnight. You have to be quick.",
    "wander.base.mushroom_pickers.greet_2": "Watch where you tread, there's one by your foot.",
    "wander.base.mushroom_pickers.which": "Brown caps are good in a stew. Red with white spots, leave be, whatever anyone tells you.",
    "wander.base.mushroom_pickers.where": "There's a ring of them over that way, under the old trees.",
    "wander.base.mushroom_pickers.basket": "A fine handful! Here, a loaf for them. They'll go in tonight's pot.",
    "wander.base.woodcarver.title": "A woodcarver",
    "wander.base.woodcarver.greet": "Every log has a spoon in it. You just take away what isn't spoon.",
    "wander.base.woodcarver.greet_2": "Mind the shavings. They get everywhere.",
    "wander.base.woodcarver.grain": "See how the grain runs? Cut with it, never across, and the wood does the work for you.",
    "wander.base.woodcarver.finer": "You've a feel for it already. Hold the knife closer to the blade, so, and the cuts come finer.",
    "wander.base.woodcarver.buy": "Good straight logs. A coin for the lot.",
    "wander.base.shearers.title": "Shearers",
    "wander.base.shearers.greet": "From farm to farm all summer, and never a sheep we couldn't catch.",
    "wander.base.shearers.greet_2": "Sharp shears and a steady hand, that's all it takes.",
    "wander.base.shearers.roll": "Lay the fleece out, fold the sides in and roll it from the tail. Tight, so it keeps.",
    "wander.base.shearers.buy": "Six good fleeces. A coin, and we'll take them to the spinners.",
    "wander.base.apprentice.title": "A would-be apprentice",
    "wander.base.apprentice.greet": "Excuse me... are you a master of anything?",
    "wander.base.apprentice.greet_2": "I want to learn a trade. Any trade. Please.",
    "wander.base.apprentice.farming": "Your fields are the talk of the road! Will you show me how? Here, I can pay a coin.",
    "wander.base.apprentice.mining": "They say you know the rock like your own hand. Show me? I've a coin saved.",
    "wander.base.apprentice.crafting": "Did you make all that yourself? Teach me, please. Here, a coin for the lesson.",
    "wander.base.apprentice.someday": "Oh. Well, when you're a master of something, I'll come back.",
    "wander.base.hedge_witch.title": "A hedge witch",
    "wander.base.hedge_witch.greet": "The stones remember. Do you?",
    "wander.base.hedge_witch.greet_2": "Herbs in the day, motes by night. Everything has its hour.",
    "wander.base.hedge_witch.mote": "Three good herbs. Breathe on them, so, and the night gives back a mote. Take it.",
    "wander.base.hedge_witch.air": "Feel the air go thin and cold? That's aether, rising where the moon touches. Learn to feel it.",
    "wander.base.gamekeepers.title": "Gamekeepers",
    "wander.base.gamekeepers.greet": "We're after a poacher. Seen anyone with a sack and a snare?",
    "wander.base.gamekeepers.greet_2": "The deer here belong to the land, not to any one man's pot.",
    "wander.base.gamekeepers.seen": "The hound has his scent. He's that way, not far.",
    "wander.base.gamekeepers.law": "Take what you need and leave the rest to breed. Snare small game, never a doe with young.",
    "wander.base.stragglers.title": "Straggling pilgrims",
    "wander.base.stragglers.greet": "We've fallen behind the shrine. My feet...",
    "wander.base.stragglers.greet_2": "Have you seen the bearers? We can't hear the bell any more.",
    "wander.base.stragglers.which_way": "There, I hear the bell! They went that way. Bless you.",
    "wander.base.stragglers.pray": "Bread for the road. Kneel with us a moment. There. Don't you feel lighter?",
    "wander.base.gossip.title": "A village gossip",
    "wander.base.gossip.greet": "Oh, have you heard? No? Well, I couldn't possibly say...",
    "wander.base.gossip.greet_2": "Nothing happens on these roads that I don't hear about.",
    "wander.base.gossip.news": "For a coin? Well, since you ask. I saw them just this morning...",
    "wander.base.refugee_kin.title": "Refugees' kin",
    "wander.base.refugee_kin.greet": "Are you the one who took them in? We've walked so far to find you.",
    "wander.base.refugee_kin.greet_2": "They speak of you every night.",
    "wander.base.refugee_kin.thanks": "Seed from our old fields, all we could carry. Plant it, and remember us.",
    "wander.base.christening.title": "A christening",
    "wander.base.christening.greet": "You were at our wedding! Look, our little one.",
    "wander.base.christening.greet_2": "We're on our way to have the baby blessed.",
    "wander.base.christening.feast": "Bread for the feast! Stand with us for the blessing. There. A share of it for you too.",
    "wander.base.poachers_gang.title": "The poacher's gang",
    "wander.base.poachers_gang.greet": "Heard you crossed our friend. Keep walking.",
    "wander.base.poachers_gang.greet_2": "Nice night for it. Shame if something happened.",
    "wander.base.poachers_gang.sprung": "That's the one! Get them!",
    "wander.base.poachers_gang.let_go": "All right, all right! Take it, and we never saw each other.",
    "wander.base.grateful_parents.title": "Grateful parents",
    "wander.base.grateful_parents.greet": "It's you! You found our little one!",
    "wander.base.grateful_parents.greet_2": "We asked all along the road until someone knew where you lived.",
    "wander.base.grateful_parents.thanks": "It isn't much, but please. We'd have nothing at all without you.",
    "wander.base.journeyman.title": "A journeyman",
    "wander.base.journeyman.greet": "Remember me? You showed me how, back when I knew nothing.",
    "wander.base.journeyman.greet_2": "I'm a journeyman now. Off to find my own master's work.",
    "wander.base.journeyman.gift": "Here's something I learned on the road, and a coin back for the one you never charged me.",
    "wander.base.highwaymen.title": "Highwaymen",
    "wander.base.highwaymen.greet": "Market day, is it? Lots of full purses on this road.",
    "wander.base.highwaymen.greet_2": "Walking alone? Brave.",
    "wander.base.highwaymen.sprung": "Stand and deliver!",
    "wander.base.highwaymen.purse": "Enough! Here, take the purse, it's not even ours.",
    "wander.base.late_pupil.title": "A late pupil",
    "wander.base.late_pupil.greet": "Have you seen a mage go by? With students? I overslept!",
    "wander.base.late_pupil.greet_2": "They'll have started without me...",
    "wander.base.late_pupil.which_way": "That way? Thank you! If I run I can catch them.",
    "wander.base.late_pupil.lesson": "Bread! I missed breakfast. Here, this is what we learned yesterday: aether pools where water is still.",
    "wander.base.beaters.title": "Beaters",
    "wander.base.beaters.greet": "We beat the brush and the game runs to the hunters.",
    "wander.base.beaters.greet_2": "Loud work, but somebody has to do it.",
    "wander.base.beaters.which_way": "The hunt went that way. Listen, you can hear the hounds.",
    "wander.base.beaters.drive": "Walk in a line, clap and shout, and never get between the game and the bows.",
    "wander.base.rival_pedlar.title": "A rival pedlar",
    "wander.base.rival_pedlar.greet": "Whatever he sold you, I sell for less!",
    "wander.base.rival_pedlar.greet_2": "Him and his dog. Thinks he owns the road.",
    "wander.base.rival_pedlar.bargain": "One coin! A bargain he'd never give you. Go on, check his price.",
    "wander.base.rival_pedlar.sneer": "He went that way, if you want to pay double.",
    "wander.base.fireside_guests.title": "Fireside guests",
    "wander.base.fireside_guests.greet": "We saw your fire and hoped you'd have us. What a homely place!",
    "wander.base.fireside_guests.greet_2": "Sit, sit. Tell us how you came to build all this.",
    "wander.base.fireside_guests.talk": "Talking it all through by a good fire clears the head. You'll see your work better tomorrow.",
    "wander.base.fireside_guests.supper": "That was a fine supper. Take these candles: a home like this deserves more light.",
    "wander.base.beekeeper.title": "Beekeeper",
    "wander.base.beekeeper.greet": "I heard your bees from the road. A good sound, that.",
    "wander.base.beekeeper.greet_2": "Mind the smoke, not the stings. They forgive a calm hand.",
    "wander.base.beekeeper.hives": "A strong colony, and flowers enough for them. Walk with me: your bees have been at the garden already.",
    "wander.base.beekeeper.skep": "Three honey for a skep I coiled on the road. Take a second swarm while the meadows are in flower.",
    "wander.base.hedgehog_lodger.title": "A hedgehog at the door",
    "music.suno": "Suno",
    "music.suno.hint": "Voxmar's own tracks made with Suno, in the menus and the world.",
    "music.lyria": "Lyria",
    "music.lyria.hint": "Voxmar's own tracks generated with Google Lyria, in the menus and the world.",
    "music.elevenlabs": "ElevenLabs",
    "music.elevenlabs.hint": "Voxmar's own tracks made with ElevenLabs: general ones anywhere, others in their biome, and boss fights.",
    "music.home": "Home motif",
    "music.home.hint": "A short calm cue the first time each night you step inside your own lit home.",
    "music.settlement": "Settlement motif",
    "music.settlement.hint": "A short bright cue the first time each day you walk into a village or hamlet.",
    "music.minecraft_menu": "Minecraft menus",
    "music.minecraft_menu.hint": "Title screen music from your Prism Launcher instance, with Minecraft assets on.",
    "music.minecraft_world": "Minecraft world",
    "music.minecraft_world.hint": "Music from your Prism Launcher instance for the world above ground, with Minecraft assets on.",
    "music.minecraft_deep": "Minecraft deep",
    "music.minecraft_deep.hint": "Nether, End and cave music from your Prism Launcher instance, played deep underground.",
    "music.minecraft_records": "Minecraft discs",
    "music.minecraft_records.hint": "Music discs from your Prism Launcher instance, now and then in the world.",
    "music.now_playing": "Now playing: {title} ({category})",
    "music.track.hearth_welcome": "Hearth Welcome",
    "music.track.market_day": "Market Day",
    "music.track.moonlit_quest": "Moonlit Quest",
    "music.track.moonlit_quest_2": "Moonlit Quest 2",
    "music.track.quiet_sky": "Quiet Sky",
    "music.track.skyward_serenity": "Skyward Serenity",
    "music.track.dawn_meadow": "Dawn Meadow",
    "music.track.highland_wind": "Highland Wind",
    "music.track.lantern_village": "Lantern Village",
    "music.track.old_forest": "Old Forest",
    "music.track.rain_on_stone": "Rain on Stone",
