    "effect.base.forest_calm.description": "Among the trees you heal a fifth faster.",
    "effect.base.rich_rock": "Rich rock",
    "effect.base.rich_rock.description": "Mountain rock splits cleanly: you mine a tenth faster.",
    "effect.base.aether_touched": "Aether-touched",
    "effect.base.aether_touched.description": "The aether hums here: every skill learns a twentieth more.",
