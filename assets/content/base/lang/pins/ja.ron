    "creature.base.wild_horse": ("Wild horse", "野生馬"),
    "creature.base.wisp": ("Wisp", "鬼火"),
    "creature.base.wolf": ("Wolf", "オオカミ"),
    "creature.base.woodcutter": ("Woodcutter", "木こり"),
    "effect.base.aether_touched": ("Aether-touched", "エーテルの加護"),
    "effect.base.aether_touched.description": ("The aether hums here: every skill learns a twentieth more.", "ここではエーテルが響く。すべてのスキルの経験が20分の1多い。"),
    "effect.base.cooled": ("Cooled", "涼しさ"),
    "effect.base.cooled.description": ("Something cooling: 8° cooler in the heat.", "体を冷やすもの。暑さの中で8度涼しい。"),
    "effect.base.ember_warmed": ("Ember-warmed", "熾火の温もり"),
    "effect.base.ember_warmed.description": ("Emberfruit glows inside you: 10° warmer.", "熾火の実が内から温める。10度暖かい。"),
    "effect.base.focused": ("Focused", "集中"),
    "effect.base.focused.description": ("A good breakfast: every skill learns a tenth more.", "しっかりした朝ごはん。どのスキルも経験が1割増える。"),
    "effect.base.forest_calm": ("Forest calm", "森の安らぎ"),
    "effect.base.forest_calm.description": ("Among the trees you heal a fifth faster.", "木々の中では、回復が5分の1速い。"),
    "effect.base.hearty": ("Hearty", "滋養"),
    "effect.base.hearty.description": ("Cooked meat: 4 more health while it lasts.", "焼いた肉。続く間、体力の上限が4増える。"),
    "effect.base.hunters_vigour": ("Hunter's vigour", "狩人の活力"),
    "effect.base.hunters_vigour.description": ("Game cooked over a fire: quicker on your feet.", "火で焼いた獲物。足が速くなる。"),
    "effect.base.mired": ("Mired", "ぬかるみ"),
    "effect.base.mired.description": ("Soft wet ground: a little slower going.", "柔らかく湿った地面。少し動きにくい。"),
    "effect.base.queasy": ("Queasy", "吐き気"),
    "effect.base.queasy.description": ("Raw meat: slower to heal and a little slower going. Cook it.", "生の肉。回復が遅く、少し動きにくい。焼こう。"),
    "effect.base.refreshed": ("Refreshed", "爽快"),
    "effect.base.refreshed.description": ("Fresh fruit: a spring in your step.", "新鮮な果物。足取りが軽くなる。"),
    "effect.base.rich_rock": ("Rich rock", "良い岩"),
    "effect.base.rich_rock.description": ("Mountain rock splits cleanly: you mine a tenth faster.", "山の岩はきれいに割れる。採掘が1割速い。"),
    "effect.base.soothed": ("Soothed", "安らぎ"),
    "effect.base.soothed.description": ("Milk: heal half as fast again.", "ミルク。回復が1.5倍速くなる。"),
    "effect.base.sustained": ("Sustained", "腹持ち"),
    "effect.base.sustained.description": ("Bread and roots: you heal by yourself a quarter faster.", "パンや根菜。自然に回復するのが4分の1速くなる。"),
    "effect.base.waterside": ("Waterside", "水辺"),
    "effect.base.waterside.description": ("By the sea, a river or a marsh: casts land a fifth more often.", "海や川や沼のそば。釣り糸が5分の1ほどよくかかる。"),
    "multiblock.base.crucible_kiln": ("Crucible Kiln", "るつぼ窯"),
    "multiblock.base.crucible_kiln.hint": ("The kiln needs kiln bricks all round the crucible and a pillar of kiln bricks on each corner.", "窯には、るつぼを囲む窯レンガと、四隅に窯レンガの柱が必要です。"),
    "multiblock.base.homestead_hearth": ("Homestead Hearth", "開拓の炉"),
    "multiblock.base.homestead_hearth.hint": ("The hearth needs a ring of stone around the hearthstone and a chimney two blocks tall at one corner.", "炉には、炉石を囲む石の輪と、角に2ブロックの高さの煙突が必要です。"),
    "quest.base.a_bed_of_your_own": ("A Bed of Your Own", "自分の寝床"),
    "quest.base.a_bed_of_your_own.why": ("Until you sleep somewhere, death sends you back to world spawn. Wool and hide, pelts, or feathers make a sleeping bag.", "どこかで眠るまで、倒れるとワールドの初期地点に戻される。羊毛と皮、毛皮、羽根で寝袋を作れる。"),
    "quest.base.a_friend_in_the_wild": ("A Friend in the Wild", "野生の友"),
    "quest.base.a_friend_in_the_wild.why": ("A tamed junglefowl lays eggs at home: your first step to a farm, and to pets.", "手なずけたヤケイは家で卵を産む。農場とペットへの第一歩。"),
    "quest.base.bare_hands": ("First Catch", "初めての釣果"),
    "quest.base.bare_hands.why": ("Fish are the easiest food near water, and heal well once cooked.", "魚は水辺でいちばん手軽な食べ物で、焼けばよく回復する。"),
    "quest.base.charcoal": ("Charcoal", "木炭"),
    "quest.base.charcoal.why": ("Fuel before metal: coal or charcoal smelts copper and makes torches. Burn logs down in a campfire, or dig out a coal seam.", "金属の前に燃料を。石炭か木炭で銅を製錬でき、松明も作れる。焚き火で原木を燃やすか、石炭の鉱脈を掘ろう。"),
    "quest.base.crafting_table": ("Crafting Table", "作業台"),
    "quest.base.crafting_table.why": ("Its three-by-three grid makes every tool and weapon.", "3×3の枠であらゆる道具と武器を作れる。"),
    "quest.base.crucible_kiln": ("Crucible Kiln", "るつぼ窯"),
    "quest.base.crucible_kiln.why": ("Bronze needs heat a campfire can't reach. Lighting the kiln starts the Bronze age.", "青銅には焚き火では届かない熱がいる。窯に火を入れると青銅の時代が始まる。"),
    "quest.base.first_bronze": ("First Bronze", "初めての青銅"),
    "quest.base.first_bronze.why": ("Three copper to one tin, smelted in the kiln: the metal of the next age.", "銅三に錫一、窯で溶かす：次の時代の金属。"),
    "quest.base.first_night": ("First Night", "最初の夜"),
    "quest.base.first_night.why": ("Night comes fast. Cooked food heals far more than raw, and a fire keeps the cold off.", "夜はすぐに来る。焼いた食べ物は生よりずっと回復し、火は寒さを防ぐ。"),
    "quest.base.first_ore": ("Red Metal Underfoot", "足元の赤い金属"),
    "quest.base.first_ore.why": ("Copper is the first ore your stone pickaxe can take, and the start of every metal.", "銅は石のつるはしで掘れる最初の鉱石で、あらゆる金属の始まり。"),
    "quest.base.homestead_hearth": ("Homestead Hearth", "開拓の炉"),
    "quest.base.homestead_hearth.why": ("Your home: you wake here after dying, and the Farm age opens. A hearthstone in a ring of stone, with a chimney at a corner.", "あなたの家：倒れてもここで目覚め、農耕の時代が開く。石の輪の中の炉石と、角の煙突。"),
    "quest.base.pockets": ("Pockets", "ポケット"),
    "quest.base.pockets.why": ("Herbs and seeds eat slots; a pouch holds a thousand of a kind in one.", "薬草や種は枠を取る。袋なら一種類千個を一つの枠に。"),
    "quest.base.red_metal": ("Red Metal", "赤い金属"),
    "quest.base.red_metal.why": ("Copper tools are faster and find more, and copper is three parts of bronze.", "銅の道具は速く、多く見つけ、銅は青銅の四分の三を占める。"),
    "quest.base.stone_in_hand": ("Stone in Hand", "石の道具"),
    "quest.base.stone_in_hand.why": ("Bare hands are slow. Stone tools mine twice as fast and reach coal for torches.", "素手は遅い。石の道具は2倍速く掘れ、松明用の石炭にも届く。"),
    "quest.base.the_potter": ("The Potter", "陶工"),
    "quest.base.the_potter.why": ("Pots and vials hold potions and stews, and fired clay lines the kiln you are working toward.", "壺や小瓶は薬やシチューを入れ、焼いた粘土は目指す窯の内張りになる。"),
    "quest.base.torchlight": ("Torchlight", "たいまつの灯り"),
    "quest.base.torchlight.why": ("Light keeps monsters off and lets you work at night.", "灯りは魔物を遠ざけ、夜も働ける。"),
    "quest.base.twine_and_thong": ("Twine and Thong", "より糸"),
    "quest.base.twine_and_thong.why": ("Twine goes into rod lines, pouches, snares and bows.", "より糸は釣り糸、袋、罠、弓になる。"),
    "quest.base.where_to_settle": ("Where to Settle", "住む場所"),
    "quest.base.where_to_settle.why": ("Biomes help different work: the woods heal, the water fishes, the mountains mine. Where you build decides what your home gives.", "バイオームごとに得意な仕事がある。森は癒し、水辺は釣れ、山は掘れる。どこに建てるかで家の恵みが決まる。"),
    "multiblock.base.bellows_bloomery": ("Bellows Bloomery", "ふいご付き塊鉄炉"),
    "multiblock.base.bellows_bloomery.hint": ("The bloomery needs kiln bricks round it with bellows in the ring, and a hollow shaft of kiln bricks two more blocks high above it.", "塊鉄炉には、ふいごを含む窯レンガの囲いと、その上に2ブロック高い窯レンガの中空の煙突が必要です。"),
    "multiblock.base.coke_oven": ("Coke Oven", "コークス炉"),
    "multiblock.base.coke_oven.hint": ("The coke oven needs a chamber of kiln bricks three on a side round a hollow middle, with the oven in the middle of one side.", "コークス炉には、中が空洞の一辺3ブロックの窯レンガの部屋が必要で、炉は一面の真ん中に置きます。"),
    "multiblock.base.blast_furnace": ("Blast Furnace", "高炉"),
    "multiblock.base.blast_furnace.hint": ("The blast furnace needs kiln bricks round it with bellows in the ring, and a hollow shaft of kiln bricks three more blocks high above it.", "高炉には、ふいごを含む窯レンガの囲いと、その上に3ブロック高い窯レンガの中空の煙突が必要です。"),
}
