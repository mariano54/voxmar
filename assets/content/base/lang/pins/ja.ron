    "creature.base.trader": ("Trader", "商人"),
    "creature.base.villager": ("Villager", "村人"),
    "creature.base.wild_boar": ("Wild boar", "イノシシ"),
    "creature.base.wild_horse": ("Wild horse", "野生馬"),
    "creature.base.wisp": ("Wisp", "鬼火"),
    "creature.base.wolf": ("Wolf", "オオカミ"),
    "creature.base.woodcutter": ("Woodcutter", "木こり"),
    "effect.base.aether_touched": ("Aether-touched", "エーテルの加護"),
    "effect.base.aether_touched.description": ("The aether hums here: every skill learns a twentieth more.", "ここではエーテルが響く。すべてのスキルの経験が20分の1多い。"),
    "effect.base.cooled": ("Cooled", "涼しさ"),
    "effect.base.cooled.description": ("Something cooling: 8° cooler in the heat.", "体を冷やすもの。暑さの中で8度涼しい。"),
    "effect.base.ember_warmed": ("Ember-warmed", "熾火の温もり"),
    "effect.base.ember_warmed.description": ("Emberfruit glows inside you: 10° warmer.", "熾火の実が内から温める。10度暖かい。"),
    "effect.base.focused": ("Focused", "集中"),
    "effect.base.focused.description": ("A good breakfast: every skill learns a tenth more.", "しっかりした朝ごはん。どのスキルも経験が1割増える。"),
    "effect.base.forest_calm": ("Forest calm", "森の安らぎ"),
    "effect.base.forest_calm.description": ("Among the trees you heal a fifth faster.", "木々の中では、回復が5分の1速い。"),
    "effect.base.hearty": ("Hearty", "滋養"),
    "effect.base.hearty.description": ("Cooked meat: room for a tenth more health while it lasts.", "焼いた肉。続く間、体力の上限が一割増える。"),
    "effect.base.warm_meal": ("Warm meal", "温かい食事"),
    "effect.base.warm_meal.description": ("A hot stew from the pot: 4° warmer, and you heal a tenth faster.", "鍋の温かいシチュー。4°暖かく、回復が1割速い。"),
    "effect.base.hunters_vigour": ("Hunter's vigour", "狩人の活力"),
    "effect.base.hunters_vigour.description": ("Game cooked over a fire: quicker on your feet.", "火で焼いた獲物。足が速くなる。"),
    "effect.base.mired": ("Mired", "ぬかるみ"),
    "effect.base.mired.description": ("Soft wet ground: a little slower going.", "柔らかく湿った地面。少し動きにくい。"),
    "effect.base.keen_edge": ("Keen edge", "研ぎ澄まし"),
    "effect.base.keen_edge.description": ("A travelling smith whetted your tools: they bite a tenth faster.", "旅の鍛冶屋が道具を研いでくれた。一割速く刃が通る。"),
    "effect.base.camp": ("Camp", "野営地"),
    "effect.base.camp.description": ("Your own bed and light: you heal a fifth faster here.", "自分の寝床と明かり。ここでは回復が2割速い。"),
    "effect.base.camp.next": ("Next: build a Homestead Hearth near your bed and light it.", "次は：寝床のそばに家の炉を作って火を灯そう。"),
    "effect.base.hearthside": ("Hearthside", "炉辺"),
    "effect.base.hearthside.description": ("Your hearth keeps the cold off: you heal a third faster here.", "炉が寒さを防ぐ。ここでは回復が3分の1速い。"),
    "effect.base.hearthside.next": ("Next: wall it in and roof it over, even with hide or wattle, with your bed and two lights, to be snug.", "次は：壁で囲み（皮や編み垣でもよい）屋根をかけ、寝床と明かりを2つ置けば居心地がよくなる。"),
    "effect.base.snug": ("Snug", "居心地"),
    "effect.base.snug.description": ("Walled in and roofed over: you heal half as fast again here.", "壁に囲まれ屋根の下。ここでは回復が5割速い。"),
    "effect.base.snug.next": ("Next: sound walls (logs, planks or stone) for most of the room, two seats, a table, two places to store things and a third light make it homely.", "次は：部屋の大半をしっかりした壁（丸太・板・石）にし、椅子2つ、机、収納2つ、3つ目の明かりで我が家になる。"),
    "effect.base.homely": ("Homely", "我が家"),
    "effect.base.homely.description": ("Sound walls, and room to sit, work and store: 2° warmer, and you learn a twentieth more here, and your stores here hold twice as much.", "しっかりした壁と、座り、働き、しまう場所。2°暖かく、ここでは経験が20分の1多く、ここの収納は2倍入る。"),
    "effect.base.homely.next": ("Next: sound walls nearly all about, two rugs, two curtains, a cushion, three pieces of crockery and a fourth light make it cosy.", "次は：ほぼ全体をしっかりした壁で囲み、敷物2つ、カーテン2つ、クッション、食器3つ、4つ目の明かりでくつろげる家になる。"),
    "effect.base.cosy": ("Cosy", "くつろぎ"),
    "effect.base.cosy.description": ("Soft, bright and close walled: 3° warmer, you heal faster and learn a tenth more here, and your stores here hold twice as much.", "柔らかく明るく、すきまのない壁。3°暖かく、ここでは回復が速く、経験が1割多く、ここの収納は2倍入る。"),
    "effect.base.cosy.next": ("Next: fine walls (dressed stone, brick or glass) for half the room, a bookshelf, a stove or cauldron, a loom, spindle or quern, and a banner make it the heart of the home.", "次は：部屋の半分を上等な壁（切り石・れんが・ガラス）にし、本棚、かまどか鍋、織機・紡ぎ台・石臼のどれか、旗で団らんの家になる。"),
    "effect.base.heart_of_the_home": ("Heart of the Home", "団らんの家"),
    "effect.base.heart_of_the_home.description": ("Everything a home needs, finely walled: 4° warmer, heal twice as fast, learn an eighth more, and your stores here hold three times as much.", "家に必要なものがそろい、壁も上等。4°暖かく、回復が2倍速く、経験が8分の1多く、ここの収納は3倍入る。"),
    "effect.base.workbench": ("Workbench", "作業台"),
    "effect.base.workbench.description": ("A bench to work at: you craft and build as if a level higher here.", "作業台がある。ここでは製作と建築の腕が1段上のように働く。"),
    "effect.base.workbench.next": ("Next: a loom, spindle stand or quern, a light, and two places to store things under a roof make it a workshop.", "次は：屋根の下に織機・紡ぎ台・石臼のどれか、明かり、収納2つを置けば工房になる。"),
    "effect.base.workshop": ("Workshop", "工房"),
    "effect.base.workshop.description": ("Everything to hand: you craft and build as if two levels higher here.", "道具がそろっている。ここでは製作と建築の腕が2段上のように働く。"),
    "effect.base.pantry": ("Pantry", "食料庫"),
    "effect.base.pantry.description": ("A full pantry by the fire: the good a meal does lasts a quarter longer.", "暖かい炉のそばの食料庫。食事の良い効果が4分の1長く続く。"),
    "effect.base.pantry.next": ("Next: four places to store things, a stove or cauldron and a table under a roof make it a larder.", "次は：屋根の下に収納4つ、かまどか鍋、机を置けば貯蔵庫になる。"),
    "effect.base.larder": ("Larder", "貯蔵庫"),
    "effect.base.larder.description": ("Meals heal a fifth more here and their good lasts half again as long.", "食事の回復が2割増え、良い効果が5割長く続く。"),
    "effect.base.sheltered": ("Sheltered", "雨宿り"),
    "effect.base.sheltered.description": ("Warm and dry while it storms: you heal a fifth faster, learn a bit more.", "外が荒れていても暖かく乾いている。回復が2割早まり、学びが20分の1増える。"),
    "effect.base.company": ("Company", "にぎやかな家"),
    "effect.base.company.description": ("Your animals about the house: you heal a tenth faster here.", "飼っている動物が家のそばにいる。ここでは回復が1割早まる。"),
    "effect.base.company.next": ("Next: four animals kept about the house make it a full house.", "次は：家のそばで動物を4頭飼えば賑やかな我が家になる。"),
    "effect.base.full_house": ("Full house", "我が家は大賑わい"),
    "effect.base.full_house.description": ("A yard full of animals: you heal a fifth faster, learn a bit more here.", "庭は動物でいっぱい。ここでは回復が2割早まり、学びが20分の1増える。"),
    "effect.base.door_shut": ("Door shut", "戸締まり"),
    "effect.base.door_shut.description": ("The door shut on the night: you heal a tenth faster here, and are 1° warmer.", "夜に戸を閉めた。ここでは回復が1割速く、1°暖かい。"),
    "effect.base.evening_in": ("Evening in", "夜の団らん"),
    "effect.base.evening_in.description": ("Home by the fire after dark: you heal a fifth faster here, and are 2° warmer.", "日が暮れて、家の火のそばにいる。ここでは回復が2割速く、2°暖かい。"),
    "effect.base.kitchen_garden": ("Kitchen garden", "家庭菜園"),
    "effect.base.kitchen_garden.description": ("Greens growing by the door: meals heal a tenth more here.", "戸口で育つ青物。ここでは食事の回復が1割増える。"),
    "effect.base.banked_fire": ("Banked fire", "種火"),
    "effect.base.banked_fire.description": ("A camp taught you to bank a fire: at home with a fire lit, 3° warmer.", "野営で火の守り方を覚えた。家で火が灯っていると、体感が3度暖かい。"),
    "effect.base.snowed_in": ("Snowed in", "雪ごもり"),
    "effect.base.snowed_in.description": ("Snug for winter: snow or hail outside, you heal and learn more at home.", "冬支度は万全。外が雪や雹のとき、家では回復も学びも増える。"),
    "effect.base.everything_in_its_place": ("Everything in its place", "整理整頓"),
    "effect.base.everything_in_its_place.description": ("A homely home: with room to store things, you build a level higher at home.", "居心地のいい家。しまう場所があれば、家での建築が1レベル高くなる。"),
    "effect.base.home_cooking": ("Home cooking", "おふくろの味"),
    "effect.base.home_cooking.description": ("Stove and quern learnt: meals at home heal a tenth more and last longer.", "かまどと石臼を覚えた。家での食事は回復が1割増え、効果も長持ちする。"),
    "effect.base.studious": ("Studious", "勉強家"),
    "effect.base.studious.description": ("Books on the shelf: indoors at home you learn a twentieth more.", "本棚の本。家の中では学びが20分の1増える。"),
    "effect.base.hearthkeeper": ("Hearthkeeper", "炉の番人"),
    "effect.base.hearthkeeper.description": ("Your own hearth is the best bench: craft and cook as if a level higher at home.", "自分の炉は最高の作業台。家での工作と料理が1レベル高くなる。"),
    "effect.base.healing_sleep": ("Healing Sleep", "癒やしの眠り"),
    "effect.base.healing_sleep.description": ("You slept: your wounds close quickly for a little while.", "眠って、しばらくの間、傷が早くふさがる。"),
    "effect.base.rested": ("Rested", "休息"),
    "effect.base.rested.description": ("You slept: you heal and learn a little more for a while.", "眠った。しばらくの間、回復と経験が少し増える。"),
    "effect.base.well_rested": ("Well rested", "ぐっすり"),
    "effect.base.well_rested.description": ("A night slept snug, in a proper bed, or with a lit corner by the bed: you learn more and mine faster for a while.", "居心地のよい家か、ちゃんとした寝台か、明かりの灯る枕辺で一夜を眠った。しばらくの間、経験が増え、採掘が速い。"),
    "effect.base.deep_rest": ("Deep rest", "深い眠り"),
    "effect.base.deep_rest.description": ("A night slept in a cosy home: you heal, learn, mine and walk faster for a while.", "くつろげる家で一夜を眠った。しばらくの間、回復・経験・採掘・歩みが速い。"),
    "effect.base.steady_hands": ("Steady hands", "安定した手"),
    "effect.base.steady_hands.description": ("A stone tool in your fist: every tool bites a tenth faster.", "石の道具を握った。どの道具も1割速く効く。"),
    "effect.base.steady_hands.next": ("Next: carry a full stone kit (pickaxe, axe, shovel, hoe and knife).", "次は：石の道具一式（ツルハシ、斧、シャベル、鍬、ナイフ）を揃えよう。"),
    "effect.base.practised_hands": ("Practised hands", "慣れた手"),
    "effect.base.practised_hands.description": ("A whole kit and the habit of it: a fifth faster, and now and then an extra piece turns up.", "道具一式と慣れ。2割速くなり、時々おまけが見つかる。"),
    "effect.base.practised_hands.next": ("Next: forge a copper kit (axe, shovel, hoe and knife) from red metal.", "次は：赤い金属で銅の道具（斧、シャベル、鍬、ナイフ）を作ろう。"),
    "effect.base.copper_hands": ("Copper hands", "銅の手"),
    "effect.base.copper_hands.description": ("Copper in every grip: nearly a third faster, and extras turn up twice as often.", "どの握りにも銅がある。3割近く速く、おまけが倍の頻度で見つかる。"),
    "effect.base.stonewise": ("Stonewise", "石を知る者"),
    "effect.base.stonewise.description": ("A hand that knows stone reads mountain rock: it splits to give more.", "石を知る手は山の岩を読む。割ると多く採れる。"),
    "effect.base.anglers_knack": ("Angler's knack", "釣り人の勘"),
    "effect.base.anglers_knack.description": ("A supper caught and cooked: you read the water, and casts land a tenth more often.", "釣って料理した夕食。水を読めて、投げ込みが1割多く当たる。"),
    "effect.base.deft_angler": ("Deft angler", "手際のよい釣り人"),
    "effect.base.deft_angler.description": ("Patience paid off: casts land a fifth more often.", "辛抱が実った。投げ込みが2割多く当たる。"),
    "effect.base.prospector": ("Prospector", "探鉱者"),
    "effect.base.prospector.description": ("A good run of ore taught you where it lies: a twentieth faster, and extras turn up more.", "鉱石をたくさん掘って、ありかが分かってきた。5%速くなり、おまけも見つかりやすい。"),
    "effect.base.settled_and_fed": ("Settled and fed", "満ち足りた暮らし"),
    "effect.base.settled_and_fed.description": ("Your animals thrive and your table is set: at home you heal a tenth faster.", "動物は元気で、食卓も整った。家にいると回復が1割速い。"),
    "effect.base.queasy": ("Queasy", "吐き気"),
    "effect.base.queasy.description": ("Raw meat: slower to heal and a little slower going. Cook it.", "生の肉。回復が遅く、少し動きにくい。焼こう。"),
    "effect.base.refreshed": ("Refreshed", "爽快"),
    "effect.base.refreshed.description": ("Fresh fruit: a spring in your step.", "新鮮な果物。足取りが軽くなる。"),
    "effect.base.rich_rock": ("Rich rock", "良い岩"),
    "effect.base.rich_rock.description": ("Mountain rock splits cleanly: you mine a tenth faster.", "山の岩はきれいに割れる。採掘が1割速い。"),
    "effect.base.soothed": ("Soothed", "安らぎ"),
    "effect.base.soothed.description": ("Milk: heal half as fast again.", "ミルク。回復が1.5倍速くなる。"),
    "effect.base.sustained": ("Sustained", "腹持ち"),
    "effect.base.sustained.description": ("Bread and roots: you heal by yourself a quarter faster.", "パンや根菜。自然に回復するのが4分の1速くなる。"),
    "effect.base.waterside": ("Waterside", "水辺"),
    "effect.base.waterside.description": ("By the sea, a river or a marsh: casts land a fifth more often.", "海や川や沼のそば。釣り糸が5分の1ほどよくかかる。"),
    "multiblock.base.crucible_kiln": ("Crucible Kiln", "るつぼ窯"),
    "multiblock.base.crucible_kiln.hint": ("The kiln needs tempered kiln bricks all round the crucible and a pillar of them on each corner. Tempered bricks take straw from a grain harvest.", "窯には、るつぼを囲むわら入り窯レンガと、四隅にその柱が必要です。わら入りのレンガには、穀物を収穫したときのわらが要ります。"),
    "multiblock.base.charcoal_clamp": ("Charcoal Clamp", "炭窯"),
    "multiblock.base.charcoal_clamp.hint": ("A clamp is nine firewood laid three by three on the ground, walled round and roofed over with earth, with kindling in place of the roof's middle earth for a flue. Light the kindling from a torch, a firebrand or a campfire.", "炭窯は、薪を地面に3×3で9本並べ、まわりを土で囲んで上も土でふさぎ、屋根の真ん中の土を焚きつけに置きかえて煙道にしたもの。松明か火のついた棒か焚き火で焚きつけに火をつける。"),
    "multiblock.base.homestead_hearth": ("Homestead Hearth", "開拓の炉"),
    "multiblock.base.homestead_hearth.hint": ("The hearth needs a ring of stone around the hearthstone and a chimney two blocks tall at one corner.", "炉には、炉石を囲む石の輪と、角に2ブロックの高さの煙突が必要です。"),
    "quest.base.a_bed_of_your_own": ("A Bed of Your Own", "自分の寝床"),
    "quest.base.a_bed_of_your_own.why": ("Until you sleep somewhere, death sends you back to world spawn. Two feathers and two hides make a sleeping bag, no table needed; wool and hide, or pelts, make one at Crafting 5. Junglefowl on warm grassland drop feathers, and rabbits in the grass drop hides. Set the bag down where you mean to stay and right-click it: you wake there after dying.", "どこかで眠るまで、倒れるとワールドの初期地点に戻される。羽根2枚と皮2枚で寝袋を作れる（作業台は要らない）。羊毛と皮、または毛皮なら製作5で作れる。羽根は暖かい草地のヤケイが、皮は草地のウサギが落とす。住むつもりの場所に寝袋を置いて右クリックすれば、倒れてもそこで目覚める。"),
    "quest.base.a_friend_in_the_wild": ("A Friend in the Wild", "野生の友"),
    "quest.base.a_friend_in_the_wild.why": ("Hold wheat seeds (break wild wheat for them; or, for a rabbit, a wild carrot: a white-flowered plant of meadows and plains, picked by hand), walk up slowly without sprinting or hitting, and right-click a junglefowl. Junglefowl keep to warm grassland and jungle; rabbits to grassland and heath. A tamed hen lays eggs at home: your first step to a farm, and to pets.", "小麦の種（野生の小麦を壊すと手に入る。ウサギなら野生のニンジン。草原や平原に咲く白い花の草で、手で摘める）を持ち、走らず殴らずにそっと近づいて、ヤケイを右クリックしよう。ヤケイは暖かい草地やジャングルに、ウサギは草地やヒースにいる。手なずけた雌鶏は家で卵を産む。農場とペットへの第一歩だ。"),
    "quest.base.a_tempting_bite": ("A Tempting Bite", "好物でおびき寄せる"),
    "quest.base.a_tempting_bite.why": ("Rabbits bolt and junglefowl scatter, but each comes to a favourite food: a carrot for rabbits (pick a wild carrot by hand, a white-flowered plant of meadows), wheat seeds or wheat for junglefowl (break wild wheat). Hold it and walk slowly, and they come up to you instead of running; switch to your axe once one is close. Draw an animal to you with its favourite food.", "ウサギは跳ねて逃げ、ヤケイは散ってしまうが、どちらも好物には寄ってくる。ウサギにはニンジン（草原に白い花を咲かせる野生のニンジンを手で摘む）、ヤケイには小麦の種か小麦（野生の小麦を壊すと手に入る）。それを持ってゆっくり歩けば、逃げずにこちらへ寄ってくる。近くまで来たら斧に持ち替えよう。好物で動物を1匹おびき寄せよう。"),
    "quest.base.bare_hands": ("First Catch", "初めての釣果"),
    "quest.base.bare_hands.why": ("Fish are the easiest food near water. Hold your rod, right-click water and wait for a bite: minnows come first. Land five; cooked fish heal well.", "魚は水辺でいちばん手軽な食べ物だ。釣り竿を持って水を右クリックし、食いつくのを待とう。最初に掛かるのはミノーだ。5匹釣り上げよう。焼いた魚はよく回復する。"),
    "quest.base.charcoal": ("Charcoal", "木炭"),
    "quest.base.charcoal.why": ("Fuel before metal: coal or charcoal smelts copper and makes torches, and only they burn hot enough for the Crucible Kiln. Charcoal comes from a clamp. Set down a chopping block (a flint over a log, Crafting 2), then hold a log and right-click it with an axe in your pack: two firewood. Lay nine firewood three by three on the ground, wall them round and roof them over with earth, and put kindling (three sticks) on the roof's middle for a flue. Light the kindling from a torch: two hours on, nobody by it, the clamp leaves thirty-six charcoal. Rain down the open flue spoils some to ash, so roof it over. Or dig out a coal seam: a small black-flecked stone on the ground marks one below. Set down a chopping block, light a clamp and have sixteen charcoal, or mine twenty-four coal.", "金属の前に燃料を。石炭か木炭で銅を製錬でき、松明も作れる。るつぼ窯を焚けるほど熱く燃えるのもこの二つだけだ。木炭は炭窯で作る。薪割り台（原木の上に火打ち石、工作2）を置き、斧を荷物に入れたまま、原木を持って右クリックすると薪が2本とれる。薪9本を地面に3×3で並べ、まわりを土で囲んで上も土でふさぎ、屋根の真ん中に焚きつけ（棒3本）を置いて煙道にする。焚きつけに松明で火をつければ、2時間後、そばにいなくても木炭36個が残る。開いた煙道に雨が降り込むと一部が灰になるので、屋根をかけておこう。あるいは石炭の層を掘ろう。地面に転がる黒い粒の混じった小石が、その真下にある印だ。薪割り台を置いて炭窯に火を入れ、木炭を16個持つか、石炭を24個掘ること。"),
    "quest.base.fuel_to_hand": ("Fuel to Hand", "燃料の備え"),
    "quest.base.fuel_to_hand.why": ("Every fire of this age eats fuel: the kilns, the clamps, the copper and at last the Crucible Kiln's charge. Take either way. Fell trees and carry thirty-two logs, to char later; or dig to a coal seam (a small black-flecked stone lying on the ground marks one below) and mine twelve coal ore. Both ways go on to Charcoal.", "この時代の火はどれも燃料を食う。窯も伏せ窯も、銅も、最後にはるつぼ窯の燃料も。どちらの道でもよい。木を伐って、あとで炭にする丸太を32本持つか、石炭の層まで掘って（地面に転がる黒い粒の混じった小石が、その真下にある印）石炭鉱石を12個掘ろう。どちらの道も「木炭」に続く。"),
    "quest.base.kiln_plans": ("Plans for the Kiln", "窯の段取り"),
    "quest.base.kiln_plans.why": ("With fuel in hand, charcoal or coal, plan the kiln it burns in: open the recipe viewer and look up the crucible, seven kiln bricks round a clay pot, then look up tempered kiln bricks, the straw-bound bricks its ring is built of, to see what they take.", "炭か石炭の燃料がそろったら、それを焚く窯の段取りを立てよう。レシピビューアでるつぼを調べると、壺を7個の窯レンガが囲んでいる。続けて、窯の囲いになるわら入り窯レンガを調べ、材料を確かめよう。"),
    "quest.base.a_woodpile": ("A Woodpile", "薪の山"),
    "quest.base.a_woodpile.why": ("Logs stacked by the door keep dry and to hand. Three logs of one wood and two sticks make a woodpile (Construction 1), the logs held between two stakes. Set one down by your hearth, under your roof: with a settle beside it, that is a hearth corner, and the room is a little warmer for it.", "戸口のそばに積んだ丸太は乾いたまま手元に置ける。同じ木の丸太3本と棒2本で薪の山ができる（建築1）。2本の杭のあいだに丸太を積んだものだ。屋根の下、炉のそばに置こう。隣に背もたれ長椅子があれば炉の隅になり、部屋が少し暖かくなる。"),
    "quest.base.opened_too_soon": ("Opened Too Soon", "早すぎた窯開け"),
    "quest.base.opened_too_soon.why": ("A clamp opened before its two hours are up gives part-burnt wood, not charcoal: still fuel for a campfire or a hearth. Charcoal tells how to build a clamp; break into one early, while it smoulders, and keep four part-burnt wood.", "2時間たつ前に開けた炭窯からは、木炭ではなく焼けかけの木が出る。それでも焚き火や炉の燃料にはなる。炭窯の作り方は「木炭」のクエストにある。くすぶっているうちに早めに崩して、焼けかけの木を4つ持とう。"),
    "quest.base.the_kiln_charge": ("A Full Charge", "窯一杯の燃料"),
    "quest.base.the_kiln_charge.why": ("The Crucible Kiln burns a whole charge when it is lit: thirty-two charcoal, or twenty-four coal ore. Keep a clamp charring logs while you fire clay, or bring coal up from the seam, and hold a full charge in your pack.", "るつぼ窯は火を入れるとき、燃料をひと揃いまるごと燃やす。木炭32個か、石炭鉱石24個だ。粘土を焼くあいだも炭窯で丸太を炭にし続けるか、石炭の層から石炭を運び上げ、ひと揃いを袋に持とう。"),
    "quest.base.a_clay_store": ("Clay in Store", "粘土の蓄え"),
    "quest.base.a_clay_store.why": ("Digging clay a trip at a time keeps the kilns waiting. Keep a store by the pit kiln: put thirty-two clay into a chest, a barrel or a crate and leave it there. Clay keeps for ever, and the next load is a step away.", "一往復ずつ粘土を掘っていては、窯が待ちぼうけになる。野窯のそばに蓄えを置こう。チェストか樽か木箱に粘土を32個入れて、そのままにしておく。粘土はいつまでも傷まず、次の窯の分がすぐ手元にある。"),
    "quest.base.first_bricks": ("First Bricks", "最初のレンガ"),
    "quest.base.first_bricks.why": ("Kiln bricks are fired clay pressed hard: four fired clay in the crafting grid make two (Crafting 5). Shape four, and keep sixteen more fired clay in your pack for the rest. The kiln wants nineteen bricks in all: twelve tempered for the ring, seven plain for the crucible.", "窯レンガは焼き粘土を固く押し固めたものだ。作業枠で焼き粘土4個から2個できる（工作レベル5）。4個作り、残りのために焼き粘土をあと16個袋に持っておこう。窯には合わせて19個のレンガが要る。囲いにわら入りを12個、るつぼに普通のものを7個だ。"),
    "quest.base.the_kiln_ring": ("The Kiln Ring", "窯の囲い"),
    "quest.base.the_kiln_ring.why": ("Choose the kiln's ground, flat and clear, near your pit kiln. Lay eight tempered kiln bricks in a ring round an empty middle, where the crucible will sit, and stand one more on each corner of the ring: twelve tempered bricks set down.", "野窯の近くに、平らで開けた窯の場所を選ぼう。るつぼが入る真ん中を空けてわら入り窯レンガ8個を輪に並べ、輪の四隅の上にさらに1個ずつ立てる。置くわら入りレンガは12個だ。"),
    "quest.base.crafting_table": ("Crafting Table", "作業台"),
    "quest.base.crafting_table.why": ("Four planks in the 2×2 grid of your inventory make a crafting table: a log splits into four planks there. Hold it and right-click the ground to set it down, then right-click the table; its three-by-three grid makes every tool and weapon.", "持ち物の2×2の枠に板材を4枚置くと作業台ができる。原木1本はそこで板材4枚に割れる。手に持って地面を右クリックして置き、作業台を右クリックしよう。3×3の枠であらゆる道具と武器を作れる。"),
    "quest.base.an_axe_to_it": ("An Axe to It", "斧を入れる"),
    "quest.base.an_axe_to_it.why": ("A spare axe: two flint over a stick in the 2×2 grid make another flint axe, so one lost to a fall or a fight never leaves you unable to fell a tree. Make it and chop eight logs; the campfire, planks and sticks ahead all want them. A stone axe, hafted from heads ground at a grindstone, chops twice as fast.", "予備の斧を作っておこう。2×2の作業枠で火打ち石2個の下に棒1本を置けば、もう1本の火打ち石の斧ができる。斧をなくしても木を切れなくなることはない。斧を作って原木を8個切ろう。この先の焚き火や板材や棒に使う。砥石車で研いだ石の刃から作る石の斧なら2倍速く切れる。"),
    "quest.base.a_chopping_block": ("A Chopping Block", "薪割り台"),
    "quest.base.a_chopping_block.why": ("Splitting logs in the grid wastes wood. A chopping block is a flint over a log (Crafting 2): dig gravel, by hand or with a shovel, and about one in eight gives a flint; it lies on stony slopes, game trails and dry stream beds. Set the block down and split logs within reach of it: each gives six planks there, two more than the grid's four. Split two logs by it.", "作業枠で丸太を割ると木がむだになる。薪割り台は丸太の上に火打ち石を置いて作る（工作2）。砂利を素手かシャベルで掘れば、8回に1回ほど火打ち石が出る。砂利は石の多い斜面や獣道、かれた川床にある。台を置き、手の届くところで丸太を割れば、1本から板材が6枚とれる。作業枠より2枚多い。台のそばで丸太を2本割ろう。"),
    "quest.base.crucible_kiln": ("Crucible Kiln", "るつぼ窯"),
    "quest.base.crucible_kiln.why": ("Bronze needs heat a campfire can't reach. With the crucible in the middle of its ring and a brick on each corner, right-click the crucible to check the kiln stands (it names the fuel it wants); then hold the full charge, thirty-two charcoal or twenty-four coal ore, and right-click it again. Lighting the kiln opens the way to the Bronze age.", "青銅には焚き火では届かない熱がいる。るつぼを輪の真ん中に置き、四隅にレンガが立っていれば、るつぼを右クリックして窯が組み上がったか確かめる（必要な燃料を教えてくれる）。それから燃料ひと揃い、木炭32個か石炭鉱石24個を持って、もう一度右クリック。窯に火を入れれば青銅の時代への道が開ける。"),
    "quest.base.first_bronze": ("First Bronze", "初めての青銅"),
    "quest.base.first_bronze.why": ("Hold three copper ingots, with a tin ore in your pack, and right-click the crucible of your lit kiln: they melt into four bronze ingots, the metal of the next age (Engineering 12). Smelt four.", "銅のインゴットを3個持ち、スズ鉱石を1個持ち物に入れて、火の入った窯のるつぼを右クリックしよう。溶けて青銅のインゴット4個になる。次の時代の金属だ（工学レベル12）。4個作ろう。"),
    "quest.base.the_bronze_age": ("The Bronze Age", "青銅の時代"),
    "quest.base.the_bronze_age.why": ("The Bronze age opens once the Farm age is behind you: thirty quests of this age done, four of them path capstones, marked gold at their corner, and the crucible kiln lit.", "農耕の時代を越えれば青銅の時代が開く。この時代のクエストを30個達成し、そのうち4つが道の締めくくり（本で角が金色のクエスト）であること。そして、るつぼ窯に火が入っていること。"),
    "quest.path.farm.combat": ("Combat", "戦い"),
    "quest.path.farm.cooking": ("Kitchen", "台所"),
    "quest.path.farm.crafting": ("Crafting", "工作"),
    "quest.path.farm.explore": ("The Road", "旅路"),
    "quest.path.farm.farming": ("Fields", "畑"),
    "quest.path.farm.fishing": ("Fishing", "釣り"),
    "quest.path.farm.home": ("Home", "住まい"),
    "quest.path.farm.rooms": ("Rooms", "部屋"),
    "quest.path.farm.callers": ("Callers", "客人"),
    "quest.path.farm.hunter": ("Hunting", "狩り"),
    "quest.path.farm.husbandry": ("Husbandry", "畜産"),
    "quest.path.farm.main": ("The Kiln", "窯"),
    "quest.path.farm.fuel": ("Fuel", "燃料"),
    "quest.path.farm.mining": ("Metals", "金属"),
    "quest.path.farm.pottery": ("Pottery", "陶芸"),
    "quest.path.farm.prayer": ("Prayer", "祈り"),
    "quest.path.nomad.combat": ("Combat", "戦い"),
    "quest.path.nomad.cooking": ("Food", "食べ物"),
    "quest.path.nomad.explore": ("The Wilds", "荒野"),
    "quest.path.nomad.home": ("Home", "住まい"),
    "quest.path.nomad.hunter": ("Hunting and Fishing", "狩りと釣り"),
    "quest.path.nomad.main": ("The Hearth", "炉辺"),
    "quest.path.nomad.mining": ("Mining", "採掘"),
    "quest.path.nomad.start": ("First Steps", "はじめの一歩"),
    "quest.base.first_night": ("First Night", "最初の夜"),
    "quest.base.first_night.why": ("Make a campfire: put two logs or Wood blocks above two Cobblestones in the 2×2 crafting grid. No stripped wood is needed. Stone lies a few blocks under the dirt or bare on hillsides; a flint pickaxe breaks it into two loose stones, and four loose stones knock together into two cobblestone in the grid. Place the fire, select raw small game or an egg in your hotbar, and right-click the fire. Rabbits and junglefowl roam open grassland; both give small game, and a junglefowl sometimes an egg. Fists are slow at the hunt too: swing an axe instead; a stone one hits three times as hard as a fist (a stone sword, two cobblestone over a stick, does as well). Wait two seconds; the cooked food goes into your inventory. If it burns, try again. Cooked food heals more than raw food.", "2×2の製作枠で、原木か木材を2個並べ、その下に丸石を2個置いて焚き火を作ろう。樹皮を剥ぐ必要はない。石は土の数ブロック下や斜面にむき出しになっている。火打ち石のつるはしで割ると石ころが2個取れ、製作枠で石ころ4個を打ち合わせると丸石が2個できる。焚き火を設置し、生の小動物の肉か卵をホットバーで選び、焚き火を右クリック。ウサギとヤケイは開けた草地にいて、どちらからも小動物の肉が取れ、ヤケイからはときどき卵も取れる。素手では狩りも遅い。斧を振ろう。石の斧なら素手の3倍の強さで当たる（丸石2個の下に棒の石の剣も同じ）。2秒待つと、調理済みの食べ物が持ち物に入る。焦げたらもう一度。調理すると生よりよく回復する。"),
    "quest.base.a_hot_meal": ("A Hot Meal", "温かい食事"),
    "quest.base.a_hot_meal.why": ("What you eat does more than fill you. Hold a food and use it to eat while you are hurt: a cooked meat leaves you Hearty, with room for a tenth more health while it lasts. Eat a cooked meat when you are hurt and feel it.", "食べ物は腹を満たすだけではない。けがをしているときに食べ物を持って使うと食べられる。焼いた肉を食べると「滋養」の状態になり、その間は体力の上限が1割増える。けがをしているときに焼いた肉を食べて確かめよう。"),
    "quest.base.by_the_fire": ("By the Fire", "火のそばで"),
    "quest.base.by_the_fire.why": ("Nights are cold, and a fire is more than light. Two planks over two sticks make a stool (Construction 1). Set it within three blocks of your campfire and right-click it to sit: by the fire you heal half as fast again, and it warms you.", "夜は寒く、火は明かりだけのものではない。板材2つを棒2本の上に置くとスツールになる(建築レベル1)。たき火から3ブロック以内に置き、右クリックして座ろう。火のそばでは回復が1.5倍になり、体も温まる。"),
    "quest.base.first_ore": ("Red Metal Underfoot", "足元の赤い金属"),
    "quest.base.first_ore.why": ("Copper needs Mining 5 and a stone pickaxe; a flint one only scratches it. Mining grows mostly from coal: a score or so of it, with what the early quests give, takes you there. Copper lies in veins underground, mostly below sea level and richest under granite; a small copper-coloured stone lying on the ground marks a vein below it, so dig down there. Mine five; it is the start of every metal.", "銅には採掘レベル5と石のつるはしが要る。火打ち石のつるはしでは傷がつくだけだ。採掘はおもに石炭で伸びる。20個ほど掘れば、最初のクエストの報酬と合わせて届く。銅は地下の鉱脈にあり、たいていは海面より下、花崗岩の土地の下に多い。地面に転がる銅色の小石（銅鉱石のかけら）は真下に鉱脈がある印なので、そこを掘り下げよう。5個掘ろう。あらゆる金属の始まりだ。"),
    "quest.base.homestead_hearth": ("Homestead Hearth", "開拓の炉"),
    "quest.base.homestead_hearth.why": ("Your home: you wake here after dying, and the road to the Farm age begins. Craft a hearthstone (eight cobblestone round an empty middle) and two chimney blocks (six cobblestone and two clay each). Set the hearthstone in a ring of eight stone or cobblestone blocks level with it, stack both chimneys on one corner stone, then right-click the hearthstone. About 28 cobblestone and 4 clay in all; clay lies on the bottom of ponds and lakes, so wade in and dig it with a shovel (one cobblestone over two sticks).", "あなたの家だ。倒れたらここで目覚め、農耕の時代への道が始まる。炉石（中央を空けて丸石8個）と煙突2つ（それぞれ丸石6個と粘土2個）を作ろう。炉石と同じ高さで、石か丸石8個の輪の中央に置き、輪の角の石の上に煙突を2つ積み、炉石を右クリックする。全部で丸石28個と粘土4個ほど。粘土は池や湖の底にあるので、水に入ってシャベル（棒2本の上に丸石1個）で掘ろう。"),
    "quest.base.an_evening_in": ("An Evening In", "家で過ごす夜"),
    "quest.base.an_evening_in.why": ("With the hearth lit, the night is yours to spend at home. After dark, stay under your roof within four blocks of your lit hearth: in by your own fire you heal a fifth faster and are warmer.", "炉に火が入れば、夜は家で過ごせる。日が暮れたら屋根の下で、火の入った炉から4ブロック以内にいよう。自分の火のそばでは回復が2割早くなり、体も温かい。"),
    "quest.base.the_farm_age": ("The Farm Age", "農耕の時代"),
    "quest.base.the_farm_age.why": ("The Farm age opens once you have found your feet: twenty quests of this age done, three of them path capstones, marked gold at their corner in the book. Its stations then open to you: the pit kiln first, for fired clay, then the cooking pot, the well and the rest.", "足場が固まれば農耕の時代が開く。この時代のクエストを20個達成し、そのうち3つが道の締めくくり（本で角が金色のクエスト）であること。すると農耕の設備が作れるようになる。まずは焼き粘土のための野窯、次に土鍋や井戸などだ。"),
    "quest.base.pockets": ("Pockets", "ポケット"),
    "quest.base.pockets.why": ("Herbs and seeds eat slots; a pouch holds a thousand of a kind in one. A hide and a twine side by side make a herb pouch, a twine over a hide a seed pouch (Crafting 3).", "薬草や種は枠を取る。袋なら一種類千個を一つの枠に。皮とひもを横に並べると薬草袋、ひもの下に皮で種袋ができる（工作レベル3）。"),
    "quest.base.red_metal": ("Red Metal", "赤い金属"),
    "quest.base.red_metal.why": ("Copper tools are faster and find more, and copper is three parts of bronze. A small copper-coloured stone on the ground marks a copper vein below it; breaking copper ore takes Mining 5, which the Charcoal quest's reward brings once claimed in the book. Hold copper ore and right-click the crucible of your lit kiln: it melts into ingots (Engineering 5). Three ingots over two sticks at the table make the pickaxe.", "銅の道具は速く、多く見つけ、銅は青銅の四分の三を占める。地面に転がる銅色の小石は、その真下に銅の鉱脈がある印だ。銅鉱石を掘るには採掘レベル5が要り、クエスト帳で「木炭」の報酬を受け取れば届く。銅鉱石を持って、火の入った窯のるつぼを右クリックすると、溶けて延べ棒になる（工学レベル5）。作業台で延べ棒3本の下に棒2本を置けば、つるはしができる。"),
    "quest.base.look_it_up": ("Look It Up", "調べてみよう"),
    "quest.base.look_it_up.why": ("Forgotten a recipe? Open the inventory, type part of a name in its search box, and click the item to see how it is made; a right-click shows what it goes into. Look up the stone pickaxe.", "作り方を忘れた？持ち物画面を開き、検索欄に名前の一部を入力して、アイテムをクリックすると作り方が見られる。右クリックなら使い道が分かる。石のツルハシを調べてみよう。"),
    "quest.base.stone_in_hand": ("Stone in Hand", "石の道具"),
    "quest.base.stone_in_hand.why": ("Soft stone will not take an edge. Find hard rock (granite, diorite, andesite or basalt near the surface, deepslate deep down) and break it with your flint pickaxe. Sand beside cobblestone over two sticks makes a grindstone in the 2×2 grid: set it down, and beside it one hard rock in the grid becomes a stone head. At the crafting table, three heads over two sticks make a stone pickaxe, and three heads with two sticks a stone axe (the recipe viewer shows the shape). Stone tools mine twice as fast and reach coal for torches.", "柔らかい石には刃が付かない。硬い岩（地表近くなら花崗岩・閃緑岩・安山岩・玄武岩、地下深くなら薄暮石）を探し、火打ち石のつるはしで割ろう。2×2の製作枠で砂と丸石を並べ、その下に棒2本で砥石車ができる。砥石車を置き、その横で硬い岩を1個製作枠に入れると石の刃になる。作業台で、石の刃3個の下に棒2本で石のつるはし、石の刃3個と棒2本で石の斧（形はレシピビューアで分かる）。石の道具は2倍速く掘れ、松明用の石炭にも届く。"),
    "quest.base.the_potter": ("The Potter", "陶工"),
    "quest.base.the_potter.why": ("Pots hold stews, and the pot is the heart of the kiln you are working toward. Shape six clay pots from fired clay at the crafting table: five fired clay in a cup shape make two (Crafting 2).", "壺はシチューを入れ、目指す窯の心臓部にもなる。作業台で焼き粘土から土の壺を6個作ろう。焼き粘土5個をカップの形に並べると2個できる（工作レベル2）。"),
    "quest.base.a_pot_on_the_fire": ("A Pot on the Fire", "鍋を火に"),
    "quest.base.a_pot_on_the_fire.why": ("A cooking pot simmers two grain into porridge, which heals more than bread, while you get on with other work. Make one at the crafting table (Crafting 3): seven fired clay round a clay pot. Set it beside a campfire, or on the hearthstone, with water within four blocks (a well counts). Right-click it with wheat in hand (Cooking 3), and two minutes later take the porridge. Keep two.", "土鍋は穀物2つを粥に煮てくれる。粥はパンより回復し、煮ているあいだはほかの仕事ができる。作業台で作ろう（工作3）。焼き粘土7つで土の壺を囲む。焚き火のわきか炉石の上に置き、4ブロック以内に水を用意する（井戸でもよい）。小麦を手に持って右クリックすれば（料理3）、2分後に粥ができる。2杯持っておこう。"),
    "quest.base.a_hearty_stew": ("A Hearty Stew", "具だくさんのシチュー"),
    "quest.base.a_hearty_stew.why": ("At Cooking 14 the pot takes three raw meat, roots or vegetables at once and simmers them into a stew, the best food a pot makes. Carrots, raw small game or raw mutton all go in; cooked food and grain do not. Load it as before, take the stew three minutes later, and keep two. Cook on until you reach Cooking 16.", "料理14になれば、土鍋に生肉か根菜か野菜を3つずつ入れてシチューを煮られる。鍋で作れるいちばんの料理だ。ニンジン、生の小動物の肉、羊肉などが使える。調理済みのものや穀物は入らない。前と同じように入れて、3分後にシチューを取り出し、2杯持っておこう。料理16になるまで料理を続けよう。"),
    "quest.base.torchlight": ("Torchlight", "たいまつの灯り"),
    "quest.base.torchlight.why": ("Light keeps monsters off and lets you work at night. A coal (or a charcoal) over a stick makes four torches: dig coal from its seam with a stone pickaxe (Coal and Cinders). Make eight. A night is a third of the day and cannot be slept away: spend it underground by torchlight digging coal, or at home cooking (Meat on the Fire) and crafting.", "灯りは魔物を遠ざけ、夜も働ける。石炭（か木炭）1個の下に棒1本で松明が4本できる。石炭は石のつるはしで層から掘る（「石炭と燃えさし」）。8本作ろう。夜は1日の3分の1あり、眠って飛ばすことはできない。松明の明かりで地下に潜って石炭を掘るか、家で料理（「火で焼く肉」）や細工をして過ごそう。"),
    "quest.base.stone_and_clay": ("Stone and Clay", "丸石と粘土"),
    "quest.base.stone_and_clay.why": ("Gather for the hearth before you build it: twenty-eight cobblestone (four loose stones knock together into two) and four clay from the bottom of a pond, dug with a shovel. Hold them all at once.", "炉を組む前に材料を集めよう：丸石28個（ばらの石4個を打ち合わせると2個になる）と、池の底からシャベルで掘る粘土4個。全部いっしょに持とう。"),
    "quest.base.light_round_the_camp": ("Light Round the Camp", "野営地を照らす"),
    "quest.base.light_round_the_camp.why": ("Monsters come up where it is dark, not where it is lit. Set four torches on the ground round the place you sleep, and the night there is safer.", "魔物は暗いところに出て、明るいところには出ない。寝る場所のまわりの地面に松明を4本立てれば、そこの夜は安全になる。"),
    "quest.base.twine_and_thong": ("Twine and Thong", "より糸"),
    "quest.base.twine_and_thong.why": ("Twine goes into fishing rods, pouches, candles and baskets. Three wheat twist into two twine. Wild wheat grows as lone golden tufts on open grassland, a tuft every twenty blocks or so on plains, steppe and meadows, and a village's fields grow it too. Or cut tall grass with a knife: about one cut in five gives a twine, one in four with a stone knife. Have ten.", "より糸は釣り竿、袋、ろうそく、かごに使う。小麦3つで2本できる。野生の小麦は開けた草地に金色の房がぽつんと生えていて、平原やステップ、草原なら20ブロックに1つほど見つかる。村の畑でも育っている。ナイフで背の高い草を刈ってもよい。5回に1回ほどより糸がとれ、石のナイフなら4回に1回だ。10本そろえよう。"),
    "quest.base.set_a_snare": ("Set a Snare", "くくり罠をかける"),
    "quest.base.set_a_snare.why": ("A snare catches small game while you do other work. Two twine over two sticks make one (Hunter 1). Set it on grass where rabbits, hares or field mice wander, and go about your day; a sprung snare holds its catch until you come back. Right-click it to take the catch and set it again.", "くくり罠は、ほかの仕事をしているあいだに小さな獲物をとってくれる。より糸2本の下に棒2本で作れる（狩猟1）。ウサギやノウサギ、野ネズミのうろつく草地に仕掛けて、いつもどおり過ごそう。かかった罠は戻るまで獲物を逃がさない。右クリックで獲物を取り、罠をかけ直す。"),
    "quest.base.where_to_settle": ("Where to Settle", "住む場所"),
    "quest.base.where_to_settle.why": ("Biomes help different work: the woods heal, the water fishes, the mountains mine. Walk until you have stood in three different ones; where you build decides what your home gives.", "バイオームごとに向く仕事が違う。森は回復、水辺は釣り、山は採掘。3つの異なるバイオームに立つまで歩こう。どこに建てるかで、家の恵みが決まる。"),
    "quest.base.timber": ("Timber", "木材"),
    "quest.base.timber.why": ("You start with nothing, and bare hands cannot fell a tree. Flint lies loose on the ground near where you wake, and a dead grey snag breaks by hand to a stick a block. Leaves give sticks too (one break in five), and gravel gives flint (one in eight). In the 2×2 grid, two flint over a stick make a flint axe, and two flint over two sticks a flint pickaxe. Fell four logs with the axe (hold the left mouse button on it); woods have the most trees, and plains have a few in groves. A log splits into four planks; four planks make a crafting table, and two planks four sticks.", "最初は何も持っておらず、素手では木を切り倒せない。目覚めた場所の近くの地面には火打ち石が落ちていて、灰色の枯れ木は素手で壊すと1ブロックごとに棒が1本取れる。葉っぱからも5回に1回棒が取れ、砂利からは8回に1回火打ち石が取れる。2×2の製作枠で火打ち石2個の下に棒1本で火打ち石の斧、棒2本で火打ち石のつるはしができる。斧で原木を4個切ろう（左ボタンを押し続ける）。木は森にいちばん多く、平原にも木立がある。原木は板材4枚になり、板材4枚で作業台、板材2枚で棒が4本できる。"),
    "quest.base.a_pile_of_stone": ("A Pile of Stone", "石の山"),
    "quest.base.a_pile_of_stone.why": ("Stone comes after flint. It lies a few blocks under the dirt almost everywhere, and bare on cliffs, hillsides and mountains. Break twenty stone with your pickaxe: each breaks into two loose stones, and four loose stones in the 2×2 grid make two cobblestone, which makes a grindstone, a campfire and, later, your hearth. Other rock, hard or soft, breaks straight to its own cobbles.", "火打ち石の次は石だ。石はほとんどどこでも土を数ブロック掘った下にあり、崖や丘の斜面、山では地表に出ている。つるはしで石を20個掘ろう。1個割るごとに石ころが2個取れ、2×2の製作枠で石ころ4個から丸石が2個できる。丸石は砥石車や焚き火、のちには炉の材料になる。ほかの岩は硬くても軟らかくても、そのまま自分の丸石に割れる。"),
    "quest.base.coal_and_cinders": ("Coal and Cinders", "石炭と燃えさし"),
    "quest.base.coal_and_cinders.why": ("Dig down where the black-flecked stone lay: coal lies in wide seams around sea level and below. Coal wants a stone pickaxe; a flint one only scratches it. One coal or charcoal over a stick makes four torches, and it smelts metal later. Mine twelve coal ore.", "黒い斑点の小石があった所を掘り下げよう。石炭は海面の高さやその下に広い層となって眠っている。石炭を掘るには石のつるはしが要り、火打ち石のものでは歯が立たない。石炭か木炭を棒の上に置くと松明が4本でき、のちには金属の製錬にも使う。石炭鉱石を12個掘ろう。"),
    "quest.base.black_flecks": ("Black Flecks", "黒い斑点"),
    "quest.base.black_flecks.why": ("Coal shows on the surface before you dig. A small black-flecked stone lying on open ground, a coal ore sample, marks a coal seam below it; they lie most often over limestone, sandstone and chalk, around sea level. Break one with your flint pickaxe: the first sample you find over each seam teaches you Mining, and any ore's sample does the same for its vein. The seam itself wants a stone pickaxe (Stone in Hand); coal ore mined from a cliff or a shaft counts here too.", "石炭は掘る前に地表に姿を見せる。開けた地面に転がる黒い斑点の小石（石炭鉱石のかけら）は、真下に石炭層がある印だ。海面の高さあたり、石灰岩や砂岩、白亜の土地の上に多い。火打ち石のつるはしで1個割ろう。鉱脈ごとに最初に割ったかけらは採掘の経験になり、ほかの鉱石のかけらも同じだ。層そのものを掘るには石のつるはしが要る（「石の道具」）。崖や縦穴で掘った石炭鉱石もここに数える。"),
    "quest.base.reading_the_ground": ("Reading the Ground", "大地を読む"),
    "quest.base.reading_the_ground.why": ("Every ore shows on the ground above its vein, as coal does: copper as a small copper-coloured stone, and the other ores in their own colours. Coal samples lift with a flint pickaxe, and copper ones too once you reach Mining 5; the rest want a better pickaxe and more Mining. Break three ore samples of any kind: the first you break over each vein teaches you Mining.", "鉱石はどれも、石炭と同じように鉱脈の上の地面に姿を見せる。銅は銅色の小石（銅鉱石のかけら）、ほかの鉱石もそれぞれの色の小石だ。石炭のかけらは火打ち石のつるはしで割れ、銅のかけらも採掘レベル5になれば割れる。ほかはもっと良いつるはしと採掘レベルが要る。どの鉱石でもいいので、かけらを3個割ろう。鉱脈ごとに最初に割ったかけらは採掘の経験になる。"),
    "quest.base.following_the_seam": ("Following the Seam", "層をたどる"),
    "quest.base.following_the_seam.why": ("A seam runs on through the rock past what you can see. Dig along it with your stone pickaxe, lighting the way with torches as you go, until you have mined thirty-two coal ore and reached Mining 8.", "石炭の層は見えている先まで岩の中を続いている。たいまつで足元を照らしながら石のつるはしで層に沿って掘り進め、石炭鉱石を32個掘って採掘レベル8になろう。"),
    "quest.base.the_first_mine": ("The First Mine", "最初の鉱山"),
    "quest.base.the_first_mine.why": ("A mine is a seam worked for good: coal for fires and torches, and copper for the age of metal to come. Mine forty-eight coal ore and twelve copper ore, and reach Mining 12.", "鉱山とは、掘り続けて暮らしを支える層のことだ。火とたいまつのための石炭と、やがて来る金属の時代のための銅。石炭鉱石を48個、銅鉱石を12個掘り、採掘レベル12になろう。"),
    "quest.base.something_to_swing": ("Something to Swing", "握れる武器"),
    "quest.base.something_to_swing.why": ("Fists are slow. A stone sword (two cobblestone over a stick) or a bone club (two bones over a stick) hits much harder; field mice in the grass, aurochs and wolves drop bones. Make one at the crafting table.", "素手では遅い。石の剣（丸石2個の下に棒）か骨の棍棒（骨2個の下に棒）なら、ずっと強く殴れる。骨は草むらのノネズミやオーロックス、オオカミが落とす。作業台で作ろう。"),
    "quest.base.a_stones_throw": ("A Stone's Throw", "石つぶて"),
    "quest.base.a_stones_throw.why": ("A sling hits from twelve blocks away, where a blade must be close: birds, runners, or something you would rather not stand next to. Lay a hide between two twine in a row at the crafting table. Hold it and click a creature in clear sight: each shot throws one cobblestone from your pack, hit or miss, so carry a stack. It hits softer than a stone sword (2 at most), and every hit trains Ranged. A sling stone that hits is left lying where the creature stood about one time in four; one that misses, or hits for nothing, is gone. Walk over and pick up what lies there before you throw again, and a stack of cobblestone lasts. Bring down five creatures and reach Ranged 4.", "投石器なら、刃物では近づくしかない相手に12ブロック先から当てられる。鳥や逃げ足の速い獣、そばに立ちたくない相手にいい。作業台で、より糸2本のあいだに獣皮を1枚、横一列に並べて作ろう。手に持ち、まっすぐ見えている生き物をクリックする。当たっても外れても1発ごとに丸石が1個減るので、ひと山持っておくこと。威力は石の剣より弱い（最大2）が、当てるたびに飛び道具が鍛えられる。スリングの石は、当たると4回に1回ほど、獲物のいた場所に落ちて残る。外れた石や、0ダメージだった石はなくなる。次に投げる前に、落ちている石を拾いに行けば、丸石1スタックが長持ちする。生き物を5体倒し、飛び道具を4にする。"),
    "quest.base.small_game": ("Small Game", "小さな獲物"),
    "quest.base.small_game.why": ("Rabbits, junglefowl and other small animals are the easiest food: small game cooks well at a campfire. Look for them on open grassland. Hunt three; a few blows are enough, and each kill trains Hunter. Then cook one of what you killed.", "ウサギやヤケイなどの小動物は、いちばん手軽な食料だ。小動物の肉は焚き火でうまく焼ける。開けた草地を探そう。3匹狩ろう。数回殴れば倒せ、倒すたびに狩猟が上がる。そして、仕留めた獲物を1つ焼いてみよう。"),
    "quest.base.hide_and_seek": ("Hide and Seek", "皮集め"),
    "quest.base.hide_and_seek.why": ("Hide makes armour, pouches and bedding once it has hung a minute on a drying rack. Rabbits on grassland drop raw hide, and so do deer and boar in the woods; a knife in your hand makes it drop more often. Gather four raw hides, and keep two bones as well: field mice in the grass drop them, and a bone makes a club, a needle, a handle.", "獣の皮は干し台に1分かけると、防具や袋や寝具の材料になる。草地のウサギや、森のシカとイノシシが生皮を落とし、ナイフを持っていると落ちやすい。生皮を4枚集め、骨も2本とっておこう。骨は草むらのノネズミが落とし、棍棒や針や柄になる。"),
    "quest.base.old_tusk": ("Old Tusk", "古牙"),
    "quest.base.old_tusk.why": ("A great boar roams the woods and the sagebrush steppe by day, alone among the boar: Old Tusk. He grazes until struck, then fights to the end, and his charge crushes. A flint spear (a flint and two sticks, Crafting 2) braces: with no shield in your off hand, right-click to raise it as he crouches, and he runs onto its point and stands dazed. A tree or a wall at your back does the same. Make a spear, then bring him down.", "大きなイノシシが一頭、昼の森やヨモギのステップを群れから離れてうろついている。古牙だ。殴られるまでは草をはみ、それから最後まで戦う。突進は重い。火打ち石の槍（火打ち石1つと棒2本、工作2）は構えられる。盾を持たずに、相手が身をかがめたら右クリックで槍を構えれば、穂先に突っこんで目を回す。背に木や壁があっても同じだ。槍を作り、仕留めよう。"),
    "quest.base.hide_wraps": ("Hide Wraps", "獣皮の防具"),
    "quest.base.hide_wraps.why": ("Armour turns blows aside and trains Defence. Hide gloves (two hide) and boots (three hide) are the cheapest pieces. Make both at the crafting table.", "防具は攻撃をそらし、防御を鍛える。獣皮の手袋（皮2枚）と靴（皮3枚）がいちばん安上がりだ。作業台で両方作ろう。"),
    "quest.base.hard_to_put_down": ("Hard to Put Down", "倒れにくい体"),
    "quest.base.hard_to_put_down.why": ("Two skills grow only in a fight. Defence trains on the blows you turn aside while you fight back against something your match, and Hitpoints, twice your level in health, on every blow you land. Rabbits and fowl cannot hurt you, so wear your hide wraps against boar and wolves in the woods, or the monsters that come out at night. Reach Defence 4 and Hitpoints 12.", "戦いの中でしか伸びない技能が2つある。防御は、自分と釣り合う相手に反撃しながら受け流した攻撃で鍛えられ、体力（レベルの2倍が体力になる）は攻撃を当てるたびに鍛えられる。ウサギや鶏ではけがをしないので、獣皮の防具を着て森のイノシシやオオカミ、夜に出る魔物と戦おう。防御レベル4と体力レベル12を目指そう。"),
    "quest.base.meat_and_fire": ("Meat on the Fire", "火で焼く肉"),
    "quest.base.meat_and_fire.why": ("Raw meat heals little and leaves you Queasy; cooked meat heals far more. Cook six pieces of meat at a campfire: small game or duck. Ducks live by rivers and in swamps. A higher Cooking level burns less. Six good meals, with what the camp has taught you, will take you to Cooking 4.", "生肉は回復が少なく、気分も悪くなる。焼いた肉ならずっとよく回復する。焚き火で肉を6個焼こう。小動物かカモのどちらでもよい。カモは川辺や沼地にいる。料理の腕が上がるほど焦げにくくなる。6回上手に焼けば、これまでの経験と合わせて料理レベル4に届く。"),
    "quest.base.a_handful_of_grain": ("A Handful of Grain", "ひとにぎりの穀物"),
    "quest.base.a_handful_of_grain.why": ("Wild wheat grows as lone golden tufts on open grassland: look on plains, steppe and meadows, where there is a tuft every twenty blocks or so, or break the wheat in a village's fields. Break it for seeds and often an ear of wheat: wheat makes bread and twine, and the seeds are your first crop.", "野生の小麦は開けた草地に金色の房がぽつんと生えている。平原やステップ、草原なら20ブロックに1つほど見つかるし、村の畑の小麦を壊してもよい。壊すと種が手に入り、小麦の穂もよく落ちる。小麦はパンとより糸になり、種は最初の作物になる。"),
    "quest.base.daily_bread": ("Daily Bread", "毎日のパン"),
    "quest.base.daily_bread.why": ("Two ears of wheat side by side in the crafting grid bake into bread, which heals more than the grain. Bake four loaves.", "小麦の穂を作業枠に2つ並べるとパンが焼ける。穀物のままより回復する。4個焼こう。"),
    "quest.base.break_ground": ("Break Ground", "土を耕す"),
    "quest.base.break_ground.why": ("A hoe tills grass or dirt into farmland, where seeds can be sown. A hoe needs a stone edge: two stone heads, ground from hard rock at a grindstone you set down, over two sticks at the crafting table. Right-click soil with it to till.", "くわは草地や土を耕して耕地にし、種をまけるようにする。くわには石の刃がいる。置いた砥石車で硬い岩から研いだ石の刃2個の下に棒2本を置いて、作業台で作ろう。土を右クリックすると耕せる。"),
    "quest.base.rod_and_line": ("Rod and Line", "釣り竿と糸"),
    "quest.base.rod_and_line.why": ("A fishing rod is three sticks and two twine, laid out at the crafting table as the recipe shows. Twine is three wheat twisted into two. With the rod in hand, right-click water and wait for a bite. Then land one fish.", "釣り竿は棒3本とより糸2本を、作業台でレシピの形に並べて作る。より糸は小麦3つを撚ると2本できる。竿を持って水を右クリックし、食いつくのを待とう。そして魚を1匹釣り上げよう。"),
    "quest.base.a_fish_supper": ("A Fish Supper", "魚の夕食"),
    "quest.base.a_fish_supper.why": ("A fish tastes far better cooked. Roast three at a campfire: hold the raw fish and right-click the fire. Catch the three yourself.", "魚は焼くとずっとおいしく、回復も多い。生の魚を持って焚き火を右クリックし、3匹焼こう。3匹は自分で釣ること。"),
    "quest.base.wild_harvest": ("Wild Harvest", "野の恵み"),
    "quest.base.wild_harvest.why": ("The wild gives herbs, flowers, berries and mushrooms for the picking. Pick five different kinds by hand; most grow back in time. Flowers and herbs crowd flower meadows, berry bushes and mushrooms grow in the woods, and raspberries in meadows. Your journal's Plants page records each kind you pick. Herbs flavour food, heal and brew into potions later. Pick five herbs: flower meadows are full of chamomile, sorrel and yarrow, mint grows by water, and sage and thyme on warm, dry ground. Carry them in a herb pouch so they do not eat your slots.", "野には薬草、花、ベリー、キノコが生えている。素手で5種類摘もう。たいていは時間がたてば生え戻る。花と薬草は花の草原に多く、ベリーの茂みとキノコは森に、ラズベリーは草原に生える。摘んだ種類は図鑑の植物のページに記録される。薬草は料理の風味づけになり、傷を癒やし、のちには薬にもなる。薬草を5本摘もう。花の草原にはカモミールやスイバ、ノコギリソウが多く、ミントは水辺に、セージとタイムは暖かく乾いた土地に生える。薬草袋に入れて持ち歩けば枠を取らない。"),
    "quest.base.herb_lore": ("Herb Lore", "薬草の知恵"),
    "quest.base.herb_lore.why": ("Alchemy is knowing what each herb carries. Brewing comes in a later age, but folk on the road teach the first of it now: an old herb gatherer shares lore for a herb, a wandering healer makes a salve of three, and a travelling alchemist wants two each of six kinds. Carry herbs on your rounds and deal with one of them.", "錬金術とは、薬草がそれぞれ持つ力を知ることだ。調合は後の時代になるが、道行く人がその最初を教えてくれる。年老いた薬草摘みは薬草1つで知恵を分けてくれ、旅の治療師は3つで軟膏を作り、旅の錬金術師は6種類を2つずつ欲しがる。見回りに薬草を持ち歩き、誰か1人と取引しよう。"),
    "quest.base.neighbours": ("Wild Neighbours", "野の隣人たち"),
    "quest.base.neighbours.why": ("Walk the land and meet who lives in it. Get right up close to six kinds of animal, within three blocks with nothing in between: rabbits and junglefowl on grassland, deer and boar in the woods, ducks by water. The journal's Animals page fills in as you go, and every kind drops something different.", "土地を歩いて、そこに住むものに会いに行こう。6種類の動物のすぐそば（3ブロック以内、間に何もない所）まで近づくと、図鑑の動物のページが埋まっていく。草地にはウサギとヤケイ、森にはシカとイノシシ、水辺にはカモがいる。動物ごとに落とすものが違う。"),
    "quest.base.lay_of_the_land": ("Lay of the Land", "土地のようす"),
    "quest.base.lay_of_the_land.why": ("Before you settle, see more of the world. Stand in six different biomes: woods, plains, hills, wetlands and shores each hold different animals, plants and ores.", "住処を決める前に、世界をもっと見て回ろう。6つの異なるバイオームに立つこと。森、平原、丘、湿地、海辺で動物も植物も鉱石も違う。"),
    "quest.base.something_hostile": ("Something Hostile", "敵意あるもの"),
    "quest.base.something_hostile.why": ("Not everything out there is food. Cave bats and cave crawlers lurk in the dark underground, and shamblers walk where the aether is strong. Fight one with a sword in hand and torches and bread at your belt.", "外にいるのは食べ物だけではない。洞窟コウモリと洞窟グモは地下の暗がりに潜み、さまよう屍はエーテルの濃い場所を歩く。剣を持ち、腰に松明とパンを備えて、1体倒そう。"),
    "quest.base.sharpening_up": ("Sharpening Up", "腕を磨く"),
    "quest.base.sharpening_up.why": ("Every blow you land trains Attack, and a higher level hits harder and truer. Hunt until you reach Attack 4. Five kills along the way.", "攻撃が当たるたびに攻撃のレベルが上がり、より強く正確に打てるようになる。攻撃レベル4まで狩りを続けよう。その間に5体仕留めること。"),
    "quest.base.raise_your_guard": ("Raise Your Guard", "盾を構える"),
    "quest.base.raise_your_guard.why": ("A shield blocks blows: right-click to raise your guard as a swing lands. A hide buckler (four hide and a stick) is the easy one; a wooden shield (planks) needs Crafting 3.", "盾は攻撃を防ぐ。振り下ろされる瞬間に右クリックで構えよう。獣皮の小盾（皮4枚と棒）なら手軽で、木の盾（板材）は工作レベル3が要る。"),
    "quest.base.tools_for_animals": ("Tools for Animals", "家畜のための道具"),
    "quest.base.tools_for_animals.why": ("Shears take wool from a tamed mouflon, and a pail takes milk from a tamed mountain goat, reindeer or aurochs. Two cobblestones crossed make shears; two planks crossed make a pail.", "はさみは飼い慣らしたムフロンから羊毛を、手おけは飼い慣らしたシロイワヤギやトナカイやオーロックスから乳を取る道具だ。丸石2個を斜めに並べるとはさみ、板材2枚を斜めに並べると手おけができる。"),
    "quest.base.a_sharp_edge": ("A Sharp Edge", "鋭い刃"),
    "quest.base.a_sharp_edge.why": ("A knife is the hunter's tool: it makes a kill drop hide more often, cuts plants cleanly, and cuts twine from tall grass. A flint knife is a flint over a stick, a stone knife a stone head over a stick; both fit the inventory grid. Stone heads are ground from hard rock at a grindstone you set down.", "ナイフは狩人の道具で、倒した獲物が皮を落としやすくなり、植物もきれいに切れ、背の高い草からより糸もとれる。火打ち石のナイフは火打ち石の下に棒、石のナイフは石の刃の下に棒で、持ち物の作業枠でも作れる。石の刃は、置いた砥石車で硬い岩から削り出す。"),
    "quest.base.a_keen_edge": ("A Keen Edge", "鋭い刃を保つ"),
    "quest.base.a_keen_edge.why": ("Copper wears down like stone, but it needn't be thrown away. Metal is mended at a grindstone, the wheel you made your first stone heads on: put a worn copper tool and one copper ingot in the grid within reach of it, and the tool comes back half new. Mend a copper tool at a grindstone.", "銅も石と同じようにすり減るが、捨てることはない。金属は砥石車で直す。最初の石の刃を研いだあの車だ。その近くで、すり減った銅の道具と銅のインゴット1個を作業枠に入れよう：道具が半分新しくなって戻る。砥石車で銅の道具を直そう。"),
    "quest.base.a_bronze_edge": ("A Bronze Edge", "青銅の刃"),
    "quest.base.a_bronze_edge.why": ("Bronze is harder than copper: a bronze tool lasts twice as long and works faster. The patterns are copper's, in bronze ingots, at Engineering 12. Make a bronze pickaxe; when it wears, a bronze ingot mends it at your grindstone.", "青銅は銅より硬い：青銅の道具は2倍長持ちし、作業も速い。形は銅と同じで、材料は青銅のインゴット、工学12で作れる。青銅のつるはしを作ろう。すり減ったら、砥石車で青銅のインゴット1個を使って直せる。"),
    "quest.base.clay_banks": ("Clay Banks", "粘土の川底"),
    "quest.base.clay_banks.why": ("Pots, vials and kiln bricks are all clay. It lies in patches on the bottom of ponds, lakes and rivers: wade in and dig it with a shovel (one stone head over two sticks). Carry out twenty-four.", "壺も小瓶も窯レンガも、材料は粘土だ。池や湖や川の底に塊になって埋まっている。水に入ってシャベル（石の刃1個の下に棒2本）で掘り、24個持ち帰ろう。"),
    "quest.base.a_pit_kiln": ("A Pit Kiln", "野窯"),
    "quest.base.a_pit_kiln.why": ("Clay needs more heat than an open fire gives. A pit kiln is a campfire walled in with cobblestone: at the crafting table, put the campfire in the middle of the bottom row with a cobblestone on each side of it and one above each of those, four in all, as the recipe shows. Set it down where the clay is near, then hold clay and right-click it.", "粘土を焼くには、野火より強い熱がいる。野窯は焚き火を丸石で囲んだものだ。作業台の下の段の真ん中に焚き火を置き、その両側と、さらにそれぞれの上に丸石を1個ずつ、計4個並べる（レシピの形どおり）。粘土の近くに置いたら、粘土を持って右クリックしよう。"),
    "quest.base.fire_the_clay": ("Fire the Clay", "粘土を焼く"),
    "quest.base.fire_the_clay.why": ("Hold clay and right-click the pit kiln: up to twelve go in, and twelve seconds later the kiln shows them fired. Right-click it again to take them out, none cracked. You need not stand by it, so dig the next load meanwhile. Fire twelve.", "粘土を持って野窯を右クリックすると、12個まで入れられる。12秒ほどで焼き上がった姿になるので、もう一度右クリックして取り出そう。割れることはない。そばで待たなくていいので、そのあいだに次の粘土を掘ろう。12個焼くこと。"),
    "quest.base.brick_by_brick": ("Brick by Brick", "レンガを積んで"),
    "quest.base.brick_by_brick.why": ("The Crucible Kiln is built of kiln bricks: twelve tempered for the ring, seven plain for the crucible. Four fired clay make two plain bricks in the crafting grid (Crafting 5); add a straw to the four at the crafting table and they make two tempered bricks, which keep whole in the kiln's heat. Nineteen bricks are forty fired clay and six straw. Keep the pit kiln and the clamp going while you dig the next load, and shape seven plain, counting your first, and twelve tempered.", "るつぼ窯は窯レンガでできている。囲いにわら入りを12個、るつぼに普通のものを7個だ。作業枠で焼き粘土4個から普通の窯レンガが2個できる（工作レベル5）。作業台でその4個にわらを1つ加えると、窯の熱でも割れないわら入り窯レンガが2個できる。19個なら焼き粘土40個とわら6つになる。次の粘土を掘るあいだも野窯と伏せ窯を動かし続け、最初の分も合わせて普通のものを7個、わら入りを12個作ろう。"),
    "quest.base.a_kiln_load": ("A Kiln Load", "窯いっぱい"),
    "quest.base.a_kiln_load.why": ("Brick by Brick takes forty fired clay, and the crucible a pot, so keep the pit kiln busy. Fire forty clay in all, counting what you have fired before, and the potters' trick is yours: four kiln bricks toward the seven plain ones of the crucible. Between loads, turn spare fired clay into crockery (Earthenware), fire cobblestone into stone for an altar (A Place to Pray), or hand clay to potters on the road.", "「レンガを積んで」には焼き粘土が40個、るつぼには壺が要るので、野窯を休ませないこと。これまでの分も合わせて粘土を40個焼けば、陶工のこつとして、るつぼに使う普通の窯レンガ7個のうち4個がもらえる。焼くあいまに、余った焼き粘土で器を作ったり（「素焼きの器」）、丸石を石に焼いて祭壇を作ったり（「祈りの場」）、道行く陶工に粘土を渡したりしよう。"),
    "quest.base.an_earth_clamp": ("A Second Clamp", "二つ目の炭窯"),
    "quest.base.an_earth_clamp.why": ("The Crucible Kiln burns thirty-two charcoal at a lighting, and every melt after wants more. A clamp takes two hours, so build the next while the last one smoulders, and roof each flue against rain. While it smoulders the flue is a fire: a drying rack beside it dries twice as fast. Light two clamps.", "るつぼ窯は一度焚くのに木炭を32個使い、そのあとも溶かすたびにもっと要る。炭窯は2時間かかるので、前の窯がくすぶっているあいだに次を築き、煙道にはそれぞれ雨よけの屋根をかけよう。くすぶっているあいだ煙道は火なので、そばの干し台は倍の速さで乾く。炭窯に2回火を入れること。"),
    "quest.base.the_crucible": ("The Crucible", "るつぼ"),
    "quest.base.the_crucible.why": ("The heart of the kiln: seven kiln bricks round a clay pot, shaped at the crafting table (Engineering 10). Engineering grows with every tool, ingot and torch you make, and Charcoal and Brick by Brick pay it well. Make it and set it down in the empty middle of your kiln's ring of bricks.", "窯の心臓部だ。作業台で土の壺の周りに窯レンガ7個を並べて作る（工学レベル10）。工学は道具や延べ棒や松明を作るたびに伸び、「木炭」と「レンガを積んで」の報酬でも大きく伸びる。作ったら、窯のレンガの輪の空いた真ん中に置こう。"),
    "quest.base.straw_for_the_kiln": ("Straw for the Kiln", "窯のためのわら"),
    "quest.base.straw_for_the_kiln.why": ("Straw in the clay keeps a kiln brick whole in the Crucible Kiln's heat. A ripe wheat plant you break gives one or two straw, and a wild wheat tuft one. Keep six straw in your pack: four fired clay and a straw make two tempered kiln bricks at the crafting table (Crafting 5).", "粘土にわらを混ぜると、窯レンガはるつぼ窯の熱でも割れない。熟した小麦の株を壊すとわらが1つか2つ、野生の小麦の株からは1つ取れる。わらを6つ袋に持っておこう。作業台で焼き粘土4個とわら1つからわら入り窯レンガが2個できる（工作レベル5）。"),
    "quest.base.first_harvest": ("First Harvest", "初めての収穫"),
    "quest.base.first_harvest.why": ("Till grass or dirt with a hoe (right-click), sow wheat seeds (wild wheat gives them) on the farmland (right-click), keeping it within four blocks of water (beside a river, pond or lake), and wait: wheat ripens in about twelve minutes. Break the ripe plants to harvest; a stone hoe reaps the ripe crops around the one you cut. Harvest four. Keep the four wheat you harvest in your pack. While it grows, there is plenty to do: explore (Far Horizons), tame hens (Hens in a Row) or make seats and a table for the hearth (A Table for Two).", "くわで草地や土を耕し（右クリック）、耕地に小麦の種（野生の小麦から取れる）をまき（右クリック）、水から4ブロック以内（川や池や湖のそば）で待とう。小麦は12分ほどで実る。熟した株を壊して収穫する。石のくわなら、刈った株のまわりの熟した作物もまとめて刈れる。4株収穫しよう。収穫した小麦4つは持っておくこと。育つあいだにもやることは多い。遠くを旅する（「遠い地平線」）、雌鶏を手なずける（「並んだ雌鶏」）、炉のそばに腰かけとテーブルを作る（「ふたりのテーブル」）。"),
    "quest.base.a_field_of_gold": ("A Field of Gold", "黄金の畑"),
    "quest.base.a_field_of_gold.why": ("One plot is a hobby; a field is a food supply. Keep sowing from your own seed and harvest twenty-four wheat plants. Seeds come back with each harvest, so the field pays for itself. A field that size also teaches Farming 4. Between sowings, cook what your hunting and fishing bring (Camp Cook) or set a herb planter by the door (Herb Garden).", "一区画は趣味、畑は食料の源だ。自分の種をまき続けて、小麦を24株収穫しよう。収穫のたびに種が戻るので、畑は自分で元を取る。それだけの畑なら、農業レベル4も身につく。種まきの合間には、狩りや釣りの獲物を料理したり（「野営の料理人」）、戸口に薬草のプランターを置いたりしよう（「薬草園」）。"),
    "quest.base.a_well_by_the_field": ("A Well by the Field", "畑のそばの井戸"),
    "quest.base.a_well_by_the_field.why": ("Crops want water within four blocks, so a field far from a river or pond stays poor. A well waters as water does. Make one at the crafting table (Construction 8): a stick, a plank and a stick along the top; a cobblestone, a pail and a cobblestone across the middle; three cobblestones along the bottom. A pail is two planks set corner to corner. Set the well on the ground beside your tilled field, or sunk level with it, no more than four blocks from the crops.", "作物は4ブロック以内に水がないとよく育たない。川や池から遠い畑はやせたままだ。井戸は水と同じように畑をうるおす。作業台で作ろう（建築8）。上の段に棒、板材、棒、中の段に丸石、手おけ、丸石、下の段に丸石を3つ並べる。手おけは板材2枚を斜めに置けばできる。耕した畑のわきの地面に置くか、畑と同じ高さに埋めこもう。作物から4ブロック以内にすること。"),
    "quest.base.a_full_granary": ("A Full Granary", "満ちた穀倉"),
    "quest.base.a_full_granary.why": ("A stone hoe reaps every ripe crop in the three by three around the one you cut, and an iron hoe the five by five, so a wide field comes in at a few strokes. Sow a field nine across with your well in it, let it ripen, and bring in sixty-four wheat plants; keep thirty-two wheat of the harvest for bread, twine and feed.", "石のくわは刈った株のまわり3×3の熟した作物をまとめて刈り取り、鉄のくわなら5×5を刈る。広い畑も数回で刈り終わる。井戸を真ん中に幅9の畑をまき、実ったら小麦を64株収穫しよう。収穫のうち小麦32はパンやより糸、飼い葉のために取っておくこと。"),
    "quest.base.carrot_patch": ("Carrot Patch", "ニンジン畑"),
    "quest.base.carrot_patch.why": ("Carrots need Farming 5 and cool, moist soil. A carrot is its own seed: forage wild carrots (white-flowered, thickest in flower meadows, a few on plains), plant what you get, and harvest four. Rabbits love them too. Keep the four carrots you harvest. Carrots take a little longer than wheat; four crops sown by your home also make a kitchen garden (A Kitchen Garden) while they grow.", "ニンジンは農業レベル5と涼しくて湿った土が要る。ニンジンはそのまま種になる。野生のニンジン（白い花で、花の草原に多く、平原にも少しある）を摘んで植え、4株収穫しよう。ウサギの大好物でもある。収穫したニンジン4本は持っておくこと。ニンジンは小麦より少し時間がかかる。家のそばに作物を4つまけば、育つあいだに家庭菜園にもなる（「家庭菜園」）。"),
    "quest.base.herb_garden": ("Herb Garden", "薬草園"),
    "quest.base.herb_garden.why": ("Herbs cannot be sown, but a herb planter (planks round dirt, Construction 3) lets a picked herb grow back at home. Make a planter, set a herb in it, and pick it again when it returns. Pick six wild plants on your rounds as well. While a herb grows back, sow four crops by the house (A Kitchen Garden).", "薬草は種まきできないが、薬草のプランター（板材で土を囲む、建築レベル3）なら、摘んだ薬草が家で生え戻る。プランターを作って薬草を植え、戻ったらまた摘もう。見回りの途中で野の植物を6つ摘むこと。薬草が生え戻るあいだ、家のそばに作物を4つ植えよう（「家庭菜園」）。"),
    "quest.base.camp_cook": ("Camp Cook", "野営の料理人"),
    "quest.base.camp_cook.why": ("Every dish trains Cooking. Duck wants level 3, mutton 5 and crab 6, and a higher level burns less. Roast six small game from your hunting at the campfire, and cook whatever else your hunting and fishing bring, until you reach Cooking 5.", "料理するたびに料理の腕が上がる。カモは3、マトンは5、カニは6が必要で、レベルが高いほど焦げにくい。狩った小さな獲物を焚き火で6つ焼き、ほかにも狩りと釣りで得た肉や魚を焼いて、料理レベル5を目指そう。"),
    "quest.base.seed_mix": ("Seed Mix", "混ぜ種"),
    "quest.base.seed_mix.why": ("Kept animals only breed when fed their breeding food. Two seeds and a wheat in the crafting grid make seed mix (Cooking 8), which readies any kept animal to breed. Make four. Bring in eight wheat to make it from.", "飼っている動物は、繁殖用の餌を与えないと増えない。種2つと小麦1つを作業枠に並べると混ぜ種ができ（料理レベル8）、どの動物も繁殖の準備ができる。4個作ろう。材料にする小麦を8つ収穫しよう。"),
    "quest.base.roots_in_the_embers": ("Roots in the Embers", "おき火の根菜"),
    "quest.base.roots_in_the_embers.why": ("A roast carrot heals better than a raw one, and roots are easy food to grow. Roast four carrots on a campfire (Cooking 2).", "焼きニンジンは生より回復し、根菜は育てやすい食べ物だ。焚き火でニンジンを4本焼こう（料理レベル2）。"),
    "quest.base.a_side_of_beef": ("A Side of Beef", "牛肉の塊"),
    "quest.base.a_side_of_beef.why": ("Aurochs beef is the richest meat the plains give, and it wants a practised cook. Roast four mutton (Cooking 5) and four pork (Cooking 8) from your hunting on the way up to Cooking 12, then roast two beef from an aurochs (Bigger Game) at the campfire or the stove.", "オーロックスの牛肉は平原でいちばん豊かな肉だが、腕のある料理人でないと扱えない。狩りで得たマトン（料理レベル5）とポーク（料理レベル8）を4つずつ焼いて料理レベル12まで上げ、オーロックス（大物狩り）の牛肉を焚き火かかまどで2つ焼こう。"),
    "quest.base.hens_in_a_row": ("Hens in a Row", "並んだ雌鶏"),
    "quest.base.hens_in_a_row.why": ("Hold wheat seeds (wild wheat and your own field give them), walk up slowly (no sprinting, no hitting) and right-click a junglefowl until it trusts you; they keep to warm grassland and jungle. A kept hen needs room, grass or feed, and water nearby, and lays an egg about every five minutes. Tame three.", "小麦の種（野生の小麦や自分の畑から取れる）を持ち、走らず殴らずにそっとヤケイに近づき、慣れるまで右クリックしよう。ヤケイは暖かい草地やジャングルにいる。飼うには広さと草か餌、近くの水が要り、5分に1個ほど卵を産む。3羽手なずけること。"),
    "quest.base.a_trough_for_the_pen": ("A Trough for the Pen", "囲いの飼い葉桶"),
    "quest.base.a_trough_for_the_pen.why": ("Kept animals graze within seven blocks of home, and a full pen strips its grass and goes hungry. A feed trough is five planks in a low U (Construction 4). Set it by the pen and stock it with eight wheat: a hungry animal with nothing to graze walks to it and eats one of its foods, so the pen is fed while you are away.", "飼っている動物は家から7ブロック以内で草を食べる。囲いがいっぱいだと草は食べつくされ、腹をすかせる。飼い葉桶は板材5枚を低いU字に置いて作る（建築4）。囲いのそばに置いて小麦を8つ入れておこう。食べる草のない腹ぺこの動物は桶まで歩いて餌を1つ食べるので、留守のあいだも囲いは飢えない。"),
    "quest.base.fresh_eggs": ("Fresh Eggs", "産みたての卵"),
    "quest.base.fresh_eggs.why": ("A kept hen lays on the ground near her, and a hen that is fed, watered and sheltered lays more. Fry your first egg on a campfire to taste the reward, then collect five more and keep them. A hen lays about every five minutes: meanwhile hunt big game (Bigger Game) or tame more animals about the house (A Full House).", "飼っている雌鶏は近くの地面に卵を産み、餌と水と屋根が足りている雌鶏ほどよく産む。最初の卵は焚き火で目玉焼きにして成果を味わい、そのあと5個集めてとっておこう。雌鶏が卵を産むのは5分に1個ほどだ。そのあいだに大きな獲物を狩ったり（「大物狩り」）、家のまわりで動物をもっと手なずけたりしよう（「にぎやかな家」）。"),
    "quest.base.a_proper_breakfast": ("A Proper Breakfast", "まともな朝食"),
    "quest.base.a_proper_breakfast.why": ("A fried egg is the quickest cooking there is: hold an egg and right-click a campfire. Fry three.", "目玉焼きは最も手軽な料理だ。卵を持って焚き火を右クリックするだけ。3個焼こう。"),
    "quest.base.a_woolly_flock": ("A Woolly Flock", "羊毛の群れ"),
    "quest.base.a_woolly_flock.why": ("Mouflon, the wild sheep, need Hunter 5 to tame (taming, hunting and Bigger Game teach it); look on mountains and heath. Hold wheat, its favourite, approach calmly and right-click. A kept sheep grows its wool back: shear it with your shears. Have your shears made before you go.", "野生の羊ムフロンは、手なずけるのに狩猟レベル5が要る（手なずけること、狩り、「大物狩り」で上がる）。山岳やヒースを探そう。好物の小麦を持ち、落ち着いて近づいて右クリックしよう。飼った羊は羊毛が生え戻るので、はさみで刈り取れる。出かける前にハサミを作っておこう。"),
    "quest.base.wool_gathering": ("Wool Gathering", "羊毛集め"),
    "quest.base.wool_gathering.why": ("Wool makes beds, cloth and sleeping bags. Right-click a kept sheep with shears in hand whenever its wool has grown back, and gather six. Wool grows back in about six minutes: dye the first of it into cloth meanwhile, for a rug once the home is homely, or go after milk (The Milk Pail).", "羊毛はベッドや布や寝袋の材料だ。飼っている羊の毛が生え戻ったら、はさみを持って右クリックして刈り、6つ集めよう。羊毛は6分ほどで生え戻る。そのあいだに最初の羊毛を布に染めておけば、家がくつろげるようになったとき敷物にできる。牛乳を取りに行くのもいい（「ミルクの手おけ」）。"),
    "quest.base.ducks_on_the_pond": ("Ducks on the Pond", "池のカモ"),
    "quest.base.ducks_on_the_pond.why": ("Mallards need Hunter 3, lay eggs, and do not mind rain. They keep to rivers and wetlands. Hold wheat seeds or wheat, their favourite, approach one by the water without sprinting or hitting, and right-click it.", "マガモは狩猟レベル3で手なずけられ、卵を産み、雨も気にしない。川や湿地にいる。好物の小麦の種か小麦を持ち、走らず殴らずに水辺で近づいて、右クリックしよう。"),
    "quest.base.the_milk_pail": ("The Milk Pail", "ミルクの手おけ"),
    "quest.base.the_milk_pail.why": ("A tamed mountain goat (Hunter 8), reindeer (10) or aurochs (12) gives milk to a pail, right-clicked. Goats live on mountains and take wheat or an apple; reindeer live on tundra and in taiga and take a mushroom; aurochs graze the plains and take wheat. Hold the food, approach calmly and right-click to tame one. Milk heals half as fast again for a while. Collect two. Make the pail first: two planks crossed. An animal gives milk about every five minutes; between pails, tame more toward a real farm.", "手なずけたシロイワヤギ（狩猟レベル8）、トナカイ（10）、オーロックス（12）は、手おけを持って右クリックすると牛乳を出す。ヤギは山岳にいて小麦かリンゴ、トナカイはツンドラやタイガにいてキノコ、オーロックスは平原にいて小麦を好む。好物を持ってそっと近づき、右クリックで手なずけよう。牛乳はしばらく回復を5割速める。2つ集めよう。まず桶を作る。板2枚を交差させる。動物が牛乳を出すのは5分に1回ほど。合間に動物をもっと手なずけて、本物の農場を目指そう。"),
    "quest.base.a_full_pen": ("A Full Pen", "満員の囲い"),
    "quest.base.a_full_pen.why": ("Six animals under your care is a real farm. Keep each fed, watered, roofed against rain and given room; condition decides what they give. You can keep up to 64 animals.", "6匹の動物を世話すれば立派な農場だ。餌、水、雨よけの屋根、広さを用意しよう。状態のよさが、もらえるものを決める。飼えるのは64匹まで。"),
    "quest.base.bigger_game": ("Bigger Game", "大物狩り"),
    "quest.base.bigger_game.why": ("Sheep, deer, boar and cattle give more meat and better hides, but they fight back: wear your hide wraps and keep your sword sharp. Red deer and wild boar keep to the woods, aurochs to the plains, mouflon to the mountains. Cook the haunch: mutton at Cooking 5, pork at 8, venison at 15. Their raw hide turns to hide hung a while on a drying rack: four sticks and three twine at the crafting table make one (Crafting 1). Make a rack.", "羊、シカ、イノシシ、牛は肉も皮も多く取れるが、反撃してくる。獣皮の防具を着て、剣を研いでおこう。アカシカとイノシシは森に、オーロックスは平原に、ムフロンは山岳にいる。肉は焼いて食べる：マトンは料理レベル5、豚は8、鹿肉は15。生皮は干し台にしばらく掛けておくと皮になる。干し台は作業台で棒4本とより糸3本から作れる（工作1）。1台作ろう。"),
    "quest.base.a_haunch_for_the_pot": ("A Haunch for the Pot", "鍋に入れるもも肉"),
    "quest.base.a_haunch_for_the_pot.why": ("Big game feeds a house for days, but only cooked. Roast a haunch at the campfire or the stove: mutton once your Cooking is 5, pork at 8, beef at 12, venison at 15. Cook one.", "大物は何日も家を養うが、焼いてこそ食べられる。焚き火かかまどでもも肉を焼こう：羊肉は料理レベル5、豚は8、牛は12、鹿肉は15から。1つ焼こう。"),
    "quest.base.a_line_of_snares": ("A Line of Snares", "くくり罠の列"),
    "quest.base.a_line_of_snares.why": ("While the big game is followed, a hunter of this age keeps a line of snares on the runs. Set four snares where rabbits and hares wander, go about your day, and come back for what they hold: three catches.", "大物を追うあいだも、この時代の狩人は獣道にくくり罠を並べておく。ウサギやノウサギのうろつくところに罠を4つ仕掛けて、いつもどおり過ごし、かかった獲物を3匹取りに戻ろう。"),
    "quest.base.full_hide_wraps": ("Full Hide Wraps", "獣皮の一揃い"),
    "quest.base.full_hide_wraps.why": ("A whole set guards head, body and legs. At the crafting table a hood takes five hides, a tunic eight and trousers seven. Rabbits, deer and boar drop raw hide; hung a while on a drying rack (four sticks and three twine), it turns to hide.", "一揃い着ると頭、胴、脚を守れる。作業台で、頭巾は皮5枚、上着は8枚、ズボンは7枚で作れる。ウサギやシカやイノシシが生皮を落とす。干し台（棒4本とより糸3本）にしばらく掛けておくと皮になる。"),
    "quest.base.copper_arms": ("Copper Arms", "銅の武具"),
    "quest.base.copper_arms.why": ("Copper hits harder and lasts longer than stone. Smelt ingots (ore over charcoal in the grid, Engineering 5), then at the crafting table make a copper sword (two ingots over a stick) and a copper shield (six ingots round a plank, as the recipe shows).", "銅は石より強く、長持ちする。インゴットを作り（銅鉱石を木炭の上に置く、工学レベル5）、作業台で銅の剣（インゴット2個の下に棒）と銅の盾（板材1枚のまわりにインゴット6個、レシピの形どおり）を作ろう。"),
    "quest.base.bow_and_arrow": ("Bow and Arrow", "弓と矢"),
    "quest.base.bow_and_arrow.why": ("A short bow reaches twenty blocks and hits twice as hard as a sling. At the crafting table, three sticks bent down one side and three twine down the other make it (Crafting 3). An arrow is a flint or a cobblestone over a stick over a feather, four at a time (Crafting 3): flint comes one gravel in eight, and feathers from junglefowl. The bow needs Ranged 3 to shoot (below it, it strikes as a fist), so keep slinging stones until then: a sling is a hide between two twine in a row at the crafting table. Make the bow and eight arrows, and reach Ranged 5.", "短弓は20ブロック先まで届き、投石器の倍の威力がある。作業台で、棒3本を片側に曲げて並べ、反対側により糸3本を並べると作れる（工作レベル3）。矢は火打ち石か丸石の下に棒、その下に羽根を並べて4本ずつ作る（工作レベル3）。火打ち石は砂利を壊すと8回に1回出て、羽根はヤケイから取れる。弓を射るには飛び道具レベル3が要り、それまでは素手で殴るのと同じなので、それまでは投石器で石を投げ続けよう。投石器は作業台で、皮1枚を横一列により糸2本で挟んで作る。弓と矢8本を作り、飛び道具レベル5を目指そう。"),
    "quest.base.every_arrow_counts": ("Every Arrow Counts", "一本も無駄にしない"),
    "quest.base.every_arrow_counts.why": ("An arrow that hits is left lying where the creature stood half the time; one that misses, or hits for nothing, is gone. Pick them up as you go and a quiver lasts. Make sixteen arrows in all and reach Ranged 8.", "当たった矢は、2回に1回、獲物のいた場所に落ちて残る。外れた矢や、0ダメージだった矢はなくなる。進みながら拾っていけば、矢筒が長持ちする。矢を合わせて16本作り、飛び道具を8にする。"),
    "quest.base.copper_mail": ("Copper Mail", "銅の鎧"),
    "quest.base.copper_mail.why": ("A copper helmet takes five ingots and a chestplate eight, at the crafting table (Engineering 5). They turn aside far more than hide does, and every ingot is ore you carried out of the hills.", "銅の兜はインゴット5個、胸当ては8個で、作業台で作る（工学レベル5）。獣皮よりずっと攻撃をそらすが、どのインゴットも丘から運んだ鉱石でできている。"),
    "quest.base.seasoned_fighter": ("Seasoned Fighter", "歴戦の戦士"),
    "quest.base.seasoned_fighter.why": ("Bigger animals and tougher monsters teach Attack faster. Keep fighting until you reach Attack 6; your health grows with Hitpoints as you go.", "大きな動物や手ごわい怪物ほど、攻撃が早く上がる。攻撃レベル6まで戦い続けよう。戦ううちにHPも伸びていく。"),
    "quest.base.tin_find": ("A Silvery Ore", "銀白色の鉱石"),
    "quest.base.tin_find.why": ("Tin is the other half of bronze. It needs Mining 10 and a pickaxe, so keep digging coal and copper to get there. Tin lies in the lower part of copper veins: where you found copper, dig below it. Mine three tin ore. Take three copper from the same seam: bronze wants both.", "スズは青銅のもう半分だ。採掘レベル10とつるはしが要るので、石炭や銅を掘ってレベルを上げよう。スズは銅の鉱脈の下のほうにある。銅を見つけたら、その下を掘ろう。スズ鉱石を3個掘ること。同じ鉱脈から銅も3つ。青銅には両方が要る。"),
    "quest.base.rock_collector": ("Rock Collector", "石集め"),
    "quest.base.rock_collector.why": ("Stone comes in many kinds, each with its own ore. The rock underfoot changes every few kilometres (granite, limestone, basalt, sandstone, slate), so dig down in different lands. Break six different rocks and ores, and your journal's Ores page fills in.", "石にはたくさんの種類があり、鉱石もそれぞれ違う。足もとの岩は数キロごとに変わる（花崗岩、石灰岩、玄武岩、砂岩、粘板岩）ので、違う土地で掘ってみよう。6種類の岩や鉱石を掘れば、図鑑の鉱石のページが埋まっていく。"),
    "quest.base.patient_angler": ("Patient Angler", "辛抱強い釣り人"),
    "quest.base.patient_angler.why": ("Every catch trains Fishing, and the bigger fish bite only at higher levels, in the seas and lakes your travels found (Far Horizons). A rod is three sticks on a diagonal at the crafting table, with two twine hanging from its tip. Fish until you reach Fishing 5, when sardines start biting in the sea.", "釣れるたびに釣りが上がり、大きな魚は高いレベルでしか食いつかない。旅で見つけた海や湖（「遠い地平線」）にそうした魚がいる。釣り竿は作業台で、棒3本を斜めに並べ、先端からより糸2本を垂らして作る。釣りレベル5まで釣ろう。海ではイワシが掛かり始める。"),
    "quest.base.many_kinds": ("Many Kinds of Fish", "さまざまな魚"),
    "quest.base.many_kinds.why": ("Rivers, lakes and the sea bite differently: minnows anywhere, sardines in the sea, perch in lakes from Fishing 10. Land two different kinds. Cook six of your catch: the best fish are worth a fire.", "川、湖、海では釣れるものが違う。ミノーはどこでも、イワシは海、パーチは釣りレベル10から湖で釣れる。2種類釣り上げよう。釣った魚を6匹焼こう。いい魚は火にかける価値がある。"),
    "quest.base.salt_and_sardines": ("Salt and Sardines", "塩とイワシ"),
    "quest.base.salt_and_sardines.why": ("Sardines bite only in salt water: cast into the sea, not a river or a lake. Take your rod to the coast, land four sardines and roast them at a fire (Cooking 5): a sardine heals as well as a minnow.", "イワシは塩水でしか食いつかない。川や湖ではなく海に投げよう。釣り竿を持って海辺へ行き、イワシを4匹釣って火で焼こう（料理レベル5）。イワシはミノーと同じだけ回復する。"),
    "quest.base.still_water_perch": ("Still Water Perch", "静かな水のパーチ"),
    "quest.base.still_water_perch.why": ("Perch keep to fresh water, rivers, lakes and ponds, and bite from Fishing 10. Reach Fishing 10 and land three. The fishers send bread home with you for your trouble.", "パーチは川、湖、池などの淡水にいて、釣りレベル10から食いつく。釣りレベル10になって3匹釣り上げよう。漁師からお礼にパンがもらえる。"),
    "quest.base.cold_water_trout": ("Cold Water Trout", "冷たい水のマス"),
    "quest.base.cold_water_trout.why": ("Where you fish matters as much as how well. Trout bite from Fishing 15, and only in cold fresh water: mountain streams, conifer lakes, cool and frozen rivers. Go up into the cold, land two and cook them: a trout wants Cooking 15, a step past the stew.", "どれだけうまく釣るかと同じくらい、どこで釣るかが大事だ。マスは釣りレベル15から、冷たい淡水でしか食いつかない。山の渓流、針葉樹林の湖、涼しい川や凍った川だ。寒い土地へ上がって2匹釣り、焼こう。マスを焼くには料理レベル15、シチューの一歩先の腕がいる。"),
    "quest.base.three_waters": ("Three Waters", "三つの水"),
    "quest.base.three_waters.why": ("Minnows bite anywhere, sardines in the sea, perch in lakes and rivers. Those three you know by now; land a fourth kind, a trout (Fishing 15, cold fresh water) or a cod (Fishing 20, the cold sea), and you know what bites where, and what is worth the walk.", "ミノーはどこでも、イワシは海、パーチは湖や川で食いつく。その3種類はもう知っている。4種類目として、マス(釣りレベル15、冷たい淡水)かタラ(釣りレベル20、冷たい海)を釣り上げれば、どこで何が釣れるか、どこまで歩く価値があるかがわかる。"),
    "quest.base.fish_on_the_table": ("Fish on the Table", "食卓に魚を"),
    "quest.base.fish_on_the_table.why": ("A home by the water eats well. With your hearth lit, cook eight fish of any kind and eat six of them: cooked fish heal well, and a meal of your own catch tastes of the place you live.", "水辺の家ではよく食べられる。炉に火を入れて、どんな魚でも8匹焼き、そのうち6匹を食べよう。焼いた魚はよく回復し、自分で釣った食事は住む土地の味がする。"),
    "quest.base.far_horizons": ("Far Horizons", "遠い地平線"),
    "quest.base.far_horizons.why": ("The world is big and each biome has its own animals, plants and ores. Stand in twelve different biomes.", "世界は広く、バイオームごとに動物も植物も鉱石も違う。12の異なるバイオームに立とう。"),
    "quest.base.what_sleeps_below": ("What Sleeps Below", "下に眠るもの"),
    "quest.base.what_sleeps_below.why": ("Farm chests lie further from where you began, on wilder land, and deeper: on cave floors ten blocks and more under the ground. A bone lockpick still opens one, as a pick of the age before always does: a bone on a twine grip at the crafting table (Crafting 5). Four in ten wake one or two cave crawlers as the lock gives. A crawler has twice a bat's health: come with a copper weapon and food. Open two Farm chests in all and bring down a cave crawler.", "農耕時代の宝箱は、始まりの地からもっと離れた荒々しい土地の、もっと深い場所にある。地面から10ブロック以上下の洞窟の床だ。前の時代のロックピックならいつでも開くので、骨のロックピックでも開く。骨のロックピックは作業台で、骨により糸の握りを付けて作る（工作レベル5）。宝箱の10個に4個で、鍵が開くと洞窟グモが1〜2匹目を覚ます。洞窟グモの体力はコウモリの2倍だ。銅の武器と食べ物を持って行こう。農耕時代の宝箱を合わせて2個開け、洞窟グモを1匹倒す。"),
    "quest.base.field_guide": ("Field Guide", "野外図鑑"),
    "quest.base.field_guide.why": ("Get right up close to fifteen kinds of animal, within three blocks with nothing in between. The journal's Animals page records each one, and what it drops once you have hunted it.", "15種類の動物のすぐそば（3ブロック以内、間に何もない所）まで近づこう。図鑑の動物のページに記録され、狩ればその落とし物も載る。"),
    "quest.base.a_table_for_two": ("A Table for Two", "ふたりのテーブル"),
    "quest.base.a_table_for_two.why": ("A home needs somewhere to sit. Furniture is made from oak, birch or dark oak planks. A stool is two planks over two sticks (Construction 1); benches and chairs follow. Make two seats at the crafting table and set them by the hearth. Planks on four sticks make a table (Construction 3). Set it near the hearth with a seat on each side; a roof and a table make a house a home.", "家には座る場所が要る。家具はオーク、シラカバ、ダークオークの板材で作る。スツールは板材2枚の下に棒2本（建築レベル1）、ベンチや椅子もそのあとで作れる。作業台で座席を2つ作って炉のそばに置こう。板材を棒の脚に載せるとテーブルになる（建築レベル3）。炉の近くに置き、両側に座席を並べよう。屋根とテーブルがあれば家らしくなる。"),
    "quest.base.shelves_and_cupboards": ("Shelves and Cupboards", "棚と戸棚"),
    "quest.base.shelves_and_cupboards.why": ("Somewhere to put things: a shelf (Construction 4) and a cupboard (Construction 6), both from planks at the crafting table. Make one of each.", "ものをしまう場所だ。棚（建築レベル4）と戸棚（建築レベル6）を、作業台で板材から作ろう。1つずつ。"),
    "quest.base.a_proper_bed": ("A Proper Bed", "ちゃんとしたベッド"),
    "quest.base.a_proper_bed.why": ("Sleep on something better than the ground: three wool over three oak, birch or dark oak planks at the crafting table (Construction 5). Place it in your home and right-click to sleep.", "地面よりましな寝床を。作業台で、羊毛3つの下にオーク、シラカバ、ダークオークのどれかの板材3枚を並べて作る（建築レベル5）。家に置き、右クリックで眠ろう。"),
    "quest.base.a_rug_underfoot": ("A Rug Underfoot", "足もとの敷物"),
    "quest.base.a_rug_underfoot.why": ("A homely home (A Homely Home) wants a rug, and wool from your flock (Wool Gathering) makes one. A cloth is a wool and a flower of the colour you want, side by side in the grid (Crafting 2): white from a daisy, yellow from a dandelion, red from a poppy. Daisies grow on plains, dandelions in flower meadows, poppies on the steppe. Make two, or weave them at a loom you set down. Two cloths side by side make three rugs (Crafting 3). A rush mat, four rushes woven at the table (Crafting 1), counts as a rug. Lay them on the floor; curtains, cushions and banners are made from cloth too.", "くつろげる家（「くつろげる家」）には敷物がほしい。群れの羊毛（「羊毛集め」）で作れる。布は、羊毛と好きな色の花を作業枠に並べて作る（工作レベル2）。白はヒナギク、黄色はタンポポ、赤はポピー。ヒナギクは平原に、タンポポは花の草原に、ポピーはステップに咲く。2枚作るか、置いた織機で織ろう。布2枚を並べると敷物が3枚できる（工作レベル3）。い草4本を編んだい草の敷物（工作レベル1）は敷物に数える。床に敷こう。カーテンやクッションや旗も布から作れる。"),
    "quest.base.earthenware": ("Earthenware", "素焼きの器"),
    "quest.base.earthenware.why": ("Fired clay makes plates, bowls, jars and jugs for the shelf. Two fired clay side by side make two plates, and three in a V make two bowls (Crafting 2); a jar takes three and a jug five (Crafting 3), and a basket is five twine. Make three pieces of crockery at the crafting table.", "焼き粘土から、棚に並べる皿、鉢、壺、水差しが作れる。焼き粘土2個を横に並べると皿が2枚、3個をV字に並べると鉢が2個できる（工作レベル2）。壺は3個、水差しは5個（工作レベル3）、かごはより糸5本でできる。作業台で器を3つ作ろう。"),
    "quest.base.a_lamp_of_clay": ("A Lamp of Clay", "土の油ランプ"),
    "quest.base.a_lamp_of_clay.why": ("A twine wick over two fired clay side by side makes an oil lamp (Crafting 4). It comes from the table dry: right-click it with fat in hand, lard or fatty raw meat such as pork or duck, and it burns five days before it wants filling again. Make two and set them down at home.", "焼き粘土2つを横に並べ、その上により糸の芯を置くと土の油ランプができる（工作レベル4）。できたては油がないので、脂（ラードか、豚肉や鴨肉のような脂の多い生肉）を持って右クリックしよう。5日燃えてから、また油が要る。2つ作って家に置こう。"),
    "quest.base.a_pot_on_the_chimney": ("A Pot on the Chimney", "煙突の壺"),
    "quest.base.a_pot_on_the_chimney.why": ("A chimney pot crowns a chimney and carries its smoke as stone does. Two fired clay down each side of the grid, the middle column empty, make two (Construction 3). Make them and set one on top of your chimney.", "煙突の壺は煙突のてっぺんに載せる焼き物で、石と同じように煙を通す。グリッドの左右の列に焼き粘土を2つずつ、真ん中の列を空けて置くと2つできる（建築レベル3）。作って、1つを煙突の上に置こう。"),
    "quest.base.candlelight": ("Candlelight", "ろうそくの明かり"),
    "quest.base.candlelight.why": ("With shelves and cupboards up (Shelves and Cupboards), light them: a twine wick over a lump of lard makes two candles (Crafting 3), and wild boar and brown bears drop lard; a cake of beeswax makes three, and two hides two. A candle is a softer light than a torch for a table or shelf.", "棚と戸棚ができたら（「棚と戸棚」）、明かりを置こう。ラード1個の上により糸の芯を置くとろうそくが2本できる（工作レベル3）。ラードはイノシシやヒグマが落とす。蜜ろう1個なら3本、皮2枚なら2本。テーブルや棚に置くと、松明より柔らかな明かりになる。"),
    "quest.base.food_enough": ("Food Enough", "食うに困らず"),
    "quest.base.food_enough.why": ("Food that lasts is a farm that works. Show any one: harvest twelve wheat and six carrots or rye (rye seed comes from village fields), keep four animals well fed and housed (condition at least 75), or land twenty-five fish. Ten loaves of bread are your reward.", "食べ物が絶えないのは、畑と家畜がうまく回っている証だ。次のどれかを示そう：小麦12とニンジンかライ麦6を収穫する（ライ麦の種は村の畑から取れる）、動物4頭を餌と住まいに恵まれた良い状態（コンディション75以上）で飼う、魚を25匹釣る。ごほうびにパンが10個もらえる。"),
    "quest.base.full_stone_kit": ("A Full Stone Kit", "石器そろえ"),
    "quest.base.full_stone_kit.why": ("A stone tool works twice as fast as a flint one and finds a little more. Carry the whole kit: pickaxe, axe, shovel (one stone head over two sticks), hoe and knife.", "石の道具は火打ち石の道具の2倍速く、少しだけ多く見つかる。ひと揃い持とう：ツルハシ、斧、シャベル（石の刃1個の下に棒2本）、くわ、ナイフ。"),
    "quest.base.flint_first": ("Flint First", "まずは火打ち石"),
    "quest.base.flint_first.why": ("Before stone, flint. Two flint over two sticks make a flint pickaxe, which breaks stone and the hard rock that stone heads come from. One stick over another makes a digging stick, a shovel for dirt and sand. Make both.", "石の前に火打ち石。火打ち石2つを棒2本の上に置くと火打ち石のつるはしになり、石や、石の刃のもとになる硬い岩を砕ける。棒を縦に2本並べると掘り棒になり、土や砂を掘るシャベルになる。両方作ろう。"),
    "quest.base.a_mended_edge": ("A Mended Edge", "刃を繕う"),
    "quest.base.a_mended_edge.why": ("Every tool wears as you work it: a flint one lasts fifty uses, a stone one three times that, and worn out it breaks. Mend it first at a chopping block: put the worn tool in the grid within reach of the block with one piece of what it is made of (a flint for a flint tool or a flint spear, a stone head for a stone tool, a stick for a digging stick). A tool made of a single such piece, such as a flint knife or a stone shovel, comes back whole; any other comes back half new. Mend a flint or stone tool, a flint spear or a digging stick by your chopping block.", "道具は使うほどすり減る。火打ち石の道具は50回、石の道具はその3倍もち、使い切ると壊れる。壊れる前に薪割り台で繕おう。台の届く所で、すり減った道具と、その材料1つ（火打ち石の道具や火打ち石の槍なら火打ち石、石の道具なら石の刃、掘り棒なら棒）を作業枠に置く。火打ち石のナイフや石のシャベルのように材料1つでできた道具は新品に戻り、ほかは半分よみがえる。薪割り台のそばで、火打ち石か石の道具、火打ち石の槍、または掘り棒を1つ繕おう。"),
    "quest.base.a_coin_purse": ("A Coin Purse", "財布"),
    "quest.base.a_coin_purse.why": ("Coins fill a pack fast. A hide and two twine (raw hide cures on a drying rack) make a coin purse that holds a thousand coins in one slot; right-click it to tip them out again. Make one.", "硬貨はすぐに荷物をいっぱいにする。なめし皮1枚とひも2本で財布ができ(生皮は干し台でなめせる)、1つの枠に硬貨を千枚入れられる。右クリックすればまた取り出せる。1つ作ろう。"),
    "quest.base.steps_and_slabs": ("Steps and Slabs", "段と板"),
    "quest.base.steps_and_slabs.why": ("A block need not be whole. Three planks in a row make six slabs, half a block high; six planks in a stair shape make four stairs (Construction 2). Make both and set down two of each: a step up to your door.", "ブロックは丸ごとでなくてもいい。板材3つを横に並べると半ブロックの高さのハーフブロックが6つ、階段の形に6つ並べると階段が4つできる(建築レベル2)。両方作って2つずつ置こう。戸口への段になる。"),
    "quest.base.a_fence_and_a_gate": ("A Fence and a Gate", "柵と門"),
    "quest.base.a_fence_and_a_gate.why": ("Three logs stood end on end make six posts; posts and sticks make fences (Construction 2), and a fence beside a slab and a fence makes a gate. Animals and most creatures take a fence as two blocks high: only a boss, or a fighter on a chase, climbs it. Set down six fences and a gate; right-click the gate to swing it open.", "丸太3本を縦に並べると柱が6本できる。柱と棒で柵ができ(建築レベル2)、柵、ハーフブロック、柵を並べると門になる。動物やたいていの生き物は柵を2ブロックの高さとみなし、乗り越えるのはボスか、追いかけている最中の戦う者だけだ。柵を6つと門を1つ置こう。門は右クリックで開く。"),
    "quest.base.dig_in": ("Dig In", "掘り進め"),
    "quest.base.dig_in.why": ("The hearth needs four clay, and clay lies on the bottom of ponds and lakes. A stone shovel digs four times faster than bare hands: make one, wade in and dig four.", "炉には粘土が4個要る。粘土は池や湖の底にある。石のシャベルは素手の4倍速く掘れる。作って水に入り、4個掘ろう。"),
    "quest.base.under_lock_and_key": ("Under Lock and Key", "鍵のかかった宝箱"),
    "quest.base.under_lock_and_key.why": ("Locked chests lie where the land hides them: on the floor of a shallow cave, or on a ledge under an overhang of rock, never out in the open or under water. Those near where you began are Nomad chests. A bone lockpick opens one: a bone on a twine grip, Crafting 5. Make one, find a chest and pick its lock.", "鍵のかかった宝箱は、土地が隠す場所にある。浅い洞窟の床や、張り出した岩の下の岩棚で、開けた場所や水の中には決してない。始まりの地の近くにあるのは遊牧時代の宝箱だ。骨のロックピックで開く。骨をより糸の柄に付けて作る（工作5）。1つ作り、宝箱を見つけて鍵を開けよう。"),
    "quest.base.light_sleepers": ("Light Sleepers", "眠りの浅いもの"),
    "quest.base.light_sleepers.why": ("What sleeps beside a chest under rock may wake as its lock gives: four Nomad chests in ten wake two to four cave bats. Have a weapon to hand before you pick the lock. Open two Nomad chests in all and bring down two cave bats.", "岩の下の宝箱のそばで眠っていたものは、鍵が開くと目を覚ますことがある。遊牧時代の宝箱の10個に4個で、洞窟コウモリが2〜4匹目を覚ます。鍵を開ける前に、武器を手元に用意しておこう。遊牧時代の宝箱を合わせて2個開け、洞窟コウモリを2匹倒す。"),
    "quest.base.stockpile": ("Stockpile", "備蓄"),
    "quest.base.stockpile.why": ("A home runs on common stock. Carry thirty-two logs and sixty-four cobblestone and nothing you want to build is a trip away. Woods give the logs fastest, and stone lies a few blocks under the dirt almost anywhere.", "家は身近な資材で回る。原木32個と丸石64個を持っていれば、建てたいものがすぐ建てられる。原木は森がいちばん早く集まり、石はほとんどどこでも土を数ブロック掘った下にある。"),
    "quest.base.copper_kit": ("Copper Kit", "銅の道具一式"),
    "quest.base.copper_kit.why": ("Copper works seven times as fast as a bare hand, a step above stone, and finds more; a tool's tooltip says how fast it works. Make an axe (three ingots), a shovel (one) and a knife (one), and a copper hoe (two). Each ingot is smelted from copper ore in the crucible of your lit kiln.", "銅は素手の7倍速く、石より一段上で、さらに多く見つかる。道具の説明に、どれだけ速く使えるかが出る。斧（延べ棒3本）、シャベル（1本）、ナイフ（1本）を作り、銅のくわ（2本）も持っておこう。延べ棒は、火の入った窯のるつぼで銅鉱石から製錬する。"),
    "quest.base.make_camp": ("Make Camp", "野営地"),
    "quest.base.make_camp.why": ("A camp is a bed and a light together. Put your sleeping bag down, set a torch beside it and sleep in it once: wherever you wake is your home, and a camp heals you a fifth faster.", "野営地とは、寝床と明かりが一緒にあること。寝袋を置き、その隣に松明を立てて、一度眠ってみよう。目覚める場所があなたの家になり、野営地では回復が2割速くなる。"),
    "quest.base.snug_for_winter": ("Snug for Winter", "冬に備えて"),
    "quest.base.snug_for_winter.why": ("With a proper bed (A Proper Bed) and candles (Candlelight), put a roof over the Hearth with the bed and two lights beside it, and the home turns snug: warm under a roof, you heal half as fast again there, and a night's sleep in it rests you better.", "ちゃんとしたベッド（「ちゃんとしたベッド」）とろうそく（「ろうそくの明かり」）がそろったら、炉に屋根をかけ、寝床と明かり2つをそばに置こう。家は居心地がよくなる。屋根の下で暖かく、回復が5割増しになり、眠ればよく休める。"),
    "quest.base.shut_the_door": ("Shut the Door", "戸を閉める"),
    "quest.base.shut_the_door.why": ("The night is dark and anything may wander in. Six planks of any wood make a wooden door at a table (Construction 2). Set it in a doorway two blocks high and it fills both; right-click to open or shut it. Shut, nothing walks through, and no creature opens it. Indoors at home behind a shut door you heal a tenth faster and keep a degree warmer (Door shut). Make a door, hang it, and shut yourself in.", "夜は暗く、何が入ってくるかわからない。どの木の板材でも6枚あれば、作業台で木の扉が作れる（建築レベル2）。高さ2マスの戸口に置くと上下ともふさがり、右クリックで開け閉めできる。閉めれば何も通り抜けられず、生き物が開けることもない。家の中で扉を閉めていれば、回復が1割速く、1°暖かい（「戸締まり」）。扉を作って取り付け、中に入って閉めよう。"),
    "quest.base.workshop_and_stove": ("A Stove and a Quern", "かまどと石臼"),
    "quest.base.workshop_and_stove.why": ("A home that works for you. A stove is a campfire under a row of three cobblestones with one more on each side of it, five in all (Construction 5). For the workshop, make one of these: quern stones are four stones (cobblestone fired in a pit kiln) in a square under a stick (Crafting 5); a spindle stand is an oak plank, a stick, a fired clay and a twine in a square (Crafting 6); a loom frame is oak planks, sticks, a twine and a fired clay (Crafting 8). All at the crafting table.", "あなたのために働く家。かまどは焚き火の上に丸石3個を一列に、両側に1個ずつ、計5個並べたもの（建築レベル5）。作業場には次のどれかを作ろう。石臼は棒の下に石（丸石を野窯で焼いたもの）4個を四角に（工作レベル5）、紡ぎ台はオークの板材1枚、棒1本、焼き粘土1個、より糸1本を四角に並べて（工作レベル6）、織機はオークの板材と棒とより糸と焼き粘土で作る（工作レベル8）。どれも作業台で作る。"),
    "quest.base.books_and_banners": ("Books and Banners", "本棚と旗"),
    "quest.base.books_and_banners.why": ("A bookshelf (planks and hides, Construction 8) and a banner (cloth and a stick, Crafting 5) say whose home this is. Make one of each.", "本棚（板材と皮、建築レベル8）と旗（布と棒、工作レベル5）は、ここが誰の家かを語る。それぞれ1つずつ作ろう。"),
    "quest.base.a_homely_home": ("A Homely Home", "くつろげる家"),
    "quest.base.a_homely_home.why": ("Room to sit, work and store: two seats, a table, two places to keep things and a third light under the roof. A homely home helps you learn a twentieth faster.", "座り、働き、しまう場所を。座る物2つ、テーブル、物をしまう場所2つ、屋根の下の3つ目の明かり。くつろげる家では経験が少し早く身につく。"),
    "quest.base.light_in_the_window": ("Light in the Window", "窓の明かり"),
    "quest.base.light_in_the_window.why": ("A lit home shows at night: a window glows by the light of the room behind it. A hide window is a hide in a frame of eight sticks (Construction 3), two at a time. Make two and set them in the walls of your lit home, then look back at it after dark.", "明かりのともった家は夜に目立つ。窓は奥の部屋の明かりで光る。皮の窓は皮1枚を棒8本の枠に張って作り（建築レベル3）、一度に2枚できる。2枚作って明かりのある家の壁にはめ、日が暮れてから振り返ってみよう。"),
    "quest.base.a_cosy_home": ("A Cosy Home", "居心地のよい家"),
    "quest.base.a_cosy_home.why": ("Soft and bright: two rugs, two curtains, a cushion, three pieces of crockery and a fourth light. A cosy home heals you faster and teaches a tenth more, and a night in it is a deep rest.", "柔らかく明るく。敷物2枚、カーテン2枚、クッション1つ、食器3つ、4つ目の明かり。居心地のよい家では回復が速く、経験が1割増え、眠れば深く休める。"),
    "quest.base.heart_of_the_home": ("Heart of the Home", "家の中心"),
    "quest.base.heart_of_the_home.why": ("Everything a home needs: a bookshelf, a stove or cauldron, a quern, spindle or loom, and a banner, all in a cosy home. Heal twice as fast and learn an eighth more where you live.", "家に必要なすべてを。本棚、かまどか大釜、石臼・紡ぎ台・織機のどれか、旗を、居心地のよい家に揃える。ここでは回復が2倍速く、経験が8分の1増える。"),
    "quest.base.ore_run": ("An Ore Run", "鉱石の遠征"),
    "quest.base.ore_run.why": ("Bronze needs a good store of ore. With a copper kit you dig fast: bring up twenty-four copper, nine tin and twelve coal ore, and the crucible will not wait on you. Copper lies below sea level with tin in the lower part of the same vein, coal in seams near sea level; small copper and coal stones lying on the ground mark the veins below.", "青銅には鉱石の蓄えがいる。銅の道具なら掘るのも速い。銅24、錫9、石炭鉱石12を掘り出せば、るつぼを待たせずに済む。銅は海面より下にあり、錫は同じ鉱脈の下のほうに、石炭は海面近くの層にある。地面に転がる銅や石炭の小石が、真下の鉱脈の印だ。"),
    "quest.base.a_place_to_pray": ("A Place to Pray", "祈りの場"),
    "quest.base.a_place_to_pray.why": ("An altar is built of stone bricks, and bricks are cut from smooth stone. Load cobblestone into your pit kiln as you do clay: it comes out as stone. Four stone in a square make four stone bricks, and seven bricks (three across the top, one in the middle, three across the bottom) make a stone altar at the crafting table (Construction 5). Place it and right-click it: your prayer points fill, and a bone in hand is offered for Magic experience. Then press C and open Prayers to turn Bark Skin on.", "祭壇は石レンガでできていて、レンガはなめらかな石から切り出す。粘土と同じように野窯に丸石を入れると、石になって出てくる。石4個を四角に並べると石レンガが4個でき、レンガ7個（上に3個、真ん中に1個、下に3個）を作業台に並べると石の祭壇になる（建築レベル5）。置いて右クリックすると祈りの力が満ち、骨を持っていれば捧げて魔法の経験値になる。Cキーから「祈り」を開いて、樹皮の肌をオンにしよう。"),
    "quest.base.bones_for_the_altar": ("Bones for the Altar", "祭壇に骨を"),
    "quest.base.bones_for_the_altar.why": ("Each bone offered at the altar is 16 Magic experience. At Magic 4 Ember Arm opens, a little more melee damage; at Magic 10, Mending, which brings your health back twice as fast. Offer bones until you reach Magic 6.", "祭壇に捧げた骨は1個につき魔法の経験値16。魔法レベル4で熾火の腕（近接ダメージが少し増える）、魔法レベル10で癒やし（体力が2倍の速さで戻る）が開く。魔法レベル6になるまで骨を捧げよう。"),
    "quest.base.folk_of_the_road": ("Folk of the Road", "旅の人々"),
    "quest.base.folk_of_the_road.why": ("Once you have been about a while, people pass by now and then: a pedlar with a hound, berry pickers, a hunter sitting hurt by the path, a child who has lost the way. They come at the edge of sight, and not often, so watch the land around you. Walk up and right-click one; most want something you hold (a hide, a bone, food) and give something back. Deal with one of them.", "しばらく過ごしていると、ときどき人が通りかかる。犬を連れた行商人、木の実摘み、道ばたで傷ついて座る狩人、道に迷った子ども。視界の端に現れるが、めったに来ないので、まわりの土地に目を配ろう。近づいて右クリックしよう。たいていは手に持っている物（皮、骨、食べ物）を欲しがり、代わりに何かをくれる。誰か一人と取引しよう。"),
    "quest.base.a_kind_turn": ("A Kind Turn", "親切なひと手間"),
    "quest.base.a_kind_turn.why": ("Not everyone on the road is well. A child who followed a butterfly wanders one spot, lost; a hunter sits hurt by the path. Food in your hand is what both need: right-click them holding it. The child then follows you to the nearest settlement, where the family thanks you; the hunter shows you a trick of the hunt.", "道を行く人が皆元気なわけではない。蝶を追いかけた子どもは迷って一か所をうろうろし、狩人は道ばたで傷ついて座っている。どちらにも必要なのは手に持った食べ物だ。持ったまま右クリックしよう。子どもは一番近い集落までついて来て、家族がお礼をくれる。狩人は狩りのこつを教えてくれる。"),
    "quest.base.something_for_something": ("Something for Something", "物には物を"),
    "quest.base.something_for_something.why": ("Folk on the road swap. A pedlar with a hound takes a hide, bone or feather for twine, seed mix or bread; berry pickers give a loaf for eight berries; woodcutters four coins for eight logs; charcoal burners two charcoal for a dozen logs. Hold what they want and right-click one of them.", "旅の人々は物を交換する。犬連れの行商人は皮か骨か羽根を、ひもか種の詰め合わせかパンと替えてくれる。木の実摘みは木の実8個でパン1つ、木こりは丸太8本で硬貨4枚、炭焼きは丸太12本で木炭2つ。相手の欲しい物を持って、誰かを右クリックしよう。"),
    "quest.base.a_bench_to_work_at": ("A Bench to Work At", "仕事台"),
    "quest.base.a_bench_to_work_at.why": ("Set your crafting table at home with a seat and a light beside it: a stool is two planks over two sticks (Construction 1), and a torch is the light. At home you then craft and build as if a level higher.", "家に作業台を置き、そばに腰かけと明かりを置こう。スツールは板2枚の下に棒2本（建築レベル1）、明かりは松明でいい。家では、作業と建築が1レベル上のようにできる。"),
    "quest.base.pantry_shelves": ("Pantry Shelves", "食料棚"),
    "quest.base.from_the_shelves": ("From the Shelves", "棚から並べる"),
    "quest.base.from_the_shelves.why": ("No need to carry it all: at home, open your pack, look a recipe up (U or R over an item) and press Lay. The grid fills from your pack and from every store in your home, nearest first, so a crate stack of planks by the bed is a woodshed to craft from. Shift lays as many as will go. Put planks in a store and lay three recipes from it.", "全部を持ち歩かなくていい。家で荷物を開き、アイテムの上でUかRを押してレシピを開き、「並べる」を押そう。荷物と家じゅうの蓄えから、近いものから順に作業枠が埋まる。寝床のそばの積み箱に板材を入れておけば、そのまま薪小屋として使える。Shiftを押すと入るだけ並べる。蓄えに板材を入れ、そこからレシピを3回並べよう。"),
    "quest.base.put_it_away": ("Put It Away", "片付け"),
    "quest.base.put_it_away.why": ("Back from a day out with a full pack, there is no need to sort it by hand. At home, press H (the Put away key in the settings): every stack in your pack whose kind a store in your home already holds goes into that store, nearest first, and your hotbar stays as it is. Keep a few planks in a crate stack, carry more home and put thirty-two away.", "一日出歩いて荷物がいっぱいでも、手で仕分けなくていい。家でH(設定の「片付けキー」)を押すと、家の収納にすでに入っている種類のスタックが、近い収納から順にそこへしまわれる。ホットバーはそのまま。積み箱に板材を少し入れておき、もっと持ち帰って32枚しまおう。"),
    "quest.base.pantry_shelves.why": ("Two places to store things by a fire make a pantry: the good a meal does lasts a quarter longer when you eat it there. A crate stack is five planks and a stick (Construction 2); a basket of five twine works too (Crafting 3). A campfire by your bed is fire enough.", "火のそばに物をしまう場所を2つ置くと食料庫になる。そこで食べた食事の効き目が4分の1長く続く。積み箱は板5枚と棒1本（建築レベル2）、ひも5本のかごでもいい（工作レベル3）。寝床のそばのたき火で火は足りる。"),
    "quest.base.company_at_camp": ("Company at Camp", "野営地の仲間"),
    "quest.base.company_at_camp.why": ("An animal you keep, near your home, is company: you heal a tenth faster there. Tame one close to your bed or hearth, where the junglefowl or rabbits graze, so it is kept within your home's reach.", "家の近くで飼っている動物は仲間になる。そこでは回復が1割速くなる。ヤケイやウサギが草を食べている、寝床や炉の近くで1匹飼い慣らせば、家の範囲で飼っていることになる。"),
    "quest.base.a_varied_table": ("A Varied Table", "いろいろな食卓"),
    "quest.base.a_varied_table.why": ("One food grows dull and heals little. Cook six meat at a fire, cook four fish, and bake three bread: every kind comes from a different part of the land, and together they keep you going.", "同じ食べ物ばかりでは飽きるし、あまり回復しない。火で肉を6、魚を4焼き、パンを3つ作ろう。どれも土地の別の場所から来るもので、合わせれば体がもつ。"),
    "quest.base.a_proper_workshop": ("A Proper Workshop", "本物の工房"),
    "quest.base.a_proper_workshop.why": ("Under a roof, beside your bench, seat and two lights, add a loom frame, spindle stand or quern and two places to store things. At home you then craft and build as if two levels higher, and engineer a level higher.", "屋根の下で、仕事台と腰かけと明かり2つのそばに、機織り台か糸車か石臼と、物をしまう場所を2つ加えよう。家では、作業と建築が2レベル上、工学が1レベル上のようにできる。"),
    "quest.base.a_larder": ("A Larder", "貯蔵庫"),
    "quest.base.a_larder.why": ("Four places to store things, a stove or cauldron and a table, under a roof by the fire: meals eaten here heal a fifth more and their good lasts half again as long.", "物をしまう場所を4つ、かまどか大鍋、テーブルを、屋根の下の火のそばに置こう。ここで食べる食事は回復が5分の1増え、効き目が1.5倍長く続く。"),
    "quest.base.kitchen_garden": ("A Kitchen Garden", "家庭菜園"),
    "quest.base.kitchen_garden.why": ("Sow four crops within reach of your home, at any stage of growth: meals eaten at home heal a tenth more. Water carriers on the road sometimes pour their pails on a field near water.", "家の範囲に作物を4つ植えよう。育ち具合は問わない。家で食べる食事の回復が1割増える。旅の水運びが、水辺の畑に桶の水をまいてくれることもある。"),
    "quest.base.a_full_house": ("A Full House", "にぎやかな家"),
    "quest.base.a_full_house.why": ("Keep four animals about the house: you heal a fifth faster and learn a little more at home. Junglefowl, mallards and mouflon tamed near home all count.", "家のまわりで動物を4匹飼おう。家では回復が5分の1速くなり、少し多く学べる。家の近くで飼い慣らしたヤケイもマガモもムフロンも数に入る。"),
    "quest.base.many_travellers": ("Many Travellers", "たくさんの旅人"),
    "quest.base.many_travellers.why": ("Every kind of traveller wants something different and gives something different: a smith whets your edges for a coin, a cartographer far from where the world began tells the way to town, a fortune teller reads what lies near, a hermit points to a wonder. Deal with five different kinds.", "旅人はそれぞれ欲しい物も、くれる物も違う。鍛冶屋は硬貨1枚で刃を研ぎ、世界の始まりから遠くにいる地図職人は町への道を教え、占い師は近くにある物を読み、隠者は不思議な場所を指し示す。5種類の旅人と取引しよう。"),
    "quest.base.farmers_on_the_road": ("Farmers on the Road", "道行く農夫"),
    "quest.base.farmers_on_the_road.why": ("Farming folk pass by those with a home. A harvest family trades each crop for the next you can sow, a goose girl gives feathers for four wheat seeds, a cowherd fills a pail held out, and a shepherd teaches a beginner who offers food. Deal with one of them.", "家のある人のところには、農家の人々が通りかかる。収穫の一家は作物を次に植えられる作物と替え、ガチョウ番の娘は小麦の種4つで羽根をくれ、牛飼いは差し出した桶を満たし、羊飼いは食べ物をくれた初心者に教えてくれる。誰か一人と取引しよう。"),
    "quest.base.safe_home": ("Safe Home", "安全な家"),
    "quest.base.safe_home.why": ("Some on the road need more than food. A family fled from a raid sits waiting: a meal, and one of them follows you home to stay. A prisoner marched in ropes goes free for three coins, a knife or a fight. A hurt traveller by the road is bait for raiders: win, and he thanks you.", "食べ物だけでは足りない人もいる。襲撃から逃げてきた一家が座って待っている。食事を渡せば一人が家までついて来て住みつく。縄で引かれる囚人は、硬貨3枚か、ナイフか、戦いで自由になる。道ばたの傷ついた旅人は盗賊のおとりだ。勝てば感謝される。"),
    "quest.base.altar_rites": ("Altar Rites", "祭壇の儀式"),
    "quest.base.altar_rites.why": ("Hold a bone and right-click your altar, three times: each bone is taken for Magic experience, and your prayer points fill. Then press C, open Prayers and turn Bark Skin on: blows land a little softer while your points last.", "骨を持って祭壇を右クリックするのを3回。骨は1本ずつ魔法の経験値として受け取られ、祈りの力が満ちる。それからCキーで「祈り」を開き、樹皮の肌をオンにしよう。力が続くあいだ、受ける打撃が少し軽くなる。"),
    "quest.base.a_prayer_in_the_fight": ("A Prayer in the Fight", "戦いの祈り"),
    "quest.base.a_prayer_in_the_fight.why": ("At Magic 4 Ember Arm opens: a little more melee damage while it is on. Turn it on before a fight, and Bark Skin with it (three times in all), and have ten creatures defeated. Turn them off when the fight is done: points come back only while no prayer is on.", "魔法レベル4で熾火の腕が開く。オンのあいだ、近接攻撃が少し強くなる。戦いの前にオンにし、樹皮の肌も一緒に（合わせて3回）オンにして、生き物を10体倒そう。戦いが終わったらオフに。祈りがひとつもオンでないときだけ、力が戻る。"),
    "quest.base.caught_in_the_rain": ("Caught in the Rain", "雨に降られて"),
    "quest.base.caught_in_the_rain.why": ("Rain and snow catch travellers out in the open, and they huddle where it found them. Hold up a torch to warm them and they press a coin on you; share food and they tell you of the ledge they sheltered under, with ore showing in it.", "雨や雪は野外の旅人を足止めし、彼らはその場で身を寄せ合う。松明を掲げて温めてやれば硬貨をくれる。食べ物を分ければ、雨宿りした岩棚に鉱石がのぞいていた話をしてくれる。"),
    "quest.base.neighbourly": ("Neighbourly", "ご近所づきあい"),
    "quest.base.neighbourly.why": ("Once your hearth is lit, neighbours from over the hill may call while you are near home. The first to call bring a plate for the house, crockery toward a cosy home; share a cooked meal and they leave seed for the garden.", "炉に火が入ると、家の近くにいるときに丘の向こうから隣人が訪ねてくることがある。最初に来た人は家に皿を持ってきてくれる。居心地のよい家の食器になる。料理を分ければ、畑の種を置いていく。"),
    "quest.base.the_rain_dance": ("The Rain Dance", "雨乞いの踊り"),
    "quest.base.the_rain_dance.why": ("In a dry spell, rainmakers dance on grassland, savanna and scrub. Stand and watch the dance through and go off refreshed, or pay them two coins and the rain comes for ten minutes: the glimmer koi rises only in rain.", "日照りが続くと、草地やサバンナや低木地で雨乞いの人々が踊る。踊りを最後まで見れば元気が出る。硬貨2枚を払えば10分間雨が降る。きらめく鯉は雨のときしか上がってこない。"),
    "quest.base.filled_again": ("Filled Again", "ふたたび満ちる"),
    "quest.base.filled_again.why": ("A priest bearing a little shrine walks the roads with pilgrims. Spend some prayer first: one short of it is filled again, once. A beginner at Magic is shown the first prayer.", "小さな祠を背負った司祭が、巡礼者と道を行く。先に祈りの力を使っておこう。足りない人は一度だけ満たしてもらえる。魔法の初心者は最初の祈りを教わる。"),
    "quest.base.a_share_of_the_hunt": ("A Share of the Hunt", "狩りの分け前"),
    "quest.base.a_share_of_the_hunt.why": ("Hunting parties chase boar and deer by day, a trapper takes rabbits, hares and pheasant, and by night wolf hunters come after the wolves near homes. Strike their quarry first, before they bring it down, and they give you a share.", "昼は狩りの一行がイノシシやシカを追い、わな猟師はウサギやノウサギやキジを捕る。夜には狼狩りが家の近くの狼を追う。彼らが仕留める前に獲物に先に一撃を入れれば、分け前をくれる。"),
    "quest.base.fired_whole": ("Fired Whole", "焼き上がり"),
    "quest.base.fired_whole.why": ("A potter and an apprentice dig clay at river banks and wet ground near folk's homes. Hand them clay and it comes back fired in their kiln, none cracked, one kept, up to eight; a beginner who shows a fired piece learns to throw a pot. Have clay fired by them, and fire twenty-four clay in all. The reward is six gold coins from the potters.", "陶工と弟子が、家のある人の近くの川岸や湿地で粘土を掘っている。粘土を渡すと窯で焼いて返してくれる。ひびは一つもなく、手間賃に一つ取る(八個まで)。焼き粘土を見せた初心者は、つぼの作り方を教わる。彼らに粘土を焼いてもらい、合わせて24個の粘土を焼こう。報酬は陶工からの金貨6枚。"),
    "quest.base.coal_by_road": ("Coal by Road", "街道の石炭"),
    "quest.base.coal_by_road.why": ("Coal carters walk sacks of coal to the nearest town, and miners caught by the dark far from home sit waiting for a light. Keep with the carters to the town, or give the miners a lump of coal or charcoal to light their lamp again; both say where coal shows at the surface. Then make sixteen torches: coal or charcoal over a stick makes four.", "石炭運びが袋の石炭を近くの町まで運び、家から遠くで日の暮れた鉱夫たちは明かりを待って座っている。石炭運びに町までついて行くか、鉱夫たちに石炭か木炭を一つ渡してランプをともし直そう。どちらも地表に石炭が出ている場所を教えてくれる。それから松明を16本作ろう。棒の上に石炭か木炭で4本できる。"),
    "quest.base.the_last_sheaf": ("The Last Sheaf", "最後の麦束"),
    "quest.base.the_last_sheaf.why": ("At harvest, villagers carry the last sheaf round the fields near folk's homes, singing. Put three of your wheat on their dolly while crops grow within 32 blocks, and the crops about them grow on a stage; a beginner learns the sowing song. Meet them, and bring in twelve wheat. The reward is seed for a bigger field.", "収穫のころ、村人たちが歌いながら最後の麦束を家の近くの畑に運んで回る。32ブロック以内に作物が育っているときに小麦3つを台車にのせると、まわりの作物が一段育つ。初心者は種まきの歌を教わる。彼らに会い、小麦を12本収穫しよう。報酬は畑を広げるための種。"),
    "quest.base.mice_in_the_stores": ("Mice in the Stores", "蔵のネズミ"),
    "quest.base.mice_in_the_stores.why": ("At dusk a piper may come by homes, the field mice of folk's stores at his heels. Follow him to the end of his tune and he leaves the seed they would have eaten. Keep a pantry by your fire as well, two crates or baskets beside it, so your stores are worth the guarding.", "夕暮れどき、家の近くに笛吹きが来ることがある。かかとには人々の蔵の野ネズミたち。曲の終わりまでついて行けば、ネズミが食べるはずだった種を置いていく。火のそばに食料置き場(木箱か籠を二つ)も作って、守る価値のある蔵にしよう。"),
    "quest.base.the_keepers_word": ("The Keepers' Word", "番人の言葉"),
    "quest.base.the_keepers_word.why": ("A poacher stalks deer in the woods at dusk: be there when he takes one and he cuts you a share, or face him with a weapon in hand (Attack 10) and he leaves. Gamekeepers follow on his trail and say which way he went, and on a later day, once you can fight, his gang may lie in wait for you. Deal with all three.", "夕暮れの森で密猟者が鹿を狙う。仕留めるところに居合わせれば肉を分けてくれるし、武器を手に（攻撃10）向き合えば去っていく。そのあとを番人たちが追い、どちらへ行ったか教えてくれる。後日、戦えるようになったころ、密猟者の一味が待ち伏せしているかもしれない。三者すべてと関わろう。"),
    "quest.base.catch_up_the_shrine": ("Catch Up the Shrine", "祠に追いつく"),
    "quest.base.catch_up_the_shrine.why": ("Pilgrims who fell behind the shrine bearer walk the roads after it, asking which way it went. They point you after it too, and a loaf from you buys their prayers. Meet the shrine bearer and the stragglers both.", "祠を運ぶ一行に遅れた巡礼者たちが、そのあとを追って道を歩き、どちらへ行ったか尋ねてくる。彼らは祠の方角を教えてくれ、パンを一つ渡せば祈りを分けてくれる。祠を運ぶ司祭と、遅れた巡礼者の両方に会おう。"),
    "quest.base.wedding_to_christening": ("From Wedding to Christening", "婚礼から洗礼へ"),
    "quest.base.wedding_to_christening.why": ("A wedding party walks the open country behind a priest: a flower for the bride, and they share bread and good cheer. Some days later the same folk may pass again with a child to be christened. Bring a loaf for the feast, and the priest's blessing restores your prayer. Meet both.", "司祭を先頭に、婚礼の一行が開けた土地を歩く。花嫁に花を一輪渡せば、パンと上機嫌を分けてくれる。数日後、同じ人々が洗礼を受ける子を連れて再び通ることがある。宴のためにパンを持っていけば、司祭の祝福で祈りが回復する。両方に会おう。"),
    "quest.base.those_taken_in": ("Those Taken In", "迎え入れた人々"),
    "quest.base.those_taken_in.why": ("Refugees roam near homes, hungry. Food in your hand and they follow you home, where they thank you with seed. Days later their kin come looking for them and camp near your home to thank you too. Take them in, then meet their kin.", "家の近くを、飢えた避難民がさまよう。食べ物を手に話しかけると家までついてきて、種でお礼をしてくれる。数日後、その身内が探しに来て、家の近くに野営し、同じくお礼をしてくれる。避難民を迎え入れ、その身内にも会おう。"),
    "quest.base.first_metal": ("First Metal", "初めての金属"),
    "quest.base.first_metal.why": ("A smith and a helper may camp in the woods with a bloomery; a beginner at Engineering learns to work the bellows there, and hands them two copper ore to see them smelt it. Deal with them, and mine four copper ore of your own for your kiln's crucible.", "鍛冶屋と手伝いが森に炉を据えて野営していることがある。工学の初心者はそこでふいごの扱いを教わり、銅鉱石を2個渡して精錬するところを見せてもらえる。彼らと関わり、自分の窯のるつぼのために銅鉱石を4個掘ろう。"),
    "quest.base.a_hen_of_your_own": ("A Hen of Your Own", "自分のめんどり"),
    "quest.base.a_hen_of_your_own.why": ("A henwife drifts over the grassland with her hens. Once you have a home and Farming 3, six wheat seeds buy a hen she hands to you; four feathers buy two eggs. Keep the hen near your home, as company there.", "めんどりを連れた鶏飼いの女が草地を渡り歩く。家があり農業3なら、小麦の種6個でめんどりを一羽ゆずってくれる。羽根4枚なら卵2個。めんどりを家の近くで飼って、家の仲間にしよう。"),
    "quest.base.master_and_journeyman": ("Master and Journeyman", "親方と職人"),
    "quest.base.master_and_journeyman.why": ("A child may tag along behind you for a while, watching you work. Once you are good at something (Farming, Mining or Crafting 15), they ask to learn it and pay a coin for the lesson. Days later they pass again as a journeyman, with a gift for their old teacher. Teach them, then meet the journeyman.", "しばらくのあいだ、子どもがあとをついて回り、仕事ぶりを見ていることがある。何かに長けていれば（農業・採掘・製作のどれかが15）、それを教えてほしいと頼み、授業料に金貨を1枚払う。数日後、職人になって再び通りかかり、昔の師匠に贈り物をくれる。教えてから、その職人に会おう。"),
    "quest.base.fang_and_stick": ("Fang and Stick", "牙と棒"),
    "quest.base.fang_and_stick.why": ("A trophy can be a tool. Wolves, lynx and bears drop a fang now and then; lash one to a stick and it is a fang dagger (Crafting 10), quick in the hand. Make one.", "戦利品は道具にもなる。オオカミ、オオヤマネコ、クマはときどき牙を落とす。牙を棒にくくりつければ牙の短剣になる(工作レベル10)。手になじんで素早く振れる。1本作ろう。"),
    "quest.base.lanterns_of_cloth": ("Lanterns of Cloth", "布の灯り"),
    "quest.base.lanterns_of_cloth.why": ("A cloth over a torch, hung from a stick, is a paper lantern (Crafting 6): a soft light in any colour you dyed. Make two and set them down at home; each one counts as a light.", "棒に下げたたいまつに布をかぶせると紙灯籠になる(工作レベル6)。染めた布の色でやわらかく光る。2つ作って家に置こう。どれも明かりとして数えられる。"),
    "quest.base.a_dooryard": ("A Dooryard", "戸口の庭"),
    "quest.base.a_dooryard.why": ("A home is more than its walls. Three cloths over three sticks make awnings (Crafting 8); hang one over your door. Twine over two cloths makes bunting (Crafting 7). Set two things out under the open sky about the door, bunting, a bench or a hay bale, and stand in your yard: there you heal a little faster.", "家は壁だけではない。布3枚を棒3本の上に並べると日よけになる(工作レベル8)。1つを戸口の上に掛けよう。布2枚の上にひもを並べると旗飾りになる(工作レベル7)。戸口のまわりの空の下に、旗飾り、ベンチ、干し草の束などを2つ置き、庭に立とう。そこでは少し早く回復する。"),
    "quest.base.five_colours": ("Five Colours", "五つの色"),
    "quest.base.five_colours.why": ("Every flower dyes a cloth its own colour: look a cloth up in the recipe book to see which. Wind flags take five, indigo, white, red, green and amber, tied on one twine (Crafting 9). Dye all five at the loom, or all five in the grid, then make the flags.", "花はそれぞれの色に布を染める。どの花かはレシピ本で布を調べればわかる。風の旗には藍、白、赤、緑、琥珀の5色を1本のひもに結ぶ(工作レベル9)。5色すべてを織機で、または5色すべてを製作枠で染めてから旗を作ろう。"),
    "quest.base.the_market_road": ("The Market Road", "市場への道"),
    "quest.base.the_market_road.why": ("Market folk walk the roads to the nearest town: a trader and farmers, sometimes a hound. Keep with them the whole way and at the town they share their bread; on the road, eight wheat sell for a coin. Either way is a dealing. Where market folk walk the road to town, highwaymen may come a little after and lie in wait for travellers who can fight. Meet the market folk, and when the highwaymen spring their ambush, win: they give up a purse.", "市場へ向かう人々が、一番近い町への道を歩いている。商人と農夫たち、ときには犬も。最後まで一緒に歩けば、町でパンを分けてくれる。道中なら小麦8つが硬貨1枚になる。どちらでも取引になる。市場の人々が町への道を歩いたあと、少し遅れて追いはぎがやってきて、戦える旅人を待ち伏せすることがある。市場の人々に会い、追いはぎが襲ってきたら打ち負かそう。財布を差し出して逃げていく。"),
    "quest.base.found_and_thanked": ("Found and Thanked", "見つかった子"),
    "quest.base.found_and_thanked.why": ("A child lost far from home wanders one spot. Food in your hand and they follow you to the nearest settlement. Days later the parents come looking for you near your home, with coins and bread for your trouble. Bring the child home, then meet the parents.", "家から遠く離れた場所で、迷子の子どもが同じ所をうろうろしている。食べ物を手に話しかけると、近くの集落までついてくる。数日後、両親が家の近くまでお礼に来て、金貨とパンをくれる。子どもを送り届け、両親に会おう。"),
    "multiblock.base.bellows_bloomery": ("Bellows Bloomery", "ふいご付き塊鉄炉"),
    "multiblock.base.bellows_bloomery.hint": ("The bloomery needs kiln bricks round it with bellows in the ring, and a hollow shaft of kiln bricks two more blocks high above it.", "塊鉄炉には、ふいごを含む窯レンガの囲いと、その上に2ブロック高い窯レンガの中空の煙突が必要です。"),
    "multiblock.base.coke_oven": ("Coke Oven", "コークス炉"),
    "multiblock.base.coke_oven.hint": ("The coke oven needs a chamber of kiln bricks three on a side round a hollow middle, with the oven in the middle of one side.", "コークス炉には、中が空洞の一辺3ブロックの窯レンガの部屋が必要で、炉は一面の真ん中に置きます。"),
    "multiblock.base.blast_furnace": ("Blast Furnace", "高炉"),
    "multiblock.base.blast_furnace.hint": ("The blast furnace needs kiln bricks round it with bellows in the ring, and a hollow shaft of kiln bricks three more blocks high above it.", "高炉には、ふいごを含む窯レンガの囲いと、その上に3ブロック高い窯レンガの中空の煙突が必要です。"),
    "multiblock.base.turbine_hall": ("Turbine Hall", "タービンホール"),
    "multiblock.base.turbine_hall.hint": ("The turbine hall needs a hall of HV casing five long, three wide and three high, hollow along its middle, with the turbine hall in the middle of the top of one end.", "タービンホールには、長さ5・幅3・高さ3の高圧外装の建屋が必要です。中央の列は空洞にし、片方の端の上段の中央にタービンホールを置きます。"),
    "multiblock.base.processing_array": ("Processing Array", "加工アレイ"),
    "multiblock.base.processing_array.hint": ("The processing array needs a cube of HV casing three on a side, hollow in the middle, with the processing array in the middle of one face.", "加工アレイには、一辺3の高圧外装の立方体が必要です。中央は空洞にし、一つの面の中央に加工アレイを置きます。"),
    "effect.base.bedside": ("Bedside", "枕辺"),
    "effect.base.bedside.description": ("A seat and two lights by your bed: 2° warmer here, and a night's sleep is well rested.", "寝床のそばに椅子と明かりが2つ。ここでは2°暖かく、夜に眠ればぐっすり休める。"),
    "effect.base.soft_furnishings": ("Soft furnishings", "柔らかな調度"),
    "effect.base.soft_furnishings.description": ("A rug underfoot and cloth hung on the wall keep the draught off: 1° warmer here.", "足もとにラグ、壁に掛けた布。すきま風が入らず、ここでは1°暖かい。"),
    "effect.base.herb_nook": ("Herb nook", "薬草の隅"),
    "effect.base.bright_room": ("Bright room", "明るい部屋"),
    "effect.base.bright_room.description": ("Daylight through two windows: you learn a twentieth more here, and heal a twentieth faster.", "2つの窓から日が差す。ここでは経験が20分の1増え、回復が20分の1速い。"),
    "effect.base.hearth_corner": ("Hearth corner", "炉の隅"),
    "effect.base.bedchamber": ("Bedchamber", "寝間"),
    "effect.base.bedchamber.description": ("A bed, a blanket chest at its foot, a washstand and a rug under one roof: 1° warmer here, and you heal a tenth faster.", "寝床、その足もとに長持、洗面台、敷物がひとつ屋根の下に。ここでは1°暖かく、回復が1割速い。"),
    "effect.base.kitchen": ("Kitchen", "台所"),
    "effect.base.kitchen.description": ("A dresser and a pot crane by the hearth: 1° warmer here, and meals heal a twentieth more.", "炉のそばに食器棚と鍋掛け。ここでは1°暖かく、食事の回復が20分の1増える。"),
    "effect.base.hearth_corner.description": ("A settle by the hearth and wood stacked to hand: 1° warmer here, and you heal a twentieth faster.", "炉のそばに背もたれ長椅子、手の届くところに薪。ここでは1°暖かく、回復が20分の1速い。"),
    "effect.base.herb_nook.description": ("Herbs drying overhead: you farm and brew as if a level higher here, and a meal's good lasts a tenth longer.", "頭上で薬草が乾いている。ここでは農作と調合が1レベル上のように行え、食事の良い効果が1割長く続く。"),
    "quest.base.a_herb_nook": ("A Herb Nook", "薬草の隅"),
    "quest.base.a_herb_nook.why": ("Tie two herbs with twine and they hang to dry (Crafting 4); a drying rack hung with meat counts as a bunch. Two bunches and a jar, basket or crate at home make a herb nook: there you farm and brew as if a level higher, so a kitchen garden at the door takes seed a level early, and a meal's good lasts a tenth longer.", "薬草2つを撚り糸で束ねれば、吊るして乾かせる（工作4）。肉を吊るした干し台もひと束に数える。束2つと壺、かご、木箱のどれかを家に置けば薬草の隅になる。そこでは農作と調合が1レベル上のように行え、戸口の家庭菜園に1レベル早く種をまけ、食事の良い効果も1割長く続く。"),
    "quest.base.by_rushlight": ("By Rushlight", "灯心草の明かり"),
    "quest.base.by_rushlight.why": ("A torch smokes and candles want hides, but a rushlight is cheap and safe by thatch. Rushes grow at the water's edge, along rivers and in marshes and bogs: break two. A plank, a stick and two rushes make two rushlights (Crafting 2). Set one down by your bed: it burns for a day, and a rush lights it again.", "たいまつは煙たく、ろうそくには皮がいる。灯心草立てなら安く、茅のそばでも安心だ。イグサは川べりや湿地、沼の水際に生える。2本刈ろう。板材1、棒1、イグサ2で灯心草立てが2つできる（工作2）。寝床のそばに1つ置こう。1日燃え、イグサでまた灯せる。"),
    "quest.base.a_lit_corner": ("A Lit Corner", "明かりの灯る一角"),
    "quest.base.a_lit_corner.why": ("A seat and two lights beside your bed make a corner worth coming home to: 2° warmer there, and a night's sleep in it wakes you well rested, roof or no roof. A stool is two planks and two sticks (Construction 1); rushlights are a plank, a stick and two rushes (Crafting 2), and candles twine over two hides (Crafting 3).", "寝床のそばに椅子と明かりを2つ置けば、帰りたくなる一角になる。そこでは2°暖かく、屋根がなくても夜そこで眠ればぐっすり目覚める。腰掛けは板2枚と棒2本（建築1）、灯心草立ては板材1、棒1、イグサ2（工作2）、ろうそくは撚り糸と皮2枚（工作3）。"),
    "quest.base.callers_at_the_door": ("Callers at the Door", "戸口の訪問者"),
    "quest.base.callers_at_the_door.why": ("A homely home draws callers. With seats, a table and stores under your roof, guests may come of an evening to sit by your fire while you are home: talk with them, share a cooked supper. Make it cosy and, by night, something smaller may come to the door for the crumbs.", "居心地のよい家には客が来る。屋根の下に椅子と机と収納があれば、家にいる夕べに客が炉のそばへ座りに来ることがある。話をして、温かい夕食を分けよう。さらに心地よい家にすれば、夜には小さな何かがパンくずを求めて戸口に来るかもしれない。"),
    "creature.base.rootmother": ("Rootmother", "根の母"),
    "creature.base.old_tusk": ("Old Tusk", "古牙"),
    "effect.base.heartwood": ("Heartwood", "心材"),
    "effect.base.heartwood.description": ("The Rootmother's heartroot: room for a fifth more health, and you heal a quarter faster.", "根の母の心根。体力の上限が5分の1増え、回復が4分の1速くなる。"),
    "quest.base.the_rootmother": ("The Rootmother", "根の母"),
    "quest.base.the_rootmother.why": ("Under the oldest woods, in the Old Growth Forest, the Dark Forest, the Redwood Forest and the Old Growth Taiga, a passage slopes down into a hollow of living root, and the Rootmother waits there. Cut her and she grows back: what do woodsmen do with stumps? A campfire or torch within four blocks of her, or the sun on her back, stops her mending. Block her lash; dodge her grasp, which no guard holds. Below half she rears and wakes: a quicker thrash, and seeds flung at anyone who keeps away. Train to Attack 12 and Defence 10, then bring her down. Her heartroot heals, and leaves you Heartwood.", "最も古い森、原生林、暗い森、セコイアの森、原生タイガの地下へ、生きた根の洞へと下る通路がある。そこに根の母が待っている。斬っても斬っても生え戻る。木こりは切り株をどうする？\u{3000}根の母から4ブロック以内の焚き火やたいまつ、あるいは背に当たる日の光が、その再生を止める。鞭打ちは防ぎ、どんな構えも止められない締めつけはかわせ。体力が半分を切ると、身を起こして目覚める。鞭打ちはさらに速くなり、離れている者には種を投げつけてくる。攻撃12、防御10まで鍛えてから倒そう。その心根は傷を癒やし、「心材」の効果を残す。"),
    "quest.base.heart_of_the_wood": ("Heart of the Wood", "森の心"),
    "quest.base.heart_of_the_wood.why": ("The Rootmother leaves three heartroot. Eaten, one gives Heartwood for ten minutes: room for a fifth more health, and you heal a quarter faster. Another eaten while it lasts only starts the ten minutes again, so keep the rest for the next hard fight. Eat one and keep two.", "根の母は心根を3個残す。1個食べると10分間「心材」になる。体力の上限が5分の1増え、回復が4分の1速くなる。効いている間にもう1個食べても、10分が始めからになるだけなので、残りは次の厳しい戦いにとっておこう。1個食べ、2個持っておく。"),
    "effect.base.bee_garden": ("Bee garden", "ミツバチの庭"),
    "effect.base.bee_garden.description": ("Bees at work among your flowers: you heal a tenth faster here, and crops near the hive grow a quarter faster.", "花の間でミツバチが働いている。ここでは回復が1割速く、巣箱の近くの作物は4分の1速く育つ。"),
    "effect.base.dooryard": ("Dooryard", "戸口の庭"),
    "effect.base.dooryard.description": ("An awning at your door, a bench, bunting, bales or a dry-stone wall out in the open about it: in the yard you heal a twentieth faster.", "戸口に日よけ、そのまわりの外に長椅子や旗飾りや干し草や石垣。庭にいると回復が20分の1速い。"),
    "effect.base.smoky": ("Smoky", "煙たい"),
    "effect.base.smoky.description": ("Smoke clings to you: bees take you for a fire and stay calm.", "煙が体にまとわりついている。ハチは火と思っておとなしくしている。"),
    "effect.base.tusk_stride": ("Tusk Stride", "牙の足取り"),
    "effect.base.tusk_stride.description": ("Old Tusk's charm hangs at your neck: you move 5% faster.", "古牙のお守りを首にかけている。移動が5%速くなる。"),
    "effect.base.fireside": ("Fireside", "炉端"),
    "effect.base.fireside.description": ("Sat by a fire: you heal half as fast again, and it warms you.", "火のそばに座っている。回復が1.5倍になり、体も温まる。"),
    "effect.base.at_table": ("At the Table", "食卓"),
    "effect.base.at_table.description": ("Sat at a table: a meal heals a quarter more, and its good lasts a quarter longer.", "食卓に座っている。食事の回復が1.25倍になり、効き目も1.25倍長く続く。"),
    "effect.base.reading_nook": ("Reading Nook", "読書の窓辺"),
    "effect.base.reading_nook.description": ("Sat by a window with books to hand: you learn a tenth more.", "本を手元に窓辺に座っている。経験が1割増える。"),
    "effect.base.feet_up": ("Feet Up", "足を休める"),
    "effect.base.feet_up.description": ("Sat with your feet on a footstool: you heal a quarter faster.", "足置きに足をのせて座っている。回復が1.25倍になる。"),
    "effect.base.stung": ("Stung", "ハチ刺され"),
    "effect.base.stung.description": ("Bee stings: slower to heal for a while. Smoke them calm first.", "ハチに刺された。しばらく回復が遅い。先に煙でおとなしくさせよう。"),
    "quest.base.a_bee_garden": ("A Bee Garden", "ミツバチの庭"),
    "quest.base.a_bee_garden.why": ("Set your skep of bees down at home with three flowers near: a bee garden, where you heal a tenth faster and crops within eight blocks of the hive grow a quarter faster. The bees forage by day in dry weather, quicker with more flowers about (a honeydew lily counts for four), and a full skep drips honey. A fire right beside it drives them off; one within four blocks smokes them calm. Right-click a full skep for two or three honey, and half the time a cake of beeswax. While it fills, sow a Kitchen Garden by the hive or plant a Herb Garden.", "ミツバチのいる巣箱を家に置き、近くに花を3つ咲かせればミツバチの庭になる。そこでは回復が1割速く、巣箱から8ブロック以内の作物は4分の1速く育つ。ミツバチは晴れた昼に蜜を集め、まわりの花が多いほど速い（ハニーデューリリーは花4つ分）。満ちた巣箱からははちみつがしたたる。すぐ横の火はハチを追い払うが、4ブロック以内の火なら煙でおとなしくなる。満ちた巣箱を右クリックすると、はちみつが2つか3つ、半分の確率で蜜ろうがひとつ取れる。満ちるのを待つ間に、巣箱のそばで家庭菜園を作るか、薬草園を植えよう。"),
    "quest.base.hung_to_dry": ("Hung to Dry", "吊るして干す"),
    "quest.base.hung_to_dry.why": ("Meat keeps if you dry it. Lash four sticks and three twine into a drying rack (Crafting 1) and stand it under open sky. Right-click it with raw meat or fish in hand to hang up to eight; go gathering, and ten minutes later it is jerky, which heals 2 and, unlike cooked food, stacks in your pack. A fire within three blocks dries it twice as fast; a roof over it stops it. Make a rack and bring home four jerky.", "肉は干せば日持ちする。棒4本とより糸3本で干し台を組み（工作1）、空の下に立てよう。生の肉か魚を手に持って右クリックすれば8つまで吊るせる。採集に出て10分たてば干し肉になる。干し肉は2回復し、調理した料理と違って袋の中で重ねられる。3ブロック以内に火があれば2倍の速さで乾き、上に屋根があると乾かない。干し台を作り、干し肉を4つ持ち帰ろう。"),
    "quest.base.trail_rations": ("Trail Rations", "旅の糧"),
    "quest.base.trail_rations.why": ("A pack of jerky carries you far from the fire: it never spoils and twelve fit in one slot. Stand a second rack by your campfire, keep both hung while you work, and gather eight jerky for a long trip. A hung rack is homely too: it counts as a bunch of herbs drying for a herb nook.", "干し肉をひと袋持てば、火から遠くまで行ける。腐らず、12枚がひとつの枠に収まる。焚き火のそばにもう1台干し台を立て、働くあいだ両方に肉を吊るしておき、長旅に備えて干し肉を8枚集めよう。肉を吊るした干し台は家らしさにもなり、薬草の隅では干している薬草ひと束に数えられる。"),
    "quest.base.a_compost_heap": ("A Compost Heap", "堆肥枠"),
    "quest.base.a_compost_heap.why": ("Nothing from the field need go to waste. Nail planks into an open box (Construction 5) for a compost heap. Right-click it with greens in hand (wheat, seed, carrots, fruit or burnt food) to fork them in by fours, up to sixteen (Farming 5); fifteen minutes later each four have rotted to one compost, and half as fast again with water within two blocks. Make a heap by your field. Spread compost on a growing crop (right-click with it in hand) and that crop and the ones beside it grow a stage at once; a bone crushed over a crop grows that one alone. A ripe crop takes nothing, so the compost stays in hand. Grow six crops with compost and one with a bone, then let them ripen.", "畑のものは何ひとつ無駄にしなくていい。板を打ちつけて口の開いた箱を作れば堆肥枠になる（建築5）。青物（小麦、種、ニンジン、果物、焦げた料理）を手に持って右クリックすれば、4つずつ16まで入れられる（農作5）。15分たてば4つごとに堆肥1つに熟し、2ブロック以内に水があれば1.5倍速くなる。畑のそばに堆肥枠を作ろう。育っている作物に堆肥をまけば（手に持って右クリック）、その作物と隣の作物がすぐに1段育つ。骨を砕いてまけば、その1株だけが育つ。実った作物には効かないので、堆肥は手元に残る。堆肥で作物を6株、骨で1株育て、実るのを待とう。"),
    "quest.base.sweet_relief": ("Sweet Relief", "甘い癒やし"),
    "quest.base.sweet_relief.why": ("Honey heals 2, as fruit does, and unlike cooked food it stacks, so a pouch of it goes a long way. The same food heals a little less each time you eat it in a row, and a minute of other things brings it back: eat honey between other meals. Eat three honey and keep three more.", "はちみつは果物と同じく2回復し、調理した食べ物と違って重ねて持てるので、ポーチ1つ分でも長くもつ。同じ食べ物を続けて食べるたびに回復は少しずつ減り、ほかのことを1分すれば元に戻る。はちみつはほかの食事の合間に食べよう。はちみつを3個食べ、さらに3個持っておく。"),
    "quest.base.humming_in_the_meadow": ("Humming in the Meadow", "野にひびく羽音"),
    "quest.base.humming_in_the_meadow.why": ("Wild bees nest in hollows at the foot of broadleaf, fruit and blossom trees in a Flower Meadow, a Cherry Grove or Lavender Fields: listen for the hum and look for bees about the roots. Coil a skep from seven wheat and three twine (Crafting 6), light a campfire within four blocks of the nest so the smoke calms them (or hold a torch a moment: its smoke clings to you for half a minute), then hold the skep up to it and right-click (Farming 12): the bees move in, and you carry home a skep of bees. Without smoke they only sting. Grow your Farming to 15 as well: a keeper of bees is a seasoned farmer.", "野生のミツバチは、花畑、桜の林、ラベンダー畑の広葉樹や果樹、花の咲く木の根元のうろに巣を作る。羽音に耳をすまし、根元のまわりを飛ぶハチを探そう。小麦7つと撚り糸3つでわら巣箱を編み（工作6）、巣から4ブロック以内でたき火を焚いて煙でおとなしくさせ（たいまつを少し手に持つのでもいい。煙は30秒ほど体にまとわりつく）、巣箱をかざして右クリックする（農作12）。ハチが移り住み、ミツバチのいる巣箱を持ち帰れる。煙がなければ刺されるだけだ。農作15まで腕を上げよう。ミツバチを飼うのは熟練の農家だ。"),
    "quest.base.smoke_that_clings": ("Smoke That Clings", "まとわりつく煙"),
    "quest.base.smoke_that_clings.why": ("Smoke clings. Hold a torch a moment, or stand within two blocks of a fire, and you are Smoky for thirty seconds after: bees take you for a fire and stay calm. Smoky, you can take a swarm with no campfire by the nest, take honey from a full skep unstung, and shoot by a nest without stirring it. Get Smoky and carry four honey.", "煙は体にまとわりつく。松明を少し手に持つか、火から2ブロック以内に立つと、その後30秒「煙たい」状態になる。ミツバチはあなたを火だと思い、おとなしくしている。煙たいうちは、巣のそばに焚き火がなくても分蜂を捕まえられ、満ちたわら巣箱から刺されずにはちみつを取れ、巣のそばで撃っても蜂を騒がせない。「煙たい」状態になり、はちみつを4個持つ。"),
    "quest.base.the_beekeeper_calls": ("The Beekeeper Calls", "養蜂家の訪れ"),
    "quest.base.the_beekeeper_calls.why": ("A home with bees draws the beekeeper by day, to look over your skeps and walk your garden with you; three honey buys a spare skep for a second hive. Beeswax makes the best light a Farm home has before coal: a wick of twine over a cake of wax gives three candles. Meet the beekeeper and make three candles, or, with no visit yet, keep two cakes of wax and make six.", "ミツバチのいる家には、昼に養蜂家がやって来て、巣箱を見て庭を一緒に歩いてくれる。はちみつ3つで予備の巣箱を譲ってくれるので、2つ目の巣にできる。蜜ろうは石炭の前の農の家で一番の明かりになる。撚り糸の芯を蜜ろうの上に置けばろうそくが3本できる。養蜂家に会ってろうそくを3本作るか、まだ来ないなら蜜ろうを2つ持ってろうそくを6本作ろう。"),
}
