    "creature.base.quail": ("Quail", "ウズラ"),
    "creature.base.rabbit": ("Rabbit", "ウサギ"),
    "creature.base.red_deer": ("Red deer", "アカシカ"),
    "creature.base.red_squirrel": ("Red squirrel", "キタリス"),
    "creature.base.reindeer": ("Reindeer", "トナカイ"),
    "creature.base.sand_lizard": ("Sand lizard", "スナトカゲ"),
    "creature.base.shambler": ("Shambler", "さまよう屍"),
    "creature.base.shore_crab": ("Shore crab", "イソガニ"),
    "creature.base.smith": ("Smith", "鍛冶屋"),
    "creature.base.snow_leopard": ("Snow leopard", "ユキヒョウ"),
    "creature.base.sporeling": ("Sporeling", "胞子っ子"),
    "creature.base.sunwing": ("Sunwing", "陽翼鳥"),
    "creature.base.tanner": ("Tanner", "革職人"),
    "creature.base.toad": ("Toad", "ヒキガエル"),
    "creature.base.tortoise": ("Tortoise", "リクガメ"),
    "creature.base.trader": ("Trader", "商人"),
    "creature.base.villager": ("Villager", "村人"),
    "creature.base.wild_boar": ("Wild boar", "イノシシ"),
    "creature.base.wild_horse": ("Wild horse", "野生馬"),
    "creature.base.wisp": ("Wisp", "鬼火"),
    "creature.base.wolf": ("Wolf", "オオカミ"),
    "creature.base.woodcutter": ("Woodcutter", "木こり"),
    "effect.base.aether_touched": ("Aether-touched", "エーテルの加護"),
    "effect.base.aether_touched.description": ("The aether hums here: every skill learns a twentieth more.", "ここではエーテルが響く。すべてのスキルの経験が20分の1多い。"),
    "effect.base.cooled": ("Cooled", "涼しさ"),
    "effect.base.cooled.description": ("Something cooling: 8° cooler in the heat.", "体を冷やすもの。暑さの中で8度涼しい。"),
    "effect.base.ember_warmed": ("Ember-warmed", "熾火の温もり"),
    "effect.base.ember_warmed.description": ("Emberfruit glows inside you: 10° warmer.", "熾火の実が内から温める。10度暖かい。"),
    "effect.base.focused": ("Focused", "集中"),
    "effect.base.focused.description": ("A good breakfast: every skill learns a tenth more.", "しっかりした朝ごはん。どのスキルも経験が1割増える。"),
    "effect.base.forest_calm": ("Forest calm", "森の安らぎ"),
    "effect.base.forest_calm.description": ("Among the trees you heal a fifth faster.", "木々の中では、回復が5分の1速い。"),
    "effect.base.hearty": ("Hearty", "滋養"),
    "effect.base.hearty.description": ("Cooked meat: room for a tenth more health while it lasts.", "焼いた肉。続く間、体力の上限が一割増える。"),
    "effect.base.hunters_vigour": ("Hunter's vigour", "狩人の活力"),
    "effect.base.hunters_vigour.description": ("Game cooked over a fire: quicker on your feet.", "火で焼いた獲物。足が速くなる。"),
    "effect.base.mired": ("Mired", "ぬかるみ"),
    "effect.base.mired.description": ("Soft wet ground: a little slower going.", "柔らかく湿った地面。少し動きにくい。"),
    "effect.base.camp": ("Camp", "野営地"),
    "effect.base.camp.description": ("Your own bed and light: you heal a fifth faster here.", "自分の寝床と明かり。ここでは回復が2割速い。"),
    "effect.base.camp.next": ("Next: build a Homestead Hearth near your bed and light it.", "次は：寝床のそばに家の炉を作って火を灯そう。"),
    "effect.base.hearthside": ("Hearthside", "炉辺"),
    "effect.base.hearthside.description": ("Your hearth keeps the cold off: you heal a third faster here.", "炉が寒さを防ぐ。ここでは回復が3分の1速い。"),
    "effect.base.hearthside.next": ("Next: roof it over, with your bed and two lights, to be snug.", "次は：屋根をかけ、寝床と明かりを2つ置けば居心地がよくなる。"),
    "effect.base.snug": ("Snug", "居心地"),
    "effect.base.snug.description": ("Warm under a roof: you heal half as fast again here.", "屋根の下で暖かい。ここでは回復が5割速い。"),
    "effect.base.snug.next": ("Next: two seats, a table, two places to store things and a third light make it homely.", "次は：椅子2つ、机、収納2つ、3つ目の明かりで我が家になる。"),
    "effect.base.homely": ("Homely", "我が家"),
    "effect.base.homely.description": ("Room to sit, work and store: you learn a twentieth more here.", "座り、働き、しまう場所。ここでは経験が20分の1多い。"),
    "effect.base.homely.next": ("Next: two rugs, two curtains, a cushion, three pieces of crockery and a fourth light make it cosy.", "次は：敷物2つ、カーテン2つ、クッション、食器3つ、4つ目の明かりでくつろげる家になる。"),
    "effect.base.cosy": ("Cosy", "くつろぎ"),
    "effect.base.cosy.description": ("Soft and bright: you heal faster and learn a tenth more here.", "柔らかく明るい。ここでは回復が速く、経験が1割多い。"),
    "effect.base.cosy.next": ("Next: a bookshelf, a stove or cauldron, a loom, spindle or quern, and a banner make it the heart of the home.", "次は：本棚、かまどか鍋、織機・紡ぎ台・石臼のどれか、旗で団らんの家になる。"),
    "effect.base.heart_of_the_home": ("Heart of the Home", "団らんの家"),
    "effect.base.heart_of_the_home.description": ("Everything a home needs: heal twice as fast, learn an eighth more.", "家に必要なものがそろった。回復が2倍速く、経験が8分の1多い。"),
    "effect.base.rested": ("Rested", "休息"),
    "effect.base.rested.description": ("You slept: you heal and learn a little more for a while.", "眠った。しばらくの間、回復と経験が少し増える。"),
    "effect.base.well_rested": ("Well rested", "ぐっすり"),
    "effect.base.well_rested.description": ("Slept in a snug home: you learn more and mine faster for a while.", "居心地のよい家で眠った。しばらくの間、経験が増え、採掘が速い。"),
    "effect.base.deep_rest": ("Deep rest", "深い眠り"),
    "effect.base.deep_rest.description": ("Slept in a cosy home: you heal, learn, mine and walk faster for a while.", "くつろげる家で眠った。しばらくの間、回復・経験・採掘・歩みが速い。"),
    "effect.base.queasy": ("Queasy", "吐き気"),
    "effect.base.queasy.description": ("Raw meat: slower to heal and a little slower going. Cook it.", "生の肉。回復が遅く、少し動きにくい。焼こう。"),
    "effect.base.refreshed": ("Refreshed", "爽快"),
    "effect.base.refreshed.description": ("Fresh fruit: a spring in your step.", "新鮮な果物。足取りが軽くなる。"),
    "effect.base.rich_rock": ("Rich rock", "良い岩"),
    "effect.base.rich_rock.description": ("Mountain rock splits cleanly: you mine a tenth faster.", "山の岩はきれいに割れる。採掘が1割速い。"),
    "effect.base.soothed": ("Soothed", "安らぎ"),
    "effect.base.soothed.description": ("Milk: heal half as fast again.", "ミルク。回復が1.5倍速くなる。"),
    "effect.base.sustained": ("Sustained", "腹持ち"),
    "effect.base.sustained.description": ("Bread and roots: you heal by yourself a quarter faster.", "パンや根菜。自然に回復するのが4分の1速くなる。"),
    "effect.base.waterside": ("Waterside", "水辺"),
    "effect.base.waterside.description": ("By the sea, a river or a marsh: casts land a fifth more often.", "海や川や沼のそば。釣り糸が5分の1ほどよくかかる。"),
    "multiblock.base.crucible_kiln": ("Crucible Kiln", "るつぼ窯"),
    "multiblock.base.crucible_kiln.hint": ("The kiln needs kiln bricks all round the crucible and a pillar of kiln bricks on each corner.", "窯には、るつぼを囲む窯レンガと、四隅に窯レンガの柱が必要です。"),
    "multiblock.base.homestead_hearth": ("Homestead Hearth", "開拓の炉"),
    "multiblock.base.homestead_hearth.hint": ("The hearth needs a ring of stone around the hearthstone and a chimney two blocks tall at one corner.", "炉には、炉石を囲む石の輪と、角に2ブロックの高さの煙突が必要です。"),
    "quest.base.a_bed_of_your_own": ("A Bed of Your Own", "自分の寝床"),
    "quest.base.a_bed_of_your_own.why": ("Until you sleep somewhere, death sends you back to world spawn. Wool and hide, pelts, or feathers make a sleeping bag.", "どこかで眠るまで、倒れるとワールドの初期地点に戻される。羊毛と皮、毛皮、羽根で寝袋を作れる。"),
    "quest.base.a_friend_in_the_wild": ("A Friend in the Wild", "野生の友"),
    "quest.base.a_friend_in_the_wild.why": ("Hold wheat seeds (or a carrot for a rabbit), walk up slowly without sprinting or hitting, and right-click a junglefowl. A tamed hen lays eggs at home: your first step to a farm, and to pets.", "小麦の種（ウサギならニンジン）を持ち、走らず殴らずにそっと近づいて、ヤケイを右クリックしよう。手なずけた雌鶏は家で卵を産む。農場とペットへの第一歩だ。"),
    "quest.base.bare_hands": ("First Catch", "初めての釣果"),
    "quest.base.bare_hands.why": ("Fish are the easiest food near water. Hold your rod, right-click water and wait for a bite: shrimp and minnows come first. Land five; cooked fish heal well.", "魚は水辺でいちばん手軽な食べ物だ。釣り竿を持って水を右クリックし、食いつくのを待とう。最初に掛かるのはエビとミノー。5匹釣り上げよう。焼いた魚はよく回復する。"),
    "quest.base.charcoal": ("Charcoal", "木炭"),
    "quest.base.charcoal.why": ("Fuel before metal: coal or charcoal smelts copper and makes torches. Burn logs down at a campfire (hold a log and right-click the fire), or dig out a coal seam.", "金属の前に燃料を。石炭か木炭で銅を製錬でき、松明も作れる。原木を持って焚き火を右クリックして燃やし尽くすか、石炭の鉱脈を掘ろう。"),
    "quest.base.crafting_table": ("Crafting Table", "作業台"),
    "quest.base.crafting_table.why": ("Its three-by-three grid makes every tool and weapon.", "3×3の枠であらゆる道具と武器を作れる。"),
    "quest.base.crucible_kiln": ("Crucible Kiln", "るつぼ窯"),
    "quest.base.crucible_kiln.why": ("Bronze needs heat a campfire can't reach. Lighting the kiln starts the Bronze age.", "青銅には焚き火では届かない熱がいる。窯に火を入れると青銅の時代が始まる。"),
    "quest.base.first_bronze": ("First Bronze", "初めての青銅"),
    "quest.base.first_bronze.why": ("Smelt three copper ingots with one tin ore into bronze blend at the crafting table (Engineering 12), then put the blend in the lit kiln's crucible: the metal of the next age.", "銅のインゴット3個とスズ鉱石1個を作業台で青銅の合わせ材にし（工学レベル12）、火の入った窯のるつぼに入れて溶かす。次の時代の金属だ。"),
    "quest.base.first_night": ("First Night", "最初の夜"),
    "quest.base.first_night.why": ("Make a campfire: put two logs or Wood blocks above two Cobblestones in the 2×2 crafting grid. No stripped wood is needed. Place the fire, select raw rabbit, raw chicken or an egg in your hotbar, and right-click the fire. Wait two seconds; the cooked food goes into your inventory. If it burns, try again. Cooked food heals more than raw food.", "2×2の製作枠で、原木か木材を2個並べ、その下に丸石を2個置いて焚き火を作ろう。樹皮を剥ぐ必要はない。焚き火を設置し、生のウサギ肉・生の鶏肉・卵のどれかをホットバーで選び、焚き火を右クリック。2秒待つと、調理済みの食べ物が持ち物に入る。焦げたらもう一度。調理すると生よりよく回復する。"),
    "quest.base.first_ore": ("Red Metal Underfoot", "足元の赤い金属"),
    "quest.base.first_ore.why": ("Copper needs Mining 5 and the pickaxe you have. It shows as green-flecked rock in hills and mountains. Mine five; it is the start of every metal.", "銅には採掘レベル5が要る。丘や山で緑の粒が混じった岩として見つかる。5個掘ろう。あらゆる金属の始まりだ。"),
    "quest.base.homestead_hearth": ("Homestead Hearth", "開拓の炉"),
    "quest.base.homestead_hearth.why": ("Your home: you wake here after dying, and the Farm age opens. Craft a hearthstone (eight cobblestone round an empty middle) and two chimney blocks (six cobblestone and two clay each). Set the hearthstone in a ring of eight stone, stack both chimneys on one corner stone, then right-click the hearthstone. About 28 cobblestone and 4 clay in all; clay lies on the bottom of ponds and lakes, so wade in and dig it with a shovel.", "あなたの家だ。倒れたらここで目覚め、農耕の時代が開く。炉石（中央を空けて丸石8個）と煙突2つ（それぞれ丸石6個と粘土2個）を作ろう。炉石を石8個の輪の中央に置き、輪の角の石の上に煙突を2つ積み、炉石を右クリックする。全部で丸石28個と粘土4個ほど。粘土は池や湖の底にあるので、水に入ってシャベルで掘ろう。"),
    "quest.base.pockets": ("Pockets", "ポケット"),
    "quest.base.pockets.why": ("Herbs and seeds eat slots; a pouch holds a thousand of a kind in one.", "薬草や種は枠を取る。袋なら一種類千個を一つの枠に。"),
    "quest.base.red_metal": ("Red Metal", "赤い金属"),
    "quest.base.red_metal.why": ("Copper tools are faster and find more, and copper is three parts of bronze.", "銅の道具は速く、多く見つけ、銅は青銅の四分の三を占める。"),
    "quest.base.look_it_up": ("Look It Up", "調べてみよう"),
    "quest.base.look_it_up.why": ("Forgotten a recipe? Open the inventory, type part of a name in its search box, and click the item to see how it is made; a right-click shows what it goes into. Look up the stone pickaxe.", "作り方を忘れた？持ち物画面を開き、検索欄に名前の一部を入力して、アイテムをクリックすると作り方が見られる。右クリックなら使い道が分かる。石のツルハシを調べてみよう。"),
    "quest.base.stone_in_hand": ("Stone in Hand", "石の道具"),
    "quest.base.stone_in_hand.why": ("Bare hands are slow. Stone tools mine twice as fast and reach coal for torches.", "素手は遅い。石の道具は2倍速く掘れ、松明用の石炭にも届く。"),
    "quest.base.the_potter": ("The Potter", "陶工"),
    "quest.base.the_potter.why": ("Pots and vials hold potions and stews, and the pot is the heart of the kiln you are working toward. Shape six clay pots from fired clay (five fired clay make two).", "壺や小瓶は薬やシチューを入れ、壺は目指す窯の心臓部にもなる。焼き粘土から土の壺を6個作ろう（焼き粘土5個で2個）。"),
    "quest.base.torchlight": ("Torchlight", "たいまつの灯り"),
    "quest.base.torchlight.why": ("Light keeps monsters off and lets you work at night.", "灯りは魔物を遠ざけ、夜も働ける。"),
    "quest.base.twine_and_thong": ("Twine and Thong", "より糸"),
    "quest.base.twine_and_thong.why": ("Twine goes into fishing rods, pouches, candles and baskets. Three wheat twist into two twine, so gather wild wheat from open grass first. Make ten.", "より糸は釣り竿、袋、ろうそく、かごに使う。小麦3つで2本できるので、まず開けた草地で野生の小麦を集めよう。10本作ること。"),
    "quest.base.where_to_settle": ("Where to Settle", "住む場所"),
    "quest.base.where_to_settle.why": ("Biomes help different work: the woods heal, the water fishes, the mountains mine. Walk until you have stood in three different ones; where you build decides what your home gives.", "バイオームごとに向く仕事が違う。森は回復、水辺は釣り、山は採掘。3つの異なるバイオームに立つまで歩こう。どこに建てるかで、家の恵みが決まる。"),
    "quest.base.timber": ("Timber", "木材"),
    "quest.base.timber.why": ("Every tool starts as wood. Chop a tree with your axe and gather eight logs. A log splits into four planks at the crafting grid, and two planks make four sticks.", "道具はどれも木から始まる。斧で木を切り、原木を8個集めよう。原木は作業枠で板材4枚になり、板材2枚で棒が4本できる。"),
    "quest.base.a_pile_of_stone": ("A Pile of Stone", "石の山"),
    "quest.base.a_pile_of_stone.why": ("Stone is the next step up from wood. Break twenty stone with your pickaxe: it drops cobblestone, which makes stone tools, a campfire and, later, your hearth.", "木の次は石だ。つるはしで石を20個掘ろう。丸石が手に入り、石の道具や焚き火、のちには炉の材料になる。"),
    "quest.base.coal_and_cinders": ("Coal and Cinders", "石炭と燃えさし"),
    "quest.base.coal_and_cinders.why": ("Coal shows as black flecks in the rock, often right at the surface of hills. One coal or charcoal over a stick makes four torches, and it smelts metal later. Mine eight.", "石炭は岩に混じる黒い粒で、丘の地表近くによく見つかる。石炭か木炭を棒の上に置くと松明が4本でき、のちには金属の製錬にも使う。8個掘ろう。"),
    "quest.base.something_to_swing": ("Something to Swing", "握れる武器"),
    "quest.base.something_to_swing.why": ("Fists are slow. A stone sword (two cobblestone over a stick) or a bone club (two bones over a stick) hits much harder. Make one at the crafting table.", "素手では遅い。石の剣（丸石2個の下に棒）か骨の棍棒（骨2個の下に棒）なら、ずっと強く殴れる。作業台で作ろう。"),
    "quest.base.small_game": ("Small Game", "小さな獲物"),
    "quest.base.small_game.why": ("Rabbits, junglefowl and other small animals are the easiest food: raw rabbit and chicken cook well at a campfire. Hunt three; a few blows are enough, and each kill trains Hunter. Then cook one of what you killed.", "ウサギやヤケイなどの小動物は、いちばん手軽な食料だ。生のウサギ肉や鶏肉は焚き火でうまく焼ける。3匹狩ろう。数回殴れば倒せ、倒すたびに狩猟が上がる。そして、仕留めた獲物を1つ焼いてみよう。"),
    "quest.base.hide_and_seek": ("Hide and Seek", "皮集め"),
    "quest.base.hide_and_seek.why": ("Hide makes armour, pouches and bedding. Rabbits and deer drop it, and a knife in your hand makes it drop more often. Gather four hides. Keep two bones as well: a bone makes a club, a needle, a handle.", "獣の皮は防具や袋や寝具の材料になる。ウサギやシカが落とし、ナイフを持っていると落ちやすい。4枚集めよう。骨も2本とっておこう。骨は棍棒や針や柄になる。"),
    "quest.base.hide_wraps": ("Hide Wraps", "獣皮の防具"),
    "quest.base.hide_wraps.why": ("Armour turns blows aside and trains Defence. Hide gloves (two hide) and boots (three hide) are the cheapest pieces. Make both at the crafting table.", "防具は攻撃をそらし、防御を鍛える。獣皮の手袋（皮2枚）と靴（皮3枚）がいちばん安上がりだ。作業台で両方作ろう。"),
    "quest.base.meat_and_fire": ("Meat on the Fire", "火で焼く肉"),
    "quest.base.meat_and_fire.why": ("Raw meat heals little and leaves you Queasy; cooked meat heals far more. Cook six pieces of meat at a campfire: rabbit, chicken, duck or frog. A higher Cooking level burns less. Six good meals will also take you to Cooking 2.", "生肉は回復が少なく、気分も悪くなる。焼いた肉ならずっとよく回復する。焚き火で肉を6個焼こう。ウサギ、鶏、カモ、カエルのどれでもよい。料理の腕が上がるほど焦げにくくなる。6回上手に焼けば、料理レベル2にも届く。"),
    "quest.base.a_handful_of_grain": ("A Handful of Grain", "ひとにぎりの穀物"),
    "quest.base.a_handful_of_grain.why": ("Wild wheat grows in tufts on open grass. Break it for seeds and the odd ear of wheat: wheat makes bread and twine, and the seeds are your first crop.", "野生の小麦は開けた草地に房になって生えている。壊すと種が手に入り、ときどき小麦の穂も落ちる。小麦はパンとより糸になり、種は最初の作物になる。"),
    "quest.base.daily_bread": ("Daily Bread", "毎日のパン"),
    "quest.base.daily_bread.why": ("Two ears of wheat side by side in the crafting grid bake into bread, which heals more than the grain. Bake four loaves.", "小麦の穂を作業枠に2つ並べるとパンが焼ける。穀物のままより回復する。4個焼こう。"),
    "quest.base.break_ground": ("Break Ground", "土を耕す"),
    "quest.base.break_ground.why": ("A hoe tills grass or dirt into farmland, where seeds can be sown. Make a hoe at the crafting table: two stone or two planks over two sticks. Right-click soil with it to till.", "くわは草地や土を耕して耕地にし、種をまけるようにする。作業台で石か板材2個の下に棒2本を置いて作ろう。土を右クリックすると耕せる。"),
    "quest.base.rod_and_line": ("Rod and Line", "釣り竿と糸"),
    "quest.base.rod_and_line.why": ("A fishing rod is three sticks and two twine, laid out at the crafting table as the recipe shows. Twine is three wheat twisted into two. With the rod in hand, right-click water and wait for a bite. Then land one fish.", "釣り竿は棒3本とより糸2本を、作業台でレシピの形に並べて作る。より糸は小麦3つを撚ると2本できる。竿を持って水を右クリックし、食いつくのを待とう。そして魚を1匹釣り上げよう。"),
    "quest.base.a_fish_supper": ("A Fish Supper", "魚の夕食"),
    "quest.base.a_fish_supper.why": ("A fish tastes far better cooked. Roast three at a campfire: hold the raw fish and right-click the fire. Catch the three yourself.", "魚は焼くとずっとおいしく、回復も多い。生の魚を持って焚き火を右クリックし、3匹焼こう。3匹は自分で釣ること。"),
    "quest.base.wild_harvest": ("Wild Harvest", "野の恵み"),
    "quest.base.wild_harvest.why": ("The wild gives herbs, flowers, berries and mushrooms for the picking. Break ten by hand; most grow back in time. Your journal's Plants page records everything you find.", "野には薬草、花、ベリー、キノコが生えている。素手で10本摘もう。たいていは時間がたてば生え戻る。見つけたものは図鑑の植物のページに記録される。"),
    "quest.base.herb_gatherer": ("Herb Gatherer", "薬草摘み"),
    "quest.base.herb_gatherer.why": ("Herbs flavour food, heal and brew into potions later. Pick five herbs such as mint, sage or thyme, and carry them in a herb pouch so they do not eat your slots.", "薬草は料理の風味づけになり、傷を癒やし、のちには薬にもなる。ミントやセージ、タイムなどの薬草を5本摘み、薬草袋に入れて持ち歩こう。"),
    "quest.base.neighbours": ("Wild Neighbours", "野の隣人たち"),
    "quest.base.neighbours.why": ("Walk the land and see who lives in it. Come within sight of six kinds of animal; the journal's Animals page fills in as you go, and every kind drops something different.", "土地を歩いて、そこに誰が住んでいるか見てみよう。6種類の動物を見かけると、図鑑の動物のページが埋まっていく。動物ごとに落とすものが違う。"),
    "quest.base.lay_of_the_land": ("Lay of the Land", "土地のようす"),
    "quest.base.lay_of_the_land.why": ("Before you settle, see more of the world. Stand in six different biomes: woods, plains, hills, wetlands and shores each hold different animals, plants and ores.", "住処を決める前に、世界をもっと見て回ろう。6つの異なるバイオームに立つこと。森、平原、丘、湿地、海辺で動物も植物も鉱石も違う。"),
    "quest.base.something_hostile": ("Something Hostile", "敵意あるもの"),
    "quest.base.something_hostile.why": ("Not everything out there is food. Cave bats and cave crawlers lurk in the dark underground, and shamblers walk where the aether is strong. Fight one with a sword in hand and torches and bread at your belt.", "外にいるのは食べ物だけではない。洞窟コウモリと洞窟グモは地下の暗がりに潜み、さまよう屍はエーテルの濃い場所を歩く。剣を持ち、腰に松明とパンを備えて、1体倒そう。"),
    "quest.base.sharpening_up": ("Sharpening Up", "腕を磨く"),
    "quest.base.sharpening_up.why": ("Every blow you land trains Attack, and a higher level hits harder and truer. Hunt until you reach Attack 4. Five kills along the way.", "攻撃が当たるたびに攻撃のレベルが上がり、より強く正確に打てるようになる。攻撃レベル4まで狩りを続けよう。その間に5体仕留めること。"),
    "quest.base.raise_your_guard": ("Raise Your Guard", "盾を構える"),
    "quest.base.raise_your_guard.why": ("A shield blocks blows: right-click to raise your guard as a swing lands. A hide buckler (four hide and a stick) is the easy one; a wooden shield (planks) needs Crafting 3.", "盾は攻撃を防ぐ。振り下ろされる瞬間に右クリックで構えよう。獣皮の小盾（皮4枚と棒）なら手軽で、木の盾（板材）は工作レベル3が要る。"),
    "quest.base.tools_for_animals": ("Tools for Animals", "家畜のための道具"),
    "quest.base.tools_for_animals.why": ("Shears take wool from sheep and a pail takes milk from cows and goats. Two cobblestones crossed make shears; two planks crossed make a pail.", "はさみは羊から羊毛を、手おけは牛やヤギから牛乳を取る道具だ。丸石2個を斜めに並べるとはさみ、板材2枚を斜めに並べると手おけができる。"),
    "quest.base.a_sharp_edge": ("A Sharp Edge", "鋭い刃"),
    "quest.base.a_sharp_edge.why": ("A knife is the hunter's tool: it makes a kill drop hide more often and cuts plants cleanly. A wooden knife is a plank over a stick, a stone knife a cobblestone over a stick; both fit the inventory grid.", "ナイフは狩人の道具で、倒した獲物が皮を落としやすくなり、植物もきれいに切れる。木のナイフは板材の下に棒、石のナイフは丸石の下に棒で、持ち物の作業枠でも作れる。"),
    "quest.base.clay_banks": ("Clay Banks", "粘土の川底"),
    "quest.base.clay_banks.why": ("Pots, vials and kiln bricks are all clay. It lies in patches on the bottom of ponds, lakes and rivers: wade in and dig it with a shovel (one cobblestone over two sticks). Carry out twenty-four.", "壺も小瓶も窯レンガも、材料は粘土だ。池や湖や川の底に塊になって埋まっている。水に入ってシャベル（丸石1個の下に棒2本）で掘り、24個持ち帰ろう。"),
    "quest.base.a_pit_kiln": ("A Pit Kiln", "野窯"),
    "quest.base.a_pit_kiln.why": ("Clay needs more heat than an open fire gives. A pit kiln is a campfire ringed with cobblestone: lay five cobblestones round a campfire at the crafting table, as the recipe shows, then set it down.", "粘土を焼くには、野火より強い熱がいる。野窯は焚き火を丸石で囲んだものだ。作業台でレシピの形に、焚き火の周りへ丸石を5個並べて作り、地面に置こう。"),
    "quest.base.fire_the_clay": ("Fire the Clay", "粘土を焼く"),
    "quest.base.fire_the_clay.why": ("Hold clay and right-click the pit kiln: after a moment it comes out as fired clay. Low Crafting levels crack some, so bring spare. Fire twelve.", "粘土を持って野窯を右クリックすると、しばらくして焼き粘土になる。工作レベルが低いうちは割れることもあるので、余分に用意しよう。12個焼くこと。"),
    "quest.base.brick_by_brick": ("Brick by Brick", "レンガを積んで"),
    "quest.base.brick_by_brick.why": ("The Crucible Kiln is built of kiln bricks: nineteen for the kiln and its crucible. Four fired clay make a brick at the crafting grid (Crafting 5). Make nineteen; it is a lot of clay, so keep firing.", "るつぼ窯は窯レンガでできている。窯とるつぼ合わせて19個必要だ。焼き粘土4個で窯レンガ1個が作業枠で作れる（工作レベル5）。19個作ろう。粘土がたくさん要るので、焼き続けること。"),
    "quest.base.the_crucible": ("The Crucible", "るつぼ"),
    "quest.base.the_crucible.why": ("The heart of the kiln: seven kiln bricks round a clay pot, shaped at the crafting table (Engineering 10). Make it, then build the kiln round it.", "窯の心臓部だ。作業台で土の壺の周りに窯レンガ7個を並べて作る（工学レベル10）。作ったら、そのまわりに窯を組もう。"),
    "quest.base.first_harvest": ("First Harvest", "初めての収穫"),
    "quest.base.first_harvest.why": ("Till grass or dirt with a hoe (right-click), sow wheat seeds on the farmland (right-click), keep water within four blocks, and wait: wheat ripens in about twelve minutes. Break the ripe plants to harvest. Harvest four. Keep the four wheat you harvest in your pack.", "くわで草地や土を耕し（右クリック）、耕地に小麦の種をまき（右クリック）、4ブロック以内に水を用意して待とう。小麦は12分ほどで実る。熟した株を壊して収穫する。4株収穫しよう。収穫した小麦4つは持っておくこと。"),
    "quest.base.a_field_of_gold": ("A Field of Gold", "黄金の畑"),
    "quest.base.a_field_of_gold.why": ("One plot is a hobby; a field is a food supply. Keep sowing from your own seed and harvest twenty-four wheat plants. Seeds come back with each harvest, so the field pays for itself. A field that size also teaches Farming 5.", "一区画は趣味、畑は食料の源だ。自分の種をまき続けて、小麦を24株収穫しよう。収穫のたびに種が戻るので、畑は自分で元を取る。それだけの畑なら、農業レベル5も身につく。"),
    "quest.base.carrot_patch": ("Carrot Patch", "ニンジン畑"),
    "quest.base.carrot_patch.why": ("Carrots need Farming 5 and cool, moist soil. A carrot is its own seed: forage wild carrots, plant what you get, and harvest four. Rabbits love them too. Keep the four carrots you harvest.", "ニンジンは農業レベル5と涼しくて湿った土が要る。ニンジンはそのまま種になる。野生のニンジンを摘んで植え、4株収穫しよう。ウサギの大好物でもある。収穫したニンジン4本は持っておくこと。"),
    "quest.base.herb_garden": ("Herb Garden", "薬草園"),
    "quest.base.herb_garden.why": ("Herbs cannot be sown, but a herb planter (planks round dirt, Construction 3) lets a picked herb grow back at home. Make a planter, set a herb in it, and pick it again when it returns. Pick six wild plants on your rounds as well.", "薬草は種まきできないが、薬草のプランター（板材で土を囲む、建築レベル3）なら、摘んだ薬草が家で生え戻る。プランターを作って薬草を植え、戻ったらまた摘もう。見回りの途中で野の植物を6つ摘むこと。"),
    "quest.base.camp_cook": ("Camp Cook", "野営の料理人"),
    "quest.base.camp_cook.why": ("Every dish trains Cooking. Duck wants level 3, mutton 5 and crab 6, and a higher level burns less. Cook a mix of meat and fish, whatever your hunting and fishing bring, until you reach Cooking 5.", "料理するたびに料理の腕が上がる。カモは3、マトンは5、カニは6が必要で、レベルが高いほど焦げにくい。狩りと釣りで得た肉や魚を焼いて、料理レベル5を目指そう。"),
    "quest.base.seed_mix": ("Seed Mix", "混ぜ種"),
    "quest.base.seed_mix.why": ("Kept animals only breed when fed their breeding food. Two seeds and a wheat in the crafting grid make seed mix (Cooking 8), which readies any kept animal to breed. Make four. Bring in eight wheat to make it from.", "飼っている動物は、繁殖用の餌を与えないと増えない。種2つと小麦1つを作業枠に並べると混ぜ種ができ（料理レベル8）、どの動物も繁殖の準備ができる。4個作ろう。材料にする小麦を8つ収穫しよう。"),
    "quest.base.roots_in_the_embers": ("Roots in the Embers", "おき火の根菜"),
    "quest.base.roots_in_the_embers.why": ("A roast carrot heals better than a raw one, and roots are easy food to grow. Roast four carrots on a campfire (Cooking 2).", "焼きニンジンは生より回復し、根菜は育てやすい食べ物だ。焚き火でニンジンを4本焼こう（料理レベル2）。"),
    "quest.base.hens_in_a_row": ("Hens in a Row", "並んだ雌鶏"),
    "quest.base.hens_in_a_row.why": ("Hold wheat seeds, walk up slowly (no sprinting, no hitting) and right-click a junglefowl until it trusts you. A kept hen needs room, grass or feed, and water nearby, and lays an egg about every five minutes. Tame three.", "小麦の種を持ち、走らず殴らずにそっとヤケイに近づき、慣れるまで右クリックしよう。飼うには広さと草か餌、近くの水が要り、5分に1個ほど卵を産む。3羽手なずけること。"),
    "quest.base.fresh_eggs": ("Fresh Eggs", "産みたての卵"),
    "quest.base.fresh_eggs.why": ("A kept hen lays on the ground near her. Collect six eggs: they fry on a campfire, and a hen that is fed, watered and sheltered lays more. Fry one to taste the reward.", "飼っている雌鶏は近くの地面に卵を産む。6個集めよう。焚き火で目玉焼きになり、餌と水と屋根が足りている雌鶏ほどよく産む。1つ焼いて、成果を味わおう。"),
    "quest.base.a_proper_breakfast": ("A Proper Breakfast", "まともな朝食"),
    "quest.base.a_proper_breakfast.why": ("A fried egg is the quickest cooking there is: hold an egg and right-click a campfire. Fry three.", "目玉焼きは最も手軽な料理だ。卵を持って焚き火を右クリックするだけ。3個焼こう。"),
    "quest.base.a_woolly_flock": ("A Woolly Flock", "羊毛の群れ"),
    "quest.base.a_woolly_flock.why": ("Mouflon, the wild sheep, need Hunter 5 to tame. Hold its favourite food, approach calmly and right-click. A kept sheep grows its wool back: shear it with your shears. Have your shears made before you go.", "野生の羊ムフロンは、手なずけるのに狩猟レベル5が要る。好物を持ち、落ち着いて近づいて右クリックしよう。飼った羊は羊毛が生え戻るので、はさみで刈り取れる。出かける前にハサミを作っておこう。"),
    "quest.base.wool_gathering": ("Wool Gathering", "羊毛集め"),
    "quest.base.wool_gathering.why": ("Wool makes beds, cloth and sleeping bags. Right-click a kept sheep with shears in hand whenever its wool has grown back, and gather six.", "羊毛はベッドや布や寝袋の材料だ。飼っている羊の毛が生え戻ったら、はさみを持って右クリックして刈り、6つ集めよう。"),
    "quest.base.ducks_on_the_pond": ("Ducks on the Pond", "池のカモ"),
    "quest.base.ducks_on_the_pond.why": ("Mallards need Hunter 3, lay eggs, and do not mind rain. Hold its favourite food, approach one by the water and right-click.", "マガモは狩猟レベル3で手なずけられ、卵を産み、雨も気にしない。好物を持って水辺で近づき、右クリックしよう。"),
    "quest.base.the_milk_pail": ("The Milk Pail", "ミルクの手おけ"),
    "quest.base.the_milk_pail.why": ("A tamed mountain goat (Hunter 8), reindeer (10) or aurochs (12) gives milk to a pail, right-clicked. Milk heals half as fast again for a while. Collect two. Make the pail first: two planks crossed.", "手なずけたシロイワヤギ（狩猟レベル8）、トナカイ（10）、オーロックス（12）は、手おけを持って右クリックすると牛乳を出す。牛乳はしばらく回復を5割速める。2つ集めよう。まず桶を作る。板2枚を交差させる。"),
    "quest.base.a_full_pen": ("A Full Pen", "満員の囲い"),
    "quest.base.a_full_pen.why": ("Six animals under your care is a real farm. Keep each fed, watered, roofed against rain and given room; condition decides what they give. You can keep up to 64 animals.", "6匹の動物を世話すれば立派な農場だ。餌、水、雨よけの屋根、広さを用意しよう。状態のよさが、もらえるものを決める。飼えるのは64匹まで。"),
    "quest.base.bigger_game": ("Bigger Game", "大物狩り"),
    "quest.base.bigger_game.why": ("Sheep, deer, boar and cattle give more meat and better hides, but they fight back: wear your hide wraps and keep your sword sharp. Cook the haunch: mutton at Cooking 5, pork at 8, venison at 15.", "羊、シカ、イノシシ、牛は肉も皮も多く取れるが、反撃してくる。獣皮の防具を着て、剣を研いでおこう。肉は焼いて食べる：マトンは料理レベル5、豚は8、鹿肉は15。"),
    "quest.base.full_hide_wraps": ("Full Hide Wraps", "獣皮の一揃い"),
    "quest.base.full_hide_wraps.why": ("A whole set guards head, body and legs. At the crafting table a hood takes five hides, a tunic eight and trousers seven.", "一揃い着ると頭、胴、脚を守れる。作業台で、頭巾は皮5枚、上着は8枚、ズボンは7枚で作れる。"),
    "quest.base.copper_arms": ("Copper Arms", "銅の武具"),
    "quest.base.copper_arms.why": ("Copper hits harder and lasts longer than stone. Smelt ingots (ore over charcoal in the grid, Engineering 5), then make a copper sword (two ingots over a stick) and a copper shield.", "銅は石より強く、長持ちする。インゴットを作り（銅鉱石を木炭の上に置く、工学レベル5）、銅の剣（インゴット2個の下に棒）と銅の盾を作ろう。"),
    "quest.base.copper_mail": ("Copper Mail", "銅の鎧"),
    "quest.base.copper_mail.why": ("A copper helmet takes five ingots and a chestplate eight. They turn aside far more than hide does, and every ingot is ore you carried out of the hills.", "銅の兜はインゴット5個、胸当ては8個で作る。獣皮よりずっと攻撃をそらすが、どのインゴットも丘から運んだ鉱石でできている。"),
    "quest.base.seasoned_fighter": ("Seasoned Fighter", "歴戦の戦士"),
    "quest.base.seasoned_fighter.why": ("Bigger animals and tougher monsters teach Attack faster. Keep fighting until you reach Attack 8; your health grows with Hitpoints as you go.", "大きな動物や手ごわい怪物ほど、攻撃が早く上がる。攻撃レベル8まで戦い続けよう。戦ううちにHPも伸びていく。"),
    "quest.base.tin_find": ("A Silvery Ore", "銀白色の鉱石"),
    "quest.base.tin_find.why": ("Tin is the other half of bronze. It needs Mining 10 and a pickaxe, so keep digging coal and copper to get there. Mine three tin ore. Take three copper from the same seam: bronze wants both.", "スズは青銅のもう半分だ。採掘レベル10とつるはしが要るので、石炭や銅を掘ってレベルを上げよう。スズ鉱石を3個掘ること。同じ鉱脈から銅も3つ。青銅には両方が要る。"),
    "quest.base.rock_collector": ("Rock Collector", "石集め"),
    "quest.base.rock_collector.why": ("Stone comes in many kinds, each with its own ore. Break six different rocks and ores, and your journal's Ores page fills in.", "石にはたくさんの種類があり、鉱石もそれぞれ違う。6種類の岩や鉱石を掘れば、図鑑の鉱石のページが埋まっていく。"),
    "quest.base.patient_angler": ("Patient Angler", "辛抱強い釣り人"),
    "quest.base.patient_angler.why": ("Every catch trains Fishing, and the bigger fish bite only at higher levels. Fish until you reach Fishing 5, when sardines start biting in the sea.", "釣れるたびに釣りが上がり、大きな魚は高いレベルでしか食いつかない。釣りレベル5まで釣ろう。海ではイワシが掛かり始める。"),
    "quest.base.many_kinds": ("Many Kinds of Fish", "さまざまな魚"),
    "quest.base.many_kinds.why": ("Rivers, lakes and the sea bite differently: shrimp anywhere, minnows in fresh water, sardines in the sea, perch in lakes from Fishing 10. Land three different kinds. Cook six of your catch: the best fish are worth a fire.", "川、湖、海では釣れるものが違う。エビはどこでも、ミノーは淡水、イワシは海、パーチは釣りレベル10から湖で釣れる。3種類釣り上げよう。釣った魚を6匹焼こう。いい魚は火にかける価値がある。"),
    "quest.base.far_horizons": ("Far Horizons", "遠い地平線"),
    "quest.base.far_horizons.why": ("The world is big and each biome has its own animals, plants and ores. Stand in twelve different biomes.", "世界は広く、バイオームごとに動物も植物も鉱石も違う。12の異なるバイオームに立とう。"),
    "quest.base.field_guide": ("Field Guide", "野外図鑑"),
    "quest.base.field_guide.why": ("Come within sight of fifteen kinds of animal. The journal's Animals page records each one, and what it drops once you have hunted it.", "15種類の動物を見かけよう。図鑑の動物のページに記録され、狩ればその落とし物も載る。"),
    "quest.base.a_seat_by_the_fire": ("A Seat by the Fire", "炉辺の腰かけ"),
    "quest.base.a_seat_by_the_fire.why": ("A home needs somewhere to sit. A stool is two planks over two sticks (Construction 1); benches and chairs follow. Make two seats and set them by the hearth.", "家には座る場所が要る。スツールは板材2枚の下に棒2本（建築レベル1）、ベンチや椅子もそのあとで作れる。座席を2つ作って炉のそばに置こう。"),
    "quest.base.a_table_for_two": ("A Table for Two", "ふたりのテーブル"),
    "quest.base.a_table_for_two.why": ("Planks on four sticks make a table (Construction 3). Set it near the hearth with a seat on each side; a roof and a table make a house a home.", "板材を棒の脚に載せるとテーブルになる（建築レベル3）。炉の近くに置き、両側に座席を並べよう。屋根とテーブルがあれば家らしくなる。"),
    "quest.base.shelves_and_cupboards": ("Shelves and Cupboards", "棚と戸棚"),
    "quest.base.shelves_and_cupboards.why": ("Somewhere to put things: a shelf (Construction 4) and a cupboard (Construction 6), both from planks at the crafting table. Make one of each.", "ものをしまう場所だ。棚（建築レベル4）と戸棚（建築レベル6）を、作業台で板材から作ろう。1つずつ。"),
    "quest.base.a_proper_bed": ("A Proper Bed", "ちゃんとしたベッド"),
    "quest.base.a_proper_bed.why": ("Sleep on something better than the ground: three wool over three planks (Construction 5). Place it in your home and right-click to sleep.", "地面よりましな寝床を。羊毛3つの下に板材3枚で作る（建築レベル5）。家に置き、右クリックで眠ろう。"),
    "quest.base.wool_and_dye": ("Wool and Dye", "羊毛と染料"),
    "quest.base.wool_and_dye.why": ("A cloth is a wool and a flower of the colour you want, side by side in the grid (Crafting 2): white from a daisy, yellow from a dandelion, red from a poppy. Make two.", "布は、羊毛と好きな色の花を作業枠に並べて作る（工作レベル2）。白はヒナギク、黄色はタンポポ、赤はポピー。2枚作ろう。"),
    "quest.base.a_rug_underfoot": ("A Rug Underfoot", "足もとの敷物"),
    "quest.base.a_rug_underfoot.why": ("Two cloths side by side make three rugs (Crafting 3). Lay them on the floor; curtains, cushions and banners are made from cloth too.", "布2枚を並べると敷物が3枚できる（工作レベル3）。床に敷こう。カーテンやクッションや旗も布から作れる。"),
    "quest.base.earthenware": ("Earthenware", "素焼きの器"),
    "quest.base.earthenware.why": ("Fired clay makes plates, bowls, jars and jugs for the shelf, and a basket is twine. Make three pieces of crockery at the crafting table.", "焼き粘土から、棚に並べる皿、鉢、壺、水差しが作れる。かごはより糸でできる。作業台で器を3つ作ろう。"),
    "quest.base.candlelight": ("Candlelight", "ろうそくの明かり"),
    "quest.base.candlelight.why": ("Twine and two hides make two candles (Crafting 3): a softer light than a torch for a table or shelf.", "より糸と皮2枚でろうそくが2本できる（工作レベル3）。テーブルや棚に置くと、松明より柔らかな明かりになる。"),
    "quest.base.food_enough": ("Food Enough", "食うに困らず"),
    "quest.base.food_enough.why": ("Food that lasts is a farm that works. Show any one: harvest twelve wheat and six carrots or rye, keep four animals well fed and housed (condition at least 75), or land forty fish. Ten loaves of bread are your reward.", "食べ物が絶えないのは、畑と家畜がうまく回っている証だ。次のどれかを示そう：小麦12とニンジンかライ麦6を収穫する、動物4頭を餌と住まいに恵まれた良い状態（コンディション75以上）で飼う、魚を40匹釣る。ごほうびにパンが10個もらえる。"),
    "multiblock.base.bellows_bloomery": ("Bellows Bloomery", "ふいご付き塊鉄炉"),
    "multiblock.base.bellows_bloomery.hint": ("The bloomery needs kiln bricks round it with bellows in the ring, and a hollow shaft of kiln bricks two more blocks high above it.", "塊鉄炉には、ふいごを含む窯レンガの囲いと、その上に2ブロック高い窯レンガの中空の煙突が必要です。"),
    "multiblock.base.coke_oven": ("Coke Oven", "コークス炉"),
    "multiblock.base.coke_oven.hint": ("The coke oven needs a chamber of kiln bricks three on a side round a hollow middle, with the oven in the middle of one side.", "コークス炉には、中が空洞の一辺3ブロックの窯レンガの部屋が必要で、炉は一面の真ん中に置きます。"),
    "multiblock.base.blast_furnace": ("Blast Furnace", "高炉"),
    "multiblock.base.blast_furnace.hint": ("The blast furnace needs kiln bricks round it with bellows in the ring, and a hollow shaft of kiln bricks three more blocks high above it.", "高炉には、ふいごを含む窯レンガの囲いと、その上に3ブロック高い窯レンガの中空の煙突が必要です。"),
    "multiblock.base.turbine_hall": ("Turbine Hall", "タービンホール"),
    "multiblock.base.turbine_hall.hint": ("The turbine hall needs a hall of HV casing five long, three wide and three high, hollow along its middle, with the turbine hall in the middle of the top of one end.", "タービンホールには、長さ5・幅3・高さ3の高圧外装の建屋が必要です。中央の列は空洞にし、片方の端の上段の中央にタービンホールを置きます。"),
    "multiblock.base.processing_array": ("Processing Array", "加工アレイ"),
    "multiblock.base.processing_array.hint": ("The processing array needs a cube of HV casing three on a side, hollow in the middle, with the processing array in the middle of one face.", "加工アレイには、一辺3の高圧外装の立方体が必要です。中央は空洞にし、一つの面の中央に加工アレイを置きます。"),
}
