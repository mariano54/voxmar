    "prayer.base.bark_skin": "樹皮の肌",
    "prayer.base.ember_arm": "熾火の腕",
    "prayer.base.keen_mind": "冴えた心",
    "prayer.base.mending": "癒やし",
    "prayer.base.ward_stab": "刺突の守り",
    "prayer.base.ward_slash": "斬撃の守り",
    "prayer.base.ward_crush": "打撃の守り",
    "prayer.base.stone_skin": "石の肌",
    "prayer.base.forge_arm": "鍛冶の腕",
    "prayer.base.clear_mind": "澄んだ心",
    "prayer.base.keepsake": "形見",
    "prayer.base.ward_missiles": "飛び道具の守り",
    "prayer.base.ward_magic": "魔法の守り",
    "prayer.base.iron_skin": "鉄の肌",
    "prayer.base.titan_arm": "巨人の腕",
