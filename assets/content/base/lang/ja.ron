    "music.track.03-a-crystal-library-hidden-in-old-ruins": "古い遺跡の水晶の書庫",
    "music.track.01-a-misty-pine-forest-at-dawn": "夜明けの霧の松林",
    "music.track.03-a-warm-cabin-deep-in-the-woods": "森の奥の暖かい小屋",
    "music.track.01-a-frozen-lake-at-dusk": "夕暮れの凍った湖",
    "music.track.02-a-quiet-mountain-hut-on-a-winter-night": "冬の夜の山小屋",
    "music.track.03-frost-glittering-on-a-still-morning": "静かな朝の霜",
    "music.track.boss-01-the-guardian-of-a-buried-tomb": "埋もれた墓の守護者",
