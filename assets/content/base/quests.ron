// Quests (engine/src/quest.rs): the quest book's chapters, one per age. A quest completes
// the moment one of its `tasks` holds, however long ago it was done: every goal of the task
// is read from what the player has done (their journal, what they made and cooked, their
// skills, what they carry, a home). They point the way and reward the walk; the one thing
// locked behind a quest is a later age's stations, behind that age's rite (`opens`, and a
// recipe's `age`). `after` names quests that come first (`"a|b"` for either).
//
// Goals: Craft(item, n), Cook(item, n), Catch(fish, n) (Catch("Kinds", n) for kinds),
// Kill(creature, n), Tame(creature, n), Pick(plant, n), Mine(ore, n), Visit(biomes),
// Discover(page, n), Level(skill, n), Have(item, n), Home, Built(multiblock, n),
// LookUp(item) (opened it in the recipe viewer), Thriving(n, percent) (keeps n animals at
// that condition or better right now), CookAt(item, station_tag, n),
// Lit(multiblock, n) (standing and successfully fuelled). Cook
// counts what any station turns out: fired pots and smelted ingots too. Items and creatures may be
// `any` or `tag:TAG`. Rewards: Xp(skill, xp), Item(item, count).
//
// The Nomad chapter as far as the game has it today (quest book v2's N01 to N18); quests
// for what is still to come (tracks, snares, slings, teas, Old Tusk) join as it lands.
(
    quests: [
        (
            name: "look_it_up", age: "nomad", branch: "main", title: "Look It Up",
            why: "Forgotten a recipe? Open the inventory, type part of a name in its search box, and click the item to see how it is made; a right-click shows what it goes into. Look up the stone pickaxe.",
            tasks: [[LookUp("stone_pickaxe")]],
            rewards: [Xp("crafting", 40.0)],
        ),
        (
            name: "first_night", age: "nomad", branch: "main", title: "First Night",
            why: "Make a campfire: put two logs or Wood blocks above two Cobblestones in the 2×2 crafting grid. No stripped wood is needed; cobblestone comes from stone, a few blocks under the dirt or bare on hillsides, and a flint pickaxe breaks it. Place the fire, select raw small game or an egg in your hotbar, and right-click the fire. Rabbits and junglefowl roam open grassland; both give small game, and a junglefowl sometimes an egg. Fists are slow at the hunt too: swing an axe instead; a stone one hits three times as hard as a fist (a stone sword, two cobblestone over a stick, does as well). Wait two seconds; the cooked food goes into your inventory. If it burns, try again. Cooked food heals more than raw food.",
            tasks: [[Craft("campfire", 1), CookAt("tag:edible", "campfire", 1)]],
            rewards: [Xp("cooking", 93.0), Item("torch", 4)],
        ),
        (
            name: "stone_in_hand", age: "nomad", branch: "main", title: "Stone in Hand",
            why: "Bare hands are slow. At the crafting table, three planks over two sticks make a wooden pickaxe: dig a few blocks under the dirt, or into a bare hillside, and break stone for cobblestone. Three cobblestone over two sticks make a stone pickaxe, and a stone axe is shaped like the wooden one. Stone tools mine twice as fast and reach coal for torches.",
            tasks: [[Craft("stone_pickaxe", 1), Craft("stone_axe", 1)]],
            after: ["crafting_table"],
            rewards: [Xp("engineering", 51.0), Xp("mining", 31.0)],
        ),
        (
            name: "a_bed_of_your_own", age: "nomad", branch: "main", title: "A Bed of Your Own",
            why: "Until you sleep somewhere, death sends you back to world spawn. Two feathers and two hides make a sleeping bag, no table needed; wool and hide, or pelts, make one at Crafting 5. Junglefowl on warm grassland drop feathers, and rabbits in the grass drop hides. Set the bag down where you mean to stay and right-click it: you wake there after dying.",
            tasks: [[Craft("sleeping_bag", 1)]],
            after: ["first_night"],
            rewards: [Xp("crafting", 82.0)],
        ),
        (
            name: "where_to_settle", age: "nomad", branch: "explore", title: "Where to Settle",
            why: "Biomes help different work: the woods heal, the water fishes, the mountains mine. Walk until you have stood in three different ones; where you build decides what your home gives.",
            tasks: [[Visit(3)]],
            after: ["stone_in_hand"],
            rewards: [Xp("farming", 100.0), Xp("mining", 100.0), Xp("fishing", 100.0), Item("bread", 2)],
        ),
        (
            name: "homestead_hearth", age: "nomad", branch: "main", title: "Homestead Hearth",
            capstone: true,
            why: "Your home: you wake here after dying, and the road to the Farm age begins. Craft a hearthstone (eight cobblestone round an empty middle) and two chimney blocks (six cobblestone and two clay each). Set the hearthstone in a ring of eight stone or cobblestone blocks level with it, stack both chimneys on one corner stone, then right-click the hearthstone. About 28 cobblestone and 4 clay in all; clay lies on the bottom of ponds and lakes, so wade in and dig it with a shovel (one cobblestone over two sticks).",
            tasks: [[Craft("hearthstone", 1), Craft("chimney", 2), Home]],
            after: ["torchlight"],
            rewards: [Xp("construction", 250.0), Xp("mining", 75.0), Item("seed_pouch", 1), Item("bread", 1)],
        ),
        (
            name: "the_farm_age", age: "nomad", branch: "main", title: "The Farm Age",
            why: "The Farm age opens once you have found your feet: twenty quests of this age done, three of them path capstones, marked gold at their corner in the book. Its stations then open to you: the pit kiln first, for fired clay, then the cooking pot, the well and the rest.",
            tasks: [[QuestsDone("nomad", 20), Capstones("nomad", 3)]],
            after: ["homestead_hearth"],
            opens: "farm",
            rewards: [Xp("crafting", 120.0), Item("clay", 12)],
        ),
        (
            name: "a_friend_in_the_wild", age: "nomad", branch: "hunter", title: "A Friend in the Wild",
            why: "Hold wheat seeds (break wild wheat for them; or, for a rabbit, a wild carrot: a white-flowered plant of meadows and plains, picked by hand), walk up slowly without sprinting or hitting, and right-click a junglefowl. Junglefowl keep to warm grassland and jungle; rabbits to grassland and heath. A tamed hen lays eggs at home: your first step to a farm, and to pets.",
            tasks: [[Tame("junglefowl", 1)], [Tame("rabbit", 1)]],
            after: ["a_tempting_bite"],
            rewards: [Xp("hunter", 180.0), Item("seed_mix", 5)],
        ),
        (
            name: "a_tempting_bite", age: "nomad", branch: "hunter", title: "A Tempting Bite",
            why: "Rabbits bolt and junglefowl scatter, but each comes to a favourite food: a carrot for rabbits (pick a wild carrot by hand, a white-flowered plant of meadows), wheat seeds or wheat for junglefowl (break wild wheat). Hold it and walk slowly, and they come up to you instead of running; switch to your axe once one is close. Draw an animal to you with its favourite food.",
            tasks: [[Lured("any", 1)]],
            after: ["first_night"],
            rewards: [Xp("hunter", 40.0)],
        ),
        (
            name: "bare_hands", age: "nomad", branch: "fishing", title: "First Catch",
            why: "Fish are the easiest food near water. Hold your rod, right-click water and wait for a bite: minnows come first. Land five; cooked fish heal well.",
            tasks: [[Catch("any", 5)]],
            after: ["rod_and_line"],
            rewards: [Xp("fishing", 130.0)],
        ),
        (
            name: "twine_and_thong", age: "nomad", branch: "crafting", title: "Twine and Thong",
            why: "Twine goes into fishing rods, pouches, candles and baskets. Three wheat twist into two twine. Wild wheat grows as lone golden tufts on open grassland, a tuft every twenty blocks or so on plains, steppe and meadows, and a village's fields grow it too. Or cut tall grass with a knife: about one cut in five gives a twine, one in four with a stone knife. Have ten.",
            tasks: [[Craft("twine", 10)], [Have("twine", 10)]],
            after: ["a_handful_of_grain"],
            rewards: [Xp("crafting", 67.0)],
        ),
        (
            name: "set_a_snare", age: "nomad", branch: "hunter", title: "Set a Snare",
            capstone: true,
            why: "A snare catches small game while you do other work. Two twine over two sticks make one (Hunter 1). Set it on grass where rabbits, hares or field mice wander, and go about your day; a sprung snare holds its catch until you come back. Right-click it to take the catch and set it again.",
            tasks: [[Placed("snare", 1), Trapped("any", 1)]],
            after: ["twine_and_thong"],
            rewards: [Xp("hunter", 60.0)],
        ),
        (
            name: "pockets", age: "nomad", branch: "qol", title: "Pockets",
            capstone: true,
            why: "Herbs and seeds eat slots; a pouch holds a thousand of a kind in one. A hide and a twine side by side make a herb pouch, a twine over a hide a seed pouch (Crafting 3).",
            tasks: [[Craft("herb_pouch", 1)], [Craft("seed_pouch", 1)]],
            after: ["twine_and_thong"],
            rewards: [Xp("crafting", 40.0)],
        ),
        (
            name: "torchlight", age: "nomad", branch: "main", title: "Torchlight",
            why: "Light keeps monsters off and lets you work at night. A coal (or a charcoal) over a stick makes four torches; coal shows as black flecks in the rock, and a black-flecked stone lying on the ground marks a seam below it. Any pickaxe breaks it, even a wooden one. Make eight. A night is a third of the day and cannot be slept away: spend it underground by torchlight digging coal, or at home cooking (Meat on the Fire) and crafting.",
            tasks: [[Craft("torch", 8)]],
            after: ["a_bed_of_your_own"],
            rewards: [Xp("engineering", 21.0)],
        ),
        (
            name: "crafting_table", age: "nomad", branch: "main", title: "Crafting Table",
            why: "Four planks in the 2×2 grid of your inventory make a crafting table: a log splits into four planks there. Hold it and right-click the ground to set it down, then right-click the table; its three-by-three grid makes every tool and weapon.",
            tasks: [[Craft("crafting_table", 1)]],
            rewards: [Xp("engineering", 18.0)],
        ),
        (
            name: "an_axe_to_it", age: "nomad", branch: "start", title: "An Axe to It",
            why: "A second axe, of wood: at the crafting table, three planks and two sticks make one (the recipe viewer shows the shape). Make it and chop eight logs; the campfire, planks and sticks ahead all want them. A stone axe, later, chops twice as fast.",
            tasks: [[Craft("wooden_axe", 1), Have("tag:log", 8)]],
            after: ["crafting_table"],
            rewards: [Xp("engineering", 20.0), Item("stick", 4)],
        ),
        (
            name: "a_chopping_block", age: "nomad", branch: "start", title: "A Chopping Block",
            why: "Splitting logs in the grid wastes wood. A chopping block is a flint over a log (Crafting 2): dig gravel, by hand or with a shovel, and about one in eight gives a flint; it lies on stony slopes, game trails and dry stream beds. Set the block down and split logs within reach of it: each gives six planks there, two more than the grid's four. Split two logs by it.",
            tasks: [[Placed("chopping_block", 1), CraftNear("tag:planks", "chopping_block", 12)]],
            after: ["an_axe_to_it", "a_bed_of_your_own"],
            rewards: [Xp("crafting", 40.0), Item("oak_log", 4)],
        ),
        (
            name: "first_ore", age: "nomad", branch: "mining", title: "Red Metal Underfoot",
            capstone: true,
            why: "Copper needs Mining 5 and the pickaxe you have. Mining grows mostly from coal: a score or so of it, with what the early quests give, takes you there. Copper lies in veins underground, mostly below sea level and richest under granite; a small copper-coloured stone lying on the ground marks a vein below it, so dig down there. Mine five; it is the start of every metal.",
            tasks: [[Mine("copper_ore", 5)]],
            after: ["coal_and_cinders"],
            rewards: [Xp("mining", 60.0)],
        ),
        (
            name: "timber", age: "nomad", branch: "start", title: "Timber",
            why: "You start with nothing, and bare hands cannot fell a tree. Flint lies loose on the ground near where you wake, and a dead grey snag breaks by hand to a stick a block. Leaves give sticks too (one break in five), and gravel gives flint (one in eight). In the 2×2 grid, two flint over a stick make a flint axe, and two flint over two sticks a flint pickaxe. Fell four logs with the axe; woods have the most trees, and plains have a few in groves. A log splits into four planks; four planks make a crafting table, and two planks four sticks.",
            tasks: [[Have("tag:log", 4)]],
            rewards: [Xp("engineering", 30.0)],
        ),
        (
            name: "a_pile_of_stone", age: "nomad", branch: "mining", title: "A Pile of Stone",
            why: "Stone is the next step up from wood. It lies a few blocks under the dirt almost everywhere, and bare on cliffs, hillsides and mountains. Break twenty stone with your pickaxe: it drops cobblestone, which makes stone tools, a campfire and, later, your hearth.",
            tasks: [[Mine("tag:stone", 20)]],
            after: ["stone_in_hand"],
            rewards: [Xp("mining", 30.0)],
        ),
        (
            name: "coal_and_cinders", age: "nomad", branch: "mining", title: "Coal and Cinders",
            why: "Coal shows as black flecks in the rock. It lies in wide seams around sea level and below, most often under limestone, sandstone and chalk; a small black-flecked stone lying on the ground marks a seam below it. One coal or charcoal over a stick makes four torches, and it smelts metal later. Mine eight.",
            tasks: [[Mine("coal_ore", 8)]],
            after: ["dig_in"],
            rewards: [Xp("mining", 60.0), Item("torch", 8)],
        ),
        (
            name: "something_to_swing", age: "nomad", branch: "combat", title: "Something to Swing",
            why: "Fists are slow. A stone sword (two cobblestone over a stick) or a bone club (two bones over a stick) hits much harder; field mice in the grass, aurochs and wolves drop bones. Make one at the crafting table.",
            tasks: [[Craft("stone_sword", 1)], [Craft("bone_club", 1)]],
            after: ["stone_in_hand"],
            rewards: [Xp("crafting", 40.0)],
        ),
        (
            name: "a_stones_throw", age: "nomad", branch: "combat", title: "A Stone's Throw",
            why: "A sling hits from twelve blocks away, where a blade must be close: birds, runners, or something you would rather not stand next to. Lay a hide between two twine in a row at the crafting table. Hold it and click a creature in clear sight: each shot throws one cobblestone from your pack, hit or miss, so carry a stack. It hits softer than a stone sword (2 at most), and every hit trains Ranged. A sling stone that hits is left lying where the creature stood about one time in four; one that misses, or hits for nothing, is gone. Walk over and pick up what lies there before you throw again, and a stack of cobblestone lasts. Bring down five creatures and reach Ranged 4.",
            tasks: [[Craft("sling", 1), Kill("any", 5), Level("ranged", 4)]],
            after: ["twine_and_thong", "something_hostile"],
            rewards: [Xp("ranged", 100.0), Xp("crafting", 30.0)],
        ),
        (
            name: "small_game", age: "nomad", branch: "hunter", title: "Small Game",
            why: "Rabbits, junglefowl and other small animals are the easiest food: small game cooks well at a campfire. Look for them on open grassland. Hunt three; a few blows are enough, and each kill trains Hunter. Then cook one of what you killed.",
            tasks: [[Kill("any", 3), Cook("tag:meat", 1)]],
            after: ["something_to_swing"],
            rewards: [Xp("hunter", 80.0)],
        ),
        (
            name: "hide_and_seek", age: "nomad", branch: "hunter", title: "Hide and Seek",
            why: "Hide makes armour, pouches and bedding once it has hung a minute on a drying rack. Rabbits on grassland drop raw hide, and so do deer and boar in the woods; a knife in your hand makes it drop more often. Gather four raw hides, and keep two bones as well: field mice in the grass drop them, and a bone makes a club, a needle, a handle.",
            tasks: [[Have("raw_hide", 4), Have("bone", 2)]],
            after: ["small_game", "a_sharp_edge"],
            rewards: [Xp("hunter", 60.0), Xp("crafting", 30.0)],
        ),
        (
            name: "old_tusk", age: "nomad", branch: "hunter", title: "Old Tusk",
            why: "A great boar roams the woods and the sagebrush steppe by day, alone among the boar: Old Tusk. He grazes until struck, then fights to the end, and his charge crushes. A flint spear (a flint and two sticks, Crafting 2) braces: with no shield in your off hand, right-click to raise it as he crouches, and he runs onto its point and stands dazed. A tree or a wall at your back does the same. Make a spear, then bring him down.",
            tasks: [[Craft("flint_spear", 1), Kill("old_tusk", 1)]],
            after: ["hide_and_seek", "raise_your_guard"],
            rewards: [Xp("hunter", 150.0), Xp("attack", 100.0)],
        ),
        (
            name: "hide_wraps", age: "nomad", branch: "combat", title: "Hide Wraps",
            why: "Armour turns blows aside and trains Defence. Hide gloves (two hide) and boots (three hide) are the cheapest pieces. Make both at the crafting table.",
            tasks: [[Craft("hide_gloves", 1), Craft("hide_boots", 1)]],
            after: ["hide_and_seek"],
            rewards: [Xp("crafting", 50.0), Xp("defence", 40.0)],
        ),
        (
            name: "hard_to_put_down", age: "nomad", branch: "combat", title: "Hard to Put Down",
            capstone: true,
            why: "Two skills grow only in a fight. Defence trains on the blows you turn aside while you fight back against something your match, and Hitpoints, twice your level in health, on every blow you land. Rabbits and fowl cannot hurt you, so wear your hide wraps against boar and wolves in the woods, or the monsters that come out at night. Reach Defence 3 and Hitpoints 11.",
            tasks: [[Level("defence", 3), Level("hitpoints", 11)]],
            after: ["raise_your_guard"],
            rewards: [Xp("defence", 60.0), Xp("hitpoints", 40.0)],
        ),
        (
            name: "meat_and_fire", age: "nomad", branch: "cooking", title: "Meat on the Fire",
            why: "Raw meat heals little and leaves you Queasy; cooked meat heals far more. Cook six pieces of meat at a campfire: small game or duck. Ducks live by rivers and in swamps. A higher Cooking level burns less. Six good meals will also take you to Cooking 2.",
            tasks: [[Cook("tag:meat", 6), Level("cooking", 2)]],
            after: ["first_night"],
            rewards: [Xp("cooking", 120.0)],
        ),
        (
            name: "a_handful_of_grain", age: "nomad", branch: "farming", title: "A Handful of Grain",
            why: "Wild wheat grows as lone golden tufts on open grassland: look on plains, steppe and meadows, where there is a tuft every twenty blocks or so, or break the wheat in a village's fields. Break it for seeds and often an ear of wheat: wheat makes bread and twine, and the seeds are your first crop.",
            tasks: [[Pick("wild_wheat", 3)], [Have("wheat", 3)]],
            after: ["first_night"],
            rewards: [Xp("farming", 40.0)],
        ),
        (
            name: "daily_bread", age: "nomad", branch: "cooking", title: "Daily Bread",
            why: "Two ears of wheat side by side in the crafting grid bake into bread, which heals more than the grain. Bake four loaves.",
            tasks: [[Craft("bread", 4)]],
            after: ["a_handful_of_grain"],
            rewards: [Xp("cooking", 60.0)],
        ),
        (
            name: "break_ground", age: "nomad", branch: "farming", title: "Break Ground",
            why: "A hoe tills grass or dirt into farmland, where seeds can be sown. Make a hoe at the crafting table: two cobblestone over two sticks. Right-click soil with it to till.",
            tasks: [[Craft("stone_hoe", 1)], [Craft("wooden_hoe", 1)], [Craft("copper_hoe", 1)]],
            after: ["daily_bread", "crafting_table"],
            rewards: [Xp("engineering", 40.0), Item("wheat_seeds", 4)],
        ),
        (
            name: "rod_and_line", age: "nomad", branch: "fishing", title: "Rod and Line",
            why: "A fishing rod is three sticks and two twine, laid out at the crafting table as the recipe shows. Twine is three wheat twisted into two. With the rod in hand, right-click water and wait for a bite. Then land one fish.",
            tasks: [[Craft("fishing_rod", 1), Catch("tag:fish", 1)]],
            after: ["twine_and_thong", "crafting_table"],
            rewards: [Xp("crafting", 40.0), Item("twine", 4)],
        ),
        (
            name: "a_fish_supper", age: "nomad", branch: "fishing", title: "A Fish Supper",
            capstone: true,
            why: "A fish tastes far better cooked. Roast three at a campfire: hold the raw fish and right-click the fire. Catch the three yourself.",
            tasks: [[Catch("tag:fish", 3), Cook("tag:fish", 3)]],
            after: ["bare_hands"],
            rewards: [Xp("cooking", 60.0), Xp("fishing", 40.0)],
        ),
        (
            name: "wild_harvest", age: "nomad", branch: "farming", title: "Wild Harvest",
            why: "The wild gives herbs, flowers, berries and mushrooms for the picking. Pick five different kinds by hand; most grow back in time. Flowers and herbs crowd flower meadows, berry bushes and mushrooms grow in the woods, and raspberries in meadows. Your journal's Plants page records each kind you pick. Herbs flavour food, heal and brew into potions later. Pick five herbs: flower meadows are full of chamomile, sorrel and yarrow, mint grows by water, and sage and thyme on warm, dry ground. Carry them in a herb pouch so they do not eat your slots.",
            tasks: [[Kinds(Plants, "any", 5), Pick("tag:herb", 5)]],
            after: ["daily_bread"],
            rewards: [Xp("farming", 110.0)],
        ),
        (
            name: "herb_lore", age: "nomad", branch: "farming", title: "Herb Lore",
            capstone: true,
            why: "Alchemy is knowing what each herb carries. Brewing comes in a later age, but folk on the road teach the first of it now: an old herb gatherer shares lore for a herb, a wandering healer makes a salve of three, and a travelling alchemist wants two each of six kinds. Carry herbs on your rounds and deal with one of them.",
            tasks: [[Met("herb_gatherer", 1)], [Met("travelling_alchemist", 1)], [Met("wandering_healer", 1)]],
            after: ["wild_harvest"],
            rewards: [Xp("alchemy", 30.0), Xp("farming", 40.0)],
        ),
        (
            name: "neighbours", age: "nomad", branch: "explore", title: "Wild Neighbours",
            why: "Walk the land and meet who lives in it. Get right up close to six kinds of animal, within three blocks with nothing in between: rabbits and junglefowl on grassland, deer and boar in the woods, ducks by water. The journal's Animals page fills in as you go, and every kind drops something different.",
            tasks: [[Discover(Animals, 6)]],
            after: ["where_to_settle"],
            rewards: [Xp("hunter", 50.0)],
        ),
        (
            name: "lay_of_the_land", age: "nomad", branch: "explore", title: "Lay of the Land",
            why: "Before you settle, see more of the world. Stand in six different biomes: woods, plains, hills, wetlands and shores each hold different animals, plants and ores.",
            tasks: [[Visit(6)]],
            after: ["neighbours"],
            rewards: [Xp("farming", 60.0)],
        ),
        (
            name: "something_hostile", age: "nomad", branch: "combat", title: "Something Hostile",
            why: "Not everything out there is food. Cave bats and cave crawlers lurk in the dark underground, and shamblers walk where the aether is strong. Fight one with a sword in hand and torches and bread at your belt.",
            tasks: [[Kill("cave_bat", 1)], [Kill("cave_crawler", 1)], [Kill("shambler", 1)]],
            after: ["sharpening_up"],
            rewards: [Xp("attack", 100.0)],
        ),
        (
            name: "sharpening_up", age: "nomad", branch: "combat", title: "Sharpening Up",
            why: "Every blow you land trains Attack, and a higher level hits harder and truer. Hunt until you reach Attack 4. Five kills along the way.",
            tasks: [[Level("attack", 4), Kill("any", 5)]],
            after: ["something_to_swing"],
            rewards: [Xp("hitpoints", 60.0), Item("bread", 2)],
        ),
        (
            name: "raise_your_guard", age: "nomad", branch: "combat", title: "Raise Your Guard",
            why: "A shield blocks blows: right-click to raise your guard as a swing lands. A hide buckler (four hide and a stick) is the easy one; a wooden shield (planks) needs Crafting 3.",
            tasks: [[Craft("hide_buckler", 1)], [Craft("wooden_shield", 1)]],
            after: ["hide_wraps"],
            rewards: [Xp("defence", 80.0), Xp("hitpoints", 100.0)],
        ),
        (
            name: "tools_for_animals", age: "nomad", branch: "farming", title: "Tools for Animals",
            why: "Shears take wool from a tamed mouflon, and a pail takes milk from a tamed mountain goat, reindeer or aurochs. Two cobblestones crossed make shears; two planks crossed make a pail.",
            tasks: [[Craft("shears", 1), Craft("pail", 1)]],
            after: ["break_ground"],
            rewards: [Xp("engineering", 40.0)],
        ),
        (
            name: "a_sharp_edge", age: "nomad", branch: "crafting", title: "A Sharp Edge",
            why: "A knife is the hunter's tool: it makes a kill drop hide more often, cuts plants cleanly, and cuts twine from tall grass. A stone knife is a cobblestone over a stick; it fits the inventory grid.",
            tasks: [[Craft("stone_knife", 1)], [Craft("wooden_knife", 1)]],
            after: ["stone_in_hand"],
            rewards: [Xp("engineering", 30.0)],
        ),
        (
            name: "full_stone_kit", age: "nomad", branch: "crafting", title: "A Full Stone Kit",
            capstone: true,
            why: "A stone tool works twice as fast as a wooden one and finds a little more. Carry the whole kit: pickaxe, axe, shovel (one cobblestone over two sticks), hoe and knife.",
            tasks: [[Have("stone_pickaxe", 1), Have("stone_axe", 1), Have("stone_shovel", 1), Have("stone_hoe", 1), Have("stone_knife", 1)]],
            after: ["a_sharp_edge", "break_ground"],
            rewards: [Xp("engineering", 30.0), Item("torch", 8)],
        ),
        (
            name: "dig_in", age: "nomad", branch: "mining", title: "Dig In",
            why: "The hearth needs four clay, and clay lies on the bottom of ponds and lakes. A stone shovel digs four times faster than bare hands: make one, wade in and dig four.",
            tasks: [[Craft("stone_shovel", 1), Have("clay", 4)]],
            after: ["a_pile_of_stone"],
            rewards: [Xp("engineering", 12.0), Item("bread", 4)],
        ),
        (
            name: "under_lock_and_key", age: "nomad", branch: "explore", title: "Under Lock and Key",
            why: "Locked chests lie where the land hides them: on the floor of a shallow cave, or on a ledge under an overhang of rock, never out in the open or under water. Those near where you began are Nomad chests. A bone lockpick opens one: a bone on a twine grip, Crafting 5. Make one, find a chest and pick its lock.",
            tasks: [[Craft("bone_lockpick", 1), Opened("nomad_treasure_chest", 1)]],
            after: ["twine_and_thong", "small_game"],
            rewards: [Xp("crafting", 40.0), Item("bone_lockpick", 2)],
        ),
        (
            name: "light_sleepers", age: "nomad", branch: "explore", title: "Light Sleepers",
            why: "What sleeps beside a chest under rock may wake as its lock gives: four Nomad chests in ten wake two to four cave bats. Have a weapon to hand before you pick the lock. Open two Nomad chests in all and bring down two cave bats.",
            tasks: [[Opened("nomad_treasure_chest", 2), Kill("cave_bat", 2)]],
            after: ["under_lock_and_key"],
            rewards: [Xp("attack", 60.0), Item("bone_lockpick", 1)],
        ),
        (
            name: "stockpile", age: "nomad", branch: "start", title: "Stockpile",
            capstone: true,
            why: "A home runs on common stock. Carry thirty-two logs and sixty-four cobblestone and nothing you want to build is a trip away. Woods give the logs fastest, and stone lies a few blocks under the dirt almost anywhere.",
            tasks: [[Have("tag:log", 32), Have("cobblestone", 64)]],
            after: ["first_ore"],
            rewards: [Xp("construction", 40.0), Item("torch", 16)],
        ),
        // The Farm age: fired clay, copper and tin, and the Crucible Kiln that opens bronze.
        (
            name: "the_potter", age: "farm", branch: "main", title: "The Potter",
            why: "Pots hold stews, and the pot is the heart of the kiln you are working toward. Shape six clay pots from fired clay at the crafting table: five fired clay in a cup shape make two (Crafting 2).",
            tasks: [[Craft("clay_pot", 6)]],
            after: ["the_farm_age", "fire_the_clay"],
            rewards: [Xp("crafting", 305.0), Item("fired_clay", 4)],
        ),
        (
            name: "a_pot_on_the_fire", age: "farm", branch: "cooking", title: "A Pot on the Fire",
            why: "A cooking pot simmers two grain into porridge, which heals more than bread, while you get on with other work. Make one at the crafting table (Crafting 3): seven fired clay round a clay pot. Set it beside a campfire, or on the hearthstone, with water within four blocks (a well counts). Right-click it with wheat in hand (Cooking 3), and two minutes later take the porridge. Keep two.",
            tasks: [[Craft("cooking_pot", 1), Have("porridge", 2)]],
            after: ["the_potter", "camp_cook"],
            rewards: [Xp("cooking", 120.0), Xp("crafting", 40.0)],
        ),
        (
            name: "a_hearty_stew", age: "farm", branch: "cooking", title: "A Hearty Stew",
            capstone: true,
            why: "At Cooking 14 the pot takes three raw meat, roots or vegetables at once and simmers them into a stew, the best food a pot makes. Carrots, raw small game or raw mutton all go in; cooked food and grain do not. Load it as before, take the stew three minutes later, and keep two.",
            tasks: [[Level("cooking", 14), Have("stew", 2)]],
            after: ["a_pot_on_the_fire", "roots_in_the_embers"],
            rewards: [Xp("cooking", 300.0), Item("honey", 2)],
        ),
        // Fuel: logs to char or coal from a seam, two ways to the Crucible Kiln's charge.
        (
            name: "fuel_to_hand", age: "farm", branch: "fuel", title: "Fuel to Hand",
            why: "Every fire of this age eats fuel: the kilns, the clamps, the copper and at last the Crucible Kiln's charge. Take either way. Fell trees and carry thirty-two logs, to char later; or dig to a coal seam (a small black-flecked stone lying on the ground marks one below) and mine twelve coal ore. Both ways go on to Charcoal.",
            tasks: [[Have("tag:log", 32)], [Mine("coal_ore", 12)]],
            after: ["the_farm_age"],
            rewards: [Xp("mining", 60.0), Xp("engineering", 40.0)],
        ),
        (
            name: "kiln_plans", age: "farm", branch: "fuel", title: "Plans for the Kiln",
            why: "With charcoal made, plan the kiln it burns in: open the recipe viewer and look up the crucible, seven kiln bricks round a clay pot, then look up kiln bricks to see what they take.",
            tasks: [[LookUp("crucible"), LookUp("kiln_bricks")]],
            after: ["charcoal"],
            rewards: [Xp("engineering", 30.0)],
        ),
        // Fuel before metal, and the Engineering and Mining that copper asks for (design
        // drafts 100 and 102: the nomad path alone left both short of 5).
        (
            name: "charcoal", age: "farm", branch: "fuel", title: "Charcoal",
            why: "Fuel before metal: coal or charcoal smelts copper and makes torches. Burn logs down at a campfire (hold a log and right-click the fire), or mine coal ore from a seam: a small black-flecked stone on the ground marks one below. Char sixteen logs, or mine twenty-four coal ore. An earth clamp chars sixteen logs at a time with nobody by it (An Earth Clamp).",
            tasks: [[Cook("charcoal", 16)], [Mine("coal_ore", 24)]],
            after: ["fuel_to_hand", "a_pit_kiln"],
            rewards: [Xp("engineering", 325.0), Xp("mining", 300.0)],
        ),
        (
            name: "the_kiln_charge", age: "farm", branch: "fuel", title: "A Full Charge",
            capstone: true,
            why: "The Crucible Kiln burns a whole charge when it is lit: thirty-two charcoal, or twenty-four coal ore. Keep a clamp charring logs while you fire clay, or bring coal up from the seam, and hold a full charge in your pack.",
            tasks: [[Have("charcoal", 32)], [Have("coal_ore", 24)]],
            after: ["charcoal", "first_bricks", "kiln_plans"],
            rewards: [Xp("engineering", 200.0)],
        ),
        (
            name: "red_metal", age: "farm", branch: "main", title: "Red Metal",
            why: "Copper tools are faster and find more, and copper is three parts of bronze. A small copper-coloured stone on the ground marks a copper vein below it; breaking copper ore takes Mining 5, which the Charcoal quest's reward brings once claimed in the book. Hold copper ore and right-click the crucible of your lit kiln: it melts into ingots (Engineering 5). Three ingots over two sticks at the table make the pickaxe.",
            tasks: [[Mine("copper_ore", 9), Craft("copper_pickaxe", 1)]],
            after: ["charcoal", "crucible_kiln"],
            rewards: [Xp("mining", 650.0), Xp("engineering", 750.0)],
        ),
        (
            name: "crucible_kiln", age: "farm", branch: "main", title: "Crucible Kiln",
            why: "Bronze needs heat a campfire can't reach. With the crucible in the middle of its ring and a brick on each corner, right-click the crucible to check the kiln stands (it names the fuel it wants); then hold the full charge, thirty-two charcoal or twenty-four coal ore, and right-click it again. Lighting the kiln opens the way to the Bronze age.",
            tasks: [[Built("crucible_kiln", 1), Lit("crucible_kiln", 1)]],
            after: ["the_crucible", "the_kiln_ring", "the_kiln_charge"],
            rewards: [Xp("engineering", 905.0)],
        ),
        (
            name: "first_bronze", age: "farm", branch: "main", title: "First Bronze",
            capstone: true,
            why: "Hold three copper ingots, with a tin ore in your pack, and right-click the crucible of your lit kiln: they melt into four bronze ingots, the metal of the next age (Engineering 12). Smelt four.",
            tasks: [[Cook("bronze_ingot", 4)]],
            after: ["crucible_kiln", "red_metal"],
            rewards: [Xp("engineering", 400.0), Item("bronze_ingot", 4)],
        ),
        (
            name: "the_bronze_age", age: "farm", branch: "main", title: "The Bronze Age",
            why: "The Bronze age opens once the Farm age is behind you: thirty quests of this age done, four of them path capstones, marked gold at their corner, and the crucible kiln lit.",
            tasks: [[QuestsDone("farm", 30), Capstones("farm", 4)]],
            after: ["crucible_kiln"],
            opens: "bronze",
            rewards: [Xp("engineering", 300.0), Item("copper_ingot", 6)],
        ),
        (
            name: "clay_banks", age: "farm", branch: "pottery", title: "Clay Banks",
            why: "Pots, vials and kiln bricks are all clay. It lies in patches on the bottom of ponds, lakes and rivers: wade in and dig it with a shovel (one cobblestone over two sticks). Carry out twenty-four.",
            tasks: [[Have("clay", 24)]],
            after: ["the_farm_age"],
            rewards: [Xp("crafting", 60.0)],
        ),
        (
            name: "a_clay_store", age: "farm", branch: "main", title: "Clay in Store",
            why: "Digging clay a trip at a time keeps the kilns waiting. Keep a store by the pit kiln: put thirty-two clay into a chest, a barrel or a crate and leave it there. Clay keeps for ever, and the next load is a step away.",
            tasks: [[Stocked("clay", "chest", 32)], [Stocked("clay", "barrel", 32)], [Stocked("clay", "crate", 32)]],
            after: ["clay_banks", "fire_the_clay"],
            rewards: [Xp("crafting", 80.0), Item("bread", 2)],
        ),
        (
            name: "a_kiln_load", age: "farm", branch: "pottery", title: "A Kiln Load",
            why: "Brick by Brick takes forty fired clay, and the crucible a pot, so keep the pit kiln busy. Fire forty clay in all, counting what you have fired before, and a dozen clay comes back for the next load. Between loads, turn spare fired clay into crockery (Earthenware), fire cobblestone into stone for an altar (A Place to Pray), or hand clay to potters on the road.",
            tasks: [[Cook("fired_clay", 40)]],
            after: ["the_potter"],
            rewards: [Xp("crafting", 120.0), Item("clay", 12)],
        ),
        (
            name: "a_pit_kiln", age: "farm", branch: "main", title: "A Pit Kiln",
            why: "Clay needs more heat than an open fire gives. A pit kiln is a campfire walled in with cobblestone: at the crafting table, put the campfire in the middle of the bottom row with a cobblestone on each side of it and one above each of those, four in all, as the recipe shows. Set it down where the clay is near, then hold clay and right-click it.",
            tasks: [[Craft("pit_kiln", 1), Placed("pit_kiln", 1)]],
            after: ["the_farm_age"],
            rewards: [Xp("construction", 80.0)],
        ),
        (
            name: "an_earth_clamp", age: "farm", branch: "pottery", title: "An Earth Clamp",
            why: "A kiln wants you standing by it; a clamp does not. Heap eight dirt over a log at the crafting table (Construction 3) for an earth clamp, then right-click it with up to sixteen clay or logs in hand. It smoulders for a minute while you dig, chop or mine, and gives back fired clay that never cracks, or charcoal. It is slower than firing by hand, but your hands are free, so keep both going. While it smoulders it is a fire: it smokes bees calm and dries a rack beside it faster. Make a clamp and fire sixteen clay or char sixteen logs.",
            tasks: [[Craft("earth_clamp", 1), CookAt("fired_clay", "earth_clamp", 16)], [Craft("earth_clamp", 1), CookAt("charcoal", "earth_clamp", 16)]],
            after: ["a_pit_kiln"],
            rewards: [Xp("construction", 60.0), Xp("crafting", 40.0)],
        ),
        (
            name: "fire_the_clay", age: "farm", branch: "main", title: "Fire the Clay",
            why: "Hold clay and right-click the pit kiln: after a moment it comes out as fired clay. Low Crafting levels crack some, so bring spare (a cracked one is clay again). Waiting at the kiln? Heap eight dirt over a log for an earth clamp (An Earth Clamp): it fires sixteen at once, none cracked, while you dig. Fire twelve.",
            tasks: [[Cook("fired_clay", 12)]],
            after: ["a_pit_kiln"],
            rewards: [Xp("crafting", 100.0)],
        ),
        (
            name: "first_bricks", age: "farm", branch: "main", title: "First Bricks",
            why: "Kiln bricks are fired clay pressed hard: four fired clay in the crafting grid make two (Crafting 5). Shape four, and keep sixteen more fired clay in your pack for the next eight. The kiln and its crucible want nineteen bricks in all.",
            tasks: [[Craft("kiln_bricks", 4), Have("fired_clay", 16)]],
            after: ["the_potter", "a_clay_store"],
            rewards: [Xp("crafting", 150.0)],
        ),
        (
            name: "brick_by_brick", age: "farm", branch: "main", title: "Brick by Brick",
            why: "The Crucible Kiln is built of kiln bricks: twelve for its ring and corner pillars, and seven for the crucible at its heart. Four fired clay make two bricks in the crafting grid (Crafting 5), so nineteen bricks are forty fired clay. Keep the pit kiln and the clamp going while you dig the next load, and shape nineteen in all, counting your first.",
            tasks: [[Craft("kiln_bricks", 19)]],
            after: ["first_bricks", "a_kiln_load"],
            // Its Engineering pays for The Crucible's level 10 until Hammer and Anvil (the kiln-age
            // PR) does: drop it when that lands, so it is never paid twice. 750 makes the level on
            // The Crucible's own chain (about 1,180 of the 1,154 xp, with the crafts it forces).
            rewards: [Xp("crafting", 300.0), Xp("engineering", 750.0)],
        ),
        (
            name: "the_kiln_ring", age: "farm", branch: "main", title: "The Kiln Ring",
            why: "Choose the kiln's ground, flat and clear, near your pit kiln. Lay eight kiln bricks in a ring round an empty middle, where the crucible will sit, and stand one more on each corner of the ring: twelve bricks set down.",
            tasks: [[Placed("kiln_bricks", 12)]],
            after: ["brick_by_brick"],
            rewards: [Xp("construction", 150.0)],
        ),
        (
            name: "the_crucible", age: "farm", branch: "main", title: "The Crucible",
            why: "The heart of the kiln: seven kiln bricks round a clay pot, shaped at the crafting table (Engineering 10). Engineering grows with every tool, ingot and torch you make, and Charcoal and Brick by Brick pay it well. Make it and set it down in the empty middle of your kiln's ring of bricks.",
            tasks: [[Craft("crucible", 1), Placed("crucible", 1)]],
            after: ["brick_by_brick", "charcoal"],
            rewards: [Xp("engineering", 300.0)],
        ),
        (
            name: "first_harvest", age: "farm", branch: "farming", title: "First Harvest",
            why: "Till grass or dirt with a hoe (right-click), sow wheat seeds (wild wheat gives them) on the farmland (right-click), keeping it within four blocks of water (beside a river, pond or lake), and wait: wheat ripens in about twelve minutes. Break the ripe plants to harvest; a stone hoe reaps the ripe crops around the one you cut. Harvest four. Keep the four wheat you harvest in your pack. While it grows, there is plenty to do: fish (Patient Angler), tame hens (Hens in a Row) or make seats and a table for the hearth (A Table for Two).",
            tasks: [[Pick("wheat_crop", 4), Have("wheat", 4)]],
            after: ["the_farm_age"],
            rewards: [Xp("farming", 100.0), Item("wheat_seeds", 6)],
        ),
        (
            name: "a_field_of_gold", age: "farm", branch: "farming", title: "A Field of Gold",
            why: "One plot is a hobby; a field is a food supply. Keep sowing from your own seed and harvest twenty-four wheat plants. Seeds come back with each harvest, so the field pays for itself. A field that size also teaches Farming 4. Between sowings, cook what your hunting and fishing bring (Camp Cook) or set a herb planter by the door (Herb Garden).",
            tasks: [[Pick("wheat_crop", 24), Level("farming", 4)]],
            after: ["first_harvest"],
            rewards: [Xp("farming", 250.0)],
        ),
        (
            name: "a_well_by_the_field", age: "farm", branch: "farming", title: "A Well by the Field",
            why: "Crops want water within four blocks, so a field far from a river or pond stays poor. A well waters as water does. Make one at the crafting table (Construction 8): a stick, a plank and a stick along the top; a cobblestone, a pail and a cobblestone across the middle; three cobblestones along the bottom. A pail is two planks set corner to corner. Set the well on the ground beside your tilled field, or sunk level with it, no more than four blocks from the crops.",
            tasks: [[Craft("well", 1), Watering("well", 1)]],
            after: ["a_field_of_gold", "a_proper_bed"],
            rewards: [Xp("construction", 120.0), Xp("farming", 80.0)],
        ),
        (
            name: "a_full_granary", age: "farm", branch: "farming", title: "A Full Granary",
            capstone: true,
            why: "A stone hoe reaps every ripe crop in the three by three around the one you cut, and an iron hoe the five by five, so a wide field comes in at a few strokes. Sow a field nine across with your well in it, let it ripen, and bring in sixty-four wheat plants; keep thirty-two wheat of the harvest for bread, twine and feed.",
            tasks: [[Pick("wheat_crop", 64), Have("wheat", 32)]],
            after: ["a_well_by_the_field", "food_enough", "seed_mix", "a_compost_heap"],
            rewards: [Xp("farming", 300.0), Item("bread", 6), Item("seed_mix", 8)],
        ),
        (
            name: "carrot_patch", age: "farm", branch: "farming", title: "Carrot Patch",
            why: "Carrots need Farming 5 and cool, moist soil. A carrot is its own seed: forage wild carrots (white-flowered, thickest in flower meadows, a few on plains), plant what you get, and harvest four. Rabbits love them too. Keep the four carrots you harvest. Carrots take a little longer than wheat; four crops sown by your home also make a kitchen garden (A Kitchen Garden) while they grow.",
            tasks: [[Pick("carrot_crop", 4), Have("carrot", 4)]],
            after: ["herb_garden"],
            rewards: [Xp("farming", 150.0), Item("carrot", 4)],
        ),
        (
            name: "herb_garden", age: "farm", branch: "farming", title: "Herb Garden",
            why: "Herbs cannot be sown, but a herb planter (planks round dirt, Construction 3) lets a picked herb grow back at home. Make a planter, set a herb in it, and pick it again when it returns. Pick six wild plants on your rounds as well. While a herb grows back, sow four crops by the house (A Kitchen Garden).",
            tasks: [[Craft("herb_planter", 1), Pick("any", 6)]],
            after: ["a_field_of_gold"],
            rewards: [Xp("construction", 80.0), Xp("farming", 60.0)],
        ),
        (
            name: "camp_cook", age: "farm", branch: "cooking", title: "Camp Cook",
            why: "Every dish trains Cooking. Duck wants level 3, mutton 5 and crab 6, and a higher level burns less. Cook a mix of meat and fish, whatever your hunting and fishing bring, until you reach Cooking 5.",
            tasks: [[Level("cooking", 5)]],
            after: ["the_farm_age"],
            rewards: [Item("bread", 6)],
        ),
        (
            name: "seed_mix", age: "farm", branch: "farming", title: "Seed Mix",
            why: "Kept animals only breed when fed their breeding food. Two seeds and a wheat in the crafting grid make seed mix (Cooking 8), which readies any kept animal to breed. Make four. Bring in eight wheat to make it from.",
            tasks: [[Craft("seed_mix", 4), Pick("wheat_crop", 8)]],
            after: ["camp_cook", "a_field_of_gold"],
            rewards: [Xp("cooking", 150.0), Xp("farming", 100.0)],
        ),
        (
            name: "roots_in_the_embers", age: "farm", branch: "cooking", title: "Roots in the Embers",
            why: "A roast carrot heals better than a raw one, and roots are easy food to grow. Roast four carrots on a campfire (Cooking 2).",
            tasks: [[Cook("roast_carrot", 4)]],
            after: ["carrot_patch"],
            rewards: [Xp("cooking", 120.0)],
        ),
        (
            name: "hens_in_a_row", age: "farm", branch: "husbandry", title: "Hens in a Row",
            why: "Hold wheat seeds (wild wheat and your own field give them), walk up slowly (no sprinting, no hitting) and right-click a junglefowl until it trusts you; they keep to warm grassland and jungle. A kept hen needs room, grass or feed, and water nearby, and lays an egg about every five minutes. Tame three.",
            tasks: [[Tame("junglefowl", 3)]],
            after: ["first_harvest"],
            rewards: [Xp("farming", 100.0), Xp("hunter", 180.0)],
        ),
        (
            name: "a_trough_for_the_pen", age: "farm", branch: "husbandry", title: "A Trough for the Pen",
            why: "Kept animals graze within seven blocks of home, and a full pen strips its grass and goes hungry. A feed trough is five planks in a low U (Construction 4). Set it by the pen and stock it with eight wheat: a hungry animal with nothing to graze walks to it and eats one of its foods, so the pen is fed while you are away.",
            tasks: [[Placed("feed_trough", 1), Stocked("wheat", "feed_trough", 8)]],
            after: ["hens_in_a_row"],
            rewards: [Xp("construction", 80.0), Xp("farming", 60.0)],
        ),
        (
            name: "fresh_eggs", age: "farm", branch: "husbandry", title: "Fresh Eggs",
            why: "A kept hen lays on the ground near her, and a hen that is fed, watered and sheltered lays more. Fry your first egg on a campfire to taste the reward, then collect five more and keep them. A hen lays about every five minutes: meanwhile go after a mouflon (A Woolly Flock) or tame more animals about the house (A Full House).",
            tasks: [[Have("egg", 5), Cook("fried_egg", 1)]],
            after: ["hens_in_a_row"],
            rewards: [Xp("farming", 100.0)],
        ),
        (
            name: "a_proper_breakfast", age: "farm", branch: "cooking", title: "A Proper Breakfast",
            side: true,
            why: "A fried egg is the quickest cooking there is: hold an egg and right-click a campfire. Fry three.",
            tasks: [[Cook("fried_egg", 3)]],
            after: ["a_full_house"],
            rewards: [Xp("cooking", 100.0)],
        ),
        (
            name: "a_woolly_flock", age: "farm", branch: "husbandry", title: "A Woolly Flock",
            why: "Mouflon, the wild sheep, need Hunter 5 to tame (taming, hunting and Bigger Game teach it); look on mountains and heath. Hold wheat, its favourite, approach calmly and right-click. A kept sheep grows its wool back: shear it with your shears. Have your shears made before you go.",
            tasks: [[Tame("mouflon", 1), Craft("shears", 1)]],
            after: ["fresh_eggs"],
            rewards: [Xp("hunter", 200.0), Xp("farming", 100.0)],
        ),
        (
            name: "wool_gathering", age: "farm", branch: "husbandry", title: "Wool Gathering",
            why: "Wool makes beds, cloth and sleeping bags. Right-click a kept sheep with shears in hand whenever its wool has grown back, and gather six. Wool grows back in about six minutes: dye the first of it into cloth meanwhile, for a rug once the home is homely, or go after milk (The Milk Pail).",
            tasks: [[Have("wool", 6)]],
            after: ["a_woolly_flock"],
            rewards: [Xp("farming", 120.0), Xp("crafting", 60.0)],
        ),
        (
            name: "ducks_on_the_pond", age: "farm", branch: "husbandry", title: "Ducks on the Pond",
            side: true,
            why: "Mallards need Hunter 3, lay eggs, and do not mind rain. They keep to rivers and wetlands. Hold wheat seeds or wheat, their favourite, approach one by the water without sprinting or hitting, and right-click it.",
            tasks: [[Tame("mallard", 1)]],
            after: ["a_proper_breakfast"],
            rewards: [Xp("hunter", 100.0)],
        ),
        (
            name: "the_milk_pail", age: "farm", branch: "husbandry", title: "The Milk Pail",
            why: "A tamed mountain goat (Hunter 8), reindeer (10) or aurochs (12) gives milk to a pail, right-clicked. Goats live on mountains and take wheat or an apple; reindeer live on tundra and in taiga and take a mushroom; aurochs graze the plains and take wheat. Hold the food, approach calmly and right-click to tame one. Milk heals half as fast again for a while. Collect two. Make the pail first: two planks crossed. An animal gives milk about every five minutes; between pails, tame more toward a real farm.",
            tasks: [[Craft("pail", 1), Have("milk", 2)]],
            after: ["wool_gathering"],
            rewards: [Xp("farming", 250.0)],
        ),
        (
            name: "a_full_pen", age: "farm", branch: "husbandry", title: "A Full Pen",
            capstone: true,
            why: "Six animals under your care is a real farm. Keep each fed, watered, roofed against rain and given room; condition decides what they give. You can keep up to 64 animals.",
            tasks: [[Tame("any", 6)]],
            after: ["the_milk_pail", "a_trough_for_the_pen"],
            rewards: [Xp("farming", 200.0), Item("feed_trough", 1), Item("seed_mix", 4)],
        ),
        (
            name: "bigger_game", age: "farm", branch: "hunter", title: "Bigger Game",
            why: "Sheep, deer, boar and cattle give more meat and better hides, but they fight back: wear your hide wraps and keep your sword sharp. Red deer and wild boar keep to the woods, aurochs to the plains, mouflon to the mountains. Cook the haunch: mutton at Cooking 5, pork at 8, venison at 15.",
            tasks: [[Kill("mouflon", 2)], [Kill("red_deer", 1)], [Kill("wild_boar", 1)], [Kill("aurochs", 1)]],
            after: ["the_farm_age"],
            rewards: [Xp("hunter", 200.0), Xp("attack", 100.0)],
        ),
        (
            name: "full_hide_wraps", age: "farm", branch: "combat", title: "Full Hide Wraps",
            why: "A whole set guards head, body and legs. At the crafting table a hood takes five hides, a tunic eight and trousers seven.",
            tasks: [[Craft("hide_hood", 1), Craft("hide_tunic", 1), Craft("hide_trousers", 1)]],
            after: ["bigger_game"],
            rewards: [Xp("crafting", 150.0), Xp("defence", 150.0)],
        ),
        (
            name: "copper_arms", age: "farm", branch: "combat", title: "Copper Arms",
            why: "Copper hits harder and lasts longer than stone. Smelt ingots (ore over charcoal in the grid, Engineering 5), then at the crafting table make a copper sword (two ingots over a stick) and a copper shield (six ingots round a plank, as the recipe shows).",
            tasks: [[Craft("copper_sword", 1), Craft("copper_shield", 1)]],
            after: ["copper_kit"],
            rewards: [Xp("engineering", 200.0), Xp("attack", 100.0)],
        ),
        (
            name: "bow_and_arrow", age: "farm", branch: "combat", title: "Bow and Arrow",
            side: true,
            why: "A short bow reaches twenty blocks and hits twice as hard as a sling. At the crafting table, three sticks bent down one side and three twine down the other make it (Crafting 3). An arrow is a flint or a cobblestone over a stick over a feather, four at a time (Crafting 3): flint comes one gravel in eight, and feathers from junglefowl. The bow needs Ranged 3 to shoot (below it, it strikes as a fist), so keep slinging stones until then. Make the bow and eight arrows, and reach Ranged 5.",
            tasks: [[Craft("short_bow", 1), Craft("arrow", 8), Level("ranged", 5)]],
            after: ["full_hide_wraps"],
            rewards: [Xp("ranged", 120.0), Xp("crafting", 60.0)],
        ),
        (
            name: "every_arrow_counts", age: "farm", branch: "combat", title: "Every Arrow Counts",
            side: true,
            why: "An arrow that hits is left lying where the creature stood half the time; one that misses, or hits for nothing, is gone. Pick them up as you go and a quiver lasts. Make sixteen arrows in all and reach Ranged 8.",
            tasks: [[Craft("arrow", 16), Level("ranged", 8)]],
            after: ["bow_and_arrow"],
            rewards: [Xp("ranged", 150.0), Item("arrow", 8)],
        ),
        (
            name: "copper_mail", age: "farm", branch: "combat", title: "Copper Mail",
            side: true,
            why: "A copper helmet takes five ingots and a chestplate eight, at the crafting table (Engineering 5). They turn aside far more than hide does, and every ingot is ore you carried out of the hills.",
            tasks: [[Craft("copper_helmet", 1), Craft("copper_chestplate", 1)]],
            after: ["copper_arms"],
            rewards: [Xp("engineering", 400.0), Xp("defence", 200.0)],
        ),
        (
            name: "seasoned_fighter", age: "farm", branch: "combat", title: "Seasoned Fighter",
            why: "Bigger animals and tougher monsters teach Attack faster. Keep fighting until you reach Attack 6; your health grows with Hitpoints as you go.",
            tasks: [[Level("attack", 6)]],
            after: ["bigger_game", "full_hide_wraps"],
            rewards: [Xp("hitpoints", 200.0)],
        ),
        (
            name: "the_rootmother", age: "farm", branch: "combat", title: "The Rootmother",
            why: "Under the oldest woods, in the Old Growth Forest, the Dark Forest, the Redwood Forest and the Old Growth Taiga, a passage slopes down into a hollow of living root, and the Rootmother waits there. Cut her and she grows back: what do woodsmen do with stumps? A campfire or torch within four blocks of her, or the sun on her back, stops her mending. Block her lash; dodge her grasp, which no guard holds. Below half she rears and wakes: a quicker thrash, and seeds flung at anyone who keeps away. Train to Attack 12 and Defence 10, then bring her down. Her heartroot heals, and leaves you Heartwood.",
            tasks: [[Level("attack", 12), Level("defence", 10)], [Kill("rootmother", 1)]],
            after: ["seasoned_fighter", "copper_arms"],
            rewards: [Xp("attack", 500.0), Xp("defence", 300.0), Item("gold_coin", 10)],
        ),
        (
            name: "heart_of_the_wood", age: "farm", branch: "combat", title: "Heart of the Wood",
            capstone: true,
            why: "The Rootmother leaves three heartroot. Eaten, one gives Heartwood for ten minutes: room for a fifth more health, and you heal a quarter faster. Another eaten while it lasts only starts the ten minutes again, so keep the rest for the next hard fight. Eat one and keep two.",
            tasks: [[Ate("heartroot", 1), Have("heartroot", 2)]],
            after: ["the_rootmother"],
            rewards: [Xp("hitpoints", 200.0), Item("heartroot", 2)],
        ),
        (
            name: "tin_find", age: "farm", branch: "mining", title: "A Silvery Ore",
            why: "Tin is the other half of bronze. It needs Mining 10 and a pickaxe, so keep digging coal and copper to get there. Tin lies in the lower part of copper veins: where you found copper, dig below it. Mine three tin ore. Take three copper from the same seam: bronze wants both.",
            tasks: [[Mine("tin_ore", 3), Mine("copper_ore", 3)]],
            after: ["copper_kit"],
            rewards: [Xp("mining", 200.0)],
        ),
        (
            name: "rock_collector", age: "farm", branch: "mining", title: "Rock Collector",
            why: "Stone comes in many kinds, each with its own ore. The rock underfoot changes every few kilometres (granite, limestone, basalt, sandstone, slate), so dig down in different lands. Break six different rocks and ores, and your journal's Ores page fills in.",
            tasks: [[Discover(Ores, 6)]],
            after: ["tin_find"],
            rewards: [Xp("mining", 120.0)],
        ),
        (
            name: "patient_angler", age: "farm", branch: "fishing", title: "Patient Angler",
            why: "Every catch trains Fishing, and the bigger fish bite only at higher levels. Fish until you reach Fishing 5, when sardines start biting in the sea.",
            tasks: [[Level("fishing", 5)]],
            after: ["the_farm_age"],
            rewards: [Xp("cooking", 100.0)],
        ),
        (
            name: "many_kinds", age: "farm", branch: "fishing", title: "Many Kinds of Fish",
            capstone: true,
            why: "Rivers, lakes and the sea bite differently: minnows anywhere, sardines in the sea, perch in lakes from Fishing 10. Land two different kinds. Cook six of your catch: the best fish are worth a fire.",
            tasks: [[Catch("Kinds", 2), Cook("tag:fish", 6)]],
            after: ["patient_angler"],
            rewards: [Xp("fishing", 150.0), Item("drying_rack", 1)],
        ),
        (
            name: "far_horizons", age: "farm", branch: "explore", title: "Far Horizons",
            why: "The world is big and each biome has its own animals, plants and ores. Stand in twelve different biomes.",
            tasks: [[Visit(12)]],
            after: ["the_farm_age"],
            rewards: [Xp("farming", 150.0), Xp("mining", 150.0), Xp("fishing", 150.0)],
        ),
        (
            name: "what_sleeps_below", age: "farm", branch: "explore", title: "What Sleeps Below",
            side: true,
            why: "Farm chests lie further from where you began, on wilder land, and deeper: on cave floors ten blocks and more under the ground. A bone lockpick still opens one, as a pick of the age before always does. Four in ten wake one or two cave crawlers as the lock gives. A crawler has twice a bat's health: come with a copper weapon and food. Open two Farm chests in all and bring down a cave crawler.",
            tasks: [[Opened("farm_treasure_chest", 2), Kill("cave_crawler", 1)]],
            after: ["far_horizons"],
            rewards: [Xp("mining", 270.0), Xp("attack", 80.0)],
        ),
        (
            name: "field_guide", age: "farm", branch: "explore", title: "Field Guide",
            why: "Get right up close to fifteen kinds of animal, within three blocks with nothing in between. The journal's Animals page records each one, and what it drops once you have hunted it.",
            tasks: [[Discover(Animals, 15)]],
            after: ["far_horizons"],
            rewards: [Xp("hunter", 250.0)],
        ),
        (
            name: "a_table_for_two", age: "farm", branch: "home", title: "A Table for Two",
            why: "A home needs somewhere to sit. Furniture is made from oak, birch or dark oak planks. A stool is two planks over two sticks (Construction 1); benches and chairs follow. Make two seats at the crafting table and set them by the hearth. Planks on four sticks make a table (Construction 3). Set it near the hearth with a seat on each side; a roof and a table make a house a home.",
            tasks: [[Craft("tag:seat", 2), Craft("tag:table", 1)]],
            after: ["the_farm_age"],
            rewards: [Xp("construction", 270.0)],
        ),
        (
            name: "shelves_and_cupboards", age: "farm", branch: "home", title: "Shelves and Cupboards",
            why: "Somewhere to put things: a shelf (Construction 4) and a cupboard (Construction 6), both from planks at the crafting table. Make one of each.",
            tasks: [[Craft("tag:shelf", 1), Craft("tag:cupboard", 1)]],
            after: ["a_table_for_two"],
            rewards: [Xp("construction", 200.0)],
        ),
        (
            name: "a_proper_bed", age: "farm", branch: "home", title: "A Proper Bed",
            why: "Sleep on something better than the ground: three wool over three oak, birch or dark oak planks at the crafting table (Construction 5). Place it in your home and right-click to sleep.",
            tasks: [[Craft("oak_bed", 1)], [Craft("birch_bed", 1)], [Craft("dark_oak_bed", 1)]],
            after: ["shelves_and_cupboards"],
            rewards: [Xp("construction", 150.0)],
        ),
        (
            name: "a_rug_underfoot", age: "farm", branch: "home", title: "A Rug Underfoot",
            why: "A homely home (A Homely Home) wants a rug, and wool from your flock (Wool Gathering) makes one. A cloth is a wool and a flower of the colour you want, side by side in the grid (Crafting 2): white from a daisy, yellow from a dandelion, red from a poppy. Daisies grow on plains, dandelions in flower meadows, poppies on the steppe. Make two. Two cloths side by side make three rugs (Crafting 3). Lay them on the floor; curtains, cushions and banners are made from cloth too.",
            tasks: [[Craft("tag:cloth", 2), Craft("tag:rug", 1)]],
            after: ["a_homely_home", "wool_gathering"],
            rewards: [Xp("crafting", 180.0)],
        ),
        (
            name: "earthenware", age: "farm", branch: "pottery", title: "Earthenware",
            why: "Fired clay makes plates, bowls, jars and jugs for the shelf. Two fired clay side by side make two plates, and three in a V make two bowls (Crafting 2); a jar takes three and a jug five (Crafting 3), and a basket is five twine. Make three pieces of crockery at the crafting table.",
            tasks: [[Craft("tag:crockery", 3)]],
            after: ["a_kiln_load"],
            rewards: [Xp("crafting", 120.0)],
        ),
        (
            name: "candlelight", age: "farm", branch: "home", title: "Candlelight",
            why: "With shelves and cupboards up (Shelves and Cupboards), light them: twine and two hides make two candles (Crafting 3), a softer light than a torch for a table or shelf.",
            tasks: [[Craft("candle", 2)]],
            after: ["shelves_and_cupboards"],
            rewards: [Xp("crafting", 60.0)],
        ),
        (
            name: "food_enough", age: "farm", branch: "farming", title: "Food Enough",
            why: "Food that lasts is a farm that works. Show any one: harvest twelve wheat and six carrots or rye (rye seed comes from village fields), keep four animals well fed and housed (condition at least 75), or land twenty-five fish. Ten loaves of bread are your reward.",
            tasks: [[Pick("wheat_crop", 12), Pick("carrot_crop", 6)], [Pick("wheat_crop", 12), Pick("rye_crop", 6)], [Thriving(4, 75)], [Catch("any", 25)]],
            after: ["kitchen_garden"],
            rewards: [Xp("farming", 530.0), Item("bread", 10)],
        ),
        (
            name: "copper_kit", age: "farm", branch: "mining", title: "Copper Kit",
            why: "Copper works seven times as fast as a bare hand, a step above stone, and finds more; a tool's tooltip says how fast it works. Make an axe (three ingots), a shovel (one) and a knife (one), and a copper hoe (two). Each ingot is smelted from copper ore in the crucible of your lit kiln.",
            tasks: [[Craft("copper_axe", 1), Craft("copper_shovel", 1), Have("copper_hoe", 1), Craft("copper_knife", 1)]],
            after: ["red_metal"],
            rewards: [Xp("engineering", 60.0), Item("coal_ore", 8)],
        ),
        (
            name: "make_camp", age: "nomad", branch: "home", title: "Make Camp",
            why: "A camp is a bed and a light together. Put your sleeping bag down, set a torch beside it and sleep in it once: wherever you wake is your home, and a camp heals you a fifth faster.",
            tasks: [[Built("home_camp", 1)], [Built("home_hearthside", 1)], [Built("home_snug", 1)], [Built("home_homely", 1)], [Built("home_cosy", 1)], [Built("home_heart_of_the_home", 1)]],
            after: ["torchlight"],
            rewards: [Xp("construction", 40.0), Item("torch", 4)],
        ),
        (
            name: "snug_for_winter", age: "farm", branch: "home", title: "Snug for Winter",
            why: "With a proper bed (A Proper Bed) and candles (Candlelight), put a roof over the Hearth with the bed and two lights beside it, and the home turns snug: warm under a roof, you heal half as fast again there, and a night's sleep in it rests you better.",
            tasks: [[Built("home_snug", 1)], [Built("home_homely", 1)], [Built("home_cosy", 1)], [Built("home_heart_of_the_home", 1)]],
            after: ["a_proper_bed", "candlelight"],
            rewards: [Xp("construction", 120.0), Item("candle", 4)],
        ),
        (
            name: "shut_the_door", age: "farm", branch: "home", title: "Shut the Door",
            why: "The night is dark and anything may wander in. Six planks of any wood make a wooden door at a table (Construction 2). Set it in a doorway two blocks high and it fills both; right-click to open or shut it. Shut, nothing walks through, and no creature opens it. Indoors at home behind a shut door you heal a tenth faster and keep a degree warmer (Door shut). Make a door, hang it, and shut yourself in.",
            tasks: [[Craft("wooden_door", 1), Felt("door_shut")]],
            after: ["snug_for_winter"],
            rewards: [Xp("construction", 60.0)],
        ),
        (
            name: "workshop_and_stove", age: "farm", branch: "rooms", title: "A Stove and a Quern",
            why: "A home that works for you. A stove is a campfire under a row of three cobblestones with one more on each side of it, five in all (Construction 5). For the workshop, make one of these: quern stones are four cobblestones in a square under a stick (Crafting 5); a spindle stand is an oak plank, two sticks and a twine in a square (Crafting 6); a loom frame is oak planks, sticks and a twine (Crafting 8). All at the crafting table.",
            tasks: [[Craft("cottage_stove", 1), Craft("tag:workshop", 1)]],
            after: ["snug_for_winter"],
            rewards: [Xp("construction", 80.0), Xp("crafting", 80.0)],
        ),
        (
            name: "books_and_banners", age: "farm", branch: "home", title: "Books and Banners",
            why: "A bookshelf (planks and hides, Construction 8) and a banner (cloth and a stick, Crafting 5) say whose home this is. Make one of each.",
            tasks: [[Craft("tag:books", 1), Craft("tag:banner", 1)]],
            after: ["a_rug_underfoot"],
            rewards: [Xp("construction", 120.0), Xp("crafting", 80.0)],
        ),
        (
            name: "a_homely_home", age: "farm", branch: "home", title: "A Homely Home",
            why: "Room to sit, work and store: two seats, a table, two places to keep things and a third light under the roof. A homely home helps you learn a twentieth faster.",
            tasks: [[Built("home_homely", 1)], [Built("home_cosy", 1)], [Built("home_heart_of_the_home", 1)]],
            after: ["shut_the_door"],
            rewards: [Xp("construction", 200.0), Item("bread", 8)],
        ),
        (
            name: "light_in_the_window", age: "farm", branch: "home", title: "Light in the Window",
            why: "A lit home shows at night: a window glows by the light of the room behind it. A hide window is a hide in a frame of eight sticks (Construction 3), two at a time. Make two and set them in the walls of your lit home, then look back at it after dark.",
            tasks: [[Craft("hide_window", 2), Placed("hide_window", 2)]],
            after: ["a_homely_home"],
            rewards: [Xp("construction", 120.0)],
        ),
        (
            name: "a_cosy_home", age: "farm", branch: "home", title: "A Cosy Home",
            why: "Soft and bright: two rugs, two curtains, a cushion, three pieces of crockery and a fourth light. A cosy home heals you faster and teaches a tenth more, and a night in it is a deep rest.",
            tasks: [[Built("home_cosy", 1)], [Built("home_heart_of_the_home", 1)]],
            after: ["a_rug_underfoot", "light_in_the_window", "earthenware"],
            rewards: [Xp("construction", 300.0), Item("candle", 6)],
        ),
        (
            name: "heart_of_the_home", age: "farm", branch: "home", title: "Heart of the Home",
            capstone: true,
            why: "Everything a home needs: a bookshelf, a stove or cauldron, a quern, spindle or loom, and a banner, all in a cosy home. Heal twice as fast and learn an eighth more where you live.",
            tasks: [[Built("home_heart_of_the_home", 1)]],
            after: ["a_cosy_home", "books_and_banners", "a_proper_workshop"],
            rewards: [Xp("construction", 500.0), Xp("cooking", 200.0), Item("bread", 12), Item("chest", 2)],
        ),
        (
            name: "ore_run", age: "farm", branch: "mining", title: "An Ore Run",
            capstone: true,
            why: "Bronze needs a good store of ore. With a copper kit you dig fast: bring up twenty-four copper, nine tin and twelve coal ore, and the crucible will not wait on you. Copper lies below sea level with tin in the lower part of the same vein, coal in seams near sea level; small copper and coal stones lying on the ground mark the veins below.",
            tasks: [[Mine("copper_ore", 24), Mine("tin_ore", 9), Mine("coal_ore", 12)]],
            after: ["rock_collector", "crucible_kiln"],
            rewards: [Xp("mining", 400.0), Item("coal_ore", 16)],
        ),
        (
            name: "a_place_to_pray", age: "farm", branch: "prayer", title: "A Place to Pray",
            why: "An altar is built of stone bricks, and bricks are cut from smooth stone. Hold cobblestone and right-click your pit kiln: it comes out as stone. Four stone in a square make four stone bricks, and seven bricks (three across the top, one in the middle, three across the bottom) make a stone altar at the crafting table (Construction 5). Place it and right-click it: your prayer points fill, and a bone in hand is offered for Magic experience. Then press C and open Prayers to turn Bark Skin on.",
            tasks: [[Craft("stone_altar", 1)]],
            after: ["a_pit_kiln"],
            rewards: [Xp("magic", 120.0)],
        ),
        (
            name: "bones_for_the_altar", age: "farm", branch: "prayer", title: "Bones for the Altar",
            why: "Each bone offered at the altar is 16 Magic experience. At Magic 4 Ember Arm opens, a little more melee damage; at Magic 10, Mending, which brings your health back twice as fast.",
            tasks: [[Level("magic", 4)]],
            after: ["altar_rites"],
            rewards: [Xp("magic", 100.0)],
        ),
        // Quests that meet the rest of the game: wanderers dealt with (`Met`), the home's rooms
        // (its `Built` steps), and the altar (`Offered`, `Prayed`).
        (
            name: "folk_of_the_road", age: "nomad", branch: "explore", title: "Folk of the Road",
            why: "Once you have been about a while, people pass by now and then: a pedlar with a hound, berry pickers, a hunter sitting hurt by the path, a child who has lost the way. They come at the edge of sight, and not often, so watch the land around you. Walk up and right-click one; most want something you hold (a hide, a bone, food) and give something back. Deal with one of them.",
            tasks: [[Met("any", 1)]],
            after: ["where_to_settle"],
            rewards: [Xp("crafting", 60.0), Item("bread", 2)],
        ),
        (
            name: "a_kind_turn", age: "nomad", branch: "explore", title: "A Kind Turn",
            why: "Not everyone on the road is well. A child who followed a butterfly wanders one spot, lost; a hunter sits hurt by the path. Food in your hand is what both need: right-click them holding it. The child then follows you to the nearest settlement, where the family thanks you; the hunter shows you a trick of the hunt.",
            tasks: [[Met("lost_child", 1)], [Met("wounded_hunter", 1)]],
            after: ["folk_of_the_road"],
            rewards: [Xp("hitpoints", 80.0), Xp("hunter", 60.0)],
        ),
        (
            name: "something_for_something", age: "nomad", branch: "explore", title: "Something for Something",
            why: "Folk on the road swap. A pedlar with a hound takes a hide, bone or feather for twine, seed mix or bread; berry pickers give a loaf for eight berries; woodcutters four coins for eight logs; charcoal burners two charcoal for a dozen logs. Hold what they want and right-click one of them.",
            tasks: [[Met("pedlar_and_hound", 1)], [Met("tinker_camp", 1)], [Met("berry_pickers", 1)], [Met("woodcutters", 1)], [Met("charcoal_burners", 1)]],
            after: ["folk_of_the_road"],
            rewards: [Xp("crafting", 80.0), Item("twine", 4)],
        ),
        (
            name: "a_bench_to_work_at", age: "nomad", branch: "home", title: "A Bench to Work At",
            why: "Set your crafting table at home with a seat and a light beside it: a stool is two planks over two sticks (Construction 1), and a torch is the light. At home you then craft and build as if a level higher.",
            tasks: [[Built("home_workbench", 1)], [Built("home_workshop", 1)]],
            after: ["a_lit_corner", "crafting_table"],
            rewards: [Xp("construction", 60.0), Xp("crafting", 40.0)],
        ),
        (
            name: "pantry_shelves", age: "nomad", branch: "home", title: "Pantry Shelves",
            why: "Two places to store things by a fire make a pantry: the good a meal does lasts a quarter longer when you eat it there. A crate stack is five planks and a stick (Construction 2); a basket of five twine works too (Crafting 3). A campfire by your bed is fire enough.",
            tasks: [[Built("home_pantry", 1)], [Built("home_larder", 1)]],
            after: ["company_at_camp"],
            rewards: [Xp("construction", 60.0), Item("bread", 2)],
        ),
        (
            name: "from_the_shelves", age: "nomad", branch: "home", title: "From the Shelves",
            capstone: true,
            why: "No need to carry it all: at home, open your pack, look a recipe up (U or R over an item) and press Lay. The grid fills from your pack and from every store in your home, nearest first, so a crate stack of planks by the bed is a woodshed to craft from. Shift lays as many as will go. Put planks in a store and lay three recipes from it.",
            tasks: [[Laid("any", 3)]],
            after: ["pantry_shelves"],
            rewards: [Xp("crafting", 40.0), Xp("construction", 20.0)],
        ),
        (
            name: "company_at_camp", age: "nomad", branch: "home", title: "Company at Camp",
            why: "An animal you keep, near your home, is company: you heal a tenth faster there. Tame one close to your bed or hearth, where the junglefowl or rabbits graze, so it is kept within your home's reach.",
            tasks: [[Built("home_company", 1)], [Built("home_full_house", 1)]],
            after: ["make_camp", "a_friend_in_the_wild"],
            rewards: [Xp("hunter", 60.0), Item("seed_mix", 4)],
        ),
        (
            name: "a_varied_table", age: "nomad", branch: "cooking", title: "A Varied Table",
            capstone: true,
            why: "One food grows dull and heals little. Cook six meat at a fire, cook four fish, and bake three bread: every kind comes from a different part of the land, and together they keep you going.",
            tasks: [[Cook("tag:meat", 6), Cook("tag:fish", 4), Craft("bread", 3)]],
            after: ["a_fish_supper", "daily_bread", "trail_rations"],
            rewards: [Xp("cooking", 180.0), Xp("hitpoints", 40.0)],
        ),
        (
            name: "a_proper_workshop", age: "farm", branch: "rooms", title: "A Proper Workshop",
            why: "Under a roof, beside your bench, seat and two lights, add a loom frame, spindle stand or quern and two places to store things. At home you then craft and build as if two levels higher, and engineer a level higher.",
            tasks: [[Built("home_workshop", 1)]],
            after: ["workshop_and_stove"],
            rewards: [Xp("construction", 150.0), Xp("engineering", 80.0)],
        ),
        (
            name: "a_larder", age: "farm", branch: "rooms", title: "A Larder",
            why: "Four places to store things, a stove or cauldron and a table, under a roof by the fire: meals eaten here heal a fifth more and their good lasts half again as long.",
            tasks: [[Built("home_larder", 1)]],
            after: ["a_herb_nook"],
            rewards: [Xp("cooking", 150.0), Item("bread", 4)],
        ),
        (
            name: "kitchen_garden", age: "farm", branch: "farming", title: "A Kitchen Garden",
            why: "Sow four crops within reach of your home, at any stage of growth: meals eaten at home heal a tenth more. Water carriers on the road sometimes pour their pails on a field near water.",
            tasks: [[Built("home_kitchen_garden", 1)]],
            after: ["herb_garden"],
            rewards: [Xp("farming", 120.0), Item("carrot", 4)],
        ),
        (
            name: "a_full_house", age: "farm", branch: "husbandry", title: "A Full House",
            side: true,
            why: "Keep four animals about the house: you heal a fifth faster and learn a little more at home. Junglefowl, mallards and mouflon tamed near home all count.",
            tasks: [[Built("home_full_house", 1)]],
            after: ["fresh_eggs"],
            rewards: [Xp("farming", 150.0), Xp("hunter", 80.0)],
        ),
        (
            name: "many_travellers", age: "farm", branch: "explore", title: "Many Travellers",
            why: "Every kind of traveller wants something different and gives something different: a smith whets your edges for a coin, a cartographer far from where the world began tells the way to town, a fortune teller reads what lies near, a hermit points to a wonder. Deal with five different kinds.",
            tasks: [[Met("Kinds", 5)]],
            after: ["field_guide"],
            rewards: [Xp("hunter", 100.0), Xp("crafting", 100.0), Item("bread", 4)],
        ),
        (
            name: "farmers_on_the_road", age: "farm", branch: "farming", title: "Farmers on the Road",
            side: true,
            why: "Farming folk pass by those with a home. A harvest family trades each crop for the next you can sow, a goose girl gives feathers for four wheat seeds, a cowherd fills a pail held out, and a shepherd teaches a beginner who offers food. Deal with one of them.",
            tasks: [[Met("harvest_family", 1)], [Met("goose_girl", 1)], [Met("cowherd", 1)], [Met("water_carriers", 1)], [Met("shepherd_and_flock", 1)]],
            after: ["a_compost_heap"],
            rewards: [Xp("farming", 150.0), Item("seed_mix", 6)],
        ),
        (
            name: "safe_home", age: "farm", branch: "explore", title: "Safe Home",
            why: "Some on the road need more than food. A family fled from a raid sits waiting: a meal, and one of them follows you home to stay. A prisoner marched in ropes goes free for three coins, a knife or a fight. A hurt traveller by the road is bait for raiders: win, and he thanks you.",
            tasks: [[Met("refugees", 1)], [Met("prison_convoy", 1)], [Met("wounded_traveller", 1)]],
            after: ["many_travellers"],
            rewards: [Xp("hitpoints", 150.0), Xp("defence", 100.0)],
        ),
        (
            name: "altar_rites", age: "farm", branch: "prayer", title: "Altar Rites",
            why: "Hold a bone and right-click your altar, three times: each bone is taken for Magic experience, and your prayer points fill. Then press C, open Prayers and turn Bark Skin on: blows land a little softer while your points last.",
            tasks: [[Offered("bone", 3), Prayed("bark_skin", 1)]],
            after: ["a_place_to_pray"],
            rewards: [Xp("magic", 80.0)],
        ),
        (
            name: "a_prayer_in_the_fight", age: "farm", branch: "prayer", title: "A Prayer in the Fight",
            why: "At Magic 4 Ember Arm opens: a little more melee damage while it is on. Turn it on before a fight, and Bark Skin with it (three times in all), and have ten creatures defeated. Turn them off when the fight is done: points come back only while no prayer is on.",
            tasks: [[Prayed("ember_arm", 1), Prayed("bark_skin", 3), Kill("any", 10)]],
            after: ["bones_for_the_altar"],
            rewards: [Xp("magic", 100.0), Xp("attack", 80.0)],
        ),
        (
            name: "caught_in_the_rain", age: "nomad", branch: "explore", title: "Caught in the Rain",
            why: "Rain and snow catch travellers out in the open, and they huddle where it found them. Hold up a torch to warm them and they press a coin on you; share food and they tell you of the ledge they sheltered under, with ore showing in it.",
            tasks: [[Met("drenched_travellers", 1)]],
            after: ["the_market_road"],
            rewards: [Xp("mining", 80.0)],
        ),
        (
            name: "neighbourly", age: "farm", branch: "callers", title: "Neighbourly",
            why: "Once your hearth is lit, neighbours from over the hill may call while you are near home. The first to call bring a plate for the house, crockery toward a cosy home; share a cooked meal and they leave seed for the garden.",
            tasks: [[Met("neighbours", 1)]],
            after: ["shut_the_door"],
            rewards: [Xp("construction", 100.0), Xp("cooking", 60.0)],
        ),
        (
            name: "a_lit_corner", age: "nomad", branch: "home", title: "A Lit Corner",
            why: "A seat and two lights beside your bed make a corner worth coming home to: 2° warmer there, and a night's sleep in it wakes you well rested, roof or no roof. A stool is two planks and two sticks (Construction 1); candles are twine over two hides (Crafting 3).",
            tasks: [[Built("home_bedside", 1)]],
            after: ["make_camp"],
            rewards: [Xp("construction", 40.0), Xp("crafting", 20.0)],
        ),
        (
            name: "a_herb_nook", age: "farm", branch: "rooms", title: "A Herb Nook",
            why: "Tie two herbs with twine and they hang to dry (Crafting 4); a drying rack hung with meat counts as a bunch. Two bunches and a jar, basket or crate at home make a herb nook: there you farm and brew as if a level higher, so a kitchen garden at the door takes seed a level early, and a meal's good lasts a tenth longer.",
            tasks: [[Built("home_herb_nook", 1)]],
            after: ["a_proper_workshop"],
            rewards: [Xp("farming", 80.0), Xp("crafting", 40.0)],
        ),
        // Home stations (stations.ron, docs/stations.md): a drying rack for the Nomad age
        // and a compost heap for the Farm age, loaded and left to work while you gather.
        (
            name: "hung_to_dry", age: "nomad", branch: "cooking", title: "Hung to Dry",
            why: "Meat keeps if you dry it. Lash four sticks and three twine into a drying rack (Crafting 3) and stand it under open sky. Right-click it with raw meat or fish in hand to hang up to eight; go gathering, and ten minutes later it is jerky, which heals 2 and, unlike cooked food, stacks in your pack. A fire within three blocks dries it twice as fast; a roof over it stops it. Make a rack and bring home four jerky.",
            tasks: [[Craft("drying_rack", 1), Have("jerky", 4)]],
            after: ["meat_and_fire"],
            rewards: [Xp("cooking", 80.0), Xp("crafting", 20.0)],
        ),
        (
            name: "trail_rations", age: "nomad", branch: "cooking", title: "Trail Rations",
            why: "A pack of jerky carries you far from the fire: it never spoils and twelve fit in one slot. Stand a second rack by your campfire, keep both hung while you work, and gather eight jerky for a long trip. A hung rack is homely too: it counts as a bunch of herbs drying for a herb nook.",
            tasks: [[Craft("drying_rack", 2), Have("jerky", 8)]],
            after: ["hung_to_dry"],
            rewards: [Xp("cooking", 150.0)],
        ),
        (
            name: "a_compost_heap", age: "farm", branch: "farming", title: "A Compost Heap",
            why: "Nothing from the field need go to waste. Nail planks into an open box (Construction 5) for a compost heap. Right-click it with greens in hand (wheat, seed, carrots, fruit or burnt food) to fork them in by fours, up to sixteen (Farming 5); fifteen minutes later each four have rotted to one compost, and half as fast again with water within two blocks. Make a heap by your field. Spread compost on a growing crop (right-click with it in hand) and that crop and the ones beside it grow a stage at once; a bone crushed over a crop grows that one alone. A ripe crop takes nothing, so the compost stays in hand. Grow six crops with compost and one with a bone, then let them ripen.",
            tasks: [[Craft("compost_heap", 1), Fertilised("compost", 6), Fertilised("bone", 1)]],
            after: ["roots_in_the_embers"],
            rewards: [Xp("farming", 350.0), Xp("construction", 40.0), Item("compost", 4)],
        ),
        // Bees (bees.ron, docs/bees.md): a swarm from a wild nest, a bee garden at home, and
        // the beekeeper with wax candles. The hive fills over a few days' foraging, so the
        // second names quests to do by it meanwhile.
        (
            name: "humming_in_the_meadow", age: "farm", branch: "farming", title: "Humming in the Meadow",
            side: true,
            why: "Wild bees nest in hollows at the foot of broadleaf, fruit and blossom trees in a Flower Meadow, a Cherry Grove or Lavender Fields: listen for the hum and look for bees about the roots. Coil a skep from seven wheat and three twine (Crafting 6), light a campfire within four blocks of the nest so the smoke calms them (or hold a torch a moment: its smoke clings to you for half a minute), then hold the skep up to it and right-click (Farming 12): the bees move in, and you carry home a skep of bees. Without smoke they only sting.",
            tasks: [[Level("farming", 12), Craft("skep", 1), Have("bee_skep", 1)]],
            after: ["herb_garden"],
            rewards: [Xp("farming", 300.0), Xp("crafting", 60.0)],
        ),
        (
            name: "smoke_that_clings", age: "farm", branch: "farming", title: "Smoke That Clings",
            side: true,
            why: "Smoke clings. Hold a torch a moment, or stand within two blocks of a fire, and you are Smoky for thirty seconds after: bees take you for a fire and stay calm. Smoky, you can take a swarm with no campfire by the nest, take honey from a full skep unstung, and shoot by a nest without stirring it. Get Smoky and carry four honey.",
            tasks: [[Felt("smoky"), Have("honey", 4)]],
            after: ["sweet_relief"],
            rewards: [Xp("farming", 120.0)],
        ),
        (
            name: "a_bee_garden", age: "farm", branch: "rooms", title: "A Bee Garden",
            side: true,
            why: "Set your skep of bees down at home with three flowers near: a bee garden, where you heal a tenth faster and crops within eight blocks of the hive grow a quarter faster. The bees forage by day in dry weather, quicker with more flowers about (a honeydew lily counts for four), and a full skep drips honey. A fire right beside it drives them off; one within four blocks smokes them calm. Right-click a full skep for two or three honey, and half the time a cake of beeswax. While it fills, sow a Kitchen Garden by the hive or plant a Herb Garden.",
            tasks: [[Built("home_bee_garden", 1), Have("honey", 3)]],
            after: ["humming_in_the_meadow"],
            rewards: [Xp("farming", 250.0)],
        ),
        (
            name: "sweet_relief", age: "farm", branch: "cooking", title: "Sweet Relief",
            side: true,
            why: "Honey heals 2, as fruit does, and unlike cooked food it stacks, so a pouch of it goes a long way. The same food heals a little less each time you eat it in a row, and a minute of other things brings it back: eat honey between other meals. Eat three honey and keep three more.",
            tasks: [[Ate("honey", 3), Have("honey", 3)]],
            after: ["a_bee_garden"],
            rewards: [Xp("cooking", 80.0), Xp("farming", 60.0)],
        ),
        (
            name: "the_beekeeper_calls", age: "farm", branch: "callers", title: "The Beekeeper Calls",
            side: true,
            why: "A home with bees draws the beekeeper by day, to look over your skeps and walk your garden with you; three honey buys a spare skep for a second hive. Beeswax makes the best light a Farm home has before coal: a wick of twine over a cake of wax gives three candles. Meet the beekeeper and make three candles, or, with no visit yet, keep two cakes of wax and make six.",
            tasks: [[Met("beekeeper", 1), Craft("candle", 3)], [Have("beeswax", 2), Craft("candle", 6)]],
            after: ["smoke_that_clings"],
            rewards: [Xp("farming", 200.0), Xp("crafting", 60.0), Item("skep", 1)],
        ),
        (
            name: "callers_at_the_door", age: "farm", branch: "callers", title: "Callers at the Door",
            why: "A homely home draws callers. With seats, a table and stores under your roof, guests may come of an evening to sit by your fire while you are home: talk with them, share a cooked supper. Make it cosy and, by night, something smaller may come to the door for the crumbs.",
            tasks: [[Met("fireside_guests", 1)]],
            after: ["a_homely_home"],
            rewards: [Xp("construction", 120.0), Xp("cooking", 60.0)],
        ),
        (
            name: "the_rain_dance", age: "farm", branch: "explore", title: "The Rain Dance",
            why: "In a dry spell, rainmakers dance on grassland, savanna and scrub. Stand and watch the dance through and go off refreshed, or pay them two coins and the rain comes for ten minutes: the glimmer koi rises only in rain.",
            tasks: [[Met("rainmakers", 1)]],
            after: ["safe_home"],
            rewards: [Xp("fishing", 100.0), Xp("farming", 60.0)],
        ),
        (
            name: "filled_again", age: "farm", branch: "prayer", title: "Filled Again",
            why: "A priest bearing a little shrine walks the roads with pilgrims. Spend some prayer first: one short of it is filled again, once. A beginner at Magic is shown the first prayer.",
            tasks: [[Met("shrine_bearer", 1)]],
            after: ["a_prayer_in_the_fight"],
            rewards: [Xp("magic", 80.0)],
        ),
        (
            name: "a_share_of_the_hunt", age: "farm", branch: "hunter", title: "A Share of the Hunt",
            why: "Hunting parties chase boar and deer by day, a trapper takes rabbits, hares and pheasant, and by night wolf hunters come after the wolves near homes. Strike their quarry first, before they bring it down, and they give you a share.",
            tasks: [[Met("hunting_party", 1)], [Met("trapper", 1)], [Met("wolf_hunters", 1)]],
            after: ["bigger_game"],
            rewards: [Xp("hunter", 120.0)],
        ),
        (
            name: "fired_whole", age: "farm", branch: "pottery", title: "Fired Whole",
            capstone: true,
            why: "A potter and an apprentice dig clay at river banks and wet ground near folk's homes. Hand them clay and it comes back fired in their kiln, none cracked, one kept, up to eight; a beginner who shows a fired piece learns to throw a pot. Have clay fired by them, and fire twenty-four clay in all. The reward is a dozen clay for the next kiln load.",
            tasks: [[Met("clay_diggers", 1), Cook("fired_clay", 24)]],
            after: ["a_kiln_load", "clay_banks", "earthenware", "an_earth_clamp"],
            rewards: [Xp("crafting", 150.0), Item("clay", 12)],
        ),
        (
            name: "coal_by_road", age: "nomad", branch: "explore", title: "Coal by Road",
            capstone: true,
            why: "Coal carters walk sacks of coal to the nearest town, and miners caught by the dark far from home sit waiting for a light. Keep with the carters to the town, or give the miners a lump of coal or charcoal to light their lamp again; both say where coal shows at the surface. Then make sixteen torches: coal or charcoal over a stick makes four.",
            tasks: [[Met("coal_carters", 1), Craft("torch", 16)], [Met("benighted_miners", 1), Craft("torch", 16)]],
            after: ["caught_in_the_rain"],
            rewards: [Xp("mining", 80.0), Item("coal_ore", 4)],
        ),
        (
            name: "the_last_sheaf", age: "farm", branch: "farming", title: "The Last Sheaf",
            side: true,
            why: "At harvest, villagers carry the last sheaf round the fields near folk's homes, singing. Put three of your wheat on their dolly while crops grow within 32 blocks, and the crops about them grow on a stage; a beginner learns the sowing song. Meet them, and bring in twelve wheat. The reward is seed for a bigger field.",
            tasks: [[Met("harvest_home", 1), Pick("wheat_crop", 12)]],
            after: ["farmers_on_the_road"],
            rewards: [Xp("farming", 150.0), Item("rye", 4)],
        ),
        (
            name: "mice_in_the_stores", age: "farm", branch: "rooms", title: "Mice in the Stores",
            capstone: true,
            why: "At dusk a piper may come by homes, the field mice of folk's stores at his heels. Follow him to the end of his tune and he leaves the seed they would have eaten. Keep a pantry by your fire as well, two crates or baskets beside it, so your stores are worth the guarding.",
            tasks: [[Met("rat_catcher", 1), Built("home_pantry", 1)], [Met("rat_catcher", 1), Built("home_larder", 1)]],
            after: ["a_larder"],
            rewards: [Xp("farming", 100.0), Item("seed_mix", 4), Item("earthen_jar", 3)],
        ),
        (
            name: "the_keepers_word", age: "farm", branch: "hunter", title: "The Keepers' Word",
            capstone: true,
            why: "A poacher stalks deer in the woods at dusk: be there when he takes one and he cuts you a share, or face him with a weapon in hand (Attack 10) and he leaves. Gamekeepers follow on his trail and say which way he went, and on a later day, once you can fight, his gang may lie in wait for you. Deal with all three.",
            tasks: [[Met("poacher", 1), Met("gamekeepers", 1), Met("poachers_gang", 1)]],
            after: ["a_share_of_the_hunt"],
            rewards: [Xp("hunter", 200.0), Xp("attack", 100.0), Item("snare", 4)],
        ),
        (
            name: "catch_up_the_shrine", age: "farm", branch: "prayer", title: "Catch Up the Shrine",
            capstone: true,
            why: "Pilgrims who fell behind the shrine bearer walk the roads after it, asking which way it went. They point you after it too, and a loaf from you buys their prayers. Meet the shrine bearer and the stragglers both.",
            tasks: [[Met("shrine_bearer", 1), Met("stragglers", 1)]],
            after: ["filled_again"],
            rewards: [Xp("magic", 120.0), Item("bone", 12)],
        ),
        (
            name: "wedding_to_christening", age: "farm", branch: "explore", title: "From Wedding to Christening",
            capstone: true,
            why: "A wedding party walks the open country behind a priest: a flower for the bride, and they share bread and good cheer. Some days later the same folk may pass again with a child to be christened. Bring a loaf for the feast, and the priest's blessing restores your prayer. Meet both.",
            tasks: [[Met("wedding", 1), Met("christening", 1)]],
            after: ["the_rain_dance"],
            rewards: [Xp("magic", 60.0), Xp("cooking", 60.0), Item("gold_coin", 8)],
        ),
        (
            name: "those_taken_in", age: "farm", branch: "callers", title: "Those Taken In",
            capstone: true,
            why: "Refugees roam near homes, hungry. Food in your hand and they follow you home, where they thank you with seed. Days later their kin come looking for them and camp near your home to thank you too. Take them in, then meet their kin.",
            tasks: [[Met("refugees", 1), Met("refugee_kin", 1)]],
            after: ["neighbourly", "callers_at_the_door"],
            rewards: [Xp("farming", 100.0), Xp("construction", 100.0), Item("gold_coin", 6)],
        ),
        (
            name: "first_metal", age: "farm", branch: "mining", title: "First Metal",
            side: true,
            why: "A smith and a helper may camp in the woods with a bloomery; a beginner at Engineering learns to work the bellows there, and hands them two copper ore to see them smelt it. Deal with them, and mine four copper ore of your own for your kiln's crucible.",
            tasks: [[Met("bloomery_smelters", 1), Mine("copper_ore", 4)]],
            after: ["crucible_kiln"],
            rewards: [Xp("engineering", 120.0), Item("bread", 2)],
        ),
        (
            name: "a_hen_of_your_own", age: "farm", branch: "husbandry", title: "A Hen of Your Own",
            side: true,
            why: "A henwife drifts over the grassland with her hens. Once you have a home and Farming 3, six wheat seeds buy a hen she hands to you; four feathers buy two eggs. Keep the hen near your home, as company there.",
            tasks: [[Met("henwife", 1), Built("home_company", 1)], [Met("henwife", 1), Built("home_full_house", 1)]],
            after: ["the_last_sheaf"],
            rewards: [Xp("farming", 100.0), Item("seed_mix", 4)],
        ),
        (
            name: "master_and_journeyman", age: "farm", branch: "crafting", title: "Master and Journeyman",
            capstone: true,
            why: "A child may tag along behind you for a while, watching you work. Once you are good at something (Farming, Mining or Crafting 15), they ask to learn it and pay a coin for the lesson. Days later they pass again as a journeyman, with a gift for their old teacher. Teach them, then meet the journeyman.",
            tasks: [[Met("apprentice", 1), Met("journeyman", 1)]],
            after: ["fired_whole"],
            rewards: [Xp("crafting", 150.0), Xp("mining", 100.0), Item("torch", 8)],
        ),
        (
            name: "the_market_road", age: "nomad", branch: "explore", title: "The Market Road",
            why: "Market folk walk the roads to the nearest town: a trader and farmers, sometimes a hound. Keep with them the whole way and at the town they share their bread; on the road, eight wheat sell for a coin. Either way is a dealing. Where market folk walk the road to town, highwaymen may come a little after and lie in wait for travellers who can fight. Meet the market folk, and when the highwaymen spring their ambush, win: they give up a purse.",
            tasks: [[Met("market_folk", 1), Met("highwaymen", 1)]],
            after: ["something_for_something"],
            rewards: [Xp("defence", 120.0), Xp("attack", 60.0), Xp("farming", 80.0)],
        ),
        (
            name: "found_and_thanked", age: "nomad", branch: "explore", title: "Found and Thanked",
            why: "A child lost far from home wanders one spot. Food in your hand and they follow you to the nearest settlement. Days later the parents come looking for you near your home, with coins and bread for your trouble. Bring the child home, then meet the parents.",
            tasks: [[Met("lost_child", 1), Met("grateful_parents", 1)]],
            after: ["a_kind_turn"],
            rewards: [Xp("hitpoints", 100.0)],
        ),
    ],
    // A new player's book opens with these pinned (a book with nothing done or pinned), so
    // the first thing on screen is what to do.
    tracker: (start_pins: ["timber", "look_it_up", "first_night"]),
)
