// Recorded sounds the game plays for events: paths within this package. Field recordings
// from Freesound, all CC0; who made each is in THIRD_PARTY_NOTICES.md. The jingles at the
// end are our own. Rain and running water are ambience beds (ambience.ron).
(
    // Thunder by how far off the lightning struck: close strikes that crack and roll, the
    // same heard from farther off (muffled), and far rolls.
    thunder: (
        near: ["sounds/thunder_near_1.mp3", "sounds/thunder_near_2.mp3"],
        middle: ["sounds/thunder_middle_1.mp3", "sounds/thunder_middle_2.mp3"],
        far: ["sounds/thunder_far_1.mp3", "sounds/thunder_far_2.mp3", "sounds/thunder_far_3.mp3"],
    ),
    // Strokes while swimming.
    swim: ["sounds/swim_2.mp3", "sounds/swim_3.mp3", "sounds/swim_4.mp3", "sounds/swim_6.mp3"],
    // Jumping or falling into water.
    splash: ["sounds/splash_1.mp3", "sounds/splash_2.mp3", "sounds/splash_3.mp3"],
    // Jingles for events, our own (tools/generate_jingles.py). A package that lists any for
    // an event replaces these; several listed take turns.
    // A quest finished: a short brass call landing home (IV - V - I), held under a harp.
    quest_done: ["sounds/quest_done_1.ogg"],
    // A finished quest's rewards claimed: coins into the purse and a glint.
    quest_claim: ["sounds/quest_claim_1.ogg", "sounds/quest_claim_2.ogg", "sounds/quest_claim_3.ogg"],
    // A skill's level reached: a quick trumpet run up to a bright held chord.
    level_up: ["sounds/level_up_1.ogg"],
    // A milestone level (every tenth, as celebrations.ron says): the grander one, instead.
    level_milestone: ["sounds/level_milestone_1.ogg"],
    // A path's last quest finished (its capstone, `capstone: true`): a horn call answered by
    // the trumpet, closing on a slow, warm amen. None listed, it rings as a quest.
    capstone_done: ["sounds/capstone_done_1.ogg"],
    // Our own (tools/generate_sfx.py), made at the loudness the game expects of them.
    // An item picked up off the ground: a soft pop, when the player's Minecraft sounds are
    // off.
    pickup: ["sounds/pickup_1.ogg", "sounds/pickup_2.ogg", "sounds/pickup_3.ogg", "sounds/pickup_4.ogg"],
    // Fire in the thatch (fire.ron): a block catching, a soft whoomph from it as the server
    // sets it burning. Our own (tools/generate_sfx.py). The smoulder before and the burning
    // after are ambience (ambience.ron's `smoulder` and `blaze`). While fire.ron can set a
    // block burning there must be one, or the game does not start.
    fire: (catch: ["sounds/fire_catch_1.ogg", "sounds/fire_catch_2.ogg"], volume: 0.9),
    // What building materials sound like: a step on one, a piece set down, a piece broken.
    // Every block carrying all of a material's tags sounds as it (of several, the one with
    // the most tags); mining taps and landings use the steps. A cue a material lists nothing
    // for is the block's family's (its `sound`). A block whose def names a `material`
    // sounds as that one whatever its tags (cut cobblestone keeps the rough stone's sound),
    // and the name must be one listed here. A package that names a material replaces it;
    // each must be some block's, or the game does not start.
    materials: [
        // Rough stone on stone: gritty taps, a heavy knock set down, stones tumbling loose.
        (
            name: "cobblestone", tags: ["stone", "cobbled"],
            step: ["sounds/materials/cobble_step_1.ogg", "sounds/materials/cobble_step_2.ogg", "sounds/materials/cobble_step_3.ogg", "sounds/materials/cobble_step_4.ogg"],
            place: ["sounds/materials/cobble_place_1.ogg", "sounds/materials/cobble_place_2.ogg", "sounds/materials/cobble_place_3.ogg"],
            break: ["sounds/materials/cobble_break_1.ogg", "sounds/materials/cobble_break_2.ogg", "sounds/materials/cobble_break_3.ogg"],
        ),
        // Dressed stone: a cleaner tap, a brick set with a scrape of mortar, a sharp split.
        (
            name: "stone_brick", tags: ["stone", "bricks"],
            step: ["sounds/materials/brick_step_1.ogg", "sounds/materials/brick_step_2.ogg", "sounds/materials/brick_step_3.ogg", "sounds/materials/brick_step_4.ogg"],
            place: ["sounds/materials/brick_place_1.ogg", "sounds/materials/brick_place_2.ogg", "sounds/materials/brick_place_3.ogg"],
            break: ["sounds/materials/brick_break_1.ogg", "sounds/materials/brick_break_2.ogg", "sounds/materials/brick_break_3.ogg"],
        ),
        // Posts, beams and lattice: a hollow knock underfoot, a firm knock set in place, splintering.
        (
            name: "timber", tags: ["timber"],
            step: ["sounds/materials/timber_step_1.ogg", "sounds/materials/timber_step_2.ogg", "sounds/materials/timber_step_3.ogg", "sounds/materials/timber_step_4.ogg"],
            place: ["sounds/materials/timber_place_1.ogg", "sounds/materials/timber_place_2.ogg", "sounds/materials/timber_place_3.ogg"],
            break: ["sounds/materials/timber_break_1.ogg", "sounds/materials/timber_break_2.ogg", "sounds/materials/timber_break_3.ogg"],
        ),
        // Thatch: a dry crush of straw, a soft rustle laid down, stalks pattering as it comes apart.
        (
            name: "thatch", tags: ["thatch"],
            step: ["sounds/materials/thatch_step_1.ogg", "sounds/materials/thatch_step_2.ogg", "sounds/materials/thatch_step_3.ogg", "sounds/materials/thatch_step_4.ogg"],
            place: ["sounds/materials/thatch_place_1.ogg", "sounds/materials/thatch_place_2.ogg", "sounds/materials/thatch_place_3.ogg"],
            break: ["sounds/materials/thatch_break_1.ogg", "sounds/materials/thatch_break_2.ogg", "sounds/materials/thatch_break_3.ogg"],
        ),
        // Shingles: tiles knocking underfoot, a slide and a clack laid, a clatter prised off.
        (
            name: "shingle", tags: ["shingle"],
            step: ["sounds/materials/shingle_step_1.ogg", "sounds/materials/shingle_step_2.ogg", "sounds/materials/shingle_step_3.ogg", "sounds/materials/shingle_step_4.ogg"],
            place: ["sounds/materials/shingle_place_1.ogg", "sounds/materials/shingle_place_2.ogg", "sounds/materials/shingle_place_3.ogg"],
            break: ["sounds/materials/shingle_break_1.ogg", "sounds/materials/shingle_break_2.ogg", "sounds/materials/shingle_break_3.ogg"],
        ),
        // Wattle: woven withies creaking underfoot, a springy rattle set in, twigs snapping.
        (
            name: "wattle", tags: ["wattle"],
            step: ["sounds/materials/wattle_step_1.ogg", "sounds/materials/wattle_step_2.ogg", "sounds/materials/wattle_step_3.ogg", "sounds/materials/wattle_step_4.ogg"],
            place: ["sounds/materials/wattle_place_1.ogg", "sounds/materials/wattle_place_2.ogg", "sounds/materials/wattle_place_3.ogg"],
            break: ["sounds/materials/wattle_break_1.ogg", "sounds/materials/wattle_break_2.ogg", "sounds/materials/wattle_break_3.ogg"],
        ),
        // Daub: a dull pat of dried mud, a wet slap set on, crumbling clods.
        (
            name: "daub", tags: ["daub"],
            step: ["sounds/materials/daub_step_1.ogg", "sounds/materials/daub_step_2.ogg", "sounds/materials/daub_step_3.ogg", "sounds/materials/daub_step_4.ogg"],
            place: ["sounds/materials/daub_place_1.ogg", "sounds/materials/daub_place_2.ogg", "sounds/materials/daub_place_3.ogg"],
            break: ["sounds/materials/daub_break_1.ogg", "sounds/materials/daub_break_2.ogg", "sounds/materials/daub_break_3.ogg"],
        ),
        // Hide: a taut, drum-like give, a flap laid over poles, leather tearing loose.
        (
            name: "hide", tags: ["hide"],
            step: ["sounds/materials/hide_step_1.ogg", "sounds/materials/hide_step_2.ogg", "sounds/materials/hide_step_3.ogg", "sounds/materials/hide_step_4.ogg"],
            place: ["sounds/materials/hide_place_1.ogg", "sounds/materials/hide_place_2.ogg", "sounds/materials/hide_place_3.ogg"],
            break: ["sounds/materials/hide_break_1.ogg", "sounds/materials/hide_break_2.ogg", "sounds/materials/hide_break_3.ogg"],
        ),
        // Fired clay: a ringing clink, a pot set down with a knock, shards shattering.
        (
            name: "terracotta", tags: ["terracotta"],
            step: ["sounds/materials/terracotta_step_1.ogg", "sounds/materials/terracotta_step_2.ogg", "sounds/materials/terracotta_step_3.ogg", "sounds/materials/terracotta_step_4.ogg"],
            place: ["sounds/materials/terracotta_place_1.ogg", "sounds/materials/terracotta_place_2.ogg", "sounds/materials/terracotta_place_3.ogg"],
            break: ["sounds/materials/terracotta_break_1.ogg", "sounds/materials/terracotta_break_2.ogg", "sounds/materials/terracotta_break_3.ogg"],
        ),
        // On rockers (a rocking chair, a cradle): set down, it rocks to rest with a creak and
        // a tap each way. Steps and breaks are timber's.
        (
            name: "rocking_chair", tags: ["rocking_chair"],
            step: ["sounds/materials/timber_step_1.ogg", "sounds/materials/timber_step_2.ogg", "sounds/materials/timber_step_3.ogg", "sounds/materials/timber_step_4.ogg"],
            place: ["sounds/materials/rocker_place_1.ogg", "sounds/materials/rocker_place_2.ogg", "sounds/materials/rocker_place_3.ogg"],
            break: ["sounds/materials/timber_break_1.ogg", "sounds/materials/timber_break_2.ogg", "sounds/materials/timber_break_3.ogg"],
        ),
        (
            name: "cradle", tags: ["cradle"],
            step: ["sounds/materials/timber_step_1.ogg", "sounds/materials/timber_step_2.ogg", "sounds/materials/timber_step_3.ogg", "sounds/materials/timber_step_4.ogg"],
            place: ["sounds/materials/rocker_place_1.ogg", "sounds/materials/rocker_place_2.ogg", "sounds/materials/rocker_place_3.ogg"],
            break: ["sounds/materials/timber_break_1.ogg", "sounds/materials/timber_break_2.ogg", "sounds/materials/timber_break_3.ogg"],
        ),
    ],
    // A tool in hand nearly worn out (tools.ron's `wear.warn`): a dry creak and a tick as the
    // head shifts. Worn out: the haft snaps and its pieces fall.
    tool_worn: ["sounds/tool_worn_1.ogg", "sounds/tool_worn_2.ogg"],
    tool_break: ["sounds/tool_break_1.ogg", "sounds/tool_break_2.ogg"],
    // What the player does, heard as they do it, by action: about as loud as placing a
    // block, times `volume`. A package that names an action replaces its sound. Every
    // action says how it sounds, or the game does not start: its `sounds`, `silent: true`,
    // or `heard` elsewhere (Block, Interface or Combat). `brings`: what its result sounds
    // like as it lands in the pack, by the first `tags` the item all has (only what the
    // action brings, never anything else picked up meanwhile).
    // `ways` are the ways of doing an action that sound their own: the first done `with`
    // any of its items or blocks (by name, or `tag:TAG`) is heard instead of the action's
    // `sounds`. Crafting is done with the grid's items; lighting, loading a station and
    // cooking with the block worked, never what is in hand. Each is checked at launch:
    // named, and done with things the content has. Our own (tools/generate_sfx.py, under
    // sounds/work/). Every clip in this file is checked at launch to be there.
    actions: {
        // Three bites and their chews.
        "core:eat": (sounds: ["sounds/eat_1.ogg", "sounds/eat_2.ogg", "sounds/eat_3.ogg"], volume: 0.8),
        // A scrape and two knocks: parts fitted together at the grid.
        "core:craft": (
            sounds: ["sounds/craft_1.ogg", "sounds/craft_2.ogg", "sounds/craft_3.ogg"], volume: 0.8,
            // By what it is made of, the hardest first: a stone axe is knocked out of
            // cobble, then bound, and heard as the stone.
            ways: [
                // Flint knapped: sharp, glassy cracks and flakes ticking away.
                (name: "knap", with: ["flint"], sounds: ["sounds/work/knap_1.ogg", "sounds/work/knap_2.ogg", "sounds/work/knap_3.ogg"]),
                // A hide or fur scraped: long rasping strokes of a stone edge.
                (name: "scrape_hide", with: ["hide", "tag:fur"], sounds: ["sounds/work/scrape_hide_1.ogg", "sounds/work/scrape_hide_2.ogg"], volume: 0.8),
                // Clay shaped by hand: wet slaps and a squelch.
                (name: "shape_clay", with: ["clay"], sounds: ["sounds/work/shape_clay_1.ogg", "sounds/work/shape_clay_2.ogg"], volume: 1.1),
                // Fired clay and kiln bricks knocked together: pottery clinks.
                (name: "clink", with: ["fired_clay", "kiln_bricks", "clay_pot"], sounds: ["sounds/work/clink_1.ogg", "sounds/work/clink_2.ogg"], volume: 1.1),
                // Stone dressed: a hammerstone pecking, grit falling.
                (name: "dress_stone", with: ["tag:cobbled", "stone", "stone_bricks"], sounds: ["sounds/work/dress_stone_1.ogg", "sounds/work/dress_stone_2.ogg", "sounds/work/dress_stone_3.ogg"], volume: 1.1),
                // Stalks and fibre twisted into cord, or wool worked: a winding creak.
                (name: "twist", with: ["wheat", "twine", "wool"], sounds: ["sounds/work/twist_1.ogg", "sounds/work/twist_2.ogg"], volume: 0.8),
                // Wood whittled: knife strokes peeling shavings, a knock of the stick.
                (name: "whittle", with: ["stick", "tag:log", "tag:planks"], sounds: ["sounds/work/whittle_1.ogg", "sounds/work/whittle_2.ogg", "sounds/work/whittle_3.ogg"], volume: 0.8),
            ],
        ),
        // Loading or emptying a home station (a drying rack, a compost heap): parts handled.
        // Loaded, at its empty block, each sounds of its own work instead.
        "base:use_station": (
            sounds: ["sounds/craft_1.ogg", "sounds/craft_2.ogg", "sounds/craft_3.ogg"], volume: 0.6,
            ways: [
                // Meat hung on the rack: a wet slap on the rail, the poles creaking.
                (name: "hang", with: ["drying_rack"], sounds: ["sounds/work/hang_1.ogg", "sounds/work/hang_2.ogg"], volume: 0.7),
                // Food tipped into the pot: a plop, a swirl of the ladle, a knock on the rim.
                (name: "stir", with: ["cooking_pot"], sounds: ["sounds/work/stir_1.ogg", "sounds/work/stir_2.ogg"], volume: 0.7),
                // Greens forked onto the heap: a wet flump and a damp rustle.
                (name: "heap", with: ["compost_heap"], sounds: ["sounds/work/heap_1.ogg", "sounds/work/heap_2.ogg"], volume: 0.7),
                // Clay or cobble loaded into a pit kiln: a knock into the embers and a breath of
                // flame.
                (name: "fire_in_kiln", with: ["pit_kiln"], sounds: ["sounds/work/kiln_load_1.ogg", "sounds/work/kiln_load_2.ogg"], volume: 0.9),
            ],
        ),
        // Taking a catch from a sprung trap (traps.ron): a pouch drawn open and shut.
        "base:take_from_trap": (sounds: ["sounds/pouch_1.ogg", "sounds/pouch_2.ogg"], volume: 0.6),
        // Flint struck, sparks, and the tinder catching: a fire or a kiln lit.
        "base:light": (
            sounds: ["sounds/light_1.ogg", "sounds/light_2.ogg"],
            // A hearth or kiln catching: a strike, a whoomph, and the fire swelling into a
            // roar that settles into its bed (ambience.ron's fire); a kiln's deeper.
            ways: [
                (name: "kindle_hearth", with: ["hearthstone", "kindling"], sounds: ["sounds/work/kindle_hearth_1.ogg", "sounds/work/kindle_hearth_2.ogg"]),
                (name: "kindle_kiln", with: ["crucible"], sounds: ["sounds/work/kindle_kiln_1.ogg", "sounds/work/kindle_kiln_2.ogg"]),
            ],
        ),
        "base:relight": (sounds: ["sounds/light_1.ogg", "sounds/light_2.ogg"]),
        // A lid lifted: a short creak and the lid knocking back.
        "base:open_store": (
            sounds: ["sounds/store_open_1.ogg", "sounds/store_open_2.ogg"], volume: 0.8,
            // By what is opened, the block worked.
            ways: [
                // A barrel's lid prised up: a scrape and the cask's hollow boom.
                (name: "barrel", with: ["tag:barrel"], sounds: ["sounds/store_barrel_1.ogg", "sounds/store_barrel_2.ogg"], volume: 0.8),
                // A cupboard or wardrobe: a little latch and a quick creak.
                (name: "cupboard", with: ["tag:cupboard"], sounds: ["sounds/store_cupboard_1.ogg", "sounds/store_cupboard_2.ogg"], volume: 1.1),
                // A jar's clay lid lifted off and set down with a clink.
                (name: "jar", with: ["tag:jar"], sounds: ["sounds/store_jar_1.ogg", "sounds/store_jar_2.ogg"], volume: 0.7),
                // A basket: wicker creaking and a rustle inside.
                (name: "basket", with: ["tag:basket"], sounds: ["sounds/store_basket_1.ogg", "sounds/store_basket_2.ogg"], volume: 0.7),
            ],
        ),
        // Putting the pack away at home: the same lid, softer.
        "base:put_away": (sounds: ["sounds/store_open_1.ogg", "sounds/store_open_2.ogg"], volume: 0.6),
        // The latch, then a slow creak on the hinges; quieter than the rest at its loudest, so
        // played louder.
        "base:open": (
            sounds: ["sounds/door_1.ogg", "sounds/door_2.ogg"], volume: 1.3,
            // By what is swung, the block worked.
            ways: [
                // A field gate: the latch bar's clack, a dry creak, a knock on the post.
                (name: "gate", with: ["tag:gate"], sounds: ["sounds/gate_1.ogg", "sounds/gate_2.ogg"], volume: 0.9),
                // Two light leaves swinging, each knocking home.
                (name: "shutters", with: ["tag:shutters"], sounds: ["sounds/shutters_1.ogg", "sounds/shutters_2.ogg"], volume: 0.8),
                // A loft hatch: a heavy board creaking, dropping with a thump.
                (name: "hatch", with: ["tag:hatch"], sounds: ["sounds/hatch_1.ogg", "sounds/hatch_2.ogg"], volume: 0.9),
                // A curtain drawn: a cloth swish and its rings ticking along the pole.
                (name: "curtain", with: ["tag:curtain"], sounds: ["sounds/curtain_1.ogg", "sounds/curtain_2.ogg"], volume: 0.6),
                // A door pushed shut (one standing open): a short creak, the thud of it meeting
                // the frame, and the latch dropping.
                (name: "shut", with: ["tag:door_open"], sounds: ["sounds/shut_1.ogg", "sounds/shut_2.ogg"], volume: 1.0),
            ],
        ),
        // A hiss settling into a sizzle as food meets the fire.
        // Food on the fire, and as it comes off: done, with a tap on a board, or burnt, with a
        // dark hiss and a puff of smoke, so a burn is heard as it happens.
        "base:cook": (
            sounds: ["sounds/cook_1.ogg", "sounds/cook_2.ogg"], volume: 0.9,
            brings: [
                (tags: ["burnt"], sounds: ["sounds/burnt_1.ogg", "sounds/burnt_2.ogg"], volume: 0.8),
                (tags: ["cooked"], sounds: ["sounds/cooked_1.ogg", "sounds/cooked_2.ogg"], volume: 0.7),
                // What the Farm age's hand stations give, as it comes off them: flour gathered
                // up in a dusty sift, twine wound off with a snap, cloth folded off the loom (a
                // bolt: cloth made up into a rug or a banner is not the loom's).
                (tags: ["flour"], sounds: ["sounds/work/flour_1.ogg", "sounds/work/flour_2.ogg"], volume: 0.9),
                (tags: ["twine"], sounds: ["sounds/work/twine_1.ogg", "sounds/work/twine_2.ogg"], volume: 1.2),
                (tags: ["bolt"], sounds: ["sounds/work/cloth_1.ogg", "sounds/work/cloth_2.ogg"], volume: 0.6),
                // What the fire and the kilns give back: a loaf knocked hollow, fired clay
                // ringing sound, an ingot clinking from the mould with a hiss, charcoal raked
                // out in brittle clinks. (Clay cracked in the fire comes back as plain clay,
                // and kilned stone as stone: told by no tag that dug clay or rock lacks, so
                // they keep the cook's own sound.)
                (tags: ["baked"], sounds: ["sounds/baked_1.ogg", "sounds/baked_2.ogg"], volume: 0.8),
                (tags: ["fired_clay"], sounds: ["sounds/work/fired_1.ogg", "sounds/work/fired_2.ogg"], volume: 0.8),
                (tags: ["ingot"], sounds: ["sounds/work/ingot_1.ogg", "sounds/work/ingot_2.ogg"], volume: 0.8),
                (tags: ["charcoal"], sounds: ["sounds/work/charcoal_1.ogg", "sounds/work/charcoal_2.ogg"], volume: 0.8),
            ],
            ways: [
                // Ore tipped into the hot crucible: a rattle on clay and a deep hiss.
                (name: "smelt", with: ["tag:crucible"], sounds: ["sounds/work/smelt_1.ogg", "sounds/work/smelt_2.ogg"], volume: 0.9),
                // The Farm age's hand stations, through their work: a quern's
                // stone rumbling round on grain, a spindle whirring, a loom's shuttle swishing
                // and its beater clacking the weft home.
                (name: "grind", with: ["tag:quern"], sounds: ["sounds/work/grind_1.ogg", "sounds/work/grind_2.ogg"], volume: 0.8),
                (name: "spin", with: ["tag:spindle"], sounds: ["sounds/work/spin_1.ogg", "sounds/work/spin_2.ogg"], volume: 0.7),
                (name: "weave", with: ["tag:loom"], sounds: ["sounds/work/weave_1.ogg", "sounds/work/weave_2.ogg"], volume: 0.8),
            ],
        ),
        // Lying down: rustles of cloth and straw (a sleeping bag on the ground).
        "base:sleep": (
            sounds: ["sounds/sleep_1.ogg"], volume: 0.7,
            // A bed of wood: its frame creaks as it takes the weight.
            ways: [(name: "bed_frame", with: ["tag:furniture"], sounds: ["sounds/bed_frame_1.ogg", "sounds/bed_frame_2.ogg"], volume: 0.7)],
        ),
        // Settling onto a seat: the same rustle, softer (a cushion).
        "base:sit": (
            sounds: ["sounds/sleep_1.ogg"], volume: 0.6,
            // A stool, chair, bench or settle: a knock of its legs and a creak.
            ways: [
                // A cushioned seat (a window seat): the rustle, as a cushion.
                (name: "cushioned_seat", with: ["tag:cushioned"], sounds: ["sounds/sleep_1.ogg"], volume: 0.6),
                // A rocking chair: the seat taking the weight, then a rock or two on its runners.
                (name: "rocking_chair", with: ["tag:rocking_chair"], sounds: ["sounds/rocking_chair_1.ogg", "sounds/rocking_chair_2.ogg"], volume: 0.6),
                (name: "wooden_seat", with: ["tag:wood"], sounds: ["sounds/seat_wood_1.ogg", "sounds/seat_wood_2.ogg"], volume: 0.6),
            ],
        ),
        // A line whipped out over the water (the plop is the water's own).
        // A line cast, and what it lands: a fish breaking the water and flapping on the bank.
        "base:fish": (
            sounds: ["sounds/cast_1.ogg", "sounds/cast_2.ogg"], volume: 0.7,
            brings: [(tags: ["fish", "raw"], sounds: ["sounds/catch_1.ogg", "sounds/catch_2.ogg"], volume: 0.8)],
        ),
        // A handful of grain shaken out to an animal, and a pat. Done with shears or a pail,
        // it is heard only by what it brings, as the server gives it (and only then awaits it).
        "base:tend": (
            sounds: ["sounds/tend_1.ogg", "sounds/tend_2.ogg"], volume: 0.7,
            ways: [
                (name: "shear", with: ["tag:shears"], silent: true),
                (name: "milk", with: ["tag:pail"], silent: true),
            ],
            // The server answers at once: a fleece picked up a moment later is not taken for it.
            brought_within: Some(3.0),
            brings: [
                // A fleece shorn: iron blades snipping, the wool rustling as it parts.
                (tags: ["wool"], sounds: ["sounds/work/shear_1.ogg", "sounds/work/shear_2.ogg"], volume: 0.7),
                // Milk drawn: squirts hissing into the pail, ringing on its wood.
                (tags: ["dairy"], sounds: ["sounds/work/milk_1.ogg", "sounds/work/milk_2.ogg"], volume: 0.6),
            ],
        ),
        // A pouch tipped out: cloth and a few small things clinking.
        "base:empty_pouch": (sounds: ["sounds/pouch_1.ogg", "sounds/pouch_2.ogg"], volume: 0.6),
        // Stepping up to the crafting table: the same parts fitted, softer.
        "base:use_table": (sounds: ["sounds/craft_1.ogg", "sounds/craft_2.ogg", "sounds/craft_3.ogg"], volume: 0.6),
        // Something fed into a machine: a scrape and a heavy clunk inside.
        "base:use_machine": (sounds: ["sounds/machine_1.ogg", "sounds/machine_2.ogg"], volume: 0.9),
        // Metal ticks in the lock, then the bolt giving.
        "base:pick_lock": (sounds: ["sounds/lock_1.ogg", "sounds/lock_2.ogg"], volume: 0.7),
        // A full skep's comb cut: a sticky tearing and honey dripping, heard as the server
        // takes it, from the skep (`when_done`).
        "base:tend_bees": (
            sounds: ["sounds/work/honey_1.ogg", "sounds/work/honey_2.ogg"], volume: 0.7, when_done: true,
            // A swarm is heard only by the skep of bees it brings; only it awaits one.
            ways: [(name: "swarm", with: ["bee_nest"], silent: true)],
            brought_within: Some(3.0),
            brings: [
                // A swarm smoked into the skep: two puffs, the hum swelling and settling. Heard
                // as the skep of bees comes to hand; one that stays put for want of smoke is
                // silent.
                (tags: ["bees"], sounds: ["sounds/work/hive_1.ogg", "sounds/work/hive_2.ogg"], volume: 0.6),
            ],
        ),
        // A soft bell swelling at the altar.
        "base:pray": (sounds: ["sounds/pray_1.ogg"], volume: 0.8),
        // Fertiliser scattered over the soil.
        "base:fertilise": (sounds: ["sounds/sprinkle_1.ogg", "sounds/sprinkle_2.ogg"], volume: 0.8),
        // Something thrown down: a swish and a soft landing.
        "core:drop": (sounds: ["sounds/toss_1.ogg", "sounds/toss_2.ogg"], volume: 0.6),
        // Heard by the block touched: its material's tap, break or placing.
        "core:mine": (heard: Some(Block)),
        "core:place": (heard: Some(Block)),
        "base:plant": (heard: Some(Block)),
        "base:pick": (heard: Some(Block)),
        "base:till": (heard: Some(Block)),
        "base:coat": (heard: Some(Block)),
        // Heard by the interface: an item's tap as it moves, a screen closing.
        "core:transfer": (heard: Some(Interface)),
        "core:quick_move": (heard: Some(Interface)),
        "core:lay": (heard: Some(Interface)),
        "core:stow": (heard: Some(Interface)),
        // Heard by the fight's own sounds.
        "core:attack": (heard: Some(Combat)),
        "core:dodge": (heard: Some(Combat)),
        // Quiet on purpose: looking an animal over, letting one go (its own sounds say
        // it), and coming back to life (the screen says it).
        "base:inspect": (silent: true),
        "base:release": (silent: true),
        "core:respawn": (silent: true),
    },
    // What the interface sounds like, by what happens in it: the player's chosen set's
    // `tap` (Click or Item, settings' Interface sounds), clips of its own (`sounds`, ours
    // from tools/generate_sfx.py, played at the set's loudness and off with it), a
    // `jingle` (the tunes above), or `silent: true`. `volume` times the clip, `pitch` its
    // speed. A package that names one replaces its sound; every one says how it sounds, or
    // the game does not start.
    interface: {
        // A button pressed.
        "click": (tap: Some(Click), volume: 0.4),
        // The pointer over a button: quiet, or menus chatter.
        "hover": (silent: true),
        // An item picked up or put down.
        "item": (tap: Some(Item), volume: 0.32),
        // Half a stack picked up: the same tap, higher and lighter.
        "split": (tap: Some(Item), volume: 0.26, pitch: 1.3),
        // A screen opened: the tap, a little higher; closed, a little lower.
        "open": (tap: Some(Item), volume: 0.3, pitch: 1.15),
        "close": (tap: Some(Item), volume: 0.24, pitch: 0.85),
        // A quest picked in the book: a page turned.
        "quest_pick": (sounds: ["sounds/page_1.ogg", "sounds/page_2.ogg"], volume: 0.32),
        // Something tried and refused (a level lacking, a recipe short, a home that cannot
        // be): two soft knocks falling, a kind "no".
        "refuse": (sounds: ["sounds/refuse_1.ogg", "sounds/refuse_2.ogg"], volume: 0.4),
        "quest_done": (jingle: true),
        "quest_claim": (jingle: true),
        "level_up": (jingle: true),
        "level_milestone": (jingle: true),
        "capstone_done": (jingle: true),
        // A firing the player set going finished while they were away (a clamp charred
        // through, a kiln gone cold): the last embers, an earthen settle and fired ware
        // ringing once as it cools.
        "fired": (sounds: ["sounds/fired_1.ogg", "sounds/fired_2.ogg"], volume: 0.45),
    },
    // The mix (crates/client/src/mix.rs). A later package's bands and caps replace those it
    // names; its ducking replaces the whole.
    mix: (
        // How loud each kind of sound is heard, low to high, in dB below full scale: the RMS
        // of a clip's loudest 50 ms (of all of it, for music and the ambience's beds) times
        // the volume the game plays it at, every volume setting at 100%. Tests measure every
        // clip we ship against these.
        bands: {
            // Every own track is levelled to one loudness (music.ron's `levels`).
            Music: (-31, -28.5),
            // Wide: beds and one-shots are tuned place by place (ambience.ron and its tests);
            // this only catches one far off the rest.
            Ambience: (-47, -19),
            // A soft open or close of the quietest set (Tap) up to the brightest click.
            Ui: (-35, -17),
            // A mining tap and a step in the leaves up to a block of water broken.
            Everyday: (-35, -14),
            // Blows, blocks and dodges: above the everyday, below a near thunderclap.
            Combat: (-30, -10),
            // The coins of a claim, softer, up to the milestone tune.
            Jingles: (-24, -15),
            // A munch at rest up to a call carrying far.
            Creatures: (-30.5, -6.5),
            // Far thunder rolling up to a strike overhead.
            Weather: (-22, -6),
        },
        // Sounds of a kind playing at once, at most; past it, the farthest, then the oldest,
        // fades out at once to make room.
        voices: {
            Ambience: 8,
            Ui: 3,
            Everyday: 10,
            Combat: 8,
            Jingles: 2,
            Creatures: 14,
            Weather: 3,
        },
        // The music dips while a jingle plays, or a boss calls, roars or cries, and comes
        // back after.
        duck: Some((under: [Jingles], bosses: true, to: 0.4, fall: 0.15, rise: 1.2)),
    ),
)
