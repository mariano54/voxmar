// Background music: its categories, when tracks play, how loud, and where. Voxmar's own
// tracks are the files in a category's folder of `assets/music`. With Minecraft assets on
// in the settings, tracks from the player's own Prism Launcher instance join them, read
// where they are and never copied (crates/client/src/music/prism.rs), each in the category
// its rule below names. The audio settings turn each category on and off. A later
// package's numbers replace these, a category it names again replaces that one, and its
// rules come before these.
(
    // Linear gain of a track at 100% music volume (a quarter under the 0.35 it was, 13 Oct).
    volume: 0.26,
    // Borrowed tracks' gain relative to Voxmar's own.
    borrowed_volume: 1.0,
    // Each of Voxmar's own tracks is brought to this loudness (dB below full scale, the RMS
    // of all of it) by how loud it was made, below, so none is much louder than the next.
    loudness: -18.0,
    // How loud each own track was made, by its path under `assets/music`. A test measures
    // the files again and says what to write for a track added or changed.
    levels: {
        "suno/moonlit_quest.mp3": -18.0,
        "suno/moonlit_quest_2.mp3": -18.1,
        "suno/quiet_sky.mp3": -17.9,
        "suno/skyward_serenity.mp3": -18.2,
        "lyria/dawn_meadow.mp3": -14.7,
        "lyria/highland_wind.mp3": -14.7,
        "lyria/lantern_village.mp3": -14.7,
        "lyria/old_forest.mp3": -14.7,
        "lyria/rain_on_stone.mp3": -14.7,
        "lyria/starlit_night.mp3": -14.7,
        "elevenlabs/round4/desert/01-sandstone-ruins-in-warm-evening-light.mp3": -17.7,
        "elevenlabs/round4/desert/02-golden-dunes-at-sunset.mp3": -19.6,
        "elevenlabs/round4/desert/03-wind-carved-canyons-at-dawn.mp3": -26.0,
        "elevenlabs/round4/fantasy/01-floating-islands-drifting-above-the-clou.mp3": -17.4,
        "elevenlabs/round4/fantasy/02-a-fairy-village-in-the-roots-of-a-great-.mp3": -15.3,
        "elevenlabs/round4/fantasy/03-a-crystal-library-hidden-in-old-ruins.mp3": -24.0,
        "elevenlabs/round4/forest/01-a-misty-pine-forest-at-dawn.mp3": -20.9,
        "elevenlabs/round4/forest/03-a-warm-cabin-deep-in-the-woods.mp3": -15.5,
        "elevenlabs/round4/snow/01-a-frozen-lake-at-dusk.mp3": -18.5,
        "elevenlabs/round4/snow/02-a-quiet-mountain-hut-on-a-winter-night.mp3": -16.2,
        "elevenlabs/round4/snow/03-frost-glittering-on-a-still-morning.mp3": -23.9,
        "elevenlabs/round5/desert/boss-01-the-guardian-of-a-buried-tomb.mp3": -16.8,
        "elevenlabs/round5/fantasy/boss-01-a-duel-with-a-rogue-archmage-in-a-floati.mp3": -15.0,
        "elevenlabs/round5/forest/boss-01-a-corrupted-beast-stalking-the-deep-wood.mp3": -15.4,
        "elevenlabs/round5/general/01-a-peaceful-village-square.mp3": -24.6,
        "elevenlabs/round5/general/02-a-cozy-inn-where-travelers-rest.mp3": -17.2,
        "elevenlabs/round5/general/03-a-quiet-moment-between-adventures.mp3": -27.0,
        "elevenlabs/round5/general/05-a-calm-harbor-town.mp3": -14.9,
        "elevenlabs/round5/snow/boss-01-a-frost-giant-on-a-frozen-glacier.mp3": -16.3,
        "home/hearth_welcome.ogg": -20.0,
        "settlement/market_day.ogg": -20.0,
    },
    // Seconds before the title screen's first track.
    first_menu_delay: (2.0, 6.0),
    // Seconds of quiet between tracks in a world (and before its first), so music comes
    // now and then, not all the time; and in the menus. Five to ten minutes (7.5 on
    // average; it was Minecraft's 10 to 20 until 15 Oct, which Mariano found too rare):
    // with tracks about 2.8 minutes long, a 20-minute stretch holds about 4.5 minutes of
    // music, nearly twice the 2.4 it did, and still mostly quiet.
    gap: (300.0, 600.0),
    menu_gap: (180.0, 420.0),
    // As a track starts, its name and category show small at the top right for this many
    // seconds, fading in and out over `fade`.
    now_playing: (shown: 6.0, fade: 1.0),
    // Seconds a track takes to fade out when a game starts or ends.
    fade_out: 1.5,
    // Seconds before another pick when a borrowed track cannot be read or played, and
    // before a track when music is turned back on with M.
    retry_after: 2.0,
    resume_after: 2.0,
    // The chance a pick is one of Voxmar's own tracks while borrowed ones suit too.
    own_share: 0.25,
    // In the settings' order. Each is called `music.<name>` in the languages.
    categories: [
        // Voxmar's own: a folder of `assets/music` each, playing everywhere unless
        // `contexts` says otherwise.
        (name: "suno", folder: "suno"),
        (name: "lyria", folder: "lyria"),
        // Made with ElevenLabs Music v2.5 by tools/music/elevenlabs (rounds 4 and 5): the
        // general tracks play anywhere; a biome's only in its biome (by its tags in
        // biomes.ron), above ground; a boss's only in a boss fight, and only for a boss
        // whose `music` (its creature's) names one of its tags, wherever the fight is. The
        // boss tracks with no tags (none yet) are every boss's.
        (name: "elevenlabs", folder: "elevenlabs", tracks: [
            (paths: ["*/forest/boss-*"], contexts: [Boss], biomes: ["forest"]),
            (paths: ["*/snow/boss-*"], contexts: [Boss], biomes: ["frozen", "cold", "tundra", "snow"]),
            (paths: ["*/desert/boss-*"], contexts: [Boss], biomes: ["desert", "dunes", "mesa"]),
            (paths: ["*/fantasy/boss-*"], contexts: [Boss], biomes: ["fantastical"]),
            (paths: ["*/boss-*"], contexts: [Boss]),
            (paths: ["*/forest/*"], contexts: [Game], biomes: ["forest"]),
            (paths: ["*/snow/*"], contexts: [Game], biomes: ["frozen", "cold", "tundra", "snow"]),
            (paths: ["*/desert/*"], contexts: [Game], biomes: ["desert", "dunes", "mesa"]),
            (paths: ["*/fantasy/*"], contexts: [Game], biomes: ["fantastical"]),
        ]),
        // The home motif: composed by tools/generate_home_motif.py, played only as `home`
        // below says, never in the rotation.
        (name: "home", folder: "home", contexts: [Home]),
        // The settlement motif: composed by tools/generate_settlement_motif.py, played only
        // as `home` below says of it, never in the rotation.
        (name: "settlement", folder: "settlement", contexts: [Settlement]),
        // Borrowed from the Prism instance, so only with Minecraft assets on.
        (name: "minecraft_menu"),
        (name: "minecraft_world"),
        (name: "minecraft_deep"),
        (name: "minecraft_records"),
    ],
    // Tracks played lately that are passed over while others suit.
    recent: 12,
    // A boss fight: a creature with `boss: true` alive within `within` blocks, or a block
    // of a boss's room (`rooms`: the block, and whose room it is) within `room_reach`
    // blocks. Only that boss's tracks play then (its `music` tags, else the untagged boss
    // tracks): the calm track playing fades as they start, and the boss's when it ends.
    // A boss that roams (Old Tusk) is in a fight only while it attacks, shows a tell or is
    // hurt, and for `calm_after` seconds after: one nicked that goes back to grazing is not.
    boss: (within: 32.0, rooms: [(block: "base:hollow_floor", boss: "base:rootmother")], room_reach: 12, calm_after: 12.0),
        // Underground: this many blocks below the surface, with this little of the air
    // around open to the sky.
    underground: (depth: 12.0, max_sky: 0.05),
    // The home motif: the first time each night (`dusk` to `dawn`, ticks after sunrise as
    // /time counts, the way-home mark's night in interface.ron) the player steps inside their
    // own lit home, a `Home` track plays (the `home` category's). Inside is within `reach`
    // blocks of the burning hearth each way (survival.ron's home_reach) under a roof within
    // `roof` blocks of the head. The track playing fades for it; a boss fight holds it
    // back, and one starting fades it.
    // The settlement motif keeps the same clock: the first time each day (`dawn` to `dusk`)
    // the player steps within a settlement's bounds (the ground its buildings stand on and
    // six blocks round), a `Settlement` track plays (the `settlement` category's). Never over
    // a motif playing, home's or its own, nor in a boss fight.
    home: (reach: 7, roof: 12, dusk: 16500, dawn: 23500),

    prism: (
        // Instances whose folder or display name contains one of these, any case; the
        // most recently launched plays. The settings may name another.
        instances: ["gt_new_horizons", "gt new horizons", "gtnh"],
        // Folders of the instance's game folder to look in, after the asset store's
        // music for its Minecraft version. A file name found earlier is skipped, so a
        // resource pack repeating the soundtrack adds only what is new.
        sources: [
            // HorizonMelodies' soundtrack zip: every sound in it is a track.
            (folder: "horizonmelodies", all_music: true),
            (folder: "resourcepacks"),
            (folder: "mods"),
        ],
        // In other packs, sounds are tracks by their path, or by the sound event naming
        // them (its name, or its category).
        music_paths: ["*music/*", "*records/*", "*record/*", "*music_disc*"],
        music_events: ["music*", "*.music*", "record*", "*.record*", "music_disc*", "*.music_disc*"],
        music_categories: ["music", "record"],
        // The most bytes a file is read to (64 MiB); a bigger one is passed over.
        max_bytes: 67108864,
        // How many folders deep a resource pack that is a folder is looked through.
        folder_depth: 12,
    ),

    // Where each borrowed track plays, by its path in its pack, less the namespace: for
    // `minecraft:music/game/calm1`, `music/game/calm1`; for HorizonMelodies' StaTech
    // tracks, `music_and_melody/music/overworld/<name>`. The first match decides.
    rules: [
        (category: "minecraft_menu", paths: ["*music/menu/*", "*end/credits*"], contexts: [Menu]),
        // The unsettling discs only below.
        (category: "minecraft_records", paths: ["*records/11", "*records/13", "*music_disc/11", "*music_disc/13"], contexts: [Underground], weight: 0.5),
        (category: "minecraft_records", paths: ["*records/*", "*record/*", "*music_disc*"], contexts: [Game, Underground], weight: 0.5),
        // Nether, End, caves and strongholds: the music of being deep down.
        (category: "minecraft_deep", paths: [
            "*nether*", "*crimson_forest*", "*warped_forest*", "*soulsand_valley*", "*soul_sand_valley*", "*basalt_deltas*",
            "*/end/*", "*dragon*", "*boss*",
            "*caves/*", "*deep_dark*", "*dripstone*", "*structure/*", "*ancient_city*", "*trial_chambers*", "*stronghold*",
        ], contexts: [Underground]),
        (category: "minecraft_world", paths: ["*creative*"], contexts: [Game]),
        (category: "minecraft_world", paths: ["*under_water*", "*underwater*", "*/water/*"], contexts: [Game]),
        // Everything else is the world's: the game, overworld biome and misc tracks.
        (category: "minecraft_world", paths: ["*"], contexts: [Game, Underground]),
    ],
)
