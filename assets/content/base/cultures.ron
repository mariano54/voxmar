            palette: (walls: [Name("white_terracotta", 3), Name("yellow_terracotta", 2)], trim: [Name("{trim}_planks", 2), Name("green_terracotta", 1), Name("dark_oak_planks", 1)], roof: [Name("red_terracotta", 2), Name("brown_terracotta", 2), Name("gray_terracotta", 1)]),
            quirks: {"dovecote_town": 2.0, "giant_tree": 2.0, "bee_town": 2.0, "windmills": 2.0, "street_ovens": 1.5, "garden_walls": 1.5},
            names: (
                first: [("Ash", "アッシュ"), ("Oak", "オーク"), ("Bram", "ブラム"), ("Hollin", "ホリン"), ("Thorn", "ソーン"), ("Mill", "ミル"), ("Wen", "ウェン"), ("Elm", "エルム"), ("Ald", "オルド"), ("Haw", "ホー"), ("Brook", "ブルック"), ("Wyn", "ウィン"), ("Lark", "ラーク"), ("Fern", "ファーン"), ("Barrow", "バロウ"), ("Copp", "コップ"), ("Har", "ハー"), ("Stan", "スタン"), ("Wych", "ウィッチ"), ("Lin", "リン"), ("Mar", "マー"), ("Cran", "クラン"), ("Bly", "ブライ"), ("Cherry", "チェリー"), ("Wood", "ウッド"), ("Red", "レッド"), ("Kings", "キングス"), ("Bourne", "ボーン"), ("Ox", "オックス"), ("Pidd", "ピッド"), ("Sel", "セル"), ("Tun", "タン"), ("Wil", "ウィル"), ("Pen", "ペン"), ("Brad", "ブラッド"), ("Chal", "チャル"), ("Ather", "アザー"), ("Hen", "ヘン"), ("Rook", "ルック"), ("Swan", "スワン"), ("Apple", "アップル"), ("Hazel", "ヘーゼル"), ("Bell", "ベル"), ("Clay", "クレイ"), ("Dun", "ダン"), ("Lang", "ラング"), ("Tad", "タッド")],
                last: [("ford", "フォード"), ("ley", "リー"), ("ton", "トン"), ("ham", "ハム"), ("wick", "ウィック"), ("field", "フィールド"), ("bury", "ベリー"), ("worth", "ワース"), ("stead", "ステッド"), ("brook", "ブルック"), ("well", "ウェル"), ("hurst", "ハースト"), ("combe", "クーム"), ("dale", "デール"), ("thorpe", "ソープ"), ("cote", "コート"), ("den", "デン"), ("ridge", "リッジ"), ("bridge", "ブリッジ"), ("wold", "ウォルド"), ("shaw", "ショー"), ("hope", "ホープ"), ("minster", "ミンスター"), ("ing", "イング"), ("lock", "ロック"), ("sted", "ステッド"), ("over", "オーヴァー"), ("church", "チャーチ")],
                small: [("End", "エンド"), ("Green", "グリーン"), ("Cross", "クロス"), ("Hollow", "ホロウ"), ("Row", "ロウ"), ("Corner", "コーナー"), ("Bottom", "ボトム"), ("Hill", "ヒル")],
                prefixes: [
                    (en: "Old", ja: "オールド", weight: 1.0, lean: {"age": 1.0}),
                    (en: "New", ja: "ニュー", weight: 0.6, lean: {"age": -1.0}),
                    (en: "Great", ja: "グレート", weight: 0.5, lean: {"wealth": 1.0, "crowding": 0.5}),
                    (en: "Little", ja: "リトル", weight: 0.6, lean: {"crowding": -1.0}),
                    (en: "Upper", ja: "アッパー", weight: 0.4),
                    (en: "Lower", ja: "ロウアー", weight: 0.3),
                    (en: "Long", ja: "ロング", weight: 0.3, lean: {"order": 1.0}),
