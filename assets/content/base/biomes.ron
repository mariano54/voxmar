#![enable(implicit_some)]
// Base game biomes.
//
// A biome claims cells of the band table in `climate.ron` (temperature × moisture ×
// continentalness × erosion; an axis left out claims all its bands), and every cell must
// belong to some land biome. Biomes sharing a cell split it by the weirdness field: common
// ones by weight in the middle of its range, rarer ones in its extremes, so a rare biome
// appears as whole regions in some places and not at all in others. A box with an
// `aether` range only applies where the land is that fantastical, and there displaces the
// ordinary biomes of its cells.
//
// `variants` take a share of their parent's land each (times their rarity), picked by an
// evenly spread variant field. An `ecotone` is a thin slice along the border of two
// biomes. `inherit` copies every field left out from another biome.
//
// Surface rules: see `SurfaceDef` and `Condition` in `crates/worldgen/src/content.rs`.
// Noises are named for their seed, so rules naming the same noise share it.
(
    biomes: [
        // --- Water ---------------------------------------------------------------------
        (
            name: "ocean",
            tags: ["ocean", "water"],
            climate: [(continentalness: ("ocean", "ocean"))],
            surface: (
                rules: [
                    (when: [Underwater, Deeper(10.0, 16.0)], place: (top: Mix([Name("gravel", 3.0), Name("sand", 1.0)]))),
                    (when: [Underwater, Patch((name: "clay_beds", scale: 25.0, octaves: 2), 0.5)], place: (top: Block("clay"))),
                    (when: [Underwater, Colder(1.0, 4.0)], place: (top: Block("gravel"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Block("sand")),
                shore: (top: Block("sand")),
            ),
        ),
        (
            name: "deep_ocean",
            tags: ["ocean", "water", "deep"],
            climate: [(continentalness: ("deep_ocean", "deep_ocean"))],
            surface: (
                ground: (top: Block("sand")),
                underwater: (top: Mix([Name("gravel", 4.0), Name("clay", 0.5), Name("sand", 1.0)])),
            ),
        ),
        (
            // Rivers and lakes: wherever fresh water lies, in every climate.
            name: "river",
            tags: ["river", "water", "fresh_water"],
            role: River,
            climate: [()],
            surface: (
                rules: [
                    (when: [Underwater, Warmer(17.0, 19.0), Wetter(1.0, 1.2), Chance(0.55)], place: (top: Block("mud"))),
                    (when: [Underwater, Colder(1.0, 4.0)], place: (top: Mix([Name("gravel", 3.0), Name("sand", 1.0)]))),
                    (when: [Underwater, Patch((name: "clay_beds", scale: 25.0, octaves: 2), 0.45)], place: (top: Block("clay"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Block("sand")),
                shore: (top: Block("sand")),
            ),
        ),

        // --- Temperate -----------------------------------------------------------------
        (
            name: "plains",
            tags: ["grassland", "temperate", "open"],
            climate: [(
                temperature: ("cool", "temperate"),
                moisture: ("moderate", "moderate"),
                continentalness: ("coast", "far_inland"),
                erosion: ("flat", "slopes"),
            )],
            surface: (
                rules: [
                    (when: [Slope(1.5, 3.0), Patch((name: "plains_rock", scale: 20.0), 0.2)], place: (top: Mix([Name("coarse_dirt", 2.0), Name("stone", 1.0)]))),
                    (when: [Patch((name: "bare_earth", scale: 16.0, octaves: 2), 0.62)], place: (top: Block("coarse_dirt"), filler: Block("dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("sand", 3.0), Name("clay", 1.0)])),
                shore: (top: Block("sand")),
            ),
            variants: [("flower_meadow", 0.18)],
        ),
        (
            name: "flower_meadow",
            inherit: "plains",
            tags: ["grassland", "temperate", "open", "flowers"],
        ),
        (
            // Oak and birch.
            name: "forest",
            tags: ["forest", "temperate", "broadleaf"],
            climate: [
                (temperature: ("cool", "warm"), moisture: ("humid", "humid"), continentalness: ("coast", "far_inland"), erosion: ("flat", "slopes")),
                (temperature: ("cool", "cool"), moisture: ("wet", "wet"), continentalness: ("coast", "far_inland"), erosion: ("flat", "slopes")),
                (temperature: ("temperate", "warm"), moisture: ("wet", "wet"), continentalness: ("coast", "far_inland"), erosion: ("slopes", "slopes")),
                (temperature: ("warm", "warm"), moisture: ("humid", "wet"), continentalness: ("coast", "far_inland"), erosion: ("peaks", "peaks")),
            ],
            surface: (
                rules: [
                    (when: [Forest(0.45, 0.8), Colder(10.0, 12.0)], place: (top: Block("podzol"), filler: Block("dirt"))),
                    (when: [Forest(0.35, 0.7), Patch((name: "moss", scale: 25.0, octaves: 2), 0.1)], place: (top: Block("moss_block"), filler: Block("dirt"))),
                    (when: [Slope(2.0, 3.0)], place: (top: Mix([Name("coarse_dirt", 2.0), Name("grass_block", 2.0), Name("gravel", 1.0)]), filler: Block("dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("sand", 2.0), Name("clay", 1.0), Name("gravel", 1.0)])),
                shore: (top: Block("sand")),
            ),
            variants: [("birch_forest", 0.25), ("cherry_grove", 0.4)],
        ),
        (
            name: "birch_forest",
            inherit: "forest",
            tags: ["forest", "temperate", "broadleaf", "birch"],
        ),
        (
            name: "cherry_grove",
            inherit: "forest",
            tags: ["forest", "temperate", "broadleaf", "blossom"],
            rarity: Rare,
            colors: (foliage: (236, 168, 196)),
        ),
        (
            name: "dark_forest",
            tags: ["forest", "temperate", "broadleaf", "dense"],
            climate: [(temperature: ("temperate", "warm"), moisture: ("wet", "wet"), continentalness: ("coast", "far_inland"), erosion: ("flat", "hills"))],
            surface: (
                rules: [
                    (when: [Forest(0.35, 0.7), Patch((name: "moss", scale: 25.0, octaves: 2), -0.1)], place: (top: Block("moss_block"), filler: Block("rooted_dirt"))),
                    (when: [Forest(0.5, 0.8)], place: (top: Mix([Name("podzol", 2.0), Name("coarse_dirt", 1.0)]), filler: Block("dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("mud", 1.0), Name("clay", 1.0), Name("sand", 1.0)])),
                shore: (top: Mix([Name("sand", 2.0), Name("mud", 1.0)])),
            ),
        ),
        (
            name: "swamp",
            tags: ["wetland", "temperate", "warm"],
            weight: 3.0,
            climate: [(temperature: ("temperate", "hot"), moisture: ("wet", "wet"), continentalness: ("coast", "inland"), erosion: ("flat", "flat"))],
            surface: (
                rules: [
                    (when: [Not(Altitude(0.0, 3.0))], place: (top: Block("mud"), filler: Block("mud"), depth: 2)),
                    (when: [Forest(0.3, 0.6), Patch((name: "moss", scale: 25.0, octaves: 2), 0.0)], place: (top: Block("moss_block"), filler: Block("rooted_dirt"))),
                    (when: [Patch((name: "swamp_mud", scale: 12.0, octaves: 2), 0.35)], place: (top: Block("mud"), filler: Block("dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("mud", 3.0), Name("clay", 1.0)])),
                shore: (top: Block("mud"), filler: Block("mud")),
            ),
        ),
        (
            // Cool, dry grassland with stony ground and worn game trails.
            name: "steppe",
            tags: ["grassland", "dry", "open"],
            climate: [(temperature: ("cold", "temperate"), moisture: ("arid", "dry"), continentalness: ("coast", "far_inland"), erosion: ("flat", "slopes"))],
            surface: (
                rules: [
                    (when: [Band((name: "game_trails", scale: 140.0), 0.012)], place: (top: Block("coarse_dirt"), filler: Block("dirt"))),
                    (when: [Patch((name: "steppe_stones", scale: 22.0, octaves: 2), 0.55)], place: (top: Mix([Name("gravel", 2.0), Name("stone", 1.0), Name("coarse_dirt", 1.0)]))),
                    (when: [Drier(0.3, 0.45), Warmer(8.0, 12.0)], place: (top: Mix([Name("coarse_dirt", 3.0), Name("grass_block", 1.0)]), filler: Block("dirt"))),
                ],
                ground: (top: Mix([Name("grass_block", 4.0), Name("coarse_dirt", 1.0)]), filler: Block("dirt")),
                underwater: (top: Mix([Name("gravel", 1.0), Name("sand", 1.0)])),
                shore: (top: Mix([Name("gravel", 1.0), Name("sand", 1.0)])),
            ),
        ),

        // --- Cold ----------------------------------------------------------------------
        (
            name: "taiga",
            tags: ["forest", "cold", "conifer"],
            climate: [(temperature: ("cold", "cold"), moisture: ("moderate", "wet"), continentalness: ("coast", "far_inland"), erosion: ("flat", "slopes"))],
            surface: (
                rules: [
                    (when: [Forest(0.45, 0.8)], place: (top: Block("podzol"), filler: Block("dirt"))),
                    (when: [Slope(1.5, 2.5)], place: (top: Mix([Name("coarse_dirt", 2.0), Name("grass_block", 2.0), Name("gravel", 1.0)]), filler: Block("dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("gravel", 2.0), Name("sand", 1.0)])),
                shore: (top: Mix([Name("gravel", 2.0), Name("sand", 1.0)])),
            ),
        ),
        (
            // Between taiga and forest, birch among the spruce.
            name: "birch_taiga",
            inherit: "taiga",
            tags: ["forest", "cold", "conifer", "birch"],
            ecotone: (between: ("taiga", "forest"), width: 2.0),
        ),
        (
            name: "snowy_tundra",
            tags: ["tundra", "frozen", "open"],
            climate: [(temperature: ("frozen", "frozen"), continentalness: ("coast", "far_inland"), erosion: ("flat", "hills"))],
            surface: (
                rules: [
                    (when: [Patch((name: "tundra_gravel", scale: 30.0, octaves: 2), 0.5)], place: (top: Mix([Name("gravel", 2.0), Name("coarse_dirt", 1.0)]))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Block("gravel")),
                shore: (top: Block("gravel")),
            ),
        ),
        (
            // Fields of bare ice where the cold is fiercest, in a few regions only.
            name: "glacier",
            tags: ["frozen", "ice", "open"],
            rarity: Rare,
            climate: [(temperature: ("frozen", "frozen"), continentalness: ("coast", "far_inland"), erosion: ("flat", "slopes"))],
            surface: (
                rules: [
                    (when: [Patch((name: "glacier_snow", scale: 18.0, octaves: 2), 0.3)], place: (top: Block("snow_block"), filler: Block("packed_ice"))),
                    (when: [Band((name: "crevasses", scale: 60.0), 0.03)], place: (top: Block("blue_ice"), filler: Block("packed_ice"))),
                ],
                ground: (top: Block("packed_ice"), filler: Block("packed_ice"), depth: 6),
                underwater: (top: Block("gravel")),
                shore: (top: Block("gravel")),
                cliff: Mix([Name("packed_ice", 2.0), Name("stone", 1.0)]),
            ),
        ),
        (
            // High country: grass giving way to scree and rock with height and slope.
            name: "mountains",
            tags: ["mountain", "highland"],
            climate: [
                (temperature: ("frozen", "cold"), continentalness: ("coast", "far_inland"), erosion: ("slopes", "peaks")),
                (temperature: ("cool", "temperate"), continentalness: ("coast", "far_inland"), erosion: ("peaks", "peaks")),
            ],
            surface: (
                rules: [
                    (when: [Altitude(70.0, 95.0), Colder(6.0, 9.0), Slope(1.0, 2.5)], place: (top: Mix([Name("gravel", 3.0), Name("stone", 1.0)]), filler: Block("stone"))),
                    (when: [Slope(1.5, 3.0)], place: (top: Mix([Name("stone", 2.0), Name("gravel", 1.0), Name("coarse_dirt", 2.0), Name("grass_block", 2.0)]), filler: Block("dirt"))),
                    (when: [Altitude(50.0, 80.0), Patch((name: "alpine_rock", scale: 14.0, octaves: 2), 0.25)], place: (top: Mix([Name("stone", 1.0), Name("coarse_dirt", 1.0)]))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Block("gravel")),
                shore: (top: Block("gravel")),
            ),
        ),

        // --- Hot -----------------------------------------------------------------------
        (
            name: "desert",
            tags: ["desert", "hot", "dry", "open"],
            climate: [(temperature: ("warm", "hot"), moisture: ("arid", "arid"), continentalness: ("coast", "far_inland"), erosion: ("flat", "hills"))],
            surface: (
                rules: [
                    // Wind streaks of red sand, thick in some fields and thread-thin elsewhere.
                    (
                        when: [Tapered((name: "desert_streaks", scale: 45.0), (name: "desert_streak_width", scale: 400.0, octaves: 2), [(0.35, 0.06), (0.15, 0.03), (0.0, 0.012)])],
                        place: (top: Block("red_sand"), filler: Block("sandstone"), depth: 5),
                    ),
                ],
                ground: (top: Block("sand"), filler: Block("sandstone"), depth: 6),
                underwater: (top: Block("sand")),
                shore: (top: Block("sand")),
                cliff: Mix([Name("sandstone", 3.0), Name("red_sandstone", 1.0)]),
            ),
        ),
        (
            // Hot, dry uplands of red sand and banded clay.
            name: "badlands",
            tags: ["desert", "hot", "dry", "mesa"],
            climate: [(temperature: ("warm", "hot"), moisture: ("arid", "dry"), continentalness: ("coast", "far_inland"), erosion: ("slopes", "peaks"))],
            strata: [
                "orange_terracotta", "terracotta", "yellow_terracotta", "orange_terracotta",
                "white_terracotta", "terracotta", "brown_terracotta", "orange_terracotta",
                "red_terracotta", "light_gray_terracotta", "terracotta", "orange_terracotta",
                "yellow_terracotta", "red_terracotta", "white_terracotta", "brown_terracotta",
            ],
            surface: (
                rules: [
                    (when: [Slope(1.5, 3.0)], place: (top: Strata, filler: Strata, depth: 14)),
                ],
                ground: (top: Block("red_sand"), filler: Strata, depth: 14),
                underwater: (top: Block("red_sand")),
                shore: (top: Block("red_sand")),
                cliff: Strata,
            ),
        ),
        (
            name: "savanna",
            tags: ["grassland", "hot", "dry", "open"],
            climate: [
                (temperature: ("warm", "hot"), moisture: ("dry", "moderate"), continentalness: ("coast", "far_inland"), erosion: ("flat", "hills")),
                (temperature: ("warm", "hot"), moisture: ("moderate", "moderate"), continentalness: ("coast", "far_inland"), erosion: ("slopes", "peaks")),
            ],
            surface: (
                rules: [
                    (when: [Band((name: "game_trails", scale: 140.0), 0.012)], place: (top: Block("coarse_dirt"), filler: Block("dirt"))),
                    (when: [Patch((name: "savanna_soil", scale: 30.0, octaves: 2), 0.4)], place: (top: Block("coarse_dirt"), filler: Block("dirt"))),
                    (when: [Slope(1.5, 2.5)], place: (top: Mix([Name("coarse_dirt", 3.0), Name("stone", 1.0), Name("grass_block", 1.0)]), filler: Block("dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Block("sand")),
                shore: (top: Block("sand")),
            ),
        ),
        (
            name: "jungle",
            tags: ["forest", "hot", "wet", "dense"],
            climate: [(temperature: ("hot", "hot"), moisture: ("humid", "wet"), continentalness: ("coast", "far_inland"))],
            surface: (
                rules: [
                    (when: [Forest(0.35, 0.7), Patch((name: "moss", scale: 25.0, octaves: 2), 0.0)], place: (top: Block("moss_block"), filler: Block("rooted_dirt"))),
                    (when: [Not(Altitude(0.0, 2.5)), Wetter(1.35, 1.5)], place: (top: Block("mud"), filler: Block("mud"), depth: 2)),
                ],
                ground: (top: Block("grass_block"), filler: Block("rooted_dirt")),
                underwater: (top: Mix([Name("sand", 2.0), Name("mud", 1.0)])),
                shore: (top: Mix([Name("sand", 3.0), Name("mud", 1.0)])),
            ),
        ),

        // --- Fantastical ---------------------------------------------------------------
        (
            // Where aether runs high in mild country: pale stone breaks through the turf in
            // patches and veins.
            name: "moonlit_meadow",
            tags: ["grassland", "temperate", "open", "fantastical"],
            rarity: Uncommon,
            climate: [(
                temperature: ("cool", "temperate"),
                moisture: ("moderate", "humid"),
                continentalness: ("coast", "far_inland"),
                erosion: ("flat", "hills"),
                aether: (0.8, 1.0),
            )],
            surface: (
                rules: [
                    (when: [Band((name: "moonlit_veins", scale: 70.0), 0.02)], place: (top: Block("calcite"), filler: Block("calcite"))),
                    (when: [Patch((name: "moonlit_stone", scale: 18.0, octaves: 2), 0.5)], place: (top: Mix([Name("calcite", 2.0), Name("diorite", 1.0)]))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("sand", 2.0), Name("clay", 1.0)])),
                shore: (top: Block("sand")),
            ),
            colors: (grass: (158, 178, 225), foliage: (170, 186, 230)),
        ),
    ],
)
