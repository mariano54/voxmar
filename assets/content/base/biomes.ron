                    (when: [Patch((name: "moonlit_stone", scale: 18.0, octaves: 2), 0.5)], place: (top: Mix([Name("calcite", 2.0), Name("diorite", 1.0)]))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
