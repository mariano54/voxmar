#![enable(implicit_some)]
// Base game biomes.
//
// A biome claims cells of the band table in `climate.ron` (temperature × moisture ×
// continentalness × erosion; an axis left out claims all its bands), and every cell must
// belong to some land biome. Biomes sharing a cell split it by the weirdness field: common
// ones by weight in the middle of its range, rarer ones in its extremes, so a rare biome
// appears as whole regions in some places and not at all in others. A box with an
// `aether` range only applies where the land is that fantastical, and there displaces the
// ordinary biomes of its cells.
//
// `atmosphere` (haze, sky tint, colour grading, ambient particles from ambient.ron) comes
// from the climate unless a biome sets parts of it. `flora` selects trees and plants from
// the shared pools in trees.ron and plants.ron.
//
// `variants` take a share of their parent's land each (times their rarity), picked by an
// evenly spread variant field. An `ecotone` is a thin slice along the border of two
// biomes. `inherit` copies every field left out from another biome.
//
// Surface rules: see `SurfaceDef` and `Condition` in `crates/worldgen/src/content.rs`.
// Noises are named for their seed, so rules naming the same noise share it. `include`
// names shared rule sets from surfaces.ron (slopes, trails), tried before the biome's own.
//
// Flora: `cover` is how much of the ground grasses and ferns carpet (most of it in a
// meadow), `flowers` how many flowers grow in the bloom field's drifts: keep it low (a few
// hundredths) for ordinary land; only flower meadows and rare variants run high. Trees,
// carpets, flowers and the mixed blocks of the ground keep to the biome's palette (see
// crates/worldgen/src/hue.rs): selectors may pick many kinds, and those whose colours sit
// with the biome's foliage, grass and ground grow freely while a clashing one is a rare
// accent. `palette` builds a biome around another colour (a maple wood, a cherry grove).
// Every ordinary land biome takes Tag("forage", 0.02): the foraged plants (wild roots,
// berries, herbs, mushrooms) whose climate and habitat suit it, each a rare find.
// `decorations` select from decorations.ron (rocks, logs, bushes, patches, litter); left
// out, a biome takes every decoration carrying one of its tags.
//
// `level` (1 ..= 10, the design wiki's first pass for P15) is how harsh, rare and
// aether-touched a biome is. Up to a find's home level (by its rarity) each level makes the
// biome's rarer plants and gathering trees about 1.4 times commoner; above it a find keeps
// about two thirds of its rate, so a high-level biome still has the commons of the gentle
// ones. Far from spawn, higher-level biomes grow likelier. The numbers are `levels` in
// climate.ron (see crates/worldgen/src/levels.rs). A variant sets its own; one left out
// inherits it.
(
    biomes: [
        // --- Water ---------------------------------------------------------------------
        (
            name: "ocean",
            level: 2,
            tags: ["ocean", "water"],
            climate: [(continentalness: ("ocean", "ocean"))],
            flora: (trees: [Name("palm", 1.0)], cover: 0.3, plants: [Tag("grass", 1.0), Name("tall_grass", 0.35)]),
            surface: (
                rules: [
                    (when: [Underwater, Deeper(10.0, 16.0)], place: (top: Mix([Name("gravel", 3.0), Name("sand", 1.0)]))),
                    (when: [Underwater, Patch((name: "clay_beds", scale: 25.0, octaves: 2), 0.5)], place: (top: Block("clay"))),
                    (when: [Underwater, Colder(1.0, 4.0)], place: (top: Block("gravel"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Block("sand")),
                shore: (top: Block("sand")),
            ),
        ),
        (
            name: "deep_ocean",
            level: 5,
            tags: ["ocean", "water", "deep"],
            climate: [(continentalness: ("deep_ocean", "deep_ocean"))],
            surface: (
                ground: (top: Block("sand")),
                underwater: (top: Mix([Name("gravel", 4.0), Name("clay", 0.5), Name("sand", 1.0)])),
            ),
        ),
        (
            // Rivers and lakes: wherever fresh water lies, in every climate. Creeks run
            // over gravel and rock between stony, mossy or muddy banks; rivers lay down
            // gravel in the hills and sand, clay and mud in the lowlands; lakes have
            // sandy shores; hot springs build travertine. Rules are tried in order.
            name: "river",
            level: 1,
            tags: ["river", "water", "fresh_water"],
            role: River,
            climate: [()],
            flora: (trees: [Name("willow", 1.0), Name("mangrove", 2.3), Name("alder", 0.5), Name("bald_cypress", 0.3)], cover: 0.75, flowers: 0.01, plants: [Tag("grass", 1.0), Name("tall_grass", 0.22), Tag("riverbank", 3.0), Tag("wetland", 1.0), Tag("wild_crop", 0.4)]),
            surface: (
                rules: [
                    // Hot springs: travertine terraces stained by minerals.
                    (when: [Underwater, Water([Spring])], place: (top: Mix([Name("travertine", 3.0), Name("orange_terracotta", 1.0), Name("yellow_terracotta", 1.0)]), filler: Block("travertine"))),
                    (when: [Water([Spring])], place: (top: Mix([Name("travertine", 4.0), Name("calcite", 1.0), Name("white_terracotta", 1.0)]), filler: Block("travertine"), depth: 2)),
                    // Creek beds.
                    (when: [Underwater, Water([Creek]), Warmer(17.0, 19.0), Wetter(1.05, 1.25), Chance(0.45)], place: (top: Block("mud"))),
                    (when: [Underwater, Water([Creek]), Patch((name: "creek_rock", scale: 7.0), 0.25)], place: (top: Mix([Name("stone", 2.0), Name("andesite", 1.0)]), filler: Block("stone"))),
                    (when: [Underwater, Water([Creek])], place: (top: Block("gravel"), filler: Block("gravel"))),
                    // River and lake beds.
                    (when: [Underwater, Warmer(17.0, 19.0), Wetter(1.0, 1.2), Chance(0.55)], place: (top: Block("mud"))),
                    (when: [Underwater, Colder(1.0, 4.0)], place: (top: Mix([Name("gravel", 3.0), Name("sand", 1.0)]))),
                    (when: [Underwater, Water([River]), Altitude(24.0, 36.0)], place: (top: Mix([Name("gravel", 3.0), Name("stone", 1.0)]), filler: Block("gravel"))),
                    (when: [Underwater, Patch((name: "clay_beds", scale: 25.0, octaves: 2), 0.45)], place: (top: Block("clay"))),
                    (when: [Underwater, Water([River]), Patch((name: "river_gravel", scale: 30.0, octaves: 2), 0.0)], place: (top: Block("gravel"))),
                    (when: [Underwater, Water([Lake]), Deeper(3.0, 5.0)], place: (top: Mix([Name("gravel", 2.0), Name("clay", 1.0), Name("mud", 1.0)]))),
                    // Banks: frozen gravel and rock in the cold.
                    (when: [Water([Creek, River]), Colder(2.0, 4.0)], place: (top: Mix([Name("gravel", 2.0), Name("stone", 1.0)]), filler: Block("gravel"), depth: 2)),
                    // Rock outcrops along creeks.
                    (when: [Water([Creek]), Patch((name: "bank_rock", scale: 9.0), 0.15)], place: (top: Mix([Name("stone", 3.0), Name("andesite", 1.0), Name("moss_block", 1.0)]), filler: Block("stone"), depth: 2)),
                    (when: [Water([Creek, River]), Warmer(16.0, 18.0), Wetter(1.15, 1.35), Chance(0.5)], place: (top: Block("mud"), depth: 2)),
                    (when: [Water([Creek]), Wetter(0.9, 1.1), Patch((name: "bank_moss", scale: 12.0, octaves: 2), 0.05)], place: (top: Block("moss_block"), filler: Block("dirt"))),
                    // Gravel at the water's edge, grass above it.
                    (when: [Water([Creek]), River(0.7, 0.9)], place: (top: Mix([Name("gravel", 3.0), Name("coarse_dirt", 1.0)]), filler: Block("gravel"), depth: 2)),
                    (when: [Water([Creek])], place: (top: Block("grass_block"), filler: Block("dirt"))),
                    (when: [Water([River]), Altitude(24.0, 36.0)], place: (top: Mix([Name("gravel", 2.0), Name("stone", 1.0)]), filler: Block("gravel"), depth: 2)),
                    (when: [Water([River]), River(0.6, 0.85), Patch((name: "river_gravel", scale: 30.0, octaves: 2), 0.2)], place: (top: Block("gravel"), depth: 2)),
                    (when: [Water([Lake]), Slope(1.5, 2.5)], place: (top: Mix([Name("gravel", 2.0), Name("stone", 1.0)]), filler: Block("gravel"), depth: 2)),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Block("sand")),
                shore: (top: Block("sand")),
            ),
        ),

        // --- Cool and temperate -------------------------------------------------------
        (
            name: "plains",
            level: 1,
            tags: ["grassland", "temperate", "open"],
            // Stones on gentle open ground: grey stone mottled with pale diorite, moss on their
            // tops, not the dark rock.
            field_stones: [Name("stone", 3.0), Name("diorite", 1.0)],
            climate: [(
                temperature: ("cool", "temperate"),
                moisture: ("moderate", "moderate"),
                continentalness: ("coast", "far_inland"),
                erosion: ("flat", "slopes"),
            )],
            flora: (
                forest: 0.07,
                trees: [Name("oak", 1.0), Name("big_oak", 0.3), Name("birch", 0.2), Name("shrub", 0.8), Name("apple_tree", 0.15), Name("pear_tree", 0.1), Name("wild_cherry", 0.1), Name("hazel", 0.25)],
                cover: 0.85, flowers: 0.021,
                plants: [Name("wild_wheat", 0.3), Tag("meadow", 1.0), Name("tall_grass", 0.22), Name("dead_bush", 0.09), Tag("wild_crop", 0.4), Tag("forage", 0.02)],
            ),
            surface: (
                include: ["soil_slopes"],
                rules: [
                    (when: [Patch((name: "bare_earth", scale: 16.0, octaves: 2), 0.66)], place: (top: Block("coarse_dirt"), filler: Block("dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("sand", 3.0), Name("clay", 1.0)])),
                shore: (top: Block("sand")),
            ),
            variants: [("flower_meadow", 0.3)],
        ),
        (
            // A rare meadow in flower: one of the few places flowers grow thickly.
            name: "flower_meadow",
            level: 1,
            inherit: "plains",
            tags: ["grassland", "temperate", "open", "flowers"],
            rarity: Uncommon,
            flora: (
                forest: 0.03,
                trees: [Name("oak", 1.0), Name("shrub", 1.0), Name("apple_tree", 0.25), Name("plum_tree", 0.2), Name("pear_tree", 0.1), Name("wild_cherry", 0.1)],
                cover: 0.7, flowers: 0.3, bloom: 0.22,
                plants: [Name("wild_wheat", 0.2), Tag("meadow", 1.0), Name("tall_grass", 0.11), Tag("forage", 0.02)],
            ),
        ),
        (
            // Where steppe meets plains: grassland with groves of oak and birch.
            name: "forest_steppe",
            level: 2,
            inherit: "plains",
            tags: ["grassland", "temperate", "open", "groves"],
            // Stones on gentle open ground: grey stone mottled with pale diorite, moss on their
            // tops, not the dark rock.
            field_stones: [Name("stone", 3.0), Name("diorite", 1.0)],
            flora: (
                forest: 0.2,
                trees: [Name("oak", 1.0), Name("birch", 1.0), Name("pine", 0.4), Name("shrub", 0.8), Name("pear_tree", 0.12), Name("wild_cherry", 0.12), Name("hazel", 0.3)],
                cover: 0.8, flowers: 0.014,
                plants: [Name("wild_wheat", 0.3), Tag("meadow", 0.6), Tag("steppe", 0.6), Name("short_grass", 2.0), Name("tall_grass", 0.22), Tag("wild_crop", 0.4), Tag("forage", 0.02)],
            ),
            ecotone: (between: ("steppe", "plains"), axis: Moisture, width: 0.06),
        ),
        (
            // Lush lowland grass, tall and deep, with old oaks standing alone.
            name: "meadow",
            level: 1,
            tags: ["grassland", "temperate", "open", "lush"],
            // Stones on gentle open ground: grey stone mottled with pale diorite, moss on their
            // tops, not the dark rock.
            field_stones: [Name("stone", 3.0), Name("diorite", 1.0)],
            weight: 0.5,
            climate: [(temperature: ("temperate", "temperate"), moisture: ("humid", "humid"), continentalness: ("coast", "far_inland"), erosion: ("flat", "hills"))],
            flora: (
                forest: 0.06,
                trees: [Name("big_oak", 1.0), Name("oak", 0.6), Name("maple", 0.2), Name("willow", 1.0), Name("apple_tree", 0.25), Name("pear_tree", 0.15), Name("plum_tree", 0.15), Name("walnut", 0.5), Name("hazel", 0.3), Name("alder", 0.5)],
                cover: 0.95, flowers: 0.035,
                plants: [Name("wild_wheat", 0.25), Name("tall_grass", 1.2), Name("short_grass", 1.0), Tag("meadow", 0.6), Name("raspberry_bush", 0.4), Name("wild_rose_bush", 0.6), Tag("wild_crop", 0.4), Tag("forage", 0.02)],
            ),
            surface: (
                include: ["soil_slopes"],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("clay", 1.0), Name("sand", 1.0), Name("silt", 1.0)])),
                shore: (top: Mix([Name("silt", 2.0), Name("sand", 1.0)])),
            ),
        ),
        (
            // Oak and birch, a maple here and there.
            name: "forest",
            level: 1,
            tags: ["forest", "temperate", "broadleaf"],
            climate: [
                (temperature: ("cool", "temperate"), moisture: ("humid", "humid"), continentalness: ("coast", "far_inland"), erosion: ("flat", "slopes")),
                (temperature: ("cool", "cool"), moisture: ("wet", "wet"), continentalness: ("coast", "far_inland"), erosion: ("flat", "slopes")),
                (temperature: ("temperate", "warm"), moisture: ("wet", "wet"), continentalness: ("coast", "far_inland"), erosion: ("slopes", "slopes")),
                (temperature: ("warm", "warm"), moisture: ("humid", "wet"), continentalness: ("coast", "far_inland"), erosion: ("peaks", "peaks")),
            ],
            flora: (
                forest: 0.8,
                trees: [Tag("broadleaf", 1.0), Name("birch", 0.6), Name("big_oak", 0.4), Name("maple", 0.1), Name("amber_maple", 0.1), Name("green_maple", 0.1), Name("golden_birch", 0.05), Name("shrub", 0.12), Name("hazel", 0.4), Name("apple_tree", 0.1), Name("wild_cherry", 0.15), Name("pear_tree", 0.08), Name("chestnut", 0.5), Name("walnut", 0.3), Name("alder", 0.4)],
                exclude: ["blossom"],
                cover: 0.75, flowers: 0.01,
                plants: [Tag("meadow", 1.0), Tag("forest_floor", 0.8), Tag("forest_edge", 0.5), Name("tall_grass", 0.14), Name("large_fern", 0.3), Tag("wild_crop", 0.4), Tag("forage", 0.02)],
            ),
            surface: (
                include: ["soil_slopes"],
                rules: [
                    (when: [Forest(0.45, 0.8), Colder(10.0, 12.0)], place: (top: Block("podzol"), filler: Block("dirt"))),
                    (when: [Forest(0.35, 0.7), Patch((name: "moss", scale: 25.0, octaves: 2), 0.1)], place: (top: Block("moss_block"), filler: Block("dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("sand", 2.0), Name("clay", 1.0), Name("gravel", 1.0)])),
                shore: (top: Block("sand")),
            ),
            variants: [("birch_forest", 0.25), ("cherry_grove", 0.3), ("old_growth_forest", 0.4)],
        ),
        (
            // Evergreen laurel woods of warm, damp coasts and hills: dark glossy crowns over
            // ferns, the ground and stones furred with moss, mist in the hollows.
            name: "laurel_forest",
            level: 2,
            tags: ["forest", "warm", "broadleaf", "wet", "mossy"],
            climate: [(temperature: ("warm", "warm"), moisture: ("humid", "humid"), continentalness: ("coast", "far_inland"), erosion: ("flat", "slopes"))],
            flora: (
                forest: 0.85,
                trees: [Name("oak", 1.0), Name("dark_oak", 0.5), Name("jungle_bush", 0.15), Name("chestnut", 0.6), Name("fig", 0.5), Name("lemon_tree", 0.6), Name("orange_tree", 0.6), Name("avocado", 0.3)],
                cover: 0.8, flowers: 0.003,
                plants: [Name("fern", 2.0), Name("large_fern", 0.8), Name("maidenhair_fern", 1.0), Name("short_grass", 0.6), Tag("wild_crop", 0.4), Tag("forage", 0.02)],
                // Its signature: moss over everything.
                decorations: [Tag("forest", 1.0), Name("moss_patch", 2.5), Name("boulder", 1.5)],
            ),
            surface: (
                include: ["soil_slopes"],
                rules: [
                    (when: [Forest(0.4, 0.7), Patch((name: "laurel_moss", scale: 18.0, octaves: 2), -0.1)], place: (top: Block("moss_block"), filler: Block("rooted_dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("gravel", 1.0), Name("sand", 1.0)])),
                shore: (top: Mix([Name("gravel", 1.0), Name("sand", 1.0)])),
            ),
            colors: (grass: (96, 150, 64), foliage: (52, 112, 40)),
            atmosphere: (haze_density: 1.5, particles: [Tag("forest", 1.0), Tag("damp", 1.0)]),
        ),
        (
            name: "birch_forest",
            level: 1,
            inherit: "forest",
            tags: ["forest", "temperate", "broadleaf", "birch"],
            flora: (
                forest: 0.8,
                trees: [Name("birch", 1.0), Name("oak", 0.15), Name("shrub", 0.1), Name("rowan", 0.3), Name("wild_cherry", 0.2), Name("hazel", 0.3)],
                cover: 0.75, flowers: 0.014,
                plants: [Tag("meadow", 1.0), Tag("forest_floor", 0.6), Name("tall_grass", 0.11), Tag("wild_crop", 0.4), Tag("forage", 0.02)],
            ),
        ),
        (
            name: "cherry_grove",
            level: 2,
            inherit: "forest",
            tags: ["forest", "temperate", "broadleaf", "blossom"],
            flora: (
                forest: 0.55,
                trees: [Name("cherry", 3.0), Name("birch", 0.1), Name("oak", 0.06), Name("wild_cherry", 0.1)],
                cover: 0.7, flowers: 0.06,
                palette: (canopy: (229, 172, 205)),
                plants: [Tag("meadow", 1.0), Name("pink_tulip", 2.0), Tag("forage", 0.02)],
            ),
            rarity: Rare,
        ),
        (
            // The oldest woods: giant oaks, an ancient one now and then, deep litter and
            // fallen trunks.
            name: "old_growth_forest",
            level: 4,
            inherit: "forest",
            tags: ["forest", "temperate", "broadleaf", "dense", "ancient"],
            rarity: Rare,
            flora: (
                forest: 0.95,
                trees: [Name("big_oak", 1.5), Name("oak", 1.0), Name("ancient_oak", 15.0), Name("maple", 0.3), Name("dark_oak", 0.3), Name("chestnut", 1.0), Name("walnut", 0.6), Name("hazel", 0.2)],
                exclude: ["blossom"],
                cover: 0.65, flowers: 0.007,
                plants: [Tag("forest_floor", 1.0), Tag("fern", 1.0), Name("short_grass", 0.6), Name("ginseng", 4.4), Tag("wild_crop", 0.4), Tag("forage", 0.02)],
                // Its signature: great fallen trunks, hollow and mossy.
                decorations: [Tag("forest", 1.0), Tag("dense", 1.0), Name("fallen_log", 2.5), Name("rotting_log", 2.0)],
            ),
        ),
        (
            // Maples in autumn colour among birch and the odd spruce, on hills and slopes.
            name: "maple_forest",
            level: 2,
            tags: ["forest", "temperate", "broadleaf", "autumn"],
            weight: 0.6,
            climate: [(temperature: ("cool", "temperate"), moisture: ("humid", "wet"), continentalness: ("coast", "far_inland"), erosion: ("flat", "slopes"))],
            flora: (
                forest: 0.75,
                trees: [Name("amber_maple", 1.0), Name("maple", 0.6), Name("golden_birch", 0.4), Name("birch", 0.3), Name("green_maple", 0.2), Name("oak", 0.15), Name("hazel", 0.3), Name("walnut", 0.4), Name("chestnut", 0.4)],
                cover: 0.75, flowers: 0.01,
                // Built around autumn colour: amber and red maples, golden birch.
                palette: (canopy: (215, 125, 50)),
                plants: [Tag("forest_floor", 0.8), Tag("meadow", 0.6), Name("bracken", 0.6), Tag("autumn", 0.6), Tag("wild_crop", 0.4), Tag("forage", 0.02)],
            ),
            surface: (
                include: ["soil_slopes"],
                rules: [
                    (when: [Forest(0.35, 0.7), Patch((name: "moss", scale: 25.0, octaves: 2), 0.2)], place: (top: Block("moss_block"), filler: Block("dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("gravel", 1.0), Name("sand", 1.0)])),
                shore: (top: Mix([Name("gravel", 1.0), Name("sand", 1.0)])),
            ),
            colors: (grass: (160, 162, 84), foliage: (176, 168, 62)),
        ),
        (
            // Spruce, oak, birch and maple together, in cool hill country.
            name: "mixed_forest",
            level: 1,
            tags: ["forest", "temperate", "broadleaf", "conifer", "cool"],
            weight: 0.6,
            climate: [(temperature: ("cool", "cool"), moisture: ("moderate", "humid"), continentalness: ("coast", "far_inland"), erosion: ("flat", "slopes"))],
            flora: (
                forest: 0.7,
                trees: [Name("spruce", 1.0), Name("oak", 0.8), Name("birch", 0.8), Name("maple", 0.12), Name("amber_maple", 0.1), Name("green_maple", 0.25), Name("pine", 0.3), Name("giant_spruce", 0.3), Name("rowan", 0.3), Name("wild_cherry", 0.15), Name("hazel", 0.3), Name("larch", 0.3), Name("pear_tree", 0.1)],
                cover: 0.75, flowers: 0.01,
                plants: [Tag("forest_floor", 0.8), Tag("fern", 1.0), Tag("meadow", 0.5), Name("blueberry_bush", 0.6), Tag("wild_crop", 0.4), Tag("forage", 0.02)],
                // Its signature: mossy boulders in fields of them.
                decorations: [Tag("forest", 1.0), Tag("conifer", 1.0), Name("boulder", 3.0)],
            ),
            variants: [("golden_aspen_woods", 0.5)],
            surface: (
                include: ["soil_slopes"],
                rules: [
                    (when: [Forest(0.45, 0.8), Patch((name: "needle_beds", scale: 20.0, octaves: 2), -0.1)], place: (top: Block("podzol"), filler: Block("dirt"))),
                ],
                ground: (top: Block("grass_block"), filler: Block("dirt")),
                underwater: (top: Mix([Name("gravel", 2.0), Name("sand", 1.0)])),
                shore: (top: Mix([Name("gravel", 2.0), Name("sand", 1.0)])),
            ),
        ),
        (
            // Aspen woods in autumn gold: white trunks under yellow crowns, a few dark spruces.
            name: "golden_aspen_woods",
            level: 2,
            inherit: "mixed_forest",
            tags: ["forest", "cool", "broadleaf", "autumn"],
            rarity: Rare,
            flora: (
                forest: 0.75,
                trees: [Name("golden_birch", 1.0), Name("birch", 0.15), Name("spruce", 0.1), Name("larch", 0.4), Name("rowan", 0.3)],
                cover: 0.7, flowers: 0.007,
                plants: [Name("short_grass", 1.0), Name("fern", 0.6), Name("bracken", 0.8), Tag("forage", 0.02)],
                palette: (canopy: (220, 180, 40)),
            ),
            colors: (grass: (168, 164, 82), foliage: (186, 168, 60)),
            variants: [],
        ),
        (
            // Heather and bracken over the hills, granite breaking through, a few junipers.
            name: "heath",
            level: 3,
            tags: ["heath", "highland", "cool", "open", "rocky"],
            weight: 0.5,
