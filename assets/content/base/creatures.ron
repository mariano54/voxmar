// Creatures: animals, monsters and spirits (docs/creatures.md, docs/creature-data.md).
//
// - `level` is its combat level (RuneScape's): hunters leave alone players more than twice
//   it. The first creatures stay at level 30 and under, most of the common ones at 1, so a
//   new player can start easily (Mariano, 2026-10-06).
// - `body` is a plan from the part library (engine/src/creature.rs, `Model`), sized in
//   blocks (width, height, length), with its colours: coat, second colour, features.
// - `habitat` picks where it appears: biomes by `tag:` or name with a weight, and the
//   climate it is comfortable in (temperature °C, moisture, aether), as plants.ron does.
//   Supernatural creatures need aether. `active` is when it is about.
// - `temperament` is its temper, 0..1; each individual rolls its own personality about
//   it (`spread`). A species that lists no `behaviours` gets them from its temperament
//   and diet: the behaviour generator's first layer.
// - `xp` is the Hunter experience for butchering a kill (monsters train combat only).
// - `taming` is how players tame it (the Hunter level, trust a feeding gives, experience),
//   `breeding` how kept ones breed (the Farming level, litter, minutes to grow up) and
//   `products` what kept ones give on timers, laid or taken with a tool (docs/breeding.md).
// - `loot` is what it drops: always (chance 1) or by chance, more with the right tool
//   (`tools`: the tags of what the killer holds) and, for rarer finds, with level.
(
    // How many creatures the world holds (docs/creature-data.md): 512 wild, and 64 kept
    // animals for each player, herds and pets together (Design, draft 91); `most` makes
    // room for the wild ones and 8 keepers' animals. Animals near a player were 12, halved
    // (Mariano, 2026-10-07: "too many animals, the world is too crowded") and then found
    // too empty (2026-10-08: "we need more mobs spawning, world is feeling a bit dead"):
    // the halved cap of 6 was always full, and only about one within 32 blocks. Now 12 (the
    // number called too crowded, but with spots 20 to 40 blocks out instead of 56, more of
    // them in sight) and 8 monsters near a player, an attempt every 1.5 s, and a spot left
    // empty less often (measured in creatures.rs density_tests, `wild_density_probe`).
    // Small birds (creatures_birds.ron) have 4 of their own, so they add life without
    // taking the animals' places.
    limits: (most: 1024, wild_most: 512, kept_each: 64, keepers: 8, animals_near: 12, monsters_near: 8, birds_near: 4, first_night_monsters: 3, spawn_every: 1.5, spawn_near: 20.0, spawn_far: 40.0, spawn_unseen_angle: 75.0, empty_for_monsters: 1.5, empty_for_animals: 2.5),
    // A creature's blow that misses trains Defence only from a creature the player landed a
    // damaging blow on within the last 10 seconds, and of at least half their Defence level
    // (design wiki draft 63), so it can't be trained standing among cave bats.
    defence: (fought_within: 10.0, least_level: 0.5),
    // How a kept animal's condition is reckoned (docs/breeding.md, "Keeping animals"; the
    // numbers from the progression plan, 2026-10-07). A need met counts 1, partly 0.8,
    // unmet 0.5; condition walks toward their product 0.15 a day up and 0.25 down; a newly
    // tamed animal starts at 0.6; below half health it is held to 0.5. Products, litters
    // and treadwheel power scale by 0.5 + 0.7 × condition, and breeding needs above 0.5.
    // Fed within a day is fed, within two partly; room is shared within 5 blocks.
    // Company is one of its kind within 14 blocks; its home's climate fit is met from 0.75
    // and partly from 0.25; rain or snow over 0.05 under open sky wants a roof within 3
    // blocks, and snow counts as rain for kinds whose comfort reaches -10 °C (Review's
    // ruling, 2026-10-08).
    condition: (
        up: 0.15, down: 0.25, met: 1.0, partly: 0.8, unmet: 0.5, tamed: 0.6, hurt: 0.5,
        output: (0.5, 0.7), breed: 0.5, fed: (1.0, 2.0), space_radius: 5.0, company: 14.0,
        climate: (0.75, 0.25), wet: 0.05, roof_within: 3.0, snow_hardy: -10.0,
    ),
    // A hop up a step rises a block and a half at most, however great the leaper's own
    // jump: a snow leopard (its jump 11, over two blocks) springing on from a block before a
    // gap would otherwise come down on a fence two high beyond it. Anything that jumps at
    // all still gets up a block.
    climbing: (step_rise: 1.45),
    creatures: [
        // --- Small and common: where everyone starts -------------------------------------
        (
            name: "rabbit", level: 1, health: 3,
            body: (
                size: (0.4, 0.45),
                model: Quadruped(body: (0.3, 0.26, 0.42), head: (0.22, 0.21, 0.24), legs: 0.1, ears: (0.07, 0.22), ear_lean: 8.0, tail: (0.1, 0.1, 0.08), tail_droop: -40.0, haunches: true, snout: (0.12, 0.08, 0.04)),
                colours: [(150, 118, 86), (226, 216, 196), (70, 52, 40)],
                skin: (fur: 0.12, belly: 0.32, feet: (196, 184, 164), markings: [EarTips(colour: (82, 62, 46)), Muzzle(colour: (196, 176, 150))]),
            ),
            genes: [
                (name: "coat", kind: Alleles([(name: "agouti", frequency: 6.0), (name: "black", frequency: 1.2, effects: [Colour(0, (54, 46, 42)), Colour(2, (30, 26, 24))]), (name: "brown", frequency: 1.5, effects: [Colour(0, (120, 82, 52))]), (name: "white", frequency: 0.3, cold: 2.5, effects: [Colour(0, (238, 236, 230)), Colour(1, (246, 244, 240)), Plain])])),
                (name: "size", kind: Number(mean: 1.0, spread: 0.06, range: (0.78, 1.3), effect: Scale)),
            ],
            breeds: [
                (name: "giant", title: "Giant rabbit", when: [Above("size", 1.18)]),
                (name: "snow_rabbit", title: "Snow rabbit", when: [Shows("coat", "white")]),
            ],
            movement: (style: Hopper, walk: 2.2, run: 7.0, turn: 420.0, jump: 7.0),
            habitat: (
                biomes: [("tag:grassland", 1.0), ("tag:heath", 0.8), ("tag:tundra", 0.6), ("tag:forest", 0.3), ("tag:scrubland", 0.5)],
                comfort: (temperature: (-16.0, 30.0), moisture: (0.12, 2.0)),
                active: Crepuscular,
            ),
            group: (size: (1, 3)),
            temperament: (fear: 0.9, nervousness: 0.85, curiosity: 0.2, sociability: 0.35, energy: 0.75),
            senses: (sight: 18.0, hearing: 24.0),
            leash: 14.0,
            diet: (eats: ["short_grass", "clover", "dandelion"], favourite: ["carrot", "wild_carrot"]),
            xp: (kill: 4.0, skill: "hunter"),
            taming: (level: 1, xp: 10.0),
            breeding: (level: 1, litter: (1, 3), growth: 8.0, xp: 12.0),
            loot: [
                (item: "raw_small_game"),
