        // --- Forest folk and hunters ---------------------------------------------------------
        (
            // Never attacks first (Mariano, 2026-10-06): common in a few biomes, a little
            // slower than a sprint, so a chase closes. Struck while it is hale it turns and
            // gores back, a short readable jab of the tusks (block it); under 40% of its
            // health it drops the fight and runs (`flees_below`), so a first fight answers
            // and ends in a short chase. Its piglets only run. Old Tusk, the boss, is the one
            // that charges. Being a fighter it lets one come near, watching, and edges off
            // only from one close on it (`Flee` radius 4). Its hide and the gristle over its
            // shoulders turn many blows and shots (defence 9), but a spear's point goes in
            // under them (weak to Stab: the boar spear), so a boar that charges the shooter
            // is no quicker game for a bow than for a spear (engine/tests/nomad_hunting.rs;
            // combat lane, Oct 20).
            name: "wild_boar", level: 4, health: 10, flees_below: 0.4, weak: Some(Stab),
            attack: (windup: 0.55, recovery: 0.6, damage: (1, 2), reach: 0.9, every: 1.6, lunge: 1.0, style: Stab),
            defence: 9,
            body: (
                size: (0.8, 0.85),
                model: Quadruped(body: (0.6, 0.55, 0.92), head: (0.38, 0.38, 0.42), legs: 0.3, ears: (0.1, 0.12), ear_lean: 30.0, horns: (0.05, 0.12), horn_shape: Tusks, snout: (0.22, 0.16, 0.16), hump: 0.2, tail: (0.05, 0.05, 0.22), tail_droop: 60.0),
                colours: [(82, 62, 46), (112, 90, 70), (226, 214, 190)],
                skin: (fur: 0.18, belly: 0.2, feet: (36, 28, 24), markings: [Dorsal(colour: (46, 34, 28), width: 0.16), Muzzle(colour: (120, 96, 84))]),
            ),
            movement: (style: Lumberer, walk: 1.3, run: 5.1, turn: 220.0, jump: 7.5),
            habitat: (
                biomes: [("tag:forest", 1.0), ("tag:broadleaf", 1.0), ("tag:scrubland", 0.7), ("tag:conifer", 0.5), ("tag:grassland", 0.35)],
                comfort: (temperature: (-12.0, 32.0), moisture: (0.3, 2.4)),
            ),
            group: (size: (1, 4)),
            temperament: (aggression: 0.0, fear: 0.65, nervousness: 0.45, curiosity: 0.45, sociability: 0.6, territory: 0.1, energy: 0.6),
