// Multiblocks (engine/src/multiblock.rs): structures recognised from a pattern of blocks.
// Layers go from the bottom up; in each, rows run north to south and characters west to
// east, and the pattern counts turned any of four ways. `key` says what a character takes
// (an item, `tag:TAG`, or `a|b`), `.` anything and a space only air. `core` is the block
// a player right clicks to light it (tagged `multiblock_core`); `hint` is what they are
// told when it does not stand yet, and `home` makes it their home, where they wake.
// `fuels` are charges one of which lights it, each at least the `heat` it asks (machines.ron's
// fuel heat). One `lit_by` an item tagged so in hand uses nothing up; one that `smoulder`s
// chars its `wood` cells for `hours` of game time into `done` (`early` if it was opened
// first, `spoiled` for the share of the burn rain fell on its open core), its core
// `burning` meanwhile and `spent` after, or its `stages` from a share of the burn on, so it
// is seen catching and dying down (engine/src/multiblock.rs, server smoulder.rs).
(
    multiblocks: [
        // The Homestead Hearth, the Nomad age's gate: a hearthstone in a ring of stone, a
        // chimney two blocks tall at one corner. Lit, it is your home: you wake there.
        (
            // Lit, its firelight keeps wolves, bears and badgers back 16 blocks at night.
            name: "homestead_hearth", title: "Homestead Hearth", home: true, ward: 16.0,
            hint: "The hearth needs a ring of stone around the hearthstone and a chimney two blocks tall at one corner.",
            layers: [
                ["sss", "sHs", "sss"],
                ["C..", "...", "..."],
                ["C..", "...", "..."],
            ],
            key: {'s': "tag:stone", 'H': "hearthstone", 'C': "chimney"},
            core: 'H',
        ),
        // The Crucible Kiln, the Farm age's gate: a crucible ringed with straw-tempered kiln
        // bricks (plain ones crack in its heat, so the field's straw is part of it), with a
        // brick pillar on each corner to hold the heat. Lit, it smelts copper and tin and
        // makes bronze (cooking.ron's `crucible` station), and the Bronze age opens.
        (
            name: "crucible_kiln", title: "Crucible Kiln", ward: 10.0,
            // Progression design's two implemented fuel routes; burn times are shared
            // with machines.ron. Hold the whole stack and light the standing core.
            fuels: [("charcoal", 32), ("coal_ore", 24)], heat: 3,
            hint: "The kiln needs tempered kiln bricks all round the crucible and a pillar of them on each corner. Tempered bricks take straw from a grain harvest.",
            layers: [
                ["kkk", "kCk", "kkk"],
                ["k.k", "...", "k.k"],
            ],
            key: {'k': "tempered_kiln_bricks", 'C': "crucible"},
            core: 'C',
        ),
        // A charcoal clamp: nine firewood laid three by three, walled and roofed with earth,
        // kindling in place of the roof's middle earth for a flue. Lit there from a torch, a
        // firebrand or a campfire carried (`firelighter`), it smoulders
        // two game hours, nobody by it, and leaves charcoal where the firewood was (four a
        // heap: thirty-six, a kiln's charge). Opened early the wood is part-burnt; rain on the
        // open flue spoils to ash the share of the burn it fell for, so roof it over.
        (
            name: "charcoal_clamp", title: "Charcoal Clamp",
            hint: "A clamp is nine firewood laid three by three on the ground, walled round and roofed over with earth, with kindling in place of the roof's middle earth for a flue. Light the kindling from a torch, a firebrand or a campfire.",
            lit_by: Some("firelighter"),
            smoulder: Some((hours: 2.0, wood: 'F', done: "charcoal_heap", early: "charred_wood_heap", spoiled: "ash_heap", burning: "clamp_flue", spent: "core:air",
                // Its flue catching for the first tenth of the burn, steady, then dying down
                // for the last sixth: a clamp near done is seen from afar.
                stages: [(0.0, "clamp_flue_catching"), (0.1, "clamp_flue"), (0.85, "clamp_flue_dying")])),
            layers: [
                ["sssss", "sFFFs", "sFFFs", "sFFFs", "sssss"],
                [".....", ".sss.", ".sKs.", ".sss.", "....."],
            ],
            key: {'F': "firewood", 's': "tag:soil", 'K': "kindling|clamp_flue|clamp_flue_catching|clamp_flue_dying"},
            core: 'K',
        ),
    ],
)
