// Machines built as structures (multiblocks.ron says how a pattern reads). The core is a
// machine (machines.ron) that works only while its structure stands; right click it to
// put in and take out, and to be told what the structure still needs.
(
    multiblocks: [
        // The Bellows Bloomery, the Bronze age's gate: a bloomery at the foot of a hollow
        // shaft of kiln bricks three high, with bellows in its ring (turned by a water
        // wheel, windmill or treadwheel through shafts). Its first iron bloom opens the
        // Iron age.
        (
            name: "bellows_bloomery", title: "Bellows Bloomery",
            hint: "The bloomery needs kiln bricks round it with bellows in the ring, and a hollow shaft of kiln bricks two more blocks high above it.",
            layers: [
                ["kkk", "kBb", "kkk"],
                ["kkk", "k k", "kkk"],
                ["kkk", "k k", "kkk"],
            ],
            key: {'k': "kiln_bricks", 'B': "bloomery", 'b': "bellows"},
            core: 'B',
        ),
    ],
)
