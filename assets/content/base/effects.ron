// What food does besides filling you (engine/src/effect.rs; the vocabulary is explained in
// core/effects.ron). Each rule in `foods` gives its effect for so many seconds to anything
// eaten that has all of its tags; eating it again tops the time back up. A food may also
// name its own with an `effect:NAME:SECONDS` tag. Good food is worth cooking: raw meat
// turns your stomach, and the best buffs come from what is hardest to get.
(
    effects: [
        (name: "hearty", kind: Buff, icon: "hearty", title: "Hearty", description: "Cooked meat: room for a tenth more health while it lasts.",
            modifiers: (max_health_share: 1.1)),
        (name: "hunters_vigour", kind: Buff, title: "Hunter's vigour", description: "Game cooked over a fire: quicker on your feet.",
            modifiers: (speed: 1.1)),
        (name: "heartwood", kind: Buff, title: "Heartwood", description: "The Rootmother's heartroot: room for a fifth more health, and you heal a quarter faster.",
            modifiers: (max_health_share: 1.2, heal: 1.25)),
        (name: "sustained", kind: Buff, title: "Sustained", description: "Bread and roots: you heal by yourself a quarter faster.",
            modifiers: (heal: 1.25)),
        (name: "refreshed", kind: Buff, title: "Refreshed", description: "Fresh fruit: a spring in your step.",
            modifiers: (speed: 1.06)),
        (name: "focused", kind: Buff, title: "Focused", description: "A good breakfast: every skill learns a tenth more.",
            modifiers: (xp: 1.1)),
        (name: "soothed", kind: Buff, title: "Soothed", description: "Milk: heal half as fast again.",
            modifiers: (heal: 1.5)),
        (name: "ember_warmed", kind: Buff, title: "Ember-warmed", description: "Emberfruit glows inside you: 10° warmer.",
            modifiers: (warmth: 10.0)),
        (name: "cooled", kind: Buff, title: "Cooled", description: "Something cooling: 8° cooler in the heat.",
            modifiers: (warmth: -8.0)),
        (name: "warm_meal", kind: Buff, title: "Warm meal", description: "A hot stew from the pot: 4° warmer, and you heal a tenth faster.",
            modifiers: (heal: 1.1, warmth: 4.0)),
        (name: "queasy", kind: Debuff, title: "Queasy", description: "Raw meat: slower to heal and a little slower going. Cook it.",
            modifiers: (heal: 0.5, speed: 0.95)),
        // Smoke that clings (bees.ron's `smoky`): a torch in hand, or a fire close by,
        // leaves it on the player, and it lingers half a minute after, so a torch held a
        // moment and put away still calms bees while the skep is taken up. A fire within
        // the bees' own smoke_reach calms them anyway, so the player's needs to be close.
        (name: "smoky", kind: Buff, title: "Smoky", description: "Smoke clings to you: bees take you for a fire and stay calm.",
            when: Some(Any([Holding("fire"), Near("fire", 2)])), lingers: 30.0),
        // A charm worn (the charm slot): Old Tusk's charge charm quickens your stride.
        (name: "tusk_stride", kind: Buff, title: "Tusk Stride", description: "Old Tusk's charm hangs at your neck: you move 5% faster.",
            when: Some(Wearing("charge_charm")), modifiers: (speed: 1.05)),
        // Sat by a fire or the hearth (`core:sit` on a seat): a Nomad's stool at the campfire
        // or a chair at home, the rest after a day out.
        (name: "fireside", kind: Buff, title: "Fireside", description: "Sat by a fire: you heal half as fast again, and it warms you.",
            when: Some(All([Seated, Any([Near("fire", 3), Near("hearth", 3)])])), modifiers: (heal: 1.5, warmth: 4.0)),
        // Sat at a table: a meal eaten there does more (as a pantry's and a larder's do).
        (name: "at_table", kind: Buff, title: "At the Table", description: "Sat at a table: a meal heals a quarter more, and its good lasts a quarter longer.",
            when: Some(All([Seated, Near("table", 2)])), modifiers: (meal_heal: 1.25, meal_time: 1.25)),
        // Sat by a window with a bookshelf to hand: a reading nook, the quiet corner of a
        // lived-in home (no home needed: a shelf and a window by a seat make the nook).
        (name: "reading_nook", kind: Buff, title: "Reading Nook", description: "Sat by a window with books to hand: you learn a tenth more.",
            when: Some(All([Seated, Near("books", 2), Near("window", 3)])), modifiers: (xp: 1.1)),
        // Sat with a footstool before the seat: feet up after a day on them. On the footstool
        // itself is no feet up (it is a seat too, and would be near itself).
        (name: "feet_up", kind: Buff, title: "Feet Up", description: "Sat with your feet on a footstool: you heal a quarter faster.",
            when: Some(All([Seated, Not(SeatedOn("footstool")), Near("footstool", 1)])), modifiers: (heal: 1.25)),
        // Taking from bees without smoke (bees.ron).
        (name: "stung", kind: Debuff, title: "Stung", description: "Bee stings: slower to heal for a while. Smoke them calm first.",
            modifiers: (heal: 0.75)),
        // Where you stand (InBiome: a biome tag or name). Each place gives a reason to go
        // there, or to leave: the water for fishing, the woods to heal.
        (name: "waterside", kind: Buff, title: "Waterside", description: "By the sea, a river or a marsh: casts land a fifth more often.",
            when: Some(Any([InBiome("ocean"), InBiome("river"), InBiome("wetland")])), modifiers: (fishing: 1.2)),
        (name: "forest_calm", kind: Buff, title: "Forest calm", description: "Among the trees you heal a fifth faster.",
            when: Some(InBiome("forest")), modifiers: (heal: 1.2)),
        (name: "rich_rock", kind: Buff, title: "Rich rock", description: "Mountain rock splits cleanly: you mine a tenth faster.",
            when: Some(InBiome("mountain")), modifiers: (mining: 1.1)),
        (name: "aether_touched", kind: Buff, title: "Aether-touched", description: "The aether hums here: every skill learns a twentieth more.",
            when: Some(InBiome("fantastical")), modifiers: (xp: 1.05)),
        (name: "keen_edge", kind: Buff, title: "Keen edge", description: "A travelling smith whetted your tools: they bite a tenth faster.",
            modifiers: (mining: 1.1)),
        (name: "mired", kind: Debuff, title: "Mired", description: "Soft wet ground: a little slower going.",
            when: Some(InBiome("wetland")), modifiers: (speed: 0.93)),

        // Home (engine/src/effect.rs, "Home is a condition too"). A player's home is the lit hearth,
        // else the bed they last slept in; these effects hold while they stand within its reach
        // (survival.ron's home_reach) and it has the furnishings each asks for, counted by block tag.
        // Each step asks for everything the one below does and replaces it, so the player always
        // sees the highest they have reached, and is told when they first reach one. Hearthside is
        // the lit Homestead Hearth, the Nomad age's end; Snug wants it roofed over; the Farm age
        // furnishes the rest, and each step up wants better walls about the room the home stands
        // in (`HomeWalls`, the share of its walls and roof at a shelter or better: blocks
        // tagged draughty, sound or fine): Snug walled in with anything, Homely mostly sound,
        // Cosy sound nearly all about, the Heart half fine; each is warmer for it. What each tag is: bed (sleeping bag, beds), light (torches, candles,
        // lanterns), hearth (the hearthstone), seat, table, storage, rug, curtain, cushion,
        // crockery, books (bookshelves), cooking (stove, cauldron), workshop (loom, spindle, quern),
        // banner. A step reached counts for quests as `Built("home_NAME", 1)`.
        (name: "camp", kind: Buff, title: "Camp", description: "Your own bed and light: you heal a fifth faster here.", announce: true,
            next: "Next: build a Homestead Hearth near your bed and light it.",
            when: Some(All([AtHome, HomeHas("bed", 1), HomeHas("light", 1)])),
            replaces: [], modifiers: (heal: 1.2)),
        (name: "hearthside", kind: Buff, title: "Hearthside", description: "Your hearth keeps the cold off: you heal a third faster here.", announce: true,
            next: "Next: wall it in and roof it over, even with hide or wattle, with your bed and two lights, to be snug.",
            when: Some(All([AtHome, HomeHas("hearth", 1)])),
            replaces: ["camp"], modifiers: (heal: 1.33, home_warmth: 4.0)),
        (name: "snug", kind: Buff, title: "Snug", description: "Walled in and roofed over: you heal half as fast again here.", announce: true,
            next: "Next: sound walls (logs, planks or stone) for most of the room, two seats, a table, two places to store things and a third light make it homely.",
            when: Some(All([AtHome, Indoors, HomeWalls(Draughty, 0.9), HomeHas("hearth", 1), HomeHas("bed", 1), HomeHas("light", 2)])),
            replaces: ["camp", "hearthside"], modifiers: (heal: 1.5, home_warmth: 6.0)),
        (name: "homely", kind: Buff, title: "Homely", description: "Sound walls, and room to sit, work and store: 2° warmer, and you learn a twentieth more here, and your stores here hold twice as much.", announce: true,
            next: "Next: sound walls nearly all about, two rugs, two curtains, a cushion, three pieces of crockery and a fourth light make it cosy.",
            when: Some(All([AtHome, Indoors, HomeWalls(Draughty, 0.9), HomeWalls(Sound, 0.6), HomeHas("hearth", 1), HomeHas("bed", 1), HomeHas("light", 3), HomeHas("seat", 2), HomeHas("table", 1), HomeHas("storage", 2)])),
            replaces: ["camp", "hearthside", "snug"], modifiers: (heal: 1.5, home_warmth: 8.0, xp: 1.05, store_room: 2.0)),
        (name: "cosy", kind: Buff, title: "Cosy", description: "Soft, bright and close walled: 3° warmer, you heal faster and learn a tenth more here, and your stores here hold twice as much.", announce: true,
            next: "Next: fine walls (dressed stone, brick or glass) for half the room, a bookshelf, a stove or cauldron, a loom, spindle or quern, and a banner make it the heart of the home.",
            when: Some(All([AtHome, Indoors, HomeWalls(Sound, 0.9), HomeHas("hearth", 1), HomeHas("bed", 1), HomeHas("light", 4), HomeHas("seat", 2), HomeHas("table", 1), HomeHas("storage", 2), HomeHas("rug", 2), HomeHas("curtain", 2), HomeHas("cushion", 1), HomeHas("crockery", 3)])),
            replaces: ["camp", "hearthside", "snug", "homely"], modifiers: (heal: 1.75, home_warmth: 9.0, xp: 1.1, store_room: 2.0)),
        (name: "heart_of_the_home", kind: Buff, title: "Heart of the Home", description: "Everything a home needs, finely walled: 4° warmer, heal twice as fast, learn an eighth more, and your stores here hold three times as much.", announce: true,
            when: Some(All([AtHome, Indoors, HomeWalls(Fine, 0.5), HomeWalls(Sound, 0.9), HomeHas("hearth", 1), HomeHas("bed", 1), HomeHas("light", 4), HomeHas("seat", 2), HomeHas("table", 1), HomeHas("storage", 2), HomeHas("rug", 2), HomeHas("curtain", 2), HomeHas("cushion", 1), HomeHas("crockery", 3), HomeHas("books", 1), HomeHas("cooking", 1), HomeHas("workshop", 1), HomeHas("banner", 1)])),
            replaces: ["camp", "hearthside", "snug", "homely", "cosy"], modifiers: (heal: 2.0, home_warmth: 10.0, xp: 1.125, store_room: 3.0)),
        // Rooms: side branches of the ladder, each a different use of a home. A workbench and a
        // workshop lift crafting and building levels (`boosts`, which recipes' level checks
        // count; a recipe marked firm ignores them); a pantry and a larder make more of meals.
        // The first step of each is a Nomad-age thing to do with the camp, the next a Farm-age one.
        (name: "workbench", kind: Buff, title: "Workbench", description: "A bench to work at: you craft and build as if a level higher here.", announce: true,
            next: "Next: a loom, spindle stand or quern, a light, and two places to store things under a roof make it a workshop.",
            when: Some(All([AtHome, HomeHas("crafting_table", 1), HomeHas("seat", 1), HomeHas("light", 1)])),
            replaces: [], boosts: [("crafting", 1), ("construction", 1)]),
        (name: "workshop", kind: Buff, title: "Workshop", description: "Everything to hand: you craft and build as if two levels higher here.", announce: true,
            when: Some(All([AtHome, Indoors, HomeHas("crafting_table", 1), HomeHas("seat", 1), HomeHas("light", 2), HomeHas("workshop", 1), HomeHas("storage", 2)])),
            replaces: ["workbench"], boosts: [("crafting", 2), ("construction", 2), ("engineering", 1)]),
        (name: "pantry", kind: Buff, title: "Pantry", description: "A full pantry by the fire: the good a meal does lasts a quarter longer.", announce: true,
            next: "Next: four places to store things, a stove or cauldron and a table under a roof make it a larder.",
            when: Some(All([AtHome, HomeHas("storage", 2), Any([HomeHas("hearth", 1), HomeHas("heat", 1)])])),
            replaces: [], modifiers: (meal_time: 1.25)),
        (name: "larder", kind: Buff, title: "Larder", description: "Meals heal a fifth more here and their good lasts half again as long.", announce: true,
            when: Some(All([AtHome, Indoors, HomeHas("storage", 4), HomeHas("cooking", 1), HomeHas("table", 1), Any([HomeHas("hearth", 1), HomeHas("heat", 1)])])),
            replaces: ["pantry"], modifiers: (meal_heal: 1.2, meal_time: 1.5)),
        // Soft furnishings, the Nomad's to the Farm age's: a rug underfoot and cloth hung on a
        // wall (`drape`: a wall hanging) under the home's roof keep the draught off the floor
        // and the walls.
        (name: "soft_furnishings", kind: Buff, title: "Soft furnishings", description: "A rug underfoot and cloth hung on the wall keep the draught off: 1° warmer here.", announce: true,
            when: Some(All([AtHome, Indoors, HomeHas("rug", 1), HomeHas("drape", 1)])),
            replaces: [], modifiers: (home_warmth: 1.0)),
        // A corner by the bed, a Nomad's first comfort before any roof: a seat and two lights
        // beside it keep the night warmer, and sleeping there is a better rest (the sleeps
        // rules below). A herb nook, the Farm age's: bunches drying overhead and a jar or crate
        // to keep them in, for a kitchen garden at the door and a brew at the bench.
        (name: "bedside", kind: Buff, title: "Bedside", description: "A seat and two lights by your bed: 2° warmer here, and a night's sleep is well rested.", announce: true,
            when: Some(All([AtHome, HomeHas("bed", 1), HomeHas("seat", 1), HomeHas("light", 2)])),
            replaces: [], modifiers: (home_warmth: 2.0)),
        (name: "herb_nook", kind: Buff, title: "Herb nook", description: "Herbs drying overhead: you farm and brew as if a level higher here, and a meal's good lasts a tenth longer.", announce: true,
            when: Some(All([AtHome, HomeHas("drying", 2), HomeHas("storage", 1)])),
            replaces: [], boosts: [("farming", 1), ("alchemy", 1)], modifiers: (meal_time: 1.1)),
        // A bright room, the Farm age's: two windows (`window`: a hide window, glass, a lattice
        // window or an open shuttered one, any pane a package tags so) in the home's walls under
        // its roof, light to work and rest by.
        (name: "bright_room", kind: Buff, title: "Bright room", description: "Daylight through two windows: you learn a twentieth more here, and heal a twentieth faster.", announce: true,
            when: Some(All([AtHome, Indoors, HomeHas("window", 2)])),
            replaces: [], modifiers: (xp: 1.05, heal: 1.05)),
        // A hearth corner, the Nomad's last comfort before the Farm: the homestead hearth under
        // the home's roof with a settle to sit at it (`settle`) and a woodpile (`woodpile`)
        // to keep it fed.
        (name: "hearth_corner", kind: Buff, title: "Hearth corner", description: "A settle by the hearth and wood stacked to hand: 1° warmer here, and you heal a twentieth faster.", announce: true,
            when: Some(All([AtHome, Indoors, HomeHas("hearth", 1), HomeHas("settle", 1), HomeHas("woodpile", 1)])),
            replaces: [], modifiers: (home_warmth: 1.0, heal: 1.05)),
        // A lived-in hearth, the Farm age's: the hearth under the home's roof with a mantel
        // shelf over it, things set out on it (`mantel_shelf`), and a fireside bench before
        // it (`fireside_bench`), the evening's seat.
        (name: "lived_in_hearth", kind: Buff, title: "Lived-in hearth", description: "A mantel shelf over the hearth and a fireside bench before it: 1° warmer here, and you learn a twentieth more.", announce: true,
            when: Some(All([AtHome, Indoors, HomeHas("hearth", 1), HomeHas("mantel_shelf", 1), HomeHas("fireside_bench", 1)])),
            replaces: [], modifiers: (home_warmth: 1.0, xp: 1.05)),
        // A bedchamber, the Farm age's first: a room to sleep in under the home's roof, the
        // bed with a blanket chest (`blanket_chest`), a washstand (`washstand`) and a rug.
        (name: "bedchamber", kind: Buff, title: "Bedchamber", description: "A bed, a blanket chest at its foot, a washstand and a rug under one roof: 1° warmer here, and you heal a tenth faster.", announce: true,
            when: Some(All([AtHome, Indoors, HomeHas("bed", 1), HomeHas("blanket_chest", 1), HomeHas("washstand", 1), HomeHas("rug", 1)])),
            replaces: [], modifiers: (home_warmth: 1.0, heal: 1.1)),
        // A kitchen, the Farm age's: the kitchen wall by the hearth under the home's roof, a
        // dresser with its plates on show (`dresser`) and a pot crane to swing the pot over
        // the fire (`pot_crane`). Meals here do a little more; all the meal effects together
        // stay under survival's meal_most.
        (name: "kitchen", kind: Buff, title: "Kitchen", description: "A dresser and a pot crane by the hearth: 1° warmer here, and meals heal a twentieth more.", announce: true,
            when: Some(All([AtHome, Indoors, HomeHas("hearth", 1), HomeHas("dresser", 1), HomeHas("pot_crane", 1)])),
            replaces: [], modifiers: (home_warmth: 1.0, meal_heal: 1.05)),
        // A bee garden, the Farm age's: a skep with bees in it among flowers at home
        // (bees.ron). Its bees make the crops about it grow a quarter faster, which the
        // apiary does; the home itself heals a tenth faster and is sweeter to come back to.
        (name: "bee_garden", kind: Buff, title: "Bee garden", description: "Bees at work among your flowers: you heal a tenth faster here, and crops near the hive grow a quarter faster.", announce: true,
            when: Some(All([AtHome, HomeHas("hive", 1), HomeHas("flower", 3)])),
            replaces: [], modifiers: (heal: 1.1)),
        // A dooryard, the Farm age's: an awning over the door and two things set out under the
        // sky about it (`yard`: a bench, bunting, a hay bale), counted only where they stand
        // in the open (`outdoors` below). Out in the yard, not under the roof, the home is a
        // place to sit a while.
        (name: "dooryard", kind: Buff, title: "Dooryard", description: "An awning at your door, a bench, bunting or bales out in the open about it: in the yard you heal a twentieth faster.", announce: true,
            when: Some(All([AtHome, Not(Indoors), HomeHas("awning", 1), HomeHas("yard", 2)])),
            replaces: [], modifiers: (heal: 1.05)),
        // Reactions: a home answers what is around it. A roof and a fire in a storm, animals
        // kept in the yard (`kept` counts those within reach) and crops growing by the door
        // each give something, with no code of their own.
        (name: "sheltered", kind: Buff, title: "Sheltered", description: "Warm and dry while it storms: you heal a fifth faster, learn a bit more.",
            when: Some(All([AtHome, Indoors, Sheltered(Any([Rain(0.3), Snow(0.3), Hail(0.2), Dust(0.3), Storm(0.1)])), Any([HomeHas("hearth", 1), HomeHas("heat", 1)])])),
            replaces: [], modifiers: (heal: 1.2, xp: 1.05)),
        (name: "company", kind: Buff, title: "Company", description: "Your animals about the house: you heal a tenth faster here.", announce: true,
            next: "Next: four animals kept about the house make it a full house.",
            when: Some(All([AtHome, HomeHas("kept", 1)])),
            replaces: [], modifiers: (heal: 1.1)),
        (name: "full_house", kind: Buff, title: "Full house", description: "A yard full of animals: you heal a fifth faster, learn a bit more here.", announce: true,
            when: Some(All([AtHome, HomeHas("kept", 4)])),
            replaces: ["company"], modifiers: (heal: 1.2, xp: 1.05)),
        // A door shut on the night (`door_shut`, a shut door's tag): indoors at home behind
        // it, the draughts and the dark stay out.
        (name: "door_shut", kind: Buff, title: "Door shut", description: "The door shut on the night: you heal a tenth faster here, and are 1° warmer.", announce: true,
            when: Some(All([AtHome, Indoors, HomeHas("door_shut", 1)])),
            replaces: [], modifiers: (heal: 1.1, home_warmth: 1.0)),
        // An evening in: after dark (`Night`), indoors at home within a few blocks of a
        // fire to sit by (`campfire`: a campfire, the hearth, the stove; a torch is no
        // fireside), and that fire the home's own (`HomeHas`), not a neighbour's through a wall. The day's work done, the home is where to be. A time of day, not a step
        // to build toward: `ladder: "night"` keeps it out of `/home`'s steps.
        (name: "evening_in", kind: Buff, title: "Evening in", description: "Home by the fire after dark: you heal a fifth faster here, and are 2° warmer.", announce: true, ladder: "night",
            when: Some(All([Night, AtHome, Indoors, HomeHas("campfire", 1), Near("campfire", 4)])),
            replaces: [], modifiers: (heal: 1.2, home_warmth: 2.0)),
        (name: "kitchen_garden", kind: Buff, title: "Kitchen garden", description: "Greens growing by the door: meals heal a tenth more here.", announce: true,
            when: Some(All([AtHome, HomeHas("crop", 4)])),
            replaces: [], modifiers: (meal_heal: 1.1)),
        // Sleeping at a bed (the sleeps rules below): the better the home around the bed, the
        // better the rest, which lasts a while wherever you go; the better rests are a night's
        // (the sleeps' `night`). While a rest, or a better one, is on, or a sleep's mend still
        // runs, a bed gives no more; a nap's Rested does not keep a night's better rest away.
        // A sleep mends too, for a minute (two in a proper bed): four times the healing of
        // being awake, still slower than eating, since food is the heal (design draft 63).
        (name: "healing_sleep", kind: Buff, title: "Healing Sleep", description: "You slept: your wounds close quickly for a little while.",
            replaces: [], modifiers: (heal: 4.0)),
        (name: "rested", kind: Buff, title: "Rested", description: "You slept: you heal and learn a little more for a while.",
            replaces: [], modifiers: (heal: 1.1, xp: 1.03)),
        (name: "well_rested", kind: Buff, title: "Well rested", description: "A night slept snug, in a proper bed, or with a lit corner by the bed: you learn more and mine faster for a while.",
            replaces: ["rested"], modifiers: (heal: 1.15, xp: 1.05, mining: 1.03)),
        (name: "deep_rest", kind: Buff, title: "Deep rest", description: "A night slept in a cosy home: you heal, learn, mine and walk faster for a while.",
            replaces: ["rested", "well_rested"], modifiers: (heal: 1.25, xp: 1.1, mining: 1.06, speed: 1.03)),

        // Know-how (condition `Done`: a quest the player has finished). What a quest taught
        // stays with them, so finishing the early gathering quests is itself an upgrade,
        // felt at once: `mining` is how fast every tool bites, `finds` the added chance of an
        // extra piece from natural rock and soil. They stack with the tool, the skill, food
        // and the place (Rich rock, Waterside), and the steps of a ladder replace each other.
        // `ladder: "knack"` makes the steps countable by quests (`Built("knack_steady_hands", 1)`).
        (name: "steady_hands", kind: Buff, title: "Steady hands", description: "A stone tool in your fist: every tool bites a tenth faster.", announce: true, ladder: "knack",
            next: "Next: carry a full stone kit (pickaxe, axe, shovel, hoe and knife).",
            when: Some(Done("stone_in_hand")),
            replaces: [], modifiers: (mining: 1.1)),
        (name: "practised_hands", kind: Buff, title: "Practised hands", description: "A whole kit and the habit of it: a fifth faster, and now and then an extra piece turns up.", announce: true, ladder: "knack",
            next: "Next: forge a copper kit (axe, shovel, hoe and knife) from red metal.",
            when: Some(Done("full_stone_kit")),
            replaces: ["steady_hands"], modifiers: (mining: 1.2, finds: 0.03)),
        (name: "copper_hands", kind: Buff, title: "Copper hands", description: "Copper in every grip: nearly a third faster, and extras turn up twice as often.", announce: true, ladder: "knack",
            when: Some(Done("copper_kit")),
            replaces: ["steady_hands", "practised_hands"], modifiers: (mining: 1.3, finds: 0.06)),
        // What was learnt, paired with where it is used.
        (name: "stonewise", kind: Buff, title: "Stonewise", description: "A hand that knows stone reads mountain rock: it splits to give more.",
            when: Some(All([Done("a_pile_of_stone"), InBiome("mountain")])), modifiers: (finds: 0.05)),
        (name: "anglers_knack", kind: Buff, title: "Angler's knack", description: "A supper caught and cooked: you read the water, and casts land a tenth more often.",
            when: Some(Done("a_fish_supper")), modifiers: (fishing: 1.1)),
        (name: "deft_angler", kind: Buff, title: "Deft angler", description: "Patience paid off: casts land a fifth more often.",
            when: Some(Done("patient_angler")), replaces: ["anglers_knack"], modifiers: (fishing: 1.2)),
        (name: "prospector", kind: Buff, title: "Prospector", description: "A good run of ore taught you where it lies: a twentieth faster, and extras turn up more.",
            when: Some(Done("ore_run")), modifiers: (mining: 1.05, finds: 0.04)),
        // What the farm gives the home: fed and settled, you heal better where you live.
        (name: "settled_and_fed", kind: Buff, title: "Settled and fed", description: "Your animals thrive and your table is set: at home you heal a tenth faster.",
            when: Some(All([Done("food_enough"), AtHome])), modifiers: (heal: 1.1)),
        // Home know-how: what a home quest taught, kept at home. Each holds from the quest
        // done, but only where it is used (`AtHome`, and the furnishing it is about), so the
        // home grows more useful with every step of the home line, on top of the ladder's own
        // comfort. `ladder: "homecraft"` keeps them out of `/home`'s steps and countable by
        // quests (`Built("homecraft_banked_fire", 1)`).
        (name: "banked_fire", kind: Buff, title: "Banked fire", description: "A camp taught you to bank a fire: at home with a fire lit, 3° warmer.", announce: true, ladder: "homecraft",
            when: Some(All([Done("make_camp"), AtHome, Any([HomeHas("hearth", 1), HomeHas("heat", 1)])])),
            replaces: [], modifiers: (home_warmth: 3.0)),
        (name: "snowed_in", kind: Buff, title: "Snowed in", description: "Snug for winter: snow or hail outside, you heal and learn more at home.", announce: true, ladder: "homecraft",
            when: Some(All([Done("snug_for_winter"), AtHome, Sheltered(Any([Snow(0.1), Hail(0.1)]))])),
            replaces: [], modifiers: (heal: 1.15, xp: 1.1)),
        (name: "everything_in_its_place", kind: Buff, title: "Everything in its place", description: "A homely home: with room to store things, you build a level higher at home.", announce: true, ladder: "homecraft",
            when: Some(All([Done("a_homely_home"), AtHome, HomeHas("storage", 2)])),
            replaces: [], boosts: [("construction", 1)]),
        (name: "home_cooking", kind: Buff, title: "Home cooking", description: "Stove and quern learnt: meals at home heal a tenth more and last longer.", announce: true, ladder: "homecraft",
            when: Some(All([Done("workshop_and_stove"), AtHome, HomeHas("cooking", 1)])),
            replaces: [], modifiers: (meal_heal: 1.1, meal_time: 1.1)),
        (name: "studious", kind: Buff, title: "Studious", description: "Books on the shelf: indoors at home you learn a twentieth more.", announce: true, ladder: "homecraft",
            when: Some(All([Done("books_and_banners"), AtHome, Indoors, HomeHas("books", 1)])),
            replaces: [], modifiers: (xp: 1.05)),
        (name: "hearthkeeper", kind: Buff, title: "Hearthkeeper", description: "Your own hearth is the best bench: craft and cook as if a level higher at home.", announce: true, ladder: "homecraft",
            when: Some(All([Done("heart_of_the_home"), AtHome])),
            replaces: [], boosts: [("crafting", 1), ("cooking", 1)]),
    ],
    foods: [
        (tags: ["meat", "cooked"], effect: "hearty", seconds: 300),
        (tags: ["meat", "cooked", "game"], effect: "hunters_vigour", seconds: 240),
        (tags: ["baked"], effect: "sustained", seconds: 600),
        (tags: ["root", "cooked"], effect: "sustained", seconds: 420),
        (tags: ["fruit"], effect: "refreshed", seconds: 180),
        (tags: ["berry", "edible"], effect: "refreshed", seconds: 120),
        (tags: ["egg", "cooked"], effect: "focused", seconds: 300),
        (tags: ["dairy"], effect: "soothed", seconds: 120),
        (tags: ["alchemy:warming", "edible"], effect: "ember_warmed", seconds: 300),
        (tags: ["alchemy:cooling", "edible"], effect: "cooled", seconds: 300),
        (tags: ["meat", "raw"], effect: "queasy", seconds: 60),
        (tags: ["stew"], effect: "warm_meal", seconds: 480),
        (tags: ["breakfast"], effect: "focused", seconds: 240),
    ],
    // What sleeping at a bed gives: each rule whose `needs` effect would hold where the player
    // sleeps (none: anywhere) and whose `bed` tag the bed slept in carries (none: any bed; a
    // proper bed is furniture, a sleeping bag is not). A rest lasts this many seconds (a day
    // is 1200), and a rested player cannot sleep again until it wears off.
    // Tags a home counts only under the open sky: a bench or a bale kept indoors is no yard.
    outdoors: ["yard"],
    sleeps: [
        (effect: "healing_sleep", seconds: 60.0),
        (effect: "healing_sleep", seconds: 120.0, bed: "furniture"),
        (effect: "rested", seconds: 600.0),
        // The better rests are a night's (`night`): a nap by day only rests and mends, and
        // does not keep a night's better rest away.
        (effect: "well_rested", seconds: 900.0, bed: "furniture", night: true),
        (effect: "well_rested", seconds: 900.0, needs: "snug", night: true),
        (effect: "well_rested", seconds: 900.0, needs: "bedside", night: true),
        (effect: "deep_rest", seconds: 1200.0, needs: "cosy", night: true),
    ],
)
