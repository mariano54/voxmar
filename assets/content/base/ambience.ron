        // as it waits out the rest (`cooldown`).
        (
            name: "shrine_bell", sound: Bell, volume: 0.28, at: Building(buildings: ["shrine"]), per_minute: 8, cooldown: 240,
            pitch: (0.97, 1.03), reach: 48,
            when: {"settlement_edge": (max: 24, fade: 60), "sun": (min: -0.15, max: 0.15, fade: 0.05), "depth": (max: 2, fade: 4)},
        ),
        // Pigs rooting in the pens, by day.
        (
            name: "pen_grunt", sound: Grunt, volume: 0.24, at: Building(buildings: ["pen", "barn"]), per_minute: 1.5, cooldown: 14,
            pitch: (0.9, 1.15), reach: 10,
            when: {"settlement_edge": (max: 10, fade: 40), "sun": (min: 0.1, fade: 0.15), "depth": (max: 2, fade: 4)},
            duck: {"rain": 0.6},
        ),
        // Sheep in the pens and the barns, by day and into the evening.
        (
            name: "pen_bleat", sound: Bleat, volume: 0.26, at: Building(buildings: ["pen", "barn"]), per_minute: 2.5, cooldown: 8,
            pitch: (0.9, 1.15), reach: 12,
            when: {"settlement_edge": (max: 10, fade: 40), "sun": (min: -0.15, fade: 0.1), "depth": (max: 2, fade: 4)},
            duck: {"rain": 0.8},
        ),
        // Evening: people coming home, doors opening and shutting along the lanes, and
        // supper things knocking in the houses. From dusk until full dark.
        (
            name: "doors", sound: Door, volume: 0.28, at: Building(buildings: ["house", "inn", "trader"], door: true), per_minute: 3, cooldown: 6,
            pitch: (0.92, 1.08), reach: 12,
            when: {"settlement_edge": (max: 6, fade: 30), "sun": (min: -0.25, max: 0.1, fade: 0.08), "depth": (max: 2, fade: 4)},
        ),
        (
            name: "supper", sound: Clatter, volume: 0.2, at: Building(buildings: ["house", "inn"]), per_minute: 2, cooldown: 10,
            pitch: (0.95, 1.1), reach: 8,
            when: {"settlement_edge": (max: 2, fade: 20), "sun": (min: -0.3, max: 0.05, fade: 0.08), "depth": (max: 2, fade: 4)},
        ),
        // Night: the place asleep. Now and then a dog somewhere barks, and an owl calls
        // from the roofs; nothing else.
        (
            name: "night_dog", sound: Bark, volume: 0.26, at: Around(distance: (20, 45), height: (0, 3)), per_minute: 0.8, cooldown: 30,
            pitch: (0.9, 1.1), reach: 16,
            when: {"settlement_edge": (max: 0, fade: 50), "sun": (max: -0.2, fade: 0.1), "depth": (max: 2, fade: 4)},
            duck: {"rain": 0.8},
        ),
        (
            name: "night_owl", sound: Owl, volume: 0.3, at: Around(distance: (25, 45), height: (6, 14)), per_minute: 0.4, cooldown: 60,
            reach: 24,
            when: {"settlement_edge": (max: 0, fade: 50), "sun": (max: -0.25, fade: 0.1), "depth": (max: 2, fade: 4)},
            duck: {"rain": 0.8},
