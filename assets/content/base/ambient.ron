// Ambient particle sets the client shows around the player: a shared pool like trees and
// plants. A biome's atmosphere selects from it by tag or name; by default every set whose
// climate fits shows wherever it fits. `density` is the share of the most particles the
// client shows, where conditions suit the set fully (times its rarity). `time` is Always,
// Day, Night or Twilight; `weather` Always, Dry or Wet; `motion` Drift, Hover, Fall, Rise
// or Blow; `aether` how strongly it follows the aether field (1: only where it is high).
(
    particles: [
        (
            name: "pollen", tags: ["meadow", "temperate"],
            density: 0.25, color: (250, 236, 170), size: 0.06, motion: Drift, time: Day, weather: Dry,
            comfort: (temperature: (10.0, 26.0), moisture: (0.45, 1.5)),
        ),
        (
            name: "fireflies", tags: ["meadow", "forest", "wetland", "warm"], rarity: Uncommon,
            density: 0.35, color: (196, 255, 120), size: 0.08, motion: Hover, glow: true, time: Night, weather: Dry,
            comfort: (temperature: (14.0, 30.0), moisture: (0.8, 2.5)),
        ),
        (
            name: "spores", tags: ["forest", "shade", "damp"],
            density: 0.2, color: (214, 222, 196), size: 0.05, motion: Hover, time: Always,
            comfort: (temperature: (4.0, 30.0), moisture: (1.15, 3.0)),
        ),
        (
            name: "dust", tags: ["dry", "desert"],
            density: 0.3, color: (222, 196, 150), size: 0.07, motion: Blow, time: Day, weather: Dry,
            comfort: (temperature: (12.0, 45.0), moisture: (0.0, 0.35)),
        ),
        (
            name: "drifting_snow", tags: ["cold", "snow"],
            density: 0.3, color: (244, 248, 255), size: 0.08, motion: Fall,
            comfort: (temperature: (-40.0, -3.0)),
        ),
        (
            name: "marsh_mist", tags: ["wetland"],
            density: 0.25, color: (226, 232, 230), size: 0.6, motion: Rise, time: Twilight,
            comfort: (temperature: (6.0, 32.0), moisture: (1.3, 3.0)),
        ),
        (
            name: "aether_motes", tags: ["fantastical", "wonder"], rarity: Rare,
            density: 0.5, color: (176, 196, 255), size: 0.07, motion: Drift, glow: true, aether: 1.0,
        ),
    ],
)
