// Tools and what makes them (tools.ron says what each kind is for; recipes.ron how they are
// made). A tool is tagged `tool`, its kind, `tier:N` (what it can mine), `speed:X` (how
// much faster than a hand on what it suits) and `yield:Y` (more and rarer finds there). A
// hoe tills soil into farmland (`base:till`), which is what crops are sown on.
(
    blocks: [
        // The crafting table: a three-by-three grid for what the inventory's two-by-two
        // cannot make (tools, stations). Right click it to work at it. A `furnishing`: a
        // village's gives nothing, one a player placed gives itself back.
        (
            name: "crafting_table", sound: Wood, textures: Sides(top: "crafting_table_top", bottom: "oak_planks", side: "crafting_table_side"),
            hardness: 2.5, color: (150, 110, 70), tags: ["station", "crafting_table", "wood", "fuel", "building", "furnishing"],
        ),
        // The Homestead Hearth's pieces (multiblocks.ron): a hearthstone, ringed with stone
        // and lit with a right click, and a chimney two blocks tall at a corner. The
        // chimney's top smokes over a hearthstone, seen from across a valley: home. Its glow
        // (9) fills a small room warm enough to work by at night.
        (
            name: "hearthstone", sound: Stone, textures: Sides(top: "hearthstone_top", bottom: "cobblestone", side: "hearthstone_side"),
            hardness: 2.0, color: (150, 120, 100), tags: ["hearth", "multiblock_core", "station", "hob", "campfire", "building"], light: 9,
        ),
        (
            name: "chimney", sound: Stone, textures: Sides(top: "chimney_top", bottom: "cobblestone", side: "chimney_side"),
            hardness: 2.0, color: (130, 100, 90), tags: ["chimney", "building", "shelter:fine"],
            particles: [(style: Smoke, rate: 3.0, at: (0.5, 1.0, 0.5), spread: 0.2, size: 1.8, height: Some(7.0), range: Some(96.0), over: Some(("hearth", 3)), color: Some((150, 146, 140)))],
        ),
        // The Farm age's fire (multiblocks.ron): a pit kiln fires clay into pots, vials and
        // bricks; kiln bricks make the crucible, and bricks tempered with straw from the
        // field (they take the heat without cracking) build the Crucible Kiln round it,
        // which smelts copper and tin and alloys them into bronze once the kiln stands.
        (
            name: "pit_kiln", sound: Stone, textures: Sides(top: "pit_kiln_top", bottom: "cobblestone", side: "pit_kiln_side"),
            hardness: 1.5, color: (120, 90, 70), tags: ["pit_kiln", "station", "heat"], light: 8,
        ),
        (
            name: "kiln_bricks", sound: Stone, textures: All("kiln_bricks"),
            hardness: 2.0, color: (160, 90, 60), tags: ["kiln_bricks", "bricks", "building", "shelter:fine"],
        ),
        (
            name: "tempered_kiln_bricks", sound: Stone, textures: All("tempered_kiln_bricks"),
            hardness: 2.0, color: (176, 112, 70), tags: ["kiln_bricks", "tempered", "bricks", "building", "shelter:fine"],
        ),
        (
            name: "crucible", sound: Stone, textures: Sides(top: "crucible_top", bottom: "kiln_bricks", side: "crucible_side"),
            hardness: 2.0, color: (150, 80, 50), tags: ["crucible", "multiblock_core", "station", "heat"], light: 10,
        ),
        // A sleeping bag: sleep in it (right click) and you wake there after dying, until a
        // hearth gives you a home.
        (
            name: "sleeping_bag", render: Plant, model: Rock, plant_height: 1.6, solid: false, sound: Grass, textures: All("sleeping_bag"),
            hardness: 0.3, color: (150, 110, 70), tags: ["bed", "sleeping_bag"],
        ),
        // A stone altar: blocks tagged `altar` restore prayer and take bones for Magic
        // (combat's prayers.ron); settlements set them in chapels and shrines. A
        // `furnishing` drops itself only where a player placed it: a village's gives nothing
        // (design draft 80).
        (
            name: "stone_altar", sound: Stone, textures: Sides(top: "stone_altar_top", bottom: "stone_bricks", side: "stone_altar_side"),
            hardness: 2.0, color: (130, 130, 135), tags: ["altar", "building", "furnishing"],
        ),
        // A herb planter: herbs and flowers placed in it grow back when picked (regrowth.ron),
        // for a gardener whose Farming level is enough for them. Herbs cannot be sown. A
        // `furnishing`, as villages set them too.
        (
            name: "herb_planter", sound: Wood, textures: Sides(top: "herb_planter_top", bottom: "oak_planks", side: "herb_planter_side"),
            hardness: 1.5, color: (120, 85, 55), tags: ["planter", "wood", "building", "furnishing"],
        ),
        // Farmland: soil a hoe has turned, where crops are sown.
        (
            name: "farmland", sound: Soil, textures: Sides(top: "farmland", bottom: "dirt", side: "dirt"),
            hardness: 0.6, drops: "dirt", color: (100, 70, 45), tags: ["creative_only", "soil", "fertile", "tilled"],
        ),
        // Flint lying loose on the ground (decorations.ron's `loose_flint`), picked
        // up by hand: with gravel's, the flint of a new player's first tools.
        (name: "loose_flint", render: Plant, model: Rock, solid: false, sound: Stone, textures: All("loose_flint"), hardness: 0.0, drops: "flint", color: (60, 60, 66), tags: ["creative_only", "loose", "natural"]),
    ],
    families: [
        // Flint: tier 1 as wood is, but made from bare hands: flint (gravel gives it one time in
        // eight) hafted on sticks (leaves give them), in the hand's grid. Stone and trees need
        // a pickaxe and an axe (tools.ron), so these come first; the cheapest of tier 1, they
        // are the tools a refusal names (`Content::least_tool`).
        (template: "drop", name: "flint_pickaxe", tags: ["pickaxe", "tool", "tier:1", "speed:2"], all: (color: (70, 72, 80))),
        (template: "drop", name: "flint_axe", tags: ["axe", "tool", "tier:1", "speed:2"], all: (color: (70, 72, 80))),
        // A flint knife (a flake on a stick) and a digging stick: the hunter's and the
        // digger's first tools, hand-made as the axe is. There are no wooden tools: a plank's
        // edge cuts nothing (older saves' come back as `renamed` says).
        (template: "drop", name: "flint_knife", tags: ["knife", "tool", "tier:1", "speed:2"], all: (color: (70, 72, 80))),
        (template: "drop", name: "digging_stick", tags: ["shovel", "tool", "tier:1", "speed:2"], all: (color: (150, 110, 70))),
        // Stone: tier 2.
        // A stone head: toolstone ground to an edge at a grindstone (recipes.ron), what every
        // stone tool is hafted from.
        (template: "drop", name: "stone_head", tags: ["tool_head"], all: (color: (120, 120, 125))),
        (template: "drop", name: "stone_pickaxe", tags: ["pickaxe", "tool", "tier:2", "speed:4", "yield:0.05"], all: (color: (120, 120, 125))),
        (template: "drop", name: "stone_axe", tags: ["axe", "tool", "tier:2", "speed:4", "yield:0.05"], all: (color: (120, 120, 125))),
        (template: "drop", name: "stone_shovel", tags: ["shovel", "tool", "tier:2", "speed:4", "yield:0.05"], all: (color: (120, 120, 125))),
        (template: "drop", name: "stone_hoe", tags: ["hoe", "tool", "tier:2", "speed:4", "yield:0.05", "reap:1"], all: (color: (120, 120, 125), action: Some("base:till"))),
        (template: "drop", name: "stone_knife", tags: ["knife", "tool", "tier:2", "speed:4", "yield:0.05"], all: (color: (120, 120, 125))),
        // Copper: tier 3.
        (template: "drop", name: "copper_pickaxe", tags: ["pickaxe", "tool", "tier:3", "speed:7", "yield:0.1"], all: (color: (190, 110, 70))),
        (template: "drop", name: "copper_axe", tags: ["axe", "tool", "tier:3", "speed:7", "yield:0.1"], all: (color: (190, 110, 70))),
        (template: "drop", name: "copper_shovel", tags: ["shovel", "tool", "tier:3", "speed:7", "yield:0.1"], all: (color: (190, 110, 70))),
        (template: "drop", name: "copper_hoe", tags: ["hoe", "tool", "tier:3", "speed:7", "yield:0.1", "reap:1"], all: (color: (190, 110, 70), action: Some("base:till"))),
        (template: "drop", name: "copper_knife", tags: ["knife", "tool", "tier:3", "speed:7", "yield:0.1"], all: (color: (190, 110, 70))),
        // Iron: tier 4.
        (template: "drop", name: "iron_pickaxe", tags: ["pickaxe", "tool", "tier:4", "speed:14", "yield:0.15"], all: (color: (200, 205, 215))),
        (template: "drop", name: "iron_axe", tags: ["axe", "tool", "tier:4", "speed:14", "yield:0.15"], all: (color: (200, 205, 215))),
        (template: "drop", name: "iron_shovel", tags: ["shovel", "tool", "tier:4", "speed:14", "yield:0.15"], all: (color: (200, 205, 215))),
        (template: "drop", name: "iron_hoe", tags: ["hoe", "tool", "tier:4", "speed:14", "yield:0.15", "reap:2"], all: (color: (200, 205, 215), action: Some("base:till"))),
        (template: "drop", name: "iron_knife", tags: ["knife", "tool", "tier:4", "speed:14", "yield:0.15"], all: (color: (200, 205, 215))),
        // Fishing rods (fishing.ron): a better rod lands more and rarer fish.
        (template: "drop", name: "fishing_rod", tags: ["rod", "tool", "tier:1"], all: (color: (130, 95, 55), action: Some("base:fish"))),
        (template: "drop", name: "fine_rod", tags: ["rod", "tool", "tier:3", "yield:0.15"], all: (color: (200, 205, 215), action: Some("base:fish"))),
        // Materials.
        (template: "drop", name: "stick", tags: ["stick", "wood", "fuel"], all: (color: (130, 95, 55))),
        // Charcoal: a log burnt at a campfire (cooking.ron), fuel and torches.
        // Pouches: one slot for many herbs, or many seeds (right click one to empty it).
        (template: "drop", name: "herb_pouch", tags: ["pouch", "holds:herb", "holds_each:1000"], all: (color: (120, 150, 80), action: Some("base:empty_pouch"))),
        (template: "drop", name: "coin_purse", tags: ["pouch", "holds:currency", "holds_each:1000"], all: (color: (140, 100, 60), action: Some("base:empty_pouch"))),
        (template: "drop", name: "seed_pouch", tags: ["pouch", "holds:seed", "holds_each:1000"], all: (color: (170, 140, 90), action: Some("base:empty_pouch"))),
        // Worn or carried when you die, it keeps a fourth item and holds the rest for an hour.
        (template: "drop", name: "grave_ward_amulet", tags: ["amulet", "grave_ward"], all: (color: (110, 80, 180), rarity: VeryRare)),
        // Pottery and metal for the Farm age: clay fired in a pit kiln, and bronze.
        (template: "drop", name: "clay_pot", tags: ["pot", "container"], all: (color: (180, 100, 60))),
        (template: "drop", name: "vial", tags: ["vial", "container"], all: (color: (190, 120, 80))),
        (template: "drop", name: "fired_clay", tags: ["fired_clay", "brick"], all: (color: (170, 90, 60))),
        // Gold coins: what shops pay and charge (prices.ron, Settlements). Never placed.
        (template: "drop", name: "gold_coin", tags: ["currency", "coin"], all: (color: (230, 190, 60))),
        // Flint: one gravel in eight breaks to it (tools.ron); arrowheads and spear points.
        (template: "drop", name: "flint", tags: ["flint", "sharp"], all: (color: (60, 60, 66))),
        (template: "drop", name: "bronze_ingot", tags: ["ingot", "metal:bronze"], all: (color: (200, 140, 70))),
        (template: "drop", name: "charcoal", tags: ["charcoal", "coal", "fuel"], all: (color: (40, 36, 34))),
        (template: "drop", name: "twine", tags: ["twine", "fibre"], all: (color: (210, 190, 140))),
        // Straw: the stalks a ripe grain crop leaves when it is cut, one or two a sown plant and
        // one a wild tuft (crops.ron). It tempers kiln bricks for the Crucible Kiln, thatches
        // (fibre) and twists into twine, and nine bind into a hay bale.
        (template: "drop", name: "straw", tags: ["straw", "fibre"], all: (color: (220, 196, 110))),
        (template: "drop", name: "copper_ingot", tags: ["ingot", "metal:copper"], all: (color: (190, 110, 70))),
        (template: "drop", name: "iron_ingot", tags: ["ingot", "metal:iron"], all: (color: (200, 205, 215))),
        // For taming and breeding: a treat no wild animal you can tame refuses, and taken
        // twice as gladly as its own food; feed that readies any kept animal to breed.
        (template: "drop", name: "taming_treat", tags: ["taming_treat", "trust:2"], all: (color: (200, 140, 80))),
        (template: "drop", name: "seed_mix", tags: ["breeding_feed"], all: (color: (170, 140, 70))),
    ],
    // Bronze is made in one step at the crucible now; a blend an older save holds comes
    // back as the bronze it would have smelted into (Oct 14).
    renamed: {
        "bronze_blend": "bronze_ingot",
        // The wooden tools, gone (Oct 15): each comes back as the tool that does its work
        // now. Flint for the pickaxe, axe and knife; the digging stick for the shovel; and,
        // as no hoe is made below stone, the stone hoe.
        "wooden_pickaxe": "flint_pickaxe",
        "wooden_axe": "flint_axe",
        "wooden_knife": "flint_knife",
        "wooden_shovel": "digging_stick",
        "wooden_hoe": "stone_hoe",
    },
)
