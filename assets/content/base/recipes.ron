// Recipes for the crafting grid (engine/src/craft.rs): the inventory's two by two, or a
// crafting table's three by three (right click one) for anything bigger.
//
// A recipe is a `pattern` (up to three rows of three item names, "" for an empty cell; it
// matches wherever it fits in the grid; `tag:TAG` takes anything with the tag, `a|b` either) or `ingredients` (in any arrangement), and makes
// `count` of `output`. A name with {name} in it makes one recipe for every name that fits
// all of the recipe's blocks, so one line serves every wood. Each trains a `skill`
// (Crafting unless it says; Engineering for tools, stations and machines), may need a
// `level` in it, and gives `xp` for every one made.
// A recipe with an `age` (the next age's stations: the pit kiln, the cooking pot...) is
// refused until the player has done that age's rite, the quest that `opens` it.
(
    recipes: [
        // Every log splits into four planks of its wood; two planks make four sticks.
        (ingredients: ["{name}_log"], output: "{name}_planks", count: 4, xp: 1.0),
        // Split on a chopping block, a log gives two more (blocks_workshop.ron): a log end
        // with a flint wedge in it.
        (ingredients: ["{name}_log"], output: "{name}_planks", count: 6, xp: 1.0, near: "chopping_block"),
        (pattern: [["flint"], ["tag:log"]], output: "chopping_block", skill: "core:crafting", level: 2, xp: 6.0),
        // Kindling: three sticks bundled, a clamp's flue (multiblocks.ron).
        (ingredients: ["stick", "stick", "stick"], output: "kindling", xp: 1.0),
        (pattern: [["{name}_planks"], ["{name}_planks"]], output: "stick", count: 4, xp: 1.0),
        // Four planks make a crafting table, for the bigger recipes.
        (pattern: [["{name}_planks", "{name}_planks"], ["{name}_planks", "{name}_planks"]], output: "crafting_table", skill: "core:engineering", xp: 8.0),
        // The Homestead Hearth's pieces: eight cobbles dressed into a hearthstone, and cobbles
        // and clay for each block of chimney. Home's fixtures train Construction from level 1
        // (design draft 100: the altar at 5 was its only source, so it never left level 1).
        (pattern: [["tag:cobbled", "tag:cobbled", "tag:cobbled"], ["tag:cobbled", "", "tag:cobbled"], ["tag:cobbled", "tag:cobbled", "tag:cobbled"]], output: "hearthstone", skill: "core:construction", level: 1, xp: 8.0),
        (pattern: [["tag:cobbled", "clay", "tag:cobbled"], ["tag:cobbled", "", "tag:cobbled"], ["tag:cobbled", "clay", "tag:cobbled"]], output: "chimney", skill: "core:construction", level: 1, xp: 10.0),
        // The Farm age's fire: a pit kiln (cobbles round a campfire), clay shaped for it, and
        // kiln bricks from what it fires; a crucible at their heart. Bronze is three
        // copper to one tin, smelted in the Crucible Kiln.
        (pattern: [["tag:cobbled", "", "tag:cobbled"], ["tag:cobbled", "campfire", "tag:cobbled"]], output: "pit_kiln", age: "farm", skill: "core:construction", level: 1, xp: 15.0),
        (pattern: [["fired_clay", "", "fired_clay"], ["fired_clay", "fired_clay", "fired_clay"]], output: "clay_pot", count: 2, level: 2, xp: 12.0),
        (pattern: [["fired_clay"], ["fired_clay"]], output: "vial", count: 3, level: 4, xp: 8.0),
        (ingredients: ["fired_clay", "fired_clay", "fired_clay", "fired_clay"], output: "kiln_bricks", count: 2, level: 5, xp: 12.0),
        // Straw in the clay keeps a brick whole in the Crucible Kiln's heat: the field's
        // straw is what the kiln is built of. The same two for four as plain bricks.
        (ingredients: ["fired_clay", "fired_clay", "fired_clay", "fired_clay", "straw"], output: "tempered_kiln_bricks", count: 2, level: 5, xp: 14.0),
        (pattern: [["kiln_bricks", "", "kiln_bricks"], ["kiln_bricks", "clay_pot", "kiln_bricks"], ["kiln_bricks", "kiln_bricks", "kiln_bricks"]], output: "crucible", age: "farm", skill: "core:engineering", level: 10, xp: 40.0),
        // A sleeping bag three ways: wool and hide, pelts, or feathers and hide, which takes a
        // raw hide off the first night's hunt as well as a cured one.
        (pattern: [["wool", "wool", "wool"], ["hide", "hide", ""]], output: "sleeping_bag", level: 5, xp: 30.0),
        (pattern: [["tag:fur", "tag:fur"], ["tag:fur", "tag:fur"]], output: "sleeping_bag", level: 5, xp: 30.0),
        (pattern: [["feather", "feather"], ["raw_hide|hide", "raw_hide|hide"]], output: "sleeping_bag", level: 1, xp: 30.0),
        // A herb planter: a box of soil herbs grow back in.
        (pattern: [["{name}_planks", "dirt", "{name}_planks"], ["{name}_planks", "{name}_planks", "{name}_planks"]], output: "herb_planter", age: "farm", skill: "core:construction", level: 3, xp: 10.0),
        // Ore smelted with coal or charcoal, by hand for now (a furnace comes later).
        (pattern: [["copper_ore"], ["coal_ore|charcoal"]], output: "copper_ingot", skill: "core:engineering", level: 5, xp: 6.0),
        (pattern: [["iron_ore"], ["coal_ore|charcoal"]], output: "iron_ingot", skill: "core:engineering", level: 15, xp: 12.0),
        // Flint tools (tier 1), Engineering 1, in the hand's grid: what bare hands make first,
        // since breaking stone or felling a tree needs a pickaxe or an axe (tools.ron). Flint
        // from gravel, sticks from leaves; a knife is a flake on a stick, a digging stick two
        // sticks end to end.
        (pattern: [["flint", "flint"], ["stick", "stick"]], output: "flint_pickaxe", skill: "core:engineering", level: 1, xp: 4),
        (pattern: [["flint", "flint"], ["stick", ""]], output: "flint_axe", skill: "core:engineering", level: 1, xp: 4),
        (pattern: [["flint"], ["stick"]], output: "flint_knife", skill: "core:engineering", level: 1, xp: 4),
        (pattern: [["stick"], ["stick"]], output: "digging_stick", skill: "core:engineering", level: 1, xp: 2),
        // Stone tools (tier 2), Engineering 1, hafted from stone heads: toolstone (hard rock,
        // blocks.ron) ground at a grindstone, a wheel of cobble dressed with sand on two sticks.
        // Soft stone will not take an edge, so a player finds the hard rock first.
        (pattern: [["sand", "tag:cobbled"], ["stick", "stick"]], output: "grindstone", skill: "core:crafting", level: 1, xp: 6),
        (ingredients: ["tag:toolstone"], output: "stone_head", near: "grindstone", skill: "core:crafting", level: 1, xp: 2),
        (pattern: [["stone_head", "stone_head", "stone_head"], ["", "stick", ""], ["", "stick", ""]], output: "stone_pickaxe", skill: "core:engineering", level: 1, xp: 6),
        (pattern: [["stone_head", "stone_head"], ["stone_head", "stick"], ["", "stick"]], output: "stone_axe", skill: "core:engineering", level: 1, xp: 6),
        (pattern: [["stone_head"], ["stick"], ["stick"]], output: "stone_shovel", skill: "core:engineering", level: 1, xp: 6),
        (pattern: [["stone_head", "stone_head"], ["", "stick"], ["", "stick"]], output: "stone_hoe", skill: "core:engineering", level: 1, xp: 6),
        (pattern: [["stone_head"], ["stick"]], output: "stone_knife", skill: "core:engineering", level: 1, xp: 6),
        // Copper tools (tier 3), Engineering 5.
        (pattern: [["copper_ingot", "copper_ingot", "copper_ingot"], ["", "stick", ""], ["", "stick", ""]], output: "copper_pickaxe", skill: "core:engineering", level: 5, xp: 16),
        (pattern: [["copper_ingot", "copper_ingot"], ["copper_ingot", "stick"], ["", "stick"]], output: "copper_axe", skill: "core:engineering", level: 5, xp: 16),
        (pattern: [["copper_ingot"], ["stick"], ["stick"]], output: "copper_shovel", skill: "core:engineering", level: 5, xp: 16),
        (pattern: [["copper_ingot", "copper_ingot"], ["", "stick"], ["", "stick"]], output: "copper_hoe", skill: "core:engineering", level: 5, xp: 16),
        (pattern: [["copper_ingot"], ["stick"]], output: "copper_knife", skill: "core:engineering", level: 5, xp: 16),
        // Bronze tools (tier 3, twice copper's life and faster), Engineering 12: the first
        // thing the Crucible Kiln's bronze is for.
        (pattern: [["bronze_ingot", "bronze_ingot", "bronze_ingot"], ["", "stick", ""], ["", "stick", ""]], output: "bronze_pickaxe", skill: "core:engineering", level: 12, xp: 24),
        (pattern: [["bronze_ingot", "bronze_ingot"], ["bronze_ingot", "stick"], ["", "stick"]], output: "bronze_axe", skill: "core:engineering", level: 12, xp: 24),
        (pattern: [["bronze_ingot"], ["stick"], ["stick"]], output: "bronze_shovel", skill: "core:engineering", level: 12, xp: 24),
        (pattern: [["bronze_ingot", "bronze_ingot"], ["", "stick"], ["", "stick"]], output: "bronze_hoe", skill: "core:engineering", level: 12, xp: 24),
        (pattern: [["bronze_ingot"], ["stick"]], output: "bronze_knife", skill: "core:engineering", level: 12, xp: 24),
        // Iron tools (tier 4), Engineering 15.
        (pattern: [["iron_ingot", "iron_ingot", "iron_ingot"], ["", "stick", ""], ["", "stick", ""]], output: "iron_pickaxe", skill: "core:engineering", level: 15, xp: 32),
        (pattern: [["iron_ingot", "iron_ingot"], ["iron_ingot", "stick"], ["", "stick"]], output: "iron_axe", skill: "core:engineering", level: 15, xp: 32),
        (pattern: [["iron_ingot"], ["stick"], ["stick"]], output: "iron_shovel", skill: "core:engineering", level: 15, xp: 32),
        (pattern: [["iron_ingot", "iron_ingot"], ["", "stick"], ["", "stick"]], output: "iron_hoe", skill: "core:engineering", level: 15, xp: 32),
        (pattern: [["iron_ingot"], ["stick"]], output: "iron_knife", skill: "core:engineering", level: 15, xp: 32),
        // Twine from three stalks of wheat or three of straw; a rod from sticks and twine,
        // at a table. Nine straw bind into a hay bale (broken, it comes apart into the nine).
        (ingredients: ["wheat", "wheat", "wheat"], output: "twine", count: 2, xp: 2.0),
        (ingredients: ["straw", "straw", "straw"], output: "twine", count: 2, xp: 2.0),
        (pattern: [["straw", "straw", "straw"], ["straw", "straw", "straw"], ["straw", "straw", "straw"]], output: "hay_bale", xp: 2.0),
        (pattern: [["", "", "stick"], ["", "stick", "twine"], ["stick", "", "twine"]], output: "fishing_rod", xp: 6.0),
        (pattern: [["", "", "iron_ingot"], ["", "stick", "twine"], ["stick", "", "twine"]], output: "fine_rod", level: 20, xp: 40.0),
        // Pouches from a hide and twine (Crafting 3): seeds stood up, herbs laid flat.
        (pattern: [["twine"], ["hide"]], output: "seed_pouch", level: 3, xp: 12.0),
        (pattern: [["hide", "twine"]], output: "herb_pouch", level: 3, xp: 12.0),
        // A coin purse: a hide drawn shut with two twines (Crafting 1); every player starts
        // with one.
        (ingredients: ["hide", "twine", "twine"], output: "coin_purse", level: 1, xp: 8.0),
        // A stone altar (Construction 5, design's draft 70): pray at it and offer bones (combat's prayers.ron).
        (pattern: [["stone_bricks", "stone_bricks", "stone_bricks"], ["", "stone_bricks", ""], ["stone_bricks", "stone_bricks", "stone_bricks"]], output: "stone_altar", age: "farm", skill: "core:construction", level: 5, xp: 12.0),
        // For taming and breeding: a treat any tameable animal takes, twice as gladly as its
        // own food; seed mix that readies any kept animal to breed.
        (ingredients: ["wheat", "wheat", "apple", "egg"], output: "taming_treat", count: 2, skill: "core:cooking", level: 27, xp: 30.0),
        (ingredients: ["wheat_seeds", "wheat_seeds", "wheat"], output: "seed_mix", count: 2, skill: "core:cooking", level: 8, xp: 6.0),
        // Four of a stone dress into four of its bricks or blocks.
        (pattern: [["stone", "stone"], ["stone", "stone"]], output: "stone_bricks", count: 4, xp: 2.0),
        (pattern: [["sand", "sand"], ["sand", "sand"]], output: "sandstone", xp: 2.0),
        (pattern: [["red_sand", "red_sand"], ["red_sand", "red_sand"]], output: "red_sandstone", xp: 2.0),
        // Moss grows over stonework.
        (ingredients: ["stone_bricks", "moss_block"], output: "mossy_stone_bricks", xp: 3.0),
        // Cobblestone is made: plain stone breaks into loose stones (blocks.ron), and four
        // knock together into two.
        (pattern: [["loose_stone", "loose_stone"], ["loose_stone", "loose_stone"]], output: "cobblestone", count: 2, xp: 1.0),
        (ingredients: ["cobblestone", "moss_block"], output: "mossy_cobblestone", xp: 3.0),
        // Two logs (barked or stripped), or bark-on-all-sides wood blocks, over two
        // cobblestones make a campfire. Removing bark is never a prerequisite.
        (pattern: [["{name}_log", "{name}_log"], ["cobblestone", "cobblestone"]], output: "campfire", skill: "core:engineering", xp: 10.0),
        (pattern: [["{name}_wood", "{name}_wood"], ["cobblestone", "cobblestone"]], output: "campfire", skill: "core:engineering", xp: 10.0),
        // Coal or charcoal on a stick makes four torches, in the hand's grid: light for the
        // first night.
        (pattern: [["coal_ore|charcoal"], ["stick"]], output: "torch", count: 4, skill: "core:engineering", xp: 2.0),
        // A firebrand burnt out in the hand leaves its charred end, enough to tip one torch
        // before there is coal: the light that burns out leads to one that lasts.
        (pattern: [["charred_stick"], ["stick"]], output: "torch", skill: "core:engineering", xp: 1.0),
        // Two stones crossed make shears, for wool; two planks a pail, for milk.
        (pattern: [["cobblestone", ""], ["", "cobblestone"]], output: "shears", skill: "core:engineering", xp: 10.0),
        (pattern: [["{name}_planks", ""], ["", "{name}_planks"]], output: "pail", skill: "core:engineering", xp: 10.0),
        // Two wheat side by side bake into bread, which fills more than the grain.
        (pattern: [["wheat", "wheat"]], output: "bread", skill: "core:cooking", xp: 8.0),
    ],
)
