// Base game blocks.
//
// Texture names refer to `textures/block/<name>` in the texture packs (our default pack in
// assets/packs/default draws them all); `color` is the placeholder used when no pack has
// the texture. `sound` is the material it sounds like (Stone when omitted). Plants are not
// solid, break instantly and need ground beneath; `drops: "core:air"` drops nothing.
//
// `templates` make whole families of blocks: each family below is one line that fills in
// `{name}` (see engine/src/block.rs). `variants` are other looks of a plant: each becomes
// its own block, `<plant>_<variant>`, that drops the plant itself, `size` of them.
// `rarity` (Common, Uncommon, Rare, VeryRare, Legendary) is how rare a block is meant to
// be where it grows naturally.
//
// Tags are the words other systems (biomes, food, alchemy, mods) select blocks by, so
// nothing has to name blocks one by one. Reuse these before inventing new ones:
//
// What it is
//   stone, soil, sand, gravel, clay, terracotta, snow, ice, ore, metal:<name>, gem
//   log, stripped, wood, planks, leaves, sapling, fuel
//   plant, flower, herb, grass, fern, reed, bush, fungus, groundcover
//   natural, cobbled, polished, bricks, building, light (gives light), glass
// Rock: igneous, sedimentary, metamorphic; where it shows: cliff (bare rock faces), cave
//   (cave walls), deep (well below the surface), surface (topsoil or ground cover)
// Soil: fertile, wet, dry, acidic, sandy
// Where a plant grows (often several): meadow, forest_floor, forest_edge, shade, wetland,
//   riverbank, shore, alpine, tundra, heath, steppe, desert, savanna, tropical, cave
// Climate hints: cold, temperate, warm, hot
// Look and timing: autumn, evergreen, night (opens or shines at night), tall
// Trees (on every member of a wood): broadleaf, conifer, tropical, palm
// Uses
//   edible, fruit, berry, grain, root, tea, spice
//   flavour:<sweet|sour|bitter|spicy|savoury|aromatic>
//   alchemy:<property>, with property one of healing, regeneration, warming, cooling,
//     calming, energising, clarity, sleep, night_sight, luminous, poison, antidote,
//     swiftness, strength, water_breathing, fire_resistance, frost_resistance,
//     featherfall, aether
//   dye:<colour> (can be made into that dye), colour:<colour> (is that colour)
//   fibre (cordage and cloth), thorny, glowing
// Colours: white, light_gray, gray, black, brown, red, orange, yellow, lime, green, cyan,
//   light_blue, blue, purple, magenta, pink
// Fantasy: wonder (fantastical; more common where the aether field is high)
(
    templates: {
        // A wood: bark, the stripped log, bark on every side, planks, leaves and a sapling.
        "wood": [
            (name: "{name}_log", sound: Wood, textures: Column(end: "{name}_log_top", side: "{name}_log"), hardness: 2.0, color: (109, 85, 50), tags: ["log", "wood", "fuel", "natural"]),
            (
                name: "stripped_{name}_log", sound: Wood,
                textures: Column(end: "stripped_{name}_log_top", side: "stripped_{name}_log"),
                hardness: 2.0, color: (176, 140, 90), tags: ["log", "stripped", "wood", "fuel"],
            ),
            (name: "{name}_wood", sound: Wood, textures: All("{name}_log"), hardness: 2.0, color: (109, 85, 50), tags: ["wood", "fuel", "building"]),
            (name: "{name}_planks", sound: Wood, textures: All("{name}_planks"), hardness: 2.0, color: (162, 130, 78), tags: ["planks", "wood", "fuel", "building"]),
            (
                name: "{name}_leaves", sound: Leaves, textures: All("{name}_leaves"), render: Leaves, tint: Foliage,
                light_filter: 1, hardness: 0.3, color: (60, 120, 40), tags: ["leaves", "natural"],
            ),
            (
                name: "{name}_sapling", render: Plant, solid: false, sound: Grass, textures: All("{name}_sapling"),
                hardness: 0.0, color: (70, 120, 40), tags: ["sapling", "plant"],
            ),
        ],
        // A rock: as it lies, broken into cobbles (what mining it gives), polished, and
        // cut into bricks.
        "stone": [
            (name: "{name}", textures: All("{name}"), hardness: 1.5, drops: "cobbled_{name}", color: (125, 125, 125), tags: ["stone", "natural"]),
            (name: "cobbled_{name}", textures: All("cobbled_{name}"), hardness: 2.0, color: (110, 110, 110), tags: ["stone", "cobbled", "building"]),
            (name: "polished_{name}", textures: All("polished_{name}"), hardness: 1.5, color: (135, 135, 135), tags: ["stone", "polished", "building"]),
            (name: "{name}_bricks", textures: All("{name}_bricks"), hardness: 1.5, color: (120, 120, 120), tags: ["stone", "bricks", "building"]),
        ],
        // Fired clay in one colour.
        "terracotta": [
            (name: "{name}_terracotta", textures: All("{name}_terracotta"), hardness: 1.25, tags: ["terracotta", "clay", "building", "colour:{name}"]),
        ],
    },
    blocks: [
        // Rock
        (name: "bedrock", textures: All("bedrock"), hardness: -1.0, color: (60, 60, 60), tags: ["deep"]),
        (name: "stone", textures: All("stone"), hardness: 1.5, drops: "cobblestone", color: (125, 125, 125), family: "stone", tags: ["stone", "natural", "igneous", "cliff", "cave"]),
        (name: "cobblestone", textures: All("cobblestone"), hardness: 2.0, color: (110, 110, 110), family: "stone", tags: ["stone", "cobbled", "building"]),
        (name: "mossy_cobblestone", textures: All("mossy_cobblestone"), hardness: 2.0, color: (100, 118, 90), family: "stone", tags: ["stone", "cobbled", "building", "natural"]),
        // Soil
        (name: "dirt", sound: Soil, textures: All("dirt"), hardness: 0.5, color: (134, 96, 67), tags: ["soil", "fertile", "natural"]),
        (name: "coarse_dirt", sound: Soil, textures: All("coarse_dirt"), hardness: 0.5, color: (119, 85, 59), tags: ["soil", "dry", "natural", "surface"]),
        (name: "rooted_dirt", sound: Soil, textures: All("rooted_dirt"), hardness: 0.5, color: (144, 104, 77), tags: ["soil", "natural"]),
        (name: "mud", sound: Soil, textures: All("mud"), hardness: 0.5, color: (60, 57, 61), tags: ["soil", "wet", "natural", "surface"]),
        (name: "moss_block", sound: Grass, textures: All("moss_block"), hardness: 0.1, color: (89, 110, 45), tags: ["soil", "wet", "groundcover", "natural", "surface"]),
        (
            name: "podzol", sound: Soil,
            textures: Sides(top: "podzol_top", bottom: "dirt", side: "podzol_side"),
            hardness: 0.5,
            drops: "dirt",
            color: (91, 63, 24),
            tags: ["soil", "acidic", "natural", "surface"],
        ),
        (
            name: "grass_block", sound: Grass,
            textures: Sides(top: "grass_block_top", bottom: "dirt", side: "grass_block_side"),
            tint: Grass,
            tint_top_only: true,
            hardness: 0.6,
            drops: "dirt",
            color: (100, 160, 70),
            tags: ["soil", "fertile", "natural", "surface"],
        ),
        (name: "clay", sound: Soil, textures: All("clay"), hardness: 0.6, color: (160, 166, 179), tags: ["clay", "wet", "natural"]),
        (name: "gravel", sound: Gravel, textures: All("gravel"), hardness: 0.6, color: (136, 126, 126), tags: ["gravel", "natural", "surface"]),
        // Snow and ice
        (
            name: "snowy_grass_block", sound: Snow,
            textures: Sides(top: "snow", bottom: "dirt", side: "grass_block_snow"),
            hardness: 0.6,
            drops: "dirt",
            color: (240, 245, 250),
            tags: ["soil", "snow", "cold", "natural", "surface"],
        ),
        (name: "snow_block", sound: Snow, textures: All("snow"), hardness: 0.2, color: (240, 245, 250), tags: ["snow", "cold", "natural", "surface"]),
        (name: "powder_snow", sound: Snow, textures: All("powder_snow"), hardness: 0.25, color: (248, 253, 253), tags: ["snow", "cold", "natural", "surface"]),
        (name: "ice", sound: Glass, textures: All("ice"), render: Translucent, light_filter: 2, hardness: 0.5, color: (150, 190, 250), tags: ["ice", "cold", "natural"]),
        (name: "packed_ice", sound: Glass, textures: All("packed_ice"), hardness: 0.5, color: (141, 180, 250), tags: ["ice", "cold", "natural"]),
        (name: "blue_ice", sound: Glass, textures: All("blue_ice"), hardness: 2.8, color: (116, 167, 253), tags: ["ice", "cold", "natural"]),
        // Sand
        (name: "sand", sound: Sand, textures: All("sand"), hardness: 0.5, color: (219, 207, 163), tags: ["sand", "natural", "surface"]),
        (name: "red_sand", sound: Sand, textures: All("red_sand"), hardness: 0.5, color: (190, 102, 33), tags: ["sand", "natural", "surface"]),
        (name: "terracotta", textures: All("terracotta"), hardness: 1.25, color: (152, 94, 67), tags: ["terracotta", "clay", "natural", "building", "colour:brown"]),
        // Fluids. Each also makes its flowing and falling states (`water_flow_1` ..
        // `water_flow_7`, `water_falling`), and water the river states that carry a current
        // (see engine/src/fluid.rs). `tick`: ticks per step of a flow; `drop`: eighths of
        // depth lost per block, so how far it runs; `slope`: how far it looks for a way down;
        // `infinite`: two sources make a third between them; `meets`: what it turns into
        // where it touches another fluid.
        (
            name: "water", sound: Water,
            textures: All("water_still"),
            render: Translucent,
            solid: false,
            tint: Water,
            light_filter: 2,
            hardness: -1.0,
            color: (63, 118, 228),
            fluid: (tick: 5, drop: 1, slope: 4, infinite: true, currents: true),
        ),
        // Glowing and slow. Quenched by water: a source turns to stone (basalt once the
        // stones arrive), flowing lava to cobblestone, and water it pours into to stone.
        (
            name: "lava", sound: Water,
            textures: All("lava_still"),
            solid: false,
            light: 15,
            hardness: -1.0,
            drops: "core:air",
            color: (214, 96, 24),
            tags: ["natural", "light", "hot", "deep"],
            fluid: (
                tick: 30, drop: 2, slope: 2,
                meets: [(fluid: "water", source: "stone", flowing: "cobblestone", below: "stone")],
            ),
        ),
        // Trees without a wood of their own
        (
            name: "mangrove_roots", sound: Wood,
            textures: Sides(top: "mangrove_roots_top", bottom: "mangrove_roots_top", side: "mangrove_roots_side"),
            render: Cutout,
            light_filter: 1,
            hardness: 0.7,
            color: (74, 59, 38),
            tags: ["wood", "natural", "wetland"],
        ),
        (name: "azalea_leaves", sound: Leaves, textures: All("azalea_leaves"), render: Leaves, light_filter: 1, hardness: 0.3, color: (90, 115, 45), tags: ["leaves", "natural", "broadleaf"]),
        (name: "flowering_azalea_leaves", sound: Leaves, textures: All("flowering_azalea_leaves"), render: Leaves, light_filter: 1, hardness: 0.3, color: (110, 110, 70), tags: ["leaves", "natural", "broadleaf", "flower"]),
        (name: "cactus", sound: Wood, textures: Sides(top: "cactus_top", bottom: "cactus_bottom", side: "cactus_side"), hardness: 0.4, color: (80, 130, 40), tags: ["plant", "desert", "hot", "dry", "natural", "thorny"]),
        // Plants
        (name: "short_grass", render: Plant, solid: false, sound: Grass, textures: All("short_grass"), tint: Grass, hardness: 0.0, drops: "core:air", color: (150, 150, 150), tags: ["plant", "grass", "meadow"]),
        (name: "tall_grass", render: Plant, solid: false, sound: Grass, textures: All("tall_grass_bottom"), tint: Grass, hardness: 0.0, drops: "core:air", color: (150, 150, 150), tags: ["plant", "grass", "meadow", "tall"]),
        (name: "tall_grass_top", render: Plant, solid: false, sound: Grass, textures: All("tall_grass_top"), tint: Grass, hardness: 0.0, drops: "core:air", color: (150, 150, 150)),
        (name: "fern", render: Plant, solid: false, sound: Grass, textures: All("fern"), tint: Grass, hardness: 0.0, drops: "core:air", color: (130, 130, 130), tags: ["plant", "fern", "forest_floor", "shade"]),
        (name: "large_fern", render: Plant, solid: false, sound: Grass, textures: All("large_fern_bottom"), tint: Grass, hardness: 0.0, drops: "core:air", color: (130, 130, 130), tags: ["plant", "fern", "forest_floor", "shade", "tall"]),
        (name: "large_fern_top", render: Plant, solid: false, sound: Grass, textures: All("large_fern_top"), tint: Grass, hardness: 0.0, drops: "core:air", color: (130, 130, 130)),
        (name: "dead_bush", render: Plant, solid: false, sound: Grass, textures: All("dead_bush"), hardness: 0.0, drops: "core:air", color: (148, 104, 40), tags: ["plant", "bush", "desert", "dry", "fuel"]),
        (name: "sweet_berry_bush", render: Plant, solid: false, sound: Leaves, textures: All("sweet_berry_bush_stage3"), hardness: 0.0, color: (60, 100, 50), tags: ["plant", "bush", "berry", "edible", "flavour:sweet", "forest_floor", "cold"]),
        (name: "sugar_cane", render: Plant, solid: false, sound: Grass, textures: All("sugar_cane"), tint: Grass, hardness: 0.0, color: (150, 190, 120), tags: ["plant", "reed", "riverbank", "warm", "flavour:sweet", "fibre"]),
        (name: "brown_mushroom", render: Plant, solid: false, sound: Grass, textures: All("brown_mushroom"), hardness: 0.0, color: (150, 110, 80), tags: ["plant", "fungus", "edible", "forest_floor", "shade", "cave", "flavour:savoury"]),
        (name: "red_mushroom", render: Plant, solid: false, sound: Grass, textures: All("red_mushroom"), hardness: 0.0, color: (200, 40, 40), tags: ["plant", "fungus", "forest_floor", "shade", "alchemy:poison", "dye:red"]),
        (name: "dandelion", render: Plant, solid: false, sound: Grass, textures: All("dandelion"), hardness: 0.0, color: (240, 210, 40), tags: ["plant", "flower", "meadow", "temperate", "edible", "flavour:bitter", "dye:yellow", "alchemy:healing"]),
        (name: "poppy", render: Plant, solid: false, sound: Grass, textures: All("poppy"), hardness: 0.0, color: (200, 30, 30), tags: ["plant", "flower", "meadow", "temperate", "dye:red", "alchemy:sleep"]),
        (name: "cornflower", render: Plant, solid: false, sound: Grass, textures: All("cornflower"), hardness: 0.0, color: (70, 100, 220), tags: ["plant", "flower", "meadow", "temperate", "dye:blue", "alchemy:clarity"]),
        (name: "oxeye_daisy", render: Plant, solid: false, sound: Grass, textures: All("oxeye_daisy"), hardness: 0.0, color: (235, 235, 225), tags: ["plant", "flower", "meadow", "temperate", "dye:white", "alchemy:healing"]),
        (name: "azure_bluet", render: Plant, solid: false, sound: Grass, textures: All("azure_bluet"), hardness: 0.0, color: (215, 225, 240), tags: ["plant", "flower", "meadow", "temperate", "dye:light_gray", "alchemy:calming"]),
        (name: "allium", render: Plant, solid: false, sound: Grass, textures: All("allium"), hardness: 0.0, color: (180, 110, 230), tags: ["plant", "flower", "meadow", "cold", "edible", "flavour:savoury", "dye:magenta"]),
        (name: "blue_orchid", render: Plant, solid: false, sound: Grass, textures: All("blue_orchid"), hardness: 0.0, color: (40, 170, 230), rarity: Uncommon, tags: ["plant", "flower", "wetland", "tropical", "warm", "dye:light_blue", "alchemy:water_breathing"]),
        (name: "lily_of_the_valley", render: Plant, solid: false, sound: Grass, textures: All("lily_of_the_valley"), hardness: 0.0, color: (240, 240, 240), tags: ["plant", "flower", "forest_floor", "shade", "cold", "dye:white", "alchemy:poison"]),
        (name: "red_tulip", render: Plant, solid: false, sound: Grass, textures: All("red_tulip"), hardness: 0.0, color: (210, 40, 30), rarity: Uncommon, tags: ["plant", "flower", "meadow", "temperate", "dye:red"]),
        (name: "orange_tulip", render: Plant, solid: false, sound: Grass, textures: All("orange_tulip"), hardness: 0.0, color: (235, 120, 30), rarity: Uncommon, tags: ["plant", "flower", "meadow", "temperate", "dye:orange"]),
        (name: "white_tulip", render: Plant, solid: false, sound: Grass, textures: All("white_tulip"), hardness: 0.0, color: (230, 230, 230), rarity: Uncommon, tags: ["plant", "flower", "meadow", "temperate", "dye:light_gray"]),
        (name: "pink_tulip", render: Plant, solid: false, sound: Grass, textures: All("pink_tulip"), hardness: 0.0, color: (235, 160, 200), rarity: Uncommon, tags: ["plant", "flower", "meadow", "temperate", "dye:pink"]),
        // Ores
        (name: "coal_ore", textures: All("coal_ore"), hardness: 3.0, color: (90, 90, 90), tags: ["ore", "fuel", "natural"]),
        (name: "iron_ore", textures: All("iron_ore"), hardness: 3.0, color: (160, 140, 120), tags: ["ore", "metal:iron", "natural"]),
        (name: "copper_ore", textures: All("copper_ore"), hardness: 3.0, color: (150, 110, 80), tags: ["ore", "metal:copper", "natural"]),
        (name: "gold_ore", textures: All("gold_ore"), hardness: 3.0, color: (200, 180, 80), rarity: Uncommon, tags: ["ore", "metal:gold", "natural"]),
        (name: "diamond_ore", textures: All("diamond_ore"), hardness: 3.0, color: (100, 200, 200), rarity: Rare, tags: ["ore", "gem", "natural", "deep"]),
        // Building
        (name: "glass", sound: Glass, textures: All("glass"), render: Cutout, hardness: 0.3, color: (200, 230, 240), tags: ["glass", "building"]),
        (name: "glowstone", sound: Glass, textures: All("glowstone"), light: 15, hardness: 0.3, color: (250, 210, 120), tags: ["light", "building"]),
        (name: "sea_lantern", sound: Glass, textures: All("sea_lantern"), light: 15, hardness: 0.3, color: (200, 225, 220), tags: ["light", "building"]),
    ],
    families: [
        // Rocks. Deepslate and the sandstones show their layers on top.
        (template: "stone", name: "deepslate", tags: ["metamorphic", "deep", "cave"], members: {"deepslate": (textures: Column(end: "deepslate_top", side: "deepslate"), hardness: 3.0, color: (75, 75, 82))}),
        (template: "stone", name: "granite", tags: ["igneous", "cliff", "cave"], all: (color: (150, 105, 90))),
        (template: "stone", name: "diorite", tags: ["igneous", "cliff", "cave"], all: (color: (190, 190, 190))),
        (template: "stone", name: "andesite", tags: ["igneous", "cliff", "cave"], all: (color: (135, 135, 135))),
        (template: "stone", name: "tuff", tags: ["igneous", "cave", "deep"], all: (color: (108, 109, 102))),
        (template: "stone", name: "calcite", tags: ["sedimentary", "cave"], all: (color: (223, 224, 220), hardness: 0.75)),
        (
            template: "stone", name: "sandstone", tags: ["sedimentary", "cliff", "desert", "sandy"],
            all: (color: (216, 203, 155), hardness: 0.8),
            members: {"sandstone": (textures: Sides(top: "sandstone_top", bottom: "sandstone_bottom", side: "sandstone"), drops: "sandstone")},
        ),
        (
            template: "stone", name: "red_sandstone", tags: ["sedimentary", "cliff", "desert", "sandy"],
            all: (color: (186, 99, 29), hardness: 0.8),
            members: {"red_sandstone": (textures: Sides(top: "red_sandstone_top", bottom: "red_sandstone_bottom", side: "red_sandstone"), drops: "red_sandstone")},
        ),
        // Fired clay, in the colours of mesa bands.
        (template: "terracotta", name: "orange", tags: ["natural"], all: (color: (162, 84, 38))),
        (template: "terracotta", name: "yellow", tags: ["natural"], all: (color: (186, 133, 35))),
        (template: "terracotta", name: "white", tags: ["natural"], all: (color: (210, 178, 161))),
        (template: "terracotta", name: "brown", tags: ["natural"], all: (color: (77, 51, 36))),
        (template: "terracotta", name: "red", tags: ["natural"], all: (color: (143, 61, 47))),
        (template: "terracotta", name: "light_gray", tags: ["natural"], all: (color: (135, 107, 98))),
        // Woods.
        (template: "wood", name: "oak", tags: ["broadleaf", "temperate"]),
        (template: "wood", name: "birch", tags: ["broadleaf", "temperate", "cold"], all: (color: (216, 215, 210)), members: {"birch_leaves": (color: (100, 140, 60))}),
        (template: "wood", name: "spruce", tags: ["conifer", "evergreen", "cold"], all: (color: (58, 37, 16)), members: {"spruce_leaves": (color: (40, 80, 50))}),
        (template: "wood", name: "jungle", tags: ["broadleaf", "tropical", "hot"], all: (color: (85, 67, 25)), members: {"jungle_leaves": (color: (48, 140, 30))}),
        (template: "wood", name: "acacia", tags: ["broadleaf", "savanna", "hot", "dry"], all: (color: (103, 96, 86)), members: {"acacia_leaves": (color: (90, 120, 40))}),
        (template: "wood", name: "dark_oak", tags: ["broadleaf", "temperate", "shade"], all: (color: (60, 46, 26)), members: {"dark_oak_leaves": (color: (50, 100, 30))}),
        (
            template: "wood", name: "cherry", tags: ["broadleaf", "temperate", "flower"],
            all: (color: (54, 33, 44)),
            members: {"cherry_leaves": (tint: Some(None), color: (229, 172, 205), tags: ["dye:pink"])},
        ),
        (template: "wood", name: "mangrove", tags: ["broadleaf", "tropical", "wetland"], all: (color: (102, 48, 42)), members: {"mangrove_leaves": (color: (60, 130, 40))}),
    ],
)
