            textures: Sides(top: "red_sandstone_top", bottom: "red_sandstone_bottom", side: "red_sandstone"),
            hardness: 0.8,
            color: (186, 99, 29),
        ),
        (name: "terracotta", textures: All("terracotta"), hardness: 1.25, color: (152, 94, 67)),
        (name: "orange_terracotta", textures: All("orange_terracotta"), hardness: 1.25, color: (162, 84, 38)),
        (name: "yellow_terracotta", textures: All("yellow_terracotta"), hardness: 1.25, color: (186, 133, 35)),
