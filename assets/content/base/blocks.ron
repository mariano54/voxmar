// Base game blocks.
//
// Texture names refer to `textures/block/<name>` in the texture packs (our default pack in
// assets/packs/default draws them all); `color` is the placeholder used when no pack has
// the texture. `sound` is the material it sounds like when stepped on, placed, mined and
// broken: Stone (when omitted), Wood, Soil, Grass, Sand, Gravel, Snow, Glass, Leaves, Water,
// Mud or Moss. Plants are not solid, break instantly and need ground beneath; `support:
// Above` makes a plant hang from the block above instead, and go with it. `drops:
// "core:air"` drops nothing.
//
// `templates` make whole families of blocks: each family below is one line that fills in
// `{name}` (see engine/src/block.rs). `variants` are other looks of a plant: each becomes
// its own block, `<plant>_<variant>`, that drops the plant itself, `size` of them.
// `rarity` (Common, Uncommon, Rare, VeryRare, Legendary) is how rare a block is meant to
// be where it grows naturally.
//
// Tags are the words other systems (biomes, food, alchemy, mods) select blocks by, so
// nothing has to name blocks one by one. Reuse these before inventing new ones:
//
// What it is
//   stone, soil, sand, gravel, clay, terracotta, snow, ice, ore, metal:<name>, gem
//   log, stripped, wood, planks, leaves, sapling, fuel
//   tree (part of a tree or giant mushroom as it grows: trunk, bark, roots, leaves, cap;
//   a new player never wakes on one)
//   plant, flower, herb, grass, fern, reed, bush, fungus, groundcover
//   natural, cobbled, polished, bricks, building, light (gives light), glass
//   rubble (loose stones broken from rock, knocked together into cobbles)
//   mossy, ruined (weathered building blocks), volcanic, dripstone, stalagmite,
//   stalactite, hanging (grows down from a ceiling)
// Rock: igneous, sedimentary, metamorphic; where it shows: cliff (bare rock faces), cave
//   (cave walls), deep (well below the surface), surface (topsoil or ground cover)
// Soil: fertile, wet, dry, acidic, sandy
// Where a plant grows (often several): meadow, forest_floor, forest_edge, shade, wetland,
//   riverbank, shore, alpine, tundra, heath, steppe, desert, savanna, tropical, cave
// Climate hints: cold, temperate, warm, hot
// Look and timing: autumn, evergreen, night (opens or shines at night), tall
// Trees (on every member of a wood): broadleaf, conifer, tropical, palm
// Uses
//   edible, fruit, berry, grain, root, tea, spice, vegetable, pulse, nut, vine,
//   forage (a wild plant worth gathering)
//   flavour:<sweet|sour|bitter|spicy|savoury|aromatic>
//   alchemy:<property>, with property one of healing, regeneration, warming, cooling,
//     calming, energising, clarity, sleep, night_sight, luminous, poison, antidote,
//     swiftness, strength, water_breathing, fire_resistance, frost_resistance,
//     featherfall, aether
//   dye:<colour> (can be made into that dye), colour:<colour> (is that colour)
//   furniture, decor (placed for looks: furniture, cloth, crockery; see blocks_furnishings.ron), seat,
//   table, bed, shelf, cupboard, storage, cloth, rug, banner, curtain, lantern, crockery, grave
//   fibre (cordage and cloth), thorny, glowing
// Colours: white, light_gray, gray, black, brown, red, orange, yellow, lime, green, cyan,
//   light_blue, blue, purple, magenta, pink
// Fantasy: wonder (fantastical; more common where the aether field is high), supernatural
//   (a plant tied to a creature or dish: docs/systems-web.md)
// Creatures and buffs: feed:<creature> (what it eats or is lured by), bait, taming,
//   nectar (bees), salt, drinking_water (kept animals drink from it: water, a well, a trough),
//   waters (waters crops and stations as water does: a well); alchemy also: night_sight,
//   quiet_steps, mutation, hearty, invisibility, steady_hand, cleansing
(
    templates: {
        // A wood: bark, the stripped log, bark on every side, planks, leaves and a sapling.
        "wood": [
            (name: "{name}_log", sound: Wood, textures: Column(end: "{name}_log_top", side: "{name}_log"), hardness: 2.0, color: (109, 85, 50), tags: ["log", "wood", "fuel", "natural", "tree", "shelter:sound"]),
            (
                name: "stripped_{name}_log", sound: Wood,
                textures: Column(end: "stripped_{name}_log_top", side: "stripped_{name}_log"),
                hardness: 2.0, color: (176, 140, 90), tags: ["log", "stripped", "wood", "fuel", "shelter:sound"],
            ),
            (name: "{name}_wood", sound: Wood, textures: All("{name}_log"), hardness: 2.0, color: (109, 85, 50), tags: ["wood", "fuel", "building", "tree", "shelter:sound"]),
            (name: "{name}_planks", sound: Wood, textures: All("{name}_planks"), hardness: 2.0, color: (162, 130, 78), tags: ["planks", "wood", "fuel", "building", "shelter:sound"]),
            (
                name: "{name}_slab", render: Model, shape: "slab", flips: true, sound: Wood, textures: All("{name}_planks"),
                hardness: 2.0, color: (162, 130, 78), tags: ["slab", "wood", "fuel", "building", "shelter:sound"],
            ),
            (
                name: "{name}_stairs", render: Model, shape: "stairs", facing: true, flips: true, sound: Wood, textures: All("{name}_planks"),
                hardness: 2.0, color: (162, 130, 78), tags: ["stairs", "wood", "fuel", "building", "shelter:sound"],
            ),
            (
                name: "{name}_leaves", sound: Leaves, textures: All("{name}_leaves"), render: Leaves, tint: Foliage,
                light_filter: 1, hardness: 0.3, color: (60, 120, 40), tags: ["leaves", "natural", "tree"],
            ),
            (
                name: "{name}_sapling", render: Plant, solid: false, sound: Grass, textures: All("{name}_sapling"),
                hardness: 0.0, color: (70, 120, 40), tags: ["sapling", "plant"],
            ),
        ],
        // A rock: as it lies, broken into cobbles (what mining it gives), polished, and
        // cut into bricks.
        "stone": [
            (name: "{name}", texture_variety: (turn: true, mirror: true), textures: All("{name}"), hardness: 1.5, drops: "cobbled_{name}", color: (125, 125, 125), tags: ["stone", "natural", "shelter:sound"]),
            (name: "cobbled_{name}", textures: All("cobbled_{name}"), hardness: 2.0, color: (110, 110, 110), tags: ["stone", "cobbled", "building", "shelter:sound"]),
            (name: "polished_{name}", textures: All("polished_{name}"), hardness: 1.5, color: (135, 135, 135), tags: ["stone", "polished", "building", "shelter:fine"]),
            (name: "{name}_bricks", textures: All("{name}_bricks"), hardness: 1.5, color: (120, 120, 120), tags: ["stone", "bricks", "building", "shelter:fine"]),
            (name: "mossy_cobbled_{name}", textures: All("mossy_cobbled_{name}"), hardness: 2.0, drops: "cobbled_{name}", color: (100, 118, 90), tags: ["stone", "cobbled", "building", "mossy", "wet", "shelter:sound"]),
            (name: "cracked_{name}_bricks", textures: All("cracked_{name}_bricks"), hardness: 1.5, color: (115, 115, 115), tags: ["stone", "bricks", "building", "ruined", "shelter:sound"]),
        ],
        // A flower or herb, with two more looks: a pair of blooms and a clump of three,
        // which give that many when picked.
        "flower": [
            (
                name: "{name}", render: Plant, solid: false, sound: Grass, textures: All("{name}"), hardness: 0.0,
                color: (200, 120, 160), tags: ["plant"],
                variants: [(name: "pair", textures: All("{name}_pair"), size: 2, rarity: Uncommon), (name: "clump", textures: All("{name}_clump"), size: 3, rarity: Rare)],
            ),
        ],
        // A single plant with one look: bushes, grasses, reeds, ferns, wonders.
        "plant": [
            (name: "{name}", render: Plant, solid: false, sound: Grass, textures: All("{name}"), hardness: 0.0, color: (90, 140, 60), tags: ["plant"]),
        ],
        // A crop (see crops.ron): three growing stages and the ripe plant, which wild ones
        // are, then its seeds and what it yields, both only ever items. A stage broken
        // before it is ripe gives its seed back; what a ripe one gives is in crops.ron.
        "crop": [
            (name: "{name}_crop_0", render: Plant, solid: false, sound: Grass, textures: All("{name}_crop0"), hardness: 0.0, drops: "{name}_seeds", color: (90, 150, 60), tags: ["plant", "crop"]),
            (name: "{name}_crop_1", render: Plant, solid: false, sound: Grass, textures: All("{name}_crop1"), hardness: 0.0, drops: "{name}_seeds", color: (90, 150, 60), tags: ["plant", "crop"]),
            (name: "{name}_crop_2", render: Plant, solid: false, sound: Grass, textures: All("{name}_crop2"), hardness: 0.0, drops: "{name}_seeds", color: (90, 150, 60), tags: ["plant", "crop"]),
            (name: "{name}_crop", render: Plant, solid: false, sound: Grass, textures: All("{name}_crop3"), hardness: 0.0, drops: "{name}_seeds", color: (90, 150, 60), tags: ["plant", "crop", "ripe"]),
            (name: "{name}_seeds", render: Plant, solid: false, item: true, action: "base:plant", textures: All("{name}_seeds"), hardness: 0.0, color: (190, 170, 110), tags: ["seed"]),
            (name: "{name}", render: Plant, solid: false, item: true, textures: All("{name}"), hardness: 0.0, color: (200, 80, 50), tags: ["produce"]),
        ],
        // A crop grown from what it yields (carrots, potatoes): no seeds of its own.
        "root_crop": [
            (name: "{name}_crop_0", render: Plant, solid: false, sound: Grass, textures: All("{name}_crop0"), hardness: 0.0, drops: "{name}", color: (90, 150, 60), tags: ["plant", "crop"]),
            (name: "{name}_crop_1", render: Plant, solid: false, sound: Grass, textures: All("{name}_crop1"), hardness: 0.0, drops: "{name}", color: (90, 150, 60), tags: ["plant", "crop"]),
            (name: "{name}_crop_2", render: Plant, solid: false, sound: Grass, textures: All("{name}_crop2"), hardness: 0.0, drops: "{name}", color: (90, 150, 60), tags: ["plant", "crop"]),
            (name: "{name}_crop", render: Plant, solid: false, sound: Grass, textures: All("{name}_crop3"), hardness: 0.0, drops: "{name}", color: (90, 150, 60), tags: ["plant", "crop", "ripe"]),
            (name: "{name}", render: Plant, solid: false, item: true, action: "base:plant", textures: All("{name}"), hardness: 0.0, color: (200, 120, 50), tags: ["produce", "root"]),
        ],
        // Fruit on a tree: leaves that bear it, bare, in blossom, unripe and ripe (what trees
        // grow with), then the fruit itself. Each is a leaf block like its tree's (same
        // tint, shading and wind), its fruit drawn over the leaves untinted; picking a ripe
        // one takes it back to bare to fruit again (crops.ron).
        "fruit_leaves": [
            (name: "{name}_leaves_0", render: Leaves, tint: Foliage, sound: Leaves, textures: All("{name}_leaves_0"), light_filter: 1, hardness: 0.3, drops: "core:air", color: (60, 120, 40), tags: ["leaves", "natural", "fruit_leaves", "tree"]),
            (name: "{name}_leaves_1", render: Leaves, tint: Foliage, sound: Leaves, textures: All("{name}_leaves_1"), light_filter: 1, hardness: 0.3, drops: "core:air", color: (60, 120, 40), tags: ["leaves", "natural", "fruit_leaves", "tree"]),
            (name: "{name}_leaves_2", render: Leaves, tint: Foliage, sound: Leaves, textures: All("{name}_leaves_2"), light_filter: 1, hardness: 0.3, drops: "core:air", color: (60, 120, 40), tags: ["leaves", "natural", "fruit_leaves", "tree"]),
            (name: "{name}_leaves", render: Leaves, tint: Foliage, sound: Leaves, textures: All("{name}_leaves"), light_filter: 1, hardness: 0.3, drops: "core:air", color: (60, 120, 40), tags: ["leaves", "natural", "fruit_leaves", "ripe", "tree"]),
            (name: "{name}", render: Plant, solid: false, item: true, textures: All("{name}"), hardness: 0.0, color: (200, 60, 40), tags: ["produce", "fruit", "edible"]),
        ],
        // Fired clay in one colour.
        "terracotta": [
            (name: "{name}_terracotta", texture_variety: (turn: true, mirror: true), textures: All("{name}_terracotta"), hardness: 1.25, tags: ["terracotta", "clay", "building", "colour:{name}", "shelter:fine"]),
        ],
    },
    blocks: [
        // Rock
        (name: "bedrock", texture_variety: (turn: true, mirror: true), textures: All("bedrock"), hardness: -1.0, color: (60, 60, 60), tags: ["deep"]),
        (name: "stone", texture_variety: (turn: true, mirror: true), textures: All("stone"), hardness: 1.5, drops: "loose_stone", drop_count: 2, color: (125, 125, 125), family: "stone", tags: ["stone", "natural", "igneous", "cliff", "cave", "shelter:sound"]),
        // A lair's room (lairs.ron): living root that no tool cuts, and the floor boss music
        // knows the room by (music.ron's `boss.rooms`).
        (name: "hollow_root", sound: Wood, textures: All("hollow_root"), hardness: -1.0, color: (78, 58, 42), tags: ["root", "lair"]),
        (name: "hollow_floor", sound: Soil, textures: All("hollow_floor"), hardness: -1.0, color: (66, 50, 38), tags: ["lair"]),
        (name: "cobblestone", textures: All("cobblestone"), hardness: 2.0, color: (110, 110, 110), family: "stone", tags: ["stone", "cobbled", "building", "shelter:sound"]),
        // Loose stones: what plain stone breaks into, two a block, knocked four at a time into
        // two cobblestone in the hand's grid (recipes.ron). Hard rock breaks to its own cobbles,
        // which the grindstone wants whole.
        (name: "loose_stone", render: Plant, solid: false, item: true, sound: Stone, textures: All("loose_stone"), hardness: 0.0, color: (125, 125, 125), tags: ["rubble"]),
        (name: "mossy_cobblestone", textures: All("mossy_cobblestone"), hardness: 2.0, color: (100, 118, 90), family: "stone", tags: ["stone", "cobbled", "building", "mossy", "wet", "shelter:sound"]),
        (name: "polished_stone", textures: All("polished_stone"), hardness: 1.5, color: (135, 135, 135), family: "stone", tags: ["stone", "polished", "building", "shelter:fine"]),
        (name: "stone_bricks", textures: All("stone_bricks"), hardness: 1.5, color: (120, 120, 120), family: "stone", tags: ["stone", "bricks", "building", "shelter:fine"]),
        (name: "mossy_stone_bricks", textures: All("mossy_stone_bricks"), hardness: 1.5, color: (105, 118, 95), family: "stone", tags: ["stone", "bricks", "building", "mossy", "wet", "shelter:sound"]),
        (name: "cracked_stone_bricks", textures: All("cracked_stone_bricks"), hardness: 1.5, color: (115, 115, 115), family: "stone", tags: ["stone", "bricks", "building", "ruined", "shelter:sound"]),
        // Volcanic glass, where lava meets water.
        (name: "obsidian", texture_variety: (turn: true, mirror: true), sound: Glass, textures: All("obsidian"), hardness: 25.0, color: (24, 18, 36), tags: ["stone", "igneous", "natural", "building", "volcanic", "deep", "shelter:fine"]),
        // Soil
        (name: "dirt", texture_variety: (turn: true, mirror: true), sound: Soil, textures: All("dirt"), hardness: 0.5, color: (134, 96, 67), tags: ["soil", "fertile", "natural"], coat: Some((with: "clay", into: "daub"))),
        (name: "coarse_dirt", texture_variety: (turn: true, mirror: true), sound: Soil, textures: All("coarse_dirt"), hardness: 0.5, color: (119, 85, 59), tags: ["soil", "dry", "natural", "surface"], coat: Some((with: "clay", into: "daub"))),
        (name: "rooted_dirt", texture_variety: (turn: true, mirror: true), sound: Soil, textures: All("rooted_dirt"), hardness: 0.5, color: (144, 104, 77), tags: ["soil", "natural"]),
        (name: "mud", texture_variety: (turn: true, mirror: true), sound: Mud, textures: All("mud"), hardness: 0.5, color: (60, 57, 61), tags: ["soil", "wet", "natural", "surface"]),
        (name: "moss_block", texture_variety: (turn: true, mirror: true), sound: Moss, textures: All("moss_block"), hardness: 0.1, color: (89, 110, 45), tags: ["soil", "wet", "groundcover", "natural", "surface"]),
        (
            name: "podzol", sound: Soil, texture_variety: (turn: true, mirror: true),
            textures: Sides(top: "podzol_top", bottom: "dirt", side: "podzol_side"),
            hardness: 0.5,
            drops: "dirt",
            color: (91, 63, 24),
            tags: ["soil", "acidic", "natural", "surface"],
        ),
        (
            name: "grass_block", sound: Grass, texture_variety: (turn: true, mirror: true),
            textures: Sides(top: "meadow_grass_top", bottom: "dirt", side: "grass_block_side"),
            tint: Grass,
            tint_top_only: true,
            hardness: 0.6,
            drops: "dirt",
            color: (100, 160, 70),
            tags: ["soil", "fertile", "natural", "surface"],
        ),
        // Ground worn by feet: grass trodden thin, and the packed earth of a well-used
        // path (generated trails, and the stages of wear in wear.ron).
        (
            name: "worn_grass_block", sound: Grass,
            textures: Sides(top: "worn_grass_block_top", bottom: "dirt", side: "grass_block_side"),
            tint: Grass,
            tint_top_only: true,
            hardness: 0.6,
            drops: "dirt",
            color: (125, 135, 75),
            tags: ["soil", "worn", "natural", "surface"],
        ),
        (name: "packed_earth", texture_variety: (turn: true, mirror: true), sound: Soil, textures: All("packed_earth"), hardness: 0.6, drops: "dirt", color: (150, 116, 80), tags: ["soil", "worn", "path", "surface"]),
        (name: "clay", texture_variety: (turn: true, mirror: true), sound: Soil, textures: All("clay"), hardness: 0.6, color: (160, 166, 179), tags: ["clay", "wet", "natural"]),
        // Daub: clay worked over wattle or earth, a sound wall that does not burn. Clay held to
        // the side of a wattle panel (blocks_building.ron) or an earth wall coats it in place.
        (name: "daub", sound: Soil, textures: All("daub"), hardness: 1.0, color: (205, 185, 150), tags: ["daub", "wall", "building", "shelter:sound"]),
        (name: "gravel", texture_variety: (turn: true, mirror: true), sound: Gravel, textures: All("gravel"), hardness: 0.6, color: (136, 126, 126), tags: ["gravel", "natural", "surface"], coat: Some((with: "clay", into: "daub"))),
        (name: "loam", texture_variety: (turn: true, mirror: true), sound: Soil, textures: All("loam"), hardness: 0.5, color: (94, 71, 54), tags: ["soil", "fertile", "natural", "surface"]),
        (name: "peat", texture_variety: (turn: true, mirror: true), sound: Mud, textures: All("peat"), hardness: 0.5, color: (55, 42, 33), tags: ["soil", "wet", "acidic", "fuel", "natural", "surface", "wetland"]),
        (name: "red_earth", texture_variety: (turn: true, mirror: true), sound: Soil, textures: All("red_earth"), hardness: 0.5, color: (157, 74, 47), tags: ["soil", "dry", "natural", "surface", "tropical", "savanna"]),
        (name: "silt", texture_variety: (turn: true, mirror: true), sound: Sand, textures: All("silt"), hardness: 0.5, color: (176, 168, 153), tags: ["soil", "wet", "fertile", "natural", "surface", "riverbank"]),
        // Snow and ice
        (
            name: "snowy_grass_block", sound: Snow,
            textures: Sides(top: "snow", bottom: "dirt", side: "grass_block_snow"),
            hardness: 0.6,
            drops: "dirt",
            color: (240, 245, 250),
            tags: ["soil", "snow", "cold", "natural", "surface"],
        ),
        (name: "snow_block", texture_variety: (turn: true, mirror: true), sound: Snow, textures: All("snow"), hardness: 0.2, color: (240, 245, 250), tags: ["snow", "cold", "natural", "surface"]),
        // A long-dead trunk, bare and weathered grey, of snags in dry and cold land: no
        // wood of any kind, so it never enters an inventory; breaking it gives a stick
        // instead (tools.ron), and no region's timber turns up where its trees do not grow.
        (
            name: "dead_log", sound: Wood, textures: All("dead_log"),
            hardness: 1.6, drops: "core:air", color: (128, 124, 116), tags: ["log", "natural", "snag", "tree"],
        ),
        (name: "powder_snow", texture_variety: (turn: true, mirror: true), sound: Snow, textures: All("powder_snow"), hardness: 0.25, color: (248, 253, 253), tags: ["snow", "cold", "natural", "surface"]),
        (name: "ice", sound: Glass, textures: All("ice"), render: Translucent, light_filter: 2, hardness: 0.5, color: (150, 190, 250), tags: ["ice", "cold", "natural"]),
        (name: "packed_ice", texture_variety: (turn: true, mirror: true), sound: Glass, textures: All("packed_ice"), hardness: 0.5, color: (141, 180, 250), tags: ["ice", "cold", "natural"]),
        (name: "blue_ice", texture_variety: (turn: true, mirror: true), sound: Glass, textures: All("blue_ice"), hardness: 2.8, color: (116, 167, 253), tags: ["ice", "cold", "natural"]),
        // Sand
        (name: "sand", texture_variety: (turn: true, mirror: true), sound: Sand, textures: All("sand"), hardness: 0.5, color: (219, 207, 163), tags: ["sand", "natural", "surface"], coat: Some((with: "clay", into: "daub"))),
        (name: "red_sand", texture_variety: (turn: true, mirror: true), sound: Sand, textures: All("red_sand"), hardness: 0.5, color: (190, 102, 33), tags: ["sand", "natural", "surface"], coat: Some((with: "clay", into: "daub"))),
        (name: "terracotta", texture_variety: (turn: true, mirror: true), textures: All("terracotta"), hardness: 1.25, color: (152, 94, 67), tags: ["terracotta", "clay", "natural", "building", "colour:brown", "shelter:fine"]),
        // Fluids. Each also makes its flowing and falling states (`water_flow_1` ..
        // `water_flow_7`, `water_falling`), and water the river states that carry a current
        // (see engine/src/fluid.rs). `tick`: ticks per step of a flow; `drop`: eighths of
        // depth lost per block, so how far it runs; `slope`: how far it looks for a way down;
        // `infinite`: two sources make a third between them; `pools`: water that fills a
        // hollow stays there; `crust`: what it hardens into where it stops, and after how
        // many ticks at rest; `meets`: what it turns into where it touches another fluid.
        (
            name: "water", sound: Water,
            textures: All("water_still"),
            // Kept animals drink from it (as from a well or a trough).
            tags: ["drinking_water"],
            render: Translucent,
            solid: false,
            tint: Water,
            light_filter: 2,
            hardness: -1.0,
            color: (63, 118, 228),
            fluid: (tick: 5, drop: 1, slope: 4, infinite: true, pools: true, currents: true, swim: true),
        ),
        // Glowing and slow. Its flows crust over with basalt where they stop, and water
        // quenches it: a source to obsidian, flowing lava to basalt, and the water it pours
        // into to broken basalt.
        (
            name: "lava", sound: Water,
            textures: All("lava_still"),
            solid: false,
            light: 15,
            hardness: -1.0,
            drops: "core:air",
            color: (214, 96, 24),
            tags: ["natural", "light", "hot", "deep", "lava"],
            fluid: (
                tick: 30, drop: 2, slope: 2,
                crust: (block: "basalt", after: 400),
                meets: [(fluid: "water", source: "obsidian", flowing: "basalt", below: "cobbled_basalt")],
            ),
        ),
        // Trees without a wood of their own
        (
            name: "mangrove_roots", sound: Wood,
            textures: Sides(top: "mangrove_roots_top", bottom: "mangrove_roots_top", side: "mangrove_roots_side"),
            render: Cutout,
            light_filter: 1,
            hardness: 0.7,
            color: (74, 59, 38),
            tags: ["wood", "natural", "wetland", "tree"],
        ),
        // Caves: dripstone, glowing growth, crystals, magma, the deep dark's gloomvein,
        // giant mushroom blocks and roots hanging from the roof.
        (name: "dripstone_block", texture_variety: (turn: false, mirror: true), textures: All("dripstone_block"), hardness: 1.5, color: (130, 104, 88), tags: ["stone", "sedimentary", "natural", "cave", "dripstone", "shelter:sound"]),
        (name: "pointed_dripstone", render: Plant, solid: false, textures: All("pointed_dripstone_up_tip"), hardness: 0.5, drops: "dripstone_block", color: (150, 120, 100), tags: ["cave", "dripstone", "natural", "stalagmite"]),
