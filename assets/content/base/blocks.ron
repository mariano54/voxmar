        // under every province, for a player whose country has none to mine down to.
        (template: "stone", name: "deepslate", tags: ["metamorphic", "deep", "cave", "toolstone"], members: {"deepslate": (textures: Column(end: "deepslate_top", side: "deepslate"), hardness: 3.0, color: (75, 75, 82))}),
