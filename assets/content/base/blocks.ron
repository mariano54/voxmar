// Base game blocks. Texture names refer to `textures/block/<name>.png` in the active
// texture source (a Minecraft client jar or resource pack); `color` is the placeholder
// used when no texture source is available.
(
    blocks: [
        (name: "air", render: Invisible, solid: false, hardness: -1.0),
        (name: "bedrock", textures: All("bedrock"), hardness: -1.0, color: (60, 60, 60)),
        (name: "stone", textures: All("stone"), hardness: 1.5, drops: Some("cobblestone"), color: (125, 125, 125)),
        (name: "cobblestone", textures: All("cobblestone"), hardness: 2.0, color: (110, 110, 110)),
        (name: "deepslate", textures: Column(end: "deepslate_top", side: "deepslate"), hardness: 3.0, color: (75, 75, 82)),
        (name: "granite", textures: All("granite"), hardness: 1.5, color: (150, 105, 90)),
        (name: "diorite", textures: All("diorite"), hardness: 1.5, color: (190, 190, 190)),
        (name: "andesite", textures: All("andesite"), hardness: 1.5, color: (135, 135, 135)),
        (name: "dirt", textures: All("dirt"), hardness: 0.5, color: (134, 96, 67)),
        (
            name: "grass_block",
            textures: Sides(top: "grass_block_top", bottom: "dirt", side: "grass_block_side"),
            tint: Grass,
            tint_top_only: true,
            hardness: 0.6,
            drops: Some("dirt"),
            color: (100, 160, 70),
        ),
        (
            name: "snowy_grass_block",
            textures: Sides(top: "snow", bottom: "dirt", side: "grass_block_snow"),
            hardness: 0.6,
            drops: Some("dirt"),
            color: (240, 245, 250),
        ),
        (name: "snow_block", textures: All("snow"), hardness: 0.2, color: (240, 245, 250)),
        (name: "ice", textures: All("ice"), render: Translucent, light_filter: 2, hardness: 0.5, color: (150, 190, 250)),
        (name: "sand", textures: All("sand"), hardness: 0.5, color: (219, 207, 163)),
        (
            name: "sandstone",
            textures: Sides(top: "sandstone_top", bottom: "sandstone_bottom", side: "sandstone"),
            hardness: 0.8,
            color: (216, 203, 155),
        ),
        (name: "red_sand", textures: All("red_sand"), hardness: 0.5, color: (190, 102, 33)),
        (name: "terracotta", textures: All("terracotta"), hardness: 1.25, color: (152, 94, 67)),
        (name: "gravel", textures: All("gravel"), hardness: 0.6, color: (136, 126, 126)),
        (name: "clay", textures: All("clay"), hardness: 0.6, color: (160, 166, 179)),
        (
            name: "water",
            textures: All("water_still"),
            render: Translucent,
            solid: false,
            tint: Water,
            light_filter: 2,
            hardness: -1.0,
            color: (63, 118, 228),
        ),
        (name: "oak_log", textures: Column(end: "oak_log_top", side: "oak_log"), hardness: 2.0, color: (109, 85, 50)),
        (name: "oak_leaves", textures: All("oak_leaves"), render: Cutout, tint: Foliage, light_filter: 1, hardness: 0.3, color: (60, 120, 40)),
        (name: "birch_log", textures: Column(end: "birch_log_top", side: "birch_log"), hardness: 2.0, color: (216, 215, 210)),
        (name: "birch_leaves", textures: All("birch_leaves"), render: Cutout, tint: Foliage, light_filter: 1, hardness: 0.3, color: (100, 140, 60)),
        (name: "spruce_log", textures: Column(end: "spruce_log_top", side: "spruce_log"), hardness: 2.0, color: (58, 37, 16)),
        (name: "spruce_leaves", textures: All("spruce_leaves"), render: Cutout, tint: Foliage, light_filter: 1, hardness: 0.3, color: (40, 80, 50)),
        (name: "jungle_log", textures: Column(end: "jungle_log_top", side: "jungle_log"), hardness: 2.0, color: (85, 67, 25)),
        (name: "jungle_leaves", textures: All("jungle_leaves"), render: Cutout, tint: Foliage, light_filter: 1, hardness: 0.3, color: (48, 140, 30)),
        (name: "acacia_log", textures: Column(end: "acacia_log_top", side: "acacia_log"), hardness: 2.0, color: (103, 96, 86)),
        (name: "acacia_leaves", textures: All("acacia_leaves"), render: Cutout, tint: Foliage, light_filter: 1, hardness: 0.3, color: (90, 120, 40)),
        (name: "cactus", textures: Sides(top: "cactus_top", bottom: "cactus_bottom", side: "cactus_side"), hardness: 0.4, color: (80, 130, 40)),
        (name: "coal_ore", textures: All("coal_ore"), hardness: 3.0, color: (90, 90, 90)),
        (name: "iron_ore", textures: All("iron_ore"), hardness: 3.0, color: (160, 140, 120)),
        (name: "copper_ore", textures: All("copper_ore"), hardness: 3.0, color: (150, 110, 80)),
        (name: "gold_ore", textures: All("gold_ore"), hardness: 3.0, color: (200, 180, 80)),
        (name: "diamond_ore", textures: All("diamond_ore"), hardness: 3.0, color: (100, 200, 200)),
        (name: "oak_planks", textures: All("oak_planks"), hardness: 2.0, color: (162, 130, 78)),
        (name: "glass", textures: All("glass"), render: Cutout, hardness: 0.3, color: (200, 230, 240)),
        (name: "glowstone", textures: All("glowstone"), light: 15, hardness: 0.3, color: (250, 210, 120)),
        (name: "sea_lantern", textures: All("sea_lantern"), light: 15, hardness: 0.3, color: (200, 225, 220)),
    ],
)
