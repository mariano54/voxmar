            textures: Sides(top: "sandstone_top", bottom: "sandstone_bottom", side: "sandstone"),
            hardness: 0.8,
            color: (216, 203, 155),
        ),
        (name: "red_sand", sound: Sand, textures: All("red_sand"), hardness: 0.5, color: (190, 102, 33)),
        (
