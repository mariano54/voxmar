// Base game blocks. Texture names refer to `textures/block/<name>.png` in the active
// texture source (a Minecraft client jar or resource pack); `color` is the placeholder
// used when no texture source is available. `sound` is the material it sounds like
// (Stone when omitted). Plants are not solid, break instantly and need ground beneath;
// `drops: Some("core:air")` drops nothing.
(
    blocks: [
        // Rock
        (name: "bedrock", textures: All("bedrock"), hardness: -1.0, color: (60, 60, 60)),
        (name: "stone", textures: All("stone"), hardness: 1.5, drops: Some("cobblestone"), color: (125, 125, 125)),
        (name: "cobblestone", textures: All("cobblestone"), hardness: 2.0, color: (110, 110, 110)),
        (name: "mossy_cobblestone", textures: All("mossy_cobblestone"), hardness: 2.0, color: (100, 118, 90)),
        (name: "deepslate", textures: Column(end: "deepslate_top", side: "deepslate"), hardness: 3.0, color: (75, 75, 82)),
        (name: "granite", textures: All("granite"), hardness: 1.5, color: (150, 105, 90)),
        (name: "diorite", textures: All("diorite"), hardness: 1.5, color: (190, 190, 190)),
        (name: "andesite", textures: All("andesite"), hardness: 1.5, color: (135, 135, 135)),
        (name: "tuff", textures: All("tuff"), hardness: 1.5, color: (108, 109, 102)),
        (name: "calcite", textures: All("calcite"), hardness: 0.75, color: (223, 224, 220)),
        // Soil
        (name: "dirt", sound: Soil, textures: All("dirt"), hardness: 0.5, color: (134, 96, 67)),
        (name: "coarse_dirt", sound: Soil, textures: All("coarse_dirt"), hardness: 0.5, color: (119, 85, 59)),
        (name: "rooted_dirt", sound: Soil, textures: All("rooted_dirt"), hardness: 0.5, color: (144, 104, 77)),
        (name: "mud", sound: Soil, textures: All("mud"), hardness: 0.5, color: (60, 57, 61)),
        (name: "moss_block", sound: Grass, textures: All("moss_block"), hardness: 0.1, color: (89, 110, 45)),
        (
            name: "podzol", sound: Soil,
            textures: Sides(top: "podzol_top", bottom: "dirt", side: "podzol_side"),
            hardness: 0.5,
            drops: Some("dirt"),
            color: (91, 63, 24),
        ),
        (
            name: "grass_block", sound: Grass,
            textures: Sides(top: "grass_block_top", bottom: "dirt", side: "grass_block_side"),
            tint: Grass,
            tint_top_only: true,
            hardness: 0.6,
            drops: Some("dirt"),
            color: (100, 160, 70),
        ),
        (name: "clay", sound: Soil, textures: All("clay"), hardness: 0.6, color: (160, 166, 179)),
        (name: "gravel", sound: Gravel, textures: All("gravel"), hardness: 0.6, color: (136, 126, 126)),
        // Snow and ice
        (
            name: "snowy_grass_block", sound: Snow,
            textures: Sides(top: "snow", bottom: "dirt", side: "grass_block_snow"),
            hardness: 0.6,
            drops: Some("dirt"),
            color: (240, 245, 250),
        ),
        (name: "snow_block", sound: Snow, textures: All("snow"), hardness: 0.2, color: (240, 245, 250)),
        (name: "powder_snow", sound: Snow, textures: All("powder_snow"), hardness: 0.25, color: (248, 253, 253)),
        (name: "ice", sound: Glass, textures: All("ice"), render: Translucent, light_filter: 2, hardness: 0.5, color: (150, 190, 250)),
        (name: "packed_ice", sound: Glass, textures: All("packed_ice"), hardness: 0.5, color: (141, 180, 250)),
        (name: "blue_ice", sound: Glass, textures: All("blue_ice"), hardness: 2.8, color: (116, 167, 253)),
        // Sand and the rocks of dry land
        (name: "sand", sound: Sand, textures: All("sand"), hardness: 0.5, color: (219, 207, 163)),
        (
