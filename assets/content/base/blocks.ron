        (name: "red_sand", sound: Sand, textures: All("red_sand"), hardness: 0.5, color: (190, 102, 33)),
        (name: "terracotta", textures: All("terracotta"), hardness: 1.25, color: (152, 94, 67)),
        (name: "gravel", sound: Gravel, textures: All("gravel"), hardness: 0.6, color: (136, 126, 126)),
        (name: "clay", sound: Soil, textures: All("clay"), hardness: 0.6, color: (160, 166, 179)),
        (
            name: "water", sound: Water,
            textures: All("water_still"),
            render: Translucent,
            solid: false,
            tint: Water,
            light_filter: 2,
            hardness: -1.0,
            color: (63, 118, 228),
        ),
        (name: "oak_log", sound: Wood, textures: Column(end: "oak_log_top", side: "oak_log"), hardness: 2.0, color: (109, 85, 50)),
        (name: "oak_leaves", sound: Leaves, textures: All("oak_leaves"), render: Cutout, tint: Foliage, light_filter: 1, hardness: 0.3, color: (60, 120, 40)),
