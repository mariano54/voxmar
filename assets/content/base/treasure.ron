// Treasure (engine/src/treasure.rs): chests locked by the age they belong to (1 Nomad,
// 2 Farm, 3 Bronze, 4 Iron, 5 Steam ...), the lockpicks that open them, and what each age's
// chest holds. The chest blocks are in blocks_treasure.ron; worldgen places them.
//
// - A lockpick of the age before the chest's, or any later, opens it and is used up.
// - One two ages short opens it only `lucky` times in one, and breaks either way.
// - Anything cruder does not try.
// - Opened, a chest becomes `opens_to` holding what its table rolled (by the world's seed
//   and where it stands). Each `loot` entry comes on its own chance (loot.rs's format);
//   each `one_of` group gives, on its chance, one of its items, so gear comes one piece a
//   chest and never a whole set. Nothing may be rarer than one chest in 400.
(
    lucky: 0.05,
    picks: [
        (item: "bone_lockpick", age: 1),
        (item: "copper_lockpick", age: 2),
        (item: "bronze_lockpick", age: 3),
        (item: "iron_lockpick", age: 4),
    ],
    chests: [
        (block: "nomad_treasure_chest", age: 1, table: "nomad", opens_to: "chest"),
        (block: "farm_treasure_chest", age: 2, table: "farm", opens_to: "chest"),
        (block: "bronze_treasure_chest", age: 3, table: "bronze", opens_to: "chest"),
        (block: "iron_treasure_chest", age: 4, table: "iron", opens_to: "chest"),
        (block: "steam_treasure_chest", age: 5, table: "steam", opens_to: "chest"),
    ],
    tables: [
        (
            name: "nomad",
            loot: [
                (item: "gold_coin", count: (2, 6)),
                (item: "flint", count: (2, 5), chance: 0.6),
                (item: "twine", count: (1, 4), chance: 0.5),
                (item: "cooked_rabbit", count: (1, 3), chance: 0.4),
                (item: "bone_lockpick", count: (1, 2), chance: 0.25),
            ],
            one_of: [
                (chance: 0.3, items: ["stone_pickaxe", "stone_axe", "stone_knife", "stone_sword", "bone_club"]),
            ],
        ),
        (
            name: "farm",
            loot: [
                (item: "gold_coin", count: (4, 10)),
                (item: "copper_ingot", count: (1, 3), chance: 0.5),
                (item: "seed_mix", count: (1, 3), chance: 0.4),
                (item: "vial", count: (1, 2), chance: 0.3),
                (item: "copper_lockpick", count: (1, 2), chance: 0.2),
            ],
            one_of: [
                (chance: 0.3, items: ["copper_pickaxe", "copper_axe", "copper_knife", "copper_sword", "fishing_rod"]),
            ],
        ),
        (
            name: "bronze",
            loot: [
                (item: "gold_coin", count: (6, 16)),
                (item: "bronze_ingot", count: (1, 3), chance: 0.5),
                (item: "charcoal", count: (2, 6), chance: 0.5),
                (item: "bronze_lockpick", count: (1, 2), chance: 0.2),
            ],
            one_of: [
                (chance: 0.3, items: ["bronze_sword", "bronze_spear", "copper_pickaxe", "fine_rod"]),
            ],
        ),
        (
            name: "iron",
            loot: [
                (item: "gold_coin", count: (10, 24)),
                (item: "iron_ingot", count: (2, 4), chance: 0.6),
                (item: "coke", count: (2, 6), chance: 0.4),
                (item: "iron_lockpick", count: (1, 2), chance: 0.2),
                (item: "grave_ward_amulet", chance: 0.01, rarity: VeryRare),
            ],
            one_of: [
                (chance: 0.3, items: ["iron_sword", "iron_pickaxe", "iron_axe", "iron_knife"]),
            ],
        ),
        (
            name: "steam",
            loot: [
                (item: "gold_coin", count: (16, 40)),
                (item: "iron_plate", count: (2, 6), chance: 0.5),
                (item: "coke", count: (4, 10), chance: 0.4),
                (item: "iron_lockpick", count: (1, 3), chance: 0.25),
                (item: "grave_ward_amulet", chance: 0.02, rarity: VeryRare),
                (item: "diamond_ore", chance: 0.01, rarity: Rare),
            ],
            one_of: [
                (chance: 0.3, items: ["iron_sword", "iron_pickaxe", "iron_axe", "iron_hoe"]),
            ],
        ),
    ],
)
