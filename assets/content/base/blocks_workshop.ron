// Workshop blocks: things a recipe is made near (`near` in recipes.ron, docs/crafting.md).
// A chopping block is a log end stood up with a flint wedge left in it: logs split by it
// give two more planks each than the crafting grid's. A grindstone is a wheel of cobble
// dressed with sand, hung between two posts: toolstone ground on it makes a stone head.
// Held to it with an axe about you, a log splits into firewood (cooking.ron), which burns
// hotter than a log; stacked under earth with kindling on top it is a charcoal clamp
// (multiblocks.ron).
(
    blocks: [
        (
            name: "chopping_block", render: Model, shape: "chopping_block", solid: true, sound: Wood,
            textures: Sides(top: "chopping_block_top", bottom: "chopping_block_top", side: "chopping_block_side"),
            drops: "chopping_block", hardness: 1.5, color: (120, 92, 58), tags: ["chopping_block", "decor"],
        ),
        (
            name: "grindstone", render: Model, shape: "grindstone", solid: true, sound: Wood,
            textures: All("grindstone_frame"),
            drops: "grindstone", hardness: 1.5, color: (128, 124, 118), tags: ["grindstone", "decor"],
        ),
        // Split firewood, stacked: good fuel (machines.ron), and what a clamp chars.
        (
            name: "firewood", sound: Wood, textures: Column(end: "firewood_end", side: "firewood_side"),
            hardness: 1.0, color: (150, 112, 72), tags: ["firewood", "wood", "fuel"],
        ),
        // Kindling: a bundle of sticks, the flue a clamp is lit at.
        (
            name: "kindling", render: Plant, solid: false, sound: Wood, textures: All("kindling"),
            hardness: 0.0, color: (130, 95, 55), tags: ["kindling", "multiblock_core", "fuel"],
        ),
        // A clamp's flue while it smoulders: a glow and a thread of smoke, warm to stand by.
        (
            name: "clamp_flue", render: Plant, solid: false, sound: Wood, textures: All("clamp_flue"),
            light: 6, drops: "core:air", hardness: 0.0, color: (200, 90, 30), tags: ["creative_only", "fire", "multiblock_core", "clamp_burning"],
            particles: [
                (style: Smoke, rate: 3.0, at: (0.5, 0.4, 0.5), spread: 0.1, size: 1.0, height: 3.0, color: Some((110, 106, 100))),
                (style: Ember, rate: 0.6, at: (0.5, 0.2, 0.5), spread: 0.1, size: 0.6, height: 1.0, color: Some((226, 84, 16))),
            ],
        ),
        // The flue just lit, the kindling catching: thick pale smoke, sparks, a dim glow
        // (multiblocks.ron's clamp `stages`).
        (
            name: "clamp_flue_catching", render: Plant, solid: false, sound: Wood, textures: All("clamp_flue"),
            light: 4, drops: "core:air", hardness: 0.0, color: (200, 90, 30), tags: ["creative_only", "fire", "multiblock_core", "clamp_burning"],
            particles: [
                (style: Smoke, rate: 6.0, at: (0.5, 0.4, 0.5), spread: 0.15, size: 1.3, height: 3.5, color: Some((168, 164, 156))),
                (style: Ember, rate: 1.5, at: (0.5, 0.3, 0.5), spread: 0.15, size: 0.6, height: 1.5, color: Some((240, 120, 30))),
            ],
        ),
        // The flue near the end, the wood charred through: a thin blue-grey wisp and a low
        // glow, a sign to come back soon.
        (
            name: "clamp_flue_dying", render: Plant, solid: false, sound: Wood, textures: All("clamp_flue"),
            light: 3, drops: "core:air", hardness: 0.0, color: (160, 70, 30), tags: ["creative_only", "fire", "multiblock_core", "clamp_burning"],
            particles: [
                (style: Smoke, rate: 1.2, at: (0.5, 0.4, 0.5), spread: 0.05, size: 0.7, height: 2.0, color: Some((120, 124, 132))),
            ],
        ),
        // What a clamp leaves where its firewood was: charcoal done in its time, part-burnt
        // wood opened early, ash where rain came in at the flue.
        (
            name: "charcoal_heap", sound: Gravel, textures: All("charcoal_heap"), drops: "charcoal", drop_count: 4,
            hardness: 0.4, color: (40, 36, 34), tags: ["creative_only", "charred"],
        ),
        (
            name: "charred_wood_heap", sound: Wood, textures: All("charred_wood_heap"), drops: "charred_wood", drop_count: 2,
            hardness: 0.6, color: (70, 52, 40), tags: ["creative_only", "charred"],
        ),
        (
            name: "ash_heap", sound: Sand, textures: All("ash_heap"), drops: "core:air",
            hardness: 0.2, color: (150, 146, 140), tags: ["creative_only", "charred"],
        ),
    ],
)
