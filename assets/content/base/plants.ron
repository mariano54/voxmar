// Base game plants: a shared pool biomes draw from by tag or name. Each names its block (a
// plant's other looks, its variants, are chosen by position), and says where it grows:
// the ground (Soil, Snow, Sand), its habitat (Anywhere, Open, Shade, Water, Shore), the
// climate it is comfortable in, and how it spreads: Cover carpets the ground, Drifts grow
// in patches of one kind, Alone here and there. A plant's tags are its block's plus its
// own, and its properties (nutrition, alchemy, dye) default to what the block's tags say.
(
    plants: [
        // Grasses and ferns.
        (name: "short_grass", block: "short_grass", habitat: Open),
        (name: "tall_grass", block: "tall_grass", top: "tall_grass_top", habitat: Open, comfort: (moisture: (0.75, 3.0))),
        (name: "fern", block: "fern", comfort: (moisture: (0.8, 3.0))),
        (name: "large_fern", block: "large_fern", top: "large_fern_top", comfort: (moisture: (0.9, 3.0))),

        // Bushes, fungi and reeds.
        (name: "dead_bush", block: "dead_bush", spread: Alone, ground: [Sand, Soil], comfort: (temperature: (10.0, 45.0), moisture: (0.0, 0.55))),
        (
            name: "sweet_berry_bush", block: "sweet_berry_bush", spread: Alone, habitat: Shade,
            comfort: (temperature: (-6.0, 11.0)),
            properties: (nutrition: 2.0),
        ),
        (name: "sugar_cane", block: "sugar_cane", stack: (1, 3), spread: Alone, habitat: Water, ground: [Soil, Sand], comfort: (temperature: (11.0, 45.0))),
        (name: "brown_mushroom", block: "brown_mushroom", spread: Alone, habitat: Shade, comfort: (moisture: (0.85, 3.0)), properties: (nutrition: 1.0)),
        (name: "red_mushroom", block: "red_mushroom", spread: Alone, habitat: Shade, comfort: (moisture: (0.85, 3.0))),

        // Flowers.
        (name: "dandelion", block: "dandelion", spread: Drifts, habitat: Open, comfort: (temperature: (4.0, 26.0), moisture: (0.4, 1.6)), properties: (nutrition: 1.0)),
        (name: "poppy", block: "poppy", spread: Drifts, habitat: Open, comfort: (temperature: (5.0, 26.0), moisture: (0.4, 1.6))),
        (name: "cornflower", block: "cornflower", spread: Drifts, habitat: Open, comfort: (temperature: (8.0, 20.0), moisture: (0.5, 1.2))),
        (name: "oxeye_daisy", block: "oxeye_daisy", spread: Drifts, habitat: Open, comfort: (temperature: (6.0, 20.0), moisture: (0.6, 1.4))),
        (name: "azure_bluet", block: "azure_bluet", spread: Drifts, habitat: Open, comfort: (temperature: (8.0, 22.0), moisture: (0.5, 1.3))),
        (name: "allium", block: "allium", spread: Drifts, habitat: Open, comfort: (temperature: (3.0, 14.0), moisture: (0.6, 1.3))),
        (name: "lily_of_the_valley", block: "lily_of_the_valley", spread: Drifts, comfort: (temperature: (2.0, 13.0), moisture: (1.0, 2.5))),
        (name: "blue_orchid", block: "blue_orchid", spread: Drifts, comfort: (temperature: (18.0, 32.0), moisture: (1.15, 3.0))),
        (name: "red_tulip", block: "red_tulip", spread: Drifts, habitat: Open, comfort: (temperature: (9.0, 18.0), moisture: (0.5, 1.0))),
        (name: "orange_tulip", block: "orange_tulip", spread: Drifts, habitat: Open, comfort: (temperature: (9.0, 18.0), moisture: (0.5, 1.0))),
        (name: "white_tulip", block: "white_tulip", spread: Drifts, habitat: Open, comfort: (temperature: (9.0, 18.0), moisture: (0.5, 1.0))),
        (name: "pink_tulip", block: "pink_tulip", spread: Drifts, habitat: Open, comfort: (temperature: (9.0, 18.0), moisture: (0.5, 1.0))),
    ],
)
