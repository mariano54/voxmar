// Base game plants: a shared pool biomes draw from by tag or name. Each names its block (a
// plant's other looks, its variants such as pairs and clumps, are chosen by position), and
// says where it grows: the ground (Soil, Snow, Sand), its habitat (Anywhere, Open, Shade,
// Understory: thickest in shade, Water, Shore), the climate it is comfortable in, and how
// it spreads: Cover carpets the ground (grasses, ferns), Drifts grow in patches of one kind
// (flowers, herbs; kept sparse), Alone here and there (bushes, fungi, reeds; a biome's weight
// for these is their chance in a hundred per block). `snowy` names its look under snow. A
// plant's tags are its block's plus its own, and its properties (nutrition, alchemy, dye)
// default to what the block's tags say. The ten rare herbs, wild rice and wild taro
// (`named_only`) grow only in the biomes that name them, one or two each, in patches:
// `patches` gives the plants per million blocks where the plant can root, the plants in a
// patch, and `aim`, design's rate for it per million blocks of each biome naming it (draft
// 89, tied to rarity: Legendary up to 100, VeryRare 120 to 160, Rare 200 to 300, in patches
// of 3 to 6); the weight a biome names it with scales the rate to the biome's own ground so
// the census meets the aim. A herb of a lake's bank (the sky lotus, a tarn find) is held to
// its rate per million columns of bank instead, times the biome's weight: how much of a
// biome is lake bank differs eightfold from world to world, so its `aim` over the whole
// biome is only what a world of middling tarns gives.
(
    // How densely small plants grow (flowers, ground plants, grasses and ferns): a factor
    // on every biome's own, 1 being the biomes' own. Halved so the land reads less crowded:
    // more bare ground between tufts, flowers and herbs, with drifts and rarities as before.
    density: 0.5,
    // What the density leaves at the biomes' own rate: the plants gathered for food,
    // crafting and alchemy (wild crops, rare herbs, forage, berries, fungi, sugar cane), so
    // thinning the look never thins the harvest.
    density_keeps: [Tag("wild_crop", 1.0), Tag("rare_herb", 1.0), Tag("forage", 1.0), Tag("berry", 1.0), Tag("fungus", 1.0), Name("sugar_cane", 1.0)],
    plants: [
        // Grasses and ferns.
        (name: "short_grass", block: "short_grass", habitat: Open),
        (name: "tall_grass", block: "tall_grass", top: "tall_grass_top", habitat: Open, comfort: (moisture: (0.75, 8.0))),
        (name: "fern", block: "fern", habitat: Understory, comfort: (moisture: (0.8, 8.0))),
        (name: "large_fern", block: "large_fern", top: "large_fern_top", habitat: Shade, comfort: (moisture: (0.9, 8.0))),

        // Bushes, fungi and reeds.
        (name: "dead_bush", block: "dead_bush", spread: Alone, ground: [Sand, Soil], comfort: (temperature: (10.0, 45.0), moisture: (0.0, 0.55))),
        (
            name: "sweet_berry_bush", block: "sweet_berry_bush", spread: Alone, habitat: Shade,
            comfort: (temperature: (-6.0, 11.0)),
            properties: (nutrition: 2.0),
        ),
        (name: "sugar_cane", block: "sugar_cane", stack: (1, 3), spread: Alone, habitat: Water, ground: [Soil, Sand], comfort: (temperature: (11.0, 45.0))),
        (name: "brown_mushroom", block: "brown_mushroom", spread: Alone, habitat: Shade, comfort: (moisture: (0.85, 8.0)), properties: (nutrition: 1.0)),
        (name: "red_mushroom", block: "red_mushroom", spread: Alone, habitat: Shade, comfort: (moisture: (0.85, 8.0))),

        // Flowers.
        (name: "dandelion", block: "dandelion", spread: Drifts, habitat: Open, comfort: (temperature: (4.0, 26.0), moisture: (0.4, 1.6)), properties: (nutrition: 1.0)),
        (name: "poppy", block: "poppy", spread: Drifts, habitat: Open, comfort: (temperature: (5.0, 26.0), moisture: (0.4, 1.6))),
