        (name: "windroot", block: "windroot", named_only: true, tags: ["rare_herb"], patches: (rate: 300.0, size: (3, 6), aim: 300.0), spread: Alone, habitat: Open, ground: [Soil, Bare], comfort: (temperature: (-8.0, 18.0), moisture: (0.2, 1.6))),
