// The land: the large noise fields every position's parameters come from, and the fields
// derived from them through nested splines, ending in `surface`, the height of the land
// (see crates/worldgen/src/router.rs and docs/terrain-foundation.md).
//
// The structure and most knot values are adapted from Tectonic 3.0.25 by Apollo (MIT; see
// THIRD_PARTY_NOTICES.md): its continents, erosion and ridges fields, its terrain splines
// and its terrain regions. Our world has Minecraft's vertical layout (128 blocks of ground
// under the sea, 256 above), so its values carry over: `surface` is in units of 128 blocks
// above the sea. Changes from Tectonic: larger continents and ranges, no river channels
// cut below the sea (our own rivers carve the valleys Tectonic's ridge lines leave),
// lowlands lifted a few blocks with rolling hills on them, and a fine texture standing in
// for 3D noise until the terrain becomes a density field.
//
// Built-in inputs: `T` (regional sea-level temperature, °C), `H` (regional moisture,
// precipitation over evaporation), `continents_fold` (the continents noise folded, 1 at the
// coast for the world's ocean fraction), and the dials `tectonic` and `young`.
// The generator reads `surface`, `C`, `mountain`, `peak`, `roughness`, `valley` and, if
// it is there, `crag`.
(
    warps: [
        ("land", (wavelength: 1100.0, amplitude: 120.0, octaves: 2)),
    ],
    noises: [
        // Continents about 10 km from sea to sea (Tectonic's ~7.9 km, made larger), with
        // eight octaves so coasts are fractal down to about 80 blocks.
        ("continents", (wavelength: 10400.0, octaves: [1.75, 1.0, 2.0, 3.0, 2.0, 2.0, 1.0, 1.0], spread: 0.55, warp: "land", scale_by: "continent_size")),
        // Mountain ranges along its zero lines, about 8 km apart. Its spread sets how much
        // of the land is mountainous: larger, less (Tectonic's is about 0.64).
        ("erosion", (wavelength: 8000.0, octaves: [2.0, 1.75, 1.5, 1.5, 1.3, 1.0, 1.0], spread: 1.3, warp: "land")),
        // Valleys along its zero lines, peaks and plateaus between.
        ("ridges", (wavelength: 1200.0, octaves: [1.0, 2.0, 1.0], spread: 0.39, warp: "land")),
        // Which style of lowland: plateaus and valleys, rolling hills, terraces, wetland.
        ("region", (wavelength: 2200.0, octaves: [1.0, 2.1, 1.5, 1.7], spread: 0.43)),
        ("height_mult", (wavelength: 1024.0, octaves: [1.0, 2.0, 1.0], spread: 0.39)),
        ("badlands_ridge", (wavelength: 731.0, octaves: [1.0, 2.0, 1.0], spread: 0.39, warp: "land")),
        ("rolling_hills", (wavelength: 320.0, octaves: [1.0, 1.6, 1.2], spread: 0.36)),
        ("lower_tier", (wavelength: 731.0, octaves: [1.4, 2.0, 1.0], spread: 0.47)),
        ("upper_tier", (wavelength: 731.0, octaves: [1.4, 2.0, 1.0], spread: 0.47)),
        ("wetland", (wavelength: 80.0, octaves: [0.6, 1.7, 1.2], spread: 0.3)),
        // Crests on the spines of ranges, and the detail dragged down their slopes.
        ("ridge_base", (wavelength: 150.0, octaves: [1.0, 0.2], spread: 0.28)),
        ("ridge_detail", (wavelength: 64.0, octaves: [0.2, 1.0], spread: 0.15)),
        // Trenches and ridges on the floor of the deep sea.
        ("ocean_lines", (wavelength: 640.0, octaves: [1.0, 1.0, 0.0, 1.0], spread: 0.3)),
        ("ocean_bumps", (wavelength: 256.0, octaves: [1.0, 1.0, 1.0], spread: 0.33)),
        // Rolling hills over the lowland, a few hundred blocks apart.
        ("hills", (wavelength: 900.0, octaves: [1.0, 1.2], spread: 0.3, warp: "land")),
        // Small bumps on the ground.
        ("bumps", (wavelength: 40.0, octaves: [1.0, 0.6], spread: 1.0)),
    ],
    fields: [
        // Continentalness in Tectonic's units: about -0.8 along the middle of the seas,
        // -0.155 at the coast, rising inland.
        ("C", Spline(on: "continents_fold", points: [(0.0, -0.8), (0.9, -0.225, 0.445), (1.08, -0.12, 0.445)])),
        // Erosion, sharpened a little near zero, and folded: ranges where it is small.
        ("E", Spline(on: "erosion", points: [(-0.35, -0.4, 0.6), (-0.14, -0.1, 0.4), (0.14, 0.1, 0.4), (0.35, 0.4, 0.6)])),
        ("Ef", Abs("E")),
        ("W", "ridges"),
        ("Wf", Abs("ridges")),
        // Lowland styles; the skew favours flat land and hills over plateaus (Tectonic's is 0.1).
        ("Q", Add(["region", 0.2])),
        // Climate bands as Tectonic's indices: 1 frozen, 2 cold, 3 temperate (our cool and
        // temperate), 4 warm, 5 hot; 1 arid ..= 5 wet. The steps are the band edges of
        // climate.ron.
        ("Ti", Spline(on: "T", points: [(-3.5, 1.0), (-2.5, 2.0), (3.5, 2.0), (4.5, 3.0), (16.5, 3.0), (17.5, 4.0), (21.5, 4.0), (22.5, 5.0)])),
        ("Hi", Spline(on: "H", points: [(0.31, 1.0), (0.37, 2.0), (0.57, 2.0), (0.63, 3.0), (0.92, 3.0), (0.98, 4.0), (1.32, 4.0), (1.38, 5.0)])),
        ("low_tier", Abs("lower_tier")),
        ("high_tier", Abs("upper_tier")),
        ("badlands", Abs("badlands_ridge")),
        ("rolling", Abs("rolling_hills")),
        ("hm", Clamp(Add([1.05, Mul([0.35, "height_mult"])]), 0.75, 1.4)),
        // A broad valley floor a couple of blocks above the sea along the ridge lines; our
        // rivers cut their channels into it.
        ("river_valley", Spline(on: "Wf", points: [(0.03, 0.015, 0.5), (0.1, 0.01)])),

        // Club: plateaus, single and double valleys, badlands ridges in the heat.
        ("plateau", Spline(on: "W", points: [
            (-0.5, 0.25, -0.1), (-0.4, Spline(on: "low_tier", points: [(0.0, 0.1), (0.15, 0.22)])),
            (-0.3, 0.05, -0.8), (-0.1, 0.01), (-0.03, 0.015, -0.5), (0.03, 0.015, 0.5), (0.1, 0.01), (0.3, 0.05, 0.8),
            (0.4, Spline(on: "low_tier", points: [(0.0, 0.135), (0.15, 0.28)])), (0.5, 0.35, 0.1),
        ])),
        ("single_valley", Spline(on: "W", points: [
            (-0.5, 0.25, -0.1), (-0.4, Spline(on: "low_tier", points: [(0.0, 0.1), (0.15, 0.22)])),
            (-0.3, 0.05, -0.8), (-0.1, 0.01), (-0.03, 0.015, -0.5), (0.03, 0.015, 0.5), (0.075, 0.01), (0.14, 0.05, 0.8),
            (0.2, Spline(on: "low_tier", points: [(0.0, 0.135), (0.15, 0.28)])), (0.3, 0.35), (0.45, 0.03),
        ])),
        ("double_valley", Spline(on: "W", points: [
            (-0.45, 0.03), (-0.3, 0.25), (-0.2, Spline(on: "low_tier", points: [(0.0, 0.1), (0.15, 0.22)])),
            (-0.125, 0.05, -0.8), (-0.075, 0.01), (-0.03, 0.015, -0.5), (0.03, 0.015, 0.5), (0.075, 0.01), (0.125, 0.05, 0.8),
            (0.2, Spline(on: "low_tier", points: [(0.0, 0.135), (0.15, 0.28)])), (0.3, 0.35), (0.45, 0.03),
        ])),
        ("badlands_ridges", Spline(on: "Wf", points: [
            (0.0, 0.015, 2.5), (0.1, 0.04),
            (0.2, Spline(on: "badlands", points: [(0.45, 0.05), (0.6, 0.15, 1.5), (0.63, 0.185, 0.2)])),
            (0.3, Spline(on: "badlands", points: [(0.45, 0.05), (0.6, 0.185, 1.5), (0.63, 0.5, 0.2)])),
        ])),
        ("club", Spline(on: "Ti", points: [
            (1.0, "plateau"),
            (2.0, Spline(on: "Hi", points: [(1.0, "single_valley"), (2.0, "plateau")])),
            (3.0, Spline(on: "Hi", points: [(2.0, "single_valley"), (3.0, "plateau"), (4.0, "plateau"), (5.0, "double_valley")])),
            (4.0, "plateau"),
            (5.0, "badlands_ridges"),
        ])),
        ("club_weak", Spline(on: "Ti", points: [
            (4.0, Spline(on: "W", points: [
                (-0.5, 0.13, -0.1), (-0.4, Spline(on: "low_tier", points: [(0.0, 0.05), (0.15, 0.11)])),
                (-0.3, 0.05, -0.8), (-0.1, 0.01), (-0.03, 0.015, -0.5), (0.03, 0.015, 0.5), (0.1, 0.01), (0.3, 0.05, 0.8),
                (0.4, Spline(on: "low_tier", points: [(0.0, 0.07), (0.15, 0.14)])), (0.5, 0.17, 0.1),
            ])),
            (5.0, "badlands_ridges"),
        ])),
        // Heart: rolling hills, ridged lowland, tall wet plateaus.
        ("heart", Spline(on: "Ti", points: [
            (3.0, Spline(on: "Hi", points: [
                (2.0, Spline(on: "Wf", points: [(0.03, 0.015, 0.5), (0.1, 0.01, 0.1), (0.2, Add([0.01, Mul([0.225, "rolling"])]))])),
                (3.0, Spline(on: "Wf", points: [(0.03, 0.015, 0.5), (0.1, 0.01, 0.1)])),
            ])),
            (4.0, Spline(on: "Hi", points: [
                (3.0, Spline(on: "Wf", points: [(0.03, 0.015, 0.5), (0.1, 0.01, 0.1)])),
                (4.0, Spline(on: "W", points: [(-0.75, 0.05), (-0.175, 0.015), (-0.125, 0.01), (-0.04, 0.015, -0.7), (0.04, 0.015, 0.7), (0.125, 0.01)])),
                (5.0, Spline(on: "Wf", points: [(0.04, 0.015, 0.7), (0.125, 0.01), (0.175, 0.015), (0.75, 0.05), (0.8, 0.6)])),
            ])),
            (5.0, Spline(on: "Wf", points: [(0.03, 0.015, 0.5), (0.1, 0.01, 0.15)])),
        ])),
        // Spade: two-tier terraces stepping down to the valleys; mesas in the heat.
        ("spade", Spline(on: "Ti", points: [
            (4.0, Spline(on: "Wf", points: [
                (0.03, 0.015, 0.5), (0.1, 0.01), (0.3, 0.05, 0.8), (0.4, Spline(on: "low_tier", points: [(0.0, 0.1), (0.15, 0.22)])),
                (0.55, 0.25, 1.0), (0.6, Spline(on: "high_tier", points: [(0.0, 0.25), (0.15, 0.45)])), (0.64, 0.5),
            ])),
            (5.0, Spline(on: "Wf", points: [
                (0.025, 0.015, 0.03), (0.1, 0.05), (0.175, 0.1, 1.5), (0.2, 0.225, 0.2), (0.4, 0.6, 7.0), (0.4, 0.6, 0.1),
                (0.8, 0.7), (0.85, 0.4), (1.0, 0.4), (1.05, 0.04),
            ])),
        ])),
        ("spade_weak", Spline(on: "Ti", points: [
            (4.0, Spline(on: "Wf", points: [(0.03, 0.015, 0.5), (0.1, 0.01), (0.3, 0.05, 0.8), (0.4, 0.22), (0.55, 0.25, 0.1)])),
            (5.0, Spline(on: "Wf", points: [
                (0.025, 0.015, 0.03), (0.1, 0.05), (0.175, 0.1, 1.5), (0.2, 0.18, 0.2), (0.4, 0.3, 2.5), (0.4, 0.3, 0.15),
                (0.8, 0.3), (0.85, 0.23), (1.0, 0.23), (1.05, 0.04),
            ])),
        ])),
        // Diamond: low land, with wetland pools just under the plain in moderate warmth.
        ("diamond", Spline(on: "Ti", points: [
            (4.0, Spline(on: "Hi", points: [
                (2.0, Spline(on: "Wf", points: [(0.03, 0.015, 0.5), (0.1, 0.01, 0.1)])),
                (3.0, Spline(on: "Wf", points: [
                    (0.03, 0.015, 0.5), (0.1, 0.01),
                    (0.15, Spline(on: "wetland", points: [(-0.45, -0.03, 0.03), (-0.3, 0.005), (0.3, 0.005), (0.45, -0.03, -0.03)])),
                ])),
            ])),
            (5.0, Spline(on: "Wf", points: [(0.03, 0.015, 0.5), (0.1, 0.01, 0.15)])),
        ])),
        // The suits by the sign of erosion and the region selector.
        ("regions", Mul(["hm", Spline(on: "E", points: [
            (-0.02, Spline(on: "Q", points: [(-0.1, "club"), (0.0, "club_weak"), (0.1, "heart")])),
            (0.04, Spline(on: "Q", points: [(-0.1, "spade"), (0.0, "spade_weak"), (0.1, "diamond")])),
        ])])),
        ("regions_weak", Spline(on: "E", points: [
            (-0.02, Spline(on: "Q", points: [(-0.04, "club"), (0.04, "heart")])),
            (0.04, Spline(on: "Q", points: [(-0.02, "spade"), (0.04, "diamond")])),
        ])),

        // The height of the land above the sea, by continentalness, then erosion (ranges
        // along its zero lines, hills, the lowland regions, flats), then the ridge lines.
        ("offset", Spline(on: "C", points: [
            (-0.45, -0.45),
            (-0.35, -0.22),
            (-0.195, -0.14),
            (-0.155, Spline(on: "Ef", points: [
                (0.2, Spline(on: "Wf", points: [(0.0, -0.1), (0.15, 0.15, 3.0), (0.25, 0.22)]), -0.17),
                (0.3, Spline(on: "Wf", points: [(0.03, 0.0, 0.5), (0.1, 0.0)])),
            ])),
            (0.0, Spline(on: "Ef", points: [
                (0.0, 0.65), (0.15, 0.38, -1.5), (0.3, 0.28),
                (0.375, Spline(on: "Wf", points: [(0.0, 0.015), (0.15, 0.15), (0.3, 0.25)])),
                (0.4, "river_valley"), (0.95, "river_valley"),
                (1.075, Spline(on: "Wf", points: [(0.38, 0.0), (0.45, 0.03)])),
            ])),
            (0.1, Spline(on: "Ef", points: [
                (0.0, 0.95), (0.175, 0.48), (0.3, 0.3),
                (0.375, Spline(on: "Wf", points: [(0.0, 0.015), (0.1, 0.125, 5.0), (0.1667, 0.225), (0.3, 0.3)])),
                (0.425, "regions_weak"), (0.5, "regions"), (0.825, "regions"),
                (0.875, Spline(on: "Wf", points: [(0.0, 0.015, 1.0), (0.175, 0.075, 0.3), (0.3, 0.25)])),
                (0.95, Spline(on: "Wf", points: [(0.0, 0.015, 1.0), (0.175, 0.075, 0.3), (0.3, 0.25)])),
                (1.075, Spline(on: "Wf", points: [(0.38, 0.0), (0.45, 0.03)])),
            ])),
            (0.8, Spline(on: "Ef", points: [
                (0.0, 1.1), (0.175, 0.56), (0.3, 0.32),
                (0.375, Spline(on: "Wf", points: [(0.0, 0.015), (0.1, 0.125, 5.0), (0.1667, 0.225), (0.3, 0.33)])),
                (0.425, "regions_weak"), (0.5, "regions"), (0.8, "regions"),
                (0.9, Spline(on: "Wf", points: [(0.0, 0.015, 1.0), (0.175, 0.075, 0.3), (0.3, 0.25)])),
                (0.95, Spline(on: "Wf", points: [(0.0, 0.015, 1.0), (0.175, 0.075, 0.3), (0.3, 0.25)])),
                (1.075, Spline(on: "Wf", points: [(0.38, 0.0), (0.45, 0.03)])),
            ])),
        ])),
        // Lowlands a few blocks higher than Tectonic's, more so inland.
        ("lift", Spline(on: "C", points: [(-0.18, 0.0), (-0.12, 0.03), (0.2, 0.06)])),
        // Rolling hills up to about 25 blocks high over the lowland, where Tectonic's 3D
        // noise would roughen it: none on the ranges (their splines shape them) or at the
        // coast, fewer on the flattest plains.
        ("rolling_land", Mul([
            Spline(on: "C", points: [(-0.14, 0.0), (0.05, 1.0)]),
            Spline(on: "Ef", points: [(0.3, 0.0), (0.45, 0.2), (0.85, 0.15), (1.2, 0.05)]),
            Max([0.0, Add([0.5, "hills"])]),
        ])),

        // Crests along the spines of the ranges only: a ridge noise, plus detail dragged
        // down the fall line by the ridge noise's own slope, so gullies follow the slope.
        ("jag", Mul([
            Spline(on: "C", points: [(0.0, 0.0), (0.175, Spline(on: "Ef", points: [(0.0, 0.2), (0.125, 0.0)]))]),
            Add([0.5, Mul([0.5, "young"])]),
        ])),
        ("ridge_slope_x", Add(["ridge_base", Mul([-1.0, Shifted("ridge_base", 6.0, 0.0)])])),
        ("ridge_slope_z", Add(["ridge_base", Mul([-1.0, Shifted("ridge_base", 0.0, 6.0)])])),
        ("ridged", Add(["ridge_base", Mul([0.6, Shifted("ridge_detail", Mul([1500.0, Abs("ridge_slope_x")]), Mul([1500.0, Abs("ridge_slope_z")]))])])),
        ("peaks", Mul(["jag", Add([0.6, Mul([-1.0, "ridged"])])])),

        // Trench and ridge lines across the deep sea floor, and swells.
        ("seabed", Mul([
            Spline(on: "C", points: [(-0.4, 1.0), (-0.3, 0.0)]),
            Add([Mul([0.06, Max([0.0, Add([1.0, Mul([-6.0, Abs("ocean_lines")])])])]), Mul([0.05, "ocean_bumps"])]),
        ])),
        // A block or two of bumps on land.
        ("texture", Mul([Spline(on: "C", points: [(-0.2, 0.0), (-0.155, 0.011)]), "bumps"])),

        ("surface", Add(["offset", "lift", "rolling_land", "peaks", "seabed", "texture"])),

        // What the rest of the generator reads of the land.
        ("mountain", Spline(on: "C", points: [(-0.16, 0.0), (0.0, Spline(on: "Ef", points: [(0.15, 1.0), (0.375, 0.0)]))])),
        ("peak", Mul(["mountain", Spline(on: "Ef", points: [(0.0, 1.0), (0.15, 0.0)])])),
        ("roughness", Max(["mountain", Mul([
            Spline(on: "C", points: [(-0.16, 0.0), (-0.1, 1.0)]),
            Spline(on: "Ef", points: [(0.375, 0.7), (0.5, 0.45), (0.825, 0.4), (0.95, 0.0)]),
        ])])),
        ("valley", Spline(on: "Wf", points: [(0.03, 1.0), (0.2, 0.0)])),
        // How far the 3D density moves the ground, in blocks (see `density` below): up to
        // nine on the spines of ranges, where rock breaks into crags, ledges and overhangs,
        // a few on their foothills, none on the lowland.
        ("crag", Mul([
            Spline(on: "C", points: [(-0.1, 0.0), (0.05, 1.0)]),
            Spline(on: "Ef", points: [(0.0, 9.0), (0.18, 6.0), (0.3, 2.5), (0.4, 0.0)]),
        ])),
    ],
    // The 3D noise `crag` moves the ground by: wavelength in blocks, octaves, how much
    // faster it changes up than across (ledges), and how much more slowly density falls
    // above the surface than below it (overhangs).
    density: (wavelength: 56.0, octaves: 2, squash: 1.5, above: 0.5),
    vertical_scale: 1.0,
    elevation_boost: 0.15,
    ceiling: (190.0, 48.0),
)
