// Ground decorations: a shared pool biomes draw from by tag or name (by default, every
// decoration carrying one of the biome's tags), placed in a fixed order of stages decided by
// their shape: Patch (ground repainted), then Bush (with the trees), then the ornaments trees
// make of their own blocks (Litter, LeafPiles, Foot), then Boulder, Rocks and
// StandingStones, then FallenLog and Stump. The small plants and the snow blanket follow.
//
// Placed decorations stand about one every `spacing` blocks each way where they are
// densest (most are sparse on purpose: a biome's character comes from one or two signature
// features, which biomes raise with their `decorations` weights, not from clutter); ornaments decorate a `chance` share of the trees `trees` selects. Density is then
// scaled by the biome's weight, the rarity (Common .. Legendary), how well the climate suits
// it (`comfort`), and each ramp in `follows`: `(field, from, to)` rises smoothly from 0 at
// `from` to 1 at `to` (or falls, with `from` above `to`). Fields: Forest (tree cover),
// Stand (the forest's structure: gaps and scrubby edges low, old-growth cores high),
// Clearing (0 outside clearings, 1 inside), Fertility, Moisture, Temperature, Slope,
// River, Altitude, Aether, and Noise((name, scale, octaves)) for clusters.
//
// Stones: `Stones` are those of the rock province (or the biome's own); wood and leaves
// come from the trees growing at the spot, so a fallen log in a birch wood is birch.
(
    decorations: [
        // --- Patches ------------------------------------------------------------------
        (
            // Bare, trampled earth.
            name: "dirt_patch", tags: ["grassland", "forest", "steppe", "savanna"],
            shape: Patch(radius: (1.2, 3.0), top: Mix([Name("coarse_dirt", 3.0), Name("rooted_dirt", 1.0)])),
            spacing: 48.0,
            follows: [(Noise((name: "bare_ground", scale: 90.0, octaves: 2)), -0.2, 0.4)],
        ),
        (
            name: "moss_patch", tags: ["forest", "wetland", "dense"],
            shape: Patch(radius: (1.5, 3.8), top: Block("moss_block")),
            spacing: 22.0,
            follows: [(Forest, 0.2, 0.6), (Moisture, 0.75, 1.2)],
        ),
        (
            name: "gravel_patch", tags: ["mountain", "highland", "tundra", "steppe"],
            shape: Patch(radius: (1.0, 2.8), top: Mix([Name("gravel", 3.0), Name("coarse_dirt", 1.0)])),
            spacing: 36.0,
        ),
        (
            // The worn floor of clearings, where deer bed down.
            name: "clearing_floor", tags: ["forest", "clearing"],
            shape: Patch(radius: (1.5, 3.5), top: Mix([Name("coarse_dirt", 2.0), Name("rooted_dirt", 1.0), Name("podzol", 1.0)])),
            spacing: 18.0,
            follows: [(Clearing, 0.4, 0.9)],
        ),
        (
            name: "mud_patch", tags: ["wetland", "jungle"],
            shape: Patch(radius: (1.5, 3.5), top: Block("mud")),
            spacing: 22.0,
            follows: [(Moisture, 1.0, 1.4)],
        ),

        // --- Rocks --------------------------------------------------------------------
        (
            // Lumps of the rock beneath, in fields of them, mossy in damp woods.
            name: "boulder", tags: ["forest", "grassland", "mountain", "highland", "tundra", "rocky"],
            shape: Boulder(radius: (1.6, 2.2), stones: Stones, moss: 0.7),
            spacing: 40.0,
            follows: [(Noise((name: "boulder_fields", scale: 140.0, octaves: 2)), -0.15, 0.45)],
        ),
        (
            name: "big_boulder", tags: ["forest", "mountain", "highland", "tundra"], rarity: Uncommon,
            shape: Boulder(radius: (2.0, 3.2), stones: Stones, moss: 0.8),
            spacing: 64.0,
            follows: [(Noise((name: "boulder_fields", scale: 140.0, octaves: 2)), 0.1, 0.6)],
        ),
        (
            // Erratics: great boulders a glacier carried from far away, of rock unlike the
            // ground they lie on.
            name: "erratic", tags: ["erratics"],
            shape: Boulder(radius: (1.8, 3.4), stones: Mix([Name("andesite", 3.0), Name("stone", 2.0), Name("diorite", 0.5)]), moss: 0.3),
            spacing: 34.0,
        ),
        (
            // Clusters of ice crystals and pale stone.
            name: "ice_crystals", tags: ["crystals"],
            shape: Rocks(count: (2, 5), spread: 2.5, size: (0.6, 1.4), stones: Mix([Name("blue_ice", 2.0), Name("packed_ice", 2.0), Name("calcite", 1.0)])),
            spacing: 9.0,
        ),
        (
            // Loose stones scattered down slopes.
            name: "scree", tags: ["mountain", "highland", "tundra", "rocky", "steppe"],
            shape: Rocks(count: (2, 4), spread: 2.2, size: (1.0, 1.4), stones: Stones, moss: 0.2),
            spacing: 18.0,
            follows: [(Slope, 0.3, 2.0)],
        ),
        (
            // A few stones among the grass: a small clump of rounded stones, where the
            // boulder fields run, never a lone cube.
            name: "stones", tags: ["forest", "grassland", "savanna", "steppe", "tundra"],
            shape: Rocks(count: (2, 3), spread: 2.0, size: (1.2, 1.5), stones: Stones, moss: 0.5),
            spacing: 64.0,
            follows: [(Noise((name: "boulder_fields", scale: 140.0, octaves: 2)), -0.05, 0.5)],
        ),
        (
            name: "desert_rocks", tags: ["desert", "mesa"],
            shape: Rocks(count: (2, 4), spread: 2.2, size: (1.2, 1.6), stones: Stones),
            spacing: 44.0,
        ),

        // --- Landmarks and wonders ----------------------------------------------------
        (
            // A ring of old standing stones on open high ground, commoner where the aether
            // runs strong: a landmark, a few hundred blocks apart at the most.
            name: "standing_stones", tags: ["grassland", "heath", "highland", "tundra"], rarity: VeryRare,
            shape: StandingStones(radius: (3.5, 6.0), count: (5, 11), height: (2, 4), stones: Stones),
            spacing: 90.0,
            follows: [(Slope, 2.0, 0.5), (Aether, 0.1, 0.7)],
        ),
        (
            // A fairy ring of glowing mushrooms in a damp wood, where aether runs high.
            name: "fairy_ring", tags: ["forest", "wetland", "fantastical"], rarity: Rare,
            shape: FairyRing(radius: (2.5, 5.0), plants: [Name("glowcap", 3.0), Name("dreamshade", 1.0), Name("brown_mushroom", 1.0)]),
            spacing: 50.0,
            follows: [(Aether, 0.4, 0.9), (Moisture, 0.8, 1.1), (Slope, 2.0, 1.0)],
        ),

        // --- Bushes (spacings ×√2, half as many, with the plant density cut) ------------
        (
            // Scrub at the edges of stands and in the forest's gaps.
            name: "undergrowth", tags: ["forest"],
            shape: Bush(radius: (0.9, 1.7)),
            spacing: 22.6,
            follows: [(Stand, 0.55, 0.15)],
        ),
        (
            // The mantle of shrubs that rings a clearing, reaching further in than trees.
            name: "clearing_edge", tags: ["forest"],
            shape: Bush(radius: (1.0, 1.9)),
            spacing: 17.0,
            follows: [(Clearing, 0.05, 0.3), (Clearing, 0.85, 0.55)],
        ),
        (
            name: "meadow_bush", tags: ["grassland", "savanna"],
            shape: Bush(radius: (0.9, 1.6)),
            spacing: 79.0,
        ),

        // --- Tree ornaments -----------------------------------------------------------
        (
            // Needles under conifers.
            name: "needle_litter", tags: ["forest", "conifer", "mountain", "highland", "cold"],
            shape: Litter(top: Mix([Name("podzol", 4.0), Name("coarse_dirt", 1.0)]), cover: 0.5),
            trees: [Tag("conifer", 1.0)],
        ),
        (
            // Leaf mould near broadleaf trunks.
            name: "leaf_litter", tags: ["forest"],
            shape: Litter(top: Mix([Name("rooted_dirt", 2.0), Name("coarse_dirt", 2.0), Name("podzol", 1.0)]), cover: 0.2),
            trees: [Tag("broadleaf", 1.0)],
            follows: [(Forest, 0.2, 0.6)],
        ),
        (
            name: "deep_litter", tags: ["dense"],
            shape: Litter(top: Mix([Name("podzol", 2.0), Name("rooted_dirt", 2.0), Name("coarse_dirt", 1.0)]), cover: 0.45),
            trees: [Tag("broadleaf", 1.0)],
        ),
        (
            // Drifts of fallen leaves and petals under autumn and blossom trees.
            name: "fallen_leaves", tags: ["forest", "grassland", "autumn", "blossom"],
            shape: LeafPiles(cover: 0.05),
            trees: [Tag("autumn", 1.0), Tag("blossom", 1.0)],
        ),
        (
            // Wild bees nest in hollows at the foot of broadleaf, fruit and blossom trees
            // where flowers grow thick: flower meadows, cherry groves and lavender fields
            // (bees.ron; the Humming in the Meadow quest says so, and a test holds it to this).
            name: "bee_nest", tags: ["flowers", "blossom"],
            shape: Foot(plants: [Name("bee_nest", 1.0)], cover: 0.25),
            chance: 0.2,
            trees: [Tag("broadleaf", 1.0), Tag("fruit", 1.0), Tag("blossom", 1.0)],
        ),
        (
            // Mushrooms at the foot of trunks in damp woods.
            name: "foot_fungi", tags: ["forest", "wetland"],
            shape: Foot(plants: [Tag("fungus", 1.0)], cover: 0.25),
            chance: 0.15,
            trees: [Tag("broadleaf", 1.0), Tag("conifer", 1.0)],
            follows: [(Moisture, 0.7, 1.1)],
        ),

        // --- Logs ---------------------------------------------------------------------
        (
            // Trunks lying where they fell, where the trees stand thickest: some with
            // branches, some by the stump they broke from, fungi and ferns on top.
            name: "fallen_log", tags: ["forest"],
            shape: FallenLog(
                length: (4, 7), thick: 0.04, hollow: 0.6, branches: 0.5, stump: 0.45, growth: 0.25,
                plants: [Tag("fungus", 2.0), Tag("fern", 1.0), Name("short_grass", 1.0)],
            ),
            spacing: 30.0,
            follows: [(Forest, 0.15, 0.6), (Stand, 0.15, 0.6)],
        ),
        (
            // Old, mossy and rotting, in damp woods.
            name: "rotting_log", tags: ["forest", "wetland", "dense"],
            shape: FallenLog(
                length: (3, 6), thick: 0.1, hollow: 0.8, branches: 0.2, stump: 0.3, growth: 0.6,
                plants: [Tag("fungus", 2.0), Tag("fern", 2.0), Tag("forest_floor", 1.0)],
            ),
            spacing: 36.0,
            follows: [(Forest, 0.2, 0.7), (Moisture, 0.9, 1.3)],
        ),
        (
            // Windthrow: trunks and snapped stumps in clearings.
            name: "windthrow", tags: ["forest", "clearing"],
            shape: FallenLog(length: (4, 8), branches: 0.7, stump: 0.7, growth: 0.15, plants: [Tag("fungus", 1.0), Name("short_grass", 2.0)]),
            spacing: 26.0,
            follows: [(Clearing, 0.3, 0.8)],
        ),
        (
            name: "snag", tags: ["forest", "clearing"],
            shape: Stump(height: (2, 4), growth: 0.3, plants: [Tag("fungus", 1.0)]),
            spacing: 24.0,
            follows: [(Clearing, 0.35, 0.8)],
        ),
        (
            name: "stump", tags: ["forest"],
            shape: Stump(height: (1, 2), growth: 0.4, plants: [Tag("fungus", 2.0), Name("short_grass", 1.0)]),
            spacing: 48.0,
            follows: [(Forest, 0.15, 0.5)],
        ),
        // Last, so it takes its chance after every other decoration's (`choose` gives earlier
        // entries theirs first) and moves none of them.
        (
            // Flint nodules weathered out of the ground, lying loose in the grass and on the
            // forest floor, on beach and desert sand, under snow and on bare rock and gravel:
            // a bare hand picks them up, and two make a flint tool's head. The spawn kit
            // (spawn_kit.ron) makes sure of some by every spawn.
            name: "loose_flint", tags: ["open", "forest", "grassland", "scrubland", "savanna", "steppe", "tundra", "heath", "highland", "mountain", "rocky", "wetland", "jungle", "desert", "mesa"],
            shape: Scatter(count: (1, 3), spread: 3.0, block: "loose_flint"),
            ground: [Soil, Snow, Sand, Bare],
            spacing: 12.0,
        ),
    ],
)
