// What creatures give (creatures.ron): meat, hides, fur, feathers and stranger things.
// All are only ever items, drawn as sprites (packs/default/recipes/creature_drops.ron).
// Tags say what each is to other systems, never which creature it came from: `meat` and
// `raw` for cooking (docs/food-and-cooking.md), healing 1 eaten raw (vitals),
// `hide`, `fur`, `bone` and the like for crafting to come, `knife` and friends on tools.
// Supernatural drops carry `aether`.
(
    templates: {
        // An item that is only ever an item: `{name}` with its own sprite.
        "drop": [
            (name: "{name}", render: Plant, solid: false, item: true, textures: All("{name}"), hardness: 0.0, color: (180, 140, 120)),
        ],
    },
    families: [
        // Meat: heals a little raw, more once cooked.
        (template: "drop", name: "raw_small_game", tags: ["meat", "raw", "edible", "flavour:savoury"], all: (color: (220, 120, 120))),
        (template: "drop", name: "raw_duck", tags: ["meat", "raw", "edible", "flavour:savoury", "fat"], all: (color: (200, 110, 100), rarity: Uncommon)),
        (template: "drop", name: "raw_mutton", tags: ["meat", "raw", "edible", "flavour:savoury"], all: (color: (200, 80, 80))),
        (template: "drop", name: "raw_pork", tags: ["meat", "raw", "edible", "flavour:savoury", "fat"], all: (color: (240, 150, 150))),
        (template: "drop", name: "raw_beef", tags: ["meat", "raw", "edible", "flavour:savoury"], all: (color: (190, 50, 50))),
        (template: "drop", name: "raw_venison", tags: ["meat", "raw", "edible", "flavour:savoury", "game"], all: (color: (150, 40, 40))),
        (template: "drop", name: "raw_bear", tags: ["meat", "raw", "edible", "flavour:savoury", "game", "fat"], all: (color: (130, 40, 40), rarity: Uncommon)),
        (template: "drop", name: "raw_crab", tags: ["meat", "raw", "edible", "flavour:savoury", "seafood"], all: (color: (220, 120, 80))),
        // Old Tusk's great tusk (creatures_bosses.ron): one a kill, the head of a tusk club.
        (template: "drop", name: "great_tusk", tags: ["trophy", "bone"], all: (color: (236, 226, 200), rarity: Uncommon)),
        // Old Tusk's rare keepsake: worn in the charm slot, it quickens your stride (effects.ron's `tusk_stride`).
        (template: "drop", name: "charge_charm", tags: ["trophy", "charm", "charge_charm"], all: (color: (224, 206, 168), rarity: VeryRare)),
        // The Rootmother's heart of root (lairs.ron): eaten raw it heals and leaves the
        // Heartwood buff; it stacks, being a root and not a meal.
        (template: "drop", name: "heartroot", tags: ["root", "edible", "effect:heartwood:600", "flavour:bitter", "alchemy:healing", "alchemy:hearty"], all: (color: (150, 60, 50), rarity: Uncommon)),
        // Skins and fur.
        // Every warm pelt is fur (P27, 2026-10-07: fewer items, many ways to get each).
        (template: "drop", name: "fur", tags: ["hide", "fur", "warm"], all: (color: (150, 110, 70))),
        // A hide comes off a beast raw: hung on a drying rack it cures to hide (stations.ron).
        (template: "drop", name: "raw_hide", tags: ["raw_hide"], all: (color: (165, 110, 85))),
        (template: "drop", name: "hide", tags: ["hide", "leather"], all: (color: (140, 95, 60))),
        (template: "drop", name: "quill", tags: ["quill", "small"], all: (color: (200, 190, 170))),
        (template: "drop", name: "scute", tags: ["shell", "armour"], all: (color: (110, 100, 60))),
        (template: "drop", name: "horn", tags: ["horn", "bone"], all: (color: (60, 56, 52), rarity: Uncommon)),
        (template: "drop", name: "ember_scale", tags: ["scale", "aether", "fire"], all: (color: (240, 120, 40), light: 6, rarity: Uncommon)),
        (template: "drop", name: "snail_shell", tags: ["shell", "small"], all: (color: (150, 106, 60))),
        (template: "drop", name: "horsehair", tags: ["fibre", "hair"], all: (color: (60, 50, 44))),
        (template: "drop", name: "sunwing_feather", tags: ["feather", "aether", "fire"], all: (color: (255, 200, 80), light: 8, rarity: Uncommon)),
        (template: "drop", name: "frost_antler", tags: ["antler", "aether", "cold"], all: (color: (190, 220, 250), light: 5, rarity: Uncommon)),
        (template: "drop", name: "bat_wing", tags: ["membrane", "small"], all: (color: (60, 50, 48))),
        (template: "drop", name: "spore_cap", tags: ["fungus", "aether", "edible"], all: (color: (160, 90, 200), light: 5, rarity: Uncommon)),
        (template: "drop", name: "beetle_crystal", tags: ["crystal", "aether"], all: (color: (120, 210, 230), light: 6, rarity: Uncommon)),
        (template: "drop", name: "wool", tags: ["fibre", "wool", "warm"], all: (color: (235, 232, 222))),
        (template: "drop", name: "feather", tags: ["feather", "light"], all: (color: (240, 240, 235))),
        // Parts.
        (template: "drop", name: "bone", tags: ["bone", "fertiliser"], all: (color: (230, 225, 205))),
        (template: "drop", name: "fang", tags: ["tooth", "sharp", "trophy"], all: (color: (240, 236, 220), rarity: Uncommon)),
        (template: "drop", name: "antler", tags: ["antler", "bone", "trophy"], all: (color: (205, 185, 150), rarity: Uncommon)),
        (template: "drop", name: "rabbit_foot", tags: ["trophy", "alchemy:luck"], all: (color: (200, 175, 140), rarity: Rare)),
        (template: "drop", name: "lard", tags: ["fat", "cooking", "fuel"], all: (color: (245, 240, 225))),
        // From monsters.
        (template: "drop", name: "silk", tags: ["fibre", "silk", "string"], all: (color: (230, 230, 240))),
        (template: "drop", name: "venom_sac", tags: ["alchemy:poison", "venom"], all: (color: (120, 190, 80), rarity: Uncommon)),
        (template: "drop", name: "rotten_flesh", tags: ["meat", "rotten", "bait", "edible"], all: (color: (120, 130, 80))),
        // Supernatural.
        (template: "drop", name: "moonhare_pelt", tags: ["hide", "fur", "aether", "glowing", "alchemy:luminous"], all: (color: (190, 215, 250), rarity: Uncommon)),
        (template: "drop", name: "moon_dust", tags: ["aether", "dust", "alchemy:luminous", "alchemy:night_sight"], all: (color: (210, 225, 255), rarity: Uncommon)),
        (template: "drop", name: "lumen_slime", tags: ["aether", "slime", "glowing", "alchemy:luminous", "alchemy:night_sight"], all: (color: (110, 240, 210), rarity: Uncommon)),
        (template: "drop", name: "aether_mote", tags: ["aether", "alchemy:aether"], all: (color: (230, 200, 255), rarity: Uncommon)),
    ],
)
