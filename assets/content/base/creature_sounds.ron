        // Howls, growls, whines and yelps.
        "wolf": (
            size: 0.9,
            calls: (dawn: 0.2, day: 0.05, dusk: 0.4, night: 0.45),
            idle: (clips: ["sounds/creatures/wolf/idle_1.ogg", "sounds/creatures/wolf/idle_2.ogg", "sounds/creatures/wolf/idle_3.ogg", "sounds/creatures/wolf/idle_4.ogg"]),
            alert: (clips: ["sounds/creatures/wolf/alert_1.ogg", "sounds/creatures/wolf/alert_2.ogg", "sounds/creatures/wolf/alert_3.ogg", "sounds/creatures/wolf/alert_4.ogg"]),
            rest: (clips: ["sounds/creatures/wolf/rest_1.ogg", "sounds/creatures/wolf/rest_2.ogg", "sounds/creatures/wolf/rest_3.ogg"]),
            call: (clips: ["sounds/creatures/wolf/call_1.ogg", "sounds/creatures/wolf/call_2.ogg"], range: 96.0),
            ready: (clips: ["sounds/creatures/wolf/ready_1.ogg", "sounds/creatures/wolf/ready_2.ogg"]),
            attack: (clips: ["sounds/creatures/wolf/attack_1.ogg", "sounds/creatures/wolf/attack_2.ogg", "sounds/creatures/wolf/attack_3.ogg"]),
            // Warning a player off: its snarls slowed into a low growl.
            warn: (clips: ["sounds/creatures/wolf/attack_1.ogg", "sounds/creatures/wolf/attack_2.ogg", "sounds/creatures/wolf/attack_3.ogg"], pitch: (0.74, 0.82), gain: 0.65, range: 24.0),
            hurt: (clips: ["sounds/creatures/wolf/hurt_1.ogg", "sounds/creatures/wolf/hurt_2.ogg", "sounds/creatures/wolf/hurt_3.ogg"]),
            death: (clips: ["sounds/creatures/wolf/death_1.ogg", "sounds/creatures/wolf/death_2.ogg"]),
        ),
        // A settlement's hound: a wolf's voice, but barking as it wanders and only now and
        // then howling, by night least of all, so a hound by a home lets it sleep.
        "hound": (
            like: "wolf",
            calls: (dawn: 0.05, day: 0.05, dusk: 0.05, night: 0.02),
            idle: (clips: ["sounds/creatures/wolf/alert_1.ogg", "sounds/creatures/wolf/alert_2.ogg", "sounds/creatures/wolf/alert_3.ogg", "sounds/creatures/wolf/alert_4.ogg"], gain: 0.4),
        ),
        // Yips, barks and the vixen's scream.
        "fox": (
            size: 0.6,
            idle: (clips: ["sounds/creatures/fox/idle_1.ogg", "sounds/creatures/fox/idle_2.ogg", "sounds/creatures/fox/idle_3.ogg"]),
            alert: (clips: ["sounds/creatures/fox/alert_1.ogg", "sounds/creatures/fox/alert_2.ogg", "sounds/creatures/fox/alert_3.ogg", "sounds/creatures/fox/alert_4.ogg"]),
            call: (clips: ["sounds/creatures/fox/call_1.ogg", "sounds/creatures/fox/call_2.ogg", "sounds/creatures/fox/call_3.ogg"]),
            ready: (clips: ["sounds/creatures/fox/ready_1.ogg", "sounds/creatures/fox/ready_2.ogg", "sounds/creatures/fox/ready_3.ogg", "sounds/creatures/fox/ready_4.ogg"], range: 56.0),
            hurt: (clips: ["sounds/creatures/fox/hurt_1.ogg", "sounds/creatures/fox/hurt_2.ogg"]),
            death: (clips: ["sounds/creatures/fox/death_1.ogg"]),
        ),
        // Growls and huffs.
        "bear": (
            size: 1.4,
            idle: (clips: ["sounds/creatures/bear/idle_1.ogg", "sounds/creatures/bear/idle_2.ogg", "sounds/creatures/bear/idle_3.ogg"]),
            alert: (clips: ["sounds/creatures/bear/alert_1.ogg", "sounds/creatures/bear/alert_2.ogg", "sounds/creatures/bear/alert_3.ogg"]),
