            alert: (clips: ["sounds/creatures/fowl/alert_1.ogg", "sounds/creatures/fowl/alert_2.ogg", "sounds/creatures/fowl/alert_3.ogg", "sounds/creatures/fowl/alert_4.ogg"]),
            call: (clips: ["sounds/creatures/fowl/call_1.ogg", "sounds/creatures/fowl/call_2.ogg", "sounds/creatures/fowl/call_3.ogg", "sounds/creatures/fowl/call_4.ogg"], range: 72.0),
            ready: (clips: ["sounds/creatures/fowl/ready_1.ogg", "sounds/creatures/fowl/ready_2.ogg"]),
