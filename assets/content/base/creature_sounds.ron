            size: 1.5,
            idle: (clips: ["sounds/creatures/deer/idle_1.ogg", "sounds/creatures/deer/idle_2.ogg", "sounds/creatures/deer/idle_3.ogg", "sounds/creatures/deer/idle_4.ogg", "sounds/creatures/deer/idle_5.ogg"]),
            alert: (clips: ["sounds/creatures/deer/alert_1.ogg", "sounds/creatures/deer/alert_2.ogg", "sounds/creatures/deer/alert_3.ogg"]),
            call: (clips: ["sounds/creatures/deer/call_1.ogg", "sounds/creatures/deer/call_2.ogg", "sounds/creatures/deer/call_3.ogg"]),
