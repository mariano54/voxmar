            idle: (clips: ["sounds/creatures/horse/idle_1.ogg", "sounds/creatures/horse/idle_2.ogg", "sounds/creatures/horse/idle_3.ogg", "sounds/creatures/horse/idle_4.ogg", "sounds/creatures/horse/idle_5.ogg", "sounds/creatures/horse/idle_6.ogg"]),
            graze: (clips: ["sounds/creatures/horse/graze_1.ogg", "sounds/creatures/horse/graze_2.ogg", "sounds/creatures/horse/graze_3.ogg", "sounds/creatures/horse/graze_4.ogg", "sounds/creatures/horse/graze_5.ogg", "sounds/creatures/horse/graze_6.ogg"], chance: 0.7),
            alert: (clips: ["sounds/creatures/horse/alert_1.ogg", "sounds/creatures/horse/alert_2.ogg", "sounds/creatures/horse/alert_3.ogg"]),
            rest: (clips: ["sounds/creatures/horse/rest_1.ogg", "sounds/creatures/horse/rest_2.ogg", "sounds/creatures/horse/rest_3.ogg"]),
            call: (clips: ["sounds/creatures/horse/call_1.ogg", "sounds/creatures/horse/call_2.ogg", "sounds/creatures/horse/call_3.ogg", "sounds/creatures/horse/call_4.ogg", "sounds/creatures/horse/call_5.ogg"]),
