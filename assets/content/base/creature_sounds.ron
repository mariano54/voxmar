// Creature voices: what each species sounds like. Read by the client
// (crates/client/src/creature_sounds); any package may add a `creature_sounds.ron`, and a
// later package's voices and species replace earlier ones by name, so a sound pack can
// revoice the world.
//
// - A voice is the sounds of one kind of animal, each event several recordings, one
//   picked at random each time at a slightly different pitch. Events: step, idle,
//   graze, alert, rest, call, ready (to breed), attack, warn (warning a player off before
//   it attacks), hurt, death, and the barks of settlements' people: greet, alarm, content.
//   A voice lacking one takes it from the voice it is `like`, then falls back to the
//   nearest event it has (alert and ready to call, call to idle, attack, warn and hurt to
//   alert, death to hurt).
// - `size` is the height in blocks of the animal recorded: a species of another height
//   sounds higher or lower (by the square root of the ratio), each individual a little
//   more for its genes, the young higher still. A species' `pitch` overrides it.
// - Each event may set `gain` (its loudness; by default the event's usual one: a call
//   loud, a munch soft), `pitch: (low, high)` (the random spread), `range` (blocks at
//   which it fades away; by default the event's usual reach) and `chance` (of sounding
//   at all).
// - `calls` says how much of a voice's chatter as it wanders is a call rather than an
//   idle sound, through each part of the day (`dawn` and `dusk` straddle sunrise and
//   sunset, `day` and `night` lie between); unset, a quarter at every hour. The cock
//   crows at dawn, songbirds sing the dawn chorus, cattle low at dusk, wolves howl and
//   frogs croak after dark.
// - `ground: false` silences the ground underfoot for things that fly, float or slide;
//   others' steps sound the block they walk on, as the player's do.
// - `aether` (0..1) on a species makes it otherworldly: a shimmer, a glassy ring and a
//   bright echo. Supernatural species have 0.5 unless they say.
//
// Recordings: Freesound, CC0 and CC-BY (credited in THIRD_PARTY_NOTICES.md); the rest are
// synthesized (hisses, slime, wings, clicks, embers, chimes).
(
    voices: {
        // Munching, shared by small grazers.
        "grazer_small": (
            graze: (clips: ["sounds/creatures/grazer_small/graze_1.ogg", "sounds/creatures/grazer_small/graze_2.ogg", "sounds/creatures/grazer_small/graze_3.ogg"], chance: 0.7),
        ),
        // Munching and slow breaths, shared by cattle and their kin.
        "grazer_large": (
            graze: (clips: ["sounds/creatures/grazer_large/graze_1.ogg", "sounds/creatures/grazer_large/graze_2.ogg", "sounds/creatures/grazer_large/graze_3.ogg", "sounds/creatures/grazer_large/graze_4.ogg", "sounds/creatures/grazer_large/graze_5.ogg"], chance: 0.7),
            rest: (clips: ["sounds/creatures/grazer_large/rest_1.ogg", "sounds/creatures/grazer_large/rest_2.ogg"]),
        ),
        // Bleats.
        "sheep": (
            like: "grazer_small",
            size: 0.95,
            idle: (clips: ["sounds/creatures/sheep/idle_1.ogg", "sounds/creatures/sheep/idle_2.ogg", "sounds/creatures/sheep/idle_3.ogg", "sounds/creatures/sheep/idle_4.ogg", "sounds/creatures/sheep/idle_5.ogg"]),
            alert: (clips: ["sounds/creatures/sheep/alert_1.ogg", "sounds/creatures/sheep/alert_2.ogg"]),
            call: (clips: ["sounds/creatures/sheep/call_1.ogg", "sounds/creatures/sheep/call_2.ogg", "sounds/creatures/sheep/call_3.ogg", "sounds/creatures/sheep/call_4.ogg"]),
            ready: (clips: ["sounds/creatures/sheep/ready_1.ogg", "sounds/creatures/sheep/ready_2.ogg"]),
            hurt: (clips: ["sounds/creatures/sheep/hurt_1.ogg", "sounds/creatures/sheep/hurt_2.ogg", "sounds/creatures/sheep/hurt_3.ogg"]),
            death: (clips: ["sounds/creatures/sheep/death_1.ogg", "sounds/creatures/sheep/death_2.ogg"]),
        ),
        // Bleats, rutting blubbers and the clack of horns.
        "goat": (
            like: "grazer_small",
            size: 1.0,
            idle: (clips: ["sounds/creatures/goat/idle_1.ogg", "sounds/creatures/goat/idle_2.ogg", "sounds/creatures/goat/idle_3.ogg"]),
            call: (clips: ["sounds/creatures/goat/call_1.ogg", "sounds/creatures/goat/call_2.ogg", "sounds/creatures/goat/call_3.ogg"]),
            ready: (clips: ["sounds/creatures/goat/ready_1.ogg", "sounds/creatures/goat/ready_2.ogg"]),
            attack: (clips: ["sounds/creatures/goat/attack_1.ogg"]),
            hurt: (clips: ["sounds/creatures/goat/hurt_1.ogg", "sounds/creatures/goat/hurt_2.ogg"]),
            death: (clips: ["sounds/creatures/goat/death_1.ogg"]),
        ),
        // Moos and bull bellows.
        "cattle": (
            like: "grazer_large",
            size: 1.45,
            calls: (dusk: 0.4),
            idle: (clips: ["sounds/creatures/cattle/idle_1.ogg", "sounds/creatures/cattle/idle_2.ogg", "sounds/creatures/cattle/idle_3.ogg", "sounds/creatures/cattle/idle_4.ogg"]),
            alert: (clips: ["sounds/creatures/cattle/alert_1.ogg", "sounds/creatures/cattle/alert_2.ogg"]),
            call: (clips: ["sounds/creatures/cattle/call_1.ogg", "sounds/creatures/cattle/call_2.ogg", "sounds/creatures/cattle/call_3.ogg"]),
            ready: (clips: ["sounds/creatures/cattle/ready_1.ogg", "sounds/creatures/cattle/ready_2.ogg"]),
            hurt: (clips: ["sounds/creatures/cattle/hurt_1.ogg", "sounds/creatures/cattle/hurt_2.ogg"]),
            death: (clips: ["sounds/creatures/cattle/death_1.ogg", "sounds/creatures/cattle/death_2.ogg"]),
        ),
        // Nasal huffs, otherwise as cattle.
        "bison": (
            like: "cattle",
            size: 1.4,
            idle: (clips: ["sounds/creatures/bison/idle_1.ogg", "sounds/creatures/bison/idle_2.ogg", "sounds/creatures/bison/idle_3.ogg", "sounds/creatures/bison/idle_4.ogg"]),
            alert: (clips: ["sounds/creatures/bison/alert_1.ogg"]),
        ),
        // Grunts, snorts and squeals.
        "pig": (
            size: 0.85,
            idle: (clips: ["sounds/creatures/pig/idle_1.ogg", "sounds/creatures/pig/idle_2.ogg", "sounds/creatures/pig/idle_3.ogg", "sounds/creatures/pig/idle_4.ogg", "sounds/creatures/pig/idle_5.ogg", "sounds/creatures/pig/idle_6.ogg", "sounds/creatures/pig/idle_7.ogg", "sounds/creatures/pig/idle_8.ogg", "sounds/creatures/pig/idle_9.ogg", "sounds/creatures/pig/idle_10.ogg", "sounds/creatures/pig/idle_11.ogg"]),
            graze: (clips: ["sounds/creatures/pig/graze_1.ogg", "sounds/creatures/pig/graze_2.ogg", "sounds/creatures/pig/graze_3.ogg", "sounds/creatures/pig/graze_4.ogg", "sounds/creatures/pig/graze_5.ogg", "sounds/creatures/pig/graze_6.ogg"], chance: 0.7),
            alert: (clips: ["sounds/creatures/pig/alert_1.ogg", "sounds/creatures/pig/alert_2.ogg", "sounds/creatures/pig/alert_3.ogg", "sounds/creatures/pig/alert_4.ogg"]),
            rest: (clips: ["sounds/creatures/pig/rest_1.ogg", "sounds/creatures/pig/rest_2.ogg", "sounds/creatures/pig/rest_3.ogg", "sounds/creatures/pig/rest_4.ogg"]),
            call: (clips: ["sounds/creatures/pig/call_1.ogg", "sounds/creatures/pig/call_2.ogg"]),
            attack: (clips: ["sounds/creatures/pig/attack_1.ogg", "sounds/creatures/pig/attack_2.ogg"]),
            hurt: (clips: ["sounds/creatures/pig/hurt_1.ogg", "sounds/creatures/pig/hurt_2.ogg"]),
            death: (clips: ["sounds/creatures/pig/death_1.ogg", "sounds/creatures/pig/death_2.ogg"]),
        ),
        // Barks of alarm, bleats and the roars of the rut.
        "deer": (
