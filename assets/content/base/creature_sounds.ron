            warn: (clips: ["sounds/creatures/bear/attack_1.ogg", "sounds/creatures/bear/attack_2.ogg", "sounds/creatures/bear/attack_3.ogg"], pitch: (0.82, 0.9), gain: 0.85, range: 40.0),
