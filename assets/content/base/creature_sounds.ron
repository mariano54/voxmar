        // Trills.
        "quail": (
            size: 0.32,
            idle: (clips: ["sounds/creatures/quail/idle_1.ogg", "sounds/creatures/quail/idle_2.ogg", "sounds/creatures/quail/idle_3.ogg", "sounds/creatures/quail/idle_4.ogg"]),
            call: (clips: ["sounds/creatures/quail/call_1.ogg", "sounds/creatures/quail/call_2.ogg", "sounds/creatures/quail/call_3.ogg", "sounds/creatures/quail/call_4.ogg", "sounds/creatures/quail/call_5.ogg"]),
