// Cooking (engine/src/cooking.rs, docs/food-and-cooking.md): what each station cooks.
// `input` is an item (or `tag:` and a tag), `station` the tag of the station block, `level`
// the Cooking level it takes, `xp` the experience for one that doesn't burn. Burning starts
// at `level` (half the time) and stops at `stop_burning`; burnt food is `burnt_food`.
(
    recipes: [
        (input: "raw_rabbit", output: "cooked_rabbit", level: 1, xp: 30.0, stop_burning: 15, burnt: "burnt_food"),
        (input: "raw_chicken", output: "cooked_chicken", level: 1, xp: 30.0, stop_burning: 15, burnt: "burnt_food"),
        (input: "potato", output: "baked_potato", level: 2, xp: 32.0, stop_burning: 16, burnt: "burnt_food"),
        (input: "carrot", output: "roast_carrot", level: 2, xp: 28.0, stop_burning: 14, burnt: "burnt_food"),
        (input: "egg", output: "fried_egg", level: 1, xp: 20.0, stop_burning: 12, burnt: "burnt_food"),
        (input: "duck_egg", output: "fried_egg", level: 3, xp: 25.0, stop_burning: 14, burnt: "burnt_food"),
