// Cooking (engine/src/cooking.rs, docs/food-and-cooking.md): what each station cooks.
// `input` is an item (or `tag:` and a tag), `station` the tag of the station block, `level`
// the level it takes in its `skill` (Cooking unless given), `xp` the experience for one that doesn't burn. Burning starts
// at `level` (`burn_start` of the time, a quarter unless given) and stops at `stop_burning` (0: never burns);
// burnt food is `burnt_food`, or what `burnt` names (a cracked clay is clay again).
(
    recipes: [
        (input: "raw_small_game", output: "cooked_small_game", level: 1, xp: 30.0, stop_burning: 15, burnt: "burnt_food"),
        (input: "potato", output: "baked_potato", level: 2, xp: 32.0, stop_burning: 15, burnt: "burnt_food"),
        (input: "carrot", output: "roast_carrot", level: 2, xp: 28.0, stop_burning: 14, burnt: "burnt_food"),
        // An egg teaches 6 (design draft 63: quail lay one every ten minutes).
        (input: "egg", output: "fried_egg", level: 1, xp: 6.0, stop_burning: 12, burnt: "burnt_food"),
        (input: "raw_crab", output: "cooked_crab", level: 6, xp: 55.0, stop_burning: 24, burnt: "burnt_food"),
        (input: "raw_duck", output: "cooked_duck", level: 3, xp: 40.0, stop_burning: 18, burnt: "burnt_food"),
        (input: "raw_mutton", output: "cooked_mutton", level: 5, xp: 50.0, stop_burning: 22, burnt: "burnt_food"),
        (input: "raw_pork", output: "cooked_pork", level: 8, xp: 60.0, stop_burning: 26, burnt: "burnt_food"),
        (input: "raw_beef", output: "cooked_beef", level: 12, xp: 75.0, stop_burning: 30, burnt: "burnt_food"),
        (input: "raw_venison", output: "cooked_venison", level: 15, xp: 90.0, stop_burning: 34, burnt: "burnt_food"),
        (input: "raw_bear", output: "cooked_bear", level: 25, xp: 140.0, stop_burning: 45, burnt: "burnt_food"),
        // Fish (fishing.ron): cooking one teaches what catching it does (design draft 63).
        (input: "raw_minnow", output: "cooked_minnow", level: 1, xp: 10.0, stop_burning: 15, burnt: "burnt_food"),
        (input: "raw_sardine", output: "cooked_sardine", level: 5, xp: 13.0, stop_burning: 25, burnt: "burnt_food"),
        (input: "raw_perch", output: "cooked_perch", level: 10, xp: 18.0, stop_burning: 30, burnt: "burnt_food"),
        (input: "raw_trout", output: "cooked_trout", level: 15, xp: 25.0, stop_burning: 35, burnt: "burnt_food"),
        (input: "raw_cod", output: "cooked_cod", level: 20, xp: 35.0, stop_burning: 40, burnt: "burnt_food"),
        (input: "raw_salmon", output: "cooked_salmon", level: 25, xp: 49.0, stop_burning: 45, burnt: "burnt_food"),
        (input: "raw_carp", output: "cooked_carp", level: 30, xp: 68.0, stop_burning: 50, burnt: "burnt_food"),
        (input: "raw_bass", output: "cooked_bass", level: 35, xp: 94.0, stop_burning: 55, burnt: "burnt_food"),
        (input: "raw_pike", output: "cooked_pike", level: 40, xp: 131.0, stop_burning: 60, burnt: "burnt_food"),
        (input: "raw_eel", output: "cooked_eel", level: 45, xp: 183.0, stop_burning: 65, burnt: "burnt_food"),
        (input: "raw_tuna", output: "cooked_tuna", level: 50, xp: 254.0, stop_burning: 70, burnt: "burnt_food"),
        (input: "raw_sturgeon", output: "cooked_sturgeon", level: 55, xp: 353.0, stop_burning: 75, burnt: "burnt_food"),
        (input: "raw_marlin", output: "cooked_marlin", level: 60, xp: 491.0, stop_burning: 78, burnt: "burnt_food"),
        (input: "raw_swordfish", output: "cooked_swordfish", level: 65, xp: 684.0, stop_burning: 80, burnt: "burnt_food"),
        (input: "raw_deepwater_lanternfish", output: "cooked_deepwater_lanternfish", level: 70, xp: 951.0, stop_burning: 80, burnt: "burnt_food"),
        (input: "raw_glimmer_koi", output: "cooked_glimmer_koi", level: 75, xp: 1323.0, stop_burning: 80, burnt: "burnt_food"),
        // Fired at a village's kiln by the potters (wandering.ron, a clay-digging party's
        // "fire" line): clay into fired clay, a crack now and then until Crafting 12. A
        // player's own pit kiln is loaded and left (stations.ron); no block works these.
        (input: "clay", output: "fired_clay", station: "village_kiln", skill: "core:crafting", level: 1, xp: 6.0, stop_burning: 12, burnt: "clay"),
        // Cobblestone fired smooth again (Construction), as the potters do it: the stone that
        // stone bricks, an altar, lanterns and graves are cut from. It never cracks.
        (input: "cobblestone", output: "stone", station: "village_kiln", skill: "core:construction", level: 1, xp: 1.0, stop_burning: 0),
        // Smelted in the Crucible Kiln (Engineering), which must stand round its crucible:
        // copper ingots from ore, and bronze from three copper ingots held and a tin ore
        // carried, four at a time (one step, no blend). Metal never burns.
        (input: "copper_ore", output: "copper_ingot", station: "crucible", skill: "core:engineering", level: 5, xp: 8.0, stop_burning: 0),
        (input: "copper_ingot", uses: 3, with: [("tin_ore", 1)], output: "bronze_ingot", count: 4, station: "crucible", skill: "core:engineering", level: 12, xp: 88.0, stop_burning: 0),
        // A stick held in any fire (a campfire, a torch, a brazier) catches: a firebrand, the
        // light before coal. It takes no skill and teaches none.
        (input: "stick", output: "firebrand", station: "fire", level: 1, xp: 0.0, stop_burning: 0),
        // A torch's stub, picked up burnt down, held in any fire catches again: a torch.
        (input: "torch_stub", output: "torch", station: "fire", level: 1, xp: 0.0, stop_burning: 0),
        // A log split on a chopping block (Construction), with an axe about you: two
        // firewood, which burn hotter and longer than the log (machines.ron) and stack into
        // a charcoal clamp (multiblocks.ron). The axe is not taken.
        (input: "tag:log", output: "firewood", count: 2, station: "chopping_block", skill: "core:construction", level: 1, xp: 2.0, stop_burning: 0, tool: "axe"),
    ],
)
