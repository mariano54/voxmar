// Skills, RuneScape-style: actions grant experience in a skill and may need a level in it,
// and levels make actions yield a little more (see engine/src/skill.rs). Any package can
// add skills here; one sets the curve that turns experience into levels. RuneScape's
// reaches level 99 at 13,034,431 experience, level 92 being half way; `Table([...])`
// instead lists the experience each level from 2 up starts at, for a short ladder.
(
    curve: RuneScape(max: 99),
    // `guide` lists what a skill opens up, by level, for its guide in the character screen;
    // crops add their own lines from crops.ron. Lines for what is still to come are listed so
    // players can see it (docs/skills.md). Breeding animals is part of Farming; taming is
    // Hunter's. The first set of content stops near level 50 (Mariano, 2026-10-06).
    skills: [
        (
            name: "farming", title: "Farming", description: "Sowing, tending and harvesting crops, and keeping and breeding animals.",
            guide: [
                (level: 1, text: "Forage wild crops for their seeds, and sow them on soil near water"),
                (level: 1, text: "Keep and breed junglefowl and rabbits; collect eggs"),
                (level: 3, text: "Keep mallards"),
                (level: 5, text: "Keep mouflon and shear them; make compost"),
                (level: 8, text: "Keep pigs; they root for truffles"),
                (level: 10, text: "Keep ibex and milk them; harvests find uncommon produce a little more often"),
                (level: 12, text: "Keep bees in skeps for honey and wax"),
                (level: 15, text: "Keep aurochs; inspecting an animal shows its visible genes"),
                (level: 20, text: "Keep horses; the studbook tracks lineage and inbreeding"),
                (level: 25, text: "Keep camels and donkeys; breed mules"),
                (level: 28, text: "Rabbits in high aether can become moonhares"),
                (level: 30, text: "Inspecting shows hidden genes and carriers"),
                (level: 35, text: "Keep ember salamanders"),
                (level: 38, text: "Aether feed raises the chance of mutation"),
                (level: 40, text: "Keep crystal tortoises"),
                (level: 48, text: "Keep griffins"),
                (level: 50, text: "Keep silver harts; harvests find rare produce a little more often"),
            ],
        ),
        (
            name: "hunter", title: "Hunter", description: "Tracking, trapping and taming wild animals.",
            guide: [
                (level: 1, text: "Read fresh tracks and droppings; tame junglefowl and rabbits; set snares"),
                (level: 1, text: "Butchering what you hunt finds rarer parts a little more often"),
                (level: 3, text: "Tame mallards; bird nets"),
                (level: 5, text: "Tame mouflon; mask your scent with herbs"),
                (level: 8, text: "Tame ibex; box traps"),
                (level: 10, text: "Tame wild boar"),
                (level: 12, text: "Tame aurochs and alpacas"),
                (level: 16, text: "Tame horses; lassos"),
                (level: 20, text: "Tame wolves and foxes"),
                (level: 25, text: "Tame lynxes; deer calls and lures"),
                (level: 28, text: "Tame moonhares; read the aether in creatures' signs"),
                (level: 32, text: "Tame ember salamanders"),
                (level: 35, text: "Tame bears"),
                (level: 40, text: "Tame frost stags"),
                (level: 44, text: "Tame sunwings"),
                (level: 47, text: "Tame griffins"),
                (level: 50, text: "Befriend silver harts"),
            ],
        ),
        (
            name: "mining", title: "Mining", description: "Digging stone, ore and gems from the ground.",
            guide: [
                (level: 1, text: "Stone, dirt, sand, gravel, clay and coal"),
                (level: 5, text: "Copper"),
                (level: 10, text: "Tin; bat guano in caves for compost"),
                (level: 15, text: "Iron"),
                (level: 20, text: "Salt licks that draw deer and ibex"),
                (level: 25, text: "Cobalt"),
                (level: 30, text: "Silver"),
                (level: 35, text: "Gold"),
                (level: 40, text: "Crystal from a living crystal tortoise's shell"),
                (level: 45, text: "Diamond"),
                (level: 50, text: "Aetherite"),
            ],
        ),
        (
            name: "cooking", title: "Cooking", description: "Turning crops, meat and wild food into meals that feed, heal and warm you.",
            guide: [
                (level: 1, text: "Campfire: roast meat, fish, eggs, roots and mushrooms; herb tea"),
                (level: 3, text: "Pot: boiled eggs and porridge"),
                (level: 5, text: "Quern: flour and flatbread"),
                (level: 8, text: "Animal feed: mash and seed mix"),
                (level: 10, text: "Oven: bread"),
                (level: 12, text: "Pan: omelettes and fried eggs"),
                (level: 14, text: "Vegetable stew"),
                (level: 15, text: "Churn: butter and cream"),
                (level: 17, text: "Meat stew and hunter's stew"),
                (level: 21, text: "Pies"),
                (level: 23, text: "Smoker: smoked meat and fish"),
                (level: 25, text: "Fresh cheese"),
                (level: 27, text: "Honey cakes and taming treats"),
                (level: 31, text: "Drying rack: jerky and dried fruit, in dry air"),
                (level: 33, text: "Crock: sauerkraut and pickles, somewhere cool"),
                (level: 37, text: "Glowcap broth: sight in the dark"),
                (level: 41, text: "Emberfruit stew: warmth and fire resistance"),
                (level: 43, text: "Frostpetal sorbet: heat resistance"),
                (level: 45, text: "Moonhare stew and starlily tea"),
                (level: 49, text: "Heartbloom pie: more health for an hour"),
                (level: 50, text: "Banquets: shared effects for everyone at the table"),
            ],
        ),
        (
            name: "attack", title: "Attack", description: "Hitting hard and often, with weapons, fangs and claws.",
            guide: [
                (level: 1, text: "Fists, wooden and stone weapons, and a bone club; your blows land and hurt more as you level"),
                (level: 5, text: "Copper weapons"),
                (level: 10, text: "Fang daggers that bleed"),
                (level: 15, text: "Bronze weapons"),
                (level: 20, text: "Iron weapons"),
                (level: 30, text: "Cobalt weapons"),
                (level: 35, text: "Silver weapons, stronger against supernatural creatures"),
                (level: 40, text: "Diamond-edged weapons"),
                (level: 45, text: "Ember-scale blades"),
                (level: 50, text: "Aetherite weapons"),
            ],
        ),
        (
            name: "defence", title: "Defence", description: "Turning blows aside, and wearing armour.",
            guide: [
                (level: 1, text: "Hide armour; blows you turn aside train it"),
                (level: 5, text: "Hard leather"),
                (level: 10, text: "Copper armour; wolf-pelt cloaks for the cold"),
                (level: 15, text: "Bronze armour"),
                (level: 20, text: "Bear-hide and iron armour"),
                (level: 25, text: "Crocodile-scale armour"),
                (level: 30, text: "Cobalt armour"),
                (level: 35, text: "Silver mail against supernatural harm"),
                (level: 40, text: "Ember-scale armour against fire"),
                (level: 45, text: "Crystal-shell armour"),
                (level: 50, text: "Aetherite armour"),
            ],
        ),
        (
            name: "hitpoints", title: "Hitpoints", description: "How much harm you can take: twice your level in health.",
            guide: [
                (level: 10, text: "20 health; it trains with every blow you land"),
                (level: 20, text: "40 health"),
                (level: 25, text: "Healing while well fed is a quarter faster"),
                (level: 35, text: "Cooked food heals a tenth more"),
                (level: 50, text: "100 health"),
            ],
        ),
    ],
)
