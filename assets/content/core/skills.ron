// Skills, RuneScape-style: actions grant experience in a skill and may need a level in it,
// and levels make actions yield a little more (see engine/src/skill.rs). Any package can
// add skills here; one sets the curve that turns experience into levels. RuneScape's
// reaches level 99 at 13,034,431 experience, level 92 being half way; `Table([...])`
// instead lists the experience each level from 2 up starts at, for a short ladder.
(
    curve: RuneScape(max: 99),
    // `guide` lists what a skill opens up, by level, for its guide in the character screen;
    // crops add their own lines from crops.ron. Skills nothing trains yet are listed so
    // players can see what is coming. Breeding animals is part of Farming.
    skills: [
        (
            name: "farming", title: "Farming", description: "Sowing, tending and harvesting crops, and breeding animals.",
            guide: [
                (level: 1, text: "Forage wild crops for their seeds, and sow them on soil near water"),
                (level: 10, text: "Harvests find uncommon produce a little more often"),
                (level: 50, text: "Harvests find rare produce a little more often"),
            ],
        ),
        (name: "mining", title: "Mining", description: "Digging stone, ore and gems from the ground."),
        (name: "cooking", title: "Cooking", description: "Turning crops, meat and wild food into meals that feed and warm you."),
        (name: "attack", title: "Attack", description: "Hitting hard and often."),
        (name: "defence", title: "Defence", description: "Turning blows aside, and wearing armour."),
        (name: "hitpoints", title: "Hitpoints", description: "How much harm you can take."),
    ],
)
