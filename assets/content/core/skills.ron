// Skills, RuneScape-style: actions grant experience in a skill and may need a level in it,
// and levels make actions yield a little more (see engine/src/skill.rs). Any package can
// add skills here; one sets the curve that turns experience into levels. RuneScape's
// reaches level 99 at 13,034,431 experience, level 92 being half way; `Table([...])`
// instead lists the experience each level from 2 up starts at, for a short ladder.
(
    curve: RuneScape(max: 99),
    // `guide` lists what a skill opens up, by level, for its guide in the character screen;
    // crops add their own lines from crops.ron. Lines for what is still to come are listed so
    // players can see it (docs/skills.md). Breeding animals is part of Farming; taming is
    // Hunter's. The first set of content stops near level 50 (Mariano, 2026-10-06).
    skills: [
        (
            name: "farming", title: "Farming", description: "Sowing, tending and harvesting crops, and keeping and breeding animals.",
            guide: [
                (category: "planting", level: 1, text: "Forage wild crops for their seeds, and sow them on soil near water", icon: "wild_wheat"),
                (category: "breeding", level: 1, text: "Keep and breed junglefowl and rabbits; collect eggs", icon: "egg"),
                (category: "breeding", level: 3, text: "Keep mallards", icon: "egg"),
                (category: "breeding", level: 5, text: "Keep mouflon and shear them; make compost", icon: "wool"),
                (category: "breeding", level: 8, text: "Keep pigs; they root for truffles", icon: "truffle"),
                (category: "breeding", level: 10, text: "Keep ibex and milk them; harvests find uncommon produce a little more often", icon: "milk"),
                (category: "breeding", level: 12, text: "Keep bees in skeps for honey and wax", icon: "honey"),
                (category: "breeding", level: 15, text: "Keep aurochs; inspecting an animal shows its visible genes", icon: "raw_beef"),
                (category: "breeding", level: 20, text: "Keep horses; the studbook tracks lineage and inbreeding"),
                (category: "breeding", level: 25, text: "Keep camels and donkeys; breed mules"),
                (category: "breeding", level: 28, text: "Rabbits in high aether can become moonhares", icon: "moonhare_pelt"),
                (category: "breeding", level: 30, text: "Inspecting shows hidden genes and carriers"),
                (category: "breeding", level: 35, text: "Keep ember salamanders"),
                (category: "breeding", level: 38, text: "Aether feed raises the chance of mutation", icon: "aether_mote"),
                (category: "breeding", level: 40, text: "Keep crystal tortoises", icon: "crystal_cluster"),
                (category: "breeding", level: 48, text: "Keep griffins", icon: "feather"),
                (category: "breeding", level: 50, text: "Keep silver harts; harvests find rare produce a little more often", icon: "antler"),
            ],
        ),
        (
            name: "hunter", title: "Hunter", description: "Tracking, trapping and taming wild animals.",
            guide: [
                (level: 1, text: "Read fresh tracks and droppings; tame junglefowl and rabbits; set snares", icon: "rabbit_foot"),
                (level: 1, text: "Butchering what you hunt finds rarer parts a little more often", icon: "hide"),
                (level: 3, text: "Tame mallards; bird nets", icon: "feather"),
                (level: 5, text: "Tame mouflon; mask your scent with herbs", icon: "sage"),
                (level: 8, text: "Tame ibex; box traps", icon: "antler"),
                (level: 10, text: "Tame wild boar", icon: "raw_pork"),
                (level: 12, text: "Tame aurochs and alpacas", icon: "raw_beef"),
                (level: 16, text: "Tame horses; lassos"),
                (level: 20, text: "Tame wolves and foxes", icon: "fur"),
                (level: 25, text: "Tame lynxes; deer calls and lures", icon: "fang"),
                (level: 28, text: "Tame moonhares; read the aether in creatures' signs", icon: "moonhare_pelt"),
                (level: 32, text: "Tame ember salamanders"),
                (level: 35, text: "Tame bears", icon: "fur"),
                (level: 40, text: "Tame frost stags", icon: "antler"),
                (level: 44, text: "Tame sunwings", icon: "feather"),
                (level: 47, text: "Tame griffins", icon: "fang"),
                (level: 50, text: "Befriend silver harts", icon: "antler"),
            ],
        ),
        (
            name: "mining", title: "Mining", description: "Digging stone, ore and gems from the ground.",
            guide: [
                (level: 1, text: "Stone, dirt, sand, gravel, clay and coal", icon: "coal_ore"),
                (level: 5, text: "Copper", icon: "copper_ore"),
                (level: 10, text: "Tin; bat guano in caves for compost", icon: "tin_ore"),
                (level: 15, text: "Iron", icon: "iron_ore"),
                (level: 20, text: "Salt licks that draw deer and ibex"),
                (level: 25, text: "Cobalt", icon: "cobalt_ore"),
                (level: 30, text: "Silver", icon: "silver_ore"),
                (level: 35, text: "Gold", icon: "gold_ore"),
                (level: 40, text: "Crystal from a living crystal tortoise's shell", icon: "crystal_cluster"),
                (level: 45, text: "Diamond", icon: "diamond_ore"),
                (level: 50, text: "Aetherite", icon: "aetherite_ore"),
            ],
        ),
        (
            name: "cooking", title: "Cooking", description: "Turning crops, meat and wild food into meals that feed, heal and warm you.",
            guide: [
                (level: 1, text: "Campfire: roast meat, fish, eggs, roots and mushrooms; herb tea", icon: "campfire"),
                (level: 3, text: "Pot: boiled eggs and porridge", icon: "egg"),
                (level: 5, text: "Quern: flour and flatbread", icon: "wheat"),
                (level: 8, text: "Animal feed: mash and seed mix", icon: "wild_grain"),
                (level: 10, text: "Oven: bread", icon: "bread"),
                (level: 12, text: "Pan: omelettes and fried eggs", icon: "fried_egg"),
                (level: 14, text: "Vegetable stew", icon: "carrot"),
                (level: 15, text: "Churn: butter and cream"),
                (level: 17, text: "Meat stew and hunter's stew", icon: "cooked_beef"),
                (level: 21, text: "Pies"),
                (level: 23, text: "Smoker: smoked meat and fish", icon: "cooked_pork"),
                (level: 25, text: "Fresh cheese"),
                (level: 27, text: "Honey cakes and taming treats", icon: "wheat"),
                (level: 31, text: "Drying rack: jerky and dried fruit, in dry air", icon: "dates"),
                (level: 33, text: "Crock: sauerkraut and pickles, somewhere cool"),
                (level: 37, text: "Glowcap broth: sight in the dark", icon: "glowcap_cap"),
                (level: 41, text: "Emberfruit stew: warmth and fire resistance", icon: "emberfruit"),
                (level: 43, text: "Frostpetal sorbet: heat resistance", icon: "frostpetal"),
                (level: 45, text: "Moonhare stew and starlily tea", icon: "starlily"),
                (level: 49, text: "Heartbloom pie: more health for an hour", icon: "heartbloom"),
                (level: 50, text: "Banquets: shared effects for everyone at the table"),
            ],
        ),
        (
            name: "engineering", title: "Engineering", description: "Making tools, stations and machines, and working metal.",
            guide: [
                (level: 1, text: "Crafting tables, sticks, torches and wooden and stone tools", icon: "crafting_table"),
                (level: 1, text: "Shears for wool, pails for milk, campfires", icon: "shears"),
                (level: 5, text: "Copper ingots and copper tools: faster work and better finds", icon: "copper_pickaxe"),
                (level: 5, text: "Copper tools and weapons mended with copper ingots at a grindstone", icon: "grindstone"),
                (level: 10, text: "Tin, and the crucible at the heart of the kiln", icon: "tin_ore"),
                (level: 12, text: "Bronze ingots and bronze tools: twice copper's life", icon: "bronze_pickaxe"),
                (level: 15, text: "Iron ingots and iron tools", icon: "iron_pickaxe"),
                (level: 20, text: "Doors, gates and ladders (to come)"),
                (level: 25, text: "Levers, pressure plates and traps (to come)"),
                (level: 30, text: "A furnace and a forge for metals (to come)"),
                (level: 35, text: "Pulleys, gears and water wheels (to come)"),
                (level: 40, text: "Carts and rails (to come)"),
                (level: 50, text: "Aether engines (to come)", icon: "aether_mote"),
            ],
        ),
        (
            name: "crafting", title: "Crafting", description: "Making materials, cloth, leather and fine things.",
            guide: [
                (level: 1, text: "Planks and sticks from logs; bricks and sandstone", icon: "oak_planks"),
                (level: 1, text: "Mossy stonework", icon: "mossy_cobblestone"),
                (level: 2, text: "Grain sacks and baskets woven of twine", icon: "sack"),
                (level: 5, text: "Rope and twine from fibre (to come)"),
                (level: 15, text: "Wool cloth and beds (to come)", icon: "wool"),
                (level: 20, text: "Leather from hides (to come)", icon: "hide"),
                (level: 25, text: "Dyes from flowers and berries (to come)"),
                (level: 30, text: "Glass panes and lanterns (to come)", icon: "glass"),
                (level: 40, text: "Fine furniture and banners (to come)"),
                (level: 50, text: "Aether-woven cloth (to come)", icon: "aether_mote"),
            ],
        ),
        (
            name: "fishing", title: "Fishing", description: "Catching fish with rods, nets and traps, in sea and fresh water.",
            guide: [
                (level: 1, text: "Shrimp in any water, minnows in fresh; twine and a fishing rod", icon: "fishing_rod"),
                (level: 5, text: "Sardines in the sea", icon: "raw_sardine"),
                (level: 10, text: "Perch in lakes and rivers", icon: "raw_perch"),
                (level: 15, text: "Trout in cold fresh water", icon: "raw_trout"),
                (level: 20, text: "Cod in cold seas; a fine rod lands more and rarer fish", icon: "raw_cod"),
                (level: 25, text: "Salmon in cold rivers", icon: "raw_salmon"),
                (level: 30, text: "Carp in warm and marshy water", icon: "raw_carp"),
                (level: 35, text: "Bass in the sea", icon: "raw_bass"),
                (level: 40, text: "Pike in temperate lakes", icon: "raw_pike"),
                (level: 45, text: "Eels in fresh water at night", icon: "raw_eel"),
                (level: 50, text: "Tuna in warm seas", icon: "raw_tuna"),
                (level: 65, text: "Swordfish in warm seas, rarely", icon: "raw_swordfish"),
                (level: 75, text: "Glimmer koi in fantastical waters on rainy nights", icon: "raw_glimmer_koi"),
                (level: 80, text: "Cape perk: casts land a little more often (to come)"),
            ],
        ),
        (
            name: "attack", title: "Attack", description: "Hitting hard and often, with weapons, fangs and claws.",
            guide: [
                (level: 1, text: "Fists, wooden and stone weapons, and a bone club; your blows land and hurt more as you level", icon: "bone"),
                (level: 5, text: "Copper weapons", icon: "copper_ore"),
                (level: 10, text: "Fang daggers that bleed", icon: "fang"),
                (level: 15, text: "Bronze weapons"),
                (level: 20, text: "Iron weapons", icon: "iron_ore"),
                (level: 30, text: "Cobalt weapons", icon: "cobalt_ore"),
                (level: 35, text: "Silver weapons, stronger against supernatural creatures", icon: "silver_ore"),
                (level: 40, text: "Diamond-edged weapons", icon: "diamond_ore"),
                (level: 45, text: "Ember-scale blades"),
                (level: 50, text: "Aetherite weapons", icon: "aetherite_ore"),
            ],
        ),
        (
            name: "defence", title: "Defence", description: "Turning blows aside, and wearing armour.",
            guide: [
                (level: 1, text: "Hide armour; blows you turn aside while you fight back train it", icon: "hide"),
                (level: 5, text: "Hard leather", icon: "hide"),
                (level: 10, text: "Copper armour; wolf-pelt cloaks for the cold", icon: "fur"),
                (level: 15, text: "Bronze armour"),
                (level: 20, text: "Bear-hide and iron armour", icon: "fur"),
                (level: 25, text: "Crocodile-scale armour"),
                (level: 30, text: "Cobalt armour", icon: "cobalt_ore"),
                (level: 35, text: "Silver mail against supernatural harm", icon: "silver_ore"),
                (level: 40, text: "Ember-scale armour against fire"),
                (level: 45, text: "Crystal-shell armour", icon: "crystal_cluster"),
                (level: 50, text: "Aetherite armour", icon: "aetherite_ore"),
                (level: 80, text: "Cape perk: protection spells last longer (when spells come)", how: "Reach 80. Protection from blows, arrows and magic comes as spells, with their own bar."),
            ],
        ),
        (
            name: "hitpoints", title: "Hitpoints", description: "How much harm you can take: twice your level in health.",
            start: 10,
            guide: [
                (level: 10, text: "20 health; it trains with every blow you land"),
                (level: 20, text: "40 health"),
                (level: 25, text: "Healing by yourself is a quarter faster (to come)"),
                (level: 35, text: "Cooked food heals a tenth more", icon: "cooked_small_game"),
                (level: 50, text: "100 health"),
            ],
        ),
        (
            name: "ranged", title: "Ranged", description: "Bows, crossbows and thrown weapons: hitting flyers and what you cannot reach.",
            guide: [
                (category: "weapons", level: 1, text: "Sling, with cobbled stone", how: "A hide pouch on two cords of twine; any cobblestone is a shot."),
                (category: "weapons", level: 5, text: "Shortbow with flint arrows", how: "A bent stick and twine make the bow; knap flint for arrowheads."),
                (category: "weapons", level: 10, text: "Bolas: tangles a creature for taming", how: "Weights on cords; hit a fleeing animal and it stops for taming."),
                (category: "ammunition", level: 15, text: "Bronze arrowheads; javelins", how: "Cast bronze heads in the Bronze age; javelins hit hard up close."),
                (category: "weapons", level: 20, text: "Horn bow, from horn and sinew", how: "Horn and sinew from hunting make a bow that outranges wood."),
                (category: "ammunition", level: 25, text: "Fire arrows", how: "Wrap arrows in resin cloth; fire hurts what fears flame."),
                (category: "weapons", level: 30, text: "Crossbow; armour-piercing bolts", how: "Iron and a crossbow bench; bolts pierce armour."),
                (category: "weapons", level: 35, text: "Harpoon, for fishing too", how: "A barbed spear on a line: reel in big fish or keep prey close."),
                (category: "weapons", level: 40, text: "Flintlock; bombs", how: "Gunpowder from bat guano and saltpetre; bombs break blocks too."),
                (category: "ammunition", level: 50, text: "Electric crossbow; silver bolts", how: "Batteries power the crossbow; silver bolts for supernatural foes."),
                (category: "weapons", level: 55, text: "Repeating crossbow, rifle", how: "Machined parts let it fire again and again."),
                (category: "weapons", level: 60, text: "Railgun: pierces immunities", how: "Superconducting coils fling a slug through any immunity."),
                (category: "weapons", level: 65, text: "Aether bow: no arrows", how: "Aether strings a bow that needs no arrows."),
                (category: "weapons", level: 78, text: "Mastery: the storm griffin's bow", how: "A rare drop from the storm griffin, mastered at 78."),
                (category: "ammunition", level: 80, text: "Cape perk: most ammunition is recovered", how: "Reach 80: most arrows and bolts come back to you."),
            ],
        ),
        (
            name: "magic", title: "Magic", description: "Spells from aether: motes, glimmer dust and moon dust are the runes.",
            guide: [
                (category: "combat", level: 1, text: "Wisp bolt, with your first aether mote", how: "Find an aether mote (wisps drop them) and bind it to a wand."),
                (category: "utility", level: 5, text: "Mend: heal yourself or a pet", how: "Spend a mote to heal yourself or a pet a little."),
                (category: "combat", level: 8, text: "Stone bolt", how: "Earth runes from dust; a heavy bolt."),
                (category: "utility", level: 12, text: "Light: a floating light", how: "A floating light that follows you for a while."),
                (category: "combat", level: 15, text: "Fire bolt", how: "Ember scales from fire creatures fuel it."),
                (category: "combat", level: 18, text: "Frost touch", how: "Frost antlers chill and slow what you touch."),
                (category: "utility", level: 20, text: "Blink: a short teleport", how: "Jump a few blocks in the direction you look."),
                (category: "utility", level: 25, text: "Root: holds a creature in place", how: "Roots hold a creature still: for taming or a clean shot."),
                (category: "combat", level: 30, text: "Lightning", how: "Storm motes, gathered in thunderstorms."),
                (category: "utility", level: 40, text: "Recall: one way home", how: "A one-way trip to your hearth."),
                (category: "combat", level: 45, text: "Gust and Freeze", how: "Push foes back, or freeze water and creatures."),
                (category: "combat", level: 50, text: "Chain lightning; aether bubble", how: "Lightning that jumps between foes; a bubble that blocks blows."),
                (category: "utility", level: 60, text: "Calm: soothes a wild animal for taming", how: "Soothes a wild animal so it trusts you sooner."),
                (category: "utility", level: 65, text: "Summon wisp; call the weather", how: "A wisp fights beside you; call rain or clear skies."),
                (category: "combat", level: 78, text: "Mastery: Starfall", how: "A rare spellbook from the Moon Hart."),
                (category: "combat", level: 80, text: "Cape perk: one spell costs no runes", how: "Reach 80: one spell of your choice costs no runes."),
            ],
        ),
        (
            name: "alchemy", title: "Alchemy", description: "Brews from the properties every plant, fungus and drop carries; boost potions stand in for levels.",
            guide: [
                (category: "brews", level: 1, text: "Herb teas; mortar and pestle", how: "Steep any herb at a campfire; each brew reveals a property."),
                (category: "brews", level: 5, text: "Tonics from two herbs that share a property", how: "Two herbs that share a property make a tonic stronger than tea."),
                (category: "brews", level: 10, text: "Cauldron: two-dose tonics", how: "A cauldron over the fire brews two doses at once."),
                (category: "brews", level: 15, text: "Antidote; warm and cool draughts", how: "Antidote cures poison; warm and cool draughts fight the weather."),
                (category: "brews", level: 20, text: "Alembic: four-dose potions", how: "A potter's alembic distils four doses into one vial."),
                (category: "boosts", level: 22, text: "Boost potions: +1 to +3 to a skill", how: "A boost lifts a skill's level for a while: make a recipe early."),
                (category: "brews", level: 25, text: "Calming draught, for taming", how: "Calms a wild animal you want to tame."),
                (category: "brews", level: 30, text: "Coatings: fire oil, poison, silver dust", how: "Coat a weapon before a fight: fire for what fears flame, poison, silver for spirits."),
                (category: "boosts", level: 35, text: "Steady hand: +2 Engineering or Crafting", how: "Fixed +2 to Engineering or Crafting, for building."),
                (category: "boosts", level: 45, text: "Surge draughts: +6, falling by one a minute", how: "+6 at first, losing one a minute: drink just before."),
                (category: "elixirs", level: 55, text: "Elixir of swiftness: 5% faster for good", how: "Rare herbs make it; drink once, keep it for good."),
                (category: "boosts", level: 60, text: "Condensed aether; Overload", how: "Condensed aether, and Overload: several combat boosts in one."),
                (category: "elixirs", level: 70, text: "Elixir of vigour: 10 more health for good", how: "Another permanent elixir: ten more health."),
                (category: "boosts", level: 78, text: "Mastery: the philosopher's draught, +4 to every skill for a minute", how: "A rare brew: +4 to every skill for a minute."),
                (category: "brews", level: 80, text: "Cape perk: an extra dose in every brew", how: "Reach 80: every brew gives one more dose."),
            ],
        ),
        (
            name: "construction", title: "Construction", description: "Your home: the hearth's tiers and the fixtures that give buffs; also dams, rails and bridges.",
            guide: [
                (category: "hearth", level: 1, text: "Hearth tier 1: bedroll and fire ring", how: "Build the Homestead Hearth and sleep beside it."),
                (category: "hearth", level: 1, text: "Hearthstone, chimney and pit kiln", how: "Dress cobbles into a hearthstone, cobbles and clay into a chimney, and ring a campfire with cobbles for a pit kiln.", icon: "hearthstone"),
                (category: "fixtures", level: 3, text: "Herb planter", how: "Planks and dirt: herbs and flowers placed in it grow back.", icon: "herb_planter"),
                (category: "hearth", level: 5, text: "Hearth tier 2: bed, stove, larder, workbench", how: "Upgrade the hearth; fixtures near it give their buffs."),
                (category: "fixtures", level: 5, text: "Stone altar", how: "Stone bricks: it will restore prayer and take bones for Magic.", icon: "stone_altar"),
                (category: "structures", level: 10, text: "Fences, wells and gates", how: "Fences keep animals in; a well waters crops anywhere."),
                (category: "hearth", level: 15, text: "Hearth tier 3: better fixtures", how: "Better fixtures for a stronger home."),
                (category: "fixtures", level: 20, text: "Kennel and stable", how: "Homes for your pets and mounts."),
                (category: "hearth", level: 25, text: "Hearth tier 4; ritual circle", how: "A stone hearth, and a circle for rituals."),
                (category: "fixtures", level: 30, text: "Telescope; trophy stand", how: "See the sky's events; show off your trophies."),
                (category: "hearth", level: 35, text: "Hearth tier 5; bath", how: "A bath washes away debuffs."),
                (category: "structures", level: 40, text: "Dams", how: "Hold back rivers for water wheels and fields."),
                (category: "fixtures", level: 45, text: "Alchemy bench; map table", how: "Brew at home; plan journeys on the map table."),
                (category: "hearth", level: 50, text: "Hearth tier 6", how: "A larger home radius."),
                (category: "hearth", level: 60, text: "Hearth tier 8; portal frame", how: "Portals between your homes start here."),
                (category: "hearth", level: 70, text: "Hearth tier 10; house core", how: "The house core: the home at its strongest."),
                (category: "fixtures", level: 74, text: "Grand fixtures: buffs half again as strong", how: "Grand fixtures give their buffs half again as strong."),
                (category: "hearth", level: 78, text: "Mastery: a second home", how: "A second hearth: two homes to wake at."),
                (category: "hearth", level: 80, text: "Cape perk: go home whenever you like", how: "Reach 80: travel home whenever you like."),
            ],
        ),
    ],
)
