// How a fight shows on screen (crates/client/src/hud/combat.rs). Sizes are interface
// pixels, colours (red, green, blue) from 0 to 255, times seconds. A later package changes
// what it gives: the meter or the pips whole, the splats' timings whole, and each splat
// kind by its own name.
(
    // The swing meter under the crosshair: it fills over the weapon's cooldown, and lights
    // while a blow would be on the beat. The end a click is held for the beat in is
    // tinted. It shows while blows were traded within `linger`.
    meter: (
        width: 24, height: 3, below: 11,
        empty: (34, 38, 54), fill: (226, 218, 196), beat: (242, 193, 78), buffer: (112, 94, 58),
        linger: 3.0,
    ),
    // The rhythm pips under it: lit by blows on the beat, all lit (`ready`) when the next
    // on the beat is a flourish.
    pips: (size: 3, gap: 2, off: (58, 62, 80), on: (242, 193, 78), ready: (255, 138, 61)),
    // Hitsplats, as the design wiki's combat feel has them: red for damage, blue for a miss
    // or a block, green for bleeding, gold for flourishes and counters, a little larger on
    // the beat. Each shows `seconds`, rising `rise` meanwhile; those on one creature stack
    // upward, newest lowest, `gap` apart; the player's own stand `hurt_above` over the
    // bottom edge. `scale` is screen pixels a font pixel: 2 as body text (the default), 3
    // as headings.
    splats: (
        seconds: 0.9, rise: 14, gap: 1, hurt_above: 70,
        // The player's blows, by kind.
        blows: {
            "plain": (color: (236, 76, 64)),
            "beat": (color: (236, 76, 64), scale: 3),
            "flourish": (color: (242, 193, 78), scale: 3),
            "counter": (color: (242, 193, 78), scale: 3),
            "bleed": (color: (110, 206, 98)),
        },
        // Blows at the player, by what came of them (and a blow of the player's that did
        // nothing shows as `missed`).
        defended: {
            "hit": (color: (236, 76, 64)),
            "missed": (color: (104, 168, 255)),
            "blocked": (color: (104, 168, 255)),
            "perfect": (color: (104, 168, 255), scale: 3),
            "dodged": (color: (104, 168, 255)),
            "evaded": (color: (104, 168, 255)),
        },
        // A blow that hurts the player flashes what the health bar lost in this colour,
        // fading back to the bar's own over `seconds`.
        flash: (color: (236, 76, 64), seconds: 0.6),
    ),
)
