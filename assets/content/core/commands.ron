// Console commands. Each runs one of the engine's built-in commands, or is an alias that
// runs other command lines with its arguments filled in (`$1`, `$2`, … and `$*` for all of
// them), which is how any package can add its own. Typed without the namespace: `/time`.
(
    commands: [
        (
            name: "help",
            usage: "[command]",
            help: "Lists the commands you can use, or explains one.",
            run: Help,
        ),
        (
            name: "time",
            usage: "[set <sunrise|day|noon|sunset|night|midnight|TICKS> | add <TICKS|30s|2h|1d> | speed <X> | freeze | resume]",
            help: "Shows or changes the time of day. A day is 24000 ticks, 20 minutes; 0 is sunrise and an in-game hour is 1000 ticks. set moves forward to the next such time, speed 10 runs days ten times as fast, freeze stops the sun and resume runs it at normal speed again.",
            permission: Admin,
            run: Time,
        ),
        (
            name: "weather",
            usage: "[KIND [light|moderate|heavy|max|0..1] [SECONDS] | natural | list]",
            help: "Shows the weather here, or brings a kind of weather (/weather list names them) to the land around you, as intense as you say (each kind has its usual intensity; 1 is its fiercest), for five minutes unless you say, after which the natural weather takes over again. natural ends it now.",
            permission: Admin,
            run: Weather,
        ),
        (
            name: "wind",
            usage: "[KIND [FROM] [SECONDS] | list]",
            help: "Shows the wind here, or brings a wind (calm, breeze, strong or gale; /wind list names them) to the land around you, from a direction (n, ne, e, se, s, sw, w, nw or degrees from north) if you say, for five minutes unless you say. /weather natural ends it.",
            permission: Admin,
            run: Wind,
        ),
        (
            name: "tp",
            usage: "<x> <y> <z> | <x> <z> | <player> | <player> <x> <y> <z> | <player> <player>",
            help: "Teleports you, or a player, to coordinates or to another player. ~ is where the player is now, so ~ ~10 ~ goes ten blocks up; with only x and z you land on the ground.",
            permission: Admin,
            run: Teleport,
        ),
        (
            name: "gamemode",
            usage: "<survival|creative> [player]",
            help: "Switches you, or a player, between survival (on foot) and creative (flight allowed).",
            permission: Admin,
            run: GameMode,
        ),
        (
            name: "setblock",
            usage: "<x> <y> <z> <block>",
            help: "Puts a block at a position (~ is where you are, so ~ ~-1 ~ is under your feet), replacing what is there. Water and lava placed this way flow.",
            permission: Admin,
            run: SetBlock,
        ),
        (
            name: "fill",
            usage: "<x1> <y1> <z1> <x2> <y2> <z2> <block>",
            help: "Fills the box between two corners with a block, up to 32768 of them; air empties it.",
            permission: Admin,
            run: Fill,
        ),
        (
            name: "give",
            usage: "<block> [count]",
            help: "Gives you blocks, 64 unless you say: /give water to pour some. What does not fit drops at your feet.",
            permission: Admin,
            run: Give,
        ),
        (
            name: "effect",
            usage: "<effect> [seconds] | clear",
            help: "Gives you an effect for a while (60 seconds unless you say), as food would; clear takes them all away.",
            permission: Admin,
            run: Effect,
        ),
        (
            name: "kill",
            usage: "",
            help: "Kills you, as a fall or a wolf would: you keep your three most valuable items and the rest lies where you fell.",
            permission: Admin,
            run: Kill,
        ),
        (
            name: "clear",
            usage: "[item]",
            help: "Empties your inventory, or takes every one of an item out of it.",
            permission: Admin,
            run: Clear,
        ),
        (
            name: "drop",
            usage: "<item> [count] [x y z]",
            help: "Drops a stack of an item into the world (up to 64 at a time) at a block (~ is where you are), or at your feet.",
            permission: Admin,
            run: Drop,
        ),
        (
            name: "grow",
            usage: "[STAGES]",
            help: "Grows the crops within 8 blocks of you by a stage, or as many as you say (all the way to ripe with `ripe`).",
            permission: Admin,
            run: Grow,
        ),
        (name: "biome", help: "Names the biome you stand in, and its climate.", run: Biome),
        (
            name: "locate",
            usage: "biome NAME [RADIUS] | gorge [RADIUS]",
            help: "Finds the nearest place of a biome, or of a river running deep in a gorge, within 4000 blocks unless you say (up to 10000).",
            permission: Admin,
            run: Locate,
        ),
        (name: "seed", help: "Tells the world's seed.", run: Seed),
        (name: "list", help: "Lists who is online.", run: List),
        // Shortcuts, as any package could add them.
        (name: "day", usage: "", help: "Sets the time to morning: /time set day.", permission: Admin, run: Alias(["time set day"])),
        (name: "night", usage: "", help: "Sets the time to night: /time set night.", permission: Admin, run: Alias(["time set night"])),
        (
            name: "summon",
            usage: "<creature> [count] [x y z]",
            help: "Puts creatures of a species (rabbit, wolf, moonhare…) on the ground in front of you, or at a block (~ is where you are), one unless you say, up to 16.",
            permission: Admin,
            run: Summon,
        ),
        (
            name: "creatures",
            usage: "[tame | ready | hasten]",
            help: "Lists the creatures within 64 blocks of you: how many of each, and what the nearest is doing. Admins may tame those within 8 blocks, ready the kept ones there to breed, hasten them (products due and young grown at once), or hold them still for a minute.",
            run: Creatures,
        ),
        (
            name: "skill",
            usage: "<skill> <level>",
            help: "Sets your level in a skill (farming, hunter, cooking, attack…), from 1 to the highest.",
            permission: Admin,
            run: Skill,
        ),
    ],
    // Times of day `/time set` knows by name, in ticks after sunrise.
    times: [
        ("sunrise", 0),
        ("day", 1000),
        ("morning", 2000),
        ("noon", 8000),
        ("afternoon", 11000),
        ("sunset", 16000),
        ("dusk", 16500),
        ("night", 17000),
        ("midnight", 20000),
        ("dawn", 23500),
    ],
)
