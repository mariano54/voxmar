// How the interface draws things a package may restyle (crates/client/src/hud/inventory.rs).
// A later package changes what it gives.
(
    // How strongly an empty worn well shows what it takes (the pack's `ui/slot/*` marks),
    // from 0 (not at all) to 1 (as drawn).
    worn_glyph_alpha: 0.25,
    // The way home (docs/home.md): a mark at the top of the screen toward home (the lit
    // hearth, else the bed last slept in) and how far it is. It never shows within
    // `home_hidden_within` blocks of home (the home's own box, survival.ron's home_reach
    // of 7, and a step). From `home_dusk` to `home_dawn` (ticks after sunrise, as /time
    // names them) it shows beyond that; by day only beyond `home_shown_beyond`. It fades
    // in and out over `home_fade` seconds.
    home_hidden_within: 8.0,
    home_shown_beyond: 48.0,
    home_dusk: 16500,
    home_dawn: 23500,
    home_fade: 0.5,
    // The quest book (crates/client/src/hud/quests.rs). A quest's icon on the web at each
    // zoom, smallest first, in interface pixels, each a multiple of 8 (its 16 texels' half)
    // so the pixel art stays sharp; the wheel or + and - step between them, and the book
    // opens at `book_zoom_at` (counted from 0). It takes `book_width` percent of the window
    // across, and down from under the bar of the screens' keys to the HUD at the bottom.
    book_zooms: [16.0, 24.0, 32.0, 48.0, 64.0],
    book_zoom_at: 1,
    book_width: 98.0,
)
