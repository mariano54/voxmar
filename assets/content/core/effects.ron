// Buffs and debuffs (engine/src/effect.rs). Each has a kind, an icon (`ui/effect/<icon>`
// in the packs, its own name unless given), an English title and line (the fallback for
// the keys `effect.<package>.<name>` and `….description` in lang/), and what it does as
// modifiers: `heal`, `speed`, `mining` and `xp` multiply (1 changes nothing, 0 stops
// healing by itself), `fishing` (casts landing) and `meal_heal` and `meal_time` (how much a
// meal heals and how long its good effects last) multiply too, `warmth` adds degrees to how
// warm you feel and `home_warmth` (a home's steps and rooms) the same but only up to
// survival.ron's `comfort_top`, never past it, `max_health` adds health points, `hurt_every`
// hurts a point every so many seconds.
//
// `when` is what brings it on, checked every second: how warm you feel, a fire nearby, and the weather where you stand (rain, snow, hail, dust and storms only out in
// it, under open sky; wind anywhere). An effect without one comes only from what you do:
// food with an `effect:NAME:SECONDS` tag gives it for that long (base/effects.ron).
// `replaces` hides milder effects while a stronger one lasts. `finds` adds to the chance of an
// extra piece from natural rock and soil. `Done("quest")` holds once that quest is finished
// (a perk that stays), and `announce` makes a step say so in chat once, counted for quests as
// `Built("LADDER_NAME", 1)` (`ladder` is `home` unless given); see base/effects.ron.
(
    effects: [
        // Warmth.
        (name: "by_the_fire", kind: Buff, title: "By the fire", description: "Warmed by a fire or torch nearby.",
            when: Some(Warmed)),
        (name: "chilly", kind: Debuff, title: "Chilly", description: "Heal slower and move a little stiffly. Find warmth.",
            when: Some(FeltBelow(6.0)), modifiers: (heal: 0.5, speed: 0.95)),
        (name: "freezing", kind: Debuff, title: "Freezing", description: "No healing, slow and numb, lose health. Get warm.",
            when: Some(FeltBelow(-6.0)), replaces: ["chilly"], modifiers: (heal: 0.0, speed: 0.9, hurt_every: Some(10.0))),
        (name: "hot", kind: Debuff, title: "Hot", description: "Heal slower.",
            when: Some(FeltAbove(30.0)), modifiers: (heal: 0.5)),
        (name: "overheated", kind: Debuff, title: "Overheated", description: "No healing, lose health. Find shade or water.",
            when: Some(FeltAbove(37.0)), replaces: ["hot"], modifiers: (heal: 0.0, hurt_every: Some(12.0))),

        // Bad weather, out in it. Wet through, it stays on you under a roof for a few minutes,
        // or until you dry off within three blocks of a fire or a hearth (or warmed on a cold
        // day), or hang your things within two of a peg rail (`pegs`): coming in from the
        // rain, you dry by your own hearth or the rail by the door.
        (name: "soaked", kind: Debuff, title: "Soaked", description: "Rain runs down your back: you feel 4° colder until you dry off by a fire or at a peg rail.",
            when: Some(Rain(0.3)), lingers: 120.0, ends: Some(Any([Warmed, Near("fire", 3), Near("hearth", 3), Near("pegs", 2)])), modifiers: (warmth: -4.0)),
        (name: "drenched", kind: Debuff, title: "Drenched", description: "A downpour: 7° colder, slower to heal and to walk, until you dry off by a fire or at a peg rail.",
            when: Some(Rain(0.7)), lingers: 180.0, ends: Some(Any([Warmed, Near("fire", 3), Near("hearth", 3), Near("pegs", 2)])), replaces: ["soaked"], modifiers: (warmth: -7.0, heal: 0.75, speed: 0.95)),
        (name: "snowblown", kind: Debuff, title: "Snowblown", description: "Snow underfoot and in your face: 3° colder and slower going.",
            when: Some(Snow(0.35)), modifiers: (warmth: -3.0, speed: 0.9)),
        (name: "pelted", kind: Debuff, title: "Pelted by hail", description: "Hail stings: lose a point of health now and then. Get under a roof.",
            when: Some(Hail(0.25)), modifiers: (hurt_every: Some(15.0))),
        (name: "windswept", kind: Debuff, title: "Windswept", description: "The gale takes your breath and your warmth: 3° colder, slower going.",
            when: Some(Wind(14.0)), modifiers: (warmth: -3.0, speed: 0.92)),
        (name: "sandblasted", kind: Debuff, title: "Sandblasted", description: "Sand in the air: slower going and harder to work.",
            when: Some(Dust(0.4)), modifiers: (speed: 0.9, mining: 0.9)),
        (name: "storm_wary", kind: Debuff, title: "Storm-wary", description: "Lightning about: you heal slower and learn less while out in it.",
            when: Some(Storm(0.5)), modifiers: (heal: 0.75, xp: 0.9)),
    ],
)
