// Core actions. Every discrete change a player (or later a machine or NPC) makes goes
// through one of these: requirements are checked when proposed and again on completion,
// then the effects are applied atomically.
(
    actions: [
        (
            name: "mine",
            duration: TargetHardness,
            requires: [Alive, InReach, Breakable, BlockLevel, CropLevel, ToolGood],
            effects: [DropLoot, WearHeld, ClearTarget],
        ),
        (
            name: "place",
            duration: Instant,
            requires: [Alive, InReach, HoldingBlock, Replaceable, Unobstructed, Supported],
            effects: [PlaceHeld],
        ),
        // The inventory screen's moves: between two slots or the pointer, a shift click,
        // and putting what the pointer holds back when the screen closes.
        (name: "transfer", duration: Instant, requires: [Alive], effects: [MoveItems]),
        (name: "quick_move", duration: Instant, requires: [Alive], effects: [QuickMove]),
        // The crafting grid: once onto the pointer, or (shift) as many as fit.
        (name: "craft", duration: Instant, requires: [Alive], effects: [Craft]),
        (name: "lay", duration: Instant, requires: [Alive], effects: [LayRecipe]),
        (name: "stow", duration: Instant, effects: [StowCursor]),
        // Throwing items from the hand (Q, or Ctrl+Q for the whole stack), or the stack on
        // the pointer by clicking outside the inventory.
        (name: "drop", duration: Instant, requires: [Alive], effects: [Throw]),
        // Striking a creature with what is in hand (left click on it).
        (name: "attack", duration: Instant, requires: [Alive, CreatureInReach], effects: [Strike]),
        // A dash aside with a moment no blow lands (Left Alt and a direction).
        (name: "dodge", duration: Instant, requires: [Alive], effects: [Dodge]),
        // Eating what you hold, which heals you, if you are hurt. A bite takes 0.6 s: no
        // swinging or dodging meanwhile, and it restarts the swing rhythm (fight.rs).
        (name: "eat", duration: Seconds(0.6), requires: [Alive, HoldingFood, Hurt], effects: [EatHeld]),
        (name: "respawn", duration: Instant, requires: [Dead], effects: [Respawn]),
    ],
)
