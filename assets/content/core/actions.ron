// Core actions. Every discrete change a player (or later a machine or NPC) makes goes
// through one of these: requirements are checked when proposed and again on completion,
// then the effects are applied atomically.
(
    actions: [
        (
            name: "mine",
            duration: TargetHardness,
            requires: [Alive, InReach, Breakable],
            effects: [GiveDrop, ClearTarget],
        ),
        (
            name: "place",
            duration: Instant,
            requires: [Alive, InReach, HoldingBlock, Replaceable, Unobstructed, Supported],
            effects: [PlaceHeld],
        ),
        // The inventory screen's moves: between two slots or the pointer, a shift click,
        // and putting what the pointer holds back when the screen closes.
        (name: "transfer", duration: Instant, requires: [Alive], effects: [MoveItems]),
        (name: "quick_move", duration: Instant, requires: [Alive], effects: [QuickMove]),
        (name: "stow", duration: Instant, effects: [StowCursor]),
        (name: "respawn", duration: Instant, requires: [Dead], effects: [Respawn]),
    ],
)
