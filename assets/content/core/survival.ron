// The numbers survival runs on, which the server reads. A later package's survival.ron
// changes only the numbers it sets. Health is in half hearts; temperatures in °C.
(
    // Health a player starts with, before their Hitpoints level sets it (twice the level).
    max_health: 20,
    // What a new player starts with: item and count (in as many slots as it takes; baked
    // food takes one each), after `pack_end`. Nothing: a new player picks up the flint lying
    // near where they wake, breaks a dead snag for sticks and knaps flint tools, since bare
    // hands cannot fell a tree (the first quests say how). A mod that wants a kit lists one
    // here, for example `("base:bread", 4)`.
    starter_kit: [],
    // What a new player starts with in the pack's last slots (last first), out of the
    // hotbar's way: the empty coin purse.
    pack_end: [("base:coin_purse", 1)],
    // How many new players from one address get the starter kit in any `kit_window`
    // seconds (a real day), so fresh names do not farm it; the rest start with `pack_end`
    // only. Players on the server's own machine in process always get it.
    kits_per_address: 1,
    kit_window: 86400.0,
    // Falls shorter than this many blocks do no damage; each block more costs one.
    safe_fall: 3.0,
    // Lava burns this much health every so many seconds.
    burn: 4,
    burn_every: 0.5,
    // Below this height the void takes all of a player's health.
    void_below: -16.0,
    // Blocks giving at least this much light (of 15) warm those near them: up to `heat` at
    // their heart, fading to nothing past `heat_reach` blocks.
    heat_emission: 12,
    heat: 14.0,
    heat_reach: 4,
    // How much colder standing in water feels.
    water_chill: 8.0,
    // How far up a roof is looked for, to tell whether a player is out in the weather.
    roof_scan: 48,
    // A home (the lit hearth, else the bed last slept in) reaches this many blocks out on each
    // side, up and down. Its furnishings are counted in that box and a player feels it
    // standing in it (effects.ron's AtHome and HomeHas).
    home_reach: 7,
    home_up: 4,
    home_down: 2,
    // What stands in a room rather than walls it in: the survey of a home's walls looks past a
    // block with one of these tags and no shelter tag to the wall behind it, so a chest or a
    // table by the wall never counts as a draughty face, and a barrel in a doorway is no door.
    // A railing on a gallery or a balcony walls nothing either, nor a ladder up to a loft. A shelter tag always wins:
    // cloth hung for a wall, a hay bale or a column is a wall.
    home_furniture: ["machine", "station", "furnishing", "storage", "decor", "multiblock_core", "farm", "waters", "railing", "ladder"],
    // The most a home's meal effects together (a pantry, a larder, a kitchen garden, home
    // cooking, a seat at the table: effects.ron's meal_heal and meal_time, which multiply)
    // make of a meal's heal, and of how long its good lasts.
    meal_most: 2.0,
    // No lying down to sleep with a creature that hunts players this many blocks off, or this
    // many seconds after being hurt: rest is not a way to heal in a fight.
    sleep_threat_reach: 12.0,
    sleep_after_hurt: 15.0,
    // The most health a second brings back by itself, however many heal buffs and prayers
    // are on. Eating stays the way to heal in a hurry: at load this must be below what the
    // slowest food heals a second, eaten bite after bite.
    heal_most: 1.0,
)
