// What each translation in `../ja.ron` of English that lives in definitions (titles,
// descriptions, guide lines, help) was made from: by the same keys, the English and the
// Japanese written for it. When a definition's English changes, a guide line is inserted
// (shifting the keys after it) or the Japanese changes, the test
// `every_translation_follows_its_english` names it: check the Japanese follows the
// English, then set both here. A mod pins its own translations beside them.
{
    "command.core.biome.help": ("Names the biome you stand in, and its climate.", "立っているバイオームと、その気候を教えます。"),
    "command.core.biome.help.summary": ("Names the biome you stand in, and its climate.", "今いるバイオームを教えます。"),
    "command.core.clear.help": ("Empties your inventory, or takes every one of an item out of it.", "持ち物を空にするか、指定したアイテムをすべて取り除きます。"),
    "command.core.clear.help.summary": ("Empties your inventory, or takes every one of an item out of it.", "持ち物を空にします。"),
    "command.core.creatures.help": ("Lists the creatures within 64 blocks of you: how many of each, and what the nearest is doing. Admins may tame those within 8 blocks, ready the kept ones there to breed, hasten them (products due and young grown at once), hold them still for a minute or let a hold go (release), kill them, or take away the ones they keep; only of one species, if they name it. Populate tries natural spawning nearby and holds arrivals for a minute; disperse removes nearby wild creatures; people says how many of the settlement people due out near players are out.", "64ブロック以内の生き物を一覧表示します: 種類ごとの数と、いちばん近い個体が何をしているか。管理者は8ブロック以内の生き物を手なずけたり、飼っている生き物を繁殖できる状態にしたり、成長を早めたり (産物がすぐに出て、子供がすぐに育つ)、1分間じっとさせたり、その足止めを解いたり (release)、倒したり、飼っている生き物を取り除いたりできます。種類を指定すれば、その種類だけに行います。populateは周囲で自然な出現を試し、現れた個体を1分間じっとさせます。disperseは周囲の野生の生き物を取り除きます。peopleは、プレイヤーの近くに出てくるはずの集落の人のうち何人が出ているかを示します。"),
    "command.core.creatures.help.summary": ("Lists the creatures within 64 blocks of you: how many of each, and what the nearest is doing.", "64ブロック以内の生き物を一覧表示します。"),
    "command.core.day.help": ("Sets the time to morning: /time set day.", "時刻を朝にします: /time set day。"),
    "command.core.day.help.summary": ("Sets the time to morning: /time set day.", "時刻を朝にします。"),
    "command.core.deop.help": ("Takes an online player's admin rights away until they leave. One named when the server started, or with its admin token, is an admin again when they come back.", "オンラインのプレイヤーの管理者権限を、退出するまで外します。起動時に指定した管理者や管理者トークンを使う人は、次に参加すると管理者に戻ります。"),
    "command.core.deop.help.summary": ("Takes an online player's admin rights away until they leave.", "プレイヤーの管理者権限を、退出するまで外します。"),
    "command.core.drop.help": ("Drops a stack of an item into the world (up to 64 at a time) at a block (~ is where you are), or at your feet.", "アイテムの束を (一度に64個まで) ワールドの指定したブロックか足元に落とします (~ は今いる場所)。"),
    "command.core.drop.help.summary": ("Drops a stack of an item into the world (up to 64 at a time) at a block (~ is where you are), or at your feet.", "アイテムをワールドに落とします。"),
    "command.core.effect.help": ("Gives you an effect for a while (60 seconds unless you say), as food would; clear takes them all away.", "食べ物のように、しばらく効果を与えます（指定がなければ60秒）。clear ですべて消します。"),
    "command.core.effect.help.summary": ("Gives you an effect for a while (60 seconds unless you say), as food would; clear takes them all away.", "効果を与えます。"),
    "command.core.fill.help": ("Fills the box between two corners with a block, up to 32768 of them; air empties it.", "2つの角の間の範囲を、32768個までブロックで埋めます。air で空にします。"),
    "command.core.fill.help.summary": ("Fills the box between two corners with a block, up to 32768 of them; air empties it.", "範囲をブロックで埋めます。"),
    "command.core.gamemode.help": ("Switches you, or a player, between survival (on foot) and creative (flight allowed).", "自分かプレイヤーをサバイバル (徒歩) とクリエイティブ (飛行可) で切り替えます。"),
    "command.core.gamemode.help.summary": ("Switches you, or a player, between survival (on foot) and creative (flight allowed).", "サバイバルとクリエイティブを切り替えます。"),
    "command.core.give.help": ("Gives you blocks, 64 unless you say: /give water to pour some. What does not fit drops at your feet.", "ブロックを受け取ります。指定がなければ64個です。/give water で水を注げます。入りきらない分は足元に落ちます。"),
    "command.core.give.help.summary": ("Gives you blocks, 64 unless you say: /give water to pour some.", "ブロックを受け取ります。"),
    "command.core.grow.help": ("Grows the crops within 8 blocks of you by a stage, or as many as you say (all the way to ripe with `ripe`), and brings back the wild plants picked there.", "8ブロック以内の作物を1段階、または指定した段階だけ育てます (`ripe` で実るまで)。そこで摘まれた野生の植物も戻します。"),
    "command.core.grow.help.summary": ("Grows the crops within 8 blocks of you by a stage, or as many as you say (all the way to ripe with `ripe`), and brings back the wild plants picked there.", "近くの作物を育てます。"),
    "command.core.help.help": ("Lists the commands you can use, or explains one.", "使えるコマンドを一覧し、またはひとつを説明します。"),
    "command.core.help.help.summary": ("Lists the commands you can use, or explains one.", "使えるコマンドを一覧します。"),
    "command.core.kill.help": ("Kills you, as a fall or a wolf would: you keep your three most valuable items and the rest lies where you fell.", "落下やオオカミにやられたときと同じように死にます。価値の高いアイテム3つは手元に残り、ほかは倒れた場所に落ちます。"),
    "command.core.kill.help.summary": ("Kills you, as a fall or a wolf would: you keep your three most valuable items and the rest lies where you fell.", "死にます。"),
    "command.core.heal.help": ("Heals you to full health at once.", "体力をすぐに全快させます。"),
    "command.core.heal.help.summary": ("Heals you to full health at once.", "体力を全快させます。"),
    "command.core.list.help": ("Lists who is online.", "オンラインの人を一覧します。"),
    "command.core.list.help.summary": ("Lists who is online.", "オンラインの人を一覧します。"),
    "command.core.locate.help": ("Finds the nearest place of a biome, of a river running deep in a gorge, or of a hamlet, village or town (of one size, if you say), within 4000 blocks unless you say (up to 10000), or the nearest sample of ore on the ground over a vein (of an ore such as iron, if you name one), within 1000.", "いちばん近いバイオーム、峡谷の深くを流れる川、小村、村、町 (大きさを指定すればその大きさのもの) を探します。範囲は指定がなければ4000ブロック (最大10000)。ore なら、鉱脈の上の地面にあるいちばん近い鉱石のかけらを1000ブロック以内で探します (iron などの鉱石の名前も指定できます)。"),
    "command.core.locate.help.summary": ("Finds the nearest place of a biome, of a river running deep in a gorge, or of a hamlet, village or town (of one size, if you say), within 4000 blocks unless you say (up to 10000), or the nearest sample of ore on the ground over a vein (of an ore such as iron, if you name one), within 1000.", "いちばん近いバイオーム、峡谷、集落、鉱石のかけらを探します。"),
    "command.core.night.help": ("Sets the time to night: /time set night.", "時刻を夜にします: /time set night。"),
    "command.core.night.help.summary": ("Sets the time to night: /time set night.", "時刻を夜にします。"),
    "command.core.op.help": ("Makes an online player an admin until they leave or /deop. Names are not checked, so admins named when the server starts count only when playing on its own machine (a tunnel that forwards players from elsewhere makes everyone look local); the server's admin token counts from anywhere.", "オンラインのプレイヤーを、退出するか /deop されるまで管理者にします。名前は確認されないため、起動時に指定した管理者はサーバーと同じマシンで遊ぶときだけ有効です（ほかの場所から転送するトンネルを使うと、全員が同じマシンにいるように見えます）。サーバーの管理者トークンはどこからでも有効です。"),
    "command.core.op.help.summary": ("Makes an online player an admin until they leave or /deop.", "プレイヤーを管理者にします。"),
    "command.core.seed.help": ("Tells the world's seed.", "ワールドのシードを教えます。"),
    "command.core.seed.help.summary": ("Tells the world's seed.", "ワールドのシードを教えます。"),
    "command.core.setblock.help": ("Puts a block at a position (~ is where you are, so ~ ~-1 ~ is under your feet), replacing what is there. Water and lava placed this way flow.", "指定した位置にブロックを置き、そこにあるものと置き換えます (~ は今いる場所なので ~ ~-1 ~ は足元)。こうして置いた水と溶岩は流れます。"),
    "command.core.setblock.help.summary": ("Puts a block at a position (~ is where you are, so ~ ~-1 ~ is under your feet), replacing what is there.", "指定した位置にブロックを置きます。"),
    "command.core.skill.help": ("Sets your level in a skill (farming, hunter, cooking, attack…), from 1 to the highest.", "スキル (農業、狩猟、料理、攻撃など) のレベルを1から最大の間で設定します。"),
    "command.core.skill.help.summary": ("Sets your level in a skill (farming, hunter, cooking, attack…), from 1 to the highest.", "スキルのレベルを設定します。"),
    "command.core.summon.help": ("Puts creatures of a species (rabbit, wolf, moonhare…) on the ground in front of you, or at a block (~ is where you are), one unless you say, up to 16; held, they stand still for a minute.", "指定した種類の生き物 (ウサギ、オオカミ、月ウサギなど) を目の前の地面か、指定したブロック (~ は今いる場所) に呼び出します。数の指定がなければ1体、最大16体。held を付けると1分間じっとしています。"),
    "command.core.summon.help.summary": ("Puts creatures of a species (rabbit, wolf, moonhare…) on the ground in front of you, or at a block (~ is where you are), one unless you say, up to 16; held, they stand still for a minute.", "生き物を呼び出します。"),
    "command.core.time.help": ("Shows or changes the time of day. A day is 24000 ticks, 30 minutes; 0 is sunrise and an in-game hour is 1000 ticks. set moves forward to the next such time, speed 10 runs days ten times as fast, freeze stops the sun and resume runs it at normal speed again.", "時刻を表示または変更します。1日は24000ティック (30分) で、0が日の出、ゲーム内の1時間は1000ティック。set は次のその時刻まで進め、speed 10 は1日を10倍速にし、freeze は太陽を止め、resume は通常の速さに戻します。"),
    "command.core.time.help.summary": ("Shows or changes the time of day.", "時刻を表示または変更します。"),
    "command.core.tp.help": ("Teleports you, or a player, to coordinates or to another player. ~ is where the player is now, so ~ ~10 ~ goes ten blocks up; with only x and z you land on the ground.", "自分かプレイヤーを座標か別のプレイヤーのところへテレポートします。~ は今いる場所なので ~ ~10 ~ は10ブロック上。x と z だけなら地面に降ります。"),
    "command.core.tp.help.summary": ("Teleports you, or a player, to coordinates or to another player.", "自分かプレイヤーをテレポートします。"),
    "command.core.wander.help": ("Tells which wandering parties are about (the people, animals and monsters that come by on their own errands), lists the kinds there are, starts one 40 blocks ahead of you where you look, or sends every party away.", "近くにいる旅の一行 (それぞれの用事で通りかかる人・動物・怪物) を表示し、種類の一覧を出し、見ている方向40ブロック先に一行を呼び出し、あるいは一行を全員去らせます。"),
    "command.core.wander.help.summary": ("Tells which wandering parties are about (the people, animals and monsters that come by on their own errands), lists the kinds there are, starts one 40 blocks ahead of you where you look, or sends every party away.", "旅の一行を表示、呼び出し、去らせます。"),
    "command.core.wear.help": ("Wears the tool in your hand (or in that hotbar slot, 1 to 9) down (or mends it) to that many uses left, or burns what is there down to that many seconds.", "手に持った道具（またはそのホットバーの枠1〜9の道具）を、残りの使用回数がその数になるまですり減らします（または直します）。燃えている物は残りの秒数をその数にします。"),
    "command.core.wear.help.summary": ("Wears the tool in your hand (or in that hotbar slot, 1 to 9) down (or mends it) to that many uses left, or burns what is there down to that many seconds.", "手に持った道具（または指定した枠の道具）の残り使用回数（燃える物は秒数）を変えます。"),
    "command.core.weather.help": ("Shows the weather here, or brings a kind of weather (/weather list names them) to the land around you, as intense as you say (each kind has its usual intensity; 1 is its fiercest), for five minutes unless you say, after which the natural weather takes over again. natural ends it now.", "ここの天気を表示するか、周りの土地に天気 (/weather list で一覧) をもたらします。強さを指定でき (種類ごとにいつもの強さがあり、1が最も激しい)、指定がなければ5分間続いたあと自然の天気に戻ります。natural ですぐに終わります。"),
    "command.core.weather.help.summary": ("Shows the weather here, or brings a kind of weather (/weather list names them) to the land around you, as intense as you say (each kind has its usual intensity; 1 is its fiercest), for five minutes unless you say, after which the natural weather takes over again.", "ここの天気を表示するか、天気をもたらします。"),
    "command.core.wind.help": ("Shows the wind here, or brings a wind (calm, breeze, strong or gale; /wind list names them) to the land around you, from a direction (n, ne, e, se, s, sw, w, nw or degrees from north) if you say, for five minutes unless you say. /weather natural ends it.", "ここの風を表示するか、周りの土地に風 (calm、breeze、strong、gale。/wind list で一覧) を吹かせます。向き (n、ne、e、se、s、sw、w、nw か北からの角度) を指定でき、指定がなければ5分間続きます。/weather natural で終わります。"),
    "command.core.wind.help.summary": ("Shows the wind here, or brings a wind (calm, breeze, strong or gale; /wind list names them) to the land around you, from a direction (n, ne, e, se, s, sw, w, nw or degrees from north) if you say, for five minutes unless you say.", "ここの風を表示するか、風を吹かせます。"),
    "effect.core.by_the_fire": ("By the fire", "焚き火のそば"),
    "effect.core.by_the_fire.description": ("Warmed by a fire or torch nearby.", "近くの火や松明で温まっている。"),
    "effect.core.chilly": ("Chilly", "肌寒い"),
    "effect.core.chilly.description": ("Heal slower and move a little stiffly. Find warmth.", "回復が遅く、少し動きにくい。暖まろう。"),
    "effect.core.drenched": ("Drenched", "ずぶ濡れ"),
    "effect.core.drenched.description": ("A downpour: 7° colder, slower to heal and to walk, until you dry off by a fire or hang your things on a peg rail indoors.", "土砂降り。火のそばで乾かすか、屋内で掛け釘に掛けるまで7度寒く、回復も歩みも遅くなる。"),
    "effect.core.freezing": ("Freezing", "凍える"),
    "effect.core.freezing.description": ("No healing, slow and numb, lose health. Get warm.", "回復せず、体がこわばり、体力が減る。暖まろう。"),
    "effect.core.hot": ("Hot", "暑い"),
    "effect.core.hot.description": ("Heal slower.", "回復が遅くなる。"),
    "effect.core.overheated": ("Overheated", "熱中症"),
    "effect.core.overheated.description": ("No healing, lose health. Find shade or water.", "回復せず、体力が減る。日陰か水辺へ。"),
    "effect.core.pelted": ("Pelted by hail", "雹に打たれて"),
    "effect.core.pelted.description": ("Hail stings: lose a point of health now and then. Get under a roof.", "雹が痛い。ときどき体力が1減る。屋根の下へ。"),
    "effect.core.sandblasted": ("Sandblasted", "砂嵐"),
    "effect.core.sandblasted.description": ("Sand in the air: slower going and harder to work.", "砂が舞う。進みにくく、作業もはかどらない。"),
    "effect.core.snowblown": ("Snowblown", "雪まみれ"),
    "effect.core.snowblown.description": ("Snow underfoot and in your face: 3° colder and slower going.", "足元も顔も雪だらけ。3度寒く、進みにくい。"),
    "effect.core.soaked": ("Soaked", "雨に濡れて"),
    "effect.core.soaked.description": ("Rain runs down your back: you feel 4° colder until you dry off by a fire or hang your things on a peg rail indoors.", "雨が背中を伝う。火のそばで乾かすか、屋内で掛け釘に掛けるまで4度寒く感じる。"),
    "effect.core.storm_wary": ("Storm-wary", "雷に用心"),
    "effect.core.storm_wary.description": ("Lightning about: you heal slower and learn less while out in it.", "雷が近い。外にいる間は回復が遅く、経験も少し減る。"),
    "effect.core.windswept": ("Windswept", "強風"),
    "effect.core.windswept.description": ("The gale takes your breath and your warmth: 3° colder, slower going.", "風に息も温もりも奪われる。3度寒く、進みにくい。"),
    "skill.core.alchemy": ("Alchemy", "錬金術"),
    "skill.core.alchemy.description": ("Brews from the properties every plant, fungus and drop carries; boost potions stand in for levels.", "植物やキノコや素材が持つ性質から薬を作る。強化薬はレベルの代わりになる。"),
    "skill.core.alchemy.guide.0": ("Herb teas; mortar and pestle", "薬草茶、乳鉢と乳棒"),
    "skill.core.alchemy.guide.0.how": ("Steep any herb at a campfire; each brew reveals a property.", "焚き火で薬草を煎じる。煎じるたびに性質がひとつわかる。"),
    "skill.core.alchemy.guide.1": ("Tonics from two herbs that share a property", "性質を共有する二つの薬草の強壮剤"),
    "skill.core.alchemy.guide.1.how": ("Two herbs that share a property make a tonic stronger than tea.", "性質を共有する二つの薬草で、茶より強い強壮剤になる。"),
    "skill.core.alchemy.guide.10": ("Elixir of swiftness: 5% faster for good", "俊足の霊薬：永久に5%速くなる"),
    "skill.core.alchemy.guide.10.how": ("Rare herbs make it; drink once, keep it for good.", "珍しい薬草から作る。一度飲めば永久に続く。"),
    "skill.core.alchemy.guide.11": ("Condensed aether; Overload", "凝縮エーテル、オーバーロード"),
    "skill.core.alchemy.guide.11.how": ("Condensed aether, and Overload: several combat boosts in one.", "凝縮エーテルと、いくつもの戦闘強化をまとめたオーバーロード。"),
    "skill.core.alchemy.guide.12": ("Elixir of vigour: 10 more health for good", "活力の霊薬：永久に体力+10"),
    "skill.core.alchemy.guide.12.how": ("Another permanent elixir: ten more health.", "もうひとつの永久の霊薬：体力+10。"),
    "skill.core.alchemy.guide.13": ("Mastery: the philosopher's draught, +4 to every skill for a minute", "極意：賢者の薬、1分間すべてのスキルに+4"),
    "skill.core.alchemy.guide.13.how": ("A rare brew: +4 to every skill for a minute.", "まれな薬：1分間すべてのスキルに+4。"),
    "skill.core.alchemy.guide.14": ("Cape perk: an extra dose in every brew", "ケープの特典：どの薬も1回分多い"),
    "skill.core.alchemy.guide.14.how": ("Reach 80: every brew gives one more dose.", "80になると、どの薬も1回分多くなる。"),
    "skill.core.alchemy.guide.2": ("Cauldron: two-dose tonics", "大釜：2回分の強壮剤"),
    "skill.core.alchemy.guide.2.how": ("A cauldron over the fire brews two doses at once.", "火にかけた大釜で一度に2回分作れる。"),
    "skill.core.alchemy.guide.3": ("Antidote; warm and cool draughts", "解毒剤、温めと冷ましの薬"),
    "skill.core.alchemy.guide.3.how": ("Antidote cures poison; warm and cool draughts fight the weather.", "解毒剤は毒を治し、温め薬と冷まし薬は天候に耐える。"),
    "skill.core.alchemy.guide.4": ("Alembic: four-dose potions", "蒸留器：4回分の薬"),
    "skill.core.alchemy.guide.4.how": ("A potter's alembic distils four doses into one vial.", "陶工の蒸留器で4回分を一本の小瓶にまとめる。"),
    "skill.core.alchemy.guide.5": ("Boost potions: +1 to +3 to a skill", "強化薬：スキルに+1から+3"),
    "skill.core.alchemy.guide.5.how": ("A boost lifts a skill's level for a while: make a recipe early.", "強化薬はしばらくスキルのレベルを上げる。早めに作れるようになる。"),
    "skill.core.alchemy.guide.6": ("Calming draught, for taming", "鎮静薬（手なずけ用）"),
    "skill.core.alchemy.guide.6.how": ("Calms a wild animal you want to tame.", "手なずけたい野生の動物を落ち着かせる。"),
    "skill.core.alchemy.guide.7": ("Coatings: fire oil, poison, silver dust", "塗り薬：火の油、毒、銀の粉"),
    "skill.core.alchemy.guide.7.how": ("Coat a weapon before a fight: fire for what fears flame, poison, silver for spirits.", "戦いの前に武器に塗る。火を嫌う相手には火、毒、霊には銀。"),
    "skill.core.alchemy.guide.8": ("Steady hand: +2 Engineering or Crafting", "確かな手：工学か工作に+2"),
    "skill.core.alchemy.guide.8.how": ("Fixed +2 to Engineering or Crafting, for building.", "工学か工作に固定で+2。ものづくり向け。"),
    "skill.core.alchemy.guide.9": ("Surge draughts: +6, falling by one a minute", "奔流の薬：+6、1分ごとに1下がる"),
    "skill.core.alchemy.guide.9.how": ("+6 at first, losing one a minute: drink just before.", "最初は+6、1分ごとに1下がる。直前に飲む。"),
    "skill.core.attack": ("Attack", "攻撃"),
    "skill.core.attack.description": ("Hitting hard and often, with weapons, fangs and claws.", "武器、牙、爪で、強く、何度も打つ。"),
    "skill.core.attack.guide.0": ("Fists, wooden and stone weapons, and a bone club; your blows land and hurt more as you level", "素手、木と石の武器、骨の棍棒。レベルが上がるほど攻撃が当たりやすく、痛くなる"),
    "skill.core.attack.guide.1": ("Copper weapons", "銅の武器"),
    "skill.core.attack.guide.2": ("Fang daggers that bleed", "出血させる牙の短剣"),
    "skill.core.attack.guide.3": ("Bronze weapons", "青銅の武器"),
    "skill.core.attack.guide.4": ("Iron weapons", "鉄の武器"),
    "skill.core.attack.guide.5": ("Cobalt weapons", "コバルトの武器"),
    "skill.core.attack.guide.6": ("Silver weapons, stronger against supernatural creatures", "銀の武器。超自然の生き物によく効く"),
    "skill.core.attack.guide.7": ("Diamond-edged weapons", "ダイヤモンドの刃の武器"),
    "skill.core.attack.guide.8": ("Ember-scale blades", "炎鱗の刃"),
    "skill.core.attack.guide.9": ("Aetherite weapons", "エーテライトの武器"),
    "skill.core.construction": ("Construction", "建築"),
    "skill.core.construction.description": ("Your home: the hearth's tiers and the fixtures that give buffs; also dams, rails and bridges.", "家づくり：炉の段階と効果をくれる設備。ダムや線路や橋も。"),
    "skill.core.construction.guide.0": ("Hearth tier 1: bedroll and fire ring", "炉の段階1：寝袋と焚き火の輪"),
    "skill.core.construction.guide.0.how": ("Build the Homestead Hearth and sleep beside it.", "開拓の炉を建て、そばで眠る。"),
    "skill.core.construction.guide.1": ("Hearthstone, chimney and pit kiln", "炉石、煙突、野窯"),
    "skill.core.construction.guide.1.how": ("Dress cobbles into a hearthstone, cobbles and clay into a chimney, and ring a campfire with cobbles for a pit kiln.", "丸石を炉石に、丸石と粘土を煙突に仕上げ、焚き火を丸石で囲んで野窯にする。"),
    "skill.core.construction.guide.2": ("Herb planter", "薬草のプランター"),
    "skill.core.construction.guide.2.how": ("Planks and dirt: herbs and flowers placed in it grow back.", "板材と土。植えた薬草や花がまた生えてくる。"),
    "skill.core.construction.guide.3": ("Hearth tier 2: bed, stove, larder, workbench", "炉の段階2：ベッド、かまど、食料庫、作業机"),
    "skill.core.construction.guide.3.how": ("Upgrade the hearth; fixtures near it give their buffs.", "炉を強化する。近くの設備が効果をくれる。"),
    "skill.core.construction.guide.4": ("Stone altar", "石の祭壇"),
    "skill.core.construction.guide.4.how": ("Stone bricks: it will restore prayer and take bones for Magic.", "石レンガ。祈りを回復し、骨を捧げて魔法の経験を得られるようになる。"),
    "skill.core.construction.guide.5": ("Fences, wells and gates", "柵、井戸、門"),
    "skill.core.construction.guide.5.how": ("Fences keep animals in; a well waters crops anywhere.", "柵は動物を囲い、井戸はどこでも作物に水をやる。"),
    "skill.core.construction.guide.6": ("Hearth tier 3: better fixtures", "炉の段階3：よりよい設備"),
    "skill.core.construction.guide.6.how": ("Better fixtures for a stronger home.", "より強い家のための、よりよい設備。"),
    "skill.core.construction.guide.7": ("Kennel and stable", "犬小屋と馬小屋"),
    "skill.core.construction.guide.7.how": ("Homes for your pets and mounts.", "ペットや乗り物の家。"),
    "skill.core.construction.guide.8": ("Hearth tier 4; ritual circle", "炉の段階4、儀式の輪"),
    "skill.core.construction.guide.8.how": ("A stone hearth, and a circle for rituals.", "石の炉と儀式の輪。"),
    "skill.core.construction.guide.9": ("Telescope; trophy stand", "望遠鏡、戦利品台"),
    "skill.core.construction.guide.9.how": ("See the sky's events; show off your trophies.", "空の出来事を見る。戦利品を飾る。"),
    "skill.core.construction.guide.10": ("Hearth tier 5; bath", "炉の段階5、風呂"),
    "skill.core.construction.guide.10.how": ("A bath washes away debuffs.", "風呂は弱体効果を洗い流す。"),
    "skill.core.construction.guide.11": ("Dams", "ダム"),
    "skill.core.construction.guide.11.how": ("Hold back rivers for water wheels and fields.", "川をせき止め、水車や畑に使う。"),
    "skill.core.construction.guide.12": ("Alchemy bench; map table", "錬金台、地図机"),
    "skill.core.construction.guide.12.how": ("Brew at home; plan journeys on the map table.", "家で調合し、地図机で旅を計画する。"),
    "skill.core.construction.guide.13": ("Hearth tier 6", "炉の段階6"),
    "skill.core.construction.guide.13.how": ("A larger home radius.", "家の範囲が広がる。"),
    "skill.core.construction.guide.14": ("Hearth tier 8; portal frame", "炉の段階8、転移門の枠"),
    "skill.core.construction.guide.14.how": ("Portals between your homes start here.", "家どうしをつなぐ転移門はここから。"),
    "skill.core.construction.guide.15": ("Hearth tier 10; house core", "炉の段階10、家の核"),
    "skill.core.construction.guide.15.how": ("The house core: the home at its strongest.", "家の核：いちばん強い家。"),
    "skill.core.construction.guide.16": ("Grand fixtures: buffs half again as strong", "大設備：効果が1.5倍"),
    "skill.core.construction.guide.16.how": ("Grand fixtures give their buffs half again as strong.", "大設備は効果が1.5倍になる。"),
    "skill.core.construction.guide.17": ("Mastery: a second home", "極意：二つ目の家"),
    "skill.core.construction.guide.17.how": ("A second hearth: two homes to wake at.", "二つ目の炉：目覚められる家が二つに。"),
    "skill.core.construction.guide.18": ("Cape perk: go home whenever you like", "ケープの特典：いつでも家に帰れる"),
    "skill.core.construction.guide.18.how": ("Reach 80: travel home whenever you like.", "80になると、いつでも家に帰れる。"),
    "skill.core.cooking": ("Cooking", "料理"),
    "skill.core.cooking.description": ("Turning crops, meat and wild food into meals that feed, heal and warm you.", "作物や肉、野の恵みを、お腹を満たし、傷を癒し、体を温める食事にする。"),
    "skill.core.cooking.guide.0": ("Campfire: roast meat, fish, eggs, roots and mushrooms; herb tea", "焚き火: 肉、魚、卵、根菜、きのこを焼く。ハーブティー"),
    "skill.core.cooking.guide.1": ("Pot: boiled eggs and porridge", "鍋: ゆで卵とおかゆ"),
    "skill.core.cooking.guide.10": ("Smoker: smoked meat and fish", "燻製小屋: 肉と魚の燻製"),
    "skill.core.cooking.guide.11": ("Fresh cheese", "フレッシュチーズ"),
    "skill.core.cooking.guide.12": ("Honey cakes and taming treats", "はちみつケーキと手なずけのおやつ"),
    "skill.core.cooking.guide.13": ("Drying rack: jerky and dried fruit, in dry air", "干し台: 乾いた空気でジャーキーと干し果物"),
    "skill.core.cooking.guide.14": ("Crock: sauerkraut and pickles, somewhere cool", "つぼ: 涼しい所でザワークラウトとピクルス"),
    "skill.core.cooking.guide.15": ("Glowcap broth: sight in the dark", "ヒカリダケのスープ: 暗闇で目が利く"),
    "skill.core.cooking.guide.16": ("Emberfruit stew: warmth and fire resistance", "熾火の実のシチュー: 体が温まり、火に強くなる"),
    "skill.core.cooking.guide.17": ("Frostpetal sorbet: heat resistance", "霜花のシャーベット: 暑さに強くなる"),
    "skill.core.cooking.guide.18": ("Moonhare stew and starlily tea", "月ウサギのシチューと星百合の茶"),
    "skill.core.cooking.guide.19": ("Heartbloom pie: more health for an hour", "心花のパイ: 1時間、体力が増える"),
    "skill.core.cooking.guide.2": ("Quern: flour and flatbread", "石臼: 小麦粉と平焼きパン"),
    "skill.core.cooking.guide.20": ("Banquets: shared effects for everyone at the table", "宴: 食卓を囲む全員に効果"),
    "skill.core.cooking.guide.3": ("Animal feed: mash and seed mix", "家畜のえさ: マッシュと混ぜ種"),
    "skill.core.cooking.guide.4": ("Oven: bread", "かまど: パン"),
    "skill.core.cooking.guide.5": ("Pan: omelettes and fried eggs", "フライパン: オムレツと目玉焼き"),
    "skill.core.cooking.guide.6": ("Vegetable stew", "野菜のシチュー"),
    "skill.core.cooking.guide.7": ("Churn: butter and cream", "バター作り: バターとクリーム"),
    "skill.core.cooking.guide.8": ("Meat stew and hunter's stew", "肉のシチューと狩人のシチュー"),
    "skill.core.cooking.guide.9": ("Pies", "パイ"),
    "skill.core.crafting": ("Crafting", "工作"),
    "skill.core.crafting.description": ("Making materials, cloth, leather and fine things.", "素材、布、革、細工物を作る。"),
    "skill.core.crafting.guide.0": ("Planks and sticks from logs; bricks and sandstone", "原木から板材と棒、レンガと砂岩"),
    "skill.core.crafting.guide.1": ("Mossy stonework", "苔むした石材"),
    "skill.core.crafting.guide.2": ("Grain sacks woven of twine", "より糸で編む穀物袋"),
    "skill.core.crafting.guide.3": ("Rope and twine from fibre (to come)", "繊維から縄とより糸（予定）"),
    "skill.core.crafting.guide.4": ("Wool cloth and beds (to come)", "毛織物とベッド（予定）"),
    "skill.core.crafting.guide.5": ("Leather from hides (to come)", "皮から革（予定）"),
    "skill.core.crafting.guide.6": ("Dyes from flowers and berries (to come)", "花と木の実から染料（予定）"),
    "skill.core.crafting.guide.7": ("Glass panes and lanterns (to come)", "板ガラスとランタン（予定）"),
    "skill.core.crafting.guide.8": ("Fine furniture and banners (to come)", "上等な家具と旗（予定）"),
    "skill.core.crafting.guide.9": ("Aether-woven cloth (to come)", "エーテル織りの布（予定）"),
    "skill.core.defence": ("Defence", "防御"),
    "skill.core.defence.description": ("Turning blows aside, and wearing armour.", "攻撃をかわし、鎧を着こなす。"),
    "skill.core.defence.guide.0": ("Hide armour; blows you turn aside while you fight back train it", "革の鎧。反撃している間は、受け流した攻撃で鍛えられる"),
    "skill.core.defence.guide.1": ("Hard leather", "硬い革"),
    "skill.core.defence.guide.10": ("Aetherite armour", "エーテライトの鎧"),
    "skill.core.defence.guide.11": ("Cape perk: protection spells last longer (when spells come)", "ケープの特典：守りの呪文が長く続く（呪文が来たら）"),
    "skill.core.defence.guide.11.how": ("Reach 80. Protection from blows, arrows and magic comes as spells, with their own bar.", "80になる。打撃、矢、魔法からの守りは、専用の枠を持つ呪文として来る。"),
    "skill.core.defence.guide.2": ("Copper armour; wolf-pelt cloaks for the cold", "銅の鎧。寒さを防ぐオオカミの毛皮のマント"),
    "skill.core.defence.guide.3": ("Bronze armour", "青銅の鎧"),
    "skill.core.defence.guide.4": ("Bear-hide and iron armour", "クマの毛皮の鎧と鉄の鎧"),
    "skill.core.defence.guide.5": ("Crocodile-scale armour", "ワニのうろこの鎧"),
    "skill.core.defence.guide.6": ("Cobalt armour", "コバルトの鎧"),
    "skill.core.defence.guide.7": ("Silver mail against supernatural harm", "超自然の害を防ぐ銀の鎖帷子"),
    "skill.core.defence.guide.8": ("Ember-scale armour against fire", "火を防ぐ炎鱗の鎧"),
    "skill.core.defence.guide.9": ("Crystal-shell armour", "水晶の甲羅の鎧"),
    "skill.core.engineering": ("Engineering", "工学"),
    "skill.core.engineering.description": ("Making tools, stations and machines, and working metal.", "道具、作業場、機械を作り、金属を加工する。"),
    "skill.core.engineering.guide.0": ("Crafting tables, sticks, torches and wooden and stone tools", "作業台、棒、松明、木と石の道具"),
    "skill.core.engineering.guide.1": ("Shears for wool, pails for milk, campfires", "羊毛用のはさみ、ミルク用の手おけ、焚き火"),
    "skill.core.engineering.guide.10": ("Pulleys, gears and water wheels (to come)", "滑車、歯車、水車（予定）"),
    "skill.core.engineering.guide.11": ("Carts and rails (to come)", "トロッコとレール（予定）"),
    "skill.core.engineering.guide.12": ("Aether engines (to come)", "エーテル機関（予定）"),
    "skill.core.engineering.guide.2": ("Copper ingots and copper tools: faster work and better finds", "銅のインゴットと銅の道具。作業が速く、掘り出し物も増える"),
    "skill.core.engineering.guide.3": ("Copper tools and weapons mended with copper ingots at a grindstone", "銅の道具と武器は砥石車で銅のインゴットを使って直す"),
    "skill.core.engineering.guide.4": ("Tin, and the crucible at the heart of the kiln", "錫と、窯の心臓になるるつぼ"),
    "skill.core.engineering.guide.5": ("Bronze ingots and bronze tools: twice copper's life", "青銅のインゴットと青銅の道具。銅の倍長持ちする"),
    "skill.core.engineering.guide.6": ("Iron ingots and iron tools", "鉄のインゴットと鉄の道具"),
    "skill.core.engineering.guide.7": ("Doors, gates and ladders (to come)", "扉、門、はしご（予定）"),
    "skill.core.engineering.guide.8": ("Levers, pressure plates and traps (to come)", "レバー、感圧板、罠（予定）"),
    "skill.core.engineering.guide.9": ("A furnace and a forge for metals (to come)", "金属用のかまどと鍛冶場（予定）"),
    "skill.core.farming": ("Farming", "農業"),
    "skill.core.farming.description": ("Sowing, tending and harvesting crops, and keeping and breeding animals.", "作物の種まき、世話、収穫、そして動物の飼育と繁殖。"),
    "skill.core.farming.guide.0": ("Forage wild crops for their seeds, and sow them on soil near water", "野生の作物を採って種を得て、水辺の土にまく"),
    "skill.core.farming.guide.1": ("Keep and breed junglefowl and rabbits; collect eggs", "ヤケイとウサギを飼って繁殖させ、卵を集める"),
    "skill.core.farming.guide.10": ("Rabbits in high aether can become moonhares", "エーテルの濃い所ではウサギが月ウサギになることがある"),
    "skill.core.farming.guide.11": ("Inspecting shows hidden genes and carriers", "調べると隠れた遺伝子と保因がわかる"),
    "skill.core.farming.guide.12": ("Keep ember salamanders", "熾火サンショウウオを飼う"),
    "skill.core.farming.guide.13": ("Aether feed raises the chance of mutation", "エーテルの飼料で突然変異が起きやすくなる"),
    "skill.core.farming.guide.14": ("Keep crystal tortoises", "水晶ガメを飼う"),
    "skill.core.farming.guide.15": ("Keep griffins", "グリフォンを飼う"),
    "skill.core.farming.guide.16": ("Keep silver harts; harvests find rare produce a little more often", "銀の牡鹿を飼う。収穫でレアな作物が少し見つかりやすくなる"),
    "skill.core.farming.guide.2": ("Keep mallards", "マガモを飼う"),
    "skill.core.farming.guide.3": ("Keep mouflon and shear them; make compost", "ムフロンを飼って毛を刈り、堆肥を作る"),
    "skill.core.farming.guide.4": ("Keep pigs; they root for truffles", "ブタを飼う。トリュフを掘り当てる"),
    "skill.core.farming.guide.5": ("Keep ibex and milk them; harvests find uncommon produce a little more often", "アイベックスを飼って乳をしぼる。収穫でアンコモンな作物が少し見つかりやすくなる"),
    "skill.core.farming.guide.6": ("Keep bees in skeps for honey and wax", "巣箱でミツバチを飼い、はちみつと蜜ろうを得る"),
    "skill.core.farming.guide.7": ("Keep aurochs; inspecting an animal shows its visible genes", "オーロックスを飼う。動物を調べると見える遺伝子がわかる"),
    "skill.core.farming.guide.8": ("Keep horses; the studbook tracks lineage and inbreeding", "ウマを飼う。血統書で家系と近親交配を記録する"),
    "skill.core.farming.guide.9": ("Keep camels and donkeys; breed mules", "ラクダとロバを飼い、ラバを育てる"),
    "skill.core.fishing": ("Fishing", "釣り"),
    "skill.core.fishing.description": ("Catching fish with rods, nets and traps, in sea and fresh water.", "竿や網や罠で、海や淡水の魚を捕る。"),
    "skill.core.fishing.guide.0": ("Shrimp in any water, minnows in fresh; twine and a fishing rod", "どんな水でもエビ、淡水で小魚。より糸と釣り竿"),
    "skill.core.fishing.guide.1": ("Sardines in the sea", "海でイワシ"),
    "skill.core.fishing.guide.10": ("Tuna in warm seas", "暖かい海でマグロ"),
    "skill.core.fishing.guide.11": ("Swordfish in warm seas, rarely", "暖かい海でまれにカジキ"),
    "skill.core.fishing.guide.12": ("Glimmer koi in fantastical waters on rainy nights", "雨の夜、不思議な水辺で光鯉"),
    "skill.core.fishing.guide.13": ("Cape perk: casts land a little more often (to come)", "ケープの特典：少し釣れやすくなる（予定）"),
    "skill.core.fishing.guide.2": ("Perch in lakes and rivers", "湖や川でパーチ"),
    "skill.core.fishing.guide.3": ("Trout in cold fresh water", "冷たい淡水でマス"),
    "skill.core.fishing.guide.4": ("Cod in cold seas; a fine rod lands more and rarer fish", "冷たい海でタラ。上等な釣り竿で釣れやすく、珍しい魚も増える"),
    "skill.core.fishing.guide.5": ("Salmon in cold rivers", "冷たい川でサケ"),
    "skill.core.fishing.guide.6": ("Carp in warm and marshy water", "暖かい水や湿地でコイ"),
    "skill.core.fishing.guide.7": ("Bass in the sea", "海でスズキ"),
    "skill.core.fishing.guide.8": ("Pike in temperate lakes", "温帯の湖でカワカマス"),
    "skill.core.fishing.guide.9": ("Eels in fresh water at night", "夜の淡水でウナギ"),
    "skill.core.hitpoints": ("Hitpoints", "HP"),
    "skill.core.hitpoints.description": ("How much harm you can take: twice your level in health.", "どれだけの痛手に耐えられるか。体力はレベルの2倍。"),
    "skill.core.hitpoints.guide.0": ("20 health; it trains with every blow you land", "体力20。攻撃を当てるたびに鍛えられる"),
    "skill.core.hitpoints.guide.1": ("40 health", "体力40"),
    "skill.core.hitpoints.guide.2": ("Healing by yourself is a quarter faster (to come)", "自然な回復が4分の1速くなる（予定）"),
    "skill.core.hitpoints.guide.3": ("Cooked food heals a tenth more", "料理した食べ物の回復量が1割増える"),
    "skill.core.hitpoints.guide.4": ("100 health", "体力100"),
    "skill.core.hunter": ("Hunter", "狩猟"),
    "skill.core.hunter.description": ("Tracking, trapping and taming wild animals.", "野生の動物を追い、罠にかけ、手なずける。"),
    "skill.core.hunter.guide.0": ("Read fresh tracks and droppings; tame junglefowl and rabbits; set snares", "新しい足跡やふんを読む。ヤケイとウサギを手なずける。くくり罠を仕掛ける"),
    "skill.core.hunter.guide.1": ("Butchering what you hunt finds rarer parts a little more often", "狩った獲物をさばくと、珍しい部位が少し見つかりやすくなる"),
    "skill.core.hunter.guide.10": ("Tame moonhares; read the aether in creatures' signs", "月ウサギを手なずける。動物の気配からエーテルを読む"),
    "skill.core.hunter.guide.11": ("Tame ember salamanders", "熾火サンショウウオを手なずける"),
    "skill.core.hunter.guide.12": ("Tame bears", "クマを手なずける"),
    "skill.core.hunter.guide.13": ("Tame frost stags", "霜角鹿を手なずける"),
    "skill.core.hunter.guide.14": ("Tame sunwings", "陽翼鳥を手なずける"),
    "skill.core.hunter.guide.15": ("Tame griffins", "グリフォンを手なずける"),
    "skill.core.hunter.guide.16": ("Befriend silver harts", "銀の牡鹿と友になる"),
    "skill.core.hunter.guide.2": ("Tame mallards; bird nets", "マガモを手なずける。鳥網"),
    "skill.core.hunter.guide.3": ("Tame mouflon; mask your scent with herbs", "ムフロンを手なずける。薬草で匂いを消す"),
    "skill.core.hunter.guide.4": ("Tame ibex; box traps", "アイベックスを手なずける。箱罠"),
    "skill.core.hunter.guide.5": ("Tame wild boar", "イノシシを手なずける"),
    "skill.core.hunter.guide.6": ("Tame aurochs and alpacas", "オーロックスとアルパカを手なずける"),
    "skill.core.hunter.guide.7": ("Tame horses; lassos", "ウマを手なずける。投げ縄"),
    "skill.core.hunter.guide.8": ("Tame wolves and foxes", "オオカミとキツネを手なずける"),
    "skill.core.hunter.guide.9": ("Tame lynxes; deer calls and lures", "オオヤマネコを手なずける。シカの呼び笛とおとり"),
    "skill.core.magic": ("Magic", "魔法"),
    "skill.core.magic.description": ("Spells from aether: motes, glimmer dust and moon dust are the runes.", "エーテルの呪文。エーテルの粒、きらめく粉、月の粉がルーンになる。"),
    "skill.core.magic.guide.0": ("Wisp bolt, with your first aether mote", "鬼火の矢（最初のエーテルの粒で）"),
    "skill.core.magic.guide.0.how": ("Find an aether mote (wisps drop them) and bind it to a wand.", "エーテルの粒（鬼火が落とす）を見つけて杖に宿す。"),
    "skill.core.magic.guide.1": ("Mend: heal yourself or a pet", "癒し：自分やペットを治す"),
    "skill.core.magic.guide.1.how": ("Spend a mote to heal yourself or a pet a little.", "粒を使って自分やペットを少し治す。"),
    "skill.core.magic.guide.10": ("Gust and Freeze", "突風と凍結"),
    "skill.core.magic.guide.10.how": ("Push foes back, or freeze water and creatures.", "敵を押し返し、水や生き物を凍らせる。"),
    "skill.core.magic.guide.11": ("Chain lightning; aether bubble", "連鎖する稲妻、エーテルの泡"),
    "skill.core.magic.guide.11.how": ("Lightning that jumps between foes; a bubble that blocks blows.", "敵から敵へ飛ぶ稲妻と、攻撃を防ぐ泡。"),
    "skill.core.magic.guide.12": ("Calm: soothes a wild animal for taming", "鎮静：野生の動物をなだめて手なずけやすくする"),
    "skill.core.magic.guide.12.how": ("Soothes a wild animal so it trusts you sooner.", "野生の動物をなだめ、早く心を開かせる。"),
    "skill.core.magic.guide.13": ("Summon wisp; call the weather", "鬼火召喚、天候を呼ぶ"),
    "skill.core.magic.guide.13.how": ("A wisp fights beside you; call rain or clear skies.", "鬼火が共に戦う。雨や晴れを呼ぶ。"),
    "skill.core.magic.guide.14": ("Mastery: Starfall", "極意：星降り"),
    "skill.core.magic.guide.14.how": ("A rare spellbook from the Moon Hart.", "月の鹿のまれな呪文書。"),
    "skill.core.magic.guide.15": ("Cape perk: one spell costs no runes", "ケープの特典：ひとつの呪文にルーンがいらない"),
    "skill.core.magic.guide.15.how": ("Reach 80: one spell of your choice costs no runes.", "80になると、選んだ呪文ひとつにルーンがいらない。"),
    "skill.core.magic.guide.2": ("Stone bolt", "石の矢"),
    "skill.core.magic.guide.2.how": ("Earth runes from dust; a heavy bolt.", "粉から土のルーンを作る。重い矢の呪文。"),
    "skill.core.magic.guide.3": ("Light: a floating light", "明かり：浮かぶ光"),
    "skill.core.magic.guide.3.how": ("A floating light that follows you for a while.", "しばらくついてくる浮かぶ光。"),
    "skill.core.magic.guide.4": ("Fire bolt", "火の矢"),
    "skill.core.magic.guide.4.how": ("Ember scales from fire creatures fuel it.", "火の生き物の熾火のうろこが燃料になる。"),
    "skill.core.magic.guide.5": ("Frost touch", "凍える手"),
    "skill.core.magic.guide.5.how": ("Frost antlers chill and slow what you touch.", "霜の枝角が触れたものを冷やし、遅くする。"),
    "skill.core.magic.guide.6": ("Blink: a short teleport", "瞬間移動：短い転移"),
    "skill.core.magic.guide.6.how": ("Jump a few blocks in the direction you look.", "見ている方向へ数ブロック跳ぶ。"),
    "skill.core.magic.guide.7": ("Root: holds a creature in place", "根縛り：生き物をその場に留める"),
    "skill.core.magic.guide.7.how": ("Roots hold a creature still: for taming or a clean shot.", "根が生き物を留める。手なずけや狙い撃ちに。"),
    "skill.core.magic.guide.8": ("Lightning", "稲妻"),
    "skill.core.magic.guide.8.how": ("Storm motes, gathered in thunderstorms.", "雷雨で集める嵐の粒。"),
    "skill.core.magic.guide.9": ("Recall: one way home", "帰還：家へ一方通行"),
    "skill.core.magic.guide.9.how": ("A one-way trip to your hearth.", "炉への一方通行の旅。"),
    "skill.core.mining": ("Mining", "採掘"),
    "skill.core.mining.description": ("Digging stone, ore and gems from the ground.", "地中から石、鉱石、宝石を掘り出す。"),
    "skill.core.mining.guide.0": ("Stone, dirt, sand, gravel, clay and coal", "石、土、砂、砂利、粘土、石炭"),
    "skill.core.mining.guide.1": ("Copper", "銅"),
    "skill.core.mining.guide.10": ("Aetherite", "エーテライト"),
    "skill.core.mining.guide.2": ("Tin; bat guano in caves for compost", "スズ。洞窟のコウモリのふんは堆肥になる"),
    "skill.core.mining.guide.3": ("Iron", "鉄"),
    "skill.core.mining.guide.4": ("Salt licks that draw deer and ibex", "シカやアイベックスを呼ぶ塩なめ場"),
    "skill.core.mining.guide.5": ("Cobalt", "コバルト"),
    "skill.core.mining.guide.6": ("Silver", "銀"),
    "skill.core.mining.guide.7": ("Gold", "金"),
    "skill.core.mining.guide.8": ("Crystal from a living crystal tortoise's shell", "生きた水晶ガメの甲羅から水晶を採る"),
    "skill.core.mining.guide.9": ("Diamond", "ダイヤモンド"),
    "skill.core.ranged": ("Ranged", "飛び道具"),
    "skill.core.ranged.description": ("Bows, crossbows and thrown weapons: hitting flyers and what you cannot reach.", "弓、クロスボウ、投げ武器。飛ぶものや届かない相手を射る。"),
    "skill.core.ranged.guide.0": ("Sling, with cobbled stone", "投石器と丸石"),
    "skill.core.ranged.guide.0.how": ("A hide pouch on two cords of twine; any cobblestone is a shot.", "より糸2本に獣皮の袋をつける。丸石ならどれでも弾になる。"),
    "skill.core.ranged.guide.1": ("Shortbow with flint arrows", "火打ち石の矢と短弓"),
    "skill.core.ranged.guide.1.how": ("A bent stick and twine make the bow; knap flint for arrowheads.", "曲げた棒とより糸で弓を作り、火打ち石を打って矢じりにする。"),
    "skill.core.ranged.guide.10": ("Repeating crossbow, rifle", "連射クロスボウ、ライフル"),
    "skill.core.ranged.guide.10.how": ("Machined parts let it fire again and again.", "精密な部品で連射できる。"),
    "skill.core.ranged.guide.11": ("Railgun: pierces immunities", "レールガン：耐性を貫く"),
    "skill.core.ranged.guide.11.how": ("Superconducting coils fling a slug through any immunity.", "超伝導コイルの弾はどんな耐性も貫く。"),
    "skill.core.ranged.guide.12": ("Aether bow: no arrows", "エーテルの弓：矢がいらない"),
    "skill.core.ranged.guide.12.how": ("Aether strings a bow that needs no arrows.", "エーテルの弦の弓は矢がいらない。"),
    "skill.core.ranged.guide.13": ("Mastery: the storm griffin's bow", "極意：嵐のグリフォンの弓"),
    "skill.core.ranged.guide.13.how": ("A rare drop from the storm griffin, mastered at 78.", "嵐のグリフォンのまれな落とし物。78で使いこなせる。"),
    "skill.core.ranged.guide.14": ("Cape perk: most ammunition is recovered", "ケープの特典：弾薬の多くが戻る"),
    "skill.core.ranged.guide.14.how": ("Reach 80: most arrows and bolts come back to you.", "80になると、矢やボルトの多くが戻ってくる。"),
    "skill.core.ranged.guide.2": ("Bolas: tangles a creature for taming", "ボーラ：生き物を絡めて手なずけやすくする"),
    "skill.core.ranged.guide.2.how": ("Weights on cords; hit a fleeing animal and it stops for taming.", "紐に重りをつけた武器。逃げる動物に当てると止まり、手なずけられる。"),
    "skill.core.ranged.guide.3": ("Bronze arrowheads; javelins", "青銅の矢じり、投げ槍"),
    "skill.core.ranged.guide.3.how": ("Cast bronze heads in the Bronze age; javelins hit hard up close.", "青銅の時代に矢じりを鋳造する。投げ槍は近くで強い。"),
    "skill.core.ranged.guide.4": ("Horn bow, from horn and sinew", "角と腱の角弓"),
    "skill.core.ranged.guide.4.how": ("Horn and sinew from hunting make a bow that outranges wood.", "狩りで得た角と腱で、木より遠くまで届く弓を作る。"),
    "skill.core.ranged.guide.5": ("Fire arrows", "火矢"),
    "skill.core.ranged.guide.5.how": ("Wrap arrows in resin cloth; fire hurts what fears flame.", "矢を樹脂の布で包む。火を嫌う相手によく効く。"),
    "skill.core.ranged.guide.6": ("Crossbow; armour-piercing bolts", "クロスボウ、貫通ボルト"),
    "skill.core.ranged.guide.6.how": ("Iron and a crossbow bench; bolts pierce armour.", "鉄とクロスボウ台で作る。ボルトは鎧を貫く。"),
    "skill.core.ranged.guide.7": ("Harpoon, for fishing too", "銛（釣りにも）"),
    "skill.core.ranged.guide.7.how": ("A barbed spear on a line: reel in big fish or keep prey close.", "糸のついた返しつきの槍。大きな魚を引き寄せ、獲物を逃がさない。"),
    "skill.core.ranged.guide.8": ("Flintlock; bombs", "火打ち石銃、爆弾"),
    "skill.core.ranged.guide.8.how": ("Gunpowder from bat guano and saltpetre; bombs break blocks too.", "コウモリの糞と硝石から火薬を作る。爆弾はブロックも壊す。"),
    "skill.core.ranged.guide.9": ("Electric crossbow; silver bolts", "電気クロスボウ、銀のボルト"),
    "skill.core.ranged.guide.9.how": ("Batteries power the crossbow; silver bolts for supernatural foes.", "電池でクロスボウを動かす。超自然の敵には銀のボルト。"),
    "command.core.machine.help": ("Tells how the machine at a block is doing (~ is where you are): what it makes, its power, or what it lacks.", "ブロックにある機械の様子を伝えます (~ は今いる場所): 何を作っているか、動力、足りないもの。"),
    "command.core.machine.help.summary": ("Tells how the machine at a block is doing (~ is where you are): what it makes, its power, or what it lacks.", "ブロックにある機械の様子を伝えます。"),
    "command.core.home.help": ("Tells where your home is, how far its furnishing has come, and what the next step needs.", "家の場所と、家具が整ってきた度合い、次の段階に必要なものを伝えます。"),
    "command.core.home.help.summary": ("Tells where your home is, how far its furnishing has come, and what the next step needs.", "家の場所と次の段階に必要なものを伝えます。"),
    "command.core.quest.help": ("Marks a quest done for you (an age's rite opens its stations), its rewards waiting to be claimed.", "クエストを達成済みにします (時代の儀式を済ませると、その時代の作業台が使えるようになります)。報酬は受け取りを待ちます。"),
    "command.core.quest.help.summary": ("Marks a quest done for you (an age's rite opens its stations), its rewards waiting to be claimed.", "クエストを達成済みにします。"),
}
