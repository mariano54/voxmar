    "skill.core.alchemy": "Alchemy",
    "skill.core.alchemy.description": "Brews from the properties every plant, fungus and drop carries; boost potions stand in for levels.",
    "skill.core.alchemy.guide.0": "Herb teas; mortar and pestle",
    "skill.core.alchemy.guide.0.how": "Steep any herb at a campfire; each brew reveals a property.",
    "skill.core.alchemy.guide.1": "Tonics from two herbs that share a property",
    "skill.core.alchemy.guide.1.how": "Two herbs that share a property make a tonic stronger than tea.",
    "skill.core.alchemy.guide.10": "Elixir of swiftness: 5% faster for good",
    "skill.core.alchemy.guide.10.how": "Rare herbs make it; drink once, keep it for good.",
    "skill.core.alchemy.guide.11": "Condensed aether; Overload",
    "skill.core.alchemy.guide.11.how": "Condensed aether, and Overload: several combat boosts in one.",
    "skill.core.alchemy.guide.12": "Elixir of vigour: 10 more health for good",
    "skill.core.alchemy.guide.12.how": "Another permanent elixir: ten more health.",
    "skill.core.alchemy.guide.13": "Mastery: the philosopher's draught, +4 to every skill for a minute",
    "skill.core.alchemy.guide.13.how": "A rare brew: +4 to every skill for a minute.",
    "skill.core.alchemy.guide.14": "Cape perk: an extra dose in every brew",
    "skill.core.alchemy.guide.14.how": "Reach 80: every brew gives one more dose.",
    "skill.core.alchemy.guide.2": "Cauldron: two-dose tonics",
    "skill.core.alchemy.guide.2.how": "A cauldron over the fire brews two doses at once.",
    "skill.core.alchemy.guide.3": "Antidote; warm and cool draughts",
    "skill.core.alchemy.guide.3.how": "Antidote cures poison; warm and cool draughts fight the weather.",
    "skill.core.alchemy.guide.4": "Alembic: four-dose potions",
    "skill.core.alchemy.guide.4.how": "A potter's alembic distils four doses into one vial.",
    "skill.core.alchemy.guide.5": "Boost potions: +1 to +3 to a skill",
    "skill.core.alchemy.guide.5.how": "A boost lifts a skill's level for a while: make a recipe early.",
    "skill.core.alchemy.guide.6": "Calming draught, for taming",
    "skill.core.alchemy.guide.6.how": "Calms a wild animal you want to tame.",
    "skill.core.alchemy.guide.7": "Coatings: fire oil, poison, silver dust",
    "skill.core.alchemy.guide.7.how": "Coat a weapon before a fight: fire for what fears flame, poison, silver for spirits.",
    "skill.core.alchemy.guide.8": "Steady hand: +2 Engineering or Crafting",
    "skill.core.alchemy.guide.8.how": "Fixed +2 to Engineering or Crafting, for building.",
    "skill.core.alchemy.guide.9": "Surge draughts: +6, falling by one a minute",
    "skill.core.alchemy.guide.9.how": "+6 at first, losing one a minute: drink just before.",
