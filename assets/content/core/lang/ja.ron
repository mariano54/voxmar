    "effect.core.by_the_fire.description": "近くの火や松明で温まっている。",
    "effect.core.chilly": "肌寒い",
    "effect.core.chilly.description": "回復が遅く、少し動きにくい。暖まろう。",
    "effect.core.freezing": "凍える",
    "effect.core.freezing.description": "回復せず、体がこわばり、体力が減る。暖まろう。",
    "effect.core.hot": "暑い",
    "effect.core.hot.description": "回復が遅くなる。",
    "effect.core.overheated": "熱中症",
    "effect.core.overheated.description": "回復せず、体力が減る。日陰か水辺へ。",
    "effect.core.soaked": "雨に濡れて",
    "effect.core.soaked.description": "雨が背中を伝う。4度寒く感じる。屋根の下へ。",
    "effect.core.drenched": "ずぶ濡れ",
    "effect.core.drenched.description": "土砂降り。7度寒く、回復も歩みも遅くなる。",
    "effect.core.snowblown": "雪まみれ",
    "effect.core.snowblown.description": "足元も顔も雪だらけ。3度寒く、進みにくい。",
    "effect.core.pelted": "雹に打たれて",
    "effect.core.pelted.description": "雹が痛い。ときどき体力が1減る。屋根の下へ。",
    "effect.core.windswept": "強風",
    "effect.core.windswept.description": "風に息も温もりも奪われる。3度寒く、進みにくい。",
    "effect.core.sandblasted": "砂嵐",
    "effect.core.sandblasted.description": "砂が舞う。進みにくく、作業もはかどらない。",
    "effect.core.storm_wary": "雷に用心",
    "effect.core.storm_wary.description": "雷が近い。外にいる間は回復が遅く、経験も少し減る。",
