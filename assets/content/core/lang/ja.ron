    // スキル
    "skill.core.farming": "農業",
    "skill.core.farming.description": "作物の種まき、世話、収穫、そして動物の飼育と繁殖。",
    "skill.core.farming.guide.0": "野生の作物を採って種を得て、水辺の土にまく",
    "skill.core.farming.guide.1": "ヤケイとウサギを飼って繁殖させ、卵を集める",
    "skill.core.farming.guide.2": "マガモを飼う",
    "skill.core.farming.guide.3": "ムフロンを飼って毛を刈り、堆肥を作る",
    "skill.core.farming.guide.4": "ブタを飼う。トリュフを掘り当てる",
    "skill.core.farming.guide.5": "アイベックスを飼って乳をしぼる。収穫でアンコモンな作物が少し見つかりやすくなる",
    "skill.core.farming.guide.6": "巣箱でミツバチを飼い、はちみつと蜜ろうを得る",
    "skill.core.farming.guide.7": "オーロックスを飼う。動物を調べると見える遺伝子がわかる",
    "skill.core.farming.guide.8": "ウマを飼う。血統書で家系と近親交配を記録する",
    "skill.core.farming.guide.9": "ラクダとロバを飼い、ラバを育てる",
    "skill.core.farming.guide.10": "エーテルの濃い所ではウサギが月ウサギになることがある",
    "skill.core.farming.guide.11": "調べると隠れた遺伝子と保因がわかる",
    "skill.core.farming.guide.12": "熾火サンショウウオを飼う",
    "skill.core.farming.guide.13": "エーテルの飼料で突然変異が起きやすくなる",
    "skill.core.farming.guide.14": "水晶ガメを飼う",
    "skill.core.farming.guide.15": "グリフォンを飼う",
    "skill.core.farming.guide.16": "銀の牡鹿を飼う。収穫でレアな作物が少し見つかりやすくなる",
    "skill.core.hunter": "狩猟",
    "skill.core.hunter.description": "野生の動物を追い、罠にかけ、手なずける。",
    "skill.core.hunter.guide.0": "新しい足跡やふんを読む。ヤケイとウサギを手なずける。くくり罠を仕掛ける",
    "skill.core.hunter.guide.1": "狩った獲物をさばくと、珍しい部位が少し見つかりやすくなる",
    "skill.core.hunter.guide.2": "マガモを手なずける。鳥網",
    "skill.core.hunter.guide.3": "ムフロンを手なずける。薬草で匂いを消す",
    "skill.core.hunter.guide.4": "アイベックスを手なずける。箱罠",
    "skill.core.hunter.guide.5": "イノシシを手なずける",
    "skill.core.hunter.guide.6": "オーロックスとアルパカを手なずける",
    "skill.core.hunter.guide.7": "ウマを手なずける。投げ縄",
    "skill.core.hunter.guide.8": "オオカミとキツネを手なずける",
    "skill.core.hunter.guide.9": "オオヤマネコを手なずける。シカの呼び笛とおとり",
    "skill.core.hunter.guide.10": "月ウサギを手なずける。動物の気配からエーテルを読む",
    "skill.core.hunter.guide.11": "熾火サンショウウオを手なずける",
    "skill.core.hunter.guide.12": "クマを手なずける",
    "skill.core.hunter.guide.13": "霜角鹿を手なずける",
    "skill.core.hunter.guide.14": "陽翼鳥を手なずける",
    "skill.core.hunter.guide.15": "グリフォンを手なずける",
    "skill.core.hunter.guide.16": "銀の牡鹿と友になる",
    "skill.core.mining": "採掘",
    "skill.core.mining.description": "地中から石、鉱石、宝石を掘り出す。",
    "skill.core.mining.guide.0": "石、土、砂、砂利、粘土、石炭",
    "skill.core.mining.guide.1": "銅",
    "skill.core.mining.guide.2": "スズ。洞窟のコウモリのふんは堆肥になる",
    "skill.core.mining.guide.3": "鉄",
    "skill.core.mining.guide.4": "シカやアイベックスを呼ぶ塩なめ場",
    "skill.core.mining.guide.5": "コバルト",
    "skill.core.mining.guide.6": "銀",
    "skill.core.mining.guide.7": "金",
    "skill.core.mining.guide.8": "生きた水晶ガメの甲羅から水晶を採る",
    "skill.core.mining.guide.9": "ダイヤモンド",
    "skill.core.mining.guide.10": "エーテライト",
    "skill.core.engineering": "工学",
    "skill.core.engineering.description": "道具、作業場、機械を作り、金属を加工する。",
    "skill.core.engineering.guide.0": "作業台、棒、松明、木と石の道具",
    "skill.core.engineering.guide.1": "羊毛用のはさみ、ミルク用の手おけ、焚き火",
    "skill.core.engineering.guide.2": "銅のインゴットと銅の道具。作業が速く、掘り出し物も増える",
    "skill.core.engineering.guide.3": "錫。青銅はこれから",
    "skill.core.engineering.guide.4": "鉄のインゴットと鉄の道具",
    "skill.core.engineering.guide.5": "扉、門、はしご（予定）",
    "skill.core.engineering.guide.6": "レバー、感圧板、罠（予定）",
    "skill.core.engineering.guide.7": "金属用のかまどと鍛冶場（予定）",
    "skill.core.engineering.guide.8": "滑車、歯車、水車（予定）",
    "skill.core.engineering.guide.9": "トロッコとレール（予定）",
    "skill.core.engineering.guide.10": "エーテル機関（予定）",
    "skill.core.crafting": "工作",
    "skill.core.crafting.description": "素材、布、革、細工物を作る。",
    "skill.core.crafting.guide.0": "原木から板材と棒、レンガと砂岩",
    "skill.core.crafting.guide.1": "苔むした石材",
    "skill.core.crafting.guide.2": "繊維から縄とより糸（予定）",
    "skill.core.crafting.guide.3": "かごと袋（予定）",
    "skill.core.crafting.guide.4": "毛織物とベッド（予定）",
    "skill.core.crafting.guide.5": "皮から革（予定）",
    "skill.core.crafting.guide.6": "花と木の実から染料（予定）",
    "skill.core.crafting.guide.7": "板ガラスとランタン（予定）",
    "skill.core.crafting.guide.8": "上等な家具と旗（予定）",
    "skill.core.crafting.guide.9": "エーテル織りの布（予定）",
    "skill.core.fishing": "釣り",
    "skill.core.fishing.description": "竿や網や罠で、海や淡水の魚を捕る。",
    "skill.core.fishing.guide.0": "どんな水でもエビ、淡水で小魚。より糸と釣り竿",
    "skill.core.fishing.guide.1": "海でイワシ",
    "skill.core.fishing.guide.2": "湖や川でパーチ",
    "skill.core.fishing.guide.3": "冷たい淡水でマス",
    "skill.core.fishing.guide.4": "冷たい海でタラ。上等な釣り竿で釣れやすく、珍しい魚も増える",
    "skill.core.fishing.guide.5": "冷たい川でサケ",
    "skill.core.fishing.guide.6": "暖かい水や湿地でコイ",
    "skill.core.fishing.guide.7": "海でスズキ",
    "skill.core.fishing.guide.8": "温帯の湖でカワカマス",
    "skill.core.fishing.guide.9": "夜の淡水でウナギ",
    "skill.core.fishing.guide.10": "暖かい海でマグロ",
    "skill.core.fishing.guide.11": "暖かい海でまれにカジキ",
    "skill.core.fishing.guide.12": "雨の夜、不思議な水辺で光鯉",
    "skill.core.fishing.guide.13": "ケープの特典：少し釣れやすくなる（予定）",
    "skill.core.ranged": "飛び道具",
    "skill.core.ranged.description": "スリング、弓、クロスボウ、投げ武器。飛ぶものや届かない相手を射る。",
    "skill.core.ranged.guide.0": "スリング、投げ槍、石",
    "skill.core.ranged.guide.1": "火打ち石の矢と短弓",
    "skill.core.ranged.guide.2": "ボーラ：生き物を絡めて手なずけやすくする",
    "skill.core.ranged.guide.3": "青銅の矢じり、投げ槍",
    "skill.core.ranged.guide.4": "角と腱の角弓",
    "skill.core.ranged.guide.5": "火矢",
    "skill.core.ranged.guide.6": "クロスボウ、貫通ボルト",
    "skill.core.ranged.guide.7": "銛（釣りにも）",
    "skill.core.ranged.guide.8": "火打ち石銃、爆弾",
    "skill.core.ranged.guide.9": "電気クロスボウ、銀のボルト",
    "skill.core.ranged.guide.10": "連射クロスボウ、ライフル",
    "skill.core.ranged.guide.11": "レールガン：耐性を貫く",
    "skill.core.ranged.guide.12": "エーテルの弓：矢がいらない",
    "skill.core.ranged.guide.13": "極意：嵐のグリフォンの弓",
    "skill.core.ranged.guide.14": "ケープの特典：弾薬の多くが戻る",
    "skill.core.magic": "魔法",
    "skill.core.magic.description": "エーテルの呪文。エーテルの粒、きらめく粉、月の粉がルーンになる。",
    "skill.core.magic.guide.0": "鬼火の矢（最初のエーテルの粒で）",
    "skill.core.magic.guide.1": "癒し：自分やペットを治す",
    "skill.core.magic.guide.2": "石の矢",
    "skill.core.magic.guide.3": "明かり：浮かぶ光",
    "skill.core.magic.guide.4": "火の矢",
    "skill.core.magic.guide.5": "凍える手",
    "skill.core.magic.guide.6": "瞬間移動：短い転移",
    "skill.core.magic.guide.7": "根縛り：生き物をその場に留める",
    "skill.core.magic.guide.8": "稲妻",
    "skill.core.magic.guide.9": "帰還：家へ一方通行",
    "skill.core.magic.guide.10": "突風と凍結",
    "skill.core.magic.guide.11": "連鎖する稲妻、エーテルの泡",
    "skill.core.magic.guide.12": "鎮静：野生の動物をなだめて手なずけやすくする",
    "skill.core.magic.guide.13": "鬼火召喚、天候を呼ぶ",
    "skill.core.magic.guide.14": "極意：星降り",
    "skill.core.magic.guide.15": "ケープの特典：ひとつの呪文にルーンがいらない",
    "skill.core.alchemy": "錬金術",
    "skill.core.alchemy.description": "植物やキノコや素材が持つ性質から薬を作る。強化薬はレベルの代わりになる。",
    "skill.core.alchemy.guide.0": "薬草茶、乳鉢と乳棒",
    "skill.core.alchemy.guide.1": "性質を共有する二つの薬草の強壮剤",
    "skill.core.alchemy.guide.2": "大釜：2回分の強壮剤",
    "skill.core.alchemy.guide.3": "解毒剤、温めと冷ましの薬",
    "skill.core.alchemy.guide.4": "蒸留器：4回分の薬",
    "skill.core.alchemy.guide.5": "強化薬：スキルに+1から+3",
    "skill.core.alchemy.guide.6": "鎮静薬（手なずけ用）",
    "skill.core.alchemy.guide.7": "塗り薬：火の油、毒、銀の粉",
    "skill.core.alchemy.guide.8": "確かな手：工学か工作に+2",
    "skill.core.alchemy.guide.9": "奔流の薬：+6、1分ごとに1下がる",
    "skill.core.alchemy.guide.10": "俊足の霊薬：永久に5%速くなる",
    "skill.core.alchemy.guide.11": "凝縮エーテル、オーバーロード",
    "skill.core.alchemy.guide.12": "活力の霊薬：永久に体力+10",
    "skill.core.alchemy.guide.13": "極意：賢者の薬、1分間すべてのスキルに+4",
    "skill.core.alchemy.guide.14": "ケープの特典：どの薬も1回分多い",
    "skill.core.construction": "建築",
    "skill.core.construction.description": "家づくり：炉の段階と効果をくれる設備。ダムや線路や橋も。",
    "skill.core.construction.guide.0": "炉の段階1：寝袋と焚き火の輪",
    "skill.core.construction.guide.1": "炉の段階2：ベッド、かまど、食料庫、作業机",
    "skill.core.construction.guide.2": "柵、井戸、門",
    "skill.core.construction.guide.3": "炉の段階3：よりよい設備",
    "skill.core.construction.guide.4": "犬小屋と馬小屋",
    "skill.core.construction.guide.5": "炉の段階4、儀式の輪",
    "skill.core.construction.guide.6": "望遠鏡、戦利品台",
    "skill.core.construction.guide.7": "炉の段階5、風呂",
    "skill.core.construction.guide.8": "ダム",
    "skill.core.construction.guide.9": "錬金台、地図机",
    "skill.core.construction.guide.10": "炉の段階6",
    "skill.core.construction.guide.11": "炉の段階8、転移門の枠",
    "skill.core.construction.guide.12": "炉の段階10、家の核",
    "skill.core.construction.guide.13": "大設備：効果が1.5倍",
    "skill.core.construction.guide.14": "極意：二つ目の家",
    "skill.core.construction.guide.15": "ケープの特典：いつでも家に帰れる",
    "skill.core.ranged.guide.0.how": "より糸でスリングを作る。石ならどれでも弾になる。",
    "skill.core.ranged.guide.1.how": "曲げた棒とより糸で弓を作り、火打ち石を打って矢じりにする。",
    "skill.core.ranged.guide.2.how": "紐に重りをつけた武器。逃げる動物に当てると止まり、手なずけられる。",
    "skill.core.ranged.guide.3.how": "青銅の時代に矢じりを鋳造する。投げ槍は近くで強い。",
    "skill.core.ranged.guide.4.how": "狩りで得た角と腱で、木より遠くまで届く弓を作る。",
    "skill.core.ranged.guide.5.how": "矢を樹脂の布で包む。火を嫌う相手によく効く。",
    "skill.core.ranged.guide.6.how": "鉄とクロスボウ台で作る。ボルトは鎧を貫く。",
    "skill.core.ranged.guide.7.how": "糸のついた返しつきの槍。大きな魚を引き寄せ、獲物を逃がさない。",
    "skill.core.ranged.guide.8.how": "コウモリの糞と硝石から火薬を作る。爆弾はブロックも壊す。",
    "skill.core.ranged.guide.9.how": "電池でクロスボウを動かす。超自然の敵には銀のボルト。",
    "skill.core.ranged.guide.10.how": "精密な部品で連射できる。",
    "skill.core.ranged.guide.11.how": "超伝導コイルの弾はどんな耐性も貫く。",
    "skill.core.ranged.guide.12.how": "エーテルの弦の弓は矢がいらない。",
    "skill.core.ranged.guide.13.how": "嵐のグリフォンのまれな落とし物。78で使いこなせる。",
    "skill.core.ranged.guide.14.how": "80になると、矢やボルトの多くが戻ってくる。",
    "skill.core.magic.guide.0.how": "エーテルの粒（鬼火が落とす）を見つけて杖に宿す。",
    "skill.core.magic.guide.1.how": "粒を使って自分やペットを少し治す。",
    "skill.core.magic.guide.2.how": "粉から土のルーンを作る。重い矢の呪文。",
    "skill.core.magic.guide.3.how": "しばらくついてくる浮かぶ光。",
    "skill.core.magic.guide.4.how": "火の生き物の熾火のうろこが燃料になる。",
    "skill.core.magic.guide.5.how": "霜の枝角が触れたものを冷やし、遅くする。",
    "skill.core.magic.guide.6.how": "見ている方向へ数ブロック跳ぶ。",
    "skill.core.magic.guide.7.how": "根が生き物を留める。手なずけや狙い撃ちに。",
    "skill.core.magic.guide.8.how": "雷雨で集める嵐の粒。",
    "skill.core.magic.guide.9.how": "炉への一方通行の旅。",
    "skill.core.magic.guide.10.how": "敵を押し返し、水や生き物を凍らせる。",
    "skill.core.magic.guide.11.how": "敵から敵へ飛ぶ稲妻と、攻撃を防ぐ泡。",
    "skill.core.magic.guide.12.how": "野生の動物をなだめ、早く心を開かせる。",
    "skill.core.magic.guide.13.how": "鬼火が共に戦う。雨や晴れを呼ぶ。",
    "skill.core.magic.guide.14.how": "月の鹿のまれな呪文書。",
    "skill.core.magic.guide.15.how": "80になると、選んだ呪文ひとつにルーンがいらない。",
    "skill.core.alchemy.guide.0.how": "焚き火で薬草を煎じる。煎じるたびに性質がひとつわかる。",
    "skill.core.alchemy.guide.1.how": "性質を共有する二つの薬草で、茶より強い強壮剤になる。",
    "skill.core.alchemy.guide.2.how": "火にかけた大釜で一度に2回分作れる。",
    "skill.core.alchemy.guide.3.how": "解毒剤は毒を治し、温め薬と冷まし薬は天候に耐える。",
    "skill.core.alchemy.guide.4.how": "陶工の蒸留器で4回分を一本の小瓶にまとめる。",
    "skill.core.alchemy.guide.5.how": "強化薬はしばらくスキルのレベルを上げる。早めに作れるようになる。",
    "skill.core.alchemy.guide.6.how": "手なずけたい野生の動物を落ち着かせる。",
    "skill.core.alchemy.guide.7.how": "戦いの前に武器に塗る。火を嫌う相手には火、毒、霊には銀。",
    "skill.core.alchemy.guide.8.how": "工学か工作に固定で+2。ものづくり向け。",
    "skill.core.alchemy.guide.9.how": "最初は+6、1分ごとに1下がる。直前に飲む。",
    "skill.core.alchemy.guide.10.how": "珍しい薬草から作る。一度飲めば永久に続く。",
    "skill.core.alchemy.guide.11.how": "凝縮エーテルと、いくつもの戦闘強化をまとめたオーバーロード。",
    "skill.core.alchemy.guide.12.how": "もうひとつの永久の霊薬：体力+10。",
    "skill.core.alchemy.guide.13.how": "まれな薬：1分間すべてのスキルに+4。",
    "skill.core.alchemy.guide.14.how": "80になると、どの薬も1回分多くなる。",
    "skill.core.construction.guide.0.how": "開拓の炉を建て、そばで眠る。",
    "skill.core.construction.guide.1.how": "炉を強化する。近くの設備が効果をくれる。",
    "skill.core.construction.guide.2.how": "柵は動物を囲い、井戸はどこでも作物に水をやる。",
    "skill.core.construction.guide.3.how": "より強い家のための、よりよい設備。",
    "skill.core.construction.guide.4.how": "ペットや乗り物の家。",
    "skill.core.construction.guide.5.how": "石の炉と儀式の輪。",
    "skill.core.construction.guide.6.how": "空の出来事を見る。戦利品を飾る。",
    "skill.core.construction.guide.7.how": "風呂は弱体効果を洗い流す。",
    "skill.core.construction.guide.8.how": "川をせき止め、水車や畑に使う。",
    "skill.core.construction.guide.9.how": "家で調合し、地図机で旅を計画する。",
    "skill.core.construction.guide.10.how": "家の範囲が広がる。",
    "skill.core.construction.guide.11.how": "家どうしをつなぐ転移門はここから。",
    "skill.core.construction.guide.12.how": "家の核：いちばん強い家。",
    "skill.core.construction.guide.13.how": "大設備は効果が1.5倍になる。",
    "skill.core.construction.guide.14.how": "二つ目の炉：目覚められる家が二つに。",
    "skill.core.construction.guide.15.how": "80になると、いつでも家に帰れる。",
    "skill.core.cooking": "料理",
    "skill.core.cooking.description": "作物や肉、野の恵みを、お腹を満たし、傷を癒し、体を温める食事にする。",
    "skill.core.cooking.guide.0": "焚き火: 肉、魚、卵、根菜、きのこを焼く。ハーブティー",
    "skill.core.cooking.guide.1": "鍋: ゆで卵とおかゆ",
    "skill.core.cooking.guide.2": "石臼: 小麦粉と平焼きパン",
    "skill.core.cooking.guide.3": "家畜のえさ: マッシュと混ぜ種",
    "skill.core.cooking.guide.4": "かまど: パン",
    "skill.core.cooking.guide.5": "フライパン: オムレツと目玉焼き",
    "skill.core.cooking.guide.6": "野菜のシチュー",
    "skill.core.cooking.guide.7": "バター作り: バターとクリーム",
    "skill.core.cooking.guide.8": "肉のシチューと狩人のシチュー",
    "skill.core.cooking.guide.9": "パイ",
    "skill.core.cooking.guide.10": "燻製小屋: 肉と魚の燻製",
    "skill.core.cooking.guide.11": "フレッシュチーズ",
    "skill.core.cooking.guide.12": "はちみつケーキと手なずけのおやつ",
    "skill.core.cooking.guide.13": "干し台: 乾いた空気でジャーキーと干し果物",
    "skill.core.cooking.guide.14": "つぼ: 涼しい所でザワークラウトとピクルス",
    "skill.core.cooking.guide.15": "ヒカリダケのスープ: 暗闇で目が利く",
    "skill.core.cooking.guide.16": "熾火の実のシチュー: 体が温まり、火に強くなる",
    "skill.core.cooking.guide.17": "霜花のシャーベット: 暑さに強くなる",
    "skill.core.cooking.guide.18": "月ウサギのシチューと星百合の茶",
    "skill.core.cooking.guide.19": "心花のパイ: 1時間、体力が増える",
    "skill.core.cooking.guide.20": "宴: 食卓を囲む全員に効果",
    "skill.core.attack": "攻撃",
    "skill.core.attack.description": "武器、牙、爪で、強く、何度も打つ。",
    "skill.core.attack.guide.0": "素手、木と石の武器、骨の棍棒。レベルが上がるほど攻撃が当たりやすく、痛くなる",
    "skill.core.attack.guide.1": "銅の武器",
    "skill.core.attack.guide.2": "出血させる牙の短剣",
    "skill.core.attack.guide.3": "青銅の武器",
    "skill.core.attack.guide.4": "鉄の武器",
    "skill.core.attack.guide.5": "コバルトの武器",
    "skill.core.attack.guide.6": "銀の武器。超自然の生き物によく効く",
    "skill.core.attack.guide.7": "ダイヤモンドの刃の武器",
    "skill.core.attack.guide.8": "炎鱗の刃",
    "skill.core.attack.guide.9": "エーテライトの武器",
    "skill.core.defence": "防御",
    "skill.core.defence.description": "攻撃をかわし、鎧を着こなす。",
    "skill.core.defence.guide.0": "革の鎧。受け流した攻撃で鍛えられる",
    "skill.core.defence.guide.1": "硬い革",
    "skill.core.defence.guide.2": "銅の鎧。寒さを防ぐオオカミの毛皮のマント",
    "skill.core.defence.guide.3": "青銅の鎧",
    "skill.core.defence.guide.4": "クマの毛皮の鎧と鉄の鎧",
    "skill.core.defence.guide.5": "ワニのうろこの鎧",
    "skill.core.defence.guide.6": "コバルトの鎧",
    "skill.core.defence.guide.7": "超自然の害を防ぐ銀の鎖かたびら",
    "skill.core.defence.guide.8": "火を防ぐ炎鱗の鎧",
    "skill.core.defence.guide.9": "水晶の甲羅の鎧",
    "skill.core.defence.guide.10": "エーテライトの鎧",
    "skill.core.defence.guide.11": "ケープの特典：守りの呪文が長く続く（呪文が来たら）",
    "skill.core.defence.guide.11.how": "80になる。打撃、矢、魔法からの守りは、専用の枠を持つ呪文として来る。",
    "skill.core.hitpoints": "HP",
    "skill.core.hitpoints.description": "どれだけの痛手に耐えられるか。体力はレベルの2倍。",
    "skill.core.hitpoints.guide.0": "体力20。攻撃を当てるたびに鍛えられる",
    "skill.core.hitpoints.guide.1": "体力40",
    "skill.core.hitpoints.guide.2": "自然な回復が4分の1速くなる（予定）",
    "skill.core.hitpoints.guide.3": "料理した食べ物の回復量が1割増える",
    "skill.core.hitpoints.guide.4": "体力100",

