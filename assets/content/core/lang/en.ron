    "skill.core.farming.guide.11": "Inspecting shows hidden genes and carriers",
    "skill.core.farming.guide.12": "Keep ember salamanders",
    "skill.core.farming.guide.13": "Aether feed raises the chance of mutation",
    "skill.core.farming.guide.14": "Keep crystal tortoises",
    "skill.core.farming.guide.15": "Keep griffins",
