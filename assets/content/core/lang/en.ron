// English: every word of the interface, by key (see crates/engine/src/lang.rs). Every
// key the game uses is here; other languages translate these, and anything they leave
// out shows in English.
//
// `{name}`s are filled in by the game; a translation keeps them and puts them wherever
// its grammar wants. Keys ending `.one` and `.other` are a count's forms: `.one` for
// exactly one, `.other` for everything else. Definitions (blocks, skills) are named
// from their ids unless a key names them: `block.base.oak_log`, `skill.core.farming`.
{
    "language.name": "English",
    // How tall a line of wrapped text is, in font sizes.
    "language.line_height": "1.2",
    "language.tight_line": "1.0",
    // Between items in a line: "Farming 3 · Mining 5".
    "language.dot": " · ",

