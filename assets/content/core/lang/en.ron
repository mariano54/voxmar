    "skill.core.attack.guide.1": "Copper weapons",
    "skill.core.attack.guide.2": "Fang daggers that bleed",
    "skill.core.attack.guide.3": "Bronze weapons",
    "skill.core.attack.guide.4": "Iron weapons",
    "skill.core.attack.guide.5": "Cobalt weapons",
    "skill.core.attack.guide.6": "Silver weapons, stronger against supernatural creatures",
    "skill.core.attack.guide.7": "Diamond-edged weapons",
    "skill.core.attack.guide.8": "Ember-scale blades",
    "skill.core.attack.guide.9": "Aetherite weapons",
    "skill.core.construction": "Construction",
    "skill.core.construction.description": "Your home: the hearth's tiers and the fixtures that give buffs; also dams, rails and bridges.",
    "skill.core.construction.guide.0": "Hearth tier 1: bedroll and fire ring",
    "skill.core.construction.guide.0.how": "Build the Homestead Hearth and sleep beside it.",
    "skill.core.construction.guide.1": "Hearthstone, chimney and pit kiln",
    "skill.core.construction.guide.1.how": "Dress cobbles into a hearthstone, cobbles and clay into a chimney, and ring a campfire with cobbles for a pit kiln.",
    "skill.core.construction.guide.2": "Herb planter",
    "skill.core.construction.guide.2.how": "Planks and dirt: herbs and flowers placed in it grow back.",
    "skill.core.construction.guide.3": "Hearth tier 2: bed, stove, larder, workbench",
    "skill.core.construction.guide.3.how": "Upgrade the hearth; fixtures near it give their buffs.",
    "skill.core.construction.guide.4": "Stone altar",
    "skill.core.construction.guide.4.how": "Stone bricks: it will restore prayer and take bones for Magic.",
    "skill.core.construction.guide.5": "Fences, wells and gates",
    "skill.core.construction.guide.5.how": "Fences keep animals in; a well waters crops anywhere.",
    "skill.core.construction.guide.6": "Hearth tier 3: better fixtures",
    "skill.core.construction.guide.6.how": "Better fixtures for a stronger home.",
    "skill.core.construction.guide.7": "Kennel and stable",
    "skill.core.construction.guide.7.how": "Homes for your pets and mounts.",
    "skill.core.construction.guide.8": "Hearth tier 4; ritual circle",
    "skill.core.construction.guide.8.how": "A stone hearth, and a circle for rituals.",
    "skill.core.construction.guide.9": "Telescope; trophy stand",
    "skill.core.construction.guide.9.how": "See the sky's events; show off your trophies.",
    "skill.core.construction.guide.10": "Hearth tier 5; bath",
    "skill.core.construction.guide.10.how": "A bath washes away debuffs.",
    "skill.core.construction.guide.11": "Dams",
    "skill.core.construction.guide.11.how": "Hold back rivers for water wheels and fields.",
    "skill.core.construction.guide.12": "Alchemy bench; map table",
    "skill.core.construction.guide.12.how": "Brew at home; plan journeys on the map table.",
    "skill.core.construction.guide.13": "Hearth tier 6",
    "skill.core.construction.guide.13.how": "A larger home radius.",
    "skill.core.construction.guide.14": "Hearth tier 8; portal frame",
    "skill.core.construction.guide.14.how": "Portals between your homes start here.",
    "skill.core.construction.guide.15": "Hearth tier 10; house core",
    "skill.core.construction.guide.15.how": "The house core: the home at its strongest.",
    "skill.core.construction.guide.16": "Grand fixtures: buffs half again as strong",
    "skill.core.construction.guide.16.how": "Grand fixtures give their buffs half again as strong.",
    "skill.core.construction.guide.17": "Mastery: a second home",
    "skill.core.construction.guide.17.how": "A second hearth: two homes to wake at.",
    "skill.core.construction.guide.18": "Cape perk: go home whenever you like",
    "skill.core.construction.guide.18.how": "Reach 80: travel home whenever you like.",
