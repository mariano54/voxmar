    "skill.core.construction": "Construction",
    "skill.core.construction.description": "Your home: the hearth's tiers and the fixtures that give buffs; also dams, rails and bridges.",
    "skill.core.construction.guide.0": "Hearth tier 1: bedroll and fire ring",
    "skill.core.construction.guide.0.how": "Build the Homestead Hearth and sleep beside it.",
    "skill.core.construction.guide.1": "Hearth tier 2: bed, stove, larder, workbench",
    "skill.core.construction.guide.1.how": "Upgrade the hearth; fixtures near it give their buffs.",
    "skill.core.construction.guide.10": "Hearth tier 6",
    "skill.core.construction.guide.10.how": "A larger home radius.",
    "skill.core.construction.guide.11": "Hearth tier 8; portal frame",
    "skill.core.construction.guide.11.how": "Portals between your homes start here.",
    "skill.core.construction.guide.12": "Hearth tier 10; house core",
    "skill.core.construction.guide.12.how": "The house core: the home at its strongest.",
    "skill.core.construction.guide.13": "Grand fixtures: buffs half again as strong",
    "skill.core.construction.guide.13.how": "Grand fixtures give their buffs half again as strong.",
    "skill.core.construction.guide.14": "Mastery: a second home",
    "skill.core.construction.guide.14.how": "A second hearth: two homes to wake at.",
    "skill.core.construction.guide.15": "Cape perk: go home whenever you like",
    "skill.core.construction.guide.15.how": "Reach 80: travel home whenever you like.",
    "skill.core.construction.guide.2": "Fences, wells and gates",
    "skill.core.construction.guide.2.how": "Fences keep animals in; a well waters crops anywhere.",
    "skill.core.construction.guide.3": "Hearth tier 3: better fixtures",
    "skill.core.construction.guide.3.how": "Better fixtures for a stronger home.",
    "skill.core.construction.guide.4": "Kennel and stable",
    "skill.core.construction.guide.4.how": "Homes for your pets and mounts.",
    "skill.core.construction.guide.5": "Hearth tier 4; ritual circle",
    "skill.core.construction.guide.5.how": "A stone hearth, and a circle for rituals.",
    "skill.core.construction.guide.6": "Telescope; trophy stand",
    "skill.core.construction.guide.6.how": "See the sky's events; show off your trophies.",
    "skill.core.construction.guide.7": "Hearth tier 5; bath",
    "skill.core.construction.guide.7.how": "A bath washes away debuffs.",
    "skill.core.construction.guide.8": "Dams",
    "skill.core.construction.guide.8.how": "Hold back rivers for water wheels and fields.",
    "skill.core.construction.guide.9": "Alchemy bench; map table",
    "skill.core.construction.guide.9.how": "Brew at home; plan journeys on the map table.",
