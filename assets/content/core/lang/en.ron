    // Command help, as commands.ron writes it (the first sentence is the list /help gives).
    "command.core.biome.help": "Names the biome you stand in, and its climate.",
    "command.core.biome.help.summary": "Names the biome you stand in, and its climate.",
    "command.core.clear.help": "Empties your inventory, or takes every one of an item out of it.",
    "command.core.clear.help.summary": "Empties your inventory, or takes every one of an item out of it.",
    "command.core.creatures.help": "Lists the creatures within 64 blocks of you: how many of each, and what the nearest is doing. Admins may tame those within 8 blocks, ready the kept ones there to breed, hasten them (products due and young grown at once), hold them still for a minute, or kill them.",
    "command.core.creatures.help.summary": "Lists the creatures within 64 blocks of you: how many of each, and what the nearest is doing.",
    "command.core.day.help": "Sets the time to morning: /time set day.",
    "command.core.day.help.summary": "Sets the time to morning: /time set day.",
    "command.core.drop.help": "Drops a stack of an item into the world (up to 64 at a time) at a block (~ is where you are), or at your feet.",
    "command.core.drop.help.summary": "Drops a stack of an item into the world (up to 64 at a time) at a block (~ is where you are), or at your feet.",
    "command.core.effect.help": "Gives you an effect for a while (60 seconds unless you say), as food would; clear takes them all away.",
    "command.core.effect.help.summary": "Gives you an effect for a while (60 seconds unless you say), as food would; clear takes them all away.",
    "command.core.fill.help": "Fills the box between two corners with a block, up to 32768 of them; air empties it.",
    "command.core.fill.help.summary": "Fills the box between two corners with a block, up to 32768 of them; air empties it.",
    "command.core.gamemode.help": "Switches you, or a player, between survival (on foot) and creative (flight allowed).",
    "command.core.gamemode.help.summary": "Switches you, or a player, between survival (on foot) and creative (flight allowed).",
    "command.core.give.help": "Gives you blocks, 64 unless you say: /give water to pour some. What does not fit drops at your feet.",
    "command.core.give.help.summary": "Gives you blocks, 64 unless you say: /give water to pour some.",
    "command.core.grow.help": "Grows the crops within 8 blocks of you by a stage, or as many as you say (all the way to ripe with `ripe`), and brings back the wild plants picked there.",
    "command.core.grow.help.summary": "Grows the crops within 8 blocks of you by a stage, or as many as you say (all the way to ripe with `ripe`), and brings back the wild plants picked there.",
    "command.core.help.help": "Lists the commands you can use, or explains one.",
    "command.core.help.help.summary": "Lists the commands you can use, or explains one.",
    "command.core.kill.help": "Kills you, as a fall or a wolf would: you keep your three most valuable items and the rest lies where you fell.",
    "command.core.kill.help.summary": "Kills you, as a fall or a wolf would: you keep your three most valuable items and the rest lies where you fell.",
    "command.core.list.help": "Lists who is online.",
    "command.core.list.help.summary": "Lists who is online.",
    "command.core.locate.help": "Finds the nearest place of a biome, of a river running deep in a gorge, or of a hamlet or village, within 4000 blocks unless you say (up to 10000), or the nearest sample of ore on the ground over a vein (of an ore such as iron, if you name one), within 1000.",
    "command.core.locate.help.summary": "Finds the nearest place of a biome, of a river running deep in a gorge, or of a hamlet or village, within 4000 blocks unless you say (up to 10000), or the nearest sample of ore on the ground over a vein (of an ore such as iron, if you name one), within 1000.",
    "command.core.night.help": "Sets the time to night: /time set night.",
    "command.core.night.help.summary": "Sets the time to night: /time set night.",
    "command.core.seed.help": "Tells the world's seed.",
    "command.core.seed.help.summary": "Tells the world's seed.",
    "command.core.setblock.help": "Puts a block at a position (~ is where you are, so ~ ~-1 ~ is under your feet), replacing what is there. Water and lava placed this way flow.",
    "command.core.setblock.help.summary": "Puts a block at a position (~ is where you are, so ~ ~-1 ~ is under your feet), replacing what is there.",
    "command.core.skill.help": "Sets your level in a skill (farming, hunter, cooking, attack…), from 1 to the highest.",
    "command.core.skill.help.summary": "Sets your level in a skill (farming, hunter, cooking, attack…), from 1 to the highest.",
    "command.core.summon.help": "Puts creatures of a species (rabbit, wolf, moonhare…) on the ground in front of you, or at a block (~ is where you are), one unless you say, up to 16.",
    "command.core.summon.help.summary": "Puts creatures of a species (rabbit, wolf, moonhare…) on the ground in front of you, or at a block (~ is where you are), one unless you say, up to 16.",
    "command.core.time.help": "Shows or changes the time of day. A day is 24000 ticks, 30 minutes; 0 is sunrise and an in-game hour is 1000 ticks. set moves forward to the next such time, speed 10 runs days ten times as fast, freeze stops the sun and resume runs it at normal speed again.",
    "command.core.time.help.summary": "Shows or changes the time of day.",
    "command.core.tp.help": "Teleports you, or a player, to coordinates or to another player. ~ is where the player is now, so ~ ~10 ~ goes ten blocks up; with only x and z you land on the ground.",
    "command.core.tp.help.summary": "Teleports you, or a player, to coordinates or to another player.",
    "command.core.weather.help": "Shows the weather here, or brings a kind of weather (/weather list names them) to the land around you, as intense as you say (each kind has its usual intensity; 1 is its fiercest), for five minutes unless you say, after which the natural weather takes over again. natural ends it now.",
    "command.core.weather.help.summary": "Shows the weather here, or brings a kind of weather (/weather list names them) to the land around you, as intense as you say (each kind has its usual intensity; 1 is its fiercest), for five minutes unless you say, after which the natural weather takes over again.",
    "command.core.wind.help": "Shows the wind here, or brings a wind (calm, breeze, strong or gale; /wind list names them) to the land around you, from a direction (n, ne, e, se, s, sw, w, nw or degrees from north) if you say, for five minutes unless you say. /weather natural ends it.",
    "command.core.wind.help.summary": "Shows the wind here, or brings a wind (calm, breeze, strong or gale; /wind list names them) to the land around you, from a direction (n, ne, e, se, s, sw, w, nw or degrees from north) if you say, for five minutes unless you say.",

