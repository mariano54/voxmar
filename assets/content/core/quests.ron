// How the interface follows quests pinned in the quest book (engine/src/quest.rs, the
// interface's hud/quests.rs). The quests themselves are each package's own quests.ron.
(
    tracker: (
        // Quests pinned at once, at most.
        pins: 3,
        // Seconds a done quest stays on screen, ticked, before it drops off.
        done_stays: 5.0,
        // How opaque the backing behind each pinned quest is, 0 to 1.
        backing_alpha: 0.5,
        // A pinned quest that drops off done leaves the quests it opens pinned in its place
        // (or, opening none, the next open quest of its age), so the next step is always on
        // screen.
        follow_on: true,
        // How many pinned quests, from the top, show a way to meet their next goal under it
        // (the recipe book's way, as the quest book shows it; none for a goal to look up).
        ways: 1,
        // The tracker names the key that opens the quest book at the quest.
        book_key: true,
    ),
    // What the quests' experience rewards are worth: every `Xp` a quest file writes is paid,
    // shown in the book and tracker, and counted by the walks times `xp`, and a capstone's
    // (the last quest of its path) times `capstone_xp` again. Doubled so a quest feels worth
    // its effort (Mariano, Oct 21); capstones half as much again for closing a path.
    pays: (
        xp: 2.0,
        capstone_xp: 1.5,
    ),
)
